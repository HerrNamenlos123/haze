
import renderer
import ui_styling
import headwind
import textedit_behavior
import vim_behavior
import text_document
import unicode
import ui_elements
import ui_components
import unicode
type presets = headwind.presets;

// Vim editing model on/off. The textedit engine is the same either way;
// this only decides whether a vim_behavior.Vim is installed on top of it
// and therefore whether keys are interpreted as vim commands.
// TODO: surface this as a user setting rather than a compile-time
// constant. A function rather than a global `let` because module-level
// variables cannot hold multi-line initializers here.
fn vimEnabled(): bool {
    return true;
}

// The editor's font, as ONE definition used by both the text that gets
// rendered and every measurement taken of it.
//
// This must never be split into two places. `ui.measureText(text)` with no
// font arguments resolves the font from the LIVE RENDER STACK -- so it
// returns the editor's font when called during the render pass, but the
// application default when called from anywhere else. Event handlers
// (onPointerDown) and the per-frame pointer pump both run OUTSIDE the
// render tree, so a bare measureText() there silently measured a different
// font: 9px per character instead of the editor's 7px.
//
// Nothing looked wrong at column 0, and the 2px-per-column error was
// absorbed by the end-of-line clamp on short lines -- so it only showed up
// on lines long enough for the drift to still land inside the text, as a
// cursor that lagged further behind the mouse the further right you
// clicked. Any measurement used to convert pixels <-> columns MUST pass
// the font explicitly.
fn editorFontFamily(): str {
    return "JetBrainsMonoNerdFont-Regular";
}

fn editorFontSize(): real {
    return 16.0;
}

// Map the UI toolkit's physical Key onto the key NAMES vim_behavior
// understands. Only the non-character keys need naming -- printable
// characters come through onTextInput instead.
fn keyEventName(key: ui_components.Key): str {
    if key == ui_components.Key.Escape { return "Escape"; }
    if key == ui_components.Key.Return { return "Return"; }
    if key == ui_components.Key.Backspace { return "Backspace"; }
    if key == ui_components.Key.Tab { return "Tab"; }
    if key == ui_components.Key.Up { return "Up"; }
    if key == ui_components.Key.Down { return "Down"; }
    if key == ui_components.Key.Left { return "Left"; }
    if key == ui_components.Key.Right { return "Right"; }
    if key == ui_components.Key.Delete { return "Delete"; }
    if key == ui_components.Key.Home { return "Home"; }
    if key == ui_components.Key.End { return "End"; }
    if key == ui_components.Key.PageUp { return "PageUp"; }
    if key == ui_components.Key.PageDown { return "PageDown"; }
    // Letters, for Ctrl-combinations like <C-d>/<C-o>/<C-r>.
    if key == ui_components.Key.A { return "a"; }
    if key == ui_components.Key.D { return "d"; }
    if key == ui_components.Key.I { return "i"; }
    if key == ui_components.Key.O { return "o"; }
    if key == ui_components.Key.R { return "r"; }
    if key == ui_components.Key.U { return "u"; }
    if key == ui_components.Key.V { return "v"; }
    return "";
}

type SizeMode = ui_components.SizeMode;
type DivElement = ui_elements.DivElement;
type TextElement = ui_elements.TextElement;
type CanvasElement = ui_elements.CanvasElement;

struct RootArgs {
    fn operator!=(other: RootArgs) {
        return false;
    }
}

// A TextMate scope selector matches a token's scope if it is the whole
// scope, or a dot-separated prefix of it (e.g. "string" matches
// "string.quoted.double", but not "stringify").
fn scopeSelectorMatches(selector: str, scope: str): bool {
    if selector.length == 0 || selector.length > scope.length {
        return false;
    }
    if !scope.startsWith(selector) {
        return false;
    }
    return selector.length == scope.length || scope[selector.length] == b".";
}

struct State {
    highlightEngine: HighlightEngine;
    highlightCommands: []HighlightCommand = [];
    highlightResults: []HighlightResult = [];
    reactiveCounter: rx.Reactive<int>;
}

extern C let g_state: State | none = none;

fn initState(state: State) {
    g_state = state;
}

fn getState() {
    let state = g_state;
    assert(state);
    return state;
}

struct HighlightToken {
    text: str;
    color: Color;
}

struct TokenColorSettings {
    foreground?: str;
    fontStyle?: str;
};

struct TokenColor {
    name?: str;
    scope: str | []str;
    settings: TokenColorSettings;
};

struct VscodeTheme {
  tokenColors: []TokenColor = [];
};

struct CompiledTokenColor {
    selectors: []str;
    settings: TokenColorSettings;
}

export fn UI(ui: ui_components.UIContext, gfx: mut renderer.gfx.Context) {
    ui.defineComponent(0, {} as RootArgs, (instance: ui_components.InstanceData<RootArgs>) => {

        let cache = json.CacheFile<Cache>("codeeditor.cache.json");

        // The document. Lines are mutated IN PLACE (see
        // stdlib/text_document): typing a character is one String.insert
        // on one line, not a rebuild of the line array and not a
        // reassembly of the whole file into a str. `docVersion` is bumped
        // by every edit so the render path can invalidate exactly what
        // changed instead of diffing content.
        let doc = text_document.Document();
        let docVersion = rx.reactive<int>(0);

        // Per-line syntax tokens, cached. Rebuilding these for the whole
        // document on every keystroke was the single biggest cost in the
        // old render path (O(lines x tokens) per frame); now a line's
        // tokens are recomputed only when that line actually changes.
        let lineTokens = rx.shallowReactive<[][]HighlightToken>([]);

        // The file exactly as read from disk, kept until the highlighter
        // and the LSP have been handed their initial copy.
        //
        // Both of them need the whole document once at startup -- and we
        // ALREADY have it, straight from fs.readText. Splitting it into
        // lines and then re-joining those lines back into the identical
        // string (which is what doc.text() does) is two pointless
        // O(document) passes to reproduce a value we were holding all
        // along. So keep it, use it, then drop it.
        let initialText = rx.reactive<str | none>(none);

        let load = () => {
            if cache.data.file {
                let file = fs.readText(cache.data.file as str);
                if file {
                    let text = file as str;
                    doc.setText(text);
                    initialText := text;
                    docVersion := rx.get(docVersion) + 1;
                }
                else {
                    fmt.println("Failed loading file");
                }
            }
        };

        // The single mutation primitive textedit_behavior drives. Cost is
        // proportional to the EDIT, not to the document: within-line edits
        // touch one line, multi-line edits touch only the lines they span.
        let applyReplaceRange = (start: Vec2i, end: Vec2i, text: String): void => {
            doc.replaceRange(start, end, text.cloneString());
            docVersion := rx.get(docVersion) + 1;
        };

        // The project currently being edited. Vue's language server doesn't actually need
        // this to be precise (tsserver does its own tsconfig discovery once a file is
        // `open`ed), it's only used for the LSP-level workspace/rootUri bookkeeping.
        let projectRoot = "/home/fzachs/Projects/technicalsketcher.web";

        // Owns the entire Vue/TypeScript language support lifecycle (LSP
        // connection, tsserver process, hybrid-mode plumbing) -- see
        // vue_lsp_bridge.hz's module doc comment for the architecture.
        let vueBridge = VueLspBridge({
            vueLanguageServerPath: "codeeditor/syntax-engine/node_modules/@vue/language-server/bin/vue-language-server.js",
            tsdk: "codeeditor/syntax-engine/node_modules/typescript/lib",
            nodeModulesDir: "codeeditor/syntax-engine/node_modules",
            projectRoot: projectRoot,
            projectName: "technicalsketcher.web",
        });
        if !vueBridge {
            fmt.println("Vue language server failed to start: ", vueBridge.message);
        }

        // ── Hover state ──────────────────────────────────────────────
        //
        // A hover is a REQUEST at a position, not a thing that happens on
        // its own. `hoverRequest` is that position (none = no hover wanted,
        // so nothing is shown and nothing is asked of the language server);
        // `hoverResult` is the answer once it arrives. Keeping the request
        // separate from the answer is what lets the popup show a loading
        // placeholder in the gap between the two, and what keeps a stale
        // answer from outliving the request that produced it.
        //
        // Who sets the request depends on the editing model, and the two
        // are deliberately different because the editors they imitate are:
        //   - no vim: the mouse does, after dwelling (see hoverDwell).
        //   - vim:    only an explicit keypress does (see hoverKeyPressed).
        let hoverRequest = rx.reactive<Vec2i | none>(none);
        let hoverResult = rx.reactive<str | null>(null);
        // Anchor in WINDOW pixels for the popup. The cursor position is the
        // right anchor for the vim path but not the mouse path, where the
        // popup belongs at the pointer, which may be nowhere near the caret.
        let hoverAnchor = rx.reactive<Vec2 | none>(none);

        // Drops whatever hover is on screen and cancels any pending one.
        // Called from every input path that invalidates it: typing, moving
        // the caret, scrolling, or moving the mouse away.
        let dismissHover = () => {
            hoverRequest := none;
            hoverResult := null;
            hoverAnchor := none;
        };

        let highlights = rx.computed(() => {
            let state = getState();
            rx.get(state.reactiveCounter);
            let results = state.highlightResults;
            state.highlightResults = [];
            return results;
        });

        // Persistent per-line token cache.
        //
        // An incremental reply carries tokens ONLY for the lines whose
        // highlighting changed, so results must be merged into this cache
        // rather than replacing it -- rebuilding from the latest reply
        // alone would blank every other line in the file.
        let tokenCache = rx.shallowReactive<[][]Token>([]);
        let tokenCacheVersion = rx.reactive<int>(0);

        let mergeHighlightResult = (result: HighlightResult) => {
            let buckets: [][]Token = rx.get(tokenCache);

            if !result.incremental {
                // Full parse: the reply is the whole truth.
                buckets = [];
            }

            // Grow/shrink to the engine's current line count so cached
            // tokens for deleted lines cannot linger.
            if result.lineCount > 0 {
                while buckets.length < result.lineCount {
                    let empty: []Token = [];
                    buckets.push(empty);
                }
                while buckets.length > result.lineCount {
                    buckets.pop();
                }
            }

            // Clear just the range this reply covers, then refill it.
            if result.incremental {
                for (let i = result.firstLine; i <= result.lastLine && i < buckets.length; i++) {
                    let empty: []Token = [];
                    buckets[i] = empty;
                }
            }

            for token in result.tokens {
                while buckets.length <= token.lineIndex {
                    let empty: []Token = [];
                    buckets.push(empty);
                }
                buckets[token.lineIndex].push(token);
            }

            tokenCache := buckets;
            tokenCacheVersion := rx.get(tokenCacheVersion) + 1;
        };

        // Drain replies and merge them. Called once per frame from the
        // render pass rather than from inside a computed, because merging
        // is a side effect and a computed may be skipped or re-run at the
        // reactive system's discretion -- a dropped reply would leave the
        // affected lines uncoloured until the next edit.
        let drainHighlightResults = () => {
            let hh: []HighlightResult = rx.get(highlights);
            for result in hh {
                mergeHighlightResult(result);
            }
        };

        let theme = rx.reactive<VscodeTheme | none>(none);
        let loadTheme = () => {
            let file = fs.readText("codeeditor/resources/obsidian-radiance-dark.json");
            // let file = fs.readText("codeeditor/resources/catppuccin-mocha.json");
            if !file {
                fmt.println("Failed to load theme");
                return;
            }

            let result = json.parse<VscodeTheme>(file);
            if !result {
                fmt.println("Failed to parse theme: ", result.error());
                return;
            }

            theme := result;
        };
        let compiledTokenColors = rx.computed<[]CompiledTokenColor>(() => {
            if !theme {
                return [];
            }

            let result: []CompiledTokenColor = [];

            for tokenColor in theme.tokenColors {
                let selectors: []str = [];

                if tokenColor.scope is str {
                    for part in tokenColor.scope.split(",") {
                        selectors.push(part.trim());
                    }
                } else {
                    selectors = tokenColor.scope;
                }

                result.push({
                    selectors: selectors,
                    settings: tokenColor.settings,
                });
            }

            return result;
        });
        let getScopeColor = (scope: str): Color | none => {
            let bestForeground: str | none = none;
            let bestLength = -1;

            for tokenColor in compiledTokenColors {
                for selector in tokenColor.selectors {
                    if selector.length >= bestLength &&
                    scopeSelectorMatches(selector, scope) &&
                    tokenColor.settings.foreground {

                        bestForeground = tokenColor.settings.foreground;
                        bestLength = selector.length;
                    }
                }
            }

            return bestForeground ? Color(bestForeground) : none;
        };


        // ui.onMounted(() => {
        //     load();
        // });
        load();
        loadTheme();

        let defaultTextColor = (): Color => "#FFF";

        // TextMate scope stacks go from least specific to most specific
        // (e.g. ["source.ts", "meta.block.ts", "keyword.control.ts"]), and
        // themes are meant to be matched against the *most specific* scope
        // first -- broad structural scopes like "meta.block" would otherwise
        // shadow the token's actual, more specific classification.
        let getFirstScopeColor = (scopes: []str): Color => {
            for (let i = scopes.length - 1; i >= 0; i--) {
                let color = getScopeColor(scopes[i]);
                if color {
                    return color;
                }
            }
            return defaultTextColor();
        }

        let texteditBehavior = textedit_behavior.Context({
            getLineLength: (lineIndex: int) => doc.lineLength(lineIndex),
            getLine: (lineIndex: int) => doc.line(lineIndex),
            getLineCount: () => doc.lineCount(),
            getTimeInSeconds: () => {
                return ui.now();
            },
            replaceRange: applyReplaceRange,
        });

        // Vim is an OPTIONAL behavior layered on the same engine. Toggling
        // it at runtime only swaps which behavior is installed -- the
        // engine, the document and the undo history are untouched, so you
        // keep your place and your history across the switch.
        let vim = vim_behavior.Vim(texteditBehavior);
        let vimOn = rx.reactive<bool>(true);

        let applyVimMode = (enabled: bool) => {
            if enabled {
                vim.install();
                vim_behavior.applyRemaps(vim, vim_behavior.defaultVimrc());
                texteditBehavior.setMode(textedit_behavior.Mode.Normal);
            } else {
                // Detaching the behavior returns the engine to plain
                // textbox handling: keys fall through to the default
                // bindings and the caret goes back to sitting BETWEEN
                // characters (Insert-mode clamping).
                texteditBehavior.clearBehavior();
                texteditBehavior.setMode(textedit_behavior.Mode.Insert);
            }
        };
        applyVimMode(true);

        let toggleVim = () => {
            let next = !rx.get(vimOn);
            vimOn := next;
            applyVimMode(next);
        };

        // Scroll state for the text area. The editor owns it (it knows
        // the content size); the scroll component owns the maths.
        let scroll = ui_components.ScrollState();
        scroll.overflowY = ui_components.Overflow.Auto;
        scroll.overflowX = ui_components.Overflow.Hidden;
        // Handle on the text area element, so the render pass can read
        // its measured size (the viewport height the scroll maths needs).
        let editorRef: ui_components.ElementRef<ui_elements.DivElement> =
            rx.shallowReactive<ui_components.ElementWrapper<ui_elements.DivElement> | null>(null);

        // Focus the text area as soon as the app comes up, so the window
        // opens ready to type in -- without this, keyboard input goes nowhere
        // until the user clicks into the editor first (key events are only
        // delivered along the focused element's chain). onMounted runs after
        // the first build, so editorRef is populated by the time this fires;
        // the request itself is applied at the start of the next frame's
        // input processing, before any keystrokes are dispatched.
        ui.onMounted(() => {
            let editorEl = rx.get(editorRef);
            if editorEl {
                editorEl.focus();
            }
        });

        // Set after anything that moves the caret, so the next frame
        // scrolls it back into view. A flag rather than an immediate
        // scroll because the viewport size is only known during render.
        let caretFollow = rx.reactive<bool>(false);

        // Mouse selection: pointer position -> document position, then
        // click places the caret and drag extends the selection, exactly
        // like a browser text area (and like vim's own mouse support).
        let mouseSelecting = rx.reactive<bool>(false);

        // Where the press landed, and whether the pointer has since moved
        // off it. A click and a drag begin identically -- button down, and
        // still down on the next frame -- so the pump cannot tell them
        // apart from button state alone. Without this, every plain click
        // started a selection (and in vim, entered visual mode) on the
        // frame after the press, because the caret gets re-derived from
        // the live mouse position and any disagreement becomes a range.
        // The PIXEL position of the press, and the document position it
        // resolved to. The drag test has to be made in pixels: converting
        // a pixel to a document position goes through maxColumn(), which
        // is MODE-DEPENDENT (normal mode clamps to the last character,
        // visual mode allows one past it). Comparing document positions
        // therefore reports "moved" the instant the mode changes, even
        // with the mouse held perfectly still -- which is what made a
        // click past the end of a line enter visual mode and select back
        // to the click column.
        let dragOriginPxX = rx.reactive<real>(0.0);
        let dragOriginPxY = rx.reactive<real>(0.0);
        let dragOriginX = rx.reactive<int>(0);
        let dragOriginY = rx.reactive<int>(0);
        let dragMoved = rx.reactive<bool>(false);

        // Top edge of the text area in window space, used to convert a
        // global pointer position into a local one.
        let editorOriginY = (): real => {
            let editorEl = rx.get(editorRef);
            if editorEl {
                let pos = editorEl.position();
                if pos {
                    return pos.y;
                }
            }
            return 0.0;
        };

        // Left edge, same purpose -- absolutely-positioned children are
        // placed in editor-local coordinates, but a pointer position is
        // in window space.
        let editorOriginX = (): real => {
            let editorEl = rx.get(editorRef);
            if editorEl {
                let pos = editorEl.position();
                if pos {
                    return pos.x;
                }
            }
            return 0.0;
        };

        // Pointer position (window space) -> document (column, line).
        // Rounds to the NEAREST character boundary horizontally, like a
        // browser: clicking the right half of a glyph puts the caret
        // after it, which is what makes click-to-place feel right.
        let documentPositionAt = (pointer: Vec2): Vec2i => {
            // Explicit font -- see editorFontFamily(). This runs from an
            // event handler, where the contextual font is NOT the editor's.
            let charSize = ui.measureText("X", editorFontFamily(), editorFontSize());
            let editorEl = rx.get(editorRef);
            let originX = 0.0;
            let originY = 0.0;
            if editorEl {
                let pos = editorEl.position();
                if pos {
                    originX = pos.x;
                    originY = pos.y;
                }
            }
            let localX = pointer.x - originX;
            let localY = pointer.y - originY + rx.get(scroll.scrollTop);

            let lineIndex = 0;
            if charSize.y > 0.0 {
                lineIndex = (localY / charSize.y) as int;
            }
            lineIndex = text_document.clampIndex(lineIndex, doc.lineCount());

            // Pixels -> DISPLAY column (the renderer lays every cluster out
            // on a fixed monospace advance, so this division is exact).
            let displayColumn = 0;
            if charSize.x > 0.0 {
                displayColumn = ((localX / charSize.x) + 0.5) as int;
            }
            if displayColumn < 0 {
                displayColumn = 0;
            }

            // Display column -> BYTE offset, which is what the engine means
            // by "column". These coincide only for pure-ASCII lines: a tab,
            // a CJK glyph or an emoji occupies a different number of bytes
            // than it does screen cells, and feeding a display column
            // straight in lands the caret at an unrelated byte.
            let lineText = doc.lineText(lineIndex);
            let column = 0;
            let cell = 0;
            let scanning = true;
            while scanning && column < lineText.length {
                let width = unicode.clusterColumnWidth(lineText, column);
                if cell + width > displayColumn {
                    scanning = false;
                } else {
                    cell = cell + width;
                    column = unicode.nextClusterOffset(lineText, column);
                }
            }

            // Past the end of the text, the caret belongs at the line's own
            // limit -- NOT at the column the pixel maths implied. Clamping
            // is deliberate and must use the CURRENT mode's limit.
            let maxColumn = texteditBehavior.maxColumn(lineIndex);
            if column > maxColumn {
                column = maxColumn;
            }
            let result: Vec2i = { x: column, y: lineIndex };
            return result;
        };

        // Is the pointer over the text area itself? documentPositionAt()
        // answers "which character would this pixel be", and it clamps --
        // so it happily reports a valid position for a pointer sitting in
        // the status bar or outside the window entirely. Mouse hover must
        // not fire in either case, hence the explicit bounds test.
        let pointerInsideEditor = (pointer: Vec2): bool => {
            let editorEl = rx.get(editorRef);
            if !editorEl {
                return false;
            }
            let pos = editorEl.position();
            if pos {
                let size = editorEl.size();
                if size {
                    // The scrollbar is chrome, not text: dwelling on it is
                    // aiming at the bar, never at the token underneath.
                    let textWidth = size.x;
                    if scroll.showsVerticalBar() {
                        textWidth = textWidth - scroll.style.size;
                    }
                    return pointer.x >= pos.x && pointer.x < pos.x + textWidth
                        && pointer.y >= pos.y && pointer.y < pos.y + size.y;
                }
            }
            return false;
        };

        let state = getState();

        // Live highlighting, incrementally.
        //
        // The document reports exactly which lines an edit replaced
        // (ChangeSet), and the syntax engine speaks that same shape: it
        // keeps a per-line rule-stack cache, retokenizes from the changed
        // line, and stops as soon as the stack reconverges. Editing one
        // line in a 5000-line file costs ~0.4ms instead of the ~24ms a
        // full reparse takes, so this runs on every edit with no debounce
        // and the colours never lag behind what you typed.
        //
        // Opening a block comment (which genuinely does recolour
        // everything below it) still cascades correctly -- the engine
        // simply keeps going until the rule stack matches again.
        let highlightUri = "buffer";
        if cache.data.file {
            highlightUri = cache.data.file as str;
            // Reuse the text we just read rather than re-deriving it.
            let startupText = rx.get(initialText);
            state.highlightEngine.sendOpenDocument(
                highlightUri, startupText ? startupText as str : doc.text());
        }

        doc.addChangeListener((change: text_document.ChangeSet) => {
            let newLines: []str = [];
            for (let i = 0; i < change.insertedCount; i++) {
                newLines.push(doc.lineText(change.startLine + i));
            }
            state.highlightEngine.sendDocumentChange(
                highlightUri, change.startLine, change.removedCount, newLines);
        });

        // Hover used to be requested every time the cursor moved, including
        // every single keystroke while typing (typing moves the cursor) --
        // each one kicking off a tsserver + LSP round trip. Typing quickly
        // queued requests faster than they drained, and editing ground to a
        // halt. Worse, it meant hover was permanently on: a popup followed
        // the caret around whether or not anyone asked for one.
        //
        // Hover is now only ever requested by the two gestures that mean
        // "tell me about this", matching the editor being imitated:
        //
        //   no vim -> VS Code: rest the MOUSE over a token for
        //             hoverDwellSeconds and the popup appears at the
        //             pointer; any pointer movement to a different
        //             character, or any keystroke, takes it away again.
        //
        //   vim    -> neovim: hover is `vim.lsp.buf.hover`, bound to K in
        //             every stock LSP config. It is a normal-mode COMMAND
        //             at the caret, one popup per press, never automatic --
        //             so nothing here is time-based at all. Per this
        //             editor's binding it is shift+L rather than K (see
        //             hoverKeyPressed).
        let hoverDwellSeconds = 0.3;
        let lastEditAt = rx.reactive<real>(-1000.0);
        // Guards the one-shot LSP document open, so the per-frame loop
        // never has to build the whole document just to discard it.
        let lspDocumentOpened = rx.reactive<bool>(false);
        // The position a request was last SENT for, so re-running the loop
        // (which happens every frame) doesn't re-send the same query.
        let lastHoverPos = rx.reactive<Vec2i | none>(none);

        // ── Mouse dwell tracking (non-vim path only) ─────────────────
        //
        // "The pointer has been still, over the same character, for long
        // enough" -- the whole of VS Code's hover trigger. Tracked in
        // window pixels rather than document positions because a pointer
        // that moves within one character has NOT moved for this purpose,
        // and comparing document positions is what makes that true.
        let mouseRestX = rx.reactive<real>(-1.0);
        let mouseRestY = rx.reactive<real>(-1.0);
        let mouseRestSince = rx.reactive<real>(-1.0);
        // Set by the vim keybinding; consumed by the loop below, which is
        // where the document text needed to build the request is in scope.
        let hoverKeyPressed = rx.reactive<bool>(false);

        // Exponentially-smoothed FPS, recomputed alongside the LSP drain
        // below since that's already the one thing guaranteed to re-run
        // every frame (it depends on ui.now()).
        let lastFrameAt = rx.reactive<real>(0.0);
        let fps = rx.reactive<real>(0.0);
        let fpsText = rx.computed(() => f"{fps as int} FPS");

        // Status-bar label for the active editing model / vim mode.
        let modeLabel = rx.computed(() => {
            if !rx.get(vimOn) {
                return "INSERT (vim off - F2)";
            }
            let mode = rx.get(texteditBehavior.mode);
            if mode == textedit_behavior.Mode.Insert { return "-- INSERT --"; }
            if mode == textedit_behavior.Mode.Visual { return "-- VISUAL --"; }
            if mode == textedit_behavior.Mode.VisualLine { return "-- VISUAL LINE --"; }
            if mode == textedit_behavior.Mode.VisualBlock { return "-- VISUAL BLOCK --"; }
            return "-- NORMAL --";
        });
        let modeColor = rx.computed((): Color => {
            if !rx.get(vimOn) {
                return "#888" as Color;
            }
            let mode = rx.get(texteditBehavior.mode);
            if mode == textedit_behavior.Mode.Insert { return "#7FD97F" as Color; }
            if textedit_behavior.modeIsVisual(mode) { return "#D9B87F" as Color; }
            return "#7FA8D9" as Color;
        });

        let prevUpdate = ui.now();

        let lspMemStat = rx.reactive<str | none>(none);

        let updateStats = () => {
            if !vueBridge {
                return;
            }
            let memory = vueBridge.getSystemMemoryUtilization();

            let vue = memory.vue ? memory.vue / 1024 / 1024 : "?";
            let ts = memory.ts ? memory.ts / 1024 / 1024 : "?";

            lspMemStat := f"Vue LSP Memory: {vue} MiB | TypeScript LSP Memory: {ts} MiB";
        };

        let runLspLoop = rx.computed(() => {
            let now = ui.now();

            let dt = now - lastFrameAt;
            lastFrameAt := now;
            if dt > 0.0 {
                fps := fps * 0.9 + (1.0 / dt) * 0.1;
            }

            if now - prevUpdate > 0.5 {
                updateStats();
                prevUpdate = now;
            }

            drainHighlightResults();

            if vueBridge && cache.data.file {
                // openDocument() is a ONE-SHOT (it early-returns once the
                // document is open), but the argument was still being
                // evaluated on every frame -- and doc.text() reassembles
                // the entire file. That alone cost seconds per frame on a
                // large file. Send the text once, then never again, and
                // send the copy we already read from disk.
                if !rx.get(lspDocumentOpened) {
                    lspDocumentOpened := true;
                    let startupText = rx.get(initialText);
                    vueBridge.openDocument(cache.data.file, "vue", 1,
                        startupText ? startupText as str : doc.text());
                    // Both consumers have their copy now; stop pinning
                    // a second full copy of the file in memory.
                    initialText := none;
                }

                // ── Deciding whether a hover is wanted ───────────────
                //
                // Two INDEPENDENT triggers, not two alternatives. The mouse
                // is a pointing device in either editing model -- pointing
                // at a token and waiting means the same thing whether or
                // not vim is on -- so dwell is always live. The keyboard
                // trigger is what's vim-specific, since only vim has a
                // modal normal mode for a bare letter to be a command in.
                //
                //   keyboard (vim only) -> neovim: `vim.lsp.buf.hover`,
                //             stock-bound to K, here shift+L. An explicit
                //             command at the CARET, one popup per press.
                //
                //   mouse (always)      -> VS Code: rest the pointer over a
                //             token for hoverDwellSeconds, popup appears at
                //             the POINTER. Any movement takes it away.
                //
                // The keyboard trigger runs first so that its caret-anchored
                // popup is already standing when the dwell branch looks; the
                // dwell branch only ever acts on an EMPTY hoverRequest, so a
                // stationary mouse cannot steal a hover the keyboard just
                // asked for.
                if rx.get(vimOn) && rx.get(hoverKeyPressed) {
                    hoverKeyPressed := false;
                    let cursor = texteditBehavior.cursorPosition;
                    // Anchor under the caret, which is where neovim floats
                    // its hover window -- `none` selects the caret anchor.
                    hoverAnchor := none;
                    hoverResult := null;
                    hoverRequest := { x: cursor.x, y: cursor.y } as Vec2i;
                    // The pointer has not moved, so without this the dwell
                    // branch would be free to re-fire at the pointer the
                    // moment this popup is dismissed, spawning a hover
                    // nobody asked for. Make the mouse re-earn its dwell.
                    mouseRestSince := now;
                }

                // Mouse dwell. Only while the pointer is actually inside
                // the editor and not mid-drag -- selecting text with the
                // mouse must not spawn popups.
                let pointer = ui.mousePos;
                let moved = pointer.x != rx.get(mouseRestX)
                    || pointer.y != rx.get(mouseRestY);
                if moved {
                    mouseRestX := pointer.x;
                    mouseRestY := pointer.y;
                    mouseRestSince := now;
                }

                let busy = rx.get(mouseSelecting) || scroll.isDragging();
                let restedFor = now - rx.get(mouseRestSince);
                if busy || moved {
                    // Moving the pointer at all takes the popup away, and
                    // the dwell timer above has already restarted -- so
                    // coming to rest on the SAME character re-asks and
                    // shows it again, while a pointer travelling across
                    // the text shows nothing on the way. That is what VS
                    // Code does, and it is why this does not bother
                    // comparing document positions: the reset of
                    // lastHoverPos is what makes the re-ask happen.
                    //
                    // This also dismisses a shift+L popup as soon as the
                    // mouse is moved, which is the right call: it is the
                    // same "you did something else now" signal that a
                    // keystroke gives.
                    if rx.get(hoverRequest) {
                        dismissHover();
                        lastHoverPos := none;
                    }
                } else if restedFor > hoverDwellSeconds
                        && now - lastEditAt > hoverDwellSeconds
                        && pointerInsideEditor(pointer) {
                    // Nothing is on screen here: any pointer movement
                    // cleared it in the branch above, and without movement
                    // this fires once and then sees its own request still
                    // standing. This is also what keeps the branch off a
                    // caret-anchored shift+L popup.
                    if !rx.get(hoverRequest) {
                        let target = documentPositionAt(pointer);
                        // Past the end of a line there is no token to
                        // describe, and asking wastes a round trip.
                        if target.x < doc.lineText(target.y).length {
                            hoverResult := null;
                            hoverAnchor := { x: pointer.x, y: pointer.y } as Vec2;
                            hoverRequest := target;
                        }
                    }
                }

                // ── Serving the request ──────────────────────────────
                //
                // One query per distinct requested position. This is kept
                // apart from the triggers above so both paths get the same
                // de-duplication, and so a request made while the servers
                // were still starting is retried once they are up: the
                // guard reads hoverAvailable() reactively, so this computed
                // re-runs the moment it flips and the pending request --
                // which is still sitting in hoverRequest -- goes out then.
                let wanted = rx.get(hoverRequest);
                if wanted && vueBridge.hoverAvailable() {
                    let prevPos = rx.get(lastHoverPos);
                    let alreadySent = false;
                    if prevPos {
                        alreadySent = prevPos.x == wanted.x && prevPos.y == wanted.y;
                    }
                    if !alreadySent {
                        lastHoverPos := wanted;
                        // wanted.x is a BYTE offset. The bridge needs the
                        // line's text to convert it into whatever index
                        // space each language server actually counts in.
                        let hoverLine = doc.lineText(wanted.y);
                        let requestedFor: Vec2i = { x: wanted.x, y: wanted.y };
                        vueBridge.hover(wanted.y, wanted.x, hoverLine, (text: str | null) => {
                            // The answer may arrive after the user has
                            // moved on or dismissed the popup; a reply for
                            // a position we are no longer asking about must
                            // not resurrect it.
                            let current = rx.get(hoverRequest);
                            if !current {
                                return;
                            }
                            if current.x != requestedFor.x || current.y != requestedFor.y {
                                return;
                            }
                            hoverResult := text ? text : "(no hover info at this position)";
                        });
                    }
                }

                vueBridge.loop();
            }
        });

        // Split ONE line's text into coloured runs, given only the tokens
        // that belong to that line. The old version scanned the whole
        // document's token list for every line, which is O(lines x tokens)
        // -- quadratic, re-run on every keystroke, and the main reason
        // typing froze. Tokens are bucketed by line once (see
        // `tokensByLine`) so this only ever walks its own line's tokens.
        let splitLineTokens = (lineText: str, tokens: []Token): []HighlightToken => {
            let parts: []HighlightToken = [];
            let position = 0;

            for token in tokens {
                // Token indices are BYTE offsets (the highlighter converts
                // from UTF-16 before sending them -- see toByteOffsets in
                // syntax-engine.ts), but snap them anyway: a slice landing
                // inside a multi-byte character yields a lone lead byte,
                // i.e. text that is not valid UTF-8. The text renderer
                // cannot decode that into a glyph, and the resulting
                // undrawable run corrupts the whole frame. This guard costs
                // a byte comparison on the ASCII fast path and makes that
                // failure mode unreachable regardless of what the
                // highlighter sends.
                let tokenStart = unicode.clusterStart(lineText, token.startIndex);
                if position < tokenStart && tokenStart <= lineText.length {
                    parts.push({
                        text: lineText.slice(position, tokenStart),
                        color: defaultTextColor(),
                    });
                }
                let rawEnd = token.endIndex < lineText.length ? token.endIndex : lineText.length;
                let tokenEnd = unicode.clusterStart(lineText, rawEnd);
                if tokenEnd > tokenStart {
                    parts.push({
                        text: lineText.slice(tokenStart, tokenEnd),
                        color: getFirstScopeColor(token.scopes),
                    });
                    position = tokenEnd;
                }
            }

            if position < lineText.length {
                parts.push({
                    text: lineText.slice(position, lineText.length),
                    color: defaultTextColor(),
                });
            }
            return parts;
        };

        // Tokens grouped by line index, rebuilt only when a new highlight
        // result arrives -- one pass over the token list instead of one
        // pass per line.
        let tokensByLine = rx.computed(() => {
            rx.get(tokenCacheVersion);
            return rx.get(tokenCache);
        });

        // The coloured runs for a single line, computed on demand. Only
        // VISIBLE lines are ever asked for (see the render loop's use of
        // scroll.visibleRange), so frame cost is O(lines on screen) rather
        // than O(lines in file).
        let highlightedLine = (lineIndex: int): []HighlightToken => {
            let lineText = doc.lineText(lineIndex);
            let buckets: [][]Token = rx.get(tokensByLine);
            let tokensForLine: []Token = [];
            if lineIndex < buckets.length {
                tokensForLine = buckets[lineIndex];
            }
            return splitLineTokens(lineText, tokensForLine);
        };

        return () => {
            ui.div({
                id: 0,
                presets: [
                    presets.col(),
                    presets.wGrow(),
                    presets.hGrow(),
                    presets.textColor("#FFF"),
                    presets.p(4),
                    presets.gap(2),
                ]
            }, () => {
                ui.div({
                    id: 0,
                    presets: [
                        presets.row(),
                        presets.gap(8),
                    ]
                }, () => {
                    ui.text({
                        id: 0,
                        text: fpsText,
                    });

                    // Which editing model is active, and (in vim) which
                    // mode -- the same information vim's own statusline
                    // shows, because with modal editing you cannot tell
                    // what a keystroke will do without it.
                    ui.text({
                        id: 2,
                        text: modeLabel,
                        presets: [presets.textColor(modeColor)],
                    });

                    if lspMemStat {
                        ui.text({
                            id: 1,
                            text: lspMemStat,
                        });
                    }
                });

                rx.get(runLspLoop);

                ui.div({
                    id: 1,
                    ref: editorRef,
                    style: {
                        direction: ui_styling.Direction.Column,
                        fontFamily: editorFontFamily(),
                        fontSize: editorFontSize(),
                        textColor: "#FFF" as Color,
                    },
                    presets: [
                        presets.relative(),
                        presets.wGrow(),
                        presets.hGrow(),
                        presets.col(),
                        presets.bg("#181818"),
                        // Lines are absolutely positioned at a scroll-offset
                        // top, so the ones scrolled past either edge would
                        // otherwise paint straight over the statusline and
                        // out past the window. Clip them to this box.
                        presets.overflowHidden(),
                        // presets.p(8),
                    ],
                    focusable: true,

                    // Wheel scrolls the text, exactly like any scroll
                    // container; the scroll model clamps at both ends.
                    onWheel: (event: ui_components.WheelEvent) => {
                        scroll.handleWheel(event.delta);
                        // The popup is anchored to a place in the text; once
                        // the text moves under it, it is pointing at the
                        // wrong token. Both editors close it on scroll.
                        dismissHover();
                    },

                    // Click places the caret, drag extends a selection --
                    // chrome's behavior, and what vim does with the mouse
                    // too (a drag puts vim into visual mode).
                    onPointerDown: (event: ui_components.PointerEvent) => {
                        // A press that started on the scrollbar is a
                        // scroll gesture, not a text selection.
                        if scroll.isDragging() {
                            return;
                        }
                        // Clicking is an interaction with the text, not a
                        // request to describe it -- put the popup away.
                        dismissHover();
                        let target = documentPositionAt(event.pos);
                        mouseSelecting := true;
                        dragOriginPxX := event.pos.x;
                        dragOriginPxY := event.pos.y;
                        dragOriginX := target.x;
                        dragOriginY := target.y;
                        dragMoved := false;
                        if rx.get(vimOn) {
                            // Leave whatever visual selection existed, then
                            // place the caret; a subsequent drag re-enters
                            // visual mode from here.
                            texteditBehavior.setMode(textedit_behavior.Mode.Normal);
                            texteditBehavior.clearSelection();
                        } else {
                            texteditBehavior.clearSelection();
                        }
                        texteditBehavior.moveTo(target, true, false);
                    },
                    // Dragging and releasing are handled by the pointer
                    // capture pump in the render pass, not here: element
                    // events stop firing once the cursor leaves the
                    // element, which would strand a selection (or a
                    // scrollbar drag) half-finished.
                    onTextInput: (event: ui_components.TextInputEvent) => {
                        // With Vim active, printable characters are
                        // commands in normal/visual mode and literal text
                        // in insert mode -- the behavior decides which.
                        if rx.get(vimOn) {
                            // Hover, as neovim binds it: an explicit
                            // command in normal/visual mode (stock LSP
                            // configs put `vim.lsp.buf.hover` on K; here it
                            // is shift+L). Shifted letters arrive as text
                            // input, not as key events, so the intercept
                            // belongs here -- and it must happen BEFORE the
                            // behavior sees the character, or vim would
                            // also run its own "L" motion (screen-bottom).
                            //
                            // Insert mode is excluded for the same reason
                            // neovim excludes it: there, "L" is just a
                            // letter you are typing.
                            let vimMode = rx.get(texteditBehavior.mode);
                            if event.text == "L" && vimMode != textedit_behavior.Mode.Insert {
                                hoverKeyPressed := true;
                                return;
                            }
                            texteditBehavior.handleTextInput(event.text);
                        } else {
                            texteditBehavior.insertText(event.text);
                        }
                        caretFollow := true;
                        lastEditAt := ui.now();
                        dismissHover();
                    },
                    onKeyDown: (event: ui_components.KeyboardEvent) => {
                        let ctrl = hasModifier(event.modifiers, KeyModifiers.Ctrl);
                        let shift = hasModifier(event.modifiers, KeyModifiers.Shift);
                        let alt = hasModifier(event.modifiers, KeyModifiers.Alt);

                        // F2 toggles the vim editing model at runtime.
                        // Handled before anything else so it works in
                        // every mode, including vim's insert mode.
                        if event.key == ui_components.Key.F2 {
                            toggleVim();
                            return;
                        }

                        // Any key may move the caret, so ask the next
                        // frame to scroll it back into view.
                        caretFollow := true;

                        if rx.get(vimOn) {
                            // Non-character keys (and modifier combos)
                            // reach Vim here; plain characters arrive via
                            // onTextInput above.
                            let name = vim_behavior.namedKey(keyEventName(event.key), ctrl, alt);
                            if name.length > 0 {
                                texteditBehavior.handleKey(name);
                                lastEditAt := ui.now();
                                // neovim's hover float closes on the next
                                // keypress; so does this one.
                                dismissHover();
                            }
                            return;
                        }

                        if event.key == ui_components.Key.Left {
                            if ctrl { texteditBehavior.moveCursorWordLeft(shift); }
                            else { texteditBehavior.moveCursorLeft(shift); }
                        }
                        else if event.key == ui_components.Key.Right {
                            if ctrl { texteditBehavior.moveCursorWordRight(shift); }
                            else { texteditBehavior.moveCursorRight(shift); }
                        }
                        else if event.key == ui_components.Key.Up {
                            texteditBehavior.moveCursorUp(shift);
                        }
                        else if event.key == ui_components.Key.Down {
                            texteditBehavior.moveCursorDown(shift);
                        }
                        else if event.key == ui_components.Key.Home {
                            if ctrl { texteditBehavior.moveCursorDocumentStart(shift); }
                            else { texteditBehavior.moveCursorHome(shift); }
                        }
                        else if event.key == ui_components.Key.End {
                            if ctrl { texteditBehavior.moveCursorDocumentEnd(shift); }
                            else { texteditBehavior.moveCursorEnd(shift); }
                        }
                        else if event.key == ui_components.Key.Return {
                            texteditBehavior.insertNewline();
                        }
                        else if event.key == ui_components.Key.Backspace {
                            texteditBehavior.deleteBackward(ctrl);
                        }
                        else if event.key == ui_components.Key.Delete {
                            texteditBehavior.deleteForward(ctrl);
                        }
                        else if ctrl && event.key == ui_components.Key.A {
                            texteditBehavior.selectAll();
                        }
                        else if ctrl && event.key == ui_components.Key.C {
                            texteditBehavior.copy();
                        }
                        else if ctrl && event.key == ui_components.Key.X {
                            texteditBehavior.cut();
                        }
                        else if ctrl && event.key == ui_components.Key.V {
                            texteditBehavior.paste();
                        }

                        lastEditAt := ui.now();
                        dismissHover();
                    },
                }, () => {
                    // Explicit font, so this stays identical to the value
                    // documentPositionAt() uses -- the two MUST agree.
                    let characterSize = ui.measureText("X", editorFontFamily(), editorFontSize());
                    let lineHeight = characterSize.y;
                    let lineCount = doc.lineCount();

                    // Keep the scroll model in sync with the content and
                    // the viewport, then clamp -- deleting the last lines
                    // must not leave the view scrolled past the end.
                    scroll.scrollHeight := lineCount as real * lineHeight;
                    let editorEl = rx.get(editorRef);
                    if editorEl {
                        let viewport = editorEl.size();
                        if viewport {
                            scroll.clientHeight := viewport.y;
                            scroll.clientWidth := viewport.x;
                        }
                    }
                    scroll.clampToBounds();

                    // ── Pointer capture ──────────────────────────────
                    //
                    // Browsers capture the pointer when a drag starts, so
                    // the dragged control keeps tracking the mouse even
                    // once the cursor leaves it -- off the scrollbar, off
                    // the window, anywhere. Element-scoped onPointerMove
                    // cannot do that: it only fires while the cursor is
                    // actually over the element, which is why dragging the
                    // 10px-wide bar used to stop the instant the mouse
                    // slipped sideways.
                    //
                    // So an in-progress drag is driven here instead, from
                    // the global mouse position and button state, which
                    // are polled every frame regardless of what is under
                    // the cursor.
                    let leftDown = ui.leftMouseHeld();

                    if scroll.isDragging() {
                        if leftDown {
                            scroll.updateDrag(ui.mousePos.y - editorOriginY());
                        } else {
                            // Released -- possibly outside the window,
                            // where no onPointerUp will ever arrive.
                            scroll.endDrag();
                            scroll.clampToBounds();
                        }
                    }

                    // Text selection follows the same rule: keep extending
                    // while the button is held, and end the moment it is
                    // released, wherever that happens.
                    if rx.get(mouseSelecting) {
                        if leftDown {
                            // A click and a drag look identical on the frame
                            // after the press. Only once the pointer has
                            // actually reached a DIFFERENT document position
                            // is this a drag -- until then, leave the caret
                            // exactly where the press put it and select
                            // nothing.
                            let origin: Vec2i = {
                                x: rx.get(dragOriginX),
                                y: rx.get(dragOriginY),
                            };
                            if !rx.get(dragMoved) {
                                // Purely a pixel test -- see dragOriginPx.
                                // A press must travel at least one whole
                                // cell before it counts as a drag, so the
                                // jitter of a normal click never selects.
                                let dx = ui.mousePos.x - rx.get(dragOriginPxX);
                                let dy = ui.mousePos.y - rx.get(dragOriginPxY);
                                if dx < 0.0 { dx = -dx; }
                                if dy < 0.0 { dy = -dy; }
                                if dx >= characterSize.x || dy >= lineHeight {
                                    dragMoved := true;
                                    // In vim, dragging IS a visual selection.
                                    // Enter it from the PRESS position, not
                                    // the current caret: visual mode allows
                                    // the caret one past the last character,
                                    // so re-deriving it here would shift the
                                    // anchor by one on any click past the
                                    // end of a line.
                                    if rx.get(vimOn) {
                                        let dragMode = rx.get(texteditBehavior.mode);
                                        if !textedit_behavior.modeIsVisual(dragMode) {
                                            texteditBehavior.setMode(textedit_behavior.Mode.Visual);
                                            texteditBehavior.setSelectionAnchor(origin);
                                        }
                                    } else {
                                        texteditBehavior.setSelectionAnchor(origin);
                                    }
                                }
                            }
                            if rx.get(dragMoved) {
                                texteditBehavior.moveTo(
                                    documentPositionAt(ui.mousePos), true, true);
                            }
                        } else {
                            mouseSelecting := false;
                            dragMoved := false;
                        }
                    }

                    // Apply any scroll the engine asked for (vim's zz/zt/zb
                    // arrive as intents because the engine has no idea how
                    // tall the viewport is), then keep the caret on screen.
                    let cursorLine = texteditBehavior.cursorPosition.y;
                    let cursorTop = cursorLine as real * lineHeight;
                    let intent = rx.get(texteditBehavior.scrollIntent);
                    if intent == textedit_behavior.ScrollIntent.Center {
                        scroll.centerInView(cursorTop, lineHeight);
                    } else if intent == textedit_behavior.ScrollIntent.Top {
                        scroll.scrollToTop(cursorTop);
                    } else if intent == textedit_behavior.ScrollIntent.Bottom {
                        scroll.scrollToBottom(cursorTop, lineHeight);
                    } else if intent == textedit_behavior.ScrollIntent.Reveal {
                        scroll.scrollIntoView(cursorTop, lineHeight);
                    }
                    if intent != textedit_behavior.ScrollIntent.None {
                        texteditBehavior.clearScrollRequest();
                    }
                    if rx.get(caretFollow) {
                        scroll.scrollIntoView(cursorTop, lineHeight);
                        caretFollow := false;
                    }

                    let scrollY = rx.get(scroll.scrollTop);

                    // Only build elements for lines that are actually on
                    // screen. This is what makes idle and typing cost
                    // independent of document length -- the old loop built
                    // a div plus one text element per token for EVERY line
                    // in the file, every frame.
                    let range = scroll.visibleRange(lineHeight, lineCount, 2);
                    let firstLine = range.x;
                    let lastLine = range.y;

                    // Selection highlight, behind the text. Only visible
                    // lines are considered, same as the text itself.
                    for (let i = firstLine; i < lastLine; i++) {
                        let sel = texteditBehavior.selectionRangeForLine(i);
                        if sel {
                            // A line whose selection runs through its
                            // newline gets one extra character of
                            // highlight, so the newline is visible as
                            // selected -- and so an EMPTY line inside a
                            // linewise (V) selection still shows up
                            // instead of collapsing to zero width.
                            // startCol/endCol are BYTE offsets, which are not
                            // proportional to screen distance: an emoji is 4
                            // bytes but 2 cells wide. Convert both ends to
                            // display columns so the highlight lines up with
                            // the glyphs rather than with the byte count.
                            let startCell = texteditBehavior.displayColumnAt(i, sel.startCol);
                            let endCell = texteditBehavior.displayColumnAt(i, sel.endCol);
                            let columns = (endCell - startCell) as real;
                            if sel.includesLineEnd {
                                columns = columns + 1.0;
                            }
                            ui.div({
                                id: 100000 + i,
                                style: {
                                    width: columns * characterSize.x,
                                    height: lineHeight,
                                },
                                presets: [
                                    presets.absolute(),
                                    presets.top(i as real * lineHeight - scrollY),
                                    presets.left(startCell as real * characterSize.x),
                                    presets.bg("#3391FF55"),
                                ]
                            }, () => {});
                        }
                    }

                    // The visible text, one absolutely-positioned row per
                    // line so scrolling is a translation rather than a
                    // relayout.
                    for (let i = firstLine; i < lastLine; i++) {
                        let tokens = highlightedLine(i);
                        ui.div({
                            id: 200000 + i,
                            presets: [
                                presets.absolute(),
                                presets.top(i as real * lineHeight - scrollY),
                                presets.left(0),
                                presets.row(),
                                // A code line must NEVER wrap. Wrapping puts
                                // the overflow on a second visual row, so the
                                // glyph at column N stops being at
                                // N*charWidth -- and documentPositionAt(),
                                // the caret and the selection highlight all
                                // assume exactly that. Long lines overflow
                                // and get clipped instead, like every editor.
                                presets.noWrap(),
                            ],
                        }, () => {
                            if tokens.length > 0 {
                                for t, ti in tokens {
                                    ui.text({ id: ti, text: t.text, presets: [presets.textColor(t.color)] });
                                }
                            }
                            else {
                                ui.text({ id: 0, text: "" });
                            }
                        });
                    }

                    // Caret. In vim's normal/visual modes it is a BLOCK
                    // covering the character it sits on (the caret is *on*
                    // a character there, not between two); in insert mode
                    // and with vim off it is the usual thin bar.
                    let mode = rx.get(texteditBehavior.mode);
                    let blockCaret = mode == textedit_behavior.Mode.Normal
                                  || textedit_behavior.modeIsVisual(mode);

                    // cursorPosition.x is a BYTE offset, so it cannot be
                    // multiplied by a character width directly -- on a line
                    // holding one emoji that would put the caret four cells
                    // right of a glyph two cells wide. displayColumnAt does
                    // the conversion from bytes to cells.
                    let cursorCell = texteditBehavior.displayColumnAt(
                        texteditBehavior.cursorPosition.y,
                        texteditBehavior.cursorPosition.x,
                    );
                    // A block caret must cover the whole character it sits
                    // on, which is two cells wide for CJK and emoji.
                    let caretCells = texteditBehavior.displayWidthOfCharacterAt(
                        texteditBehavior.cursorPosition.y,
                        texteditBehavior.cursorPosition.x,
                    );
                    let cursorPos = Vec2(
                        cursorCell as real * characterSize.x,
                        cursorTop - scrollY,
                    );
                    ui.div({
                        id: 300001,
                        style: {
                            width: blockCaret ? caretCells as real * characterSize.x : 1.0,
                            height: lineHeight,
                        },
                        presets: [
                            presets.absolute(),
                            presets.top(cursorPos.y),
                            presets.left(cursorPos.x),
                            texteditBehavior.cursorVisible
                                ? (blockCaret ? presets.bg("#FFFFFF99") : presets.bg("#FFF"))
                                : presets.bg("#00000000"),
                        ]
                    }, () => {});

                    // Scrollbar. Drawn last so it sits above the text,
                    // and only when the content actually overflows
                    // (Overflow.Auto). The thumb is draggable and the
                    // track is clickable -- see ScrollState.beginDragY.
                    if scroll.showsVerticalBar() {
                        let barWidth = scroll.style.size;
                        let trackHeight = scroll.verticalTrackLength();
                        let thumbTop = scroll.verticalThumbOffset();
                        let thumbHeight = scroll.verticalThumbLength();
                        let viewWidth = rx.get(scroll.clientWidth);

                        ui.div({
                            id: 400000,
                            style: { width: barWidth, height: trackHeight },
                            presets: [
                                presets.absolute(),
                                presets.top(0),
                                presets.left(viewWidth - barWidth),
                                presets.bg(scroll.style.trackColor),
                            ],
                            onPointerDown: (event: ui_components.PointerEvent) => {
                                // Stop this reaching the editor underneath,
                                // which would otherwise start a text
                                // selection every time you grab the bar.
                                event.stopPropagation();
                                scroll.beginDragY(event.pos.y - editorOriginY());
                            },
                            // NOTE: no onPointerMove/onPointerUp here.
                            // Element events only fire while the cursor is
                            // over the element, so a drag would die the
                            // moment you moved off the 10px-wide bar. The
                            // drag is instead driven from the per-frame
                            // poll in the render pass (see "pointer
                            // capture" below), which follows the mouse
                            // anywhere -- including outside the window.
                        }, () => {
                            ui.div({
                                id: 0,
                                style: { width: barWidth, height: thumbHeight },
                                presets: [
                                    presets.absolute(),
                                    presets.top(thumbTop),
                                    presets.left(0),
                                    presets.bg(scroll.isDragging()
                                        ? scroll.style.thumbActiveColor
                                        : scroll.style.thumbColor),
                                    presets.rounded(5),
                                ],
                            }, () => {});
                        });
                    }

                    // The popup exists whenever a hover was ASKED for, not
                    // only once an answer came back -- otherwise the gap
                    // between the two (a cold language server takes many
                    // seconds) looks exactly like the request having been
                    // ignored. While that gap is open it shows why, so a
                    // slow start reads as "starting up", not as "broken".
                    if rx.get(hoverRequest) {
                        let pending = rx.get(hoverResult);
                        let ready = vueBridge && vueBridge.hoverAvailable();
                        let hoverText = pending ? pending as str
                            : (ready ? "Loading..." : "Starting language server...");

                        // Anchor: at the pointer for the mouse path (VS
                        // Code puts the popup where you are pointing),
                        // under the caret for the vim path. Both are
                        // converted to editor-local pixels, since the
                        // popup is absolutely positioned inside it.
                        let anchor = rx.get(hoverAnchor);
                        let anchorX = cursorPos.x;
                        let anchorY = cursorPos.y;
                        if anchor {
                            anchorX = anchor.x - editorOriginX();
                            anchorY = anchor.y - editorOriginY();
                        }

                        ui.div({
                            id: 300002,
                            presets: [
                                presets.absolute(),
                                presets.top(anchorY + characterSize.y + 10.0),
                                presets.left(anchorX),
                                presets.bg("#181818"),
                                presets.border(1),
                                presets.borderColor("#4F4F4F"),
                                presets.rounded(2),
                                // Without a bound, a long signature runs off
                                // the right edge and the text is unreadable.
                                presets.p(4),
                            ]
                        }, () => {
                            ui.text({
                                id: 0,
                                text: hoverText,
                                presets: pending
                                    ? []
                                    : [presets.textColor("#9A9A9A")],
                            });
                        });
                    }
                });
            });
        };
    });
}