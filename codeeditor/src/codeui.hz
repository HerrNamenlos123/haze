
import renderer
import ui_styling
import headwind
import textedit_behavior
import vim_behavior
import text_document
import ui_elements
import ui_components
type presets = headwind.presets;

// Vim editing model on/off. The textedit engine is the same either way;
// this only decides whether a vim_behavior.Vim is installed on top of it
// and therefore whether keys are interpreted as vim commands.
// TODO: surface this as a user setting rather than a compile-time
// constant. A function rather than a global `let` because module-level
// variables cannot hold multi-line initializers here.
fn vimEnabled(): bool {
    return true;
}

// Map the UI toolkit's physical Key onto the key NAMES vim_behavior
// understands. Only the non-character keys need naming -- printable
// characters come through onTextInput instead.
fn keyEventName(key: ui_components.Key): str {
    if key == ui_components.Key.Escape { return "Escape"; }
    if key == ui_components.Key.Return { return "Return"; }
    if key == ui_components.Key.Backspace { return "Backspace"; }
    if key == ui_components.Key.Tab { return "Tab"; }
    if key == ui_components.Key.Up { return "Up"; }
    if key == ui_components.Key.Down { return "Down"; }
    if key == ui_components.Key.Left { return "Left"; }
    if key == ui_components.Key.Right { return "Right"; }
    if key == ui_components.Key.Delete { return "Delete"; }
    if key == ui_components.Key.Home { return "Home"; }
    if key == ui_components.Key.End { return "End"; }
    if key == ui_components.Key.PageUp { return "PageUp"; }
    if key == ui_components.Key.PageDown { return "PageDown"; }
    // Letters, for Ctrl-combinations like <C-d>/<C-o>/<C-r>.
    if key == ui_components.Key.A { return "a"; }
    if key == ui_components.Key.D { return "d"; }
    if key == ui_components.Key.I { return "i"; }
    if key == ui_components.Key.O { return "o"; }
    if key == ui_components.Key.R { return "r"; }
    if key == ui_components.Key.U { return "u"; }
    if key == ui_components.Key.V { return "v"; }
    return "";
}

type SizeMode = ui_components.SizeMode;
type DivElement = ui_elements.DivElement;
type TextElement = ui_elements.TextElement;
type CanvasElement = ui_elements.CanvasElement;

struct RootArgs {
    fn operator!=(other: RootArgs) {
        return false;
    }
}

// A TextMate scope selector matches a token's scope if it is the whole
// scope, or a dot-separated prefix of it (e.g. "string" matches
// "string.quoted.double", but not "stringify").
fn scopeSelectorMatches(selector: str, scope: str): bool {
    if selector.length == 0 || selector.length > scope.length {
        return false;
    }
    if !scope.startsWith(selector) {
        return false;
    }
    return selector.length == scope.length || scope[selector.length] == b".";
}

struct State {
    highlightEngine: HighlightEngine;
    highlightCommands: []HighlightCommand = [];
    highlightResults: []HighlightResult = [];
    reactiveCounter: rx.Reactive<int>;
}

extern C let g_state: State | none = none;

fn initState(state: State) {
    g_state = state;
}

fn getState() {
    let state = g_state;
    assert(state);
    return state;
}

struct HighlightToken {
    text: str;
    color: Color;
}

struct TokenColorSettings {
    foreground?: str;
    fontStyle?: str;
};

struct TokenColor {
    name?: str;
    scope: str | []str;
    settings: TokenColorSettings;
};

struct VscodeTheme {
  tokenColors: []TokenColor = [];
};

struct CompiledTokenColor {
    selectors: []str;
    settings: TokenColorSettings;
}

export fn UI(ui: ui_components.UIContext, gfx: mut renderer.gfx.Context) {
    ui.defineComponent(0, {} as RootArgs, (instance: ui_components.InstanceData<RootArgs>) => {

        let cache = json.CacheFile<Cache>("codeeditor.cache.json");

        // The document. Lines are mutated IN PLACE (see
        // stdlib/text_document): typing a character is one String.insert
        // on one line, not a rebuild of the line array and not a
        // reassembly of the whole file into a str. `docVersion` is bumped
        // by every edit so the render path can invalidate exactly what
        // changed instead of diffing content.
        let doc = text_document.Document();
        let docVersion = rx.reactive<int>(0);

        // Per-line syntax tokens, cached. Rebuilding these for the whole
        // document on every keystroke was the single biggest cost in the
        // old render path (O(lines x tokens) per frame); now a line's
        // tokens are recomputed only when that line actually changes.
        let lineTokens = rx.shallowReactive<[][]HighlightToken>([]);

        let load = () => {
            if cache.data.file {
                let file = fs.readText(cache.data.file as str);
                if file {
                    doc.setText(file as str);
                    docVersion := rx.get(docVersion) + 1;
                }
                else {
                    fmt.println("Failed loading file");
                }
            }
        };

        // The single mutation primitive textedit_behavior drives. Cost is
        // proportional to the EDIT, not to the document: within-line edits
        // touch one line, multi-line edits touch only the lines they span.
        let applyReplaceRange = (start: Vec2i, end: Vec2i, text: String): void => {
            doc.replaceRange(start, end, text.cloneString());
            docVersion := rx.get(docVersion) + 1;
        };

        // The project currently being edited. Vue's language server doesn't actually need
        // this to be precise (tsserver does its own tsconfig discovery once a file is
        // `open`ed), it's only used for the LSP-level workspace/rootUri bookkeeping.
        let projectRoot = "/home/fzachs/Projects/technicalsketcher.web";

        // Owns the entire Vue/TypeScript language support lifecycle (LSP
        // connection, tsserver process, hybrid-mode plumbing) -- see
        // vue_lsp_bridge.hz's module doc comment for the architecture.
        let vueBridge = VueLspBridge({
            vueLanguageServerPath: "codeeditor/syntax-engine/node_modules/@vue/language-server/bin/vue-language-server.js",
            tsdk: "codeeditor/syntax-engine/node_modules/typescript/lib",
            nodeModulesDir: "codeeditor/syntax-engine/node_modules",
            projectRoot: projectRoot,
            projectName: "technicalsketcher.web",
        });
        if !vueBridge {
            fmt.println("Vue language server failed to start: ", vueBridge.message);
        }

        let hoverResult = rx.reactive<str | null>(null);

        let highlights = rx.computed(() => {
            let state = getState();
            rx.get(state.reactiveCounter);
            let results = state.highlightResults;
            state.highlightResults = [];
            return results;
        });

        // Persistent per-line token cache.
        //
        // An incremental reply carries tokens ONLY for the lines whose
        // highlighting changed, so results must be merged into this cache
        // rather than replacing it -- rebuilding from the latest reply
        // alone would blank every other line in the file.
        let tokenCache = rx.shallowReactive<[][]Token>([]);
        let tokenCacheVersion = rx.reactive<int>(0);

        let mergeHighlightResult = (result: HighlightResult) => {
            let buckets: [][]Token = rx.get(tokenCache);

            if !result.incremental {
                // Full parse: the reply is the whole truth.
                buckets = [];
            }

            // Grow/shrink to the engine's current line count so cached
            // tokens for deleted lines cannot linger.
            if result.lineCount > 0 {
                while buckets.length < result.lineCount {
                    let empty: []Token = [];
                    buckets.push(empty);
                }
                while buckets.length > result.lineCount {
                    buckets.pop();
                }
            }

            // Clear just the range this reply covers, then refill it.
            if result.incremental {
                for (let i = result.firstLine; i <= result.lastLine && i < buckets.length; i++) {
                    let empty: []Token = [];
                    buckets[i] = empty;
                }
            }

            for token in result.tokens {
                while buckets.length <= token.lineIndex {
                    let empty: []Token = [];
                    buckets.push(empty);
                }
                buckets[token.lineIndex].push(token);
            }

            tokenCache := buckets;
            tokenCacheVersion := rx.get(tokenCacheVersion) + 1;
        };

        // Drain replies and merge them. Called once per frame from the
        // render pass rather than from inside a computed, because merging
        // is a side effect and a computed may be skipped or re-run at the
        // reactive system's discretion -- a dropped reply would leave the
        // affected lines uncoloured until the next edit.
        let drainHighlightResults = () => {
            let hh: []HighlightResult = rx.get(highlights);
            for result in hh {
                mergeHighlightResult(result);
            }
        };

        let theme = rx.reactive<VscodeTheme | none>(none);
        let loadTheme = () => {
            let file = fs.readText("codeeditor/resources/obsidian-radiance-dark.json");
            // let file = fs.readText("codeeditor/resources/catppuccin-mocha.json");
            if !file {
                fmt.println("Failed to load theme");
                return;
            }

            let result = json.parse<VscodeTheme>(file);
            if !result {
                fmt.println("Failed to parse theme: ", result.error());
                return;
            }

            theme := result;
        };
        let compiledTokenColors = rx.computed<[]CompiledTokenColor>(() => {
            if !theme {
                return [];
            }

            let result: []CompiledTokenColor = [];

            for tokenColor in theme.tokenColors {
                let selectors: []str = [];

                if tokenColor.scope is str {
                    for part in tokenColor.scope.split(",") {
                        selectors.push(part.trim());
                    }
                } else {
                    selectors = tokenColor.scope;
                }

                result.push({
                    selectors: selectors,
                    settings: tokenColor.settings,
                });
            }

            return result;
        });
        let getScopeColor = (scope: str): Color | none => {
            let bestForeground: str | none = none;
            let bestLength = -1;

            for tokenColor in compiledTokenColors {
                for selector in tokenColor.selectors {
                    if selector.length >= bestLength &&
                    scopeSelectorMatches(selector, scope) &&
                    tokenColor.settings.foreground {

                        bestForeground = tokenColor.settings.foreground;
                        bestLength = selector.length;
                    }
                }
            }

            return bestForeground ? Color(bestForeground) : none;
        };


        // ui.onMounted(() => {
        //     load();
        // });
        load();
        loadTheme();

        let defaultTextColor = (): Color => "#FFF";

        // TextMate scope stacks go from least specific to most specific
        // (e.g. ["source.ts", "meta.block.ts", "keyword.control.ts"]), and
        // themes are meant to be matched against the *most specific* scope
        // first -- broad structural scopes like "meta.block" would otherwise
        // shadow the token's actual, more specific classification.
        let getFirstScopeColor = (scopes: []str): Color => {
            for (let i = scopes.length - 1; i >= 0; i--) {
                let color = getScopeColor(scopes[i]);
                if color {
                    return color;
                }
            }
            return defaultTextColor();
        }

        let texteditBehavior = textedit_behavior.Context({
            getLineLength: (lineIndex: int) => doc.lineLength(lineIndex),
            getLine: (lineIndex: int) => doc.line(lineIndex),
            getLineCount: () => doc.lineCount(),
            getTimeInSeconds: () => {
                return ui.now();
            },
            replaceRange: applyReplaceRange,
        });

        // Vim is an OPTIONAL behavior layered on the same engine. Toggling
        // it at runtime only swaps which behavior is installed -- the
        // engine, the document and the undo history are untouched, so you
        // keep your place and your history across the switch.
        let vim = vim_behavior.Vim(texteditBehavior);
        let vimOn = rx.reactive<bool>(true);

        let applyVimMode = (enabled: bool) => {
            if enabled {
                vim.install();
                vim_behavior.applyRemaps(vim, vim_behavior.defaultVimrc());
                texteditBehavior.setMode(textedit_behavior.Mode.Normal);
            } else {
                // Detaching the behavior returns the engine to plain
                // textbox handling: keys fall through to the default
                // bindings and the caret goes back to sitting BETWEEN
                // characters (Insert-mode clamping).
                texteditBehavior.clearBehavior();
                texteditBehavior.setMode(textedit_behavior.Mode.Insert);
            }
        };
        applyVimMode(true);

        let toggleVim = () => {
            let next = !rx.get(vimOn);
            vimOn := next;
            applyVimMode(next);
        };

        // Scroll state for the text area. The editor owns it (it knows
        // the content size); the scroll component owns the maths.
        let scroll = ui_components.ScrollState();
        scroll.overflowY = ui_components.Overflow.Auto;
        scroll.overflowX = ui_components.Overflow.Hidden;
        // Handle on the text area element, so the render pass can read
        // its measured size (the viewport height the scroll maths needs).
        let editorRef: ui_components.ElementRef<ui_elements.DivElement> =
            rx.shallowReactive<ui_components.ElementWrapper<ui_elements.DivElement> | null>(null);

        // Set after anything that moves the caret, so the next frame
        // scrolls it back into view. A flag rather than an immediate
        // scroll because the viewport size is only known during render.
        let caretFollow = rx.reactive<bool>(false);

        // Mouse selection: pointer position -> document position, then
        // click places the caret and drag extends the selection, exactly
        // like a browser text area (and like vim's own mouse support).
        let mouseSelecting = rx.reactive<bool>(false);

        // Pointer position (window space) -> document (column, line).
        // Rounds to the NEAREST character boundary horizontally, like a
        // browser: clicking the right half of a glyph puts the caret
        // after it, which is what makes click-to-place feel right.
        let documentPositionAt = (pointer: Vec2): Vec2i => {
            let charSize = ui.measureText("X");
            let editorEl = rx.get(editorRef);
            let originX = 0.0;
            let originY = 0.0;
            if editorEl {
                let pos = editorEl.position();
                if pos {
                    originX = pos.x;
                    originY = pos.y;
                }
            }
            let localX = pointer.x - originX;
            let localY = pointer.y - originY + rx.get(scroll.scrollTop);

            let lineIndex = 0;
            if charSize.y > 0.0 {
                lineIndex = (localY / charSize.y) as int;
            }
            lineIndex = text_document.clampIndex(lineIndex, doc.lineCount());

            let column = 0;
            if charSize.x > 0.0 {
                column = ((localX / charSize.x) + 0.5) as int;
            }
            if column < 0 {
                column = 0;
            }
            let maxColumn = texteditBehavior.maxColumn(lineIndex);
            if column > maxColumn {
                column = maxColumn;
            }
            let result: Vec2i = { x: column, y: lineIndex };
            return result;
        };

        let state = getState();

        // Live highlighting, incrementally.
        //
        // The document reports exactly which lines an edit replaced
        // (ChangeSet), and the syntax engine speaks that same shape: it
        // keeps a per-line rule-stack cache, retokenizes from the changed
        // line, and stops as soon as the stack reconverges. Editing one
        // line in a 5000-line file costs ~0.4ms instead of the ~24ms a
        // full reparse takes, so this runs on every edit with no debounce
        // and the colours never lag behind what you typed.
        //
        // Opening a block comment (which genuinely does recolour
        // everything below it) still cascades correctly -- the engine
        // simply keeps going until the rule stack matches again.
        let highlightUri = "buffer";
        if cache.data.file {
            highlightUri = cache.data.file as str;
            state.highlightEngine.sendOpenDocument(highlightUri, doc.text());
        }

        doc.addChangeListener((change: text_document.ChangeSet) => {
            let newLines: []str = [];
            for (let i = 0; i < change.insertedCount; i++) {
                newLines.push(doc.lineText(change.startLine + i));
            }
            state.highlightEngine.sendDocumentChange(
                highlightUri, change.startLine, change.removedCount, newLines);
        });

        // Hover used to be requested every time the cursor moved, including
        // every single keystroke while typing (typing moves the cursor) --
        // each one kicking off a tsserver + LSP round trip. Typing quickly
        // queued requests faster than they drained, and editing ground to a
        // halt. Debounce instead: only ask for hover once the cursor has
        // been still for a bit, and only if it's actually at a new position.
        let hoverDebounceSeconds = 0.2;
        let lastEditAt = rx.reactive<real>(-1000.0);
        let lastHoverPos = rx.reactive<Vec2i | none>(none);

        // Exponentially-smoothed FPS, recomputed alongside the LSP drain
        // below since that's already the one thing guaranteed to re-run
        // every frame (it depends on ui.now()).
        let lastFrameAt = rx.reactive<real>(0.0);
        let fps = rx.reactive<real>(0.0);
        let fpsText = rx.computed(() => f"{fps as int} FPS");

        // Status-bar label for the active editing model / vim mode.
        let modeLabel = rx.computed(() => {
            if !rx.get(vimOn) {
                return "INSERT (vim off - F2)";
            }
            let mode = rx.get(texteditBehavior.mode);
            if mode == textedit_behavior.Mode.Insert { return "-- INSERT --"; }
            if mode == textedit_behavior.Mode.Visual { return "-- VISUAL --"; }
            if mode == textedit_behavior.Mode.VisualLine { return "-- VISUAL LINE --"; }
            if mode == textedit_behavior.Mode.VisualBlock { return "-- VISUAL BLOCK --"; }
            return "-- NORMAL --";
        });
        let modeColor = rx.computed((): Color => {
            if !rx.get(vimOn) {
                return "#888" as Color;
            }
            let mode = rx.get(texteditBehavior.mode);
            if mode == textedit_behavior.Mode.Insert { return "#7FD97F" as Color; }
            if textedit_behavior.modeIsVisual(mode) { return "#D9B87F" as Color; }
            return "#7FA8D9" as Color;
        });

        let prevUpdate = ui.now();

        let lspMemStat = rx.reactive<str | none>(none);

        let updateStats = () => {
            if !vueBridge {
                return;
            }
            let memory = vueBridge.getSystemMemoryUtilization();

            let vue = memory.vue ? memory.vue / 1024 / 1024 : "?";
            let ts = memory.ts ? memory.ts / 1024 / 1024 : "?";

            lspMemStat := f"Vue LSP Memory: {vue} MiB | TypeScript LSP Memory: {ts} MiB";
        };

        let runLspLoop = rx.computed(() => {
            let now = ui.now();

            let dt = now - lastFrameAt;
            lastFrameAt := now;
            if dt > 0.0 {
                fps := fps * 0.9 + (1.0 / dt) * 0.1;
            }

            if now - prevUpdate > 0.5 {
                updateStats();
                prevUpdate = now;
            }

            drainHighlightResults();

            if vueBridge && cache.data.file {
                vueBridge.openDocument(cache.data.file, "vue", 1, doc.text());

                if now - lastEditAt > hoverDebounceSeconds {
                    let cursor = texteditBehavior.cursorPosition;
                    let curPos: Vec2i = { x: cursor.x, y: cursor.y };
                    let prevPos = rx.get(lastHoverPos);
                    let samePos = prevPos && prevPos.x == curPos.x && prevPos.y == curPos.y;
                    if !samePos {
                        lastHoverPos := curPos;
                        vueBridge.hover(curPos.y, curPos.x, (text: str | null) => {
                            hoverResult := text ? text : "(no hover info at this position)";
                        });
                    }
                }

                vueBridge.loop();
            }
        });

        // Split ONE line's text into coloured runs, given only the tokens
        // that belong to that line. The old version scanned the whole
        // document's token list for every line, which is O(lines x tokens)
        // -- quadratic, re-run on every keystroke, and the main reason
        // typing froze. Tokens are bucketed by line once (see
        // `tokensByLine`) so this only ever walks its own line's tokens.
        let splitLineTokens = (lineText: str, tokens: []Token): []HighlightToken => {
            let parts: []HighlightToken = [];
            let position = 0;

            for token in tokens {
                if position < token.startIndex && token.startIndex <= lineText.length {
                    parts.push({
                        text: lineText.slice(position, token.startIndex),
                        color: defaultTextColor(),
                    });
                }
                let tokenEnd = token.endIndex < lineText.length ? token.endIndex : lineText.length;
                if tokenEnd > token.startIndex {
                    parts.push({
                        text: lineText.slice(token.startIndex, tokenEnd),
                        color: getFirstScopeColor(token.scopes),
                    });
                    position = tokenEnd;
                }
            }

            if position < lineText.length {
                parts.push({
                    text: lineText.slice(position, lineText.length),
                    color: defaultTextColor(),
                });
            }
            return parts;
        };

        // Tokens grouped by line index, rebuilt only when a new highlight
        // result arrives -- one pass over the token list instead of one
        // pass per line.
        let tokensByLine = rx.computed(() => {
            rx.get(tokenCacheVersion);
            return rx.get(tokenCache);
        });

        // The coloured runs for a single line, computed on demand. Only
        // VISIBLE lines are ever asked for (see the render loop's use of
        // scroll.visibleRange), so frame cost is O(lines on screen) rather
        // than O(lines in file).
        let highlightedLine = (lineIndex: int): []HighlightToken => {
            let lineText = doc.lineText(lineIndex);
            let buckets: [][]Token = rx.get(tokensByLine);
            let tokensForLine: []Token = [];
            if lineIndex < buckets.length {
                tokensForLine = buckets[lineIndex];
            }
            return splitLineTokens(lineText, tokensForLine);
        };

        return () => {
            ui.div({
                id: 0,
                presets: [
                    presets.col(),
                    presets.wGrow(),
                    presets.hGrow(),
                    presets.textColor("#FFF"),
                    presets.p(4),
                    presets.gap(2),
                ]
            }, () => {
                ui.div({
                    id: 0,
                    presets: [
                        presets.row(),
                        presets.gap(8),
                    ]
                }, () => {
                    ui.text({
                        id: 0,
                        text: fpsText,
                    });

                    // Which editing model is active, and (in vim) which
                    // mode -- the same information vim's own statusline
                    // shows, because with modal editing you cannot tell
                    // what a keystroke will do without it.
                    ui.text({
                        id: 2,
                        text: modeLabel,
                        presets: [presets.textColor(modeColor)],
                    });

                    if lspMemStat {
                        ui.text({
                            id: 1,
                            text: lspMemStat,
                        });
                    }
                });

                rx.get(runLspLoop);

                ui.div({
                    id: 1,
                    ref: editorRef,
                    style: {
                        direction: ui_styling.Direction.Column,
                        fontFamily: "JetBrainsMonoNerdFont-Regular",
                        fontSize: 16.0,
                        textColor: "#FFF" as Color,
                    },
                    presets: [
                        presets.relative(),
                        presets.wGrow(),
                        presets.hGrow(),
                        presets.col(),
                        presets.bg("#181818"),
                        // presets.p(8),
                    ],
                    focusable: true,

                    // Wheel scrolls the text, exactly like any scroll
                    // container; the scroll model clamps at both ends.
                    onWheel: (event: ui_components.WheelEvent) => {
                        scroll.handleWheel(event.delta);
                    },

                    // Click places the caret, drag extends a selection --
                    // chrome's behavior, and what vim does with the mouse
                    // too (a drag puts vim into visual mode).
                    onPointerDown: (event: ui_components.PointerEvent) => {
                        let target = documentPositionAt(event.pos);
                        mouseSelecting := true;
                        if rx.get(vimOn) {
                            // Leave whatever visual selection existed, then
                            // place the caret; a subsequent drag re-enters
                            // visual mode from here.
                            texteditBehavior.setMode(textedit_behavior.Mode.Normal);
                            texteditBehavior.clearSelection();
                        } else {
                            texteditBehavior.clearSelection();
                        }
                        texteditBehavior.moveTo(target, true, false);
                    },
                    onPointerMove: (event: ui_components.PointerEvent) => {
                        if !rx.get(mouseSelecting) {
                            return;
                        }
                        let target = documentPositionAt(event.pos);
                        if rx.get(vimOn) {
                            // Dragging in vim selects: enter visual mode on
                            // the first movement, then extend.
                            let mode = rx.get(texteditBehavior.mode);
                            if !textedit_behavior.modeIsVisual(mode) {
                                texteditBehavior.setSelectionAnchor(texteditBehavior.cursor());
                                texteditBehavior.setMode(textedit_behavior.Mode.Visual);
                            }
                            texteditBehavior.moveTo(target, true, true);
                        } else {
                            texteditBehavior.moveTo(target, true, true);
                        }
                    },
                    onPointerUp: (event: ui_components.PointerEvent) => {
                        // Ending a drag also settles the caret, which is
                        // what keeps a click-drag-release selection stable.
                        mouseSelecting := false;
                        texteditBehavior.moveTo(documentPositionAt(event.pos), true, rx.get(mouseSelecting));
                    },
                    onTextInput: (event: ui_components.TextInputEvent) => {
                        // With Vim active, printable characters are
                        // commands in normal/visual mode and literal text
                        // in insert mode -- the behavior decides which.
                        if rx.get(vimOn) {
                            texteditBehavior.handleTextInput(event.text);
                        } else {
                            texteditBehavior.insertText(event.text);
                        }
                        caretFollow := true;
                        lastEditAt := ui.now();
                        hoverResult := null;
                    },
                    onKeyDown: (event: ui_components.KeyboardEvent) => {
                        let ctrl = hasModifier(event.modifiers, KeyModifiers.Ctrl);
                        let shift = hasModifier(event.modifiers, KeyModifiers.Shift);
                        let alt = hasModifier(event.modifiers, KeyModifiers.Alt);

                        // F2 toggles the vim editing model at runtime.
                        // Handled before anything else so it works in
                        // every mode, including vim's insert mode.
                        if event.key == ui_components.Key.F2 {
                            toggleVim();
                            return;
                        }

                        // Any key may move the caret, so ask the next
                        // frame to scroll it back into view.
                        caretFollow := true;

                        if rx.get(vimOn) {
                            // Non-character keys (and modifier combos)
                            // reach Vim here; plain characters arrive via
                            // onTextInput above.
                            let name = vim_behavior.namedKey(keyEventName(event.key), ctrl, alt);
                            if name.length > 0 {
                                texteditBehavior.handleKey(name);
                                lastEditAt := ui.now();
                                hoverResult := null;
                            }
                            return;
                        }

                        if event.key == ui_components.Key.Left {
                            if ctrl { texteditBehavior.moveCursorWordLeft(shift); }
                            else { texteditBehavior.moveCursorLeft(shift); }
                        }
                        else if event.key == ui_components.Key.Right {
                            if ctrl { texteditBehavior.moveCursorWordRight(shift); }
                            else { texteditBehavior.moveCursorRight(shift); }
                        }
                        else if event.key == ui_components.Key.Up {
                            texteditBehavior.moveCursorUp(shift);
                        }
                        else if event.key == ui_components.Key.Down {
                            texteditBehavior.moveCursorDown(shift);
                        }
                        else if event.key == ui_components.Key.Home {
                            if ctrl { texteditBehavior.moveCursorDocumentStart(shift); }
                            else { texteditBehavior.moveCursorHome(shift); }
                        }
                        else if event.key == ui_components.Key.End {
                            if ctrl { texteditBehavior.moveCursorDocumentEnd(shift); }
                            else { texteditBehavior.moveCursorEnd(shift); }
                        }
                        else if event.key == ui_components.Key.Return {
                            texteditBehavior.insertNewline();
                        }
                        else if event.key == ui_components.Key.Backspace {
                            texteditBehavior.deleteBackward(ctrl);
                        }
                        else if event.key == ui_components.Key.Delete {
                            texteditBehavior.deleteForward(ctrl);
                        }
                        else if ctrl && event.key == ui_components.Key.A {
                            texteditBehavior.selectAll();
                        }
                        else if ctrl && event.key == ui_components.Key.C {
                            texteditBehavior.copy();
                        }
                        else if ctrl && event.key == ui_components.Key.X {
                            texteditBehavior.cut();
                        }
                        else if ctrl && event.key == ui_components.Key.V {
                            texteditBehavior.paste();
                        }

                        lastEditAt := ui.now();
                        hoverResult := null;
                    },
                }, () => {
                    let characterSize = ui.measureText("X");
                    let lineHeight = characterSize.y;
                    let lineCount = doc.lineCount();

                    // Keep the scroll model in sync with the content and
                    // the viewport, then clamp -- deleting the last lines
                    // must not leave the view scrolled past the end.
                    scroll.scrollHeight := lineCount as real * lineHeight;
                    let editorEl = rx.get(editorRef);
                    if editorEl {
                        let viewport = editorEl.size();
                        if viewport {
                            scroll.clientHeight := viewport.y;
                            scroll.clientWidth := viewport.x;
                        }
                    }
                    scroll.clampToBounds();

                    // Apply any scroll the engine asked for (vim's zz/zt/zb
                    // arrive as intents because the engine has no idea how
                    // tall the viewport is), then keep the caret on screen.
                    let cursorLine = texteditBehavior.cursorPosition.y;
                    let cursorTop = cursorLine as real * lineHeight;
                    let intent = rx.get(texteditBehavior.scrollIntent);
                    if intent == textedit_behavior.ScrollIntent.Center {
                        scroll.centerInView(cursorTop, lineHeight);
                    } else if intent == textedit_behavior.ScrollIntent.Top {
                        scroll.scrollToTop(cursorTop);
                    } else if intent == textedit_behavior.ScrollIntent.Bottom {
                        scroll.scrollToBottom(cursorTop, lineHeight);
                    } else if intent == textedit_behavior.ScrollIntent.Reveal {
                        scroll.scrollIntoView(cursorTop, lineHeight);
                    }
                    if intent != textedit_behavior.ScrollIntent.None {
                        texteditBehavior.clearScrollRequest();
                    }
                    if rx.get(caretFollow) {
                        scroll.scrollIntoView(cursorTop, lineHeight);
                        caretFollow := false;
                    }

                    let scrollY = rx.get(scroll.scrollTop);

                    // Only build elements for lines that are actually on
                    // screen. This is what makes idle and typing cost
                    // independent of document length -- the old loop built
                    // a div plus one text element per token for EVERY line
                    // in the file, every frame.
                    let range = scroll.visibleRange(lineHeight, lineCount, 2);
                    let firstLine = range.x;
                    let lastLine = range.y;

                    // Selection highlight, behind the text. Only visible
                    // lines are considered, same as the text itself.
                    for (let i = firstLine; i < lastLine; i++) {
                        let sel = texteditBehavior.selectionRangeForLine(i);
                        if sel {
                            // A line whose selection runs through its
                            // newline gets one extra character of
                            // highlight, so the newline is visible as
                            // selected -- and so an EMPTY line inside a
                            // linewise (V) selection still shows up
                            // instead of collapsing to zero width.
                            let columns = (sel.endCol - sel.startCol) as real;
                            if sel.includesLineEnd {
                                columns = columns + 1.0;
                            }
                            ui.div({
                                id: 100000 + i,
                                style: {
                                    width: columns * characterSize.x,
                                    height: lineHeight,
                                },
                                presets: [
                                    presets.absolute(),
                                    presets.top(i as real * lineHeight - scrollY),
                                    presets.left(sel.startCol as real * characterSize.x),
                                    presets.bg("#3391FF55"),
                                ]
                            }, () => {});
                        }
                    }

                    // The visible text, one absolutely-positioned row per
                    // line so scrolling is a translation rather than a
                    // relayout.
                    for (let i = firstLine; i < lastLine; i++) {
                        let tokens = highlightedLine(i);
                        ui.div({
                            id: 200000 + i,
                            presets: [
                                presets.absolute(),
                                presets.top(i as real * lineHeight - scrollY),
                                presets.left(0),
                                presets.row(),
                            ],
                        }, () => {
                            if tokens.length > 0 {
                                for t, ti in tokens {
                                    ui.text({ id: ti, text: t.text, presets: [presets.textColor(t.color)] });
                                }
                            }
                            else {
                                ui.text({ id: 0, text: "" });
                            }
                        });
                    }

                    // Caret. In vim's normal/visual modes it is a BLOCK
                    // covering the character it sits on (the caret is *on*
                    // a character there, not between two); in insert mode
                    // and with vim off it is the usual thin bar.
                    let mode = rx.get(texteditBehavior.mode);
                    let blockCaret = mode == textedit_behavior.Mode.Normal
                                  || textedit_behavior.modeIsVisual(mode);
                    let cursorPos = Vec2(
                        texteditBehavior.cursorPosition.x as real * characterSize.x,
                        cursorTop - scrollY,
                    );
                    ui.div({
                        id: 300001,
                        style: {
                            width: blockCaret ? characterSize.x : 1.0,
                            height: lineHeight,
                        },
                        presets: [
                            presets.absolute(),
                            presets.top(cursorPos.y),
                            presets.left(cursorPos.x),
                            texteditBehavior.cursorVisible
                                ? (blockCaret ? presets.bg("#FFFFFF99") : presets.bg("#FFF"))
                                : presets.bg("#00000000"),
                        ]
                    }, () => {});

                    // Scrollbar. Drawn last so it sits above the text,
                    // and only when the content actually overflows
                    // (Overflow.Auto). The thumb is draggable and the
                    // track is clickable -- see ScrollState.beginDragY.
                    if scroll.showsVerticalBar() {
                        let barWidth = scroll.style.size;
                        let trackHeight = scroll.verticalTrackLength();
                        let thumbTop = scroll.verticalThumbOffset();
                        let thumbHeight = scroll.verticalThumbLength();
                        let viewWidth = rx.get(scroll.clientWidth);

                        ui.div({
                            id: 400000,
                            style: { width: barWidth, height: trackHeight },
                            presets: [
                                presets.absolute(),
                                presets.top(0),
                                presets.left(viewWidth - barWidth),
                                presets.bg(scroll.style.trackColor),
                            ],
                            onPointerDown: (event: ui_components.PointerEvent) => {
                                let editorEl = rx.get(editorRef);
                                let originY = 0.0;
                                if editorEl {
                                    let pos = editorEl.position();
                                    if pos { originY = pos.y; }
                                }
                                scroll.beginDragY(event.pos.y - originY);
                            },
                            onPointerMove: (event: ui_components.PointerEvent) => {
                                if scroll.isDragging() {
                                    let editorEl = rx.get(editorRef);
                                    let originY = 0.0;
                                    if editorEl {
                                        let pos = editorEl.position();
                                        if pos { originY = pos.y; }
                                    }
                                    scroll.updateDrag(event.pos.y - originY);
                                }
                            },
                            onPointerUp: (event: ui_components.PointerEvent) => {
                                scroll.endDrag();
                                scroll.clampToBounds();
                                lastEditAt := ui.now();
                            },
                        }, () => {
                            ui.div({
                                id: 0,
                                style: { width: barWidth, height: thumbHeight },
                                presets: [
                                    presets.absolute(),
                                    presets.top(thumbTop),
                                    presets.left(0),
                                    presets.bg(scroll.isDragging()
                                        ? scroll.style.thumbActiveColor
                                        : scroll.style.thumbColor),
                                    presets.rounded(5),
                                ],
                            }, () => {});
                        });
                    }

                    if hoverResult {
                        ui.div({
                            id: 300002,
                            presets: [
                                presets.absolute(),
                                presets.top(cursorPos.y + characterSize.y + 10.0),
                                presets.left(cursorPos.x),
                                presets.bg("#181818"),
                                presets.border(1),
                                presets.borderColor("#4F4F4F"),
                                presets.rounded(2),
                            ]
                        }, () => {
                            ui.text({ id: 0, text: hoverResult });
                        });
                    }
                });
            });
        };
    });
}