
import app
import renderer
import ui_styling
import headwind
import textedit_behavior
import vim_behavior
import text_document
import unicode
import ui_elements
import ui_components
import ui_widgets
import filedialog
// Aliased because this file also has local things called "tabs" (the open
// tab list in UI()), and the module name would shadow confusingly.

// Vim editing model on/off. The textedit engine is the same either way;
// this only decides whether a vim_behavior.Vim is installed on top of it
// and therefore whether keys are interpreted as vim commands.
// TODO: surface this as a user setting rather than a compile-time
// constant. A function rather than a global `let` because module-level
// variables cannot hold multi-line initializers here.
fn vimEnabled(): bool {
    return true;
}

// The editor's font, as ONE definition used by both the text that gets
// rendered and every measurement taken of it.
//
// This must never be split into two places. `ui.measureText(text)` with no
// font arguments resolves the font from the LIVE RENDER STACK -- so it
// returns the editor's font when called during the render pass, but the
// application default when called from anywhere else. Event handlers
// (onPointerDown) and the per-frame pointer pump both run OUTSIDE the
// render tree, so a bare measureText() there silently measured a different
// font: 9px per character instead of the editor's 7px.
//
// Nothing looked wrong at column 0, and the 2px-per-column error was
// absorbed by the end-of-line clamp on short lines -- so it only showed up
// on lines long enough for the drift to still land inside the text, as a
// cursor that lagged further behind the mouse the further right you
// clicked. Any measurement used to convert pixels <-> columns MUST pass
// the font explicitly.
fn editorFontFamily(): str {
    return "JetBrainsMonoNerdFont-Regular";
}

fn editorFontSize(): real {
    return 16.0;
}

// Map the UI toolkit's physical Key onto the key NAMES vim_behavior
// understands. Only the non-character keys need naming -- printable
// characters come through onTextInput instead.
fn keyEventName(key: ui_components.Key): str {
    if key == ui_components.Key.Escape { return "Escape"; }
    if key == ui_components.Key.Return { return "Return"; }
    if key == ui_components.Key.Backspace { return "Backspace"; }
    if key == ui_components.Key.Tab { return "Tab"; }
    if key == ui_components.Key.Up { return "Up"; }
    if key == ui_components.Key.Down { return "Down"; }
    if key == ui_components.Key.Left { return "Left"; }
    if key == ui_components.Key.Right { return "Right"; }
    if key == ui_components.Key.Delete { return "Delete"; }
    if key == ui_components.Key.Home { return "Home"; }
    if key == ui_components.Key.End { return "End"; }
    if key == ui_components.Key.PageUp { return "PageUp"; }
    if key == ui_components.Key.PageDown { return "PageDown"; }
    // Letters, for Ctrl-combinations like <C-d>/<C-o>/<C-r>.
    if key == ui_components.Key.A { return "a"; }
    if key == ui_components.Key.D { return "d"; }
    if key == ui_components.Key.I { return "i"; }
    if key == ui_components.Key.O { return "o"; }
    if key == ui_components.Key.R { return "r"; }
    if key == ui_components.Key.U { return "u"; }
    if key == ui_components.Key.V { return "v"; }
    return "";
}

// The vim mode as a `when` clause spells it -- lowercase, matching the
// vocabulary vim's own documentation uses, so a rule reads
// `vimMode == 'normal'`. See ctxVimMode() in editor_keymap.hz.
fn vimModeContextName(mode: textedit_behavior.Mode): str {
    if mode == textedit_behavior.Mode.Insert { return "insert"; }
    if mode == textedit_behavior.Mode.Visual { return "visual"; }
    if mode == textedit_behavior.Mode.VisualLine { return "visualline"; }
    if mode == textedit_behavior.Mode.VisualBlock { return "visualblock"; }
    return "normal";
}

// vim's 'commentstring' for a file: ONE template with %s where the line's
// own text goes. Both line comments ("// %s") and languages that only have
// block comments ("<!-- %s -->") are expressed the same way, which is why
// vim models it as a single template -- see toggleComment in vim_behavior.
fn commentStringForFile(path: str): str {
    let lower = asciiLower(path);
    if lower.endsWith(".py") || lower.endsWith(".sh") || lower.endsWith(".bash")
        || lower.endsWith(".zsh") || lower.endsWith(".toml") || lower.endsWith(".yaml")
        || lower.endsWith(".yml") || lower.endsWith(".ini") || lower.endsWith(".conf") {
        return "# %s";
    }
    if lower.endsWith(".css") || lower.endsWith(".scss") || lower.endsWith(".less") {
        return "/* %s */";
    }
    if lower.endsWith(".html") || lower.endsWith(".htm") || lower.endsWith(".xml")
        || lower.endsWith(".svg") || lower.endsWith(".md") {
        return "<!-- %s -->";
    }
    if lower.endsWith(".lua") || lower.endsWith(".sql") {
        return "-- %s";
    }
    // Everything else this editor is likely to see -- ts/js/tsx/hz/c/rs/go.
    return "// %s";
}

// A .vue file has no single comment syntax: its <template> is HTML, its
// <script> is TypeScript and its <style> is CSS, and a comment written in
// the wrong one of those is not a comment at all.
//
// Which region a line is in is decided by scanning back for the nearest
// top-level block tag rather than by asking the syntax engine, because the
// per-line tokens this editor caches keep only text and colour -- the
// TextMate scopes that would answer it directly are dropped before they
// reach here. An SFC's blocks are top-level and unnested by construction,
// so the scan is reliable in practice.
fn vueCommentStringAt(doc: text_document.Document, line: int): str {
    let y = vim_behavior.clampInt(line, 0, doc.lineCount() - 1);
    for (let i = y; i >= 0; i--) {
        let text = doc.lineText(i).trim();
        if text.startsWith("<script") {
            return "// %s";
        }
        if text.startsWith("<style") {
            return "/* %s */";
        }
        if text.startsWith("<template") {
            return "<!-- %s -->";
        }
    }
    // Above every block tag -- the SFC's outermost level, which is markup.
    return "<!-- %s -->";
}

// No members: every instance equals every other, which is exactly what the
// autogenerated comparison says. (This used to spell that out by hand, back
// when a struct without a declared operator had no comparison at all.)
struct RootArgs {}


// The TextMate grammar a file is parsed with, chosen by its extension.
//
// This used to be the single constant "source.vue", which is why every
// file -- including this editor's OWN source -- was coloured by the Vue
// grammar, i.e. barely at all: outside an SFC's <template>/<script>, Vue
// treats a whole file as undifferentiated body text, so a .hz or .json
// buffer came out as one flat colour.
//
// The returned scope must be one the syntax engine can actually load (see
// loadGrammar in codeeditor/syntax-engine/syntax-engine.ts); "source.hz"
// is Haze's own grammar, the same one the VS Code extension ships.
//
// A file whose extension isn't listed deliberately gets a scope no
// grammar answers to, which the engine reports as "no tokens" -- plain
// unhighlighted text. That is the honest result for a language we have no
// grammar for, and far better than the previous behaviour of running an
// arbitrary file through the Vue grammar.
fn scopeNameForFile(path: str): str {
    if path.endsWith(".hz") { return "source.hz"; }
    if path.endsWith(".vue") { return "source.vue"; }
    if path.endsWith(".ts") || path.endsWith(".mts") || path.endsWith(".cts") { return "source.ts"; }
    if path.endsWith(".tsx") { return "source.tsx"; }
    if path.endsWith(".js") || path.endsWith(".mjs") || path.endsWith(".cjs") { return "source.js"; }
    if path.endsWith(".jsx") { return "source.js.jsx"; }
    // .jsonc has no grammar of its own here; the JSON one is close enough
    // and colours everything but the comments.
    if path.endsWith(".json") || path.endsWith(".jsonc") { return "source.json"; }
    if path.endsWith(".json5") { return "source.json5"; }
    if path.endsWith(".css") { return "source.css"; }
    if path.endsWith(".scss") { return "source.css.scss"; }
    if path.endsWith(".less") { return "source.css.less"; }
    if path.endsWith(".sass") { return "source.sass"; }
    if path.endsWith(".html") || path.endsWith(".htm") { return "text.html.basic"; }
    if path.endsWith(".md") { return "text.html.markdown"; }
    if path.endsWith(".yaml") || path.endsWith(".yml") { return "source.yaml"; }
    if path.endsWith(".toml") { return "source.toml"; }
    if path.endsWith(".graphql") || path.endsWith(".gql") { return "source.graphql"; }
    return "text.plain";
}

// How a file is announced to the Vue language server, or "" for a file it
// has no business seeing.
//
// The editor's one language server is vue-language-server with tsserver
// behind it, so it understands exactly the web languages below. Haze
// files (and anything else) are NOT among them: opening one as "vue" --
// which is what every file was announced as before this existed -- makes
// the server parse Haze source as an SFC and answer hovers from whatever
// it manages to make of it. Better to not open it at all, and simply have
// no hovers, until there is a Haze language server to ask instead.
fn lspLanguageIdForFile(path: str): str {
    if path.endsWith(".vue") { return "vue"; }
    if path.endsWith(".ts") || path.endsWith(".mts") || path.endsWith(".cts") { return "typescript"; }
    if path.endsWith(".tsx") { return "typescriptreact"; }
    if path.endsWith(".js") || path.endsWith(".mjs") || path.endsWith(".cjs") { return "javascript"; }
    if path.endsWith(".jsx") { return "javascriptreact"; }
    return "";
}

// A TextMate scope selector matches a token's scope if it is the whole
// scope, or a dot-separated prefix of it (e.g. "string" matches
// "string.quoted.double", but not "stringify").
fn scopeSelectorMatches(selector: str, scope: str): bool {
    if selector.length == 0 || selector.length > scope.length {
        return false;
    }
    if !scope.startsWith(selector) {
        return false;
    }
    return selector.length == scope.length || scope[selector.length] == b".";
}

// One semantically classified run of a single line, already resolved to
// the TextMate scope it should be coloured as.
//
// Deliberately carries a scope rather than the token type it came from:
// once the mapping below has run, a semantic token is exactly as
// colourable as a TextMate one, so the render path treats them alike and
// there is only ever one way a colour gets chosen.
//
// Offsets are BYTE offsets within the line, like everything else the
// editor stores.
ref struct SemanticToken {
    startIndex: int;
    endIndex: int;
    scope: str;
}

// The TextMate scope a semantic token is coloured as.
//
// The two systems name different things. A semantic token says what a
// symbol IS -- this identifier is a parameter, that one is a readonly
// property, this call is into the default library -- which is precisely
// what a regular-expression grammar cannot know. A theme, meanwhile,
// names colours by TextMate scope and nothing else: the editor's own
// default theme (obsidian-radiance-dark.json) has no `semanticTokenColors`
// block at all, so a mapping that went looking for one would silently
// colour nothing.
//
// Mapping onto scopes instead means semantic colours come out of the SAME
// theme entries the TextMate tokens already use -- so every theme works,
// the two layers cannot disagree about what a "constant" looks like, and
// the whole feature costs the render path one extra scope lookup. This is
// also what VS Code itself falls back to, and the scope names below are
// its table.
//
// An unrecognised type returns "", which the caller drops -- leaving the
// TextMate colour in place, which is the honest answer for a
// classification we have no opinion about.
fn semanticScopeFor(tokenType: str, tokenModifiers: int): str {
    let isStatic = hasSemanticModifier(tokenModifiers, 1);
    let isAsync = hasSemanticModifier(tokenModifiers, 2);
    let isReadonly = hasSemanticModifier(tokenModifiers, 3);
    let isDefaultLibrary = hasSemanticModifier(tokenModifiers, 4);

    if tokenType == "namespace" { return "entity.name.namespace"; }
    if tokenType == "class" {
        return isDefaultLibrary ? "support.class" : "entity.name.type.class";
    }
    if tokenType == "enum" { return "entity.name.type.enum"; }
    if tokenType == "interface" { return "entity.name.type.interface"; }
    if tokenType == "typeParameter" { return "entity.name.type.parameter"; }
    if tokenType == "type" {
        return isDefaultLibrary ? "support.type" : "entity.name.type";
    }
    if tokenType == "parameter" { return "variable.parameter"; }
    if tokenType == "variable" {
        if isDefaultLibrary { return "support.variable"; }
        return isReadonly ? "variable.other.constant" : "variable.other.readwrite";
    }
    if tokenType == "property" {
        if isDefaultLibrary { return "support.variable.property"; }
        return isReadonly ? "variable.other.constant.property" : "variable.other.property";
    }
    if tokenType == "enumMember" { return "variable.other.enummember"; }
    if tokenType == "function" {
        if isDefaultLibrary { return "support.function"; }
        return isAsync ? "entity.name.function.async" : "entity.name.function";
    }
    if tokenType == "method" {
        return isStatic ? "entity.name.function.member.static" : "entity.name.function.member";
    }
    return "";
}

// Total byte length of a document -- every line, plus the newline that
// separates each from the next.
//
// The same number doc.text().length would give, without building the
// string: this is only ever needed to tell a language server how much of
// the file to look at, and reassembling a whole file to count its bytes
// is what made the old per-frame open cost seconds.
fn documentByteLength(doc: text_document.Document): int {
    let count = doc.lineCount();
    if count == 0 {
        return 0;
    }
    let total = 0;
    for (let i = 0; i < count; i++) {
        total = total + doc.lineLength(i);
    }
    return total + count - 1;
}


// One resolved colour override for part of a line, ready to paint over
// whatever the TextMate layer put there. Both the semantic tokens and the
// bracket colours funnel into this one shape, so the render path has a
// single kind of overlay to apply rather than one per feature.
ref struct ColourOverride {
    startIndex: int;
    endIndex: int;
    color: Color;
}

ref struct State {
    highlightEngine: HighlightEngine;
    highlightCommands: []HighlightCommand = [];
    highlightResults: []HighlightResult = [];
    reactiveCounter: rx.Reactive<int>;

    // ONE language server for the whole application, shared by every tab.
    //
    // Emphatically not per-editor. A VueLspBridge owns a vue-language-server
    // process AND a tsserver behind it, which together are hundreds of
    // megabytes and take seconds to warm up -- so one per open file would
    // multiply the editor's entire memory footprint and startup cost by the
    // number of tabs, for no benefit whatsoever. It is also simply the wrong
    // model: LSP is inherently multi-document (every request names its file
    // by uri) and tsserver wants the whole PROJECT open at once to resolve
    // imports across files, which is exactly what several tabs of one
    // project are.
    lspBridge: VueLspBridge | none = none;

    // Take every reply addressed to `uri`, leaving the rest queued.
    //
    // Draining is DESTRUCTIVE, so with more than one editor open it cannot
    // be done globally: whichever consumer ran first would empty the queue
    // and silently swallow every other document's replies, leaving those
    // tabs permanently uncoloured (the engine sends a line's tokens exactly
    // once, when they change, so a dropped reply is never resent).
    //
    // Each editor therefore takes only what is addressed to it, and the
    // hover popup -- another document on the same connection -- does the
    // same with its own uri. A reply for a uri nobody claims stays in the
    // queue rather than being dropped, so a tab whose editor has not yet
    // mounted still gets the reply to the `open` it just sent.
    fn takeResultsFor(uri: str): []HighlightResult {
        let mine: []HighlightResult = [];
        let rest: []HighlightResult = [];
        for result in this.highlightResults {
            if result.uri == uri {
                mine.push(result);
            } else {
                rest.push(result);
            }
        }
        // Only pay for the rebuild when something was actually taken --
        // this runs once per editor per frame.
        if mine.length > 0 {
            this.highlightResults = rest;
        }
        return mine;
    }
}

extern C let g_state: State | none = none;

fn initState(state: State) {
    g_state = state;
}

fn getState() {
    let state = g_state;
    assert(state);
    return state;
}

ref struct HighlightToken {
    text: str;
    color: Color;
}

// ── Hover content ────────────────────────────────────────────────────────
//
// One run of lines from a hover payload, tagged with whether it is code.
// A hover is not a single kind of text: LSP's `contents` is markdown, and
// a typical reply interleaves fenced code blocks (the signature -- the
// part worth syntax colouring) with prose (the doc comment, which must NOT
// be run through a TypeScript grammar or every English word ends up
// coloured as an identifier).
ref struct HoverBlock {
    text: str;
    isCode: bool;
}

// Splits a hover payload into code/prose blocks.
//
// Two shapes arrive here, from the two channels vue_lsp_bridge merges:
//   - tsserver quickinfo `displayString`: BARE code, no markdown at all.
//     Nothing to strip, and it is the common case (it wins whenever it has
//     an answer), so it must not be mangled by markdown handling.
//   - LSP hover `contents.value`: markdown, where the signature sits in a
//     ```ts fence and the docs follow as prose.
//
// A payload with no fence at all is therefore treated as entirely code,
// which is exactly right for the quickinfo case and is also what VS Code
// does with a plaintext hover.
//
// Deliberately only handles fenced blocks rather than being a general
// markdown renderer: fences are the only construct that changes how text
// must be COLOURED, which is the single thing this function exists to
// decide. Inline markup (`*emphasis*`, backtick spans) affects styling
// only, and is left as literal text rather than half-rendered.
fn parseHoverBlocks(payload: str): []HoverBlock {
    let blocks: []HoverBlock = [];
    let lines = payload.split("\n");
    let fence = "```";

    // The block currently being accumulated, built up as a string rather
    // than a list of lines. Written as one flat loop with no helper
    // closure on purpose: a closure that reassigns a captured array
    // (`current = []`) does NOT clear the caller's copy in this compiler
    // -- only in-place mutation such as push() is visible outside -- so a
    // flush-helper silently accumulated every block into the next one.
    let current = "";
    let currentHasLines = false;
    let inCode = false;
    // Whether any fence was seen at all -- decides the no-markdown case.
    let sawFence = false;

    for line in lines {
        if line.trim().startsWith(fence) {
            sawFence = true;
            // A fence both closes the run before it and opens the next.
            // Blank runs between blocks carry no information and would
            // render as empty gaps in the popup.
            if currentHasLines && current.trim().length > 0 {
                blocks.push({ text: current, isCode: inCode });
            }
            current = "";
            currentHasLines = false;
            inCode = !inCode;
        }
        else {
            current = currentHasLines ? current + "\n" + line : line;
            currentHasLines = true;
        }
    }
    if currentHasLines && current.trim().length > 0 {
        blocks.push({ text: current, isCode: inCode });
    }

    // No fences anywhere: the whole payload is a bare signature (the
    // tsserver quickinfo case), so colour all of it as code.
    if !sawFence {
        let all: []HoverBlock = [];
        for block in blocks {
            all.push({ text: block.text, isCode: true });
        }
        return all;
    }
    return blocks;
}

// One edit, remembered until every reply that predates it has been
// consumed. See `pendingEdits` / `rebaseLine` in UI(): a highlight reply
// is phrased in the line numbers of the document as it was when the
// request went out, and these are what map those numbers onto the
// document as it is now.
// Where a hover popup sits, decided ONCE per popup.
//
// Placement depends on the popup's own measured size (to flip above/below
// and to keep its right edge in view), and moving the popup re-measures it
// -- so recomputing this every frame is a feedback loop that oscillates
// forever. It is computed on the first frame the size is known and then
// held: the content and the anchor are both fixed for as long as the popup
// is open, so there is nothing for a later frame to legitimately change.
ref struct HoverPlacement {
    x: real = 0.0;
    y: real = 0.0;
    // Sitting above the token (the default) rather than below it. Drives
    // the -1 translateY that lifts the popup by its own height.
    above: bool = true;
}

ref struct PendingEdit {
    version: int = 0;
    startLine: int = 0;
    removedCount: int = 0;
    insertedCount: int = 0;
}

ref struct TokenColorSettings {
    foreground?: str;
    fontStyle?: str;
};

ref struct TokenColor {
    name?: str;
    scope: str | []str;
    settings: TokenColorSettings;
};

ref struct VscodeTheme {
  // "dark" or "light". VS Code picks a different set of built-in default
  // colours per theme type, so this decides what a theme that defines no
  // bracket colours falls back to -- see defaultBracketColorHex.
  // OPTIONAL, not defaulted. A field with a default is still REQUIRED by
  // json.parse -- an absent one fails the whole parse ("JSON missing
  // field"), which for a theme means no colours at all rather than a
  // theme with one field missing. Every optional key below is spelled `?`
  // for that reason, and a theme is entitled to omit any of them.
  type?: str;
  // The theme's whole `colors` block, kept as a raw node rather than a
  // struct: its keys are dotted names like
  // "editorBracketHighlight.foreground1", which are not field names, and
  // only a handful of the ~200 entries are ever read. See themeColorValue.
  colors?: json.Node;
  // Whether this theme OPTS IN to semantic highlighting.
  //
  // Defaulting to false is not a guess, it is VS Code's rule:
  // `editor.semanticHighlighting.enabled` defaults to
  // "configuredByTheme", which means semantic tokens are applied only when
  // the theme asks for them with `"semanticHighlighting": true`. A theme
  // that says nothing gets none.
  //
  // This matters far more than it sounds. A theme's tokenColors are tuned
  // against what the GRAMMAR produces, so painting semantic tokens over a
  // theme that never asked for them repaints things the theme deliberately
  // styled -- object literal keys stop being `meta.object-literal.key` and
  // become `variable.other.property`, `const` bindings stop being plain
  // variables and become constants, and the file stops looking like the
  // theme's author intended. obsidian-radiance-dark.json does not opt in
  // (catppuccin-mocha.json does), which is exactly why this editor looked
  // wrong against VS Code showing the same file in the same theme.
  semanticHighlighting?: bool;
  tokenColors: []TokenColor = [];
};

ref struct CompiledTokenColor {
    selectors: []str;
    settings: TokenColorSettings;
}

// ── Scope colour memo ────────────────────────────────────────────────────
//
// Resolving one TextMate scope to a colour means scanning every selector
// of every theme entry (~465 prefix-compares for the bundled theme) with
// no early exit. That answer depends only on the scope string and the
// loaded theme, yet it used to be recomputed for every coloured run of
// every visible line on every frame -- profiling put it at ~23% of all
// non-profiler CPU time, the largest single cost in the idle editor.
//
// Open addressing with linear probing, same shape as chrome-trace.hz's
// ChildTable (there is no hash map in the stdlib). Sized for the few dozen
// distinct scopes a real file yields, and rebuilt wholesale when the theme
// changes rather than being invalidated entry by entry.

// An occupied slot's `hasColors` entry is what distinguishes "this scope
// has no theme rule" (a real, cacheable answer) from "not in the table yet"
// -- without it a miss and a colourless hit would be indistinguishable, and
// every unstyled scope would rescan the whole theme on every frame, which is
// exactly the cost this table exists to remove.

// Base-31 polynomial string hash, kept bounded by reducing mod a modulus
// small enough that `h * base + 255` cannot overflow -- the same
// arrangement, and for the same reason, as chrome-trace.hz's hashStrInto.
fn hashScope(s: str): int {
    let h = 0;
    for (let i = 0; i < s.length; i++) {
        h = (h * 31 + (s[i] as int)) % 1000000007;
    }
    return h;
}

ref struct ScopeColorCache {
    // Parallel arrays indexed by bucket. `used[b]` is what makes a bucket
    // occupied; keys[b] is only meaningful when it is set.
    used: []bool = [];
    keys: []str = [];
    colors: []Color = [];
    hasColors: []bool = [];
    count: int = 0;

    // Which themeGeneration these entries were resolved against; a
    // mismatch means the whole table is stale (see getScopeColor).
    generation: int = -1;

    fn constructor() {
        let cache = ScopeColorCache {};
        cache.reset(64);
        return cache;
    }

    // Drops every entry, keeping the current capacity -- a theme reload
    // replaces the answers, not the number of distinct scopes.
    mut fn clear(): void {
        this.reset(this.used.length > 0 ? this.used.length : 64);
    }

    mut fn reset(capacity: int): void {
        let used: []bool = [];
        let keys: []str = [];
        let colors: []Color = [];
        let hasColors: []bool = [];
        used.reserve(capacity);
        keys.reserve(capacity);
        colors.reserve(capacity);
        hasColors.reserve(capacity);
        for (let i = 0; i < capacity; i++) {
            used.push(false);
            keys.push("");
            colors.push(Color(0.0, 0.0, 0.0, 0.0));
            hasColors.push(false);
        }
        this.used = used;
        this.keys = keys;
        this.colors = colors;
        this.hasColors = hasColors;
        this.count = 0;
    }

    // Bucket for `scope`, probing forward past collisions. Returns the
    // index of either the matching entry or the first free slot, so both
    // lookup and insert can share one walk. The table is never allowed to
    // fill (see insert), so this always terminates.
    fn slotFor(scope: str, hash: int): int {
        let capacity = this.used.length;
        let slot = hash % capacity;
        while this.used[slot] && this.keys[slot] != scope {
            slot = (slot + 1) % capacity;
        }
        return slot;
    }

    // The slot holding `scope`, or -1 if the table has never resolved it.
    //
    // Deliberately an INDEX rather than a `ScopeColorHit | none`. A struct
    // inside a union is heap-boxed, so the old shape allocated one object
    // per lookup -- and a lookup happens for every scope of every token of
    // every visible line, on every frame. That made this single line one
    // of the largest allocation sites in the whole editor (~10k
    // allocations a second at rest), for a value the caller reads twice
    // and throws away. An int answers the same question and allocates
    // nothing; `colors`/`hasColors` are read directly at the slot.
    fn find(scope: str): int {
        if this.used.length == 0 {
            return -1;
        }
        let slot = this.slotFor(scope, hashScope(scope));
        if !this.used[slot] {
            return -1;
        }
        return slot;
    }

    mut fn insert(scope: str, color: Color | none): void {
        // Keep the load factor under ~70% so probe chains stay short, and
        // so slotFor always finds a free slot to stop on.
        if (this.count + 1) * 10 >= this.used.length * 7 {
            this.grow();
        }

        let slot = this.slotFor(scope, hashScope(scope));
        if !this.used[slot] {
            this.used[slot] = true;
            this.keys[slot] = scope;
            this.count = this.count + 1;
        }
        if color {
            this.colors[slot] = color;
            this.hasColors[slot] = true;
        }
        else {
            this.hasColors[slot] = false;
        }
    }

    // Doubles the table and re-seats every entry -- a bucket depends on
    // capacity, so the old positions mean nothing in the new table.
    mut fn grow(): void {
        let oldUsed = this.used;
        let oldKeys = this.keys;
        let oldColors = this.colors;
        let oldHasColors = this.hasColors;

        this.reset(oldUsed.length * 2);

        for (let i = 0; i < oldUsed.length; i++) {
            if oldUsed[i] {
                let slot = this.slotFor(oldKeys[i], hashScope(oldKeys[i]));
                this.used[slot] = true;
                this.keys[slot] = oldKeys[i];
                this.colors[slot] = oldColors[i];
                this.hasColors[slot] = oldHasColors[i];
                this.count = this.count + 1;
            }
        }
    }
}

@props
filePath: str;
// Whether this editor is the one the user is looking at. An inactive
// editor is still fully mounted and still drains its own highlight
// replies; it just must not act on input, since keyboard focus and the
// mouse belong to the visible tab (see the guards in the render pass).
active: bool = true;

@setup

// One open file: its document, its editing engine, its syntax token cache,
// its scroll position, its caret, its undo history and its language-server
// state. Everything that makes a tab a tab lives in here.
//
// This is deliberately a COMPONENT rather than a function the root calls
// with some state passed in, because the component system is what gives it
// a lifetime: one instance per open file, created when the file is opened
// and kept alive -- setup closure and all -- for exactly as long as that
// tab exists. Switching tabs merely hides it (`display: none`, see
// stdlib/tabs), so its scroll offset and caret are still there when you
// come back, without any of that state having to be lifted out and stored
// somewhere central.
//
// `filePath` is fixed for the instance's whole life. It is read once during
// setup to load the file and to open the document with the highlighter, and
// it doubles as the uri every reply for this tab is routed by -- which is
// what keeps one tab's tokens out of another's cache.

        // Captured ONCE, not read from props on each render. The path is
        // this instance's identity: the highlighter document, the caches
        // keyed by it and the loaded text all belong to this exact file,
        // so a path that changed underneath would leave every one of them
        // describing the previous file. The tab system never does that (a
        // different file is a different key, hence a different instance),
        // and pinning it here means nothing downstream has to defend
        // against it.
        let filePath = args.filePath;

        // The document. Lines are mutated IN PLACE (see
        // stdlib/text_document): typing a character is one String.insert
        // on one line, not a rebuild of the line array and not a
        // reassembly of the whole file into a str. `docVersion` is bumped
        // by every edit so the render path can invalidate exactly what
        // changed instead of diffing content.
        let doc = text_document.Document();
        let docVersion = rx.reactive<int>(0);

        // Per-line syntax tokens, cached. Rebuilding these for the whole
        // document on every keystroke was the single biggest cost in the
        // old render path (O(lines x tokens) per frame); now a line's
        // tokens are recomputed only when that line actually changes.
        let lineTokens = rx.shallowReactive<[][]HighlightToken>([]);

        // ── Documents held open with the highlight engine ────────────────
        //
        // The engine keys its parse state by uri and echoes that uri back
        // on every reply, so more than one document can be open at once and
        // each reply still lands in the right cache. Two are used here: the
        // editor buffer, and the hover popup -- whose contents are coloured
        // by exactly the same machinery rather than by a second, lesser
        // copy of it, which is the whole point of routing by uri.
        //
        // The hover document's scope is TypeScript, not Vue: its text is a
        // bare signature (`function greet(name: string): number`), which the
        // Vue grammar treats as one undifferentiated run of SFC body text --
        // no colouring at all.
        //
        // The buffer's scope comes from the file's extension (see
        // scopeNameForFile), so a .hz file is coloured by Haze's own
        // grammar, a .ts file by the TypeScript one, and a .vue file by the
        // Vue one -- which embeds source.ts for its <script> blocks anyway.
        // Fixed for the instance's life, like filePath itself.
        let editorScopeName = scopeNameForFile(filePath);
        // Which language, if any, this file may be announced to the Vue
        // language server as. Empty means "none of its business" -- a Haze
        // file, say -- and switches the LSP off for this tab entirely.
        let lspLanguageId = lspLanguageIdForFile(filePath);
        // This editor's document uri with the highlight engine. The file
        // path IS the uri, which is what keeps every open tab a separate
        // document on the one connection: replies come back stamped with
        // it and are routed by it (see State.takeResultsFor), so two tabs
        // can be edited in the same frame without either one's tokens
        // landing in the other's cache. A buffer with no path on disk gets
        // a name derived from its tab id, for the same reason -- it still
        // has to be distinguishable from every other open document.
        let highlightUri = filePath.length > 0 ? filePath : f"buffer://{args.id}";
        // Per-EDITOR, not a single global name: every open tab has its own
        // hover popup, and they are all documents on the one engine
        // connection. Sharing one "__hover__" uri across tabs would make
        // each tab's hover overwrite the parse state of every other's and
        // send the replies to whichever editor drained first.
        let hoverHighlightUri = f"__hover__/{args.id}";
        let hoverScopeName = "source.ts";

        // Element ids inside the hover popup that must never collide with
        // the sequential ones (0..n) used for blocks and for code lines.
        //
        // The component system caches a parent's children by plain id and
        // FIXES each one's element type the first time it is seen (see
        // getOrCreateDiv in ui_components.hz, which hard-asserts on a type
        // change). Two things in the popup are structurally different from
        // a code line -- the "Loading..." placeholder and a prose block are
        // single text nodes, whereas a code block is a div per line -- and
        // both would otherwise land on id 0, the same id block 0 / line 0
        // takes. Every hover goes placeholder -> content, so that clash is
        // hit immediately and every time.
        //
        // Sharing an id would force the two shapes to agree at every depth
        // forever; giving them ids no block or line can ever reach makes
        // the subtrees independent instead, so each is free to have its
        // own shape. Far from the 0..n range for exactly that reason.
        let hoverPlaceholderId = 900001;
        let hoverProseId = 900002;

        // The file exactly as read from disk, kept until the highlighter
        // and the LSP have been handed their initial copy.
        //
        // Both of them need the whole document once at startup -- and we
        // ALREADY have it, straight from fs.readText. Splitting it into
        // lines and then re-joining those lines back into the identical
        // string (which is what doc.text() does) is two pointless
        // O(document) passes to reproduce a value we were holding all
        // along. So keep it, use it, then drop it.
        let initialText = rx.reactive<str | none>(none);

        // ── Saving, and the file underneath the buffer ───────────────────
        //
        // Three pieces of state, and they are separate on purpose:
        //
        //   dirty     the buffer differs from what WE last wrote or read.
        //   disk*     the file's identity on disk as of that same moment.
        //   diverged  both of the above moved apart -- the buffer has
        //             unsaved changes AND the file has been rewritten by
        //             something else since we last looked.
        //   conflict  the modal asking about that divergence is on screen.
        //
        // Only a divergence is ever a question for the user. A clean buffer
        // over a changed file reloads silently (that is what makes two
        // editors on one file stay in step), and a dirty buffer over an
        // unchanged file saves silently. It is exactly the case where both
        // are true that has no safe automatic answer, because every
        // available answer destroys somebody's work.
        //
        // `diverged` and `conflict` are two flags rather than one because
        // Cancel takes the dialog away without making the two versions
        // agree. Collapsing them would mean that cancelling re-armed the
        // autosave, and the next time focus left the editor it would
        // silently perform the overwrite the user had just declined.

        // Unsaved changes. Reactive because the tab strip draws it -- see
        // documents.hz for why the flag lives on the editor and the tab
        // reads it rather than the other way round.
        let dirty = rx.reactive<bool>(false);
        // The buffer and the file have both moved since they last agreed.
        // While this is set, NOTHING writes this file automatically.
        let diverged = rx.reactive<bool>(false);
        // The modal is up for this document.
        let conflict = rx.reactive<bool>(false);
        // The disk copy that raised the conflict, read once and held so
        // that answering "discard" does not have to go back to the file --
        // which may have moved on again in the meantime, making the answer
        // apply to something the question was never about.
        let pendingDiskText = rx.reactive<str | none>(none);

        // The file's stat as of our own last read or write.
        //
        // Plain boxes rather than reactives: nothing renders them, and they
        // are written from closures, which capture a local by VALUE -- a
        // bare `let mtime = 0` reassigned inside one closure would simply
        // not be visible to the next (see the same pattern in
        // lastFrameAt/smoothedFps further down).
        //
        // mtime AND size, because either one alone lies: a filesystem with
        // one-second timestamp granularity misses a rewrite inside the same
        // second, and a rewrite that happens to preserve the length is
        // invisible to size. Together they miss only a same-second rewrite
        // to the identical length, which the content comparison below then
        // catches anyway.
        let diskMtime: ref Box<int> = { value: 0 };
        let diskSize: ref Box<int> = { value: 0 };
        let diskKnown: ref Box<bool> = { value: false };

        // Adopt the file's current identity as "what we last saw".
        //
        // Called after every read and every write of our own, and that is
        // what keeps the watcher from reporting our OWN save as somebody
        // else's edit -- which it otherwise would, every single time, since
        // a write is exactly what changes an mtime.
        let rememberDiskState = (): void => {
            if filePath.length == 0 {
                return;
            }
            let stat = fs.statFile(filePath);
            if stat {
                let state = stat as fs.FileState;
                diskMtime.value = state.mtime;
                diskSize.value = state.size;
                diskKnown.value = true;
            }
            else {
                diskKnown.value = false;
            }
        };

        // Status-line feedback: what the last save, reload or ex command
        // did. One line, replaced each time -- vim's own message area, and
        // the only channel an ex command has to answer through.
        let statusMessage = rx.reactive<str>("");

        let load = () => {
            if filePath.length == 0 {
                return;
            }
            let file = fs.readText(filePath);
            if file {
                let text = file as str;
                doc.setText(text);
                initialText := text;
                docVersion := rx.get(docVersion) + 1;
                // Stat AFTER the read, not before: a file rewritten
                // between the two would otherwise be recorded as the
                // version we are holding, and the change would never be
                // noticed. This way the worst case is one spurious reload
                // of a file we already have.
                rememberDiskState();
            }
            else {
                fmt.println(f"Failed loading file: {filePath}");
            }
        };

        // The single mutation primitive textedit_behavior drives. Cost is
        // proportional to the EDIT, not to the document: within-line edits
        // touch one line, multi-line edits touch only the lines they span.
        let applyReplaceRange = (start: Vec2i, end: Vec2i, text: String): void => {
            doc.replaceRange(start, end, text.cloneString());
            docVersion := rx.get(docVersion) + 1;
        };

        // The application's one language server, not this editor's -- see
        // State.lspBridge. Every tab talks to the same connection and is
        // told apart by the uri on each request, which is how LSP is meant
        // to be used and what keeps one vue-language-server + tsserver pair
        // serving the whole project instead of one pair per open file.
        // Deliberately NOT captured into a local here, the way it used to
        // be. The bridge is REPLACED whenever the workspace changes (new
        // folder, new project root, new server processes -- see
        // restartLanguageServers in workspace.hz), and a tab holding the
        // one it was mounted with would go on talking to a connection
        // whose processes have exited. Every use below re-reads
        // getState().lspBridge instead.

        // ── Hover state ──────────────────────────────────────────────
        //
        // A hover is a REQUEST at a position, not a thing that happens on
        // its own. `hoverRequest` is that position (none = no hover wanted,
        // so nothing is shown and nothing is asked of the language server);
        // `hoverResult` is the answer once it arrives. Keeping the request
        // separate from the answer is what lets the popup show a loading
        // placeholder in the gap between the two, and what keeps a stale
        // answer from outliving the request that produced it.
        //
        // Who sets the request depends on the editing model, and the two
        // are deliberately different because the editors they imitate are:
        //   - no vim: the mouse does, after dwelling (see hoverDwell).
        //   - vim:    only an explicit keypress does (see hoverKeyPressed).
        let hoverRequest = rx.reactive<Vec2i | none>(none);
        let hoverResult = rx.reactive<str | null>(null);
        // Anchor in WINDOW pixels for the popup. The cursor position is the
        // right anchor for the vim path but not the mouse path, where the
        // popup belongs at the pointer, which may be nowhere near the caret.
        let hoverAnchor = rx.reactive<Vec2 | none>(none);

        // Where the current popup sits, resolved once from its measured
        // size -- see HoverPlacement. `none` means "not measured yet", in
        // which case the popup is laid out but not drawn.
        let hoverPlacement = rx.reactive<HoverPlacement | none>(none);

        // Drops whatever hover is on screen and cancels any pending one.
        // Called from every input path that invalidates it: typing, moving
        // the caret, scrolling, or moving the mouse away.
        let dismissHover = () => {
            hoverRequest := none;
            hoverResult := null;
            hoverAnchor := none;
            // Must be cleared with the rest: a stale placement is one
            // computed for the PREVIOUS popup's size and anchor, so keeping
            // it would flash the next hover at the old one's position for a
            // frame before it re-resolves.
            hoverPlacement := none;
        };

        // ── Hover popup contents ─────────────────────────────────────────
        //
        // The payload split into code/prose blocks, recomputed only when a
        // new hover answer arrives.
        let hoverBlocks = rx.computed(() => {
            let pending = rx.get(hoverResult);
            if !pending {
                let empty: []HoverBlock = [];
                return empty;
            }
            return parseHoverBlocks(pending as str);
        });

        // The exact text handed to the highlight engine: the code blocks
        // only, joined back together. Prose is excluded deliberately -- run
        // through a TypeScript grammar it would come back with English
        // words coloured as identifiers and keywords.
        //
        // This is also the line space the engine's reply is phrased in, so
        // the popup renderer must walk THESE lines (not the payload's) when
        // pairing tokens with text. Keeping one computed as the single
        // source of both is what keeps those two in step.
        let hoverCodeText = rx.computed(() => {
            let blocks: []HoverBlock = rx.get(hoverBlocks);
            let text = "";
            let first = true;
            for block in blocks {
                if block.isCode {
                    text = first ? block.text : text + "\n" + block.text;
                    first = false;
                }
            }
            return text;
        });

        // Hand the popup's code to the engine as its own document, under
        // its own uri and the TypeScript grammar. Sent as a full "open"
        // every time rather than a "change": the text is replaced wholesale
        // on each new hover, so there is no incremental edit to describe,
        // and re-opening the same uri simply discards the previous parse.
        //
        // A computed, so this fires exactly when the code text changes --
        // one request per hover answer, not one per frame.
        let lastHoverCodeSent = rx.reactive<str>("");
        let hoverHighlightRequester = rx.computed(() => {
            let code: str = rx.get(hoverCodeText);
            let sent: str = rx.get(lastHoverCodeSent);
            if code == sent {
                return 0;
            }
            lastHoverCodeSent := code;
            if code.length == 0 {
                return 0;
            }
            getState().highlightEngine.sendOpenDocument(
                hoverHighlightUri, code, 0, hoverScopeName);
            return 0;
        });

        // This editor's replies, and only its own. The queue is shared by
        // every open tab plus every hover popup, so taking the whole thing
        // (which is what this used to do) meant the first editor to drain
        // swallowed all the others' replies -- and the engine never resends
        // a line's tokens, so those tabs would simply stay uncoloured.
        let highlights = rx.computed(() => {
            let state = getState();
            rx.get(state.reactiveCounter);
            let mine = state.takeResultsFor(highlightUri);
            let hover = state.takeResultsFor(hoverHighlightUri);
            for result in hover {
                mine.push(result);
            }
            return mine;
        });

        // Persistent per-line token cache.
        //
        // An incremental reply carries tokens ONLY for the lines whose
        // highlighting changed, so results must be merged into this cache
        // rather than replacing it -- rebuilding from the latest reply
        // alone would blank every other line in the file.
        let tokenCache = rx.shallowReactive<[][]Token>([]);
        let tokenCacheVersion = rx.reactive<int>(0);

        // ── Bracket pair colourisation state ─────────────────────────────
        //
        // VS Code has this on by default (`editor.bracketPairColorization
        // .enabled`), and so does this.
        let bracketColorizationEnabled = true;

        // Per-line bracket tokens, and the stack of OPEN bracket kinds at
        // the START of each line.
        //
        // The stack is what makes rescanning incremental, and it is the
        // same trick the syntax engine already uses with its per-line rule
        // stack: after an edit, rescanning can stop as soon as a line's
        // starting stack matches what was recorded there before, because
        // every line below then produces exactly what it produced last
        // time. Without it, one keystroke would rescan the whole file.
        let bracketTokens = rx.shallowReactive<[][]BracketToken>([]);
        let bracketCacheVersion = rx.reactive<int>(0);
        let bracketStacks: [][]int = [];
        // The SFC region each line STARTS in, carried alongside the stack
        // for the same reason: which characters even count as brackets
        // changes between a .vue file's <template> and its <script>, so a
        // rescan cannot be said to have reconverged until BOTH match.
        let bracketRegions: []int = [];
        // A file that is not an SFC is all code, so its region never moves.
        let bracketRootRegion = lspLanguageId == "vue"
            ? BracketRegionNone : BracketRegionCode;

        // Scratch space for the bracket rescan's running stack, kept for
        // the life of the editor rather than allocated per rescan. See
        // refreshBrackets.
        let bracketScanStack: []int = [];

        // ── Shared empty lists ───────────────────────────────────────────
        //
        // "This line has no tokens / no overrides" is answered thousands of
        // times a second (once per line per frame, on every layer), and
        // writing `[]` for it each time is a real heap allocation each
        // time. These stand in for all of them. Nothing may ever push into
        // one: they are handed out by reference, so a single push would be
        // visible everywhere at once. Every consumer below only reads.
        let noTokens: []Token = [];
        let noSemanticTokens: []SemanticToken = [];
        let noBracketTokens: []BracketToken = [];
        let noOverrides: []ColourOverride = [];

        // The line range whose bracket INPUT changed and so must be
        // rescanned no matter what: `from` is where rescanning starts, and
        // `through` is the last line that may not take the convergence
        // shortcut above.
        //
        // Both are needed, and conflating them is a real bug rather than a
        // simplification. Tokens change over a RANGE (opening a block
        // comment retokenizes every line it swallows), and inside that
        // range a line's brackets can change while the starting stack does
        // not -- a comment that swallows a balanced `{ ... }` leaves the
        // stack identical on both sides of it. Converging early there
        // would leave those brackets painted as code.
        let bracketCleanLine = 1000000000;
        let bracketDirtyFrom = rx.reactive<int>(0);
        let bracketDirtyThrough = rx.reactive<int>(1000000000);

        let markBracketsDirty = (fromLine: int, throughLine: int) => {
            if !bracketColorizationEnabled {
                return;
            }
            let firstLine = fromLine < 0 ? 0 : fromLine;
            if firstLine < rx.get(bracketDirtyFrom) {
                bracketDirtyFrom := firstLine;
            }
            if throughLine > rx.get(bracketDirtyThrough) {
                bracketDirtyThrough := throughLine;
            }
        };

        // Mirror an edit's structural change into the bracket caches, for
        // the same reason spliceTokenCache does it for the TextMate ones:
        // both are addressed by line number, so they have to already be in
        // the document's new index space before anything reads them.
        let spliceBracketCaches = (startLine: int, removedCount: int, insertedCount: int) => {
            if removedCount == insertedCount {
                // Nothing moved -- the common case (typing, backspace, an
                // in-place replace). The lines themselves are rescanned
                // anyway; only their POSITIONS would need fixing here.
                return;
            }
            let buckets: [][]BracketToken = rx.get(bracketTokens);
            if startLine > buckets.length || startLine > bracketStacks.length {
                return;
            }
            let removableTokens = removedCount;
            if startLine + removableTokens > buckets.length {
                removableTokens = buckets.length - startLine;
            }
            for (let i = 0; i < removableTokens; i++) {
                buckets.remove(startLine);
            }
            for (let i = 0; i < insertedCount; i++) {
                let empty: []BracketToken = [];
                buckets.insert(startLine + i, empty);
            }
            bracketTokens := buckets;

            let removableStacks = removedCount;
            if startLine + removableStacks > bracketStacks.length {
                removableStacks = bracketStacks.length - startLine;
            }
            for (let i = 0; i < removableStacks; i++) {
                bracketStacks.remove(startLine);
                if startLine < bracketRegions.length {
                    bracketRegions.remove(startLine);
                }
            }
            for (let i = 0; i < insertedCount; i++) {
                // A placeholder stack, immediately overwritten by the
                // rescan the edit also schedules. It only has to exist so
                // the array stays as long as the document.
                let empty: []int = [];
                bracketStacks.insert(startLine + i, empty);
                bracketRegions.insert(startLine + i, bracketRootRegion);
            }
        };

        // Apply an edit's STRUCTURAL change to the cache: the same
        // splice the document and the engine both just performed.
        //
        // Without this the cache was resized only at its END (append or
        // pop until the length matched), which is correct exactly when the
        // edit was on the last line and wrong everywhere else. Inserting a
        // line at N left every cached bucket below N sitting one index too
        // high -- line N+1 rendered with line N's colours, all the way
        // down -- and since the engine only ever re-sends the handful of
        // lines whose TOKENS changed, nothing afterwards ever put them
        // back. That is why a single blank line permanently wrecked the
        // highlighting below it.
        //
        // The engine splices its own caches identically (see
        // changeDocument in syntax-engine.ts); this keeps the two in the
        // same index space, which is the whole premise of merging replies
        // by line number.
        let spliceTokenCache = (startLine: int, removedCount: int, insertedCount: int) => {
            if removedCount == 0 && insertedCount == 0 {
                return;
            }
            // A same-line edit -- one line removed, one inserted, at the
            // same index -- is not a structural change at all; it is
            // typing, backspace, or a small in-place replace (see the
            // startY == endY fast path in text_document.replaceRange). No
            // buckets actually need to move, so leave this one exactly as
            // it is instead of clearing it to empty: the stale tokens are
            // still a reasonable rendering of the line for however many
            // frames it takes the engine's reply to arrive, whereas an
            // empty bucket draws the whole line in the default colour and
            // flashes on every keystroke.
            if removedCount == 1 && insertedCount == 1 {
                return;
            }
            let buckets: [][]Token = rx.get(tokenCache);
            if startLine > buckets.length {
                return;
            }
            let removable = removedCount;
            if startLine + removable > buckets.length {
                removable = buckets.length - startLine;
            }
            for (let i = 0; i < removable; i++) {
                buckets.remove(startLine);
            }
            for (let i = 0; i < insertedCount; i++) {
                // Empty rather than absent: the engine's reply will fill
                // these in, and until it does an uncoloured line is the
                // correct thing to draw.
                let empty: []Token = [];
                buckets.insert(startLine + i, empty);
            }
            tokenCache := buckets;
            tokenCacheVersion := rx.get(tokenCacheVersion) + 1;
        };

        // Edits made since a given document version, kept so a reply that
        // is already out of date can still be used.
        //
        // Requests go out once per EDIT; replies are read once per FRAME.
        // Typing therefore routinely leaves several changes in flight, and
        // a reply that comes back describes the document as it was when
        // its request was sent -- every line number in it, including the
        // lineIndex on each token, is in THAT document's index space.
        //
        // Simply dropping such a reply does not work: the engine sends a
        // line's tokens exactly once, when they change, so a discarded
        // reply means those lines stay blank forever. Instead the reply is
        // REBASED -- its line numbers are pushed through each edit that
        // has happened since, which is precisely how the lines it refers
        // to have moved.
        let pendingEdits: []PendingEdit = [];

        // Map a line number from `fromVersion`'s index space into the
        // current one. Returns -1 if the line was deleted by a later edit,
        // in which case whatever the reply says about it is meaningless.
        let rebaseLine = (line: int, fromVersion: int): int => {
            let result = line;
            for edit in pendingEdits {
                // Only edits made AFTER this reply's version moved it;
                // a line at or below `result`'s own start is untouched.
                if edit.version <= fromVersion || result < edit.startLine {
                    continue;
                }
                if result < edit.startLine + edit.removedCount {
                    // Inside the replaced range -- this line is gone,
                    // and whatever the reply says about it is moot.
                    return -1;
                }
                result = result + edit.insertedCount - edit.removedCount;
            }
            return result;
        };

        // Forget edits no reply can still refer to.
        let dropEditsUpTo = (version: int) => {
            while pendingEdits.length > 0 && pendingEdits[0].version <= version {
                pendingEdits.remove(0);
            }
        };

        let mergeHighlightResult = (result: HighlightResult) => {
            let buckets: [][]Token = rx.get(tokenCache);

            if !result.incremental {
                // A full parse is the whole truth -- but only for the
                // version it describes. Rebasing cannot reconstruct lines
                // that later edits inserted, so anything still in flight
                // is applied on top by the replies that follow.
                //
                // Emptied in place rather than thrown away: dropping the
                // array only means allocating a fresh bucket for every line
                // of the file again in the resize below, and the buckets
                // sitting here are already the right shape and the right
                // length. `clear()` keeps each one's buffer, so a reparse
                // of a big file refills storage it already owns instead of
                // taking thousands of allocations to rebuild it.
                for (let i = 0; i < buckets.length; i++) {
                    buckets[i].clear();
                }
            }

            // The cache's LENGTH is owned solely by spliceTokenCache(),
            // which runs synchronously with each edit and is therefore
            // always in the document's current index space. A reply's
            // `lineCount` counts the document as it was when the request
            // was sent, so resizing from it would truncate the cache to a
            // stale length -- popping buckets off the END and permanently
            // deleting the highlighting of every line past it, with no
            // later reply to restore them.
            let lineCount = doc.lineCount();
            while buckets.length < lineCount {
                let empty: []Token = [];
                buckets.push(empty);
            }
            while buckets.length > lineCount {
                buckets.pop();
            }

            // Rebase every token's line through the edits made since this
            // reply's version, then clear-and-refill the lines it lands
            // on. Two passes so a line receiving several tokens is cleared
            // once, before any of them are added.
            for token in result.tokens {
                let line = rebaseLine(token.lineIndex, result.version);
                if line >= 0 && line < buckets.length {
                    // Emptied, not replaced -- same reason as above. A
                    // reply carries every token of every line it repaints,
                    // so this ran once per token: a heap allocation each
                    // time, for a bucket whose storage was about to be
                    // refilled with almost exactly what it just held.
                    buckets[line].clear();
                }
            }

            for token in result.tokens {
                let line = rebaseLine(token.lineIndex, result.version);
                if line >= 0 && line < buckets.length {
                    // The token's own lineIndex is left as the engine sent
                    // it; nothing reads it once the token is filed, since
                    // the renderer addresses buckets by position.
                    buckets[line].push(token);
                }
            }

            // Brackets are read off these very tokens (a `{` inside a
            // comment is not a bracket), so a reply that repaints a line
            // can change its brackets even though its text never moved --
            // typing `/*` is exactly that. Marked as a RANGE, since every
            // line the reply touched must be rescanned rather than the
            // rescan being allowed to converge inside it.
            if !result.incremental {
                markBracketsDirty(0, bracketCleanLine);
            }
            else {
                let firstDirty = -1;
                let lastDirty = -1;
                for token in result.tokens {
                    let line = rebaseLine(token.lineIndex, result.version);
                    if line < 0 {
                        continue;
                    }
                    if firstDirty < 0 || line < firstDirty {
                        firstDirty = line;
                    }
                    if line > lastDirty {
                        lastDirty = line;
                    }
                }
                if firstDirty >= 0 {
                    markBracketsDirty(firstDirty, lastDirty);
                }
            }

            // This reply is consumed, so no future reply can refer to a
            // version at or below it.
            dropEditsUpTo(result.version);

            tokenCache := buckets;
            tokenCacheVersion := rx.get(tokenCacheVersion) + 1;
        };

        // Tokens for the hover popup's own document, bucketed by line the
        // same way the buffer's are. Kept separate from `tokenCache`
        // because the two documents have unrelated line spaces -- merging
        // a hover reply into the buffer's cache would repaint the file's
        // first few lines with the popup's colours.
        //
        // Replaced wholesale rather than merged: the popup is always sent
        // as a fresh full parse (its text never changes once it arrives,
        // so there is no incremental case to serve), and it has no edit
        // history to rebase against.
        let hoverTokens = rx.shallowReactive<[][]Token>([]);
        let hoverTokensVersion = rx.reactive<int>(0);

        let applyHoverHighlightResult = (result: HighlightResult) => {
            let buckets: [][]Token = [];
            for token in result.tokens {
                while buckets.length <= token.lineIndex {
                    let empty: []Token = [];
                    buckets.push(empty);
                }
                buckets[token.lineIndex].push(token);
            }
            hoverTokens := buckets;
            hoverTokensVersion := rx.get(hoverTokensVersion) + 1;
        };

        // ── Semantic tokens ──────────────────────────────────────────────
        //
        // The second highlighting layer. Everything above knows what a
        // token LOOKS like -- a regular-expression grammar can tell an
        // identifier from a keyword and nothing more. This layer knows
        // what one IS: a parameter, a readonly property, a call into the
        // default library, a type as opposed to a value. That needs a real
        // type checker, so it comes from tsserver (see
        // VueLspBridge.semanticTokens), arrives whole-file at a time, and
        // is bucketed by line so the render path can read it exactly the
        // way it reads the TextMate tokens.
        let semanticCache = rx.shallowReactive<[][]SemanticToken>([]);
        let semanticCacheVersion = rx.reactive<int>(0);

        // The document version a request has already been sent for, so the
        // per-frame pump asks once per quiet document instead of once per
        // frame. -1 is "never asked", which no real version can be.
        let semanticRequestedVersion = rx.reactive<int>(-1);

        // Turn one reply's whole-file byte offsets into per-line tokens.
        //
        // A reply is only usable against the exact document it was
        // computed for. Every offset in it is counted from the start of
        // the FILE, so one character typed anywhere above shifts all of
        // them -- there is nothing here to rebase the way an incremental
        // TextMate reply is rebased, because that one is phrased in line
        // numbers and a line number survives an edit somewhere else.
        // A stale reply is therefore dropped outright, and the pump below
        // simply asks again once the document is quiet.
        let applySemanticSpans = (spans: []SemanticSpan, requestVersion: int) => {
            if requestVersion != doc.version {
                return;
            }

            let lineCount = doc.lineCount();
            // Reuses the buckets already in the cache -- one reply carries
            // the whole file, so building a fresh list of fresh per-line
            // arrays meant one heap allocation per line of the document
            // every time the file went quiet. Emptied and refilled instead;
            // this is a whole-file answer either way, so every bucket is
            // written before anything reads it again.
            let buckets: [][]SemanticToken = rx.get(semanticCache);
            for (let i = 0; i < buckets.length; i++) {
                buckets[i].clear();
            }
            while buckets.length < lineCount {
                let empty: []SemanticToken = [];
                buckets.push(empty);
            }
            while buckets.length > lineCount {
                buckets.pop();
            }

            // Byte offset of every line's first character.
            //
            // Built up front and searched per span rather than walked
            // alongside them, because tsserver DOES NOT emit spans in
            // source order. It mostly does, which is what made a forward
            // walk look sufficient -- but a `defineProps<{...}>()` call
            // reports the type argument's members before the `props`
            // variable they are attached to, and for a `.vue` file the
            // whole template is mapped back out of virtual TypeScript that
            // sits after the script block. A walk that only moves forward
            // silently DROPS every span behind it, which is why `props`
            // and `defineProps` came out uncoloured.
            //
            // Costs one integer per line and no text scanning at all,
            // since a line's byte length is already known.
            let lineStarts: []int = [];
            let offset = 0;
            for (let i = 0; i < lineCount; i++) {
                lineStarts.push(offset);
                offset = offset + doc.lineLength(i) + 1;
            }

            // Which byte ranges of the file semantic tokens may touch.
            //
            // For a `.vue` file that is the <script> blocks and nothing
            // else, mirroring VS Code: its TypeScript semantic-token
            // provider bails unless the code it is asked about is the
            // script block (see typescript-semantic-tokens.js, which
            // requires the embedded code id to be `main`), so a template
            // is coloured by the grammar alone.
            //
            // That is not a detail. Volar compiles a template into virtual
            // TypeScript that reaches every binding through the component
            // instance, so tsserver classifies `panelVisible` in
            // `v-if="panelVisible"` as a PROPERTY rather than the variable
            // the grammar correctly calls it -- repainting half the
            // template in property colours. Anything that is not a `.vue`
            // file is all script, and is not restricted at all.
            let scriptOnly = lspLanguageId == "vue";
            let scriptRangeStarts: []int = [];
            let scriptRangeEnds: []int = [];
            if scriptOnly {
                let openLine = -1;
                for (let i = 0; i < lineCount; i++) {
                    // SFC block tags sit on their own line in every Vue
                    // file there is; anything else is not an SFC.
                    let trimmed = doc.lineText(i).trim();
                    if openLine < 0 && trimmed.startsWith("<script") {
                        openLine = i;
                    }
                    else if openLine >= 0 && trimmed.startsWith("</script") {
                        scriptRangeStarts.push(lineStarts[openLine + 1]);
                        scriptRangeEnds.push(lineStarts[i]);
                        openLine = -1;
                    }
                }
                if openLine >= 0 && openLine + 1 < lineCount {
                    // Unterminated block: take it as running to the end,
                    // which is what it looks like while one is being typed.
                    scriptRangeStarts.push(lineStarts[openLine + 1]);
                    scriptRangeEnds.push(offset);
                }
            }

            for span in spans {
                if span.length <= 0 {
                    continue;
                }
                let scope = semanticScopeFor(
                    semanticTokenTypeName(span.tokenType), span.tokenModifiers);
                // A classification this editor has no scope for leaves the
                // TextMate colour alone, which is the honest result.
                if scope.length == 0 {
                    continue;
                }

                if scriptOnly {
                    let inScript = false;
                    for (let r = 0; r < scriptRangeStarts.length; r++) {
                        if span.start >= scriptRangeStarts[r] && span.start < scriptRangeEnds[r] {
                            inScript = true;
                            break;
                        }
                    }
                    if !inScript {
                        continue;
                    }
                }

                // Binary search for the line this span begins on.
                let line = 0;
                let lo = 0;
                let hi = lineCount - 1;
                while lo < hi {
                    let mid = (lo + hi + 1) / 2;
                    if lineStarts[mid] <= span.start {
                        lo = mid;
                    }
                    else {
                        hi = mid - 1;
                    }
                }
                line = lo;

                // A span can cross lines -- a multi-line type annotation,
                // a template literal. Clip it to one token per line, since
                // the render path only ever draws a single line at a time
                // and addresses it by column.
                let spanEnd = span.start + span.length;
                let clipLine = line;
                let clipStart = lineStarts[line];
                let clipEnd = clipStart + doc.lineLength(line);
                while clipLine < lineCount {
                    let startInLine = span.start > clipStart ? span.start - clipStart : 0;
                    let endInLine = spanEnd < clipEnd ? spanEnd - clipStart : clipEnd - clipStart;
                    if endInLine > startInLine {
                        buckets[clipLine].push(SemanticToken {
                            startIndex: startInLine,
                            endIndex: endInLine,
                            scope: scope,
                        });
                    }
                    if spanEnd <= clipEnd || clipLine + 1 >= lineCount {
                        break;
                    }
                    clipLine = clipLine + 1;
                    clipStart = clipEnd + 1;
                    clipEnd = clipStart + doc.lineLength(clipLine);
                }
            }

            semanticCache := buckets;
            semanticCacheVersion := rx.get(semanticCacheVersion) + 1;
        };

        let bracketStacksEqual = (a: []int, b: []int): bool => {
            if a.length != b.length {
                return false;
            }
            for (let i = 0; i < a.length; i++) {
                if a[i] != b[i] {
                    return false;
                }
            }
            return true;
        };

        // Rescan brackets over whatever range is currently dirty.
        //
        // Walks the document forward from the first dirty line carrying a
        // stack of open brackets, assigning each bracket the depth of the
        // pair it belongs to, and stops as soon as it reaches a line that
        // already began with the very same stack (see bracketDirtyThrough
        // for why that is only allowed past the changed range). Typing a
        // character that is not a bracket therefore costs one line.
        let refreshBrackets = () => {
            if !bracketColorizationEnabled {
                return;
            }
            let start: int = rx.get(bracketDirtyFrom);
            // Nothing is dirty -- what every idle frame looks like. Bail
            // out BEFORE the resize loops and before touching either
            // reactive: `:=` notifies its dependents unconditionally,
            // without ever comparing the new value to the old one, so
            // writing bracketDirtyFrom back to the value it already holds
            // would re-dirty this loop (and everything else reading it) on
            // every single frame.
            if start >= bracketCleanLine {
                return;
            }
            let dirtyThrough: int = rx.get(bracketDirtyThrough);
            let lineCount = doc.lineCount();
            if start >= lineCount {
                bracketDirtyFrom := bracketCleanLine;
                bracketDirtyThrough := -1;
                return;
            }

            let buckets: [][]BracketToken = rx.get(bracketTokens);
            // Both caches are spliced on every edit, so this only has to
            // fix up the tail after a file load or a reload.
            while buckets.length < lineCount {
                let empty: []BracketToken = [];
                buckets.push(empty);
            }
            while buckets.length > lineCount {
                buckets.pop();
            }
            while bracketStacks.length < lineCount {
                let empty: []int = [];
                bracketStacks.push(empty);
            }
            while bracketStacks.length > lineCount {
                bracketStacks.pop();
            }
            while bracketRegions.length < lineCount {
                bracketRegions.push(bracketRootRegion);
            }
            while bracketRegions.length > lineCount {
                bracketRegions.pop();
            }

            let tokenBuckets: [][]Token = rx.get(tokenCache);

            // The state at the start of `start`, which the edit that
            // dirtied it cannot have changed -- an edit on a line never
            // moves the brackets that were already open before it.
            //
            // Refilled rather than re-created, like everything else in this
            // loop: `clear()` keeps the buffer it grew to last time, so a
            // rescan reuses one allocation for the life of the editor
            // instead of taking a fresh one every time it runs.
            let stack: []int = bracketScanStack;
            stack.clear();
            for kind in bracketStacks[start] {
                stack.push(kind);
            }
            let region = bracketRegions[start];

            for (let lineIndex = start; lineIndex < lineCount; lineIndex++) {
                if lineIndex > start {
                    if lineIndex > dirtyThrough && bracketRegions[lineIndex] == region
                        && bracketStacksEqual(bracketStacks[lineIndex], stack) {
                        // Converged: this line already began exactly here,
                        // so it and everything below it are unchanged.
                        break;
                    }
                    // Overwrite the stack already stored for this line
                    // instead of swapping in a new array. A rescan walks
                    // every line of the dirty range, so a fresh []int per
                    // line was one heap allocation per line -- for a
                    // handful of ints that the array sitting there already
                    // has room for.
                    let saved: []int = bracketStacks[lineIndex];
                    saved.clear();
                    for kind in stack {
                        saved.push(kind);
                    }
                    // `saved` IS bracketStacks[lineIndex] -- refilled in
                    // place, so there is nothing to store back. The region
                    // is a plain int and still has to be.
                    bracketRegions[lineIndex] = region;
                }

                // Likewise the bucket: refilled in place, so a rescan
                // costs nothing per line once each line has been scanned
                // once. Safe because nothing reads a bucket between here
                // and the `bracketTokens :=` below -- this whole pass runs
                // inside one frame's pump, before anything renders.
                let out: []BracketToken = buckets[lineIndex];
                out.clear();
                // doc.line() rather than doc.lineText(): the latter clones
                // the line into a fresh str, and a full-document rescan
                // would then allocate one string per line for nothing.
                let tokens: []Token = noTokens;
                if lineIndex < tokenBuckets.length {
                    tokens = tokenBuckets[lineIndex];
                }
                // A .vue file changes language partway down, so the
                // region has to be recomputed per line; anything else is
                // code from the first line to the last.
                let lineRegion = region;
                if bracketRootRegion == BracketRegionNone {
                    let packed = advanceSfcRegion(region, doc.lineText(lineIndex).trim());
                    lineRegion = sfcLineRegion(packed);
                    let nextRegion = sfcNextRegion(packed);
                    if nextRegion != region {
                        // Crossing into or out of a block: bracket pairs
                        // never span two embedded documents, so nothing
                        // opened on the other side may be matched here.
                        while stack.length > 0 {
                            stack.pop();
                        }
                    }
                    region = nextRegion;
                }
                scanLineBrackets(doc.line(lineIndex), tokens, stack, out, lineRegion);
            }

            bracketTokens := buckets;
            bracketCacheVersion := rx.get(bracketCacheVersion) + 1;
            bracketDirtyFrom := bracketCleanLine;
            bracketDirtyThrough := -1;
        };

        // Drain replies and merge them. Called once per frame from the
        // render pass rather than from inside a computed, because merging
        // is a side effect and a computed may be skipped or re-run at the
        // reactive system's discretion -- a dropped reply would leave the
        // affected lines uncoloured until the next edit.
        //
        // Routed by the uri the engine echoes back: several documents are
        // open at once (the buffer and the hover popup), and each reply
        // must land in its own cache.
        //
        // Draining is ONCE PER ARRIVING REPLY, which is what the counter
        // guard below enforces. `highlights` is a computed keyed on that
        // counter, so on a frame where nothing arrived it does not re-run
        // and simply hands back the very same list it returned when it
        // last did -- the replies it already gave us, not an empty one.
        // Merging that list again re-files every token in it, re-marks the
        // lines it covers as bracket-dirty, and so drags a full token
        // merge AND a bracket rescan through every idle frame, allocating
        // a fresh bucket per line each time. The queue itself was already
        // emptied by the first drain, so a second one cannot even add
        // information.
        let lastDrainedCounter: ref Box<int> = { value: -1 };
        let drainHighlightResults = () => {
            let counter: int = rx.get(getState().reactiveCounter);
            if counter == lastDrainedCounter.value {
                return;
            }
            lastDrainedCounter.value = counter;

            let hh: []HighlightResult = rx.get(highlights);
            for result in hh {
                if result.uri == hoverHighlightUri {
                    applyHoverHighlightResult(result);
                }
                else {
                    mergeHighlightResult(result);
                }
            }
        };

        let theme = rx.reactive<VscodeTheme | none>(none);

        // Bumped on every successful theme load. getScopeColor's memo is
        // keyed on this, so a reloaded theme invalidates every cached
        // colour without anything having to walk the table. A plain int
        // rather than a reactive: it is only ever read from inside
        // getScopeColor, which must NOT re-run its callers when the theme
        // changes -- the render pass already re-reads colours every frame.
        let themeGeneration: ref Box<int> = { value: 0 };

        let loadTheme = () => {
            let file = fs.readText("codeeditor/resources/obsidian-radiance-dark.json");
            // let file = fs.readText("codeeditor/resources/catppuccin-mocha.json");
            if !file {
                fmt.println("Failed to load theme");
                return;
            }

            let result = json.parse<VscodeTheme>(file);
            if !result {
                fmt.println("Failed to parse theme: ", result.error());
                return;
            }

            theme := result;
            themeGeneration.value = themeGeneration.value + 1;
        };
        let compiledTokenColors = rx.computed<[]CompiledTokenColor>(() => {
            if !theme {
                return [];
            }

            let result: []CompiledTokenColor = [];

            for tokenColor in theme.tokenColors {
                let selectors: []str = [];

                if tokenColor.scope is str {
                    for part in tokenColor.scope.split(",") {
                        selectors.push(part.trim());
                    }
                } else {
                    selectors = tokenColor.scope;
                }

                result.push({
                    selectors: selectors,
                    settings: tokenColor.settings,
                });
            }

            return result;
        });
        // Memo for getScopeColor, keyed on the scope string.
        //
        // The uncached lookup is a full scan of every selector of every
        // theme entry -- ~465 string prefix-compares for this theme, with
        // no early exit (a longer selector later in the list can always
        // win, see bestLength). That ran once per scope in a token's scope
        // stack, for every coloured run, on every visible line, EVERY
        // frame, which made it the single most expensive thing the idle
        // editor did.
        //
        // The result depends only on (scope, theme), and the set of
        // distinct scopes a real file produces is tiny (dozens), so the
        // whole thing collapses to one hash lookup after first sight. The
        // table is cleared whenever the theme is recompiled, below.
        let scopeColorCache = ScopeColorCache();

        let getScopeColorUncached = (scope: str): Color | none => {
            let bestForeground: str | none = none;
            let bestLength = -1;

            for tokenColor in compiledTokenColors {
                for selector in tokenColor.selectors {
                    if selector.length >= bestLength &&
                    scopeSelectorMatches(selector, scope) &&
                    tokenColor.settings.foreground {

                        bestForeground = tokenColor.settings.foreground;
                        bestLength = selector.length;
                    }
                }
            }

            return bestForeground ? Color(bestForeground) : none;
        };

        let getScopeColor = (scope: str): Color | none => {
            // Every cached answer was resolved against one particular
            // theme, so a load since then invalidates all of them at once
            // -- cheaper to notice here, once per lookup, than to hunt
            // down every place a theme could change and purge from there.
            if scopeColorCache.generation != themeGeneration.value {
                scopeColorCache.clear();
                scopeColorCache.generation = themeGeneration.value;
            }

            let slot = scopeColorCache.find(scope);
            if slot >= 0 {
                // A cached "no theme rule matches this scope" is a real
                // answer worth keeping -- it costs the same full scan to
                // rediscover as a hit does.
                return scopeColorCache.hasColors[slot]
                    ? scopeColorCache.colors[slot]
                    : none;
            }

            let color = getScopeColorUncached(scope);
            scopeColorCache.insert(scope, color);
            return color;
        };


        // ui.onMounted(() => {
        //     load();
        // });
        load();
        loadTheme();

        let defaultTextColor = (): Color => "#FFF";

        // Whether the loaded theme wants semantic tokens at all.
        //
        // VS Code's "configuredByTheme" default, mirrored -- see
        // VscodeTheme.semanticHighlighting. False until a theme has loaded,
        // so nothing is ever painted with a rule no theme has agreed to.
        let semanticHighlightingEnabled = rx.computed<bool>(() => {
            let loaded = rx.get(theme);
            if !loaded {
                return false;
            }
            let flag = loaded.semanticHighlighting;
            if flag is bool {
                return flag;
            }
            // Absent means "this theme has no opinion", which VS Code
            // reads as no.
            return false;
        });

        // The bracket colour cycle for the loaded theme, resolved once and
        // recomputed only when the theme itself changes.
        let bracketPalette = rx.computed<BracketPalette>(() => {
            let loaded = rx.get(theme);
            if !loaded {
                // No theme yet: VS Code's dark defaults, which is what the
                // rest of the editor draws with until one loads too.
                return resolveBracketPalette("dark", none);
            }
            let themeType = loaded.type;
            return resolveBracketPalette(themeType is str ? themeType : "dark", loaded.colors);
        });

        // The colour a bracket at `level` is drawn in, or none when this
        // theme leaves the cycle empty (every slot transparent) and nothing
        // should be recoloured at all.
        //
        // The modulo IS the rainbow: depth 0 takes the first colour, and
        // once the colours run out it starts over, so deeply nested code
        // repeats rather than running out of colours. VS Code spells the
        // same thing `level % 30` into a table of 30 CSS classes, 30 being
        // the lowest common multiple of 1..6 so that the cycle comes out
        // right for any palette size -- with the palette in hand directly,
        // one modulo does it.
        let bracketColorFor = (level: int): Color | none => {
            let palette: BracketPalette = rx.get(bracketPalette);
            if level < 0 {
                return palette.unexpectedColor;
            }
            if palette.levelColors.length == 0 {
                return none;
            }
            return palette.levelColors[level % palette.levelColors.length];
        };

        // TextMate scope stacks go from least specific to most specific
        // (e.g. ["source.ts", "meta.block.ts", "keyword.control.ts"]), and
        // themes are meant to be matched against the *most specific* scope
        // first -- broad structural scopes like "meta.block" would otherwise
        // shadow the token's actual, more specific classification.
        let getFirstScopeColor = (scopes: []str): Color => {
            for (let i = scopes.length - 1; i >= 0; i--) {
                let color = getScopeColor(scopes[i]);
                if color {
                    return color;
                }
            }
            return defaultTextColor();
        }

        let texteditBehavior = textedit_behavior.Context({
            getLineLength: (lineIndex: int) => doc.lineLength(lineIndex),
            getLine: (lineIndex: int) => doc.line(lineIndex),
            getLineCount: () => doc.lineCount(),
            getTimeInSeconds: () => {
                return ui.now();
            },
            replaceRange: applyReplaceRange,

            // Route the unnamed register through the OS clipboard, so
            // yanking here pastes into other applications and vice
            // versa. Vim spells this `set clipboard=unnamedplus`; the
            // engine only wires the bridge, `useSystemClipboard` below
            // is what turns it on.
            getClipboard: () => {
                let text: String = String(app.getClipboardText());
                return text;
            },
            setClipboard: (text: String): void => {
                app.setClipboardText(text.cloneString());
            },
        });

        // Turns the bridge wired above on. Applies in both editing models:
        // vim's y/p and the plain editor's ctrl+c/ctrl+v share this one
        // register, so the OS clipboard is the single source of truth.
        texteditBehavior.useSystemClipboard = true;

        // Vim is an OPTIONAL behavior layered on the same engine. Toggling
        // it at runtime only swaps which behavior is installed -- the
        // engine, the document and the undo history are untouched, so you
        // keep your place and your history across the switch.
        let vim = vim_behavior.Vim(texteditBehavior);
        let vimOn = rx.reactive<bool>(true);

        let applyVimMode = (enabled: bool) => {
            if enabled {
                vim.install();
                vim_behavior.applyRemaps(vim, vim_behavior.defaultVimrc());
                texteditBehavior.setMode(textedit_behavior.Mode.Normal);
            } else {
                // Detaching the behavior returns the engine to plain
                // textbox handling: keys fall through to the default
                // bindings and the caret goes back to sitting BETWEEN
                // characters (Insert-mode clamping).
                texteditBehavior.clearBehavior();
                texteditBehavior.setMode(textedit_behavior.Mode.Insert);
            }
        };
        applyVimMode(true);

        let toggleVim = (): void => {
            let next = !rx.get(vimOn);
            vimOn := next;
            applyVimMode(next);
        };

        // ── Writing the buffer back to disk ──────────────────────────
        //
        // Deliberately a plain, blocking write of the whole file. An
        // editor's save is the one operation a user waits for on purpose,
        // and the document is already in memory -- there is nothing here
        // that wants a background thread, a temp file or a queue.
        //
        // doc.text() is the ONE O(document) allocation on this path, and
        // it is unavoidable: the buffer is a list of lines and the file is
        // a byte stream. It happens per save, never per frame.
        let saveToDisk = (): bool => {
            if filePath.length == 0 {
                // A buffer with no path on disk. Nothing to write to, and
                // no "Save As" to fall back on yet -- say so rather than
                // reporting a success that did not happen.
                statusMessage := "E32: No file name";
                return false;
            }
            if !fs.writeText(filePath, doc.text()) {
                statusMessage := f"E212: Can't open file for writing: {filePath}";
                return false;
            }
            dirty := false;
            diverged := false;
            conflict := false;
            pendingDiskText := none;
            // Immediately, and this is load bearing: the write just changed
            // the file's mtime, so without adopting it here the very next
            // poll would report our own save as an external edit.
            rememberDiskState();
            statusMessage := f"\"{fileNameOf(filePath)}\" written";
            return true;
        };

        // The save every ordinary path goes through.
        //
        // Refuses to write a diverged file and raises the dialog instead,
        // rather than silently picking the buffer -- which is what an
        // unguarded write IS, and which is precisely the answer the user
        // has not given. Returns false in that case, so `:wq` does not go
        // on to close the tab and ctrl+w does not go on to close it either.
        //
        // The unguarded saveToDisk() above is reached only by the two
        // things that mean "yes, I know": the dialog's Overwrite button and
        // an explicit `!`.
        let requestSave = (): bool => {
            if rx.get(diverged) {
                conflict := true;
                return false;
            }
            return saveToDisk();
        };

        // Replace the buffer with what is on disk, keeping the caret where
        // it was as far as the new text allows.
        //
        // setText() is O(document) and rebuilds every line, which is right
        // here: the file was replaced wholesale, so there is no incremental
        // edit to describe. Its ChangeSet says exactly that (line 0, every
        // line removed, every line inserted), and the existing change
        // listener forwards it to the highlighter and the language servers
        // unchanged -- a reload needs no special path through either.
        let applyDiskText = (text: str): void => {
            let caret = rx.get(texteditBehavior.cursorPosition);
            doc.setText(text);
            docVersion := rx.get(docVersion) + 1;
            // AFTER setText, which goes through the change listener and
            // therefore marks the buffer dirty. It is not: this is now
            // exactly what the file holds.
            dirty := false;
            diverged := false;
            conflict := false;
            pendingDiskText := none;
            rememberDiskState();

            // The caret's line may not exist any more, and its column may
            // be past the end of the line that took its place. Clamping
            // both is what stops a reload from throwing the reader to the
            // top of the file for the sake of one line that shrank.
            let line = vim_behavior.clampInt(caret.y, 0, doc.lineCount() - 1);
            let column = vim_behavior.clampInt(caret.x, 0, doc.lineLength(line));
            let target: Vec2i = { x: column, y: line };
            texteditBehavior.clearSelection();
            texteditBehavior.moveTo(target, true, false);
        };

        // ── The file watcher ────────────────────────────────────────
        //
        // Polled from the per-frame loop on a timer rather than driven by
        // fs.watch(). Two reasons: a watch registers a callback that fires
        // from inside fs.pollEvents(), i.e. from the middle of the frame
        // loop rather than from this component's own update, and the poll
        // it does underneath is the same stat() this does -- so the
        // callback buys nothing and costs an indirection plus a per-file
        // registration that would have to be torn down when the tab
        // closes, which there is no unmount hook for.
        let checkDisk = () => {
            if filePath.length == 0 {
                return;
            }
            let stat = fs.statFile(filePath);
            if !stat {
                // The file is gone (deleted, or renamed out from under
                // us). The buffer is now the only copy in existence, so it
                // is emphatically not reloaded or discarded -- it is left
                // exactly as it is, and saving will recreate the file.
                // Nothing is asked, because there is no second version to
                // choose between.
                diskKnown.value = false;
                return;
            }
            let state = stat as fs.FileState;
            if diskKnown.value
                && state.mtime == diskMtime.value
                && state.size == diskSize.value {
                return;
            }

            let file = fs.readText(filePath);
            if !file {
                // Stat said it is there but it could not be read -- a
                // partial write in progress, most likely. Leave everything
                // alone WITHOUT adopting the new stat, so the next poll
                // looks again once the writer has finished.
                return;
            }
            let text = file as str;

            // Adopt the new identity now, before deciding what to do with
            // the contents. Whatever the answer turns out to be, this exact
            // version has now been seen, and re-asking about it on every
            // poll for as long as the tab is open is not an answer -- it is
            // a loop.
            diskMtime.value = state.mtime;
            diskSize.value = state.size;
            diskKnown.value = true;

            // A new timestamp over identical bytes is not a change: a
            // formatter that rewrote the file byte for byte, a `touch`, or
            // a copy that preserved the content. Reloading would rebuild
            // every token for nothing; raising a conflict would ask about
            // a difference that does not exist.
            //
            // The length check comes first and is what keeps this cheap:
            // it is O(lines) and needs no allocation, and differing
            // lengths already prove the contents differ. The full
            // comparison -- the one O(document) allocation on this path --
            // is reached only when the lengths match, and only on a poll
            // that actually saw the file change.
            if text.length == documentByteLength(doc) {
                if text == doc.text() {
                    // The two agree after all, whatever they did in the
                    // meantime -- which RECONCILES an outstanding
                    // divergence rather than merely being uninteresting.
                    // Somebody else saving the same text is a perfectly
                    // ordinary way for a conflict to stop existing.
                    diverged := false;
                    conflict := false;
                    pendingDiskText := none;
                    return;
                }
            }

            if rx.get(dirty) {
                // Both sides moved. This is the one case with no safe
                // automatic answer -- see the state block above.
                pendingDiskText := text;
                diverged := true;
                conflict := true;
                return;
            }

            // Clean buffer: the file on disk is simply the newer truth.
            // This is what keeps several editors open on one file in step
            // with each other.
            applyDiskText(text);
            statusMessage := f"\"{fileNameOf(filePath)}\" reloaded";
        };

        // Save because focus left, not because anyone asked.
        let autosave = (): void => {
            // A diverged file is skipped SILENTLY rather than asking:
            // autosave fires when attention has already moved elsewhere,
            // and a modal nobody asked for is not an improvement on
            // leaving the buffer exactly as it was. The question comes back
            // the next time the file is saved or closed on purpose.
            if filePath.length == 0 || rx.get(diverged) || rx.get(conflict)
                || !rx.get(dirty) {
                return;
            }
            saveToDisk();
        };

        // ── The three answers to the conflict dialog ─────────────────
        //
        // All three clear the flag and hand focus back to the editor: the
        // modal took it when it appeared (it has to -- it answers to the
        // keyboard), and an editor only claims focus when its tab becomes
        // active, which dismissing a dialog is not.
        let resolveOverwrite = () => {
            conflict := false;
            pendingDiskText := none;
            // The unguarded write: this IS the authorisation requestSave
            // was waiting for.
            saveToDisk();
            documents().requestEditorFocus();
        };
        let resolveDiscard = () => {
            let pending = rx.get(pendingDiskText);
            conflict := false;
            if pending {
                applyDiskText(pending as str);
            }
            else {
                // Nothing held back to apply -- the version the question
                // was about is gone (the file was deleted again between
                // asking and answering). There is no second version left to
                // discard in favour of, so the buffer simply stands, and
                // the divergence is over because only one side remains.
                diverged := false;
            }
            documents().requestEditorFocus();
        };
        let resolveCancel = () => {
            // Neither side wins and the buffer stays dirty, which is what
            // the user asked for. `diverged` deliberately STAYS SET: the
            // versions still disagree, so nothing may write this file on
            // its own -- only the dialog goes away.
            //
            // pendingDiskText is kept for the same reason. A later
            // "discard" must apply the version the question was about, not
            // whatever the file happens to hold by then.
            conflict := false;
            documents().requestEditorFocus();
        };

        // Publish this tab's actions for everything that cannot reach into
        // this closure -- the tab strip, ctrl+s, the window-blur autosave
        // and the conflict dialog. See documents.hz.
        documents().register(DocEntry {
            key: args.id,
            path: filePath,
            dirty: dirty,
            diverged: diverged,
            conflict: conflict,
            // The GUARDED one. Everything reaching this editor from
            // outside -- the focus-loss sweep, the close path, ctrl+s --
            // must be unable to overwrite a diverged file without asking.
            save: requestSave,
            checkDisk: checkDisk,
            resolveOverwrite: resolveOverwrite,
            resolveDiscard: resolveDiscard,
            resolveCancel: resolveCancel,
        });

        // ── Ex commands (`:w`, `:q`, ...) ────────────────────────────
        //
        // The engine parses nothing: it collects the line and hands over
        // the text (see Vim.onExCommand). That is the right split, because
        // none of these are text-editing operations -- `:w` is a file
        // write and `:q` closes a tab, and an editing engine can know
        // about neither.
        //
        // The supported set is the one that matters for a file: write,
        // quit, both, and re-read. `!` means force, exactly as in vim:
        // on a write it goes ahead despite a conflict, and on a quit it
        // abandons unsaved changes instead of refusing.
        let runExCommand = (command: str): void => {
            let parsed = parseExCommand(command);
            if !parsed.valid {
                let text = command.trim();
                if text.length == 0 {
                    return;
                }
                statusMessage := f"E492: Not an editor command: {text}";
                return;
            }

            if parsed.reload {
                // Without `!` this refuses to throw away unsaved changes,
                // which is vim's E37 and the same rule `:q` follows below.
                if rx.get(dirty) && !parsed.force {
                    statusMessage := "E37: No write since last change (add ! to override)";
                    return;
                }
                if filePath.length == 0 {
                    statusMessage := "E32: No file name";
                    return;
                }
                let file = fs.readText(filePath);
                if !file {
                    statusMessage := f"E484: Can't open file {filePath}";
                    return;
                }
                applyDiskText(file as str);
                statusMessage := f"\"{fileNameOf(filePath)}\" reloaded";
                return;
            }

            if parsed.write {
                // A write over a diverged file IS the "overwrite" answer to
                // the conflict dialog, so `:w` refuses to give it silently
                // and says so, while `:w!` gives it deliberately.
                if rx.get(diverged) && !parsed.force {
                    statusMessage := "E13: File has changed on disk (add ! to override)";
                    return;
                }
                if parsed.all {
                    documents().saveAllDirty();
                    // saveAllDirty deliberately skips diverged buffers, so
                    // a forced `:wa!` has to write this one itself.
                    if rx.get(diverged) && parsed.force {
                        saveToDisk();
                    }
                }
                else {
                    let written = parsed.force ? saveToDisk() : requestSave();
                    if !written {
                        // The write did not happen, so a `:wq` must NOT go
                        // on to close the tab -- that is the one way to
                        // lose the buffer entirely.
                        return;
                    }
                }
            }

            if parsed.quit {
                if !parsed.write && rx.get(dirty) && !parsed.force {
                    statusMessage := "E37: No write since last change (add ! to override)";
                    return;
                }
                if parsed.force && !parsed.write {
                    // `!` on a quit means abandon, and closing a tab
                    // otherwise SAVES it (see closeTab) -- so the flag has
                    // to be cleared here, or `:q!` would write the very
                    // changes it was asked to throw away.
                    if parsed.all {
                        documents().discardAll();
                    }
                    else {
                        dirty := false;
                        diverged := false;
                        conflict := false;
                    }
                }
                // Closing a tab belongs to the shell, which owns the tab
                // list; the command registry is how anything else reaches
                // it.
                if parsed.all {
                    keybindings().commands.run("workbench.action.closeAllEditors");
                }
                else {
                    keybindings().commands.run("workbench.action.closeActiveEditor");
                }
            }
        };

        let exCommandHook: vim_behavior.ExCommandHook = (command: str) => {
            runExCommand(command);
        };
        vim.onExCommand = exCommandHook;

        // ── Go to definition ─────────────────────────────────────────
        //
        // Asks the language server where the symbol under the caret is
        // defined and raises a navigation request for the answer. The
        // request, not a direct jump: the target may be in a file that is
        // not open, and opening tabs belongs to the shell -- see
        // navigation.hz.
        let goToDefinition = () => {
            let bridge = getState().lspBridge;
            if !bridge {
                return;
            }
            if lspLanguageId.length == 0 {
                // Not a language these servers speak; there is nothing to
                // ask and a request would be answered against nothing.
                return;
            }
            let caret = rx.get(texteditBehavior.cursorPosition);
            let lineText = doc.lineText(caret.y);
            bridge.definition(filePath, caret.y, caret.x, lineText,
                (targets: []DefinitionTarget) => {
                    if targets.length == 0 {
                        return;
                    }
                    // The first target, like every editor: several only
                    // happen for overloads and merged declarations, where
                    // the first is the one people mean.
                    let target = targets[0];
                    requestReveal(target.filepath, target.line, target.utf16Offset);
                });
        };

        // vim's `gd`. The engine knows nothing about language servers; it
        // just calls this. See Vim.onGoToDefinition.
        let goToDefinitionHook: vim_behavior.GoToDefinitionHook = () => {
            goToDefinition();
        };
        vim.onGoToDefinition = goToDefinitionHook;

        // Keep vim's indent unit in step with the setting.
        //
        // A computed rather than a one-off assignment: the width is
        // toggled at runtime from the status bar, and `>`/`<` and
        // insert-mode Tab all read this one field -- so an editor that
        // captured it at mount would go on indenting by the old width for
        // as long as its tab stayed open.
        //
        // Spaces, never a tab: U+0009 has no glyph in any font and the
        // renderer has no fallback, so a literal tab is drawn as a tofu
        // box. See settings.hz.
        let trackIndentUnit = rx.computed(() => {
            let unit = indentString();
            vim.indentUnit = unit;
            return unit;
        });

        // Keep 'commentstring' current for `gc`. A computed rather than a
        // one-off, because in a .vue file the answer depends on which
        // block the caret is in and therefore changes as the caret moves.
        let isVue = asciiLower(filePath).endsWith(".vue");
        let fixedCommentString = commentStringForFile(filePath);
        let trackCommentString = rx.computed(() => {
            if !isVue {
                vim.commentString = fixedCommentString;
                return fixedCommentString;
            }
            let caret = rx.get(texteditBehavior.cursorPosition);
            rx.get(docVersion);
            let resolved = vueCommentStringAt(doc, caret.y);
            vim.commentString = resolved;
            return resolved;
        });

        // ── Acting on a navigation request ───────────────────────────
        //
        // Every tab watches; the one whose path matches acts. Guarded by a
        // serial it has already seen, so each request moves each tab once
        // and no tab has to clear the request for the others (the same
        // shape workspace().lspGeneration uses).
        let revealSerialSeen = rx.reactive<int>(0);
        let applyPendingReveal = rx.computed(() => {
            let nav = navigation();
            let serial = rx.get(nav.serial);
            if serial == rx.get(revealSerialSeen) {
                return serial;
            }
            let wanted: str = rx.get(nav.path);
            if wanted != filePath {
                // Not for this tab. Deliberately does NOT mark the serial
                // seen: the tab this is for may not exist yet, and marking
                // it here would be meaningless anyway since each tab keeps
                // its own counter.
                return serial;
            }
            revealSerialSeen := serial;
            let line = vim_behavior.clampInt(rx.get(nav.line), 0, doc.lineCount() - 1);
            // The offset arrives in UTF-16 code units because the sender
            // had no way to convert it -- only this side has the target
            // line's text. See DefinitionTarget.
            let lineText = doc.lineText(line);
            let byteColumn = unicode.offsetFromUtf16Units(lineText, rx.get(nav.utf16Offset));
            let target: Vec2i = { x: byteColumn, y: line };
            if rx.get(vimOn) {
                texteditBehavior.setMode(textedit_behavior.Mode.Normal);
            }
            texteditBehavior.clearSelection();
            texteditBehavior.moveTo(target, true, false);
            // Centred, which is what every editor does on a jump: landing
            // on the last visible line tells you nothing about context.
            texteditBehavior.requestScroll(textedit_behavior.ScrollIntent.Center);
            return serial;
        });

        // Scroll state for the text area. The editor owns it (it knows
        // the content size); the scroll component owns the maths.
        let scroll = ui_components.ScrollState();
        scroll.overflowY = ui_components.Overflow.Auto;
        scroll.overflowX = ui_components.Overflow.Hidden;
        // Handle on the text area element, so the render pass can read
        // its measured size (the viewport height the scroll maths needs).
        let editorRef: ui_components.ElementRef<ui_elements.DivElement> =
            rx.shallowReactive<ui_components.ElementWrapper<ui_elements.DivElement> | null>(null);

        // Handle on the hover popup, so its placement can read back the size
        // it actually measured to. Needed because "keep it inside the
        // viewport" is not answerable from the anchor alone: whether the
        // popup overflows depends on how big the popup is, and that is only
        // known once it has been laid out with its real text in it.
        //
        // That makes the size one frame stale, which is fine and is what
        // browsers do for the same reason: the popup is placed from last
        // frame's measurement, and a hover's text doesn't change after it
        // arrives, so the only frame that could ever be misplaced is the
        // single one where it first appears with content. The vertical case
        // doesn't even have that gap -- it uses translate (a fraction of the
        // popup's OWN size, resolved during layout), so it is correct
        // immediately, with no measurement involved at all.
        let hoverPopupRef: ui_components.ElementRef<ui_elements.DivElement> =
            rx.shallowReactive<ui_components.ElementWrapper<ui_elements.DivElement> | null>(null);

        // Keep keyboard focus on whichever tab is showing.
        //
        // Two jobs in one, because they are the same job. At startup it is
        // the old "focus the text area so the window opens ready to type
        // in" -- without it, keystrokes go nowhere until you click into the
        // editor, since key events are only delivered along the focused
        // element's chain. And on every tab switch it moves focus to the
        // newly revealed editor, which is what makes switching tabs leave
        // you able to type immediately rather than having to click first.
        //
        // A watch rather than onMounted because mounting is not the moment
        // that matters: every tab mounts once, up front, including the ones
        // that are hidden. Becoming ACTIVE is the event to react to.
        // Focusing a hidden editor would be worse than useless -- the
        // component system blurs anything inside a `display: none` subtree
        // (see releaseHiddenInputState) -- hence the guard.
        //
        // The request is applied at the start of the next frame's input
        // processing, before any keystrokes are dispatched, so no input is
        // dropped in the switch.
        // A computed rather than ui.watch(), matching how every other
        // cross-frame reaction in this file is written: it re-runs exactly
        // when `active` changes, and the render pass reads it once per
        // frame (see `rx.get(followActiveFocus)` in the template) to keep
        // it live.
        let followActiveFocus = rx.computed(() => {
            // Re-run when the conflict dialog gives focus back, not only
            // when this tab becomes active. Dismissing a modal is not a tab
            // switch, so without this the window would be left with nothing
            // focused and therefore no keyboard at all -- see
            // DocumentRegistry.focusEpoch.
            rx.get(documents().focusEpoch);
            let active = instance.props().active;
            if active {
                let editorEl = rx.get(editorRef);
                if editorEl {
                    editorEl.focus();
                }
            }
            return active;
        });

        // Set after anything that moves the caret, so the next frame
        // scrolls it back into view. A flag rather than an immediate
        // scroll because the viewport size is only known during render.
        let caretFollow = rx.reactive<bool>(false);

        // Mouse selection: pointer position -> document position, then
        // click places the caret and drag extends the selection, exactly
        // like a browser text area (and like vim's own mouse support).
        let mouseSelecting = rx.reactive<bool>(false);

        // Where the press landed, and whether the pointer has since moved
        // off it. A click and a drag begin identically -- button down, and
        // still down on the next frame -- so the pump cannot tell them
        // apart from button state alone. Without this, every plain click
        // started a selection (and in vim, entered visual mode) on the
        // frame after the press, because the caret gets re-derived from
        // the live mouse position and any disagreement becomes a range.
        // The PIXEL position of the press, and the document position it
        // resolved to. The drag test has to be made in pixels: converting
        // a pixel to a document position goes through maxColumn(), which
        // is MODE-DEPENDENT (normal mode clamps to the last character,
        // visual mode allows one past it). Comparing document positions
        // therefore reports "moved" the instant the mode changes, even
        // with the mouse held perfectly still -- which is what made a
        // click past the end of a line enter visual mode and select back
        // to the click column.
        let dragOriginPxX = rx.reactive<real>(0.0);
        let dragOriginPxY = rx.reactive<real>(0.0);
        let dragOriginX = rx.reactive<int>(0);
        let dragOriginY = rx.reactive<int>(0);
        let dragMoved = rx.reactive<bool>(false);

        // Top edge of the text area in window space, used to convert a
        // global pointer position into a local one.
        let editorOriginY = (): real => {
            let editorEl = rx.get(editorRef);
            if editorEl {
                let pos = editorEl.position();
                if pos {
                    return pos.y;
                }
            }
            return 0.0;
        };

        // Left edge, same purpose -- absolutely-positioned children are
        // placed in editor-local coordinates, but a pointer position is
        // in window space.
        let editorOriginX = (): real => {
            let editorEl = rx.get(editorRef);
            if editorEl {
                let pos = editorEl.position();
                if pos {
                    return pos.x;
                }
            }
            return 0.0;
        };

        // Pointer position (window space) -> document (column, line).
        // Rounds to the NEAREST character boundary horizontally, like a
        // browser: clicking the right half of a glyph puts the caret
        // after it, which is what makes click-to-place feel right.
        let documentPositionAt = (pointer: Vec2): Vec2i => {
            // Explicit font -- see editorFontFamily(). This runs from an
            // event handler, where the contextual font is NOT the editor's.
            let charSize = ui.measureText("X", editorFontFamily(), editorFontSize());
            let editorEl = rx.get(editorRef);
            let originX = 0.0;
            let originY = 0.0;
            if editorEl {
                let pos = editorEl.position();
                if pos {
                    originX = pos.x;
                    originY = pos.y;
                }
            }
            let localX = pointer.x - originX;
            let localY = pointer.y - originY + rx.get(scroll.scrollTop);

            let lineIndex = 0;
            if charSize.y > 0.0 {
                lineIndex = (localY / charSize.y) as int;
            }
            lineIndex = text_document.clampIndex(lineIndex, doc.lineCount());

            // Pixels -> DISPLAY column (the renderer lays every cluster out
            // on a fixed monospace advance, so this division is exact).
            let displayColumn = 0;
            if charSize.x > 0.0 {
                displayColumn = ((localX / charSize.x) + 0.5) as int;
            }
            if displayColumn < 0 {
                displayColumn = 0;
            }

            // Display column -> BYTE offset, which is what the engine means
            // by "column". These coincide only for pure-ASCII lines: a tab,
            // a CJK glyph or an emoji occupies a different number of bytes
            // than it does screen cells, and feeding a display column
            // straight in lands the caret at an unrelated byte.
            let lineText = doc.lineText(lineIndex);
            let column = 0;
            let cell = 0;
            while column < lineText.length {
                let width = unicode.clusterColumnWidth(lineText, column);
                if cell + width > displayColumn {
                    break;
                }
                cell = cell + width;
                column = unicode.nextClusterOffset(lineText, column);
            }

            // Past the end of the text, the caret belongs at the line's own
            // limit -- NOT at the column the pixel maths implied. Clamping
            // is deliberate and must use the CURRENT mode's limit.
            let maxColumn = texteditBehavior.maxColumn(lineIndex);
            if column > maxColumn {
                column = maxColumn;
            }
            let result: Vec2i = { x: column, y: lineIndex };
            return result;
        };

        // Does the pointer's own column fall within `lineIndex`'s text,
        // ignoring the end-of-line clamp documentPositionAt() applies?
        // Compares DISPLAY cells, since that is what pixels convert into
        // and what the line's on-screen width is measured in.
        let pointerColumnInsideLine = (pointer: Vec2, lineIndex: int): bool => {
            let charSize = ui.measureText("X", editorFontFamily(), editorFontSize());
            if charSize.x <= 0.0 {
                return false;
            }
            let localX = pointer.x - editorOriginX();
            if localX < 0.0 {
                return false;
            }
            // Truncate rather than round: rounding is right for placing a
            // caret BETWEEN characters, but here the question is which
            // character the pixel is actually on top of.
            let cell = (localX / charSize.x) as int;
            return cell < unicode.displayWidth(doc.lineText(lineIndex));
        };

        // Is there a word character at this document position?
        //
        // Mouse hover is only meaningful over an identifier -- that is what
        // a language server has something to say about. Whitespace, blank
        // space past the end of a line, and punctuation all answer false.
        // Word characters are the usual identifier set (letters, digits,
        // `_`, `$`), plus anything non-ASCII, since a byte >= 0x80 is part
        // of a multi-byte character which may well be an identifier in
        // another script -- and treating those as punctuation would silently
        // disable hover for non-English code.
        let isWordPositionAt = (pos: Vec2i): bool => {
            let lineText = doc.lineText(pos.y);
            if pos.x < 0 || pos.x >= lineText.length {
                return false;
            }
            let byte = lineText[pos.x];
            if byte >= b"a" && byte <= b"z" { return true; }
            if byte >= b"A" && byte <= b"Z" { return true; }
            if byte >= b"0" && byte <= b"9" { return true; }
            if byte == b"_" || byte == b"$" { return true; }
            // Any continuation/lead byte of a multi-byte character.
            return byte >= 0x80;
        };

        // Is the pointer over the text area itself? documentPositionAt()
        // answers "which character would this pixel be", and it clamps --
        // so it happily reports a valid position for a pointer sitting in
        // the status bar or outside the window entirely. Mouse hover must
        // not fire in either case, hence the explicit bounds test.
        let pointerInsideEditor = (pointer: Vec2): bool => {
            let editorEl = rx.get(editorRef);
            if !editorEl {
                return false;
            }
            let pos = editorEl.position();
            if pos {
                let size = editorEl.size();
                if size {
                    // The scrollbar is chrome, not text: dwelling on it is
                    // aiming at the bar, never at the token underneath.
                    let textWidth = size.x;
                    if scroll.showsVerticalBar() {
                        textWidth = textWidth - scroll.style.size;
                    }
                    return pointer.x >= pos.x && pointer.x < pos.x + textWidth
                        && pointer.y >= pos.y && pointer.y < pos.y + size.y;
                }
            }
            return false;
        };

        let state = getState();

        // Live highlighting, incrementally.
        //
        // The document reports exactly which lines an edit replaced
        // (ChangeSet), and the syntax engine speaks that same shape: it
        // keeps a per-line rule-stack cache, retokenizes from the changed
        // line, and stops as soon as the stack reconverges. Editing one
        // line in a 5000-line file costs ~0.4ms instead of the ~24ms a
        // full reparse takes, so this runs on every edit with no debounce
        // and the colours never lag behind what you typed.
        //
        // Opening a block comment (which genuinely does recolour
        // everything below it) still cascades correctly -- the engine
        // simply keeps going until the rule stack matches again.
        if filePath.length > 0 {
            // Reuse the text we just read rather than re-deriving it.
            let startupText = rx.get(initialText);
            state.highlightEngine.sendOpenDocument(
                highlightUri, startupText ? startupText as str : doc.text(),
                doc.version, editorScopeName);
        }

        // Guards the one-shot LSP document open, so the per-frame loop
        // never has to build the whole document just to discard it.
        //
        // Declared up here rather than beside the rest of the hover state
        // because the change listener below reads it: an edit may only be
        // forwarded to the language servers once they have actually been
        // told about the file.
        let lspDocumentOpened = rx.reactive<bool>(false);

        // Which set of language servers this tab has introduced itself to.
        // Compared against workspace().lspGeneration, which is bumped every
        // time they are replaced -- see the reset in the per-frame LSP
        // block below.
        let lspGenerationSeen = rx.reactive<int>(-1);

        // Byte length of the document's LAST line, as it was before the
        // edit currently being processed.
        //
        // Needed for exactly one case, and unrecoverable once the edit has
        // happened. An edit is forwarded as "replace lines [start, end)",
        // which is expressed as a range running from column 0 of `start`
        // to column 0 of `end` -- column 0 needs no encoding conversion,
        // so nothing has to be scanned to build it. But when the edit runs
        // to the end of the file there is no line after `end` to point at,
        // and the range has to end at the last line's END instead. This is
        // that length, kept current so it is still the OLD one when the
        // listener runs.
        let lspLastLineLength = rx.reactive<int>(
            doc.lineCount() > 0 ? doc.lineLength(doc.lineCount() - 1) : 0);

        doc.addChangeListener((change: text_document.ChangeSet) => {
            // The buffer and the file have parted ways. Written only on
            // the transition, never on every keystroke: this is a reactive
            // the tab strip reads, and re-notifying it with `true` while
            // it is already true would rebuild the strip's props on every
            // single character typed.
            //
            // A reload comes through here too (setText is a change like
            // any other) and sets this -- applyDiskText clears it again
            // immediately afterwards, which is where it belongs, since only
            // that caller knows the new text came from the file.
            if !rx.get(dirty) {
                dirty := true;
                // "written" stops being true the moment something is
                // typed, so the note goes with it.
                statusMessage := "";
            }

            let newLines: []str = [];
            for (let i = 0; i < change.insertedCount; i++) {
                newLines.push(doc.lineText(change.startLine + i));
            }

            // ── Forward the edit to the language servers ──────────────
            //
            // Without this they answer every position-based question --
            // hover, and every semantic token -- against the file as it
            // was on disk when the tab opened, which stops being true at
            // the first keystroke.
            //
            // The document is described by LINES here, so the edit is
            // forwarded as a line-granular range replacement even when the
            // user only typed one character: the servers reconstruct the
            // same text either way, and this needs no column arithmetic.

            // The copy read from disk no longer describes this document,
            // so whoever has yet to be handed it must reassemble instead.
            // Matters when the servers are still starting up: the open
            // they eventually perform has to carry the CURRENT text.
            initialText := none;

            let oldLineCount = doc.lineCount() - change.insertedCount + change.removedCount;
            let oldLastLineLength = rx.get(lspLastLineLength);
            if doc.lineCount() > 0 {
                lspLastLineLength := doc.lineLength(doc.lineCount() - 1);
            }

            let vueBridge = getState().lspBridge;
            if vueBridge && rx.get(lspDocumentOpened) && lspLanguageId.length > 0 {
                let replacement = "";
                for (let i = 0; i < change.insertedCount; i++) {
                    replacement = replacement + newLines[i];
                    // Every replaced line keeps its newline EXCEPT when
                    // the range ran to the end of the file, where there
                    // was no trailing newline to replace in the first
                    // place.
                    if change.startLine + change.removedCount < oldLineCount
                        || i + 1 < change.insertedCount {
                        replacement = replacement + "\n";
                    }
                }

                let endLine = change.startLine + change.removedCount;
                let endColumn = 0;
                if endLine >= oldLineCount {
                    // Ran to the end of the document: point at the end of
                    // the last line that actually exists, since there is
                    // no line after it to start at.
                    endLine = oldLineCount > 0 ? oldLineCount - 1 : 0;
                    endColumn = oldLastLineLength;
                }

                vueBridge.changeDocument(filePath, {
                    startLine: change.startLine,
                    endLine: endLine,
                    endColumn: endColumn,
                    newText: replacement,
                }, doc.version);
            }

            // Shift the token cache to match the edit BEFORE the reply
            // arrives. The reply is addressed by line number, so the cache
            // has to already be in the document's new index space for
            // those numbers to mean anything -- and the lines that merely
            // MOVED keep their colours in the meantime instead of being
            // redrawn with a neighbour's.
            spliceTokenCache(change.startLine, change.removedCount, change.insertedCount);
            // The same shift for the bracket caches, then a rescan of
            // exactly the lines whose text changed. Everything below them
            // is reached only if the edit actually altered the bracket
            // balance, which the rescan discovers for itself.
            spliceBracketCaches(change.startLine, change.removedCount, change.insertedCount);
            let bracketDirtyLast = change.startLine + change.insertedCount - 1;
            markBracketsDirty(change.startLine,
                bracketDirtyLast < change.startLine ? change.startLine : bracketDirtyLast);
            // Remember the edit so replies still in flight -- which are
            // phrased in an older document's line numbers -- can be
            // rebased onto the document as it is now.
            pendingEdits.push(PendingEdit {
                version: doc.version,
                startLine: change.startLine,
                removedCount: change.removedCount,
                insertedCount: change.insertedCount,
            });
            // Stamp the request with the document version it describes.
            // Document.version is bumped BEFORE listeners run (see
            // text_document.hz), so inside this callback it already names
            // the state this very change produced -- which is exactly what
            // the reply has to be checked against when it comes back.
            state.highlightEngine.sendDocumentChange(
                highlightUri, change.startLine, change.removedCount, newLines,
                doc.version);
        });

        // Hover used to be requested every time the cursor moved, including
        // every single keystroke while typing (typing moves the cursor) --
        // each one kicking off a tsserver + LSP round trip. Typing quickly
        // queued requests faster than they drained, and editing ground to a
        // halt. Worse, it meant hover was permanently on: a popup followed
        // the caret around whether or not anyone asked for one.
        //
        // Hover is now only ever requested by the two gestures that mean
        // "tell me about this", matching the editor being imitated:
        //
        //   no vim -> VS Code: rest the MOUSE over a token for
        //             hoverDwellSeconds and the popup appears at the
        //             pointer; any pointer movement to a different
        //             character, or any keystroke, takes it away again.
        //
        //   vim    -> neovim: hover is `vim.lsp.buf.hover`, bound to K in
        //             every stock LSP config. It is a normal-mode COMMAND
        //             at the caret, one popup per press, never automatic --
        //             so nothing here is time-based at all. Per this
        //             editor's binding it is shift+L rather than K (see
        //             hoverKeyPressed).
        let hoverDwellSeconds = 0.3;
        // How long the document must have been left alone before its
        // semantic tokens are asked for. See the pump in the render pass.
        let semanticQuietSeconds = 0.25;
        let lastEditAt = rx.reactive<real>(-1000.0);
        // Monotonic keystroke counter -- see noteKeyboardActivity.
        let inputSerial = rx.reactive<int>(0);
        // The position a request was last SENT for, so re-running the loop
        // (which happens every frame) doesn't re-send the same query.
        let lastHoverPos = rx.reactive<Vec2i | none>(none);

        // ── Mouse dwell tracking (non-vim path only) ─────────────────
        //
        // "The pointer has been still, over the same character, for long
        // enough" -- the whole of VS Code's hover trigger. Tracked in
        // window pixels rather than document positions because a pointer
        // that moves within one character has NOT moved for this purpose,
        // and comparing document positions is what makes that true.
        let mouseRestX = rx.reactive<real>(-1.0);
        let mouseRestY = rx.reactive<real>(-1.0);
        let mouseRestSince = rx.reactive<real>(-1.0);

        // Has the keyboard taken over from the mouse?
        //
        // Set by any keystroke, cleared only when the pointer PHYSICALLY
        // MOVES again. While it is set, mouse dwell cannot fire at all.
        //
        // A timeout is not enough here, and that was the bug: suppressing
        // the dwell for hoverDwellSeconds after the last keystroke means
        // the moment you stop to think, the still-stationary mouse re-arms
        // and pops open a hover for whatever it happens to be sitting on.
        // While you are navigating with the keyboard the mouse is not
        // pointing at anything -- it is just where you last left it -- so
        // the text under it means nothing and a popup there is noise that
        // covers the code you are actually reading.
        //
        // This is VS Code's behaviour: type or move the caret and the
        // mouse stops being a hover source until you move it again. Only
        // real motion (see `moved` in the dwell branch) rearms it, which
        // is exactly the gesture that means "I am pointing at this now".
        let keyboardTookOver = rx.reactive<bool>(false);

        // Called by every keyboard path: the keyboard is now driving, so
        // the mouse stops being a hover source until it moves again.
        let noteKeyboardActivity = () => {
            lastEditAt := ui.now();
            keyboardTookOver := true;
            // Bumped per key so the status line can render state the
            // editing engine keeps in plain fields rather than reactives --
            // specifically the `:` command line, which changes on every
            // keystroke while it is open and on nothing else. Reading
            // lastEditAt would ALMOST work and is the trap: two keys in one
            // frame produce the same timestamp, so the second one would not
            // re-render.
            inputSerial := rx.get(inputSerial) + 1;
        };
        // Set by the vim keybinding; consumed by the loop below, which is
        // where the document text needed to build the request is in scope.
        let hoverKeyPressed = rx.reactive<bool>(false);

        // Exponentially-smoothed FPS, recomputed alongside the LSP drain
        // below since that's already the one thing guaranteed to re-run
        // every frame (it depends on ui.now()).
        //
        // The smoothing accumulates in PLAIN variables and only the
        // published number is reactive, updated a couple of times a second
        // beside the other status-bar stats. Writing the reactive every
        // frame would re-run fpsText every frame, and formatting a string
        // is a heap allocation -- one per frame, forever, for a label that
        // is unreadable if it changes faster than this anyway.
        let lastFrameAt: ref Box<real> = { value: 0.0 };
        let smoothedFps: ref Box<real> = { value: 0.0 };
        let fps = rx.reactive<real>(0.0);
        let fpsText = rx.computed(() => f"{rx.get(fps) as int} FPS");

        // Status-bar label for the active editing model / vim mode.
        let modeLabel = rx.computed(() => {
            if !rx.get(vimOn) {
                return "INSERT (vim off - F2)";
            }
            let mode = rx.get(texteditBehavior.mode);
            if mode == textedit_behavior.Mode.Insert { return "-- INSERT --"; }
            if mode == textedit_behavior.Mode.Visual { return "-- VISUAL --"; }
            if mode == textedit_behavior.Mode.VisualLine { return "-- VISUAL LINE --"; }
            if mode == textedit_behavior.Mode.VisualBlock { return "-- VISUAL BLOCK --"; }
            return "-- NORMAL --";
        });
        // The `:` line, as vim's own status area shows it. Empty whenever
        // no command line is open.
        //
        // Driven off inputSerial because command-line state lives in plain
        // fields on Vim, not in reactives -- an editing engine has no
        // business owning UI reactivity, and this is the one piece of it
        // that changes per keystroke without touching the document.
        let commandLineLabel = rx.computed(() => {
            rx.get(inputSerial);
            if !rx.get(vimOn) || !vim.commandLineOpen() {
                return "";
            }
            return f":{vim.commandLineText()}";
        });

        let modeColor = rx.computed((): Color => {
            if !rx.get(vimOn) {
                return "#888" as Color;
            }
            let mode = rx.get(texteditBehavior.mode);
            if mode == textedit_behavior.Mode.Insert { return "#7FD97F" as Color; }
            if textedit_behavior.modeIsVisual(mode) { return "#D9B87F" as Color; }
            return "#7FA8D9" as Color;
        });

        // ── Keybinding context and commands owned by this editor ──────
        //
        // Both are guarded on `active` because the registries are flat and
        // global while an editor is per-tab: the visible tab is the one
        // that holds keyboard focus, so it is the one whose state the
        // `when` clauses are asking about and the one whose document an
        // editor command should act on. Switching tabs re-runs both, and
        // the newly active editor takes ownership.
        //
        // Computeds rather than writes scattered through the mutation
        // sites: every value below is derived from a reactive, so this
        // re-runs exactly when one of them changes and nothing else has to
        // remember to keep the context in step. Read once per frame from
        // the render pass (see rx.get() in the template) to stay live --
        // the same shape followActiveFocus above already uses.
        let publishEditorContext = rx.computed(() => {
            if !instance.props().active {
                return false;
            }
            let ctx = keybindings().context;
            let on = rx.get(vimOn);
            let mode = rx.get(texteditBehavior.mode);
            ctx.setBool(ctxVimActive(), on);
            ctx.setStr(ctxVimMode(), on ? vimModeContextName(mode) : "");
            let anchor = rx.get(texteditBehavior.selectionAnchor);
            ctx.setBool(ctxEditorHasSelection(), anchor ? true : false);
            return true;
        });

        // Built ONCE, here, not inside the computed below: every lambda in
        // this struct captures something (vim, vimOn, goToDefinition), so
        // building it inside ownEditorCommands heap-allocated a fresh closure
        // env per handler every time the tab's `active` flipped. The handlers
        // don't depend on anything that changes between activations -- only
        // the act of registering does -- so the closures are created with the
        // editor and the computed merely hands the same struct over again.
        // toggleVim is passed as-is rather than wrapped in `() => { toggleVim(); }`,
        // which was one more allocation that did nothing but forward a call.
        let editorCommands = EditorCommands {
            // Wrapped, unlike toggleVim beside it, because requestSave
            // answers whether it actually wrote (a diverged file raises the
            // dialog instead) and a CommandFn returns nothing. The wrapper
            // is built once here with the rest of the struct, so it costs
            // the same as any other handler in it.
            save: () => { requestSave(); },
            toggleVim: toggleVim,
            // No longer a stub: this is the real jump list. The keymap
            // routes ctrl+o here rather than letting it reach the
            // engine as a key, so the binding and vim's own <C-o> are
            // the same action rather than two that shadow each other.
            vimNavigateBack: () => { vim.jumpBack(); },
            vimNavigateForward: () => { vim.jumpForward(); },
            goToDefinition: () => {
                // Outside vim, or from F12, the jump origin still has
                // to be recorded -- `gd` does this itself.
                if rx.get(vimOn) {
                    vim.pushJump();
                }
                goToDefinition();
            },
        };

        let ownEditorCommands = rx.computed(() => {
            if !instance.props().active {
                return false;
            }
            registerEditorCommands(keybindings(), editorCommands);
            return true;
        });

        let prevUpdate: ref Box<real> = { value: ui.now() };

        // File-watch timer. Boxes for the same reason the FPS accumulators
        // above are: written from inside a closure, which captures a plain
        // local by value.
        let diskPollSeconds = 0.25;
        let lastDiskCheck: ref Box<real> = { value: ui.now() };

        let lspMemStat = rx.reactive<str | none>(none);

        let updateStats = () => {
            let vueBridge = getState().lspBridge;
            if !vueBridge {
                lspMemStat := none;
                return;
            }
            let memory = vueBridge.getSystemMemoryUtilization();

            let vue = memory.vue ? memory.vue / 1024 / 1024 : "?";
            let ts = memory.ts ? memory.ts / 1024 / 1024 : "?";

            lspMemStat := f"Vue LSP Memory: {vue} MiB | TypeScript LSP Memory: {ts} MiB";
        };

        let runLspLoop = rx.computed(() => {
            let now = ui.now();

            let dt = now - lastFrameAt.value;
            lastFrameAt.value = now;
            if dt > 0.0 {
                smoothedFps.value = smoothedFps.value * 0.9 + (1.0 / dt) * 0.1;
            }

            if now - prevUpdate.value > 0.5 {
                fps := smoothedFps.value;
                updateStats();
                prevUpdate.value = now;
            }

            // Watch the file. On a timer rather than every frame: a stat()
            // is a syscall, and doing one per tab per frame would be 60 a
            // second per open file to answer a question whose answer
            // changes at human speed. A quarter of a second is fast enough
            // that a save in another editor looks instantaneous.
            if now - lastDiskCheck.value > diskPollSeconds {
                lastDiskCheck.value = now;
                checkDisk();
            }

            // Drives vim's 'timeoutlen'. A pending mapping chord (the `j` of
            // `jk`) is shown immediately and taken back if the chord
            // completes -- but if the next key never arrives, only the clock
            // can settle it, and vim_behavior has no timer of its own. This
            // is the one place guaranteed to run every frame, so it is where
            // that decision gets made.
            //
            // Bump docVersion when it fires: the speculative character
            // becoming permanent is a document change as far as the render
            // path is concerned, even though no text moved.
            if rx.get(vimOn) {
                if vim.tick() {
                    docVersion := rx.get(docVersion) + 1;
                }
            }

            drainHighlightResults();

            // After draining, never before: brackets are derived from the
            // tokens those replies just merged, so rescanning first would
            // read the previous frame's view of which `{` are inside
            // comments. Cheap when nothing is dirty, which is most frames.
            refreshBrackets();

            // Reading the computed is what evaluates it, and evaluating it
            // is what sends a hover's code to the highlight engine. It
            // memoises on the code text, so this is a no-op on every frame
            // where the hover hasn't changed -- but it must be READ every
            // frame, since a computed nobody reads never runs at all.
            rx.get(hoverHighlightRequester);

            // `lspLanguageId` is what gates a whole tab's language-server
            // participation: the server behind this bridge speaks the web
            // languages and nothing else, so a Haze buffer neither opens
            // nor hovers. Skipping the open alone would be worse than
            // skipping both -- hover requests naming a document the server
            // was never told about are answered against nothing.
            let vueBridge = getState().lspBridge;

            // A workspace switch replaces both language servers, and the
            // replacements have never heard of this document. Everything
            // below is guarded by one-shot latches (opened once, semantic
            // tokens requested once per version), so without clearing them
            // an already-open tab would sit there believing it had already
            // introduced itself and would silently lose every semantic
            // feature for the rest of its life. Reading the generation here
            // is also what subscribes this computed to the switch.
            let generation = rx.get(workspace().lspGeneration);
            if rx.get(lspGenerationSeen) != generation {
                lspGenerationSeen := generation;
                lspDocumentOpened := false;
                // -1 rather than 0: 0 is a real document version, so the
                // guard has to be reset to something no version can equal.
                semanticRequestedVersion := -1;
            }

            if vueBridge && filePath.length > 0 && lspLanguageId.length > 0 {
                // openDocument() is a ONE-SHOT (it early-returns once the
                // document is open), but the argument was still being
                // evaluated on every frame -- and doc.text() reassembles
                // the entire file. That alone cost seconds per frame on a
                // large file. Send the text once, then never again, and
                // send the copy we already read from disk.
                //
                // Deliberately held back until isReady(). openDocument()
                // would happily queue it, but what got queued would be the
                // text as it was BEFORE anything typed while the servers
                // were starting -- and every edit forwarded afterwards is
                // relative to whatever was opened, so a stale base would
                // stay stale for the life of the tab. Waiting costs one
                // reassembly of a file that was edited in the meantime; a
                // file that was not still uses the copy read from disk.
                if !rx.get(lspDocumentOpened) && vueBridge.isReady() {
                    lspDocumentOpened := true;
                    let startupText = rx.get(initialText);
                    // The version the servers are told about here is the
                    // base every later didChange counts up from, so it has
                    // to be the document's own -- not a literal 1, which
                    // an edit made while the servers were starting has
                    // already moved past.
                    vueBridge.openDocument(filePath, lspLanguageId, doc.version,
                        startupText ? startupText as str : doc.text());
                    // Both consumers have their copy now; stop pinning
                    // a second full copy of the file in memory.
                    initialText := none;
                }

                // ── Semantic tokens ──────────────────────────────────
                //
                // Asked for once the document has been left alone for a
                // moment, never on the keystroke itself. A classification
                // is a real type-check across the project -- orders of
                // magnitude more expensive than the TextMate pass -- and
                // its answer is phrased in whole-file offsets that the
                // very next keystroke invalidates, so asking mid-typing
                // buys a reply that is already stale by the time it lands
                // (see applySemanticSpans, which drops exactly those).
                //
                // The version guard is what makes this once per quiet
                // document rather than once per frame, and it is also what
                // re-asks after each burst of typing: an edit moves
                // doc.version, so the guard opens again on its own.
                // Not asked for at all when the theme has not opted in --
                // the answer would be thrown away, and it is a real
                // type-check across the project to produce.
                if rx.get(semanticHighlightingEnabled)
                    && rx.get(lspDocumentOpened)
                    && rx.get(semanticRequestedVersion) != doc.version
                    && ui.now() - rx.get(lastEditAt) >= semanticQuietSeconds {
                    semanticRequestedVersion := doc.version;
                    let requestVersion = doc.version;
                    vueBridge.semanticTokens(filePath, 0, documentByteLength(doc),
                        (spans: []SemanticSpan) => {
                            applySemanticSpans(spans, requestVersion);
                        });
                }

                // ── Deciding whether a hover is wanted ───────────────
                //
                // Two INDEPENDENT triggers, not two alternatives. The mouse
                // is a pointing device in either editing model -- pointing
                // at a token and waiting means the same thing whether or
                // not vim is on -- so dwell is always live. The keyboard
                // trigger is what's vim-specific, since only vim has a
                // modal normal mode for a bare letter to be a command in.
                //
                //   keyboard (vim only) -> neovim: `vim.lsp.buf.hover`,
                //             stock-bound to K, here shift+L. An explicit
                //             command at the CARET, one popup per press.
                //
                //   mouse (always)      -> VS Code: rest the pointer over a
                //             token for hoverDwellSeconds, popup appears at
                //             the POINTER. Any movement takes it away.
                //
                // The keyboard trigger runs first so that its caret-anchored
                // popup is already standing when the dwell branch looks; the
                // dwell branch only ever acts on an EMPTY hoverRequest, so a
                // stationary mouse cannot steal a hover the keyboard just
                // asked for.
                if rx.get(vimOn) && rx.get(hoverKeyPressed) {
                    hoverKeyPressed := false;
                    let cursor = texteditBehavior.cursorPosition;
                    // Anchor under the caret, which is where neovim floats
                    // its hover window -- `none` selects the caret anchor.
                    hoverAnchor := none;
                    hoverResult := null;
                    hoverRequest := { x: cursor.x, y: cursor.y } as Vec2i;
                    // The pointer has not moved, so without this the dwell
                    // branch would be free to re-fire at the pointer the
                    // moment this popup is dismissed, spawning a hover
                    // nobody asked for. Make the mouse re-earn its dwell.
                    mouseRestSince := now;
                }

                // Mouse dwell. Only while the pointer is actually inside
                // the editor and not mid-drag -- selecting text with the
                // mouse must not spawn popups.
                let pointer = ui.mousePos;
                let moved = pointer.x != rx.get(mouseRestX)
                    || pointer.y != rx.get(mouseRestY);
                if moved {
                    mouseRestX := pointer.x;
                    mouseRestY := pointer.y;
                    mouseRestSince := now;
                    // Physically moving the mouse is the gesture that means
                    // "I am pointing at something now", and it is the ONLY
                    // thing that gives the mouse back its say after the
                    // keyboard took over -- see keyboardTookOver.
                    keyboardTookOver := false;
                }

                // A hidden tab must never open a hover popup. This is
                // already true without the guard -- pointerInsideEditor()
                // asks for the editor box, and a hidden element reports no
                // geometry at all (see ui_components.ui_position) -- but
                // saying so here keeps the dwell timer from advancing in
                // the background and makes the intent legible.
                // A pointer we have never located cannot be dwelling. Until
                // the platform reports it, ui.mousePos reads (0,0) and
                // never changes -- which looks exactly like a pointer held
                // perfectly still, so the dwell timer would mature and pop
                // a hover open for whatever sits in the corner, without the
                // mouse ever having touched the window.
                let busy = !instance.props().active
                    || !ui.mousePosKnown
                    // The keyboard is driving; the mouse is just parked
                    // somewhere -- see keyboardTookOver.
                    || rx.get(keyboardTookOver)
                    || rx.get(mouseSelecting) || scroll.isDragging();
                let restedFor = now - rx.get(mouseRestSince);
                if busy || moved {
                    // Moving the pointer at all takes the popup away, and
                    // the dwell timer above has already restarted -- so
                    // coming to rest on the SAME character re-asks and
                    // shows it again, while a pointer travelling across
                    // the text shows nothing on the way. That is what VS
                    // Code does, and it is why this does not bother
                    // comparing document positions: the reset of
                    // lastHoverPos is what makes the re-ask happen.
                    //
                    // Moving the mouse also dismisses a shift+L popup,
                    // which is right: it is the same "you did something
                    // else now" signal that a keystroke gives.
                    //
                    // But only MOVING may do that. `busy` on its own must
                    // not, because the keyboard taking over is itself one
                    // of the things that makes this branch true -- and the
                    // shift+L popup IS the keyboard's own popup, created
                    // by the block a few lines above. Tearing it down here
                    // would mean the keyboard hover appeared and vanished
                    // within the same frame, i.e. never appeared at all.
                    // A caret-anchored popup (hoverAnchor == none) is the
                    // keyboard's; only the mouse's own is the mouse's to
                    // dismiss.
                    let mouseOwnsPopup = rx.get(hoverAnchor) is Vec2;
                    if rx.get(hoverRequest) && (moved || mouseOwnsPopup) {
                        dismissHover();
                        lastHoverPos := none;
                    }
                } else if restedFor > hoverDwellSeconds
                        && now - lastEditAt > hoverDwellSeconds
                        && pointerInsideEditor(pointer) {
                    // Nothing is on screen here: any pointer movement
                    // cleared it in the branch above, and without movement
                    // this fires once and then sees its own request still
                    // standing. This is also what keeps the branch off a
                    // caret-anchored shift+L popup.
                    if !rx.get(hoverRequest) {
                        let target = documentPositionAt(pointer);
                        // Only over an actual WORD. documentPositionAt()
                        // clamps, so the blank area right of a line's last
                        // character reports that character's position --
                        // meaning without this test, resting the mouse
                        // anywhere in the empty space beside the text
                        // popped up a hover for whatever token happened to
                        // end that line. Punctuation and whitespace are
                        // excluded for the same reason VS Code ignores
                        // them: there is no identifier there to describe.
                        // The clamp inside documentPositionAt() is why the
                        // raw pointer column has to be checked separately:
                        // in vim's normal mode it pins the position to the
                        // LAST CHARACTER of the line, so pointing at empty
                        // space far to the right of a short line still
                        // reports a real word position. Only the untruncated
                        // column can tell the difference.
                        if pointerColumnInsideLine(pointer, target.y)
                            && isWordPositionAt(target) {
                            hoverResult := null;
                            hoverAnchor := { x: pointer.x, y: pointer.y } as Vec2;
                            hoverRequest := target;
                        }
                    }
                }

                // ── Serving the request ──────────────────────────────
                //
                // One query per distinct requested position. This is kept
                // apart from the triggers above so both paths get the same
                // de-duplication, and so a request made while the servers
                // were still starting is retried once they are up: the
                // guard reads hoverAvailable() reactively, so this computed
                // re-runs the moment it flips and the pending request --
                // which is still sitting in hoverRequest -- goes out then.
                let wanted = rx.get(hoverRequest);
                if wanted && vueBridge.hoverAvailable() {
                    let prevPos = rx.get(lastHoverPos);
                    let alreadySent = false;
                    if prevPos {
                        alreadySent = prevPos.x == wanted.x && prevPos.y == wanted.y;
                    }
                    if !alreadySent {
                        lastHoverPos := wanted;
                        // wanted.x is a BYTE offset. The bridge needs the
                        // line's text to convert it into whatever index
                        // space each language server actually counts in.
                        let hoverLine = doc.lineText(wanted.y);
                        let requestedFor: Vec2i = { x: wanted.x, y: wanted.y };
                        // THIS tab's file. The bridge serves every open tab,
                        // so a hover that did not name its own document
                        // would be answered against another one's.
                        vueBridge.hover(filePath, wanted.y, wanted.x, hoverLine, (text: str | null) => {
                            // The answer may arrive after the user has
                            // moved on or dismissed the popup; a reply for
                            // a position we are no longer asking about must
                            // not resurrect it.
                            let current = rx.get(hoverRequest);
                            if !current {
                                return;
                            }
                            if current.x != requestedFor.x || current.y != requestedFor.y {
                                return;
                            }
                            hoverResult := text ? text : "(no hover info at this position)";
                            // The popup was sized around "Loading..." and is
                            // about to be sized around the real signature,
                            // which is a different shape entirely. Drop the
                            // placement so it is resolved again from the new
                            // measurement -- and, because an unresolved
                            // placement is not drawn, the popup simply does
                            // not appear at the wrong size for a frame on
                            // the way there.
                            hoverPlacement := none;
                        });
                    }
                }
                // NOTE: no vueBridge.loop() here. The bridge is shared by
                // every tab (see State.lspBridge), so pumping it from each
                // editor would drain the same connection N times per frame
                // -- and a reply is consumed by whoever reads it first, so
                // the other tabs' callbacks would simply never fire. The
                // shell pumps it exactly once per frame instead.
            }
            else if rx.get(initialText) {
                // No language server for this file, so the branch above --
                // the only other place that lets go of the startup copy --
                // will never run. The highlighter has had its copy since
                // setup and nothing else wants the file as one string, so
                // holding a second full copy of it forever is pure waste.
                initialText := none;
            }
        });

        // Emit one run of a line, split wherever a semantic token covers
        // part of it.
        //
        // This is where the highlighting layers meet, and the order is the
        // whole point: the TextMate colour is the BASE, and the overrides
        // are painted over the parts of it they have an opinion about. That
        // way punctuation, keywords, strings and comments keep the colours
        // the grammar gives them, while an identifier the type checker
        // recognises is recoloured for what it actually is, and a bracket
        // is recoloured for how deeply it nests. It also means the editor
        // looks right before the language server is up, and degrades back
        // to exactly that if it dies.
        //
        // `overrides` is one line's worth, sorted by offset -- see
        // lineColourOverrides, which is the only thing that builds them.
        let pushColouredRun = (parts: []HighlightToken, lineText: str,
            start: int, end: int, baseColor: Color, overrides: []ColourOverride) => {
            let position = start;
            for token in overrides {
                // Already behind the cursor, or beyond this run. The first
                // half is also what resolves any overlap BETWEEN overrides:
                // whichever one starts earlier wins the bytes they share,
                // and the loser is dropped rather than splitting the run in
                // two. Semantic tokens cover identifiers and bracket
                // colours cover single punctuation characters, so the two
                // never actually meet.
                if token.endIndex <= position || token.startIndex >= end {
                    continue;
                }
                // Snapped for the same reason the TextMate offsets are:
                // slicing into the middle of a character produces bytes
                // the text renderer cannot decode into a glyph.
                let tokenStart = unicode.clusterStart(lineText,
                    token.startIndex > position ? token.startIndex : position);
                let tokenEnd = unicode.clusterStart(lineText,
                    token.endIndex < end ? token.endIndex : end);
                if tokenStart > position {
                    parts.push({
                        text: lineText.slice(position, tokenStart),
                        color: baseColor,
                    });
                }
                if tokenEnd > tokenStart {
                    parts.push({
                        text: lineText.slice(tokenStart, tokenEnd),
                        color: token.color,
                    });
                    position = tokenEnd;
                }
            }
            if position < end {
                parts.push({
                    text: lineText.slice(position, end),
                    color: baseColor,
                });
            }
        };

        // Split ONE line's text into coloured runs, given only the tokens
        // that belong to that line. The old version scanned the whole
        // document's token list for every line, which is O(lines x tokens)
        // -- quadratic, re-run on every keystroke, and the main reason
        // typing froze. Tokens are bucketed by line once (see
        // `tokensByLine`) so this only ever walks its own line's tokens.
        //
        // `overrides` is that same line's semantic and bracket colours,
        // painted over the TextMate ones by pushColouredRun above; pass an
        // empty array for text that has neither.
        let splitLineTokens = (lineText: str, tokens: []Token, overrides: []ColourOverride): []HighlightToken => {
            let parts: []HighlightToken = [];
            let position = 0;

            for token in tokens {
                // Token indices are BYTE offsets (the highlighter converts
                // from UTF-16 before sending them -- see toByteOffsets in
                // syntax-engine.ts), but snap them anyway: a slice landing
                // inside a multi-byte character yields a lone lead byte,
                // i.e. text that is not valid UTF-8. The text renderer
                // cannot decode that into a glyph, and the resulting
                // undrawable run corrupts the whole frame. This guard costs
                // a byte comparison on the ASCII fast path and makes that
                // failure mode unreachable regardless of what the
                // highlighter sends.
                let tokenStart = unicode.clusterStart(lineText, token.startIndex);
                if position < tokenStart && tokenStart <= lineText.length {
                    pushColouredRun(parts, lineText, position, tokenStart,
                        defaultTextColor(), overrides);
                }
                let rawEnd = token.endIndex < lineText.length ? token.endIndex : lineText.length;
                let tokenEnd = unicode.clusterStart(lineText, rawEnd);
                if tokenEnd > tokenStart {
                    pushColouredRun(parts, lineText, tokenStart, tokenEnd,
                        getFirstScopeColor(token.scopes), overrides);
                    position = tokenEnd;
                }
            }

            if position < lineText.length {
                pushColouredRun(parts, lineText, position, lineText.length,
                    defaultTextColor(), overrides);
            }
            return parts;
        };

        // Tokens grouped by line index, rebuilt only when a new highlight
        // result arrives -- one pass over the token list instead of one
        // pass per line.
        let tokensByLine = rx.computed(() => {
            rx.get(tokenCacheVersion);
            return rx.get(tokenCache);
        });

        // The coloured runs for a single line, computed on demand. Only
        // VISIBLE lines are ever asked for (see the render loop's use of
        // scroll.visibleRange), so frame cost is O(lines on screen) rather
        // than O(lines in file).
        // Everything that recolours part of a line, merged into one list in
        // offset order.
        //
        // The two sources are independent and never overlap in practice --
        // semantic tokens land on identifiers, bracket colours on single
        // punctuation characters -- so merging them here means the painter
        // below stays a single pass over a single list, whatever ends up
        // feeding it.
        let lineColourOverrides = (lineIndex: int): []ColourOverride => {
            // Read so this re-runs when either cache is replaced. Both are
            // swapped wholesale, and without the versions nothing would
            // notice until the next edit moved the TextMate tokens.
            rx.get(semanticCacheVersion);
            rx.get(bracketCacheVersion);

            let semantic: []SemanticToken = noSemanticTokens;
            // Gated on the theme, not merely on having an answer: a theme
            // that did not opt in is drawn by the grammar alone, cache or
            // no cache.
            if rx.get(semanticHighlightingEnabled) {
                let semanticBuckets: [][]SemanticToken = rx.get(semanticCache);
                // A cache is only as long as the document was when its
                // reply arrived, so a line typed since then simply has no
                // bucket -- and draws with the layers that do until the
                // next reply.
                if lineIndex < semanticBuckets.length {
                    semantic = semanticBuckets[lineIndex];
                }
            }

            let brackets: []BracketToken = noBracketTokens;
            if bracketColorizationEnabled {
                let bracketBuckets: [][]BracketToken = rx.get(bracketTokens);
                if lineIndex < bracketBuckets.length {
                    brackets = bracketBuckets[lineIndex];
                }
            }

            // Nothing recolours this line -- a comment, a blank line, plain
            // prose. Common enough to be worth answering with the shared
            // empty list rather than a new one nobody will ever put
            // anything into.
            if semantic.length == 0 && brackets.length == 0 {
                return noOverrides;
            }

            let overrides: []ColourOverride = [];
            let si = 0;
            let bi = 0;
            while si < semantic.length || bi < brackets.length {
                let takeBracket = si >= semantic.length;
                if !takeBracket && bi < brackets.length {
                    takeBracket = brackets[bi].startIndex <= semantic[si].startIndex;
                }
                if takeBracket {
                    let color = bracketColorFor(brackets[bi].level);
                    if color {
                        overrides.push({
                            startIndex: brackets[bi].startIndex,
                            endIndex: brackets[bi].endIndex,
                            color: color,
                        });
                    }
                    bi = bi + 1;
                }
                else {
                    // A scope this theme has no rule for is dropped rather
                    // than forced to some default, leaving the TextMate
                    // colour standing -- which is better than the line was
                    // without semantic tokens at all.
                    let color = getScopeColor(semantic[si].scope);
                    if color {
                        overrides.push({
                            startIndex: semantic[si].startIndex,
                            endIndex: semantic[si].endIndex,
                            color: color,
                        });
                    }
                    si = si + 1;
                }
            }
            return overrides;
        };

        // ── Per-line run cache ───────────────────────────────────────────
        //
        // The render pass asks every VISIBLE line for its coloured runs on
        // every frame, and producing them is far from free: one clone of
        // the line's text, one overrides list, one run list, and one string
        // slice per run. Over a screenful of lines at 60fps that was
        // thousands of heap allocations per second -- to rebuild output
        // that is byte-for-byte what the previous frame already built,
        // since an idle editor changes none of the inputs.
        //
        // So the answer is memoised per line and thrown away when -- and
        // only when -- something it was derived from moves. There are five
        // such inputs (the text, the TextMate tokens, the semantic tokens,
        // the bracket colours, the theme), every one of them already
        // carries a version that only ever counts UP, and their sum is
        // therefore itself monotonic and changes exactly when one of them
        // does. That makes a single int a complete description of "what
        // these runs were built from", with no per-input bookkeeping.
        //
        // Reading all five here also keeps the render pass subscribed to
        // all five, which is what it was already doing through the
        // individual layers.
        let lineRuns: [][]HighlightToken = [];
        let lineRunStamps: []int = [];

        let renderStamp = (): int => {
            return rx.get(docVersion)
                + rx.get(tokenCacheVersion)
                + rx.get(semanticCacheVersion)
                + rx.get(bracketCacheVersion)
                + themeGeneration.value;
        };

        let highlightedLine = (lineIndex: int): []HighlightToken => {
            let stamp = renderStamp();
            // Entries are only ever created for lines that have actually
            // been on screen, so this grows to the scrolled-through part of
            // the file and no further.
            while lineRunStamps.length <= lineIndex {
                let empty: []HighlightToken = [];
                lineRuns.push(empty);
                lineRunStamps.push(-1);
            }
            if lineRunStamps[lineIndex] == stamp {
                return lineRuns[lineIndex];
            }

            let lineText = doc.lineText(lineIndex);
            let buckets: [][]Token = rx.get(tokensByLine);
            let tokensForLine: []Token = noTokens;
            if lineIndex < buckets.length {
                tokensForLine = buckets[lineIndex];
            }
            let runs = splitLineTokens(lineText, tokensForLine,
                lineColourOverrides(lineIndex));
            lineRuns[lineIndex] = runs;
            lineRunStamps[lineIndex] = stamp;
            return runs;
        };

        // Coloured runs for one line of the popup's code, mirroring
        // highlightedLine() above but reading the hover document's cache.
        let highlightedHoverLine = (lineText: str, lineIndex: int): []HighlightToken => {
            rx.get(hoverTokensVersion);
            let buckets: [][]Token = rx.get(hoverTokens);
            let tokensForLine: []Token = noTokens;
            if lineIndex < buckets.length {
                tokensForLine = buckets[lineIndex];
            }
            // No overrides for the hover popup: its text is a bare
            // signature the language server produced, not a position in any
            // document, so there is nothing to classify it against -- and
            // its brackets are part of a rendered signature rather than
            // code being edited, which VS Code does not rainbow either.
            return splitLineTokens(lineText, tokensForLine, noOverrides);
        };

        // The status bar's indent-width control. Hoisted for the same
        // reason every other stored handler here is: it is kept in the
        // button's runtime data and called back at event-dispatch time, so
        // a literal in the template would be a fresh heap environment on
        // every rebuild.
        let onToggleIndent = () => {
            toggleIndentWidth();
        };

        let onWheel = (event: ui_components.WheelEvent) => {
            scroll.handleWheel(event.delta);
            // The popup is anchored to a place in the text; once
            // the text moves under it, it is pointing at the
            // wrong token. Both editors close it on scroll.
            dismissHover();
        };

        let onPointerDown = (event: ui_components.PointerEvent) => {
            // A press that started on the scrollbar is a
            // scroll gesture, not a text selection.
            if scroll.isDragging() {
                return;
            }
            // Clicking is an interaction with the text, not a
            // request to describe it -- put the popup away. Any
            // button: the popup is pointing at a token, and a right
            // press means you have moved on from reading it too.
            dismissHover();
            // Only the primary button selects. A right or middle
            // press leaves the caret and the selection alone, as a
            // browser does -- right-clicking inside a selection
            // must not destroy the thing you are about to act on.
            if event.button != ui_components.PointerButton.Left {
                return;
            }
            let target = documentPositionAt(event.pos);
            let granularity = textedit_behavior.granularityForClickCount(event.detail);
            let extending = hasModifier(event.modifiers, KeyModifiers.Shift);

            mouseSelecting := true;
            dragOriginPxX := event.pos.x;
            dragOriginPxY := event.pos.y;
            dragOriginX := target.x;
            dragOriginY := target.y;
            // A word or line press has ALREADY produced a
            // selection, and so has a shift+click, so the drag is
            // live from this very frame. Only a plain single press
            // has to wait and see whether it becomes a drag at all
            // -- see the pointer pump below.
            dragMoved := extending || granularity != textedit_behavior.SelectionGranularity.Character;

            if rx.get(vimOn) {
                // Vim's own mouse behaviour: a plain press drops
                // out of visual mode and just places the caret (a
                // subsequent drag re-enters it), while a double or
                // triple press selects and therefore IS a visual
                // selection immediately. Shift+click extends
                // whatever is already there, so it keeps the mode.
                if !extending {
                    texteditBehavior.setMode(textedit_behavior.Mode.Normal);
                    texteditBehavior.clearSelection();
                    if granularity == textedit_behavior.SelectionGranularity.Word {
                        // Set BEFORE selecting: visual mode is what
                        // makes the engine place the caret on the
                        // last selected character rather than past
                        // it (see selectionRangeForLine).
                        texteditBehavior.setMode(textedit_behavior.Mode.Visual);
                    } else if granularity == textedit_behavior.SelectionGranularity.Line {
                        // A triple press means whole lines, and vim
                        // has a mode for exactly that -- so the
                        // selection a following `d` or `y` acts on is
                        // linewise, not a characterwise span that
                        // happens to reach both ends of a line.
                        texteditBehavior.setMode(textedit_behavior.Mode.VisualLine);
                    }
                } else if !textedit_behavior.modeIsVisual(rx.get(texteditBehavior.mode)) {
                    // Shift+click extends, and in vim an extended
                    // selection IS visual mode -- otherwise the
                    // highlight would appear with no mode behind it
                    // and the next `d` would delete a line instead
                    // of the selection.
                    texteditBehavior.setMode(textedit_behavior.Mode.Visual);
                }
            } else if !extending {
                texteditBehavior.clearSelection();
            }

            if extending {
                // Keeps whatever granularity is in force, so double
                // click then shift+click extends by whole words --
                // see textedit_behavior.SelectionGranularity.
                texteditBehavior.extendSelectionTo(target);
            } else {
                texteditBehavior.beginSelection(target, granularity);
            }
        };

        let onTextInput = (event: ui_components.TextInputEvent) => {
            // With Vim active, printable characters are
            // commands in normal/visual mode and literal text
            // in insert mode -- the behavior decides which.
            if rx.get(vimOn) {
                // Hover, as neovim binds it: an explicit
                // command in normal/visual mode (stock LSP
                // configs put `vim.lsp.buf.hover` on K; here it
                // is shift+L). Shifted letters arrive as text
                // input, not as key events, so the intercept
                // belongs here -- and it must happen BEFORE the
                // behavior sees the character, or vim would
                // also run its own "L" motion (screen-bottom).
                //
                // Insert mode is excluded for the same reason
                // neovim excludes it: there, "L" is just a
                // letter you are typing.
                let vimMode = rx.get(texteditBehavior.mode);
                // ...but not while a `:` line is open, where an L is a
                // character of the command being typed and nothing else.
                // Command-line mode is not an engine mode (see
                // Vim.commandLineActive), so the mode check above cannot
                // see it.
                if event.text == "L" && vimMode != textedit_behavior.Mode.Insert
                    && !vim.commandLineOpen() {
                    hoverKeyPressed := true;
                    return;
                }
                texteditBehavior.handleTextInput(event.text);
            } else {
                texteditBehavior.insertText(event.text);
            }
            caretFollow := true;
            noteKeyboardActivity();
            dismissHover();
        };

        let onFocus = (e: ui_components.FocusEvent) => {
            keybindings().context.setBool(ctxEditorTextFocus(), true);
        };

        let onBlur = (e: ui_components.FocusEvent) => {
            keybindings().context.setBool(ctxEditorTextFocus(), false);
            // Autosave. Focus leaving a text editor is the moment its
            // contents stop being something the user is still in the
            // middle of -- switching to another tab, clicking into another
            // panel, or (the same handler, since a hidden element cannot
            // hold focus) having this tab hidden underneath another one.
            //
            // Leaving the OS window entirely does NOT come through here:
            // the window keeps its internal focus while the user is in
            // another application. That edge is handled in main.hz.
            autosave();
        };

        let onKeyDown = (event: ui_components.KeyboardEvent) => {
            let ctrl = hasModifier(event.modifiers, KeyModifiers.Ctrl);
            let shift = hasModifier(event.modifiers, KeyModifiers.Shift);
            let alt = hasModifier(event.modifiers, KeyModifiers.Alt);

            // F2 (toggle the vim editing model) is not handled
            // here any more: it is a keymap rule bound to
            // editor.action.toggleVim, resolved at the window's
            // capture-phase dispatch point before this handler
            // ever runs. See editor_keymap.hz.

            // Any key may move the caret, so ask the next
            // frame to scroll it back into view.
            caretFollow := true;

            if rx.get(vimOn) {
                // Non-character keys (and modifier combos)
                // reach Vim here; plain characters arrive via
                // onTextInput above.
                let name = vim_behavior.namedKey(keyEventName(event.key), ctrl, alt);
                if name.length > 0 {
                    texteditBehavior.handleKey(name);
                    noteKeyboardActivity();
                    // neovim's hover float closes on the next
                    // keypress; so does this one.
                    dismissHover();
                }
                return;
            }

            if event.key == ui_components.Key.Left {
                if ctrl { texteditBehavior.moveCursorWordLeft(shift); }
                else { texteditBehavior.moveCursorLeft(shift); }
            }
            else if event.key == ui_components.Key.Right {
                if ctrl { texteditBehavior.moveCursorWordRight(shift); }
                else { texteditBehavior.moveCursorRight(shift); }
            }
            else if event.key == ui_components.Key.Up {
                texteditBehavior.moveCursorUp(shift);
            }
            else if event.key == ui_components.Key.Down {
                texteditBehavior.moveCursorDown(shift);
            }
            else if event.key == ui_components.Key.Home {
                if ctrl { texteditBehavior.moveCursorDocumentStart(shift); }
                else { texteditBehavior.moveCursorHome(shift); }
            }
            else if event.key == ui_components.Key.End {
                if ctrl { texteditBehavior.moveCursorDocumentEnd(shift); }
                else { texteditBehavior.moveCursorEnd(shift); }
            }
            else if event.key == ui_components.Key.Return {
                texteditBehavior.insertNewline();
            }
            else if event.key == ui_components.Key.Backspace {
                texteditBehavior.deleteBackward(ctrl);
            }
            else if event.key == ui_components.Key.Delete {
                texteditBehavior.deleteForward(ctrl);
            }
            else if event.key == ui_components.Key.Tab {
                // The same unit vim's `>` and insert-mode Tab use, so the
                // two editing models cannot indent a file differently.
                // Without this, Tab did nothing at all outside vim.
                texteditBehavior.insertText(indentString());
                // Tab's default action is to move focus to the next focusable
                // element. A text editor is the canonical case for claiming
                // the key instead -- without this the same press would indent
                // AND tab away from the editor.
                event.preventDefault();
            }
            else if ctrl && event.key == ui_components.Key.A {
                texteditBehavior.selectAll();
            }
            else if ctrl && event.key == ui_components.Key.C {
                texteditBehavior.copy();
            }
            else if ctrl && event.key == ui_components.Key.X {
                texteditBehavior.cut();
            }
            else if ctrl && event.key == ui_components.Key.V {
                texteditBehavior.paste();
            }

            noteKeyboardActivity();
            dismissHover();
        };

@template
    div [w-grow h-grow gap-[do {
        do {
            ui.div({
                id: 2,
            }, () => {
                // Per-tab status line. It stays inside the editor rather
                // than being lifted to the app shell because everything on
                // it -- the vim mode, the caret's own frame timing -- is a
                // property of THIS document, and each tab has its own.
                ui.div({
                    id: 0,
                }, () => {
                    ui.text({
                        id: 0,
                        text: fpsText,
                    });

                    // Which editing model is active, and (in vim) which
                    // mode -- the same information vim's own statusline
                    // shows, because with modal editing you cannot tell
                    // what a keystroke will do without it.
                    ui.text({
                        id: 2,
                        text: modeLabel,
                    },
                        presets.textColor(modeColor)
                    );

                    // The `:` line being typed, and the message the last
                    // save / reload / ex command left behind. Mutually
                    // exclusive: while a command is being typed, the
                    // previous command's answer is no longer what this
                    // area is for.
                    let commandLine = rx.get(commandLineLabel);
                    if commandLine.length > 0 {
                        ui.text({
                            id: 4,
                            text: commandLine,
                        },
                            presets.textColor("#FFFFFF")
                        );
                    }
                    else {
                        let message = rx.get(statusMessage);
                        if message.length > 0 {
                            ui.text({
                                id: 5,
                                text: message,
                            },
                                presets.textColor("#9ECE6A")
                            );
                        }
                    }

                    // Indent width, and the control that changes it --
                    // VS Code puts the same thing in the same place, and a
                    // setting you cannot see is a setting nobody knows they
                    // have. Clicking flips between the two widths for the
                    // whole application (see settings.hz), which is why it
                    // is a plain toggle rather than a menu.
                    ui_widgets.ButtonComponent(ui, {
                        id: 6,
                        label: indentLabel(),
                        bg: "#00000000",
                        bgHover: "#2A2D2E",
                        bgActive: "#37373D",
                        textColor: "#CCCCCC",
                        paddingX: 6.0,
                        paddingY: 0.0,
                        rounded: 3.0,
                        onClick: onToggleIndent,
                    });

                    // A chord waiting for its second stroke. Without this,
                    // pressing ctrl+k looks exactly like pressing nothing:
                    // the key is swallowed and the next one means something
                    // unexpected. VS Code shows the same hint for the same
                    // reason.
                    let chord = rx.get(keybindings().chordHint);
                    if chord.length > 0 {
                        ui.text({
                            id: 3,
                            text: f"{chord} ...",
                        },
                            presets.textColor("#D9B87F")
                        );
                    }

                    if lspMemStat {
                        ui.text({
                            id: 1,
                            text: lspMemStat,
                        });
                    }
                },
                    presets.row(),
                    presets.gap(8),
                    presets.p(1),
                    // Explicitly shrink-wrap the row's height, so the
                    // editor box below it (hGrow) takes ALL the
                    // remaining space instead of the two of them
                    // splitting the column between them.
                    presets.wGrow(),
                    presets.hFit()
                );

                rx.get(runLspLoop);
                // Moves keyboard focus onto this editor when its tab
                // becomes the visible one -- see followActiveFocus.
                rx.get(followActiveFocus);
                // Keeps this editor's `when`-clause context and its
                // command registrations current while it is the visible
                // tab -- see publishEditorContext / ownEditorCommands.
                rx.get(publishEditorContext);
                rx.get(ownEditorCommands);
                // Keeps `gc`'s comment syntax in step with the caret, and
                // lets this tab act on a go-to-definition that landed in
                // it -- see trackCommentString / applyPendingReveal.
                rx.get(trackCommentString);
                rx.get(trackIndentUnit);
                rx.get(applyPendingReveal);

                ui.div({
                    id: 1,
                    elementRef: editorRef,
                    style: {
                        direction: ui_styling.Direction.Column,
                        fontFamily: editorFontFamily(),
                        fontSize: editorFontSize(),
                        textColor: "#FFF" as Color,
                    },
                    focusable: true,

                    // editorTextFocus, the context key that separates "this
                    // key is for the document" from "this key is for the
                    // application" -- see editor_keymap.hz. Tracked from
                    // focus itself rather than from `active`, because it is
                    // literally the question the dispatcher is asking: will
                    // this keystroke reach a text editor?
                    onFocus: onFocus,
                    onBlur: onBlur,

                    // Wheel scrolls the text, exactly like any scroll
                    // container; the scroll model clamps at both ends.
                    onWheel: onWheel,

                    // Click places the caret, drag extends a selection --
                    // chrome's behavior, and what vim does with the mouse
                    // too (a drag puts vim into visual mode).
                    onPointerDown: onPointerDown,
                    // Dragging and releasing are handled by the pointer
                    // capture pump in the render pass, not here: element
                    // events stop firing once the cursor leaves the
                    // element, which would strand a selection (or a
                    // scrollbar drag) half-finished.
                    onTextInput: onTextInput,
                    onKeyDown: onKeyDown,
                }, () => {
                    // Explicit font, so this stays identical to the value
                    // documentPositionAt() uses -- the two MUST agree.
                    let characterSize = ui.measureText("X", editorFontFamily(), editorFontSize());
                    let lineHeight = characterSize.y;
                    let lineCount = doc.lineCount();

                    // Keep the scroll model in sync with the content and
                    // the viewport, then clamp -- deleting the last lines
                    // must not leave the view scrolled past the end.
                    scroll.scrollHeight := lineCount as real * lineHeight;
                    let editorEl = rx.get(editorRef);
                    if editorEl {
                        let viewport = editorEl.size();
                        if viewport {
                            scroll.clientHeight := viewport.y;
                            scroll.clientWidth := viewport.x;
                        }
                    }
                    scroll.clampToBounds();

                    // ── Pointer capture ──────────────────────────────
                    //
                    // Browsers capture the pointer when a drag starts, so
                    // the dragged control keeps tracking the mouse even
                    // once the cursor leaves it -- off the scrollbar, off
                    // the window, anywhere. Element-scoped onPointerMove
                    // cannot do that: it only fires while the cursor is
                    // actually over the element, which is why dragging the
                    // 10px-wide bar used to stop the instant the mouse
                    // slipped sideways.
                    //
                    // So an in-progress drag is driven here instead, from
                    // the global mouse position and button state, which
                    // are polled every frame regardless of what is under
                    // the cursor.
                    //
                    // Which is exactly why it has to be gated on this tab
                    // being the visible one. These are GLOBAL inputs: they
                    // say nothing about which editor the mouse is over, so
                    // an inactive tab polling them would track a drag
                    // happening in the active tab and scroll or select in
                    // lockstep with it, invisibly, until you switched back
                    // and found it moved. Element events do not have this
                    // problem (a hidden element is not hit-tested at all --
                    // see ui_styling.Display); only this per-frame poll does.
                    let leftDown = instance.props().active && ui.leftMouseHeld();

                    if scroll.isDragging() {
                        if leftDown {
                            scroll.updateDrag(ui.mousePos.y - editorOriginY());
                        } else {
                            // Released -- possibly outside the window,
                            // where no onPointerUp will ever arrive.
                            scroll.endDrag();
                            scroll.clampToBounds();
                        }
                    }

                    // Text selection follows the same rule: keep extending
                    // while the button is held, and end the moment it is
                    // released, wherever that happens.
                    if rx.get(mouseSelecting) {
                        if leftDown {
                            // A click and a drag look identical on the frame
                            // after the press. Only once the pointer has
                            // actually reached a DIFFERENT document position
                            // is this a drag -- until then, leave the caret
                            // exactly where the press put it and select
                            // nothing.
                            //
                            // This wait applies to a SINGLE press only. A
                            // double or triple press has already selected
                            // something, so onPointerDown set dragMoved
                            // straight away and the word/line drag is live
                            // from the first frame -- which is what makes
                            // double-click-and-drag feel immediate rather
                            // than needing a cell of slack first.
                            let origin: Vec2i = {
                                x: rx.get(dragOriginX),
                                y: rx.get(dragOriginY),
                            };
                            if !rx.get(dragMoved) {
                                // Purely a pixel test -- see dragOriginPx.
                                // A press must travel at least one whole
                                // cell before it counts as a drag, so the
                                // jitter of a normal click never selects.
                                let dx = ui.mousePos.x - rx.get(dragOriginPxX);
                                let dy = ui.mousePos.y - rx.get(dragOriginPxY);
                                if dx < 0.0 { dx = -dx; }
                                if dy < 0.0 { dy = -dy; }
                                if dx >= characterSize.x || dy >= lineHeight {
                                    dragMoved := true;
                                    // In vim, dragging IS a visual selection.
                                    // Enter it from the PRESS position, not
                                    // the current caret: visual mode allows
                                    // the caret one past the last character,
                                    // so re-deriving it here would shift the
                                    // anchor by one on any click past the
                                    // end of a line.
                                    if rx.get(vimOn) {
                                        let dragMode = rx.get(texteditBehavior.mode);
                                        if !textedit_behavior.modeIsVisual(dragMode) {
                                            texteditBehavior.setMode(textedit_behavior.Mode.Visual);
                                            texteditBehavior.setSelectionAnchor(origin);
                                        }
                                    }
                                }
                            }
                            if rx.get(dragMoved) {
                                // One call for all three granularities: the
                                // engine kept the anchor AND what the press
                                // established, so this is a character drag
                                // after a single click and a word-by-word
                                // drag after a double one -- see
                                // textedit_behavior.SelectionGranularity.
                                texteditBehavior.extendSelectionTo(
                                    documentPositionAt(ui.mousePos));
                            }
                        } else {
                            mouseSelecting := false;
                            dragMoved := false;
                        }
                    }

                    // Apply any scroll the engine asked for (vim's zz/zt/zb
                    // arrive as intents because the engine has no idea how
                    // tall the viewport is), then keep the caret on screen.
                    let cursorLine = texteditBehavior.cursorPosition.y;
                    let cursorTop = cursorLine as real * lineHeight;
                    let intent = rx.get(texteditBehavior.scrollIntent);
                    if intent == textedit_behavior.ScrollIntent.Center {
                        scroll.centerInView(cursorTop, lineHeight);
                    } else if intent == textedit_behavior.ScrollIntent.Top {
                        scroll.scrollToTop(cursorTop);
                    } else if intent == textedit_behavior.ScrollIntent.Bottom {
                        scroll.scrollToBottom(cursorTop, lineHeight);
                    } else if intent == textedit_behavior.ScrollIntent.Reveal {
                        scroll.scrollIntoView(cursorTop, lineHeight);
                    }
                    if intent != textedit_behavior.ScrollIntent.None {
                        texteditBehavior.clearScrollRequest();
                    }
                    if rx.get(caretFollow) {
                        scroll.scrollIntoView(cursorTop, lineHeight);
                        caretFollow := false;
                    }

                    let scrollY = rx.get(scroll.scrollTop);

                    // Only build elements for lines that are actually on
                    // screen. This is what makes idle and typing cost
                    // independent of document length -- the old loop built
                    // a div plus one text element per token for EVERY line
                    // in the file, every frame.
                    let range = scroll.visibleRange(lineHeight, lineCount, 2);
                    let firstLine = range.x;
                    let lastLine = range.y;

                    // Selection highlight, behind the text. Only visible
                    // lines are considered, same as the text itself.
                    for (let i = firstLine; i < lastLine; i++) {
                        let sel = texteditBehavior.selectionRangeForLine(i);
                        if sel {
                            // A line whose selection runs through its
                            // newline gets one extra character of
                            // highlight, so the newline is visible as
                            // selected -- and so an EMPTY line inside a
                            // linewise (V) selection still shows up
                            // instead of collapsing to zero width.
                            // startCol/endCol are BYTE offsets, which are not
                            // proportional to screen distance: an emoji is 4
                            // bytes but 2 cells wide. Convert both ends to
                            // display columns so the highlight lines up with
                            // the glyphs rather than with the byte count.
                            let startCell = texteditBehavior.displayColumnAt(i, sel.startCol);
                            let endCell = texteditBehavior.displayColumnAt(i, sel.endCol);
                            let columns = (endCell - startCell) as real;
                            if sel.includesLineEnd {
                                columns = columns + 1.0;
                            }
                            ui.div({
                                id: 100000 + i,
                                style: {
                                    width: columns * characterSize.x,
                                    height: lineHeight,
                                },
                            }, () => {},
                                presets.absolute(),
                                presets.top(i as real * lineHeight - scrollY),
                                presets.left(startCell as real * characterSize.x),
                                presets.bg("#3391FF55")
                            );
                        }
                    }

                    // The visible text, one absolutely-positioned row per
                    // line so scrolling is a translation rather than a
                    // relayout.
                    for (let i = firstLine; i < lastLine; i++) {
                        let tokens = highlightedLine(i);
                        ui.div({
                            id: 200000 + i,
                        }, () => {
                            if tokens.length > 0 {
                                for t, ti in tokens {
                                    ui.text({ id: ti, text: t.text }, presets.textColor(t.color));
                                }
                            }
                            else {
                                ui.text({ id: 0, text: "" });
                            }
                        },
                            presets.absolute(),
                            presets.top(i as real * lineHeight - scrollY),
                            presets.left(0),
                            presets.row(),
                            // A code line must NEVER wrap. Wrapping puts
                            // the overflow on a second visual row, so the
                            // glyph at column N stops being at
                            // N*charWidth -- and documentPositionAt(),
                            // the caret and the selection highlight all
                            // assume exactly that. Long lines overflow
                            // and get clipped instead, like every editor.
                            presets.noWrap()
                        );
                    }

                    // Caret. In vim's normal/visual modes it is a BLOCK
                    // covering the character it sits on (the caret is *on*
                    // a character there, not between two); in insert mode
                    // and with vim off it is the usual thin bar.
                    let mode = rx.get(texteditBehavior.mode);
                    let blockCaret = mode == textedit_behavior.Mode.Normal
                                  || textedit_behavior.modeIsVisual(mode);

                    // cursorPosition.x is a BYTE offset, so it cannot be
                    // multiplied by a character width directly -- on a line
                    // holding one emoji that would put the caret four cells
                    // right of a glyph two cells wide. displayColumnAt does
                    // the conversion from bytes to cells.
                    let cursorCell = texteditBehavior.displayColumnAt(
                        texteditBehavior.cursorPosition.y,
                        texteditBehavior.cursorPosition.x,
                    );
                    // A block caret must cover the whole character it sits
                    // on, which is two cells wide for CJK and emoji.
                    let caretCells = texteditBehavior.displayWidthOfCharacterAt(
                        texteditBehavior.cursorPosition.y,
                        texteditBehavior.cursorPosition.x,
                    );
                    // ...but where there is NO character under it there is
                    // no width either, and a zero-wide block is an
                    // invisible caret. That is not an edge case: an empty
                    // line in normal mode always lands here (so does the
                    // one-past-the-end position visual mode allows), and
                    // the caret simply vanished. Fall back to one cell,
                    // which is what vim itself draws on a blank line.
                    if caretCells <= 0 {
                        caretCells = 1;
                    }
                    let cursorPos = Vec2(
                        cursorCell as real * characterSize.x,
                        cursorTop - scrollY,
                    );
                    ui.div({
                        id: 300001,
                        style: {
                            width: blockCaret ? caretCells as real * characterSize.x : 1.0,
                            height: lineHeight,
                        },
                    }, () => {},
                        presets.absolute(),
                        presets.top(cursorPos.y),
                        presets.left(cursorPos.x),
                        texteditBehavior.cursorVisible
                            ? (blockCaret ? presets.bg("#FFFFFF99") : presets.bg("#FFF"))
                            : presets.bg("#00000000")
                    );

                    // Scrollbar. Drawn last so it sits above the text,
                    // and only when the content actually overflows
                    // (Overflow.Auto). The thumb is draggable and the
                    // track is clickable -- see ScrollState.beginDragY.
                    if scroll.showsVerticalBar() {
                        let barWidth = scroll.style.size;
                        let trackHeight = scroll.verticalTrackLength();
                        let thumbTop = scroll.verticalThumbOffset();
                        let thumbHeight = scroll.verticalThumbLength();
                        let viewWidth = rx.get(scroll.clientWidth);

                        ui.div({
                            id: 400000,
                            style: { width: barWidth, height: trackHeight },
                            onPointerDown: (event: ui_components.PointerEvent) => {
                                // Stop this reaching the editor underneath,
                                // which would otherwise start a text
                                // selection every time you grab the bar.
                                event.stopPropagation();
                                // Dragging is a primary-button gesture; a
                                // right-click on the bar must not seize the
                                // pointer, or the per-frame drag pump (which
                                // ends the drag on the LEFT button going up)
                                // would never let go of it.
                                if event.button != ui_components.PointerButton.Left {
                                    return;
                                }
                                scroll.beginDragY(event.pos.y - editorOriginY());
                            },
                            // NOTE: no onPointerMove/onPointerUp here.
                            // Element events only fire while the cursor is
                            // over the element, so a drag would die the
                            // moment you moved off the 10px-wide bar. The
                            // drag is instead driven from the per-frame
                            // poll in the render pass (see "pointer
                            // capture" below), which follows the mouse
                            // anywhere -- including outside the window.
                        }, () => {
                            ui.div({
                                id: 0,
                                style: { width: barWidth, height: thumbHeight },
                            }, () => {},
                                presets.absolute(),
                                presets.top(thumbTop),
                                presets.left(0),
                                presets.bg(scroll.isDragging()
                                    ? scroll.style.thumbActiveColor
                                    : scroll.style.thumbColor),
                                presets.rounded(5)
                            );
                        },
                            presets.absolute(),
                            presets.top(0),
                            presets.left(viewWidth - barWidth),
                            presets.bg(scroll.style.trackColor),
                            // The scrollbar sits inside the editor, so it
                            // would inherit the I-beam; it's chrome, not
                            // text. VS Code shows the plain arrow here.
                            presets.cursorDefault()
                        );
                    }

                    // The popup exists whenever a hover was ASKED for, not
                    // only once an answer came back -- otherwise the gap
                    // between the two (a cold language server takes many
                    // seconds) looks exactly like the request having been
                    // ignored. While that gap is open it shows why, so a
                    // slow start reads as "starting up", not as "broken".
                    if rx.get(hoverRequest) {
                        let pending = rx.get(hoverResult);
                        let bridgeForHover = getState().lspBridge;
                        let ready = bridgeForHover && bridgeForHover.hoverAvailable();
                        let hoverText = pending ? pending as str
                            : (ready ? "Loading..." : "Starting language server...");

                        // Anchor: at the pointer for the mouse path (VS
                        // Code puts the popup where you are pointing),
                        // under the caret for the vim path. Both are
                        // converted to editor-local pixels, since the
                        // popup is absolutely positioned inside it.
                        let anchor = rx.get(hoverAnchor);
                        let anchorX = cursorPos.x;
                        let anchorY = cursorPos.y;
                        if anchor {
                            anchorX = anchor.x - editorOriginX();
                            anchorY = anchor.y - editorOriginY();
                        }

                        // ── Placement ────────────────────────────────
                        //
                        // The rule, same as VS Code's: sit ABOVE the hovered
                        // token by default (below it would cover the line
                        // you are about to read, and the next few lines of
                        // code with it), but never leave the viewport --
                        // a popup clipped at an edge is worse than one on
                        // the "wrong" side, since the text simply isn't
                        // there to read.
                        //
                        // Vertically this needs no measurement: `top` puts
                        // the popup's own top edge on the line's top edge,
                        // and translateY(-1) then lifts it by exactly its
                        // OWN height, leaving its bottom on that line -- the
                        // gap closes to `hoverGap` above the token. Being a
                        // fraction of the popup's own size, it resolves
                        // during layout, so it is right on the very first
                        // frame no matter how tall the text turns out to be.
                        let hoverGap = 6.0;
                        let popupSize = none as Vec2 | none;
                        let popupEl = rx.get(hoverPopupRef);
                        if popupEl {
                            popupSize = popupEl.size();
                        }

                        // ── Why the placement is FROZEN once decided ─────
                        //
                        // Both decisions below (flip above/below, clamp the
                        // right edge) read the popup's own measured size --
                        // and a popup that moves is a popup that gets
                        // re-measured, whose new measurement can flip the
                        // decision straight back. That is a feedback loop
                        // with no fixed point, and it ran once per frame:
                        // the popup visibly vibrated between two positions
                        // the entire time it was open.
                        //
                        // A hover's content never changes after it arrives
                        // and its anchor never moves while it is open (any
                        // pointer movement dismisses it outright -- see the
                        // dwell branch), so its correct position is a
                        // CONSTANT. It only has to be computed once, on the
                        // first frame where the size is actually known, and
                        // then left alone. Recomputing it every frame was
                        // never buying anything; it was only ever able to
                        // do harm.
                        let placement = rx.get(hoverPlacement);
                        if !placement && popupSize is Vec2 {

                            // Viewport to stay inside: the editor's own box,
                            // in the same editor-local coordinates the popup
                            // is positioned in (so its top-left is 0,0).
                            let viewportW = 0.0;
                            let viewportH = 0.0;
                            let editorBox = rx.get(editorRef);
                            if editorBox {
                                let vp = editorBox.size();
                                if vp {
                                    viewportW = vp.x;
                                    viewportH = vp.y;
                                }
                            }

                            // Flip below the token when there isn't room
                            // above.
                            let above = true;
                            if anchorY - hoverGap < popupSize.y {
                                // Only flip if below is genuinely roomier;
                                // otherwise a popup taller than the viewport
                                // would flip to a side that fits it no better.
                                let roomBelow = viewportH - (anchorY + characterSize.y + hoverGap);
                                if roomBelow > anchorY - hoverGap {
                                    above = false;
                                }
                            }

                            // Horizontal clamp: keep the right edge inside
                            // the viewport, then re-clamp the left to 0 so a
                            // popup wider than the viewport stays anchored at
                            // the left edge rather than being pushed off it
                            // (a negative left would hide the START of the
                            // signature, which is the part worth reading).
                            let x = anchorX;
                            if viewportW > 0.0 {
                                let maxX = viewportW - popupSize.x - hoverGap;
                                if x > maxX { x = maxX; }
                            }
                            if x < 0.0 { x = 0.0; }

                            // Above: top edge on the token's top edge, then
                            // lifted by the popup's own full height
                            // (translate), minus the gap. Below: straight
                            // under the token, no translate needed.
                            let y = above
                                ? anchorY - hoverGap
                                : anchorY + characterSize.y + hoverGap;

                            hoverPlacement := HoverPlacement { x: x, y: y, above: above };
                        }

                        // Until the popup has been measured there is nowhere
                        // correct to put it, so for that one frame it is
                        // laid out but not VISIBLE. Drawing it at a
                        // provisional position is exactly the "appears, then
                        // jumps" flash this exists to avoid; one frame of
                        // nothing is imperceptible, a jump is not.
                        //
                        // Deliberately NOT display:none: that removes the
                        // element from layout entirely, so it would never be
                        // measured, so the placement would never resolve and
                        // the popup would never appear at all. It has to be
                        // laid out to be measured -- it just must not be
                        // painted yet. Transparent colours are how you say
                        // "occupy space, show nothing"; the text inside is
                        // covered by the same treatment below.
                        let resolved = rx.get(hoverPlacement);
                        let measuring = !resolved;
                        let popupX = resolved ? resolved.x : 0.0;
                        let popupY = resolved ? resolved.y : 0.0;
                        let above = resolved ? resolved.above : true;
                        // Applied to every run of text in the popup, so the
                        // measuring frame lays the real text out (that is
                        // what gives the box its size) while showing none of
                        // it. Text colour does not inherit far enough to do
                        // this from the container alone -- each run sets its
                        // own colour from the theme.
                        let hoverInk = (color: Color): Color => {
                            return measuring ? "#00000000" as Color : color;
                        };

                        ui.div({
                            id: 300002,
                            elementRef: hoverPopupRef,
                        }, () => {
                            if !pending {
                                // Still waiting on the language server --
                                // there is no content to colour yet, only
                                // the placeholder saying so.
                                //
                                // On its OWN id, disjoint from the block
                                // ids below (which are 0..n). The child
                                // cache is keyed by id per parent and an
                                // element's type is fixed the first time
                                // that id is seen -- so sharing id 0 with
                                // block 0 means the whole subtree under it
                                // has to agree on every element's type at
                                // every depth, forever. It doesn't and
                                // can't: the placeholder is one line of
                                // prose, a code block is a div per line.
                                // Giving the placeholder an id no block
                                // will ever take makes the two subtrees
                                // independent, so neither constrains the
                                // other's shape.
                                ui.text({
                                    id: hoverPlaceholderId,
                                    text: hoverText,
                                },
                                    presets.textColor(hoverInk("#9A9A9A"))
                                );
                            }
                            else {
                                // Code blocks are drawn line by line as
                                // coloured runs, exactly the way the editor
                                // draws a buffer line (same splitLineTokens,
                                // same theme colours) -- which is the whole
                                // point: a signature in the popup should
                                // look identical to the same signature in
                                // the file. Prose keeps the dimmer
                                // documentation colour and wraps normally.
                                //
                                // `codeLine` walks the SAME line space the
                                // engine was given (hoverCodeText), so token
                                // line numbers line up with the text here.
                                let blocks: []HoverBlock = rx.get(hoverBlocks);
                                let stackref codeLine = Box<int>(0);
                                for block, bi in blocks {
                                    // EVERY block gets a div wrapper,
                                    // whether it is code or prose.
                                    //
                                    // The child cache is keyed by plain id
                                    // per parent and an element's TYPE is
                                    // fixed the first time that id is seen
                                    // (see getOrCreateDiv in
                                    // ui_components.hz, which hard-asserts
                                    // on a type change). Emitting a div for
                                    // one block kind and a bare text node
                                    // for the other therefore panics as soon
                                    // as two successive hovers disagree
                                    // about what block `bi` is -- and they
                                    // routinely do, since a bare tsserver
                                    // signature is all-code while an LSP
                                    // markdown reply is code-then-prose.
                                    // A uniform wrapper makes the type at
                                    // any given id constant by construction.
                                    ui.div({
                                        id: bi,
                                    }, () => {
                                        if block.isCode {
                                            for lineText, li in block.text.split("\n") {
                                                let runs = highlightedHoverLine(lineText, codeLine.value);
                                                codeLine.value = codeLine.value + 1;
                                                ui.div({
                                                    id: li,
                                                }, () => {
                                                    if runs.length > 0 {
                                                        for run, ri in runs {
                                                            ui.text({
                                                                id: ri,
                                                                text: run.text,
                                                            },
                                                                presets.textColor(hoverInk(run.color))
                                                            );
                                                        }
                                                    }
                                                    else {
                                                        // No tokens yet (the
                                                        // engine's reply lands
                                                        // a frame later): show
                                                        // the text uncoloured
                                                        // rather than nothing.
                                                        ui.text({
                                                            id: 0,
                                                            text: lineText,
                                                        },
                                                            presets.textColor(hoverInk(defaultTextColor()))
                                                        );
                                                    }
                                                },
                                                    presets.row(),
                                                    // Same reason as a
                                                    // buffer line: a
                                                    // wrapped run would
                                                    // break the column
                                                    // alignment of code.
                                                    presets.noWrap()
                                                );
                                            }
                                        }
                                        else {
                                            // Prose gets an id disjoint from
                                            // the code lines' (0..n), for the
                                            // same reason the placeholder
                                            // does: block `bi` flips between
                                            // code and prose across hovers
                                            // (bare quickinfo is all-code,
                                            // markdown is code-then-prose),
                                            // and the two shapes are a text
                                            // node versus a div-per-line.
                                            // Disjoint ids let each keep its
                                            // own shape instead of forcing a
                                            // common one.
                                            ui.text({
                                                id: hoverProseId,
                                                text: block.text,
                                            },
                                                presets.textColor(hoverInk("#9A9A9A"))
                                            );
                                        }
                                    },
                                        presets.col()
                                    );
                                }
                            }
                        },
                            presets.absolute(),
                            presets.top(popupY),
                            presets.left(popupX),
                            // -1 = "up by exactly my own height", so the
                            // popup's BOTTOM lands on popupY. Only when
                            // sitting above; below already starts at the
                            // right place.
                            presets.translateY(above ? -1.0 : 0.0),
                            // Blocks (and code lines within them) stack
                            // vertically, like the editor's own lines.
                            presets.col(),
                            // Fully transparent on the measuring frame
                            // -- see `measuring` above. Same box, same
                            // size, simply not painted yet.
                            presets.bg(measuring ? "#00000000" : "#181818"),
                            presets.border(1),
                            presets.borderColor(measuring ? "#00000000" : "#4F4F4F"),
                            presets.rounded(2),
                            // Without a bound, a long signature runs off
                            // the right edge and the text is unreadable.
                            presets.p(2),
                            // A popup floating over the text is chrome:
                            // it would otherwise inherit the editor's
                            // I-beam, implying you can select into it.
                            presets.cursorDefault()
                        );
                    }
                },
                    presets.relative(),
                    presets.wGrow(),
                    presets.hGrow(),
                    presets.col(),
                    presets.bg("#181818"),
                    // Lines are absolutely positioned at a scroll-offset
                    // top, so the ones scrolled past either edge would
                    // otherwise paint straight over the statusline and
                    // out past the window. Clip them to this box.
                    presets.overflowHidden(),
                    // I-beam over the text, exactly like VS Code. Set on
                    // the editor box rather than on each line so it also
                    // covers the empty space past the last line and to
                    // the right of short lines -- which is still text you
                    // can click into. Inherited by the lines; the
                    // scrollbar overrides it back to an arrow.
                    presets.cursorText(),
                    // presets.p(8)
                );
            },
                presets.col(),
                presets.wGrow(),
                presets.hGrow(),
                presets.textColor("#FFF"),
                presets.gap(2)
            );
        }
        0.0
    }]] {}