
import app
import ui_runtime
import ui_components
import filedialog
import wgpu

const comptime profile = false;
const comptime vsync = true;

// Translates app's platform-level pointer edge queue into ui_components'
// own PointerEdge type -- kept as a small glue function here (rather than
// having either module import the other's types) so app stays ignorant of
// the UI component tree and ui_components stays ignorant of SDL/app, same
// as mousePos/wheelDelta/modifiers just below.
// `out` is the caller's reusable buffer rather than a fresh array: this runs
// once per frame, and ui_components only reads the result inside the same
// process() call (see its `edges` local), so nothing outlives the frame and
// clear() lets the buffer keep the capacity it already grew to.
fn toUIPointerEdges(a: app.App, out: mut []ui_components.PointerEdge): []ui_components.PointerEdge {
    let result = out;
    result.clear();
    for e in a.pointerEdges() {
        let button = ui_components.PointerButton.None;
        if e.button == 0 { button = ui_components.PointerButton.Left; }
        else if e.button == 1 { button = ui_components.PointerButton.Middle; }
        else if e.button == 2 { button = ui_components.PointerButton.Right; }
        let kind = e.kind == app.PointerEdgeKind.Pressed ? ui_components.PointerEdgeKind.Pressed : ui_components.PointerEdgeKind.Released;
        result.push({ button: button, kind: kind, pos: e.pos });
    }
    return result;
}

// Reinterprets app.KeyEdge.key (an sdl.Key, though this file doesn't import
// sdl to name it directly -- T just infers as that) into a ui_components.Key
// -- both enums are independently pinned to the same USB HID scancode
// numbering (see ui_components.Key's doc comment), so this is a cheap
// raw-int reinterpret rather than an N-armed mapping, same trick sdl.hz's
// own scancodeToKey() uses to build a sdl.Key out of a raw scancode in the
// first place. Plain `as` doesn't allow this (Haze has no built-in
// conversion between two unrelated enum types), hence dropping to unsafe C.
fn sdlKeyToUIKey<T>(k: T): ui_components.Key :: final {
    do unsafe {
        let result: ui_components.Key = uninitialized;
        __c__("result = (int)k;");
        return result;
    };
}

// Translates app's platform-level key edge queue into ui_components' own
// KeyEdge type.
// Reuses the caller's buffer, same as toUIPointerEdges above.
fn toUIKeyEdges(a: app.App, out: mut []ui_components.KeyEdge): []ui_components.KeyEdge {
    let result = out;
    result.clear();
    for e in a.keyEdges() {
        let kind = e.kind == app.KeyEdgeKind.Pressed ? ui_components.KeyEdgeKind.Pressed : ui_components.KeyEdgeKind.Released;
        result.push({ key: sdlKeyToUIKey(e.key), kind: kind, repeat: e.repeat, modifiers: e.modifiers });
    }
    return result;
}

fn main(): int {
    // Headless check of the keybinding harness -- the `when` parser and the
    // chord dispatcher, which fail silently rather than loudly (see
    // keybindings_selftest.hz). Gated on an env var because there is no
    // argv accessor in the stdlib yet, and taken before the window is
    // created so it needs no GPU.
    let selftest = env.get("CODEEDITOR_SELFTEST");
    if selftest {
        return runEditorSelfTest(selftest as str);
    }

    attempt {
        let a = app.App({
            title: "Haze CodeEditor",
            presentMode: vsync ? wgpu.PresentMode.Fifo : wgpu.PresentMode.Mailbox,
        })?!;

        let font = a.gfx.fontRenderer.fs.addFont(
            "roboto-regular",
            "test/Roboto-Regular.ttf"
        );

        let monoFont = a.gfx.fontRenderer.fs.addFont(
            "JetBrainsMonoNerdFont-Regular",
            "codeeditor/resources/JetBrainsMonoNerdFont-Regular.ttf"
        );

        // Reused every frame by the two edge-queue callbacks below, so the
        // per-frame translation costs no allocation after the first frame.
        let pointerEdgeScratch: mut []ui_components.PointerEdge = [];
        let keyEdgeScratch: mut []ui_components.KeyEdge = [];

        let runtime = ui_runtime.Runtime({
            gfx: a.gfx,
            windowState: a.windowState,
            fonts: [
                { name: "roboto", id: font },
                { name: "JetBrainsMonoNerdFont-Regular", id: monoFont },
                { name: "default", id: font },
            ],
            mousePos: () => a.mousePos(),
            // Lets the UI tell "pointer at the window's top-left" apart
            // from "the pointer has never been over this window", which
            // are the same (0,0) otherwise -- see UIContext.mousePosKnown.
            mousePosKnown: () => a.mousePosKnown(),
            pointerButtons: ui_components.PointerHeldCallbacks {
                leftHeld: () => a.pointerLeftHeld(),
                middleHeld: () => a.pointerMiddleHeld(),
                rightHeld: () => a.pointerRightHeld(),
                edgesThisFrame: () => toUIPointerEdges(a, pointerEdgeScratch),
            },
            inputExtras: ui_components.InputExtrasCallbacks {
                wheelDelta: () => a.wheelDelta(),
                modifiers: () => a.wheelModifiers(),
            },
            keyboard: ui_components.KeyboardCallbacks {
                keyEdgesThisFrame: () => toUIKeyEdges(a, keyEdgeScratch),
                textInputThisFrame: () => a.textInput(),
            },
            // The index is a ui_styling.Cursor; app maps it to the platform
            // cursor. Called every frame, and cheap when unchanged.
            setCursor: (index: int): void => { app.setCursor(index); },
            // The platform clipboard, for widgets that cut/copy/paste (see
            // ui_components.ClipboardCallbacks). Omit it and ui.hasClipboard()
            // reports false, which widgets read as "use your own register".
            clipboard: ui_components.ClipboardCallbacks {
                getText: (): str => { return app.getClipboardText(); },
                setText: (text: str): bool => { return app.setClipboardText(text); },
            },
            ui: (ui: ui_components.UIContext) => { UI(ui, a.gfx); },
        });

        // Which files to open is the UI shell's decision now, not this
        // one's: it owns the tab list, restores the previous session from
        // the shared cache (see appcache.hz), and asks for a file only when
        // that turns out to be empty. Picking one here as well would have
        // prompted before the window even existed, and then again for the
        // same thing.

        buildSyntaxEngine();
        // installLSP();

        let highlightEngine = HighlightEngine("codeeditor/syntax-engine/syntax-engine");
        if (!highlightEngine) {
            fmt.println("Highlight engine failed to start");
            return 0;
        }
        initState({
            highlightEngine: highlightEngine,
            reactiveCounter: rx.reactive<int>(0),
        });

        // The language servers are NOT started here any more, and their
        // project root is no longer a constant compiled into this file
        // (which is what made every file outside one particular checkout
        // resolve against the wrong project). They belong to the open
        // WORKSPACE: restore whichever folder was open last, then bring
        // them up against it through exactly the same call a later "Open
        // Folder" makes, so the startup path and the switch path cannot
        // drift apart. With no folder open this starts nothing at all --
        // see the header comment in workspace.hz for why that is better
        // than guessing a root.
        restoreWorkspaceFromCache();
        restartLanguageServers();
        // let engine = installLSP();
        // if !engine {
        //     return 0;
        // }

        let profiler = profile ? Profiler({
            samplingRate: 0,
            // memoryInstrumentationStacktraces: false,
        }) : null;

        while let frame = a.nextFrame() {
            if a.resized {
                runtime.resize(a.windowState);
            }
            runtime.render(frame, a.canvas);
            frame.present();

            let highlightResult = getState().highlightEngine.loop();
            if highlightResult {
                assert(g_state);
                g_state.highlightResults.push(highlightResult);
                g_state.reactiveCounter++;
            }

            // ── The OS window's own focus ────────────────────────────
            //
            // The other half of the autosave rule. An editor saves when
            // keyboard focus leaves it INSIDE the application (see the
            // onBlur in EditorView), but switching to another program does
            // not move that focus at all -- the window keeps its internal
            // focus and simply stops being the current one. This is that
            // edge, and it is only visible from here.
            //
            // Coming back is the mirror image: an edit made in another
            // program has just finished, so every open file is re-checked
            // immediately rather than waiting out the poll interval.
            if a.justLostFocus() {
                documents().saveAllDirty();
            }
            if a.justGainedFocus() {
                documents().checkAllDisk();
            }

            // Retire the node processes of any language servers that a
            // workspace switch replaced. Non-blocking, and a no-op unless
            // a switch actually happened -- see reapRetiredProcesses.
            reapRetiredProcesses();

            appCache().flush();
        }
        
        if profiler {
            profiler.stopAndSave();
        }

        a.destroy();
        return 0;
    }
    else e {
        if e is str {
            fmt.println("Application failed: ", e);
        }
        else if e is fs.Error {
            fmt.println("Application failed: ", e);
        }
        else if e is none {
            fmt.println("Application failed: ", e);
        }
        else {
            fmt.println("Application failed: ", e);
        }
        return 1;
    };
}
