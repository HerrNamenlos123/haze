from ui_widgets import TextInput, TextInputComponent, ButtonComponent, ButtonSlotContent, FloatingPanelComponent, FloatingPanelSlotBody

// Ctrl+R: the remembered folders, filtered by what is typed. Same shape and
// keys as QuickOpen.

@props
open: bool = false;

@emit
close: ();
pick: (str,);

@setup
let query = reactive<str>("");
let selected = reactive<int>(0);
let session = reactive<int>(0);
let focused = reactive<int>(0);
let inputRef = ui.componentRef<TextInput>();

ui.watch(() => props.open, (open: bool, previous: bool | none) => {
    if !open { return; }
    query := "";
    selected := 0;
    session := rx.get(session) + 1;
}, { immediate: true });

ui.onFrame(() => {
    if rx.get(focused) == rx.get(session) { return; }
    let input = rx.get(inputRef);
    if !input { return; }
    input.focus();
    focused := rx.get(session);
});

let rows = computed((): []str => {
    let needle = asciiLower(rx.get(query));
    let all: []str = rx.get(workspace().recents);
    let out: []str = [];
    for path in all {
        if needle.length == 0 || asciiLower(path).contains(needle) {
            out.push(path);
        }
    }
    return out;
});

let dismiss = () => { emits.close(); };
let retyped = (text: str) => { selected := 0; };
let pickAt = (index: int) => {
    let list: []str = rx.get(rows);
    if index < 0 || index >= list.length { return; }
    emits.pick(list[index]);
};
let accept = (text: str) => { pickAt(rx.get(selected)); };

let step = (delta: int) => {
    let count = rx.get(rows).length;
    if count == 0 { return; }
    let next = rx.get(selected) + delta;
    selected := next < 0 ? count - 1 : (next >= count ? 0 : next);
};

let onKey = (event: KeyboardEvent) => {
    let ctrl = hasModifier(event.modifiers, KeyModifiers.Ctrl);
    if event.key == Key.Down || (ctrl && event.key == Key.N) { step(1); }
    else if event.key == Key.Up || (ctrl && event.key == Key.P) { step(-1); }
    else if event.key == Key.Escape { emits.close(); }
    else { return; }
    event.preventDefault();
    event.stopPropagation();
};

@template [w-fit h-fit]

FloatingPanel if=[props.open] [] position=[ui_widgets.PanelPosition.Top] marginTop=[90]
    backgroundColor=["#252526"] radius=[6] @close=dismiss
{
    #body {
        div [col gap-1 w-[600]px h-fit p-2 overflow-hidden cursor-default] @keydown=onKey {
            TextInput [] ref=inputRef text=[query] placeholder="Open recent folder"
                backgroundColor="#313131" focusRing=[0] @submit=accept @change=retyped {}

            div if=[rows.length == 0] [px-2 py-1 h-fit] {
                text [text-color-["#8A8A8A"]] ["No recent folders"]
            }

            Button for=[path, index in rows] key=[index] [] icon="folder" label=[path] grow=[true]
                focusRing=[0] rounded=[3] bgHover="#2A2D2E" bgSelected="#04395E"
                selected=[index == rx.get(selected)] @click=[() => { pickAt(index); }] {}
        }
    }
}
