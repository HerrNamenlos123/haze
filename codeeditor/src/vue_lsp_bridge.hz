
import language_server_protocol
import unicode

// --- Architecture ------------------------------------------------------
//
// `@vue/language-server` runs in "hybrid mode": it has no semantic
// TypeScript language service of its own (see its own bundled plugin list
// -- template, directives, component props, syntactic-only TS stuff, but
// no semantic TS plugin at all). Real TypeScript understanding -- hover,
// definitions, anything requiring an actual type checker -- has to come
// from a real `tsserver` process with `@vue/typescript-plugin` loaded,
// which the *client* (us) is responsible for spawning and owning. That
// gives this module three genuinely separate channels to juggle, not one:
//
//   1. The LSP connection to vue-language-server itself (`_lsp`). Answers
//      template/HTML/SFC-structural hover and diagnostics directly, no
//      tsserver involved.
//
//   2. A `tsserver/request` / `tsserver/response` notification relay:
//      vue-language-server can't itself hold a real, project-aware
//      tsserver in hybrid mode, so for its own Vue-specific queries
//      (`_vue:projectInfo`, `_vue:getComponentProps`, ...) it asks *us* to
//      run them against our tsserver and hand the result back. See
//      handleNotification/_emitTsServerResponse.
//
//   3. Requests *we* issue directly against our own tsserver (currently
//      just `quickinfo`). `@vue/typescript-plugin` registers with tsserver
//      as a standard TS Language Service Plugin (see its index.js:
//      `createLanguageServicePlugin` from `@volar/typescript`, which wraps
//      the project's `languageService` in a proxy understanding `.vue`
//      files) -- so tsserver's own plain commands already understand
//      `.vue` positions once the plugin's loaded and a project is open.
//      This is the actual source of real hover for anything inside
//      `<script setup>`, and it never touches vue-language-server's LSP
//      connection at all. See sendQuickInfoRequest/hover.
//
// Channels 2 and 3 both require tsserver to already have a project loaded
// for the file (i.e. `open` to have completed) -- `@vue/typescript-plugin`
// only registers its patches once tsserver creates a project. A request
// that races ahead of `open` gets "Unrecognized JSON command" (channel 2)
// or just answers as a plain, Vue-less TypeScript file (channel 3).
// openDocument()/hover() below enforce that ordering internally so callers
// don't have to think about it.

// Duplicates a C string into an owned, GC'd Haze str -- needed because
// SDL's SDL_TextInputEvent.text (unrelated file, same trick) and here
// hzstd_get_cwd()'s stack buffer are both short-lived/reused.
//
// hzstd_get_cwd is the platform layer's own wrapper (hzstd_platform.h, pulled
// in by hzstd.h, so always in scope): plain getcwd() lives in <unistd.h>,
// which the Windows toolchain does not have, while the wrapper is
// GetCurrentDirectoryA there and getcwd() on Linux. It returns false on
// failure and leaves the buffer unspecified, so the buffer is emptied first --
// toAbsolutePath then produces a visibly wrong path starting with "/" instead
// of whatever bytes happened to be on the stack.
fn getCwdAbsolute(): str :: final {
    do unsafe {
        let result: str = uninitialized;
        __c__("char __hz_cwd_buf[4096]; if (!hzstd_get_cwd(__hz_cwd_buf, sizeof(__hz_cwd_buf))) { __hz_cwd_buf[0] = 0; } result = hzstd_cstr_dup(__hz_cwd_buf);");
        return result;
    };
}

// vue-language-server dynamically `require()`s `typescript.tsdk` and each
// plugin's `location` from its own installed location deep inside its own
// node_modules, not from our cwd -- relative paths silently resolve to
// nothing there, degrading hybrid mode without any error. codeeditor is
// always launched from the haze2 repo root (same assumption every other
// "codeeditor/..." relative resource path in this codebase already makes),
// so cwd + a repo-relative path is exactly the absolute path needed.
fn toAbsolutePath(relativePath: str): str {
    return getCwdAbsolute() + "/" + relativePath;
}

export struct VueInitializationOptions {
    struct Plugin {
        name: str;
        location: str;
        languages: []str;
    };
    plugins: []Plugin;

    struct TypeScript {
        tsdk: str;
    };
    typescript?: TypeScript;
}

struct TsServerRequestMessage {
    seq: int;
    type: str;
    command: str;
    arguments: json.Node;
}

struct TsServerResponseMessage {
    seq: int;
    type: str;
    request_seq?: int;
    success?: bool;
    command?: str;
    body?: json.Node;
    message?: str;
}

// tsserver's `exit` command takes no arguments; this exists only so an
// empty arguments object can be built the same way every other command's
// is (a json.Node cannot be default-constructed).
struct TsServerExitArgs {}

// tsserver's `definition` command. Identical in shape to QuickInfoArgs --
// 1-based line, 1-based UTF-16 offset.
struct DefinitionArgs {
    file: str;
    line: int;
    offset: int;
}

// One entry of tsserver's `definition` reply: a FileSpan. `file` is a plain
// absolute filesystem PATH, not a URI -- which is a second reason (beyond
// hybrid mode) to ask tsserver rather than vue-language-server: there is no
// percent-decoding and no file:// scheme to unpick.
struct DefinitionSpan {
    file: str = "";
    start: TsServerLocation = {};
    end: TsServerLocation = {};
}

// Where a definition lives, in the terms the editor needs to go there.
export inline struct DefinitionTarget {
    // Absolute path. May be a file that is not open, or not even a file the
    // user has ever seen (a .d.ts inside node_modules).
    filepath: str;
    // 0-based, converted from tsserver's 1-based line.
    line: int;
    // 0-based UTF-16 code units into that line -- NOT a byte column.
    //
    // Converting to a byte column needs the TEXT of the target line, and
    // for a file that is not open yet there is no text to consult. So the
    // raw offset travels to the destination and is converted there, once
    // the document exists. See applyPendingReveal in codeui.hz.
    utf16Offset: int;
}

struct QuickInfoArgs {
    file: str;
    line: int;    // 1-based, per TS Server Protocol (unlike LSP's 0-based)
    offset: int;  // 1-based
}

// Subset of tsserver's QuickInfoResponseBody we actually use.
struct QuickInfoBody {
    displayString?: str;
    documentation?: str;
}

// --- Incremental document sync ----------------------------------------
//
// tsserver's own edit shape (protocol.CodeEdit): 1-BASED line and offset,
// unlike LSP's 0-based Position right next to it. The +1s live in
// changeDocument() rather than in callers.
struct TsServerLocation {
    line: int = 0;
    offset: int = 0;
}

struct TsServerCodeEdit {
    start: TsServerLocation;
    end: TsServerLocation;
    newText: str;
}

struct TsServerFileCodeEdits {
    fileName: str;
    textChanges: []TsServerCodeEdit;
}

struct UpdateOpenArgs {
    changedFiles: []TsServerFileCodeEdits;
}

// One edit, phrased the way BOTH servers want it.
//
// The range always starts at column 0 of `startLine`, because every edit
// this editor forwards is line-granular: whole lines are replaced by whole
// lines, which is exactly what text_document.ChangeSet reports. That
// matters more than it looks -- column 0 means the same thing in every
// position encoding there is, so no line has to be scanned to convert it.
//
// `endColumn` is the ONE exception, and it is only ever non-zero for an
// edit whose replaced range ran to the end of the document: there is no
// "line after the last line" to point at, so the range has to end at the
// last line's end instead. It is a BYTE offset, sent verbatim.
export inline struct DocumentChange {
    // First replaced line, 0-based. The range starts at its column 0.
    startLine: int;
    // Line the range ends on, 0-based. Normally the line one PAST the last
    // replaced one (with endColumn 0), so the trailing newline is part of
    // what gets replaced.
    endLine: int;
    endColumn: int = 0;
    // What the range was replaced with. Ends with a newline whenever the
    // range ended at column 0 of a following line.
    newText: str;
}

// --- Semantic classification -------------------------------------------

struct SemanticClassificationsArgs {
    file: str;
    // Byte offsets into the whole file. tsserver counts UTF-16 code units
    // here; this editor deliberately treats those as bytes -- see
    // semanticTokens() for what that does and does not cost.
    start: int;
    length: int;
    // "2020" is the packed encoding decoded by decodeSemanticSpans below.
    // The alternative, "original", is a different and much coarser scheme.
    format: str;
}

struct SemanticClassificationsBody {
    spans?: []int;
    endOfLineState?: int;
}

// One classified span of a document.
export inline struct SemanticSpan {
    start: int;
    length: int;
    // Index into semanticTokenTypeName().
    tokenType: int;
    // Bit set over semanticTokenModifierName()'s indices.
    tokenModifiers: int;
}

// tsserver's semantic token types, in ITS OWN index order -- the number
// packed into a classification is an index into exactly this list, so the
// order is part of the wire format and must not be sorted or extended.
//
// Mirrors the table in
// volar-service-typescript/lib/semanticFeatures/semanticTokens.js, which
// is what VS Code's TypeScript and Vue support decode with.
export fn semanticTokenTypeName(index: int): str {
    if index == 0 { return "class"; }
    if index == 1 { return "enum"; }
    if index == 2 { return "interface"; }
    if index == 3 { return "namespace"; }
    if index == 4 { return "typeParameter"; }
    if index == 5 { return "type"; }
    if index == 6 { return "parameter"; }
    if index == 7 { return "variable"; }
    if index == 8 { return "enumMember"; }
    if index == 9 { return "property"; }
    if index == 10 { return "function"; }
    if index == 11 { return "method"; }
    return "";
}

// Modifier BIT positions, again in tsserver's own order.
export fn semanticTokenModifierName(index: int): str {
    if index == 0 { return "declaration"; }
    if index == 1 { return "static"; }
    if index == 2 { return "async"; }
    if index == 3 { return "readonly"; }
    if index == 4 { return "defaultLibrary"; }
    if index == 5 { return "local"; }
    return "";
}

// Whether a SemanticSpan's modifier set contains bit `index`.
//
// Written as repeated halving rather than `modifiers & (1 << index)`
// because Haze reserves `&` for reference-of and has no bitwise-and.
export fn hasSemanticModifier(modifiers: int, index: int): bool {
    let shifted = modifiers;
    for (let i = 0; i < index; i++) {
        shifted = shifted / 2;
    }
    return shifted % 2 == 1;
}

// Decode tsserver's "2020"-format classification array.
//
// The wire form is a FLAT list of triples -- start, length, encoded --
// where `encoded` packs both facts about the token into one number: the
// low 8 bits are the modifier set, and the rest, minus one, is the type
// index. A value that fits entirely in those low 8 bits therefore carries
// no type at all and is dropped, exactly as VS Code's own decoder does.
//
// Division and modulo stand in for the shift and mask the encoding is
// really made of; see hasSemanticModifier for why.
fn decodeSemanticSpans(body: json.Node | none): []SemanticSpan {
    let spans: []SemanticSpan = [];
    if !body {
        return spans;
    }
    let parsed = json.parse<SemanticClassificationsBody>(body);
    if !parsed {
        fmt.println(f"vue_lsp_bridge: failed to parse semantic classifications: {parsed.error()}");
        return spans;
    }
    if !parsed.spans {
        return spans;
    }
    let values: []int = parsed.spans;
    let tripleCount = values.length / 3;
    for (let t = 0; t < tripleCount; t++) {
        let i = t * 3;
        let encoded = values[i + 2];
        // 256 is one past the modifier mask: anything below it is
        // modifiers only, with no type to colour by.
        if encoded < 256 {
            continue;
        }
        spans.push(SemanticSpan {
            start: values[i],
            length: values[i + 1],
            tokenType: (encoded / 256) - 1,
            tokenModifiers: encoded % 256,
        });
    }
    return spans;
}

struct OpenArgs {
    file: str;
    fileContent: str;
    // Without this, tsserver opens the file as a lone "inferred project"
    // member. `<script setup>` hover needs the *configured* project (real
    // tsconfig.json) resolved: defineProps/defineEmits macro typing, and any
    // hover on an imported binding, both need module resolution and
    // cross-file type info that an inferred, tsconfig-less project can't
    // provide.
    //
    // OPTIONAL, and omitted deliberately for a file that is not inside the
    // open workspace. It is not a hint that tsserver may ignore -- it is
    // where tsserver STARTS looking for the tsconfig.json that will own the
    // file, and it will not look above it. Sending the workspace root for a
    // file somewhere else entirely therefore does not merely fail to help:
    // it actively prevents tsserver from finding that file's OWN tsconfig,
    // and the file lands in the wrong configured project or in a
    // tsconfig-less inferred one. That is the "it loaded the wrong project"
    // failure. With the field absent, tsserver walks up from the file
    // itself, which is exactly what an editor with no folder open should do
    // -- and what VS Code does for a loose file.
    projectRootPath?: str;
}

export inline struct VueLspBridgeArgs {
    // All three paths are relative to the repo root (same convention as
    // every other "codeeditor/..." resource path in this codebase) --
    // resolved to absolute internally, see toAbsolutePath().
    vueLanguageServerPath: str;
    tsdk: str;
    nodeModulesDir: str;
    // The project being *edited* (unrelated to our own repo root) --
    // absolute, since it names an arbitrary location on disk.
    projectRoot: str;
    projectName: str;
}

// The one thing application code needs for Vue/TypeScript language
// support: construct with VueLspBridgeArgs, call openDocument() once a
// file's content is known, call hover() for hover text, call loop() once a
// frame. Everything else in this file (the LSP connection, the tsserver
// process, the two different tsserver request channels, the open/ready
// sequencing) is this struct's own implementation detail.
// ── Retiring the servers without blocking ────────────────────────────────
//
// Replacing a bridge (the user opened a different folder) must not leak the
// two node processes behind it -- together they are hundreds of megabytes.
// But it must not block either: the only join primitive available WAITS for
// the child, and a child that is slow to notice its closed stdin would
// freeze the editor mid-frame, possibly forever.
//
// So a retired process is parked here instead, and reaped later from the
// frame loop: isAlive() is non-blocking and reaps internally, and once it
// has said false, join() returns immediately with the cached exit code
// rather than waiting on anything (see hzstd_process_is_alive/_join, which
// share an `exited` latch). A child that never exits simply stays on this
// list; it is not worth hanging the editor over.
// Held inside a struct rather than as a bare `[]process.Process` global:
// a global cannot be initialized with an expression that needs more than
// one C statement, which an empty dynamic-array literal does. This is the
// same shape g_state uses in codeui.hz, for the same reason.
struct RetiredProcesses {
    items: []process.Process = [];
}

extern C let g_retiredProcesses: RetiredProcesses | none = none;

fn retiredProcesses(): RetiredProcesses {
    let existing = g_retiredProcesses;
    if existing {
        return existing;
    }
    let created = RetiredProcesses {};
    g_retiredProcesses = created;
    return created;
}

fn retireProcess(retired: process.Process) {
    retiredProcesses().items.push(retired);
}

// How many retired processes have not yet been reaped. For tests and
// diagnostics: a workspace switch that leaked its old servers would show up
// here as a number that never comes back down.
export fn retiredProcessCount(): int {
    let registry = g_retiredProcesses;
    if !registry {
        return 0;
    }
    return registry.items.length;
}

// Call once per frame. Cheap: a non-blocking waitpid per still-running
// child, and the list is empty in the normal case where no workspace has
// been switched.
export fn reapRetiredProcesses() {
    let registry = g_retiredProcesses;
    if !registry {
        return;
    }
    if registry.items.length == 0 {
        return;
    }
    let stillRunning: []process.Process = [];
    for retired in registry.items {
        if retired.isAlive() {
            stillRunning.push(retired);
        } else {
            // Already exited and already reaped by isAlive(); this only
            // releases the handle and its pipes.
            retired.join();
        }
    }
    registry.items = stillRunning;
}

export opaque struct VueLspBridge {
    _lsp: language_server_protocol.Context<VueInitializationOptions>;
    _tsserverProcess: process.Process;
    _tsserverInputBuffer: str = "";
    _tsserverNextSeq: int = 0;
    _logAllRequests: bool = false;

    struct PendingTsRequest {
        seq: int;
        vueRequestId: int;
    }
    _tsserverPendingRequests: []PendingTsRequest = [];

    // Requests *we* initiated directly against tsserver (as opposed to
    // PendingTsRequest above, which are relayed on vue-language-server's
    // behalf) -- currently just quickinfo, see sendQuickInfoRequest below.
    struct PendingQuickInfoRequest {
        seq: int;
        callback: (body: QuickInfoBody | none) => none;
    }
    _quickInfoPendingRequests: []PendingQuickInfoRequest = [];

    struct PendingSemanticTokensRequest {
        seq: int;
        callback: (spans: []SemanticSpan) => none;
    }
    _semanticTokensPendingRequests: []PendingSemanticTokensRequest = [];

    struct PendingDefinitionRequest {
        seq: int;
        callback: (targets: []DefinitionTarget) => none;
    }
    _definitionPendingRequests: []PendingDefinitionRequest = [];

    // One file registered with both servers. `sent` distinguishes a
    // document that has actually been announced from one that is still
    // waiting for the LSP handshake to finish -- openDocument() is allowed
    // to be called before the servers are up, and loop() flushes the
    // backlog once they are.
    struct OpenDocument {
        filepath: str;
        languageId: str;
        version: int;
        content: str;
        sent: bool = false;
    }

    // Open-document lifecycle: openDocument() may be called before the LSP
    // handshake finishes (application code shouldn't have to care), so a
    // premature call is stashed here and actually performed by loop() once
    // isReady() goes true. _documentReady is the public-facing signal
    // hover() gates on -- reactive, so hover() called from inside an
    // rx.computed() automatically re-fires the moment it flips, with no
    // extra bookkeeping required from the caller.
    //
    // MANY documents, not one. This bridge is shared by every editor tab
    // (one language server for the whole application -- see State.lspBridge
    // in codeui.hz), so it has to keep them all open at once and answer
    // each request against the file that asked. It also happens to be what
    // the servers themselves want: LSP is document-oriented by design, and
    // tsserver resolves imports across the whole project, so having every
    // open file registered makes each individual answer better.
    //
    // Getting this wrong is not subtle: while this held a single
    // `_filepath`, every tab's hover was answered against whichever file
    // was opened FIRST, so hovering in one tab returned another file's
    // symbols.
    _openDocuments: []OpenDocument = [];
    _projectRootPath: str = "";
    _documentReady: rx.Reactive<bool>;
    // Set by shutdown(). Every public entry point checks it, because the
    // process handles behind this bridge are released once reaped and
    // touching a released handle is a use-after-free that the process
    // wrapper turns into a panic. A caller holding a stale bridge for one
    // more frame is normal (an editor tab captured it), so this has to be
    // survivable rather than merely documented.
    _shutdown: bool = false;

    // Spawns both vue-language-server (over LSP) and tsserver (with
    // `@vue/typescript-plugin` loaded globally, so it understands `.vue`
    // files for any project it ends up servicing).
    fn constructor(args: VueLspBridgeArgs): Result<VueLspBridge, language_server_protocol.Error> {
        let tsdk = toAbsolutePath(args.tsdk);
        let nodeModulesDir = toAbsolutePath(args.nodeModulesDir);

        let lsp = language_server_protocol.Context<VueInitializationOptions>({
            exe: "node",
            // --tsdk=, not initializationOptions.typescript.tsdk, is what
            // vue-language-server's own entrypoint actually reads to pick
            // the `ts` instance it uses in-process to compile each .vue
            // SFC into its virtual embedded-TS document (see its index.js:
            // it scans process.argv for "--tsdk=", falling back to a bare
            // `require("typescript")` if absent). initializationOptions.
            // typescript.tsdk below isn't read by this code path at all,
            // but is sent anyway in case some other server version does.
            args: [toAbsolutePath(args.vueLanguageServerPath), "--stdio", f"--tsdk={tsdk}"],
        }, {
            rootUri: f"file://{args.projectRoot}",
            workspaceFolders: [{ uri: f"file://{args.projectRoot}", name: args.projectName }],
            initializationOptions: VueInitializationOptions {
                plugins: [
                    {
                        name: "@vue/typescript-plugin",
                        location: f"{nodeModulesDir}/@vue/typescript-plugin",
                        languages: ["vue"],
                    }
                ],
                typescript: { tsdk: tsdk },
            },
        });
        if !lsp {
            return language_server_protocol.Error { message: f"vue-language-server failed to launch: {lsp.message}" };
        }

        let tsserverProcess = process.spawn("node", [
            f"{tsdk}/tsserver.js",
            "--globalPlugins", "@vue/typescript-plugin",
            "--pluginProbeLocations", nodeModulesDir,
        ]);
        if !tsserverProcess {
            return language_server_protocol.Error { message: f"tsserver failed to launch: Exit code {tsserverProcess}" };
        }

        let bridge = VueLspBridge {
            _lsp: lsp,
            _tsserverProcess: tsserverProcess,
            _projectRootPath: args.projectRoot,
            _documentReady: rx.reactive<bool>(false),
        };

        lsp.onNotification = (method: str, params: json.Node) => {
            bridge._handleNotification(method, params);
        };

        return bridge;
    }

    export inline struct MemoryUtilization {
        vue?: int;
        ts?: int;
    }

    fn getSystemMemoryUtilization(): MemoryUtilization {
        if this._shutdown {
            return MemoryUtilization {};
        }
        return {
            vue: this._lsp.getSystemMemoryUtilization(),
            ts: this._tsserverProcess.memoryInfo().committed,
        };
    }

    // Whether the LSP handshake with vue-language-server has completed.
    fn isReady(): bool {
        if this._shutdown {
            return false;
        }
        return this._lsp.initResponse is not none;
    }

    // The folder both servers were initialized against. "" when the editor
    // has no folder open, in which case every document is opened without a
    // projectRootPath -- see OpenArgs.
    fn projectRoot(): str {
        return this._projectRootPath;
    }

    // Whether `filepath` is inside the open workspace, and therefore
    // whether the workspace's tsconfig is the right one to resolve it
    // against. See pathIsInsideFolder in workspace.hz for why this is not
    // a plain prefix test.
    fn ownsFile(filepath: str): bool {
        return pathIsInsideFolder(filepath, this._projectRootPath);
    }

    // Tell both servers to exit and hand their processes to the reaper.
    // Non-blocking; see reapRetiredProcesses above for why it has to be.
    //
    // The bridge is dead afterwards and must be replaced, not reused: the
    // servers' entire notion of "the project" is fixed at initialize time
    // (LSP has a didChangeWorkspaceFolders notification, but this client
    // never advertised the capability, and tsserver binds a file to a
    // project when the file is opened, not on request), so a new root
    // means new processes.
    fn shutdown() {
        if this._shutdown {
            return;
        }
        // tsserver has its own `exit` command, and it is the only reliable
        // way to end it: it reads stdin as a line stream and idles at EOF
        // rather than quitting, so closing stdin on its own leaves a
        // multi-hundred-megabyte process sitting there forever. Sent before
        // the flag below, because _sendTsServerCommand refuses once the
        // bridge is marked down.
        let exitArgs = json.encodeToJsonNode<TsServerExitArgs>({});
        if exitArgs {
            this._tsserverNextSeq = this._tsserverNextSeq + 1;
            this._sendTsServerCommand(this._tsserverNextSeq, "exit", exitArgs);
        }

        this._shutdown = true;
        if this._lsp.isRunning() {
            // Sends the protocol's own shutdown/exit before closing stdin
            // -- see Context.detach().
            retireProcess(this._lsp.detach());
        }
        // Backstop for tsserver, matching what detach() does for the LSP.
        this._tsserverProcess.closeStdin();
        retireProcess(this._tsserverProcess);
        this._documentReady := false;
    }

    // Whether hover() will actually produce an answer, i.e. the handshake
    // finished AND the document has been opened with both servers. Callers
    // that show hover UI need this to tell "there is genuinely nothing at
    // this position" apart from "the language server isn't up yet" -- the
    // two look identical from hover()'s callback, which simply never fires
    // in the second case. Reactive, so a computed reading this re-runs the
    // moment the servers come up.
    fn hoverAvailable(): bool {
        if this._shutdown {
            return false;
        }
        return rx.get(this._documentReady);
    }

    // Queues `filepath` to be opened with both vue-language-server and our
    // tsserver process. Safe to call every frame with the same arguments
    // (e.g. from a reactive computed with no readiness guard of its own)
    // -- actually opens exactly once, deferring automatically until
    // isReady() if called before the LSP handshake finishes.
    fn openDocument(filepath: str, languageId: str, version: int, fileContent: str) {
        if this._shutdown {
            return;
        }
        // Idempotent PER FILE. Every editor calls this from a per-frame
        // reactive path, so it is hit constantly with the same arguments;
        // re-announcing an already-open document would reset the servers'
        // view of it (and re-send the whole file) on every frame.
        for doc in this._openDocuments {
            if doc.filepath == filepath {
                return;
            }
        }
        this._openDocuments.push(OpenDocument {
            filepath: filepath,
            languageId: languageId,
            version: version,
            content: fileContent,
        });
        if !this.isReady() {
            // Announced by loop() once the handshake completes. Opening a
            // file before the servers are up is normal -- the tabs are
            // restored at startup, well before either process is ready.
            return;
        }
        this._flushPendingOpens();
    }

    // Announce every document that has not been sent yet. Called both when
    // a file is opened while the servers are already up, and by loop() the
    // moment they come up, which is what drains a startup backlog of tabs.
    fn _flushPendingOpens() {
        for doc in this._openDocuments {
            if !doc.sent {
                doc.sent = true;
                this._doOpenDocument(doc.filepath, doc.languageId, doc.version, doc.content);
                // The content was only held to be able to send it; a second
                // copy of every open file is not worth keeping around.
                doc.content = "";
            }
        }
    }

    fn _doOpenDocument(filepath: str, languageId: str, version: int, fileContent: str) {
        this._lsp.sendDocumentOpenNotification(filepath, languageId, version, fileContent);

        // Only claim the file for the workspace's project when it really is
        // in the workspace -- see OpenArgs.projectRootPath for why sending
        // it otherwise is worse than sending nothing.
        let openArgs = OpenArgs { file: filepath, fileContent: fileContent };
        if this.ownsFile(filepath) {
            openArgs.projectRootPath = this._projectRootPath;
        }
        let argsNode = json.encodeToJsonNode<OpenArgs>(openArgs);
        if !argsNode {
            sys.panic("vue_lsp_bridge: failed to encode tsserver 'open' arguments");
        }
        this._tsserverNextSeq = this._tsserverNextSeq + 1;
        this._sendTsServerCommand(this._tsserverNextSeq, "open", argsNode);

        this._documentReady := true;
    }

    fn _findOpenDocument(filepath: str): OpenDocument | none {
        for doc in this._openDocuments {
            if doc.filepath == filepath {
                return doc;
            }
        }
        return none;
    }

    // Forward one edit to BOTH servers, keeping their copies of `filepath`
    // in step with the editor's.
    //
    // Without this everything position-based -- hover, and every semantic
    // token below -- is answered against the file as it was on disk when
    // the tab opened, and is therefore wrong from the first keystroke.
    //
    // `version` names the document AFTER the edit and must increase; pass
    // text_document.Document.version, which is bumped before the change
    // listeners run and is what the highlight engine is already stamped
    // with.
    //
    // A change for a document that has not actually been announced yet is
    // DROPPED rather than queued. An incremental edit is meaningless
    // without the base it applies to, and the caller is expected to defer
    // the open until it can send the document's current text (see
    // codeui.hz, which waits for isReady() for exactly this reason) -- so
    // by the time the open happens, this edit is already in it.
    fn changeDocument(filepath: str, change: DocumentChange, version: int) {
        if this._shutdown {
            return;
        }
        let doc = this._findOpenDocument(filepath);
        if !doc {
            return;
        }
        if !doc.sent {
            return;
        }
        doc.version = version;

        this._lsp.sendDocumentChangeNotification(filepath, version, {
            start: { line: change.startLine, character: 0 },
            end: { line: change.endLine, character: change.endColumn },
        }, change.newText);

        let argsNode = json.encodeToJsonNode<UpdateOpenArgs>({
            changedFiles: [
                {
                    fileName: filepath,
                    textChanges: [
                        {
                            start: { line: change.startLine + 1, offset: 1 },
                            end: { line: change.endLine + 1, offset: change.endColumn + 1 },
                            newText: change.newText,
                        },
                    ],
                },
            ],
        });
        if !argsNode {
            sys.panic("vue_lsp_bridge: failed to encode tsserver 'updateOpen' arguments");
        }
        this._tsserverNextSeq = this._tsserverNextSeq + 1;
        this._sendTsServerCommand(this._tsserverNextSeq, "updateOpen", argsNode);
    }

    // Ask what every symbol in a byte range of `filepath` actually IS --
    // class, parameter, readonly property, default-library function -- as
    // opposed to what it merely looks like to a regular-expression grammar.
    //
    // This goes straight to tsserver (channel 3 in the module comment at
    // the top of this file), not through vue-language-server, and that is
    // what makes ONE implementation cover both languages: `.ts` files are
    // tsserver's native subject, and for a `.vue` file
    // `@vue/typescript-plugin` maps the spans of the virtual TypeScript it
    // compiles the SFC into back onto positions in the `.vue` source
    // before we ever see them. vue-language-server cannot answer this for
    // a plain `.ts` file at all, since it only knows how to look inside
    // documents that have embedded code.
    //
    // POSITIONS ARE TREATED AS BYTES. tsserver counts UTF-16 code units,
    // and the editor counts bytes; they agree exactly on ASCII, which is
    // all of any real source file except string literals and comments. On
    // a line containing non-ASCII text, spans after it on that line are
    // reported shifted -- the colour lands slightly off, and nothing else,
    // because the render path snaps every offset to a character boundary
    // before slicing (see splitLineTokens in codeui.hz).
    //
    // Answers nothing at all until the document has been opened: a
    // classification computed for a file tsserver has never been told
    // about describes an empty file.
    fn semanticTokens(filepath: str, start: int, length: int, callback: (spans: []SemanticSpan) => none) {
        if !rx.get(this._documentReady) {
            return;
        }
        let doc = this._findOpenDocument(filepath);
        if !doc {
            return;
        }
        if !doc.sent {
            return;
        }

        let argsNode = json.encodeToJsonNode<SemanticClassificationsArgs>({
            file: filepath,
            start: start,
            length: length,
            format: "2020",
        });
        if !argsNode {
            sys.panic("vue_lsp_bridge: failed to encode tsserver 'encodedSemanticClassifications-full' arguments");
        }
        this._tsserverNextSeq = this._tsserverNextSeq + 1;
        let seq = this._tsserverNextSeq;
        this._semanticTokensPendingRequests.push({ seq: seq, callback: callback });
        this._sendTsServerCommand(seq, "encodedSemanticClassifications-full", argsNode);
    }

    // The one thing hover UI needs: position in, best-available hover text
    // (or null if there's genuinely nothing) out. Merges two independent,
    // complementary sources (see the module doc comment at the top of this
    // file for why both are needed): vue-language-server's own LSP hover
    // (template/HTML/SFC-structure) and a direct tsserver quickinfo query
    // (real TypeScript semantics -- required for anything inside
    // <script setup>). Never calls back until the document has actually
    // been opened -- reactive, so calling this from inside an
    // rx.computed() naturally re-fires once that happens even without the
    // position changing again.
    // `byteColumn` is a BYTE OFFSET into `lineText`, matching how the editor
    // stores every column. The two channels below count positions
    // differently and neither counts bytes by default, so the conversion
    // happens here rather than being pushed onto callers:
    //
    //   - tsserver's `offset` is a UTF-16 code unit index (its host is
    //     TypeScript, whose strings are UTF-16), and is 1-based.
    //   - LSP's `character` is UTF-16 by default, or bytes if the server
    //     accepted our `utf-8` request during initialize.
    //
    // `lineText` must be the text of line `line`; without it neither
    // conversion is possible, since both depend on what precedes the offset.
    // `filepath` names the document being asked about, and is required:
    // several files are open at once (one per editor tab) and a position
    // means nothing without saying which file it is in. Passing the wrong
    // one, or defaulting it, silently returns another file's symbols for
    // the position -- which is exactly what happened while this bridge
    // tracked a single document.
    fn hover(filepath: str, line: int, byteColumn: int, lineText: str, callback: (text: str | null) => none) {
        if !rx.get(this._documentReady) {
            return;
        }
        // Asking about a file the servers have not been told about yields a
        // confident answer computed from nothing. Better to say nothing.
        let known = false;
        for doc in this._openDocuments {
            if doc.filepath == filepath && doc.sent {
                known = true;
                break;
            }
        }
        if !known {
            return;
        }

        // tsserver always counts UTF-16 code units.
        let tsserverOffset = unicode.utf16UnitsBefore(lineText, byteColumn);
        // The LSP side may have negotiated byte offsets instead.
        let lspCharacter = this._lsp.characterFromByteOffset(lineText, byteColumn);

        let quickInfoText: str | null = null;
        let lspHoverText: str | null = null;
        let quickInfoDone = false;
        let lspHoverDone = false;

        let tryEmit = (): void => {
            if !quickInfoDone || !lspHoverDone {
                return;
            }
            callback(quickInfoText ? quickInfoText : lspHoverText);
        };

        this._sendQuickInfoRequest(filepath, line, tsserverOffset, (body: QuickInfoBody | none) => {
            if body && body.displayString {
                quickInfoText = body.displayString;
            }
            quickInfoDone = true;
            tryEmit();
        });

        this._lsp.sendDocumentHoverRequest(filepath, line, lspCharacter, (response: Result<language_server_protocol.LSPDocumentHoverResponse | null, language_server_protocol.LSPError>) => {
            if response {
                let hover = response;
                if hover {
                    lspHoverText = hover.contents.value;
                }
            }
            lspHoverDone = true;
            tryEmit();
        });
    }

    // Where the symbol under `byteColumn` on `line` is defined.
    //
    // Answered by tsserver alone, not by vue-language-server. In hybrid
    // mode the language server has no semantic TypeScript service at all
    // (see the module doc comment), so it cannot resolve a definition for
    // anything in <script setup> -- which is nearly everything anyone wants
    // to jump to. The tsserver reply also names plain filesystem paths
    // rather than URIs, so nothing has to be decoded.
    //
    // The callback receives an empty list when there is no definition, and
    // is not called at all if the servers are not ready or the file was
    // never opened -- the same contract hover() has.
    fn definition(filepath: str, line: int, byteColumn: int, lineText: str, callback: (targets: []DefinitionTarget) => none) {
        if this._shutdown || !rx.get(this._documentReady) {
            return;
        }
        let known = false;
        for doc in this._openDocuments {
            if doc.filepath == filepath && doc.sent {
                known = true;
                break;
            }
        }
        if !known {
            return;
        }
        // tsserver always counts UTF-16 code units, never bytes.
        let tsserverOffset = unicode.utf16UnitsBefore(lineText, byteColumn);
        let argsNode = json.encodeToJsonNode<DefinitionArgs>({
            file: filepath, line: line + 1, offset: tsserverOffset + 1,
        });
        if !argsNode {
            sys.panic("vue_lsp_bridge: failed to encode tsserver 'definition' arguments");
        }
        this._tsserverNextSeq = this._tsserverNextSeq + 1;
        let seq = this._tsserverNextSeq;
        this._definitionPendingRequests.push({ seq: seq, callback: callback });
        this._sendTsServerCommand(seq, "definition", argsNode);
    }

    // Asks tsserver directly for hover info at a position, bypassing
    // vue-language-server entirely -- see the module doc comment (channel
    // 3) for why this works. Not the same thing as the "tsserver/request"
    // relay below (channel 2), which is for vue-language-server's own
    // Vue-specific queries.
    // `utf16Offset` is a 0-based UTF-16 code unit index into the line; the
    // +1 below converts it to tsserver's 1-based `offset`. It is NOT a byte
    // offset -- see hover() for where the conversion happens.
    fn _sendQuickInfoRequest(filepath: str, line: int, utf16Offset: int, callback: (body: QuickInfoBody | none) => none) {
        let argsNode = json.encodeToJsonNode<QuickInfoArgs>({ file: filepath, line: line + 1, offset: utf16Offset + 1 });
        if !argsNode {
            sys.panic("vue_lsp_bridge: failed to encode tsserver 'quickinfo' arguments");
        }
        this._tsserverNextSeq = this._tsserverNextSeq + 1;
        let seq = this._tsserverNextSeq;
        this._quickInfoPendingRequests.push({ seq: seq, callback: callback });
        this._sendTsServerCommand(seq, "quickinfo", argsNode);
    }

    // Registered as `lsp.onNotification` in the constructor, for any
    // "tsserver/request" vue-language-server sends us (channel 2). `params`
    // arrives as `[[requestId, command, args]]` -- vscode-jsonrpc wraps a
    // single positional array argument in another array.
    fn _handleNotification(method: str, params: json.Node) {
        if method != "tsserver/request" {
            fmt.println(f"vue_lsp_bridge: unsupported notification '{method}'");
            return;
        }

        let outer = json.parse<[]json.Node>(params);
        if !outer {
            fmt.println(f"vue_lsp_bridge: malformed tsserver/request notification: {outer.error()}");
            return;
        }
        let inner = json.parse<[]json.Node>(outer[0]);
        if !inner {
            fmt.println(f"vue_lsp_bridge: malformed tsserver/request payload: {inner.error()}");
            return;
        }
        let requestId = json.parse<int>(inner[0]);
        if !requestId {
            fmt.println(f"vue_lsp_bridge: malformed tsserver/request id: {requestId.error()}");
            return;
        }
        let command = json.parse<str>(inner[1]);
        if !command {
            fmt.println(f"vue_lsp_bridge: malformed tsserver/request command: {command.error()}");
            return;
        }
        let args = inner[2];

        this._tsserverNextSeq = this._tsserverNextSeq + 1;
        let seq = this._tsserverNextSeq;
        this._tsserverPendingRequests.push({ seq: seq, vueRequestId: requestId });
        this._sendTsServerCommand(seq, command, args);
    }

    // Drains the LSP connection and tsserver's output, and performs any
    // openDocument() call that had to be deferred until isReady(). The one
    // thing callers need to call once per frame.
    fn loop() {
        if this._shutdown {
            return;
        }
        this._lsp.loop();

        // Announce anything opened before the servers were up. Several
        // files can be waiting here at once: the tabs are restored at
        // startup, long before the handshake finishes.
        if this.isReady() {
            this._flushPendingOpens();
        }

        let stderr = this._tsserverProcess.readStderr();
        if stderr.length > 0 {
            fmt.println("tsserver stderr: ", stderr);
        }

        let stdout = this._tsserverProcess.readStdout();
        if stdout.length == 0 {
            return;
        }
        this._tsserverInputBuffer = this._tsserverInputBuffer + stdout;

        while true {
            let framed = language_server_protocol.extractFramedMessage(this._tsserverInputBuffer);
            if !framed {
                return;
            }
            this._tsserverInputBuffer = framed.remaining;
            this._handleTsServerMessage(framed.message);
        }
    }

    fn _sendTsServerCommand(seq: int, command: str, arguments: json.Node) {
        let message = json.stringify(TsServerRequestMessage {
            seq: seq,
            type: "request",
            command: command,
            arguments: arguments,
        });
        if this._logAllRequests {
            fmt.println(f"ts-> {message}");
        }
        this._tsserverProcess.writeStdin(message + "\n");
    }

    fn _handleTsServerMessage(message: str) {
        if this._logAllRequests {
            fmt.println(f"ts<- {message}");
        }

        let result = json.parse<TsServerResponseMessage>(message);
        if !result {
            fmt.println(f"vue_lsp_bridge: failed to parse tsserver message: {result.error()}");
            return;
        }
        if result.type != "response" {
            // Events (e.g. "requestCompleted", telemetry) aren't relevant to the bridge.
            return;
        }
        // A failed command (e.g. quickinfo on a position tsserver's project
        // service can't actually resolve) still relays through as a
        // "response" with an empty body -- which callers below would
        // otherwise see as a bare null, indistinguishable from "there's
        // genuinely nothing to show here". Surfacing the failure explicitly
        // keeps that distinction visible in the logs.
        if result.success is not none && !result.success {
            fmt.println(f"vue_lsp_bridge: tsserver command '{result.command}' failed (seq {result.request_seq}): {result.message}");
        }
        let requestSeq = result.request_seq;
        if !requestSeq {
            return;
        }

        // quickinfo requests we sent directly (_sendQuickInfoRequest) --
        // distinct from the vue-language-server relay below, matched first
        // since seq is a single shared counter so a given requestSeq can
        // only ever belong to one or the other.
        let matchedQuickInfoCallback: ((body: QuickInfoBody | none) => none) | none = none;
        let remainingQuickInfo: []PendingQuickInfoRequest = [];
        for entry in this._quickInfoPendingRequests {
            if entry.seq == requestSeq {
                matchedQuickInfoCallback = entry.callback;
            }
            else {
                remainingQuickInfo.push(entry);
            }
        }
        this._quickInfoPendingRequests = remainingQuickInfo;
        if matchedQuickInfoCallback is not none {
            if result.body is not none {
                let body = json.parse<QuickInfoBody>(result.body);
                if body {
                    matchedQuickInfoCallback(body);
                }
                else {
                    matchedQuickInfoCallback(none);
                }
            }
            else {
                matchedQuickInfoCallback(none);
            }
            return;
        }

        // Definitions, matched the same way as quickinfo above.
        let matchedDefinitionCallback: ((targets: []DefinitionTarget) => none) | none = none;
        let remainingDefinition: []PendingDefinitionRequest = [];
        for entry in this._definitionPendingRequests {
            if entry.seq == requestSeq {
                matchedDefinitionCallback = entry.callback;
            }
            else {
                remainingDefinition.push(entry);
            }
        }
        this._definitionPendingRequests = remainingDefinition;
        if matchedDefinitionCallback is not none {
            let targets: []DefinitionTarget = [];
            if result.body {
                let spans = json.parse<[]DefinitionSpan>(result.body);
                if spans {
                    for span in spans {
                        if span.file.length > 0 {
                            targets.push(DefinitionTarget {
                                filepath: span.file,
                                line: span.start.line - 1,
                                utf16Offset: span.start.offset - 1,
                            });
                        }
                    }
                }
            }
            // An empty list is a real answer ("nothing is defined here"),
            // and so is a failed command -- both mean do not navigate.
            matchedDefinitionCallback(targets);
            return;
        }

        // Semantic classifications we asked for directly, matched the same
        // way and for the same reason as quickinfo above: one shared seq
        // counter means a given requestSeq belongs to exactly one list.
        let matchedSemanticCallback: ((spans: []SemanticSpan) => none) | none = none;
        let remainingSemantic: []PendingSemanticTokensRequest = [];
        for entry in this._semanticTokensPendingRequests {
            if entry.seq == requestSeq {
                matchedSemanticCallback = entry.callback;
            }
            else {
                remainingSemantic.push(entry);
            }
        }
        this._semanticTokensPendingRequests = remainingSemantic;
        if matchedSemanticCallback is not none {
            // A failed command (already logged above) has no body, which
            // decodes to no spans -- the right answer, since "we could not
            // classify this" and "nothing here is classified" both mean
            // the TextMate layer stands on its own.
            matchedSemanticCallback(decodeSemanticSpans(result.body));
            return;
        }

        let matchedVueRequestId: int | none = none;
        let remaining: []PendingTsRequest = [];
        for entry in this._tsserverPendingRequests {
            if entry.seq == requestSeq {
                matchedVueRequestId = entry.vueRequestId;
            }
            else {
                remaining.push(entry);
            }
        }
        this._tsserverPendingRequests = remaining;

        if !matchedVueRequestId {
            return;
        }

        this._emitTsServerResponse(matchedVueRequestId, result.body);
    }

    // Sends "tsserver/response" with params `[[vueRequestId, body]]`, mirroring the exact
    // wrapping vscode-jsonrpc applies on the sending side (confirmed empirically: a single
    // positional array argument gets wrapped in another array on the wire).
    fn _emitTsServerResponse(vueRequestId: int, body: json.Node | none) {
        let idNode = json.encodeToJsonNode<int>(vueRequestId);
        if !idNode {
            sys.panic("vue_lsp_bridge: failed to encode tsserver/response id");
        }

        let resolvedBody = body;
        if !resolvedBody {
            resolvedBody = json.encodeToJsonNode<null>(null);
        }
        if !resolvedBody {
            sys.panic("vue_lsp_bridge: failed to encode null tsserver/response body");
        }

        let pair: []json.Node = [idNode, resolvedBody];
        let pairNode = json.encodeToJsonNode<[]json.Node>(pair);
        if !pairNode {
            sys.panic("vue_lsp_bridge: failed to encode tsserver/response pair");
        }

        let outer: []json.Node = [pairNode];
        this._lsp.sendNotification<[]json.Node>("tsserver/response", outer);
    }
}
