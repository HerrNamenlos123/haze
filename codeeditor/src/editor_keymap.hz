import filedialog

// ═══ This editor's keymap ════════════════════════════════════════════════
//
// keybindings.hz is the generic machinery; everything editor-specific lives
// here. Two halves:
//
//   installDefaultKeymap()  the rule table -- which keys run which command
//                           ids, and under which conditions. Deliberately
//                           written as data, in exactly the shape a
//                           keybindings.json row has, so it can be replaced
//                           by (or layered under) a file on disk later
//                           without any of the surrounding code changing.
//
//   the context keys        named below as constants, because a `when`
//                           clause referring to a key nobody ever sets is
//                           silently false and there is no compiler to
//                           catch the typo.
//
// The commands themselves are registered where their closures live -- see
// registerWorkbenchCommands() in the UI shell and registerEditorCommands()
// in EditorView -- because a command is a piece of behavior belonging to a
// component, not a piece of configuration.

// ── Context keys ─────────────────────────────────────────────────────────

// A text editor has keyboard focus. The single most important one: it is
// what separates "this key is for the document" from "this key is for the
// application", and it is why ctrl+o can mean two different things.
fn ctxEditorTextFocus(): str { return "editorTextFocus"; }

// The focused editor has the vim behavior installed.
fn ctxVimActive(): str { return "vimActive"; }

// Which vim mode that editor is in: "normal", "insert", "visual",
// "visualline", or "" when vim is off. A string rather than a set of bools
// so a rule can say `vimMode == 'normal'` and read the way vim docs do.
fn ctxVimMode(): str { return "vimMode"; }

// The focused editor has a non-empty selection.
fn ctxEditorHasSelection(): str { return "editorHasSelection"; }

// At least one file is open. Guards the tab commands, which are
// meaningless with nothing open.
fn ctxHasOpenTabs(): str { return "hasOpenTabs"; }

// ── The rule table ───────────────────────────────────────────────────────

fn installDefaultKeymap(keys: mut Keybindings): void {
    keys.keymap.bindAll([
        // Files.
        //
        // The `when` is what keeps ctrl+o out of vim's way. Vim's own <C-o>
        // is jump-back, and it takes a COUNT (`3<C-o>`) -- a count the user
        // types as ordinary characters that go straight to the editing
        // engine. If this binding swallowed the ctrl+o, the engine would
        // never see the key, the count would be stranded, and `3<C-o>` would
        // jump once. So inside a vim editor outside insert mode this rule
        // deliberately does not match at all, and the key falls through to
        // the engine untouched -- which is also where it is tested against
        // real neovim (scripts/vim-jumplist-cases.ts).
        { key: "ctrl+o", command: "workbench.action.files.openFile",
          when: "!(editorTextFocus && vimActive && vimMode != 'insert')" },
        // A CHORD: ctrl+k is a prefix, so pressing it alone parks the
        // dispatcher until the second stroke arrives. VS Code puts most of
        // its two-stroke bindings behind this same ctrl+k prefix.
        { key: "ctrl+k ctrl+o", command: "workbench.action.files.openFolder" },
        { key: "ctrl+r", command: "workbench.action.openRecent" },

        // Tabs.
        { key: "ctrl+w", command: "workbench.action.closeActiveEditor", when: "hasOpenTabs" },
        // ctrl+tab and ctrl+shift+tab are separate rules rather than one
        // rule that inspects shift itself: modifiers are matched exactly,
        // which is what keeps a rule for ctrl+tab from also swallowing
        // every shifted variant of it.
        { key: "ctrl+tab", command: "workbench.action.nextEditor", when: "hasOpenTabs" },
        { key: "ctrl+shift+tab", command: "workbench.action.previousEditor", when: "hasOpenTabs" },

        // Editing model.
        { key: "f2", command: "editor.action.toggleVim", when: "editorTextFocus" },

        // Go to definition, on VS Code's key. `gd` reaches the same command
        // from inside vim -- see Vim.onGoToDefinition.
        { key: "f12", command: "editor.action.revealDefinition", when: "editorTextFocus" },

        // NOTE on the jump list: <C-o> and <C-i> are deliberately NOT bound
        // here. They belong to the editing engine, which implements the
        // real jump list with counts and vim's own append/de-duplicate
        // semantics (see stdlib/vim_behavior). The commands
        // vim.navigateBack / vim.navigateForward exist and are registered
        // so a menu or command palette can reach them, but no key routes
        // through them -- a key that did would arrive without its count.
    ]);
}

// ── The one instance ─────────────────────────────────────────────────────
//
// A global for the same reason State is one: keybindings are a property of
// the application, not of any component, and both ends of the wiring (the
// shell's dispatch point and each editor's context-key updates) need to
// reach the same object without threading it through every render function
// in between.
extern C let g_keybindings: mut Keybindings | none = none;

fn keybindings(): mut Keybindings {
    let existing = g_keybindings;
    if existing {
        return existing;
    }
    let created = Keybindings();
    installDefaultKeymap(created);
    created.reportProblems();
    g_keybindings = created;
    return created;
}

// ── Commands owned by the application shell ──────────────────────────────
//
// Registered from inside UI(), where the closures that do the work exist.
// Re-registering an id replaces the previous handler, so this is safe to
// call again on a remount.
ref struct WorkbenchCommands {
    openFile: CommandFn;
    openFolder: CommandFn;
    closeFolder: CommandFn;
    openRecent: CommandFn;
    closeActiveEditor: CommandFn;
    nextEditor: CommandFn;
    previousEditor: CommandFn;
}

fn registerWorkbenchCommands(keys: mut Keybindings, handlers: WorkbenchCommands): void {
    keys.commands.register("workbench.action.files.openFile", handlers.openFile);
    keys.commands.register("workbench.action.files.openFolder", handlers.openFolder);
    keys.commands.register("workbench.action.closeFolder", handlers.closeFolder);
    keys.commands.register("workbench.action.openRecent", handlers.openRecent);
    keys.commands.register("workbench.action.closeActiveEditor", handlers.closeActiveEditor);
    keys.commands.register("workbench.action.nextEditor", handlers.nextEditor);
    keys.commands.register("workbench.action.previousEditor", handlers.previousEditor);
}

// ── Commands owned by whichever editor is active ─────────────────────────
//
// An editor command is per-tab (it acts on THAT document), but the command
// registry is flat and global -- so the editor that is currently active
// re-registers these on becoming active, and thereby claims them. That is
// the correct owner by definition: keyboard focus follows the active tab,
// and every one of these bindings is gated on editorTextFocus anyway.
ref struct EditorCommands {
    toggleVim: CommandFn;
    vimNavigateBack: CommandFn;
    vimNavigateForward: CommandFn;
    goToDefinition: CommandFn;
}

fn registerEditorCommands(keys: mut Keybindings, handlers: EditorCommands): void {
    keys.commands.register("editor.action.toggleVim", handlers.toggleVim);
    keys.commands.register("vim.navigateBack", handlers.vimNavigateBack);
    keys.commands.register("vim.navigateForward", handlers.vimNavigateForward);
    keys.commands.register("editor.action.revealDefinition", handlers.goToDefinition);
}
