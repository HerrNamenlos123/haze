
struct HighlightCommand {
    fileContent: str;
}

struct HighlightResult {
    tokens: []Token;
    // The line range `tokens` covers. An incremental ("change") reply
    // only carries the lines whose highlighting actually changed, so a
    // consumer must REPLACE that range in its cache and keep the rest --
    // see codeui.hz's mergeTokens.
    firstLine: int = 0;
    lastLine: int = 0;
    // Total line count the engine now believes the document has, so a
    // consumer can drop cached tokens for lines that no longer exist.
    lineCount: int = 0;
    // False for a full-document parse (the whole cache is replaced).
    incremental: bool = false;
}

struct Token {
  lineIndex: int;
  startIndex: int;
  endIndex: int;
  scopes: []str;
};

struct HighlightRequest {
    id: int;
    method: str;
    fileContent?: str;
    // Incremental ("open"/"change") fields -- see the engine's protocol
    // in codeeditor/syntax-engine/syntax-engine.ts.
    uri?: str;
    startLine?: int;
    removedCount?: int;
    newLines?: []str;
}

struct ResultObject {
    tokens?: []Token;
    initialized?: bool;
    // The line range these tokens cover. A "change" reply only carries
    // tokens for the lines whose highlighting actually changed, so the
    // client must MERGE them into its cache rather than replacing it.
    firstLine?: int;
    lastLine?: int;
    lineCount?: int;
}

struct ErrorObject {
    code: int;
    message: str;
}

struct HighlightResponse {
    jsonrpc: str;
    id: int;
    result?: ResultObject;
    error?: ErrorObject;
}

struct HighlightEngine {
    highlightProcess: process.Process;
    inputBuffer: mut String;
    nextMessageId: int = 1;
    // Once true, `highlightProcess`'s OS handle has been released (via join())
    // and must never be touched again.
    dead: bool = false;

    fn constructor(cmdline: str, cwd: str) {
        let p = process.spawn("/bin/bash", ["-c", cmdline], { cwd: cwd });
        if (!p) {
            return none;
        }

        let request = json.stringify(HighlightRequest {
            id: 0,
            method: "initialize",
        });
        p.writeStdin("Content-Length: ");
        p.writeStdin(f"{request.length}");
        p.writeStdin("\r\n\r\n");
        p.writeStdin(request);

        let inputBuffer = String();
        inputBuffer.reserve(8192);

        return HighlightEngine {
            highlightProcess: p,
            inputBuffer: inputBuffer,
        };
    }

    fn stop() {
        if this.dead {
            return;
        }
        this.dead = true;
        this.highlightProcess.join();
    }

    fn aliveCheck() {
        if this.dead {
            return;
        }
        if !this.highlightProcess.isAlive() {
            // Read stderr before join(), since join() releases the process
            // handle and it must not be touched afterwards.
            let stderrOutput = this.highlightProcess.readStderr();
            let result = this.highlightProcess.join();
            this.dead = true;
            fmt.println(f"Syntax Highlighter exited with code {result}");
            if stderrOutput.length > 0 {
                fmt.println(f"Syntax Highlight stderr: {stderrOutput}");
            }
        }
    }

    // Full parse, remembered under `uri` so later edits can be
    // incremental against it. Send this once when a file is opened.
    fn sendOpenDocument(uri: str, fileContent: str) {
        if this.dead {
            return;
        }
        let request = json.stringify(HighlightRequest {
            id: 1,
            method: "open",
            uri: uri,
            fileContent: fileContent,
        });
        this.highlightProcess.writeStdin("Content-Length: ");
        this.highlightProcess.writeStdin(f"{request.length}");
        this.highlightProcess.writeStdin("\r\n\r\n");
        this.highlightProcess.writeStdin(request);
    }

    // Incremental edit: `removedCount` lines at `startLine` were replaced
    // by `newLines`. The engine retokenizes from there and stops as soon
    // as the rule stack reconverges, so the reply usually covers only a
    // couple of lines -- 0.4ms instead of 24ms on a 5000-line file.
    //
    // This mirrors text_document.ChangeSet exactly, which is what makes
    // the document model's change notifications directly forwardable.
    fn sendDocumentChange(uri: str, startLine: int, removedCount: int, newLines: []str) {
        if this.dead {
            return;
        }
        let request = json.stringify(HighlightRequest {
            id: 1,
            method: "change",
            uri: uri,
            startLine: startLine,
            removedCount: removedCount,
            newLines: newLines,
        });
        this.highlightProcess.writeStdin("Content-Length: ");
        this.highlightProcess.writeStdin(f"{request.length}");
        this.highlightProcess.writeStdin("\r\n\r\n");
        this.highlightProcess.writeStdin(request);
    }

    fn sendHighlightRequest(fileContent: str) {
        if this.dead {
            fmt.println("Cannot send highlight request: LSP process has exited");
            return;
        }
        let request = json.stringify(HighlightRequest {
            id: 1,
            method: "highlight",
            fileContent: fileContent,
        });
        // fmt.println(request);
        this.highlightProcess.writeStdin("Content-Length: ");
        this.highlightProcess.writeStdin(f"{request.length}");
        this.highlightProcess.writeStdin("\r\n\r\n");
        this.highlightProcess.writeStdin(request);
    }

    fn loop(): HighlightResult | none {
        this.aliveCheck();
        if this.dead {
            return none;
        }

        let newStdout = this.highlightProcess.readStdout();
        this.inputBuffer.append(newStdout);

        let contentLengthText = "Content-Length: ";
        if this.inputBuffer.length() > 0 && !this.inputBuffer.startsWith(contentLengthText) {
            sys.panic(f"LSP: Input Buffer must never start with something other than '{contentLengthText}'");
        }

        let separator = "\r\n\r\n";
        let separatorIndex = find(this.inputBuffer, separator);
        if !separatorIndex {
            return none;
        }

        let numberLength = separatorIndex;
        let numberString = this.inputBuffer.cloneSlice(contentLengthText.length, separatorIndex);
        let contentLength = strToInt(numberString);
        if !contentLength {
            fmt.println("LSP Response: Failed to parse content length");
            return none;
        }
        let headerLength = separatorIndex + separator.length;
        let totalPacketLength = headerLength + contentLength;

        if this.inputBuffer.length() < totalPacketLength {
            return none;
        }

        // Extract response and shift remaining packet forward
        let response = this.inputBuffer.cloneSlice(headerLength, headerLength + contentLength);
        let remainingPacket = this.inputBuffer.cloneSlice(totalPacketLength);
        this.inputBuffer = remainingPacket;

        return this.processResponse(response);
    }

    fn processResponse(response: str): HighlightResult | none {
        let j = json.parse<HighlightResponse>(response);
        if !j {
            fmt.println("Failed to parse response: ", j.error());
            return none;
        }
        if j.jsonrpc != "2.0" {
            fmt.println(f"LSP: Response invalid: Expected jsonrpc version 2.0, but received {j.jsonrpc}");
            return none;
        }

        if j.result {
            if j.id == 0 {
                fmt.println("Highlight Engine initialized");
            }
            else if j.id == 1 {
                let r = HighlightResult {
                    tokens: [],
                };
                if (j.result.tokens) {
                    r.tokens = j.result.tokens;
                }
                if (j.result.firstLine) {
                    r.firstLine = j.result.firstLine;
                    r.incremental = true;
                }
                if (j.result.lastLine) {
                    r.lastLine = j.result.lastLine;
                }
                if (j.result.lineCount) {
                    r.lineCount = j.result.lineCount;
                }
                return r;
            }
            else {
                fmt.println("Received unknown LSP response id: {}", j.id);
            }
        } else if j.error {
            fmt.println("LSP ERROR");
            // LSPError lspError = (LSPError) { .code = j.error.code, .message = j.error.message };
            // processLSPError(ctx, lspError);
        } else {
            fmt.println("LSP: Response invalid: Has neither result nor error object");
        }
        return none;
    }
};

fn strToInt(string: str): int | none {
    if (string.length == 0) {
        return none;
    }

    let sign = 1;
    let i = 0;

    if (string[0] == b"-") {
        sign = -1;
        i = 1;
    } else if (string[0] == b"+") {
        i = 1;
    }

    let value = 0;
    for (let x = 0; i < string.length; i++) {
        const digit = string[i] as int - 48;

        if (digit < 0 || digit > 9) {
            return none;
        }

        value = value * 10 + digit;
    }

    return sign * value;
}

fn find(string: String, search: str): int | none {
  if (search.length == 0) {
    return 0;
  }

  let last = string.length() - search.length;

  for (let i = 0; i <= last; i++) {
    let j = 0;

    while (j < search.length && string.getAt(i + j) == search[j]) {
      j++;
    }

    if (j == search.length) {
      return i;
    }
  }

  return none;
}