import ui_widgets
import ui_components
import filedialog

from ui_widgets import TabsComponent

// The application shell: the tab list, and one editor per tab.

// The shell's whole model of an open file. A key is a component IDENTITY and
// must never be reused -- hand a new tab a closed one's key and the component
// system returns the dead tab's editor, document and all. An index is exactly
// the wrong choice, since closing a tab renumbers every tab after it.
ref struct OpenTab {
    key: int;
    path: str;
}

@setup

let cache = appCache();

let openTabs = rx.shallowReactive<[]OpenTab>([]);
let activeKey = reactive<int>(-1);
let nextKey = reactive<int>(0);

let rootRef = elementRef<DivElement>();
// The scrim has to cover the whole window, and a floating element is positioned
// against its containing block rather than stretched to fill it.
let rootSize = computed((): Vec2 => {
    let root = rx.get(rootRef);
    let size = root ? root.size() : none;
    return size ? size as Vec2 : Vec2(0.0, 0.0);
});

let indexOfKey = (key: int): int => {
    let tabs: []OpenTab = rx.get(openTabs);
    for (let i = 0; i < tabs.length; i++) {
        if tabs[i].key == key {
            return i;
        }
    }
    return -1;
};

let keyForPath = (path: str): int => {
    let tabs: []OpenTab = rx.get(openTabs);
    for tab in tabs {
        if tab.path == path {
            return tab.key;
        }
    }
    return -1;
};

let pathForKey = (key: int): str => {
    let tabs: []OpenTab = rx.get(openTabs);
    for tab in tabs {
        if tab.key == key {
            return tab.path;
        }
    }
    return "";
};

// So the editor comes back up where it was left rather than empty.
let persist = () => {
    let saved = "";
    let tabs: []OpenTab = rx.get(openTabs);
    for tab in tabs {
        saved = saved.length > 0 ? saved + "\n" + tab.path : tab.path;
    }
    cache.data.openFiles := saved;
    cache.data.activeFile := pathForKey(rx.get(activeKey));
};

let openFile = (path: str) => {
    if path.length == 0 {
        return;
    }
    // Two tabs on one path would be two editors on one highlighter document,
    // fighting over the same uri.
    let existing = keyForPath(path);
    if existing >= 0 {
        activeKey := existing;
        persist();
        return;
    }
    let key = rx.get(nextKey);
    nextKey := key + 1;
    let tabs: []OpenTab = rx.get(openTabs);
    tabs.push(OpenTab { key: key, path: path });
    openTabs := tabs;
    activeKey := key;
    persist();
};

let closeTab = (key: int) => {
    let index = indexOfKey(key);
    if index < 0 {
        return;
    }
    // Closing is the one way of leaving a buffer that never produces a blur, so
    // the autosave happens here. It can also say no: a file that changed under
    // an edited buffer cannot be written without an answer, and the tab stays
    // until the dialog is answered.
    if !documents().requestClose(key) {
        return;
    }

    let tabs: []OpenTab = rx.get(openTabs);
    tabs.remove(index);
    openTabs := tabs;
    // There is no unmount hook, so the registry entry has to be dropped here or
    // it would keep handing out closures over a document nothing can see.
    documents().unregister(key);

    if rx.get(activeKey) == key {
        if tabs.length == 0 {
            activeKey := -1;
        } else {
            // The tab to the left, or the first one -- what every editor does.
            let next = index - 1;
            if next < 0 { next = 0; }
            if next >= tabs.length { next = tabs.length - 1; }
            activeKey := tabs[next].key;
        }
    }
    persist();
};

let selectTab = (key: int) => {
    activeKey := key;
    persist();
};

let promptForFile = () => {
    if let picked = filedialog.pickFile(); picked is filedialog.DialogSuccess {
        openFile(picked.path);
    }
};

// +1 is the next tab, -1 the previous; both wrap.
let cycleEditor = (delta: int) => {
    let tabs: []OpenTab = rx.get(openTabs);
    if tabs.length <= 1 {
        return;
    }
    let index = indexOfKey(rx.get(activeKey));
    if index < 0 { index = 0; }
    let next = index + delta;
    if next < 0 { next = tabs.length - 1; }
    if next >= tabs.length { next = 0; }
    activeKey := tabs[next].key;
    persist();
};

let closeActiveEditor = () => {
    let key = rx.get(activeKey);
    if key >= 0 {
        closeTab(key);
    }
};

// Walks from the END, because closing a tab removes it from the array being
// walked.
let closeAllEditors = () => {
    let tabs: []OpenTab = rx.get(openTabs);
    let i = tabs.length - 1;
    while i >= 0 {
        closeTab(tabs[i].key);
        i = i - 1;
    }
};

// Which KEYS reach these is not decided here -- that is the rule table in
// editor_keymap.hz, and neither half knows the other's contents.
registerWorkbenchCommands(keybindings(), WorkbenchCommands {
    openFile: () => { promptForFile(); },
    openFolder: () => { promptForWorkspace(); },
    closeFolder: () => { closeWorkspace(); },
    openRecent: () => {},
    closeActiveEditor: () => { closeActiveEditor(); },
    closeAllEditors: () => { closeAllEditors(); },
    nextEditor: () => { cycleEditor(1); },
    previousEditor: () => { cycleEditor(-1); },
    // Every dirty tab, not just the visible one, which is why this is a shell
    // command while plain Save is an editor one.
    saveAll: () => { documents().saveAllDirty(); },
});

// Restore the previous session, falling back to asking for a file.
let restored = false;
let savedFiles = cache.data.openFiles as str;
if savedFiles.length > 0 {
    for path in savedFiles.split("\n") {
        if path.length > 0 {
            openFile(path);
            restored = true;
        }
    }
}
if cache.data.activeFile {
    let key = keyForPath(cache.data.activeFile as str);
    if key >= 0 {
        activeKey := key;
    }
}
// A cache written by the single-file version, which knew nothing about tabs.
if !restored && cache.data.file {
    openFile(cache.data.file as str);
}
if rx.get(openTabs).length == 0 {
    promptForFile();
}

// The strip's own view of the tabs. A derived copy rather than a stored field,
// because the shell has no idea whether a file has unsaved changes and should
// not start keeping a second, staler copy of the answer.
let tabItems = computed((): []ui_widgets.TabItem => {
    rx.get(documents().generation);
    let items: []ui_widgets.TabItem = [];
    let tabs: []OpenTab = rx.get(openTabs);
    for tab in tabs {
        items.push(ui_widgets.TabItem {
            key: tab.key,
            title: fileNameOf(tab.path),
            modified: documents().isDirty(tab.key),
        });
    }
    return items;
});

// The strip cannot compare its item array, so this is what tells it the list
// moved: any number derived from what it draws.
let tabsFingerprint = computed((): int => {
    let items: []ui_widgets.TabItem = rx.get(tabItems);
    let sum = items.length;
    for item in items {
        sum = sum * 31 + item.key * 2 + (item.modified ?? false ? 1 : 0);
    }
    return sum;
});

let windowTitle = computed((): str => {
    let name = fileNameOf(pathForKey(rx.get(activeKey)));
    return name.length > 0 ? f"{name} - Haze CodeEditor" : "Haze CodeEditor";
});

// --- The conflict dialog -----------------------------------------
//
// Bound once and looking the entry up per call, so the props stay equal frame
// to frame -- a closure rebuilt per render compares unequal every time and
// defeats the memoization entirely.
let conflictEntry = computed((): DocEntry | none => documents().firstConflict());
let conflictFileName = computed((): str => {
    let entry = rx.get(conflictEntry);
    return entry ? fileNameOf(entry.path) : "";
});
let overwriteConflict: DocAction = () => {
    let entry = documents().firstConflict();
    if entry { entry.resolveOverwrite(); }
};
let discardConflict: DocAction = () => {
    let entry = documents().firstConflict();
    if entry { entry.resolveDiscard(); }
};
let cancelConflict: DocAction = () => {
    let entry = documents().firstConflict();
    if entry { entry.resolveCancel(); }
};

let onKeyDownCapture = (event: ui_components.KeyboardEvent) => {
    // What makes the dialog MODAL rather than merely on top: while it is up no
    // binding resolves, so ctrl+s cannot save the very file whose fate is being
    // asked about. The dialog has focus, so the keys it wants still reach it.
    if modalIsOpen() {
        return;
    }
    if keybindings().dispatch(event).handled() {
        event.stopPropagation();
    }
};

// The shell's half of a go-to-definition: make sure the target file has a tab
// and is the visible one. Placing the caret is the destination editor's half.
let navigationSerialSeen = reactive<int>(0);
let followNavigation = computed((): int => {
    let nav = navigation();
    let serial = rx.get(nav.serial);
    if serial == rx.get(navigationSerialSeen) {
        return serial;
    }
    navigationSerialSeen := serial;
    let path: str = rx.get(nav.path);
    if path.length > 0 {
        openFile(path);
    }
    return serial;
});

ui.onFrame(() => {
    // Pumped once here rather than in each editor: the connection is one, and a
    // reply is consumed by whoever reads it first, so N tabs would race for each
    // other's answers.
    let bridge = getState().lspBridge;
    if bridge {
        bridge.loop();
    }
    rx.get(followNavigation);

    let count = rx.get(openTabs).length;
    keybindings().context.setBool("hasOpenTabs", count > 0);
    if count == 0 {
        // Closing the focused tab UNMOUNTS its editor, and an unmounted element
        // never gets an onBlur -- so the flag would stay stuck true with no
        // editor left to be true about.
        keybindings().context.setBool(ctxEditorTextFocus(), false);
    }
});

@template [w-grow h-grow col relative bg-["#181818"] text-color-["#FFFFFF"]]
    ref=rootRef
    focusable=true
    @keydowncapture=onKeyDownCapture

// Only when the platform is not drawing one. Asked of the window rather than
// restating main.hz's constant, so the two cannot drift apart.
TitleBar if=[!ui.window.hasNativeTitlebar()] [] title=[windowTitle] {}

Tabs if=[tabItems.length > 0] [] items=[tabItems] revision=[tabsFingerprint]
    activeKey=[activeKey] @select=selectTab @close=closeTab {}

div if=[tabItems.length == 0] [w-grow h-grow col items-center justify-center]
    focusable=true autofocus=true
{
    text [text-color-["#7A7A7A"]] ["No file open  --  Ctrl+O to open one"]
}

// Every tab stays MOUNTED and merely hides itself when it is not the active
// one, which is what makes switching tabs mean "look somewhere else" instead of
// "throw this away and rebuild it": scroll offset, caret, undo history and
// cached tokens all live inside the editor component. A hidden subtree is not
// laid out, painted or hit-tested.
//
// `key=` sits on the component itself rather than on a wrapper div, because a
// component nested INSIDE a loop body is not keyed by the loop -- every
// iteration would ask for the same component id, and they would all share one
// instance.
EditorView for=[tab in openTabs] key=[tab.key] [] tabKey=[tab.key]
    filePath=[tab.path] active=[tab.key == activeKey] {}

// Last, because hit-testing walks children in reverse declaration order and
// ignores z-index: a modal declared earlier would be painted over the editor
// but have its clicks swallowed by it.
ConflictDialog [] open=[conflictEntry ? true : false] fileName=[conflictFileName]
    viewport=[rootSize] onOverwrite=[overwriteConflict] onDiscard=[discardConflict]
    onCancel=[cancelConflict] {}
