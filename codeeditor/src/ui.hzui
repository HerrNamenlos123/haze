import ui_widgets
import ui_components
import filedialog

from ui_widgets import TabsComponent, SplitterComponent, ButtonComponent, ButtonSlotContent

// The application shell: the tab list, and one editor per tab.

// The shell's whole model of an open file. A key is a component IDENTITY and
// must never be reused -- hand a new tab a closed one's key and the component
// system returns the dead tab's editor, document and all. An index is exactly
// the wrong choice, since closing a tab renumbers every tab after it.
ref struct OpenTab {
    key: int;
    path: str;
}

@setup

let cache = appCache();

let openTabs = rx.shallowReactive<[]OpenTab>([]);
let activeKey = reactive<int>(-1);
let nextKey = reactive<int>(0);

let rootRef = elementRef<DivElement>();
// The scrim has to cover the whole window, and a floating element is positioned
// against its containing block rather than stretched to fill it.
let rootSize = computed((): Vec2 => {
    let root = rx.get(rootRef);
    let size = root ? root.size() : none;
    return size ? size as Vec2 : Vec2(0.0, 0.0);
});

let indexOfKey = (key: int): int => {
    let tabs: []OpenTab = rx.get(openTabs);
    for (let i = 0; i < tabs.length; i++) {
        if tabs[i].key == key {
            return i;
        }
    }
    return -1;
};

let keyForPath = (path: str): int => {
    let tabs: []OpenTab = rx.get(openTabs);
    for tab in tabs {
        if tab.path == path {
            return tab.key;
        }
    }
    return -1;
};

let pathForKey = (key: int): str => {
    let tabs: []OpenTab = rx.get(openTabs);
    for tab in tabs {
        if tab.key == key {
            return tab.path;
        }
    }
    return "";
};

// So the editor comes back up where it was left rather than empty.
let persist = () => {
    let saved = "";
    let tabs: []OpenTab = rx.get(openTabs);
    for tab in tabs {
        saved = saved.length > 0 ? saved + "\n" + tab.path : tab.path;
    }
    cache.data.openFiles := saved;
    cache.data.activeFile := pathForKey(rx.get(activeKey));
};

// `preview` opens it in VS Code's preview tab: the one tab the next preview
// replaces, in place, until it is pinned (see pinTab in navigation.hz).
let openFile = (path: str, preview: bool) => {
    if path.length == 0 {
        return;
    }
    // Two tabs on one path would be two editors on one highlighter document,
    // fighting over the same uri.
    let existing = keyForPath(path);
    if existing >= 0 {
        if !preview {
            pinTab(existing);
        }
        activeKey := existing;
        persist();
        return;
    }
    let key = rx.get(nextKey);
    nextKey := key + 1;
    let tabs: []OpenTab = rx.get(openTabs);
    let previous = rx.get(navigation().previewKey);
    let at = preview && previous >= 0 ? indexOfKey(previous) : -1;
    // The old preview makes way, in its place -- unless it cannot close (a
    // conflict still waiting for an answer), and then it simply stays.
    if at >= 0 && documents().requestClose(previous) {
        tabs.remove(at);
        documents().unregister(previous);
        tabs.insert(at, OpenTab { key: key, path: path });
    } else {
        tabs.push(OpenTab { key: key, path: path });
    }
    openTabs := tabs;
    activeKey := key;
    if preview {
        navigation().previewKey := key;
    }
    persist();
};
let openPinned = (path: str) => { openFile(path, false); };
let openPreview = (path: str) => { openFile(path, true); };

let closeTab = (key: int) => {
    let index = indexOfKey(key);
    if index < 0 {
        return;
    }
    // Closing is the one way of leaving a buffer that never produces a blur, so
    // the autosave happens here. It can also say no: a file that changed under
    // an edited buffer cannot be written without an answer, and the tab stays
    // until the dialog is answered.
    if !documents().requestClose(key) {
        return;
    }

    let tabs: []OpenTab = rx.get(openTabs);
    tabs.remove(index);
    openTabs := tabs;
    pinTab(key);
    // There is no unmount hook, so the registry entry has to be dropped here or
    // it would keep handing out closures over a document nothing can see.
    documents().unregister(key);

    if rx.get(activeKey) == key {
        if tabs.length == 0 {
            activeKey := -1;
        } else {
            // The tab to the left, or the first one -- what every editor does.
            let next = index - 1;
            if next < 0 { next = 0; }
            if next >= tabs.length { next = tabs.length - 1; }
            activeKey := tabs[next].key;
        }
    }
    persist();
};

// Double-clicking a tab keeps it.
let keepTab = (key: int) => { pinTab(key); };

let selectTab = (key: int) => {
    activeKey := key;
    persist();
};

// The two side panels. Widths are dragged, so they live in reactive cells and
// are written back to the cache whenever they settle.
let treeOpen = reactive<bool>((cache.data.treeOpen ?? true) as bool);
let agentOpen = reactive<bool>(false);
let treeWidth = reactive<real>((cache.data.treeWidth ?? 240.0) as real);
let agentWidth = reactive<real>((cache.data.agentWidth ?? 380.0) as real);

let clampWidth = (value: real): real => {
    let limit = rx.get(rootSize).x - 320.0;
    if value > limit { value = limit; }
    return value < 160.0 ? 160.0 : value;
};
let dragTree = (x: real) => {
    treeWidth := clampWidth(x);
    cache.data.treeWidth := rx.get(treeWidth);
};
let dragAgent = (x: real) => {
    agentWidth := clampWidth(rx.get(rootSize).x - x);
    cache.data.agentWidth := rx.get(agentWidth);
};
let toggleTree = () => {
    treeOpen := !rx.get(treeOpen);
    cache.data.treeOpen := rx.get(treeOpen);
};

// The sidebar shows one view at a time, picked from the activity bar. Picking
// the one already showing hides the sidebar, as in VS Code.
let sidebarView = reactive<str>((cache.data.sidebarView ?? "explorer") as str);
let revealView = (view: str) => {
    sidebarView := view;
    cache.data.sidebarView := view;
    if !rx.get(treeOpen) { toggleTree(); }
};
let clickView = (view: str) => {
    if rx.get(treeOpen) && rx.get(sidebarView) == view {
        toggleTree();
        return;
    }
    revealView(view);
};
// Ctrl+Shift+F: seeded with the editor's one-line selection, if any.
let openSearchView = () => {
    revealView("search");
    let s = searchState();
    if s.editorSelection.length > 0 {
        s.query := s.editorSelection;
        scheduleSearch(s, ui.now(), 0.0);
    }
    s.focusSerial := rx.get(s.focusSerial) + 1;
};
let toggleAgent = () => {
    agentOpen := !rx.get(agentOpen);
    if rx.get(agentOpen) { agent().boot(rx.get(workspace().path)); }
};

let quickOpen = reactive<bool>(false);
// The folder Ctrl+P searches: the workspace when one is open, otherwise the
// active file's own folder -- a file opened without a folder still gets a
// picker over its siblings rather than an empty list.
let quickOpenRoot = computed((): str => {
    let folder: str = rx.get(workspace().path);
    return folder.length > 0 ? folder : quickOpenParent(pathForKey(rx.get(activeKey)));
});
let closeQuickOpen = () => {
    quickOpen := false;
    documents().requestEditorFocus();
};
let pickQuickOpen = (path: str) => {
    closeQuickOpen();
    openFile(path, false);
};

let recentOpen = reactive<bool>(false);
let closeRecent = () => {
    recentOpen := false;
    documents().requestEditorFocus();
};
let pickRecent = (path: str) => {
    closeRecent();
    openWorkspace(path);
};
// Every remembered folder but the open one, for the welcome page.
let otherRecents = computed((): []str => {
    let current: str = rx.get(workspace().path);
    let all: []str = rx.get(workspace().recents);
    let out: []str = [];
    for path in all {
        if path != current { out.push(path); }
    }
    return out;
});

let pickWorkspace = () => { promptForWorkspace(); };

let promptForFile = () => {
    let current: str = rx.get(workspace().path);
    if let picked = filedialog.pickFile({ defaultPath: current }); picked is filedialog.DialogSuccess {
        openFile(picked.path, false);
    }
};
let showQuickOpen = () => { quickOpen := true; };

// +1 is the next tab, -1 the previous; both wrap.
let cycleEditor = (delta: int) => {
    let tabs: []OpenTab = rx.get(openTabs);
    if tabs.length <= 1 {
        return;
    }
    let index = indexOfKey(rx.get(activeKey));
    if index < 0 { index = 0; }
    let next = index + delta;
    if next < 0 { next = tabs.length - 1; }
    if next >= tabs.length { next = 0; }
    activeKey := tabs[next].key;
    persist();
};

let closeActiveEditor = () => {
    let key = rx.get(activeKey);
    if key >= 0 {
        closeTab(key);
    }
};

// Walks from the END, because closing a tab removes it from the array being
// walked.
let closeAllEditors = () => {
    let tabs: []OpenTab = rx.get(openTabs);
    let i = tabs.length - 1;
    while i >= 0 {
        closeTab(tabs[i].key);
        i = i - 1;
    }
};

// Which KEYS reach these is not decided here -- that is the rule table in
// editor_keymap.hz, and neither half knows the other's contents.
registerWorkbenchCommands(keybindings(), WorkbenchCommands {
    openFile: () => { promptForFile(); },
    openFolder: () => { promptForWorkspace(); },
    closeFolder: () => { closeWorkspace(); },
    openRecent: () => { recentOpen := true; },
    closeActiveEditor: () => { closeActiveEditor(); },
    closeAllEditors: () => { closeAllEditors(); },
    nextEditor: () => { cycleEditor(1); },
    previousEditor: () => { cycleEditor(-1); },
    // Every dirty tab, not just the visible one, which is why this is a shell
    // command while plain Save is an editor one.
    saveAll: () => { documents().saveAllDirty(); },
    quickOpen: () => { quickOpen := true; },
    toggleFileTree: () => { toggleTree(); },
    toggleAgent: () => { toggleAgent(); },
    findInFiles: () => { openSearchView(); },
    showExplorer: () => { revealView("explorer"); },
    nextSearchResult: () => { stepSearchResult(1); },
    previousSearchResult: () => { stepSearchResult(-1); },
});

// Bring back a set of tabs. A remembered file that has since been deleted or
// moved must not come back as a tab over a path that no longer reads.
let restoreTabs = (files: []str, active: str) => {
    for path in files {
        if path.length > 0 && pathExists(path) {
            openFile(path, false);
        }
    }
    let key = keyForPath(active);
    if key >= 0 {
        activeKey := key;
        persist();
    }
};

let openTabPaths = (): []str => {
    let paths: []str = [];
    let tabs: []OpenTab = rx.get(openTabs);
    for tab in tabs {
        paths.push(tab.path);
    }
    return paths;
};

// Restore the previous session. Nothing is ever asked for at startup: with no
// tabs the welcome page offers the folder and file commands instead.
let savedFiles = cache.data.openFiles as str;
let savedActive = "";
if cache.data.activeFile {
    savedActive = cache.data.activeFile as str;
}
if savedFiles.length > 0 {
    restoreTabs(savedFiles.split("\n"), savedActive);
} else if cache.data.file {
    // A cache written by the single-file version, which knew nothing about tabs.
    openFile(cache.data.file as str, false);
}

// Switching folders swaps the tabs, as in VS Code: the old folder's tabs are
// remembered for it, and the new one's come back.
ui.watch(() => rx.get(workspace().path), (path: str, previous: str | none) => {
    if previous is none {
        return;
    }
    let old = previous as str;
    if old == path {
        return;
    }
    storeWorkspaceSession(old, openTabPaths(), pathForKey(rx.get(activeKey)));
    closeAllEditors();
    let session = loadWorkspaceSession(path);
    restoreTabs(session.files, session.active);
    persist();
    if path.length > 0 {
        revealView("explorer");
    }
});

// The strip's own view of the tabs. A derived copy rather than a stored field,
// because the shell has no idea whether a file has unsaved changes and should
// not start keeping a second, staler copy of the answer.
let tabItems = computed((): []ui_widgets.TabItem => {
    rx.get(documents().generation);
    let items: []ui_widgets.TabItem = [];
    let tabs: []OpenTab = rx.get(openTabs);
    for tab in tabs {
        items.push(ui_widgets.TabItem {
            key: tab.key,
            title: fileNameOf(tab.path),
            modified: documents().isDirty(tab.key),
            preview: tab.key == rx.get(navigation().previewKey),
        });
    }
    return items;
});

// The strip cannot compare its item array, so this is what tells it the list
// moved: any number derived from what it draws.
let tabsFingerprint = computed((): int => {
    let items: []ui_widgets.TabItem = rx.get(tabItems);
    let sum = items.length;
    for item in items {
        sum = sum * 31 + item.key * 4 + (item.modified ?? false ? 1 : 0)
            + (item.preview ?? false ? 2 : 0);
    }
    return sum;
});

let activeFilePath = computed((): str => pathForKey(rx.get(activeKey)));

// VS Code's "file - folder - app".
let windowTitle = computed((): str => {
    let name = fileNameOf(pathForKey(rx.get(activeKey)));
    let folder: str = rx.get(workspace().name);
    let title = folder.length > 0 ? f"{folder} - Haze CodeEditor" : "Haze CodeEditor";
    return name.length > 0 ? f"{name} - {title}" : title;
});
let welcomeTitle = computed((): str => {
    let folder: str = rx.get(workspace().name);
    return folder.length > 0 ? folder : "Haze CodeEditor";
});

// --- The conflict dialog -----------------------------------------
//
// Bound once and looking the entry up per call, so the props stay equal frame
// to frame -- a closure rebuilt per render compares unequal every time and
// defeats the memoization entirely.
let conflictEntry = computed((): DocEntry | none => documents().firstConflict());
let conflictFileName = computed((): str => {
    let entry = rx.get(conflictEntry);
    return entry ? fileNameOf(entry.path) : "";
});
let overwriteConflict: DocAction = () => {
    let entry = documents().firstConflict();
    if entry { entry.resolveOverwrite(); }
};
let discardConflict: DocAction = () => {
    let entry = documents().firstConflict();
    if entry { entry.resolveDiscard(); }
};
let cancelConflict: DocAction = () => {
    let entry = documents().firstConflict();
    if entry { entry.resolveCancel(); }
};

let onKeyDownCapture = (event: ui_components.KeyboardEvent) => {
    // What makes the dialog MODAL rather than merely on top: while it is up no
    // binding resolves, so ctrl+s cannot save the very file whose fate is being
    // asked about. The dialog has focus, so the keys it wants still reach it.
    if modalIsOpen() || rx.get(quickOpen) || rx.get(recentOpen) {
        return;
    }
    if keybindings().dispatch(event).handled() {
        event.stopPropagation();
        // A key a rule consumed has no default action either: a bound tab
        // (accepting a suggestion) must not also move focus out of the editor.
        event.preventDefault();
    }
};

// The shell's half of a go-to-definition: make sure the target file has a tab
// and is the visible one. Placing the caret is the destination editor's half.
let navigationSerialSeen = reactive<int>(0);
let followNavigation = computed((): int => {
    let nav = navigation();
    let serial = rx.get(nav.serial);
    if serial == rx.get(navigationSerialSeen) {
        return serial;
    }
    navigationSerialSeen := serial;
    let path: str = rx.get(nav.path);
    if path.length > 0 {
        openFile(path, rx.get(nav.preview));
    }
    return serial;
});

ui.onFrame(() => {
    // Pumped once here rather than in each editor: the connection is one, and a
    // reply is consumed by whoever reads it first, so N tabs would race for each
    // other's answers.
    let bridge = getState().lspBridge;
    if bridge {
        bridge.loop();
    }
    // Only while the panel is hidden: it does its own polling, and a session
    // nobody drains stalls behind a full pipe once its turn fills it.
    if !rx.get(agentOpen) {
        agent().poll();
    }
    rx.get(followNavigation);

    pumpSearch(ui.now(), 262144);
    keybindings().context.setBool(ctxHasSearchResults(), searchState().total > 0);
    // Editing a preview tab keeps it, as in VS Code: a buffer with unsaved
    // changes must never be replaced by the next preview.
    let previewKey = rx.get(navigation().previewKey);
    if previewKey >= 0 && documents().isDirty(previewKey) {
        pinTab(previewKey);
    }

    let count = rx.get(openTabs).length;
    keybindings().context.setBool("hasOpenTabs", count > 0);
    if count == 0 {
        // Closing the focused tab UNMOUNTS its editor, and an unmounted element
        // never gets an onBlur -- so the flag would stay stuck true with no
        // editor left to be true about.
        keybindings().context.setBool(ctxEditorTextFocus(), false);
    }
});

@template [w-grow h-grow col relative bg-["#181818"] text-color-["#FFFFFF"]]
    ref=rootRef
    focusable=true
    @keydowncapture=onKeyDownCapture

// Only when the platform is not drawing one. Asked of the window rather than
// restating main.hz's constant, so the two cannot drift apart.
TitleBar if=[!ui.window.hasNativeTitlebar()] [] title=[windowTitle] {}

div [row w-grow h-grow gap-0] {
    // The activity bar.
    div [col h-grow w-[44]px items-center gap-1 py-1 bg-["#181818"]] {
        Button [] icon="files" selected=[rx.get(treeOpen) && rx.get(sidebarView) != "search"]
            paddingX=[10] paddingY=[8] focusRing=[0] @click=[() => { clickView("explorer"); }] {}
        Button [] icon="search" selected=[rx.get(treeOpen) && rx.get(sidebarView) == "search"]
            paddingX=[10] paddingY=[8] focusRing=[0] @click=[() => { clickView("search"); }] {}
    }
    div if=[rx.get(treeOpen)] [col h-grow w-[rx.get(treeWidth)]px] {
        FileTree if=[rx.get(sidebarView) != "search"] [] root=[rx.get(workspace().path)]
            activePath=[activeFilePath] @open=openPreview @open-folder=pickWorkspace {}
        SearchView if=[rx.get(sidebarView) == "search"] [] {}
    }
    Splitter if=[rx.get(treeOpen)] [] @drag=dragTree {}

    div [col w-grow h-grow gap-0] {
        Tabs if=[tabItems.length > 0] [] items=[tabItems] revision=[tabsFingerprint]
            activeKey=[activeKey] previewFontFamily=[italicFontFamily()]
            @select=selectTab @close=closeTab @pin=keepTab {}

        // The welcome page: what to open, never a dialog nobody asked for.
        div if=[tabItems.length == 0] [w-grow h-grow col items-center justify-center gap-2]
            focusable=true autofocus=true
        {
            text [font-size-20 text-color-["#CCCCCC"]] [welcomeTitle]
            div [col w-fit h-fit gap-1 pt-2] {
                Button [] icon="folder-opened" label="Open Folder...   Ctrl+K Ctrl+O" @click=pickWorkspace {}
                Button [] icon="file" label="Open File...   Ctrl+O" @click=promptForFile {}
                Button if=[hasWorkspace()] [] icon="search" label="Go to File...   Ctrl+P" @click=showQuickOpen {}
                Button if=[otherRecents.length > 0] [] icon="history" label="Open Recent...   Ctrl+R"
                    @click=[() => { recentOpen := true; }] {}
            }
            div if=[otherRecents.length > 0] [col w-fit h-fit gap-0 pt-2] {
                text [text-color-["#7A7A7A"]] ["Recent"]
                Button for=[path, index in otherRecents] key=[index] [] label=[path]
                    @click=[() => { openWorkspace(path); }] {}
            }
        }

        // Every tab stays MOUNTED and merely hides itself when it is not the
        // active one, which is what makes switching tabs mean "look somewhere
        // else" instead of "throw this away and rebuild it": scroll offset,
        // caret, undo history and cached tokens all live inside the editor
        // component. A hidden subtree is not laid out, painted or hit-tested.
        //
        // `key=` sits on the component itself rather than on a wrapper div,
        // because a component nested INSIDE a loop body is not keyed by the
        // loop -- every iteration would ask for the same component id, and
        // they would all share one instance.
        EditorView for=[tab in openTabs] key=[tab.key] [] tabKey=[tab.key]
            filePath=[tab.path] active=[tab.key == activeKey] {}
    }

    Splitter if=[rx.get(agentOpen)] [] @drag=dragAgent {}
    div if=[rx.get(agentOpen)] [col h-grow w-[rx.get(agentWidth)]px] {
        ClaudePanel [] codeFontFamily=[editorFontFamily()] {}
    }
}

QuickOpen [] open=[rx.get(quickOpen)] root=[quickOpenRoot] @close=closeQuickOpen @pick=pickQuickOpen {}
RecentPicker [] open=[rx.get(recentOpen)] @close=closeRecent @pick=pickRecent {}

// Last, because hit-testing walks children in reverse declaration order and
// ignores z-index: a modal declared earlier would be painted over the editor
// but have its clicks swallowed by it.
ConflictDialog [] open=[conflictEntry ? true : false] fileName=[conflictFileName]
    viewport=[rootSize] onOverwrite=[overwriteConflict] onDiscard=[discardConflict]
    onCancel=[cancelConflict] {}
