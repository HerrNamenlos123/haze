from ui_widgets import ButtonComponent

// A REAL titlebar, not a strip that looks like one.
//
// The root element carries `os-titlebar`, which publishes its box to the
// window manager (see ui_styling.OSTitlebar, and
// ui_components.UIContext.syncWindowRegions for how it gets there). Everything
// a titlebar is expected to do -- drag the window, double-click to
// maximize/restore, throw it at a screen edge or a corner to snap or tile it,
// shake it, right-click for the window menu, move it with the keyboard -- is
// therefore done BY the window manager, on that box, and not one line of it is
// implemented in this file. It could not be: those gestures are the desktop's,
// they differ per platform and per user setting, and an application that
// reimplements them gets a window that behaves almost, but not quite, like
// every other window on the machine.
//
// What is implemented here is the three buttons, because they are the only
// part the platform cannot infer, and the layout. The buttons need no
// annotation to stay clickable: an element that takes pointer input of its own
// is carved out of the drag region automatically -- see
// ui_components.isPointerInteractive.

@props
color: str = "#3C3C3C";
textColor: str = "#CCCCCC";
title: str = "";
height: real = 32.0;
// The minimize/maximize/close group. Turn it off for a titlebar that supplies
// its own controls through the rightContent slot; dragging, resizing and
// snapping do not depend on it either way, since those come from the OS.
windowControls: bool = true;
controlHoverColor: str = "#FFFFFF14";
controlActiveColor: str = "#FFFFFF29";
// Close hovers red rather than the neutral grey the other two get, matching
// what every desktop does with the one button that discards work.
closeHoverColor: str = "#C42B1C";
closeActiveColor: str = "#B0271A";

@slot
leftContent: {
    title: str;
};
centerContent: {
    title: str;
};
rightContent: {
    title: str;
};

@setup

let rootRef = elementRef<DivElement>();

// Centering the title EXACTLY, rather than approximately.
//
// The obvious version -- a growing spacer either side -- only centres when the
// left and right content happen to be the same width, which they never are
// once there are three buttons on one side. So the title floats out of flow
// (nothing can push it around), is placed at the bar's midpoint, and is then
// shifted back by half of its OWN width. That last part is what `translate`
// is for here: it is a multiple of the element's own size, which is the one
// measurement this side does not have. It is CSS's
// `position: absolute; left: 50%; transform: translateX(-50%)`, written in
// the units this layout engine has.
let centerX = computed(() => {
    let size = rootRef?.size();
    if size { return size.x / 2.0; }
    return 0.0;
});

// `ui.window` is per-UIContext, so every call below means THE window this
// component is running in -- there is no global here to pick the wrong one,
// and nothing in this file changes the day a second window exists.
let maximizeIcon = computed(() => {
    if ui.window.isMaximized() { return "chrome-restore"; }
    return "chrome-maximize";
});

let minimizeWindow = () => {
    ui.window.minimize();
};

// The maximize button. There is deliberately no double-click handler beside
// it: a press on the drag region never reaches this component on any backend
// -- it belongs to the platform layer, which turns a double click there into
// the very same maximize/restore. See ui_styling.OSTitlebar.
let toggleMaximizeWindow = () => {
    ui.window.toggleMaximize();
};

// Goes out as the platform's own close request, so this runs the identical
// shutdown sequence the window manager's X runs: same event, same queue, same
// handler, one path. See ui_components.WindowApi.close.
let closeWindow = () => {
    ui.window.close();
};


@template [
        os-titlebar relative row w-grow h-[props.height]px items-center
        bg-[props.color] font-size-16
    ]
    ref=rootRef

slot leftContent title=[props.title]

div [w-grow] {}

div [absolute left-[rx.get(centerX)] translate-x-[-0.5] h-[props.height]px w-fit row items-center] {
    slot centerContent title=[props.title] {
        text [no-wrap text-color-[props.textColor]] [props.title]
    }
}

slot rightContent title=[props.title]

div if=[props.windowControls] [row items-center h-grow] {
    Button [] icon="chrome-minimize" paddingX=[14] paddingY=[9] rounded=[0]
        bgHover=[props.controlHoverColor] bgActive=[props.controlActiveColor]
        textColor=[props.textColor] focusRing=[0] @click=minimizeWindow {}

    Button [] icon=[rx.get(maximizeIcon)] paddingX=[14] paddingY=[9] rounded=[0]
        bgHover=[props.controlHoverColor] bgActive=[props.controlActiveColor]
        textColor=[props.textColor] focusRing=[0] @click=toggleMaximizeWindow {}

    Button [] icon="chrome-close" paddingX=[14] paddingY=[9] rounded=[0]
        bgHover=[props.closeHoverColor] bgActive=[props.closeActiveColor]
        textColor=[props.textColor] focusRing=[0] @click=closeWindow {}
}
