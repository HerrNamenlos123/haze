
from codicons import CodiconComponent

@props
color: str = "#292929";
textColor: str = "#FFF";
showCloseButton: bool = true;
showMinimizeButton: bool = true;
showMaximizeButton: bool = true;
title: str = "";

@slot
leftContent: {
    title: str;
};
centerContent: {
    title: str;
};
rightContent: {
    title: str;
};

@setup

@template [relative w-grow h-fit bg-["#3C3C3C"] items-center]

slot leftContent title=[props.title]

div [w-grow] {}

div [absolute] {
    slot centerContent title=[props.title] {
        text [no-wrap text-color-[props.textColor]] [props.title]
    }
}

slot rightContent title=[props.title]

Button [] label="Button" {}

Codicon [] icon="window-closes" {}

