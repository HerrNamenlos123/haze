        {
          "include": "#declaration-modifiers"
        },
        {
          "name": "storage.modifier.haze",
          "match": "(?<![_[:alnum:]])(?:(?<!\\.)\\b)(mut|const)\\b"
        },
        {
          "begin": "(?<![_[:alnum:]])(?:(?<!\\.)\\b)(fn)\\b",
          "beginCaptures": {
            "1": {
              "name": "storage.type.function.haze"
            }
          },
          "end": "(?<=\\})|(?=;)|(?<=\\S)(?=\\s*$)",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "name": "storage.modifier.haze",
              "match": "(?<![_[:alnum:]])(?:(?<!\\.)\\b)comptime\\b"
            },
            {
              "include": "#function-name"
            },
            {
              "include": "#type-parameters"
            },
            {
              "include": "#function-parameters"
            },
            {
              "include": "#function-return-type"
            },
            {
              "include": "#requires-block"
            },
            {
              "include": "#function-body"
            }
          ]
        }
      ]
    },
    "method-declaration": {
      "name": "meta.method.declaration.haze",
      "begin": "(?x)\n(?<![_[:alnum:]])(?:(?<!\\.)\\b)\n(?=\n  (?:(?:static|mut|const)\\s+)*\n  fn\\b\n)",
      "end": "(?<=\\})|(?=;)|(?<=\\S)(?=\\s*$)",
      "patterns": [
        {
          "include": "#function-declaration"
        }
      ]
    },
    "function-name": {
      "patterns": [
        {
          "name": "meta.definition.function.haze entity.name.function.operator.haze",
          "match": "(?x)\noperator\\s*(?:\\[\\]|:=|==|!=|<=|>=|<|>|\\+|-|\\*|/|%|=)\n|\noperator\\s+as\\b"
        },
        {
          "name": "meta.definition.function.haze entity.name.function.haze",
          "match": "(?<![_[:alnum:]])[_[:alpha:]][_[:alnum:]]*(?=\\s*(<|\\())"
        },
        {
          "name": "meta.definition.function.haze entity.name.function.haze",
          "match": "(?<![_[:alnum:]])[_[:alpha:]][_[:alnum:]]*"
