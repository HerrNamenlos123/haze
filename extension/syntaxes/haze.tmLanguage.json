      ]
    },
    "function-body": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.haze",
          "match": "=>|->"
        },
        {
          "name": "meta.function.body.haze",
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.block.begin.haze"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.block.end.haze"
            }
          },
          "patterns": [
            {
              "include": "#main-patterns"
            }
          ]
        }
      ]
    },
    "function-return-type": {
      "begin": "(?<=\\))\\s*(:)(?!:)",
      "beginCaptures": {
        "1": {
          "name": "keyword.operator.type.annotation.haze"
        }
      },
      "end": "(?<![:|&])(?=$|^|[{;,)\\]]|=>|->|::)",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#type"
        }
      ]
    },
    "function-parameters": {
      "name": "meta.parameters.haze",
      "begin": "\\(",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.parameters.begin.haze"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.parameters.end.haze"
        }
      },
      "patterns": [
        {
          "include": "#function-parameters-body"
        }
      ]
    },
    "function-parameters-body": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "name": "keyword.operator.rest.haze",
          "match": "\\.\\.\\."
        },
        {
          "include": "#parameter-name"
        },
        {
          "include": "#parameter-type-annotation"
        },
        {
          "include": "#variable-initializer"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "parameter-name": {
      "patterns": [
        {
          "match": "(?x)\n(?:(\\.\\.\\.)\\s*)?\n(?<!=|:)(?<![_[:alnum:]])(?:(?<=\\.\\.\\.)|(?<!\\.))\n(?:(this)|([_[:alpha:]][_[:alnum:]]*))\n(?![_[:alnum:]])\\s*(\\?)?\\s*(?=:)",
          "captures": {
            "1": {
              "name": "keyword.operator.rest.haze"
            },
            "2": {
              "name": "variable.language.this.haze"
            },
            "3": {
              "name": "variable.parameter.haze"
            },
            "4": {
              "name": "keyword.operator.optional.haze"
            }
          }
        },
        {
          "match": "(?x)\n(?:(\\.\\.\\.)\\s*)?\n(?<!=|:)(?<![_[:alnum:]])(?:(?<=\\.\\.\\.)|(?<!\\.))\n(?:(this)|([_[:alpha:]][_[:alnum:]]*))\n(?![_[:alnum:]])\\s*(\\?)?\\s*(?=[,)=]|$)",
          "captures": {
            "1": {
              "name": "keyword.operator.rest.haze"
            },
            "2": {
              "name": "variable.language.this.haze"
            },
            "3": {
              "name": "variable.parameter.haze"
            },
            "4": {
              "name": "keyword.operator.optional.haze"
            }
          }
        }
      ]
    },
    "parameter-type-annotation": {
      "begin": "(:)",
      "beginCaptures": {
        "1": {
          "name": "keyword.operator.type.annotation.haze"
        }
      },
      "end": "(?<![:|&])(?=[,)]|(=(?!>))|$)",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#type"
        }
      ]
    },
    "lambda-declaration": {
      "name": "meta.lambda.haze",
      "begin": "(?x)\n(?=\n  \\(\n  (?:[^()]|\\((?:[^()]|\\([^()]*\\))*\\))*\n  \\)\n  \\s*(?::\\s*(?:[^;{}()=]|\\((?:[^()]|\\([^()]*\\))*\\))*)?\n  \\s*(?:::[^;{}]*)?\n  \\s*(?:=>|->)\n)",
      "end": "(?<=\\})|(?<==>|->)",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#function-parameters"
        },
        {
          "include": "#function-return-type"
        },
        {
          "include": "#requires-block"
        },
        {
          "include": "#function-body"
        }
      ]
    },
    "variable-declaration": {
      "name": "meta.variable.declaration.haze",
      "begin": "(?x)\n(?<![_[:alnum:]])(?:(?<!\\.)\\b)\n(?:(export)\\s+)?\n(?:(extern)\\s+(?:([_[:alpha:]][_[:alnum:]]*)\\s+)?)?\n(?:(pub)\\s+)?\n(let|const)\\s+\n(?:(stackref|comptime)\\s+)?\n([_[:alpha:]][_[:alnum:]]*)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.export.haze"
        },
        "2": {
          "name": "storage.modifier.haze"
        },
        "3": {
          "name": "storage.modifier.haze"
        },
        "4": {
          "name": "storage.modifier.haze"
        },
        "5": {
          "name": "storage.type.haze"
        },
        "6": {
          "name": "storage.modifier.haze"
