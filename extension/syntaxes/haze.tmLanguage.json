{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "haze",
  "scopeName": "source.hz",
  "patterns": [
    {
      "include": "#main-patterns"
    }
  ],
  "repository": {
    "main-patterns": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#directives"
        },
        {
          "include": "#import-statement"
        },
        {
          "include": "#meta-annotation"
        },
        {
          "include": "#namespace-declaration"
        },
        {
          "include": "#struct-declaration"
        },
        {
          "include": "#enum-declaration"
        },
        {
          "include": "#type-alias-declaration"
        },
        {
          "include": "#function-declaration"
        },
        {
          "include": "#method-declaration"
        },
        {
          "include": "#variable-declaration"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "expression": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#string"
        },
        {
          "include": "#cast-expression"
        },
        {
          "include": "#requires-block"
        },
        {
          "include": "#control-keywords"
        },
        {
          "include": "#storage-keywords"
        },
        {
          "include": "#expression-operator-keywords"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#literal-numbers"
        },
        {
          "include": "#primitive-types"
        },
        {
          "include": "#lambda-declaration"
        },
        {
          "include": "#struct-literal"
        },
        {
          "include": "#function-call"
        },
        {
          "include": "#object-identifiers"
        },
        {
          "include": "#variables"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation-accessor"
        },
        {
          "include": "#punctuation"
        },
        {
          "include": "#paren-expression"
        },
        {
          "include": "#bracket-expression"
        },
        {
          "include": "#block"
        }
      ]
    },
    "block": {
      "name": "meta.block.haze",
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.block.begin.haze"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.end.haze"
        }
      },
      "patterns": [
        {
          "include": "#main-patterns"
        }
      ]
    },
    "paren-expression": {
      "begin": "\\(",
      "beginCaptures": {
        "0": {
          "name": "meta.brace.round.haze"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "meta.brace.round.haze"
        }
      },
      "patterns": [
        {
          "include": "#expression"
        }
      ]
    },
    "bracket-expression": {
      "begin": "\\[",
      "beginCaptures": {
        "0": {
          "name": "meta.brace.square.haze"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "meta.brace.square.haze"
        }
      },
      "patterns": [
        {
          "include": "#expression"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.haze",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.haze"
            }
          },
          "end": "(?=$)"
        },
        {
          "name": "comment.block.haze",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.haze"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.haze"
            }
          }
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "match": "(#source)\\s*(?=\")",
          "captures": {
            "1": {
              "name": "keyword.control.directive.haze"
            }
          }
        },
        {
          "match": "(#compile|#link)\\s*(?=\")",
          "captures": {
            "1": {
              "name": "keyword.control.directive.haze"
            }
          }
        },
        {
          "name": "keyword.other.inline-c.haze",
          "match": "\\b__c__\\b"
        }
      ]
    },
    "import-statement": {
      "patterns": [
        {
          "begin": "(?<![_[:alnum:]])(?:(?<!\\.)\\b)(from)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.import.haze"
            }
          },
          "end": "(?=;)|(?<=\\S)(?=\\s*$)",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#string"
            },
            {
              "name": "keyword.control.import.haze",
              "match": "(?<![_[:alnum:]])(?:(?<!\\.)\\b)import\\b"
            },
            {
              "name": "keyword.control.as.haze",
              "match": "(?<![_[:alnum:]])(?:(?<!\\.)\\b)as\\b"
            },
            {
              "name": "variable.other.readwrite.alias.haze",
              "match": "[_[:alpha:]][_[:alnum:]]*"
            },
            {
              "include": "#punctuation"
            }
          ]
        },
        {
          "begin": "(?<![_[:alnum:]])(?:(?<!\\.)\\b)(import)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.import.haze"
            }
          },
          "end": "(?=;)|(?<=\\S)(?=\\s*$)",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#string"
            },
            {
              "name": "keyword.control.as.haze",
              "match": "(?<![_[:alnum:]])(?:(?<!\\.)\\b)as\\b"
            },
            {
              "name": "variable.other.readwrite.alias.haze",
              "match": "[_[:alpha:]][_[:alnum:]]*"
            },
            {
              "include": "#punctuation"
            }
          ]
        }
      ]
    },
    "meta-annotation": {
      "name": "meta.annotation.haze",
      "begin": "\\[\\[",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.annotation.begin.haze"
        }
      },
      "end": "\\]\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.annotation.end.haze"
        }
      },
      "patterns": [
        {
          "include": "#string"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#literal-numbers"
        },
        {
          "match": "([_[:alpha:]][_[:alnum:]]*)",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.haze"
            }
          }
        },
        {
          "name": "keyword.operator.assignment.haze",
          "match": "="
        },
        {
          "include": "#punctuation-accessor"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "namespace-declaration": {
      "begin": "(?<![_[:alnum:]])(?:(?<!\\.)\\b)(?:(export)\\s+)?(namespace|module_namespace)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.export.haze"
        },
        "2": {
          "name": "keyword.other.namespace.haze"
        }
      },
      "end": "(?=\\{)|(?=;)|(?<=\\})",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#string"
        },
        {
          "name": "entity.name.namespace.haze",
          "match": "[_[:alpha:]][_[:alnum:]]*"
        },
        {
          "include": "#punctuation-accessor"
        }
      ]
    },
    "declaration-modifiers": {
      "patterns": [
        {
          "name": "keyword.control.export.haze",
          "match": "(?<![_[:alnum:]])(?:(?<!\\.)\\b)export\\b"
        },
        {
          "name": "storage.modifier.haze",
          "match": "(?<![_[:alnum:]])(?:(?<!\\.)\\b)(extern|pub|noemit|opaque|plain|ref|nocopy|static|comptime|nodiscard|clonable|nonclonable|bitflag|unscoped)\\b"
        }
      ]
    },
    "struct-declaration": {
      "name": "meta.struct.declaration.haze",
      "begin": "(?x)\n(?<![_[:alnum:]])(?:(?<!\\.)\\b)\n(?=\n  (?:(?:export|extern|pub|noemit|opaque|plain|ref|nocopy)\\s+(?:[_[:alpha:]][_[:alnum:]]*\\s+)?)*\n  struct\\b\n)",
      "end": "(?<=\\})|(?=;)",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#declaration-modifiers"
        },
        {
          "begin": "(?<![_[:alnum:]])(?:(?<!\\.)\\b)(struct)\\b",
          "beginCaptures": {
            "1": {
              "name": "storage.type.struct.haze"
            }
          },
          "end": "(?<=\\})|(?=;)",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "name": "meta.definition.struct.haze entity.name.type.struct.haze",
              "match": "(?<![_[:alnum:]])[_[:alpha:]][_[:alnum:]]*(?=\\s*(<|::|\\{|$))"
            },
            {
              "include": "#type-parameters"
            },
            {
              "include": "#requires-block"
            },
            {
              "include": "#struct-body"
            }
          ]
        }
      ]
    },
    "struct-body": {
      "name": "meta.struct.body.haze",
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.block.begin.haze"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.end.haze"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#directives"
        },
        {
          "include": "#meta-annotation"
        },
        {
          "include": "#struct-declaration"
        },
        {
          "include": "#enum-declaration"
        },
        {
          "include": "#type-alias-declaration"
        },
        {
          "include": "#method-declaration"
        },
        {
          "include": "#struct-member"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "struct-member": {
      "begin": "(?x)\n(?<![_[:alnum:]])(?:(?<!\\.)\\b)\n(?:(let|const|mut)\\s+)?\n([_[:alpha:]][_[:alnum:]]*)\\s*\n(\\?)?\\s*(:)",
      "beginCaptures": {
        "1": {
          "name": "storage.modifier.haze"
        },
        "2": {
          "name": "variable.other.property.haze"
        },
        "3": {
          "name": "keyword.operator.optional.haze"
        },
        "4": {
          "name": "keyword.operator.type.annotation.haze"
        }
      },
      "end": "(?=;)|(?=\\})|(?<=\\S)(?=\\s*$)",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#variable-initializer"
        },
        {
          "include": "#type"
        }
      ]
    },
    "enum-declaration": {
      "name": "meta.enum.declaration.haze",
      "begin": "(?x)\n(?<![_[:alnum:]])(?:(?<!\\.)\\b)\n(?=\n  (?:(?:export|extern|pub|noemit)\\s+(?:[_[:alpha:]][_[:alnum:]]*\\s+)?)*\n  enum\\b\n)",
      "end": "(?<=\\})|(?=;)",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#declaration-modifiers"
        },
        {
          "begin": "(?<![_[:alnum:]])(?:(?<!\\.)\\b)(enum)\\b",
          "beginCaptures": {
            "1": {
              "name": "storage.type.enum.haze"
            }
          },
          "end": "(?<=\\})|(?=;)",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "name": "storage.modifier.haze",
              "match": "(?<![_[:alnum:]])(?:(?<!\\.)\\b)(bitflag|unscoped)\\b"
            },
            {
              "name": "meta.definition.enum.haze entity.name.type.enum.haze",
              "match": "(?<![_[:alnum:]])[_[:alpha:]][_[:alnum:]]*(?=\\s*(::|\\{|$))"
            },
            {
              "include": "#requires-block"
            },
            {
              "name": "meta.enum.body.haze",
              "begin": "\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.block.begin.haze"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.block.end.haze"
                }
              },
              "patterns": [
                {
                  "include": "#comments"
                },
                {
                  "match": "(?<![_[:alnum:]])([_[:alpha:]][_[:alnum:]]*)\\s*(?=,|=|\\}|$)",
                  "captures": {
                    "1": {
                      "name": "variable.other.enummember.haze"
                    }
                  }
                },
                {
                  "include": "#variable-initializer"
                },
                {
                  "include": "#punctuation"
                }
              ]
            }
          ]
        }
      ]
    },
    "type-alias-declaration": {
      "name": "meta.type.declaration.haze",
      "begin": "(?x)\n(?<![_[:alnum:]])(?:(?<!\\.)\\b)\n(?:(export)\\s+)?\n(?:(extern)\\s+(?:([_[:alpha:]][_[:alnum:]]*)\\s+)?)?\n(?:(pub)\\s+)?\n(type)\\s+\n([_[:alpha:]][_[:alnum:]]*)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.export.haze"
        },
        "2": {
          "name": "storage.modifier.haze"
        },
        "3": {
          "name": "storage.modifier.haze"
        },
        "4": {
          "name": "storage.modifier.haze"
        },
        "5": {
          "name": "storage.type.type.haze"
        },
        "6": {
          "name": "meta.definition.type.haze entity.name.type.alias.haze"
        }
      },
      "end": "(?=;)|(?<=\\S)(?=\\s*$)",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#type-parameters"
        },
        {
          "begin": "(=)",
          "beginCaptures": {
            "1": {
              "name": "keyword.operator.assignment.haze"
            }
          },
          "end": "(?=;)|(?<=\\S)(?=\\s*$)",
          "patterns": [
            {
              "include": "#type"
            }
          ]
        }
      ]
    },
    "function-declaration": {
      "name": "meta.function.declaration.haze",
      "begin": "(?x)\n(?<![_[:alnum:]])(?:(?<!\\.)\\b)\n(?=\n  (?:(?:export|extern|pub|noemit|static|ref|stackref|mut|const)\\s+(?:[_[:alpha:]][_[:alnum:]]*\\s+)?)*\n  fn\\b\n)",
      "end": "(?<=\\})|(?=;)|(?<=\\S)(?=\\s*$)",
      "patterns": [
        {
          "include": "#comments"
