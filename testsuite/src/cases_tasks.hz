// ============================================================================
// Tasks and the scheduler (stage 3 of docs/async-implementation-plan.md;
// docs/async-runtime.md sections 2, 5, 7 to 9).
//
// Every piece of Haze code runs in a task, `main` too. A spawned task joins
// the ready queue and starts when its spawner suspends (C384); ready tasks
// run first come first served (C246). A thread ends when no task that keeps
// it alive is left (C236); background tasks are then killed, never resumed
// (C435, C437), and their futures report it (C438, C561).
// ============================================================================

namespace cases_tasks {

    export fn register(s: mut testsuite.Suite) {
        s.run(
            "tasks: a spawned task starts only when its spawner suspends",
            """
fn main(): int {
    let log: mut []str = [];
    let a = task.spawn(() => {
        log.push("a");
        return 1;
    });
    log.push("spawned");
    log.push("still main");
    let r = a.join();
    log.push("joined");
    let v = 0;
    if r is int { v = r; }
    fmt.println(f"{log[0]} {log[1]} {log[2]} {log[3]} {v}");
    return 0;
}
""",
            "spawned still main a joined 1");

        // Ties: tasks that became ready by the same event run in the order
        // they started waiting; yielding puts a task behind every ready one.
        s.run(
            "tasks: ready tasks run in the order they became ready",
            """
fn main(): int {
    let log: mut []str = [];
    let gate = Future<int>();
    let names: []str = ["x", "y", "z"];
    let waiters: mut []Future<none> = [];
    for name in names {
        let n = name;
        waiters.push(task.spawn(() => {
            let g = gate.join();
            log.push(n);
            sys.yield();
            log.push(n + "2");
        }));
    }
    let opener = task.spawn(() => {
        log.push("open");
        gate.complete(5);
        log.push("opened");
    });
    for w in waiters { let r = w.join(); }
    let o = opener.join();
    let line = "";
    for entry in log { line = line + entry + " "; }
    fmt.println(line);
    return 0;
}
""",
            "open opened x y z x2 y2 z2 ");

        s.run(
            "tasks: join gives the value, isDone tells whether it is there",
            """
fn main(): int {
    let f = task.spawn(() => { return "text"; });
    let before = f.isDone();
    let r = f.join();
    let after = f.isDone();
    let made = Future<int>();
    let madeBefore = made.isDone();
    made.complete(7);
    let m = made.join();
    let t = "";
    if r is str { t = r; }
    let mv = 0;
    if m is int { mv = m; }
    fmt.println(f"{before} {t} {after} {madeBefore} {mv} {made.isDone()}");
    return 0;
}
""",
            "false text true false 7 true");

        s.run(
            "tasks: a future made by code wakes every task joining it",
            """
fn main(): int {
    let shared = Future<int>();
    let a = task.spawn(() => {
        let r = shared.join();
        if r is int { return r + 1; }
        return 0;
    });
    let b = task.spawn(() => {
        let r = shared.join();
        if r is int { return r + 2; }
        return 0;
    });
    sys.yield();
    let early = a.isDone() || b.isDone();
    shared.complete(10);
    let ra = a.join();
    let rb = b.join();
    let sum = 0;
    if ra is int { sum += ra; }
    if rb is int { sum += rb; }
    fmt.println(f"{early} {sum}");
    return 0;
}
""",
            "false 23");

        s.run(
            "tasks: a recovered second complete keeps the first value",
            """
fn main(): int {
    let f = Future<int>();
    f.complete(1);
    let again = attempt { f.complete(2); 0 } recover e { 1 };
    let r = f.join();
    let v = 0;
    if r is int { v = r; }
    fmt.println(f"{again} {v}");
    return 0;
}
""",
            "1 1");

        // C444: in a child process, since the panic ends it.
        s.run(
            "tasks: completing a future twice panics",
            """
fn main(): int {
    let args = sys.args();
    if args.length > 1 && args[1] == "child" {
        let f = Future<int>();
        f.complete(1);
        f.complete(2);
        fmt.println("not reached");
        return 0;
    }
    let r = process.runCaptured(args[0], ["child"]);
    fmt.println(f"{r.exitCode} {r.stderrResult.contains("completed twice")} {r.stdoutResult.length}");
    return 0;
}
""",
            "255 true 0");

        // C406, C285, TL-6: a new task starts with a copy of its creator's
        // context and task-local values, taken when it is spawned.
        s.run(
            "tasks: a new task copies its creator's context and task-local values",
            """
tasklocal let counter: int = 1;
tasklocal let untouched: int = 50;
fn held(): int {
    let v = sys.userBoxValue<int>(context.userBox1);
    if v is int { return v; }
    return 0;
}
fn setHeld(n: int) {
    context.userBox1 = sys.makeUserBox(n);
}
fn main(): int {
    counter = 7;
    setHeld(3);
    let child = task.spawn(() => {
        let seen = f"{counter} {held()} {untouched}";
        counter = 100;
        setHeld(4);
        return seen;
    });
    counter = 8;
    setHeld(5);
    let r = child.join();
    let seen = "";
    if r is str { seen = r; }
    fmt.println(f"{seen} | {counter} {held()}");
    return 0;
}
""",
            "7 3 50 | 8 5");

        // C536: every task's stack is scanned while it is suspended, and the
        // running one's while it runs.
        s.run(
            "tasks: thousands of suspended tasks keep their objects through collections",
            """
ref struct Cell { v: int = 0; next: Cell | none = none; }
fn chain(n: int, base: int): Cell {
    let head = Cell { v: base };
    let cur = head;
    for (let i = 1; i < n; i++) {
        let c = Cell { v: base + i };
        cur.next = c;
        cur = c;
    }
    return head;
}
fn sumChain(c: Cell): int {
    let s = 0;
    let cur: Cell | none = c;
    while cur is Cell {
        s += cur.v;
        cur = cur.next;
    }
    return s;
}
fn main(): int {
    let futures: mut []Future<int> = [];
    for (let i = 0; i < 3000; i++) {
        let k = i;
        futures.push(task.spawn(() => {
            let c = chain(10, k);
            sys.yield();
            if k % 300 == 0 { sys.forceGc(); }
            let garbage = chain(30, 0);
            sys.yield();
            return sumChain(c) - 10 * k - 45;
        }));
    }
    let wrong = 0;
    for f in futures {
        let r = f.join();
        if r is int { if r != 0 { wrong++; } } else { wrong++; }
    }
    fmt.println(f"{futures.length} {wrong}");
    return 0;
}
""",
            "3000 0");

        // C383: a guard hit is reported as a stack overflow and recovered in
        // the task, which goes on running.
        s.run(
            "tasks: a stack overflow in a task is recovered there",
            """
fn deep(n: int): int :: final {
    if n == 0 { return 0; }
    let pad: [4]int = [n, n, n, n];
    return deep(n - 1) + pad[n % 4] - n + 1;
}
fn main(): int {
    let f = task.spawn(() => {
        let message = "";
        let r = attempt { deep(1000000000) } recover e {
            message = e.message;
            -1
        };
        // Once more in the same task: the recovery re-armed its guard
        // (Windows: the first overflow used it up).
        let second = attempt { deep(1000000000) } recover e { -3 };
        return f"{r} {message.contains("Stack overflow")} {deep(1000)} {second}";
    });
    // A newer task: the guard checked is the running task's, not the newest.
    let newer = task.spawn(() => { return 0; });
    let r = f.join();
    let n = newer.join();
    if r is str { fmt.println(r); }
    let again = attempt { deep(1000000000) } recover e { -2 };
    fmt.println(f"{again}");
    return 0;
}
""",
            "-1 true 1000 -3\n-2");

        s.run(
            "tasks: an uncaught stack overflow ends the program with a stack trace",
            """
fn deep(n: int): int :: final {
    if n == 0 { return 0; }
    let pad: [4]int = [n, n, n, n];
    return deep(n - 1) + pad[n % 4] - n + 1;
}
fn main(): int {
    let args = sys.args();
    if args.length > 1 && args[1] == "child" {
        fmt.println(f"{deep(1000000000)}");
        return 0;
    }
    let r = process.runCaptured(args[0], ["child"]);
    fmt.println(f"{r.exitCode} {r.stderrResult.contains("Stack overflow")} {r.stderrResult.contains("deep")} {r.stdoutResult.length}");
    return 0;
}
""",
            "255 true true 0");

        // C236, C435, C437: main returns, the background task is still
        // suspended; it is killed and never runs again, and the program ends
        // with main's status.
        s.runExitCode(
            "tasks: a background task does not keep its thread alive",
            """
fn main(): int {
    let bg = task.spawn(() => {
        fmt.println("bg started");
        let forever = Future<int>();
        let r = forever.join();
        fmt.println("bg resumed");
        return 0;
    }, { background: true });
    sys.yield();
    fmt.println("main returns");
    return 3;
}
""",
            3);

        // A killed task leaves the waiters of the future it joined: killing
        // the task it waits for later must not wake it (the runtime checks
        // that every waiter it wakes still waits).
        s.run(
            "tasks: background tasks waiting for each other are all killed",
            """
fn main(): int {
    let gate = Future<int>();
    let target = task.spawn(() => {
        let r = gate.join();
        return 1;
    }, { background: true });
    let waiter = task.spawn(() => {
        let r = target.join();
        fmt.println("waiter resumed");
        return 2;
    }, { background: true });
    sys.yield();
    fmt.println(f"{target.isDone()} {waiter.isDone()}");
    return 0;
}
""",
            "false false");

        // C216: the scheduler between tasks runs no Haze code, so C asking
        // for a context there (here: at exit, after the last task) fails
        // loudly.
        s.run(
            "tasks: a context made from C while no task runs panics",
            """
__c__("#include <stdlib.h>\nstatic void at_exit(void) { hzstd_context_t c = hzstd_context_for_current_thread(); (void)c; }");
fn main(): int {
    let args = sys.args();
    if args.length > 1 && args[1] == "child" {
        do unsafe { __c__("atexit(at_exit);"); };
        return 0;
    }
    let r = process.runCaptured(args[0], ["child"]);
    fmt.println(f"{r.exitCode} {r.stderrResult.contains("runs no task")}");
    return 0;
}
""",
            "255 true");

        s.run(
            "tasks: a background task is killed at thread end, not resumed",
            """
fn main(): int {
    let bg = task.spawn(() => {
        fmt.println("bg started");
        let forever = Future<int>();
        let r = forever.join();
        fmt.println("bg resumed");
        return 0;
    }, { background: true });
    let worker = task.spawn(() => {
        for (let i = 0; i < 3; i++) { sys.yield(); }
        fmt.println("worker done");
    });
    fmt.println("main returns");
    return 0;
}
""",
            "main returns\nbg started\nworker done");

        // C438, C561: the futures of killed tasks, joined after the thread
        // ended (from C, at exit, under a stand-in task: joining a settled
        // future never suspends). Threads (stage 5) will join them for real.
        s.run(
            "tasks: joining a killed task gives Killed, one that never ran NeverRan",
            """
__c__("#include <stdlib.h>\nhzstd_none_t report(hzstd_context_t *ctx, void *killed, void *never_ran);\nstatic hzstd_thread_t *report_thread;\nstatic void *report_killed;\nstatic void *report_never_ran;\nstatic void at_exit(void) { hzstd_context_t c = { 0 }; hzstd_task_t t = { 0 }; t.thread = report_thread; c.task = &t; c.thread = report_thread; c.settings = hzstd_context_settings_default(); report(&c, report_killed, report_never_ran); }");
fn describe(r: Result<int, TaskError>): str {
    if r is int { return f"value {r}"; }
    if r is TaskError {
        if r == TaskError.Killed { return "Killed"; }
        return "NeverRan";
    }
    return "?";
}
fn asFuture(p: cptr): Future<int> {
    return do unsafe {
        let f: Future<int> = uninitialized;
        __c__("f = p;");
        f
    };
}
extern C fn report(killed: cptr, neverRan: cptr) {
    let k = asFuture(killed);
    let n = asFuture(neverRan);
    fmt.println(f"{describe(k.join())} {describe(n.join())} {k.isDone()}");
}
fn main(): int {
    let p = sys.contextPtr();
    let killed = task.spawn(() => {
        let forever = Future<int>();
        let r = forever.join();
        return 1;
    }, { background: true });
    sys.yield();
    let neverRan = task.spawn(() => { return 2; }, { background: true });
    // Static C memory is scanned by the collector: the futures stay alive.
    do unsafe { __c__("report_thread = ((hzstd_context_t *)p)->thread; report_killed = (void *)killed; report_never_ran = (void *)neverRan; atexit(at_exit);"); };
    return 0;
}
""",
            "Killed NeverRan true");

        // Every task that keeps the thread alive waits for something that can
        // never happen: a loud failure, not a hang.
        s.run(
            "tasks: a deadlock ends the program with an error",
            """
fn main(): int {
    let args = sys.args();
    if args.length > 1 && args[1] == "child" {
        let never = Future<int>();
        let r = never.join();
        fmt.println("not reached");
        return 0;
    }
    let r = process.runCaptured(args[0], ["child"]);
    fmt.println(f"{r.exitCode} {r.stderrResult.contains("deadlock")} {r.stdoutResult.length}");
    return 0;
}
""",
            "255 true 0");

        // C242: more than 10 ms of a task's own CPU time without a switch
        // warns, on stderr, naming the thread; runs below never do. The
        // watchdog measures every 5 ms, so the runs here stay well clear of
        // the limit on either side: the short ones on the wall clock (their
        // CPU time is never more), the others until the watchdog measured
        // them.
        s.run(
            "tasks: the stall warning fires when a task runs more than 10 ms without yielding",
            """
fn spin(seconds: real): int {
    let start = time.now();
    let n = 0;
    while time.now() - start < seconds { n++; }
    return n;
}
// Runs until the watchdog has measured `seconds` of this run (its own CPU
// time, what a stall is judged by), whatever the machine's load: a loop on
// the wall clock gets less CPU time than it lasts on a busy machine. The
// wall clock only bounds a watchdog that never measures.
fn spinMeasured(seconds: real): int {
    let start = time.now();
    let n = 0;
    while sys.timeSinceTaskSwitch() < seconds && time.now() - start < 10.0 { n++; }
    return n;
}
fn main(): int {
    let args = sys.args();
    if args.length > 1 && args[1] == "long" {
        let n = spinMeasured(0.1);
        return 0;
    }
    if args.length > 1 && args[1] == "medium" {
        let n = spinMeasured(0.03);
        return 0;
    }
    if args.length > 1 && args[1] == "short" {
        for (let i = 0; i < 30; i++) {
            let n = spin(0.002);
            sys.yield();
        }
        return 0;
    }
    let longRun = process.runCaptured(args[0], ["long"]);
    let shortRuns = process.runCaptured(args[0], ["short"]);
    let mediumRun = process.runCaptured(args[0], ["medium"]);
    let traced = longRun.stderrResult.contains("It is currently at:") && longRun.stderrResult.contains("spin");
    // Reported again at each doubling while it still runs.
    let again = longRun.stderrResult.contains("has now run");
    fmt.println(f"{longRun.stderrResult.contains("without yielding (thread: main)")} {traced} {again} {mediumRun.stderrResult.contains("without yielding")} {shortRuns.stderrResult.contains("without yielding")} {longRun.exitCode} {shortRuns.exitCode}");
    return 0;
}
""",
            "true true true true false 0 0");

        // Section 10: a stall's trace is printed once per place (the stack
        // from the innermost function of the program or a library outwards);
        // a stall at a place seen before is one line naming it, a different
        // place gets its trace. Each loop runs until the watchdog measured
        // it (see spinMeasured in the case above) and looks at that measure
        // every step, so the watchdog catches it inside
        // sys.timeSinceTaskSwitch(), the runtime or the system as often as
        // in its own code: all of it is the same place.
        s.run(
            "tasks: a stall trace is printed once per place, a repeat names it",
            """
fn spinA(seconds: real): int {
    let start = time.now();
    let n = 0;
    while sys.timeSinceTaskSwitch() < seconds && time.now() - start < 10.0 { n++; }
    return n;
}
fn spinB(seconds: real): int {
    let start = time.now();
    let n = 0;
    while sys.timeSinceTaskSwitch() < seconds && time.now() - start < 10.0 { n++; }
    return n;
}
fn main(): int {
    let args = sys.args();
    if args.length > 1 && args[1] == "child" {
        for (let i = 0; i < 2; i++) {
            let n = spinA(0.03);
            sys.yield();
        }
        let m = spinB(0.03);
        return 0;
    }
    let r = process.runCaptured(args[0], ["child"]);
    let e = r.stderrResult;
    let reports = e.split("It is currently at:").length - 1;
    let repeat = e.contains("again in spinA() (its stack trace was printed before)");
    fmt.println(f"{r.exitCode} {reports} {e.contains("spinA")} {e.contains("spinB")} {repeat}");
    return 0;
}
""",
            "0 2 true true true");

        // The watchdog allocates no GC memory, also not to print a stall
        // trace: a stall inside a profiled window adds nothing to the
        // program's allocations (the profiler's hook sees every thread).
        s.run(
            "tasks: a stall report allocates nothing the program's profiler counts",
            """
fn spin(seconds: real): int {
    let start = time.now();
    let n = 0;
    while time.now() - start < seconds { n++; }
    return n;
}
// Runs until the watchdog has measured `seconds` of this run (its own CPU
// time, what a stall is judged by), whatever the machine's load: a loop on
// the wall clock gets less CPU time than it lasts on a busy machine. The
// wall clock only bounds a watchdog that never measures.
fn spinMeasured(seconds: real): int {
    let start = time.now();
    let n = 0;
    while sys.timeSinceTaskSwitch() < seconds && time.now() - start < 10.0 { n++; }
    return n;
}
fn main(): int {
    let args = sys.args();
    if args.length > 1 && args[1] == "child" {
        // The same window twice, with and without a stall: what the profiler
        // itself shows of its own allocations is the same in both (it is
        // not the same on every platform).
        let quiet = Profiler({ samplingRate: 0, memoryInstrumentation: true, memoryInstrumentationStacktraces: false });
        let m = spin(0.001);
        let calm = quiet.stop();
        sys.yield();
        let p = Profiler({ samplingRate: 0, memoryInstrumentation: true, memoryInstrumentationStacktraces: false });
        let n = spinMeasured(0.06);
        let r = p.stop();
        // The profiler reports on stdout: the difference goes out as the status.
        return r.memoryInstrumentationFrames.length - calm.memoryInstrumentationFrames.length;
    }
    let r = process.runCaptured(args[0], ["child"]);
    fmt.println(f"{r.exitCode} {r.stderrResult.contains("It is currently at:")}");
    return 0;
}
""",
            "0 true");

        // C521, C576: once a graceful exit started, its status is final: a
        // failure after it (here in an exit handler, where no task runs) is
        // printed and ends the program with that status, not 255.
        s.run(
            "tasks: a panic after sys.exit started keeps the exit status",
            """
__c__("#include <stdlib.h>\nstatic void at_exit(void) { hzstd_context_t c = hzstd_context_for_current_thread(); (void)c; }");
fn main(): int {
    let args = sys.args();
    if args.length > 1 && args[1] == "child" {
        do unsafe { __c__("atexit(at_exit);"); };
        sys.exit(3);
    }
    let r = process.runCaptured(args[0], ["child"]);
    fmt.println(f"{r.exitCode} {r.stderrResult.contains("runs no task")}");
    return 0;
}
""",
            "3 true");

        // C588, C590: the loop calls only yieldAfter, and the other task
        // still gets its turns, each after about 20 ms of the loop's time.
        s.run(
            "tasks: sys.yieldAfter yields once the task has run longer than asked",
            """
fn main(): int {
    let turns: mut []int = [];
    let other = task.spawn(() => {
        while turns.length < 3 {
            turns.push(1);
            sys.yield();
        }
    });
    let longest = 0.0;
    let iterations = 0;
    while turns.length < 3 && iterations < 2000000000 {
        iterations++;
        let t = sys.timeSinceTaskSwitch();
        if t > longest { longest = t; }
        sys.yieldAfter(0.02);
    }
    let r = other.join();
    fmt.println(f"{turns.length} {longest >= 0.015} {longest < 0.2}");
    return 0;
}
""",
            "3 true true");

        // A switch starts the measurement over: right after it the task has
        // run for no time, whatever the task before it ran (the watchdog's
        // next look comes up to 5 ms later).
        s.run(
            "tasks: the time since the last switch starts over at every switch",
            """
fn main(): int {
    let other = task.spawn(() => { return 0; });
    let iterations = 0;
    while sys.timeSinceTaskSwitch() < 0.015 && iterations < 2000000000 { iterations++; }
    let before = sys.timeSinceTaskSwitch();
    sys.yield();
    let after = sys.timeSinceTaskSwitch();
    fmt.println(f"{before >= 0.015} {after < 0.005}");
    return 0;
}
""",
            "true true");

        // C301: time.sleep suspends the calling task only; the others run,
        // and the sleeps end in the order of their deadlines.
        s.run(
            "tasks: time.sleep suspends only the calling task",
            """
fn main(): int {
    let log: mut []str = [];
    let start = time.now();
    let slow = task.spawn(() => { time.sleep(0.05); log.push("slow"); return 0; });
    let fast = task.spawn(() => { time.sleep(0.01); log.push("fast"); return 0; });
    let counter = task.spawn(() => {
        let n = 0;
        while !slow.isDone() { n++; sys.yield(); }
        return n;
    });
    let a = slow.join();
    let b = fast.join();
    let c = counter.join();
    let elapsed = time.now() - start;
    let spins = 0;
    if c is int { spins = c; }
    fmt.println(f"{log[0]} {log[1]} {spins > 10} {elapsed >= 0.045}");
    return 0;
}
""",
            "fast slow true true");

        // The event loop's clock is the one of its last turn: a sleep that
        // follows a long run must still last as long as asked, also while
        // another task keeps the loop turning without waiting.
        s.run(
            "tasks: a sleep after a long run lasts as long as asked",
            """
fn main(): int {
    let done: mut []int = [];
    time.sleep(0.001);
    let spinner = task.spawn(() => {
        while done.length == 0 { sys.yield(); }
    });
    let spinStart = time.now();
    while time.now() - spinStart < 0.06 {}
    let start = time.now();
    time.sleep(0.04);
    let slept = time.now() - start;
    done.push(1);
    let r = spinner.join();
    fmt.println(f"{slept >= 0.035}");
    return 0;
}
""",
            "true");

        s.run(
            "tasks: a sleeping task keeps its thread alive, a sleeping background task does not",
            """
fn main(): int {
    let args = sys.args();
    if args.length > 1 && args[1] == "child" {
        let bg = task.spawn(() => {
            time.sleep(30.0);
            fmt.println("background woke");
        }, { background: true });
        let fg = task.spawn(() => {
            time.sleep(0.02);
            fmt.println("woke");
        });
        return 0;
    }
    let start = time.now();
    let r = process.runCaptured(args[0], ["child"]);
    let took = time.now() - start;
    fmt.println(f"{r.stdoutResult.trim()} {r.exitCode} {took < 10.0}");
    return 0;
}
""",
            "woke 0 true");

        s.run(
            "tasks: time.sleep(0) lets the other ready tasks run first",
            """
fn main(): int {
    let log: mut []str = [];
    let other = task.spawn(() => { log.push("other"); });
    time.sleep(0.0);
    log.push("main");
    let r = other.join();
    fmt.println(f"{log[0]} {log[1]}");
    return 0;
}
""",
            "other main");

        // C521, C574, C585 to C587: sys.exit stops every task at its
        // suspension, none is resumed, and the program ends with the status.
        s.run(
            "tasks: sys.exit ends the program with its status, stopping every task",
            """
fn main(): int {
    let args = sys.args();
    if args.length > 1 && args[1] == "child" {
        let sleeper = task.spawn(() => {
            time.sleep(0.02);
            fmt.println("sleeper woke");
        });
        let waiter = task.spawn(() => {
            let never = Future<int>();
            let r = never.join();
            fmt.println("waiter woke");
        });
        let exiter = task.spawn(() => {
            fmt.println("exiting");
            if args.length > 1 { sys.exit(7); }
            fmt.println("after exit");
        });
        let r = exiter.join();
        fmt.println("main resumed");
        return 0;
    }
    let r = process.runCaptured(args[0], ["child"]);
    fmt.println(f"{r.exitCode} {r.stdoutResult.trim()}");
    return 0;
}
""",
            "7 exiting");

        s.run(
            "tasks: sys.exit with a status outside 0 to 255 panics",
            """
fn main(): int {
    let args = sys.args();
    if args.length > 1 {
        if args[1] == "high" { sys.exit(256); }
        sys.exit(-1);
    }
    let high = process.runCaptured(args[0], ["high"]);
    let low = process.runCaptured(args[0], ["low"]);
    fmt.println(f"{high.exitCode} {high.stderrResult.contains("between 0 and 255")} {low.exitCode}");
    return 0;
}
""",
            "255 true 255");

        s.runExitCode(
            "tasks: sys.exit(0) from main",
            """
fn main(): int {
    sys.exit(0);
    return 9;
}
""",
            0);

        // C547: at once, nothing else runs.
        s.run(
            "tasks: sys.abort ends the program at once",
            """
fn main(): int {
    let args = sys.args();
    if args.length > 1 && args[1] == "child" {
        let other = task.spawn(() => { fmt.println("other ran"); });
        sys.abort();
    }
    let r = process.runCaptured(args[0], ["child"]);
    fmt.println(f"{r.exitCode} {r.stdoutResult.length}");
    return 0;
}
""",
            "134 0");

        // A collection the task's thread runs is not the task's time (section
        // 10), also before the collector reports its end (BDWGC restarts the
        // world first; review 2026-11-20). The collector's event hook is
        // called by hand around a busy stretch, as a collection would.
        s.run(
            "tasks: a collection in progress does not count as the task's run time",
            """
__c__("#include <gc/gc.h>\nstatic void gc_event(int e) { GC_get_on_collection_event()((GC_EventType)e); }");
fn spin(seconds: real): int {
    let start = time.now();
    let n = 0;
    while time.now() - start < seconds { n++; }
    return n;
}
fn main(): int {
    let args = sys.args();
    if args.length > 1 && args[1] == "child" {
        do unsafe { __c__("gc_event(GC_EVENT_START);"); };
        let n = spin(0.06);
        let during = sys.timeSinceTaskSwitch();
        do unsafe { __c__("gc_event(GC_EVENT_END);"); };
        fmt.println(f"{during < 0.01}");
        return 0;
    }
    if args.length > 1 && args[1] == "short" {
        do unsafe { __c__("gc_event(GC_EVENT_START);"); };
        let n = spin(0.002);
        do unsafe { __c__("gc_event(GC_EVENT_END);"); };
        return 0;
    }
    let r = process.runCaptured(args[0], ["child"]);
    let shortGc = process.runCaptured(args[0], ["short"]);
    // A long one is reported as a pause of its own (section 10).
    let pause = r.stderrResult.contains("a garbage collection took");
    fmt.println(f"{r.stdoutResult.trim()} {r.stderrResult.contains("without yielding")} {pause} {shortGc.stderrResult.contains("garbage collection")} {r.exitCode}");
    return 0;
}
""",
            "true false true false 0");

        // A fault while this thread holds the world stopped (here: the stack
        // runs out inside a collection; stack_left counts from where the
        // overflow is reported, on Windows the stack guarantee and the
        // kernel's own pages above the guard) cannot be handed to the panic worker,
        // which is stopped too: it is reported directly and ends the program
        // (review 2026-11-20: it hung, silently). The child's hang guard (a
        // thread the collector does not know, so a stopped world does not
        // stop it) ends a hang with 124.
        s.run(
            "tasks: a stack overflow inside a collection is reported, never a hang",
            """
__c__("#include <gc/gc.h>\n\n#ifdef _WIN32\n#define OVERFLOW_RESERVE (16384 + 2 * 4096)\n#else\n#define OVERFLOW_RESERVE 0\n#endif\nstatic hzstd_int_t stack_left(void) { const fiber_stack *s = hzstd_current_task_stack(); char here; return (hzstd_int_t)(&here - (char *)s->limit) - OVERFLOW_RESERVE; }\n#ifdef _WIN32\n#include <windows.h>\n#undef CreateThread\nstatic DWORD WINAPI hang_guard_main(LPVOID p) { (void)p; Sleep(30000); TerminateProcess(GetCurrentProcess(), 124); return 0; }\nstatic void hang_guard(void) { CloseHandle(CreateThread(NULL, 0, hang_guard_main, NULL, 0, NULL)); }\n#else\n#include <pthread.h>\n#include <unistd.h>\n#undef pthread_create\nstatic void *hang_guard_main(void *p) { (void)p; sleep(30); _exit(124); return NULL; }\nstatic void hang_guard(void) { pthread_t t; pthread_create(&t, NULL, hang_guard_main, NULL); pthread_detach(t); }\n#endif");
fn deep(n: int): int :: final {
    let left = 0;
    do unsafe { __c__("left = stack_left(); if (left < 24000) GC_gcollect();"); };
    let pad: [4]int = [n, n, n, n];
    return deep(n + 1) + pad[n % 4] - n;
}
fn main(): int {
    let args = sys.args();
    if args.length > 1 && args[1] == "child" {
        do unsafe { __c__("hang_guard();"); };
        fmt.println(f"{deep(0)}");
        return 0;
    }
    let r = process.runCaptured(args[0], ["child"]);
    fmt.println(f"{r.exitCode} {r.stderrResult.contains("Stack overflow")}");
    return 0;
}
""",
            "255 true");

        // The same for the whole collection, not only while the world is
        // stopped: the collecting thread holds the collector's lock until
        // the collection's end, and the panic worker's report allocates GC
        // memory (under ASan the overflow above lands after the world
        // restarted, and hung there; 2026-11-20). The collector's event hook
        // is called by hand.
        s.run(
            "tasks: a panic while this thread runs a collection is reported directly",
            """
__c__("#include <gc/gc.h>\nstatic void gc_event(int e) { GC_get_on_collection_event()((GC_EventType)e); }\n#ifdef _WIN32\n#include <windows.h>\n#undef CreateThread\nstatic DWORD WINAPI hang_guard_main(LPVOID p) { (void)p; Sleep(30000); TerminateProcess(GetCurrentProcess(), 124); return 0; }\nstatic void hang_guard(void) { CloseHandle(CreateThread(NULL, 0, hang_guard_main, NULL, 0, NULL)); }\n#else\n#include <pthread.h>\n#include <unistd.h>\n#undef pthread_create\nstatic void *hang_guard_main(void *p) { (void)p; sleep(30); _exit(124); return NULL; }\nstatic void hang_guard(void) { pthread_t t; pthread_create(&t, NULL, hang_guard_main, NULL); pthread_detach(t); }\n#endif");
fn main(): int {
    let args = sys.args();
    if args.length > 1 && args[1] == "child" {
        do unsafe { __c__("hang_guard(); gc_event(GC_EVENT_START);"); };
        sys.panic("boom");
    }
    let r = process.runCaptured(args[0], ["child"]);
    fmt.println(f"{r.exitCode} {r.stderrResult.contains("boom while this thread was running a garbage collection")}");
    return 0;
}
""",
            "255 true");

        // The window opens before the collector's event hook does anything
        // (under ASan the stack ran out inside the hook itself, before it
        // had marked the thread as collecting, and the report then waited
        // for the collector's lock; 2026-11-20). Each level runs the hook,
        // the deepest call, until the stack is gone. That needs a hook that
        // takes more stack than a level of the recursion, which holds on
        // Linux; the hook is shallower on Windows, so the stack runs out in
        // the recursion there (the case below covers both).
        if sys.isLinux() {
            s.run(
                "tasks: a stack overflow inside the collector's event hook is reported directly",
                """
__c__("#include <gc/gc.h>\n\n#ifdef _WIN32\n#define OVERFLOW_RESERVE (16384 + 2 * 4096)\n#else\n#define OVERFLOW_RESERVE 0\n#endif\nstatic hzstd_int_t stack_left(void) { const fiber_stack *s = hzstd_current_task_stack(); char here; return (hzstd_int_t)(&here - (char *)s->limit) - OVERFLOW_RESERVE; }\nstatic void gc_events(void) { GC_on_collection_event_proc p = GC_get_on_collection_event(); p(GC_EVENT_START); p(GC_EVENT_END); }\n#ifdef _WIN32\n#include <windows.h>\n#undef CreateThread\nstatic DWORD WINAPI hang_guard_main(LPVOID p) { (void)p; Sleep(30000); TerminateProcess(GetCurrentProcess(), 124); return 0; }\nstatic void hang_guard(void) { CloseHandle(CreateThread(NULL, 0, hang_guard_main, NULL, 0, NULL)); }\n#else\n#include <pthread.h>\n#include <unistd.h>\n#undef pthread_create\nstatic void *hang_guard_main(void *p) { (void)p; sleep(30); _exit(124); return NULL; }\nstatic void hang_guard(void) { pthread_t t; pthread_create(&t, NULL, hang_guard_main, NULL); pthread_detach(t); }\n#endif");
fn deep(n: int): int :: final {
    let left = 0;
    do unsafe { __c__("left = stack_left(); if (left < 16000) gc_events();"); };
    let pad: [4]int = [n, n, n, n];
    return deep(n + 1) + pad[n % 4] - n;
}
fn main(): int {
    let args = sys.args();
    if args.length > 1 && args[1] == "child" {
        do unsafe { __c__("hang_guard();"); };
        fmt.println(f"{deep(0)}");
        return 0;
    }
    let r = process.runCaptured(args[0], ["child"]);
    fmt.println(f"{r.exitCode} {r.stderrResult.contains("Stack overflow while this thread was running a garbage collection")}");
    return 0;
}
""",
                "255 true");
        }

        // The same window, opened by the hook (a collection's start) and
        // never closed: the stack running out anywhere in it is reported
        // directly, never handed to the stopped panic worker.
        s.run(
            "tasks: a stack overflow while the collection window is open is reported directly",
            """
__c__("#include <gc/gc.h>\nstatic void gc_start(void) { GC_get_on_collection_event()(GC_EVENT_START); }\n#ifdef _WIN32\n#include <windows.h>\n#undef CreateThread\nstatic DWORD WINAPI hang_guard_main(LPVOID p) { (void)p; Sleep(30000); TerminateProcess(GetCurrentProcess(), 124); return 0; }\nstatic void hang_guard(void) { CloseHandle(CreateThread(NULL, 0, hang_guard_main, NULL, 0, NULL)); }\n#else\n#include <pthread.h>\n#include <unistd.h>\n#undef pthread_create\nstatic void *hang_guard_main(void *p) { (void)p; sleep(30); _exit(124); return NULL; }\nstatic void hang_guard(void) { pthread_t t; pthread_create(&t, NULL, hang_guard_main, NULL); pthread_detach(t); }\n#endif");
fn deep(n: int): int :: final {
    let pad: [4]int = [n, n, n, n];
    return deep(n + 1) + pad[n % 4] - n;
}
fn main(): int {
    let args = sys.args();
    if args.length > 1 && args[1] == "child" {
        do unsafe { __c__("hang_guard(); gc_start();"); };
        fmt.println(f"{deep(0)}");
        return 0;
    }
    let r = process.runCaptured(args[0], ["child"]);
    fmt.println(f"{r.exitCode} {r.stderrResult.contains("Stack overflow while this thread was running a garbage collection")}");
    return 0;
}
""",
            "255 true");

        // The stall trace is taken while the task holds a lock that naming
        // the trace needs: on Linux glibc's loader lock, inside
        // dl_iterate_phdr (the unwinder parses symbol tables there; the
        // sanitizer run of 2026-11-20 hung there); on Windows the process
        // heap's lock, which malloc and dbghelp take. It must neither
        // deadlock nor lose the warning.
        s.run(
            "tasks: a stall inside a lock the stall trace needs is reported, never a deadlock",
            """
__c__("#ifdef _WIN32\n#include <windows.h>\nstatic void stall_in_lock(void) { HANDLE heap = GetProcessHeap(); LARGE_INTEGER f, a, b; QueryPerformanceFrequency(&f); HeapLock(heap); QueryPerformanceCounter(&a); do { QueryPerformanceCounter(&b); } while ((b.QuadPart - a.QuadPart) * 1000 < 60 * f.QuadPart); HeapUnlock(heap); }\n#else\n#define _GNU_SOURCE\n#include <link.h>\n#include <time.h>\nstatic int busy_in_loader(struct dl_phdr_info *info, size_t size, void *data) { (void)info; (void)size; struct timespec a, b; clock_gettime(CLOCK_THREAD_CPUTIME_ID, &a); do { clock_gettime(CLOCK_THREAD_CPUTIME_ID, &b); } while ((b.tv_sec - a.tv_sec) * 1000000000L + (b.tv_nsec - a.tv_nsec) < 60000000L); return 1; }\nstatic void stall_in_lock(void) { dl_iterate_phdr(busy_in_loader, NULL); }\n#endif\n#ifdef _WIN32\n#include <windows.h>\n#undef CreateThread\nstatic DWORD WINAPI hang_guard_main(LPVOID p) { (void)p; Sleep(30000); TerminateProcess(GetCurrentProcess(), 124); return 0; }\nstatic void hang_guard(void) { CloseHandle(CreateThread(NULL, 0, hang_guard_main, NULL, 0, NULL)); }\n#else\n#include <pthread.h>\n#include <unistd.h>\n#undef pthread_create\nstatic void *hang_guard_main(void *p) { (void)p; sleep(30); _exit(124); return NULL; }\nstatic void hang_guard(void) { pthread_t t; pthread_create(&t, NULL, hang_guard_main, NULL); pthread_detach(t); }\n#endif");
fn main(): int {
    let args = sys.args();
    if args.length > 1 && args[1] == "child" {
        do unsafe { __c__("hang_guard(); stall_in_lock();"); };
        fmt.println("finished");
        return 0;
    }
    let r = process.runCaptured(args[0], ["child"]);
    fmt.println(f"{r.exitCode} {r.stdoutResult.trim()} {r.stderrResult.contains("without yielding")}");
    return 0;
}
""",
            "0 finished true");

        // The profiler unwinds its samples after the run, from snapshots of
        // the sampled stack: memory past a snapshot is read live only where
        // it cannot have changed, inside a loaded module (CFI, code). A task
        // stack and the heap have moved on since the sample (review
        // 2026-11-20: only the thread's own stack was refused). The sampling
        // profiler (perf_event_open) exists on Linux only.
        if sys.isLinux() {
            s.run(
                "tasks: the profiler's unwinder reads only module memory live",
                """
__c__("#include <stdint.h>\n#include <stdbool.h>\nbool hzstd_perf_live_read_allowed(uint64_t addr);\nstatic int some_global = 1;");
fn main(): int {
    let code = false;
    let globalData = false;
    let taskStack = true;
    let heap = true;
    do unsafe {
        __c__("int local = 2; void *block = hzstd_heap_allocate(64, NULL); code = hzstd_perf_live_read_allowed((uint64_t)(uintptr_t)&hzstd_perf_live_read_allowed); globalData = hzstd_perf_live_read_allowed((uint64_t)(uintptr_t)&some_global); taskStack = hzstd_perf_live_read_allowed((uint64_t)(uintptr_t)&local); heap = hzstd_perf_live_read_allowed((uint64_t)(uintptr_t)block);");
    };
    fmt.println(f"{code} {globalData} {taskStack} {heap}");
    return 0;
}
""",
                "true true false false");
        }

        s.run(
            "tasks: yielding with nothing else ready goes on at once",
            """
fn main(): int {
    let n = 0;
    for (let i = 0; i < 1000; i++) {
        sys.yield();
        n++;
    }
    fmt.println(f"{n}");
    return 0;
}
""",
            "1000");
    }
}
