// ============================================================================
// `tasklocal` and `global` (Axiom C196, C198, C199, C202; docs/async-runtime.md
// section 2, "Globals").
//
//   tasklocal let x: T = v;     tasklocal const x = v;
//   global let x: T = v;        global const x = v;
//
// at module or namespace level, after `export` / `extern` / `pub` and before
// `let` / `const`. Both are reserved words.
//
//   * `tasklocal let`: once per task (task-local storage, cases_tasklocal.hz);
//     `tasklocal const` is a constant; never atomic (H7239)
//   * `global let`: once per process, so its type is atomic (an atomic
//     primitive, an atomic array, a reference to an atomic struct), else
//     H7247 (C199, docs/async-decisions.md S5-12)
//   * `global const`: once per process, a C global
//   * what either holds must cross threads (H7238; the rule itself:
//     cases_crossing.hz)
//   * `extern` or `comptime` with either keyword: H7232
//   * on a local variable: a syntax error in both parsers
//
// The syntax itself, in both parsers, is pinned by src/Parser/Parser.test.ts.
// ============================================================================

namespace cases_storage_keywords {

    fn notAtomic(s: mut testsuite.Suite, name: str, source: str) {
        s.compileFails(name, source, [
            testsuite.exactCount(errorcodes.Code.GlobalLetNotAtomic, 1),
            testsuite.totalErrors(1),
        ]);
    }

    fn combination(s: mut testsuite.Suite, name: str, source: str) {
        s.compileFails(name, source, [
            testsuite.exactCount(errorcodes.Code.StorageClassCombination, 1),
            testsuite.totalErrors(1),
        ]);
    }

    export fn register(s: mut testsuite.Suite) {

        // ── `global const` is accepted and behaves as today's global ────────
        s.run(
            "storage keywords: a global const is an ordinary process-wide constant",
            """
global const base = 40;
global const name: str = "g";
export global const exported = 2;
namespace cfg {
    export global const depth = 3;
    global const hidden = 5;
    export fn both(): int { return depth + hidden; }
}
struct Limits { v: int = base; }

fn add(n: int): int { return n + base; }

fn main(): int {
    let f = () => base + cfg.depth;
    fmt.println(f"{add(2)} {name} {exported} {cfg.depth} {cfg.both()} {f()} {Limits {}.v}");
    return 0;
}
""",
            "42 g 2 3 8 43 40");

        // ── Rule 1: tasklocal (built; what it does: cases_tasklocal.hz) ────
        s.compileOk("storage keywords: tasklocal let", """
tasklocal let counter: int = 0;

fn main(): int { return 0; }
""");

        s.compileOk("storage keywords: tasklocal const", """
tasklocal const limit = 3;

fn main(): int { return 0; }
""");

        s.compileOk("storage keywords: tasklocal in a namespace, exported", """
namespace n {
    export tasklocal let counter: int = 0;
}

fn main(): int { return 0; }
""");

        // ── Rule 3: global let holds an atomic type ─────────────────────────
        notAtomic(s, "storage keywords: global let of a plain int", """
global let counter: int = 0; // <- H7247

fn main(): int { return 0; }
""");

        notAtomic(s, "storage keywords: global let in a namespace", """
namespace n {
    global let counter: int = 0; // <- H7247
}

fn main(): int { return 0; }
""");

        // A global nobody uses is still diagnosed: the declaration is the error.
        notAtomic(s, "storage keywords: an unused global let is still rejected", """
global let unused: int = 1; // <- H7247

fn main(): int {
    return 7;
}
""");

        notAtomic(s, "storage keywords: global let of a plain array", """
global let items: []int = []; // <- H7247

fn main(): int { return 0; }
""");

        s.compileFails("storage keywords: an atomic tasklocal", """
tasklocal let counter: atomic int = 0; // <- H7239

fn main(): int { return 0; }
""", [
            testsuite.exactCount(errorcodes.Code.AtomicPrimitiveOutsideFieldOrGlobal, 1),
            testsuite.totalErrors(1),
        ]);

        s.compileFails("storage keywords: a global const that cannot cross threads", """
global const make: () => int = () => 1; // <- H7238

fn main(): int { return make(); }
""", [
            testsuite.exactCount(errorcodes.Code.CannotCrossThreads, 1),
            testsuite.messageContains("'make' is shared by every thread of the process, but it cannot cross threads: its type is"),
            testsuite.messageContains(":: final)', a closure whose type is not 'crossthread'"),
            testsuite.totalErrors(1),
        ]);

        // An atomic array as a `global let` passes the type rule; a global
        // array's initializer is not a constant image yet (a plain one fails
        // the same way), so only the primitives run here.
        s.compileOk("storage keywords: global let of an atomic array is atomic", """
global let seen: mut atomic []int;

fn main(): int { return 0; }
""");

        s.run("storage keywords: global let of atomic primitives", """
global let count: atomic int = 40;
global let ratio: atomic real = 0.5;
global let ready: atomic bool = false;
namespace n {
    export global let hits: atomic int = 0;
}

fn bump() { count += 1; n.hits++; }

fn main(): int {
    bump();
    bump();
    ratio *= 4.0;
    let was = ready.exchange(true);
    let swapped = count.compareExchange(42, 50);
    fmt.println(f"{count} {n.hits} {ratio} {was} {ready} {swapped}");
    return 0;
}
""", "50 2 2 false true true");

        // ── Rule 4: extern and comptime ─────────────────────────────────────
        combination(s, "storage keywords: extern with global", """
extern C global const code: int; // <- H7232

fn main(): int { return 0; }
""");

        combination(s, "storage keywords: extern with tasklocal", """
extern C tasklocal let code: int; // <- H7232

fn main(): int { return 0; }
""");

        combination(s, "storage keywords: comptime with global", """
global const comptime k = 3; // <- H7232

fn main(): int { return 0; }
""");

        combination(s, "storage keywords: comptime with tasklocal", """
tasklocal let comptime k = 3; // <- H7232

fn main(): int { return 0; }
""");

        // ── Rule 5: never on a local ────────────────────────────────────────
        s.compileFails(
            "storage keywords: global const on a local variable",
            """
fn main(): int {
    global const x = 1;
    return x;
}
""",
            [testsuite.mustHave(errorcodes.Code.SyntaxError)]);

        s.compileFails(
            "storage keywords: tasklocal let on a local variable",
            """
fn main(): int {
    tasklocal let x: int = 1;
    return x;
}
""",
            [testsuite.mustHave(errorcodes.Code.SyntaxError)]);

        s.compileFails(
            "storage keywords: global is a reserved word",
            """
fn main(): int {
    let global = 1;
    return global;
}
""",
            [testsuite.mustHave(errorcodes.Code.SyntaxError)]);
    }
}
