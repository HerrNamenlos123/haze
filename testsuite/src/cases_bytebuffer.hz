// ============================================================================
// REGRESSION TESTS: ByteBuffer, the standard way to build binary data.
//
// The model (stdlib/core/src/memory.hz has the full comment):
//
//   * Two phases. While building, the buffer grows and is edited, and no view
//     of it can exist. `commit()` ends that for good; from then on `bytes()`
//     and `string()` are views into the buffer's own storage, with no copy.
//     Crossing the line in either direction panics.
//   * Behaviour never depends on the representation: a buffer that still
//     borrows the `str` it was built from behaves exactly like one that
//     copied it (`string()` before `commit()` panics either way).
//   * It is a `nocopy` value: the buffer itself costs no allocation, and no
//     second binding of it (a second writer) can exist.
//   * Storage is growable (reallocated geometrically) or fixed (allocated
//     once, from any allocator, never moved; overflowing it panics). A
//     measuring buffer stores nothing and only counts, so the same code can
//     run twice: measure, then write into an exactly sized buffer.
//   * `reserve(total)` grows geometrically, `reserveExact(total)` exactly.
//
// The allocation counts are part of the contract, so they are asserted:
// borrowing and committing allocate nothing, an exactly sized buffer
// allocates once, growth reallocates at most log2(n) times.
// ============================================================================

namespace cases_bytebuffer {

    export fn register(s: mut testsuite.Suite) {

        s.run(
            "bytebuffer: building, editing, committing, viewing, sizing and measuring",
            """
ref struct Log { pending: ByteBuffer; }

fn writeGreeting(out: mut stackref ByteBuffer, name: str) {
    out.push("hi ");
    out.push(name);
    out.push(10 as u8);
}

fn main(): int {
    // 1. Every kind of push; reading in place.
    let stackref b = ByteBuffer();
    b.push("hello");
    b.push(Bytes(" "));
    b.push(119 as u8);
    b.push(Bytes("orld"));
    fmt.println(f"1: {b.length()} {b.cloneString()} {b[0].get()} {b.getAt(4)}");

    // 2. Editing.
    b.insert(0, ">> ");
    b.insert(b.length(), 33 as u8);
    b.remove(3, 6);
    b.setAt(0, 60 as u8);
    b[2] := 95 as u8;
    fmt.println(f"2: {b.cloneString()}");
    b.truncate(4);
    b.resize(6);
    fmt.println(f"2b: {b.length()} {b[5].get()} {b.cloneString().length}");
    b.clear();
    fmt.println(f"2c: {b.length()}");

    // 3. Views after commit are the buffer's own memory, every time.
    let c = ByteBuffer();
    c.push("abc");
    c.commit();
    let s1 = c.string();
    let s2 = c.string();
    fmt.println(f"3: {s1} {s2} {c.bytes().refersToSameMemory(c.bytes())} {c.isCommitted()} {c.length()}");

    // 4. Copy-on-write: the source never changes, and a buffer committed
    //    without edits is the source itself.
    let src = "source text";
    let d = ByteBuffer(src);
    d.setAt(0, 83 as u8);
    d.commit();
    let e = ByteBuffer(src);
    e.commit();
    fmt.println(f"4: {src} {d.string()} {e.bytes().refersToSameMemory(Bytes(src))}");

    // 5. Capacity: the constructor is exact, reserve is geometric (and a
    //    no-op when there is room), reserveExact is exact.
    let g = ByteBuffer(10);
    let g0 = g.capacity();
    g.reserve(11);
    let g1 = g.capacity();
    g.reserve(15);
    let g2 = g.capacity();
    g.reserveExact(25);
    let g3 = g.capacity();
    g.reserve(26);
    fmt.println(f"5: {g0} {g1} {g2} {g3} {g.capacity()}");

    // 6. Measure, then write exactly that much.
    let stackref m = ByteBuffer.measuring();
    writeGreeting(m, "bob");
    let stackref x = ByteBuffer(m.length());
    writeGreeting(x, "bob");
    x.commit();
    fmt.println(f"6: {m.length()} {x.capacity()} {x.length()} {x.string().length}");

    // 7. Fixed storage from an arena.
    let stackref f = ByteBuffer.fixed(8, Alloc.arena());
    f.push("1234");
    f.push(Bytes("5678"));
    f.commit();
    fmt.println(f"7: {f.string()} {f.capacity()}");

    // 8. Clones are independent of later edits, in any phase.
    let h = ByteBuffer();
    h.push("one");
    let snapshot = h.cloneString();
    h.setAt(0, 79 as u8);
    h.push("two");
    fmt.println(f"8: {snapshot} {h.cloneString()} {h.cloneBytes().length}");

    // 9. A buffer held by a ref struct, replaced after commit: views of the
    //    old one stay valid.
    let log: mut ref Log = { pending: ByteBuffer() };
    log.pending.push("first");
    log.pending.commit();
    let old = log.pending.string();
    log.pending = ByteBuffer();
    log.pending.push("second");
    fmt.println(f"9: {old} {log.pending.cloneString()}");

    // 10. A single-byte Bytes has no memory to borrow.
    let one = ByteBuffer(Bytes(65 as u8));
    one.commit();
    fmt.println(f"10: {one.string()}");
    return 0;
}
""",
            """
1: 11 hello world 104 111
2: <>_world!
2b: 6 0 6
2c: 0
3: abc abc true true 3
4: source text Source text true
5: 10 20 20 25 50
6: 7 7 7 7
7: 12345678 8
8: one Onetwo 6
9: first second
10: A
""");

        // ── String: a shareable, editable text, built on one ByteBuffer ──────
        s.run(
            "bytebuffer: String is a ref wrapper with the same phases",
            """
fn shout(s: mut String) { s.append("!"); }
fn main(): int {
    let s = String("hello");
    s.append(" world");
    shout(s);
    s.insert(0, ">");
    s.remove(1, 1);
    s.setAt(0, 72 as u8);
    let shared = s;
    shared.append("?");
    let other = String("abc");
    other.append(s);
    fmt.println(f"{s.cloneString()} {s.length()} {s.getAt(1)} {s.startsWith("Hello")} {s.endsWith("!?")} {s.contains("o w")} {s.cloneSlice(1, 5)}");
    fmt.println(f"{s} {other.cloneString()}");
    s.commit();
    fmt.println(s.string());
    let empty = String();
    empty.reserve(100);
    fmt.println(f"{empty.length()}");
    let twice = String("abcde");
    twice.append("f");
    twice.append(twice);
    fmt.println(twice.cloneString());
    return 0;
}
""",
            """
Hello world!? 13 101 true true true ello
Hello world!? abcHello world!?
Hello world!?
0
abcdefabcdef
""");

        // ── A str is pointer + length, never NUL-terminated ──────────────────
        //
        // A committed ByteBuffer's view is followed by whatever its storage
        // held before, and a slice ends in the middle of other bytes. Code
        // handing a str to C must copy it by length: the process spawner
        // read argv, the program, the working directory and the environment
        // up to the next NUL, which only worked while every formatted string
        // happened to sit in zero-filled memory.
        s.run(
            "bytebuffer: a str handed to a child process is read by its length, not to a NUL",
            """
fn main(): int {
    let b = ByteBuffer(64);
    b.push("abc");
    b.push("def");
    b.truncate(3);
    b.commit();
    let arg = b.string();

    let exe = "echoXYZ".slice(0, 4);
    let r1 = process.runCaptured(exe, [arg, "one two".slice(0, 3)]);
    let r2 = process.runCaptured("pwd", [], { cwd: "/tmpXYZ".slice(0, 4) });
    let r3 = process.runCaptured("sh", ["-c", "echo $HZTEST"], { env: ["HZTEST=okXYZ".slice(0, 9)] });
    fmt.println(f"{r1.exitCode} [{r1.stdoutResult.trim()}]");
    fmt.println(f"{r2.exitCode} [{r2.stdoutResult.trim()}]");
    fmt.println(f"{r3.exitCode} [{r3.stdoutResult.trim()}]");
    return 0;
}
""",
            """
0 [abc one]
0 [/tmp]
0 [ok]
""");

        s.run(
            "bytebuffer: copying a file through sliced paths reads them by length",
            """
fn main(): int {
    let dir = "/tmp/haze-testsuite-str-copy";
    let made = fs.createDirectory(dir);
    let wrote = fs.writeText(f"{dir}/src.txt", "copied");
    let src = f"{dir}/src.txtXYZ".slice(0, dir.length + 8);
    let dst = f"{dir}/dst.txtXYZ".slice(0, dir.length + 8);
    let a = fs.copyFile(src, dst, { overwrite: true });
    let b = fs.copy(src, f"{dir}/dst2.txtXYZ".slice(0, dir.length + 9), { overwrite: true });
    let back = "";
    if let text = fs.readText(f"{dir}/dst.txt") { back = text; }
    let back2 = "";
    if let text = fs.readText(f"{dir}/dst2.txt") { back2 = text; }
    fmt.println(f"{back} {back2}");
    return 0;
}
""",
            "copied copied");

        // Not about strings, but found with them: a program that cannot be
        // started left stdout as a NULL C string, and reading it crashed.
        s.run(
            "bytebuffer: a program that cannot be started reports a failure instead of crashing",
            """
fn main(): int {
    let r = process.runCaptured("haze-testsuite-no-such-program", []);
    fmt.println(f"{r.exitCode != 0} [{r.stdoutResult}]");
    return 0;
}
""",
            "true []");

        // ── Rotating: reordering what was written, in place ──────────────────
        //
        // rotate(start, middle, end) moves [middle, end) to `start` and
        // [start, middle) after it. It has three ways to park the shorter
        // side (the stack, the unused capacity, or none: reversing in
        // place), so the sizes and storage kinds below reach all three, and
        // every result is checked against the same reorder built by slicing.
        s.run(
            "bytebuffer: rotate matches slicing for every size and storage kind",
            """
fn expected(s: str, a: int, m: int, e: int): str {
    return f"{s.slice(0, a)}{s.slice(m, e)}{s.slice(a, m)}{s.slice(e)}";
}

fn main(): int {
    let letters = "abcdefghijklmnopqrstuvwxyz0123456789";
    let state = 7;
    let cases = 0;
    for (let round = 0; round < 400; round++) {
        state = (state * 1103515245 + 12345) % 2147483648;
        let n = state % 3000;
        if round % 5 == 0 { n = state % 40; }
        let stackref text = ByteBuffer(n);
        for (let i = 0; i < n; i++) {
            state = (state * 1103515245 + 12345) % 2147483648;
            text.push(letters[state % 36]);
        }
        text.commit();
        let src = text.string();

        state = (state * 1103515245 + 12345) % 2147483648;
        let a = 0;
        let m = 0;
        let e = 0;
        if n > 0 {
            a = state % (n + 1);
            m = a + (state / 7) % (n - a + 1);
            e = m + (state / 13) % (n - m + 1);
        }
        let want = expected(src, a, m, e);

        let kind = round % 4;
        if kind == 0 {
            // Growable, with plenty of unused capacity.
            let stackref b = ByteBuffer(n * 3 + 1);
            b.push(src);
            let cap = b.capacity();
            b.rotate(a, m, e);
            assert(b.cloneString() == want, f"spare n={n} {a} {m} {e}");
            assert(b.capacity() == cap && b.length() == n, "spare: size changed");
        }
        else if kind == 1 {
            // Growable and exactly full.
            let stackref b = ByteBuffer(n);
            b.push(src);
            b.rotate(a, m, e);
            assert(b.cloneString() == want, f"full n={n} {a} {m} {e}");
            assert(b.capacity() == n && b.length() == n, "full: size changed");
        }
        else if kind == 2 {
            // Fixed and full: nowhere to grow, so never allowed to.
            let stackref b = ByteBuffer.fixed(n, Alloc.heap());
            b.push(src);
            b.rotate(a, m, e);
            assert(b.cloneString() == want, f"fixed n={n} {a} {m} {e}");
        }
        else {
            // Borrowing: the source it borrows must not change.
            let stackref b = ByteBuffer(src);
            b.rotate(a, m, e);
            assert(b.cloneString() == want, f"borrowed n={n} {a} {m} {e}");
            assert(src == text.string(), "borrowed: the source changed");
        }
        cases++;
    }

    // Empty ranges on either side are no-ops, as is rotating nothing at all.
    let stackref z = ByteBuffer("abc");
    z.rotate(0, 0, 3);
    z.rotate(1, 3, 3);
    z.rotate(3, 3, 3);
    assert(z.cloneString() == "abc", "no-op rotations");

    // A measuring buffer has nothing to move and keeps its count.
    let stackref ms = ByteBuffer.measuring();
    ms.push("abcdef");
    ms.rotate(1, 2, 5);
    assert(ms.length() == 6, "measuring length");

    fmt.println(f"rotate: {cases} cases");
    return 0;
}
""",
            "rotate: 400 cases");

        s.runExitCode(
            "bytebuffer: rotate allocates nothing, whichever way it parks the shorter side",
            """
fn profiler(): Profiler {
    return Profiler({ samplingRate: 0, memoryInstrumentation: true, memoryInstrumentationStacktraces: false });
}
fn main(): int {
    let stackref small = ByteBuffer(100);
    small.push("0123456789");
    let stackref spare = ByteBuffer(5000);
    for (let i = 0; i < 2000; i++) { spare.push(97 as u8); }
    spare.push("b");
    let stackref full = ByteBuffer.fixed(2000, Alloc.heap());
    for (let i = 0; i < 1999; i++) { full.push(97 as u8); }
    full.push("c");

    let p = profiler();
    small.rotate(2, 5, 9);
    spare.rotate(0, 1000, 2001);
    full.rotate(0, 1000, 2000);
    let r = p.stop();

    assert(small.cloneString() == "0156782349", "small");
    assert(spare.getAt(1000) == 98 && spare.getAt(2000) == 97, "spare");
    assert(full.getAt(999) == 99 && full.getAt(1999) == 97, "full");
    let count = r.memoryInstrumentationFrames.length - 1;
    assert(count == 0, f"rotate allocated {count}");
    return 0;
}
""",
            0);

        // The unused capacity is only a place to park the shorter side when
        // all of it fits there. Here 40 bytes would not: a guard buffer
        // placed right behind the buffer in the same arena must stay intact.
        s.runExitCode(
            "bytebuffer: rotate never parks past the end of the capacity",
            """
fn main(): int {
    let arena = Alloc.arena();
    let stackref opener = ByteBuffer.fixed(16, arena);
    let stackref a = ByteBuffer.fixed(1920, arena);
    let stackref guard = ByteBuffer.fixed(64, arena);
    for (let i = 0; i < 64; i++) { guard.push(35 as u8); }
    for (let i = 0; i < 600; i++) { a.push(76 as u8); }
    for (let i = 0; i < 760; i++) { a.push(82 as u8); }

    // 560 bytes are free, the shorter side is 600.
    a.rotate(0, 600, 1360);

    a.commit();
    guard.commit();
    let ab = a.bytes();
    let gb = guard.bytes();
    let adjacent = false;
    __c__("adjacent = (const char*)gb.basePtr + gb.offset == (const char*)ab.basePtr + ab.offset + 1920;");
    assert(adjacent, "the guard is not right behind the buffer: the arena's layout changed, adjust this test");
    for (let i = 0; i < 64; i++) {
        assert(guard.getAt(i) == 35, f"guard byte {i} was overwritten");
    }
    for (let i = 0; i < 1360; i++) {
        let want: u8 = 82;
        if i >= 760 { want = 76; }
        assert(a.getAt(i) == want, f"byte {i}");
    }
    return 0;
}
""",
            0);

        s.runExitCode(
            "bytebuffer: rotating out of bounds panics",
            """
fn main(): int {
    let b = ByteBuffer("abcdef");
    b.rotate(3, 2, 6);
    return 0;
}
""",
            255);

        s.runExitCode(
            "bytebuffer: rotating past the end panics",
            """
fn main(): int {
    let b = ByteBuffer("abcdef");
    b.rotate(0, 2, 7);
    return 0;
}
""",
            255);

        s.runExitCode(
            "bytebuffer: rotating after commit panics",
            """
fn main(): int {
    let b = ByteBuffer();
    b.push("abcdef");
    b.commit();
    b.rotate(0, 2, 6);
    return 0;
}
""",
            255);

        // ── Formatted text, written straight into any buffer ────────────────
        //
        // pushFmt / appendFmt format exactly as fmt.format does, into the
        // buffer itself: a struct field too, which a formatter's
        // `mut stackref ByteBuffer` cannot take, and with nothing allocated
        // beyond the buffer's own growth.
        s.run(
            "bytebuffer: pushFmt and String.appendFmt format like fmt.format, anywhere",
            """
ref struct Doc { body: ByteBuffer; }

fn main(): int {
    let n = 42;
    let r = 1.5;
    let neg = -7;

    // 1. A local buffer, any mix of values.
    let stackref b = ByteBuffer();
    b.pushFmt("n=", n, " r=", r, " ok=", true);
    b.pushFmt(neg);
    b.pushFmt("plain");
    b.commit();
    let want1 = fmt.format("n=", n, " r=", r, " ok=", true, neg, "plain");
    fmt.println(f"1: {b.string()} {b.string() == want1}");

    // 2. A buffer held in a struct field.
    let doc: mut ref Doc = { body: ByteBuffer() };
    doc.body.pushFmt("[", n, "]");
    doc.body.pushFmt(r, ",", false);
    doc.body.commit();
    fmt.println(f"2: {doc.body.string()}");

    // 3. A measuring buffer counts exactly what would be written.
    let stackref m = ByteBuffer.measuring();
    m.pushFmt("n=", n, " r=", r, " ", false);
    let want3 = fmt.format("n=", n, " r=", r, " ", false);
    fmt.println(f"3: {m.length()} {want3.length}");

    // 4. A String takes formatted text the same way, and chains.
    let s = String("x");
    s.appendFmt("=", n).appendFmt(" ", r, " ", neg);
    fmt.println(f"4: {s.cloneString()}");

    // 5. Nothing at all to format.
    let stackref e = ByteBuffer();
    e.pushFmt("");
    e.commit();
    fmt.println(f"5: [{e.string()}] {e.length()}");
    return 0;
}
""",
            """
1: n=42 r=1.5 ok=true-7plain true
2: [42]1.5,false
3: 16 16
4: x=42 1.5 -7
5: [] 0
""");

        s.runExitCode(
            "bytebuffer: pushFmt and appendFmt allocate nothing when there is room",
            """
ref struct Doc { body: ByteBuffer; }

fn profiler(): Profiler {
    return Profiler({ samplingRate: 0, memoryInstrumentation: true, memoryInstrumentationStacktraces: false });
}

fn main(): int {
    let n = 12345;
    let r = 2.25;
    let stackref b = ByteBuffer(256);
    let doc: mut ref Doc = { body: ByteBuffer(256) };
    let s = String();
    s.reserve(256);
    s.append("start ");

    let stackref m = ByteBuffer.measuring();

    let p = profiler();
    b.pushFmt("n=", n, " r=", r, " ", true, " ", -3);
    doc.body.pushFmt(n, " ", r);
    s.appendFmt(n, " ", r, " ", false);
    m.pushFmt(r, " ", true, n);
    let res = p.stop();

    b.commit();
    doc.body.commit();
    assert(b.string() == "n=12345 r=2.25 true -3", "buffer");
    assert(doc.body.string() == "12345 2.25", "field");
    assert(s.cloneString() == "start 12345 2.25 false", "string");
    assert(m.length() == 14, f"measured {m.length()}");
    let count = res.memoryInstrumentationFrames.length - 1;
    assert(count == 0, f"formatting allocated {count}");
    return 0;
}
""",
            0);

        s.runExitCode(
            "bytebuffer: pushFmt after commit panics",
            """
fn main(): int {
    let b = ByteBuffer();
    b.push("a");
    b.commit();
    b.pushFmt(1.5);
    return 0;
}
""",
            255);

        s.runExitCode(
            "bytebuffer: pushFmt past a fixed capacity panics",
            """
fn main(): int {
    let stackref f = ByteBuffer.fixed(4, Alloc.heap());
    f.pushFmt(1.25, "x");
    return 0;
}
""",
            255);

        s.runExitCode(
            "bytebuffer: appendFmt on a committed String panics",
            """
fn main(): int {
    let s = String("a");
    s.commit();
    s.appendFmt(2.5);
    return 0;
}
""",
            255);

        // ── String edits everything a ByteBuffer can, as text ───────────────
        s.run(
            "bytebuffer: String has the whole editing API",
            """
fn main(): int {
    let s = String();
    s.append("hello").append(33 as u8);
    s.insert(0, 62 as u8);
    fmt.println(f"1: {s.cloneString()} {s.length()}");
    s.rotate(1, 6, 7);
    fmt.println(f"2: {s.cloneString()}");
    s.truncate(3);
    fmt.println(f"3: {s.cloneString()} {s.isCommitted()}");
    s.reserveExact(40);
    fmt.println(f"4: {s.capacity()}");
    s.clear();
    s.append("x");
    s.commit();
    fmt.println(f"5: {s.string()} {s.isCommitted()} {s.length()}");
    return 0;
}
""",
            """
1: >hello! 7
2: >!hello
3: >!h false
4: 40
5: x true 1
""");

        // ── push's fast path only ever writes into the buffer's own block ───
        //
        // Dropping the end of a borrowing buffer leaves room behind it that
        // belongs to the source: a push there must copy first, not write into
        // the borrowed str.
        s.run(
            "bytebuffer: pushing after dropping the end of a borrowed buffer leaves the source alone",
            """
fn main(): int {
    let word = "text";
    let src = f"source {word}";

    let stackref b = ByteBuffer(src);
    b.truncate(6);
    b.push("!");
    b.push(63 as u8);
    b.commit();
    fmt.println(f"{src} | {b.string()}");

    let stackref c = ByteBuffer(src);
    c.remove(3, 8);
    c.push(88 as u8);
    c.push("Y");
    c.commit();
    fmt.println(f"{src} | {c.string()}");
    return 0;
}
""",
            """
source text | source!?
source text | souXY
""");

        s.runExitCode(
            "bytebuffer: pushing a byte past a fixed capacity panics",
            """
fn main(): int {
    let stackref f = ByteBuffer.fixed(2, Alloc.heap());
    f.push(65 as u8);
    f.push(66 as u8);
    f.push(67 as u8);
    fmt.println(f"{f.length()}");
    return 0;
}
""",
            255);

        // ── Integers are formatted exactly as printf formats them ───────────
        //
        // fmt writes integers digit by digit instead of through snprintf;
        // printf itself is the oracle, over every integer type, the extremes
        // and a spread of values in between.
        s.run(
            "fmt: integers format exactly as printf does",
            """
__c__("#include <stdio.h>");
__c__("#include <inttypes.h>");

fn signedOracle(v: i64): str {
    let s = "";
    __c__("char ob[32]; snprintf(ob, sizeof(ob), \\"%\\" PRIi64, (int64_t)v); s = hzstd_str_dup(HZSTD_STRING_FROM_CSTR(ob));");
    return s;
}

fn unsignedOracle(v: u64): str {
    let s = "";
    __c__("char ob[32]; snprintf(ob, sizeof(ob), \\"%\\" PRIu64, (uint64_t)v); s = hzstd_str_dup(HZSTD_STRING_FROM_CSTR(ob));");
    return s;
}

fn main(): int {
    let checked = 0;
    let state = 12345;
    let values: []int = [0, 1, -1, 9, 10, -10, 99, 100, 999, 1000, 9223372036854775807, -9223372036854775807 - 1];
    let p = 1;
    for (let i = 0; i < 18; i++) {
        p = p * 10;
        values.push(p);
        values.push(p - 1);
        values.push(-p);
        values.push(1 - p);
    }
    for (let i = 0; i < 2000; i++) {
        state = (state * 1103515245 + 12345) % 2147483648;
        let hi = state;
        state = (state * 1103515245 + 12345) % 2147483648;
        let v = hi * 2147483648 + state;
        if i % 3 == 0 { v = -v; }
        if i % 5 == 0 { v = v / 1000000000; }
        values.push(v);
    }
    for v in values {
        assert(f"{v}" == signedOracle(v), f"int {v}");
        let w: i64 = v;
        assert(f"{w}" == signedOracle(w), "i64");
        checked++;
    }

    let i8s: []i8 = [0, 1, -1, 127, -128, 42, -42];
    for v in i8s { assert(f"{v}" == signedOracle(v), "i8"); checked++; }
    let i16s: []i16 = [0, 32767, -32768, 1000, -1000];
    for v in i16s { assert(f"{v}" == signedOracle(v), "i16"); checked++; }
    let i32s: []i32 = [0, 2147483647, -2147483648, 65536, -65536];
    for v in i32s { assert(f"{v}" == signedOracle(v), "i32"); checked++; }
    let u8s: []u8 = [0, 1, 9, 10, 99, 100, 255];
    for v in u8s { assert(f"{v}" == unsignedOracle(v), "u8"); checked++; }
    let u16s: []u16 = [0, 65535, 10000];
    for v in u16s { assert(f"{v}" == unsignedOracle(v), "u16"); checked++; }
    let u32s: []u32 = [0, 4294967295, 1000000000];
    for v in u32s { assert(f"{v}" == unsignedOracle(v), "u32"); checked++; }
    let u64s: []u64 = [0, 18446744073709551615, 10000000000000000000, 9223372036854775808];
    for v in u64s { assert(f"{v}" == unsignedOracle(v), "u64"); checked++; }
    let sizes: []usize = [0, 4096, 18446744073709551615];
    for v in sizes { assert(f"{v}" == unsignedOracle(v as u64), "usize"); checked++; }

    fmt.println(f"integers: {checked} checked");
    return 0;
}
""",
            "integers: 2121 checked");

        // ── Allocation counts ────────────────────────────────────────────────
        //
        // Each window is measured with the memory profiler; the Profiler
        // object itself is the one allocation every window contains.
        s.runExitCode(
            "bytebuffer: allocation counts are part of the contract",
            """
fn profiler(): Profiler {
    return Profiler({ samplingRate: 0, memoryInstrumentation: true, memoryInstrumentationStacktraces: false });
}
fn main(): int {
    let src = "borrowed source";

    // Borrow, commit, view: nothing.
    let p1 = profiler();
    let a = ByteBuffer(src);
    a.commit();
    let av = a.string();
    let r1 = p1.stop();

    // Exact size: one allocation; pushing within it, committing and viewing
    // add none.
    let p2 = profiler();
    let b = ByteBuffer(16);
    b.push("0123456789");
    b.push(Bytes("abcdef"));
    b.commit();
    let bs = b.string();
    let bb = b.bytes();
    let r2 = p2.stop();

    // Measure (nothing), then write exactly (one).
    let p3 = profiler();
    let stackref m = ByteBuffer.measuring();
    m.push("measured ");
    m.push(src);
    let stackref x = ByteBuffer(m.length());
    x.push("measured ");
    x.push(src);
    x.commit();
    let xs = x.string();
    let r3 = p3.stop();

    // Growth from empty: 1000 single bytes is one allocation plus at most
    // log2(1000) reallocations.
    let p4 = profiler();
    let g = ByteBuffer();
    for (let i = 0; i < 1000; i++) { g.push(97 as u8); }
    g.commit();
    let r4 = p4.stop();

    // Formatting allocates exactly the resulting string.
    let n = 42;
    let p5 = profiler();
    let formatted = fmt.format("n=", n, " src=", src);
    let r5 = p5.stop();

    // A String is its object plus its storage once edited.
    let p6 = profiler();
    let s = String("abc");
    s.append("def");
    let r6 = p6.stop();

    assert(av == src, "borrowed view");
    assert(bs == "0123456789abcdef" && bb.length == 16, "exact view");
    assert(xs == "measured borrowed source", "measured view");
    assert(g.length() == 1000, "growth length");
    assert(formatted == "n=42 src=borrowed source", "formatted");
    assert(s.cloneString() == "abcdef", "string");

    let c1 = r1.memoryInstrumentationFrames.length - 1;
    let c2 = r2.memoryInstrumentationFrames.length - 1;
    let c3 = r3.memoryInstrumentationFrames.length - 1;
    let c4 = r4.memoryInstrumentationFrames.length - 1;
    let c5 = r5.memoryInstrumentationFrames.length - 1;
    let c6 = r6.memoryInstrumentationFrames.length - 1;
    assert(c1 == 0, f"borrow+commit+view allocated {c1}");
    assert(c2 == 1, f"exact buffer allocated {c2}");
    assert(c3 == 1, f"measure+exact allocated {c3}");
    assert(c4 >= 1 && c4 <= 11, f"growth to 1000 bytes allocated {c4}");
    assert(c5 == 1, f"fmt.format allocated {c5}");
    assert(c6 == 2, f"String + edit allocated {c6}");
    return 0;
}
""",
            0);

        // ── The phases are enforced at runtime ───────────────────────────────
        s.runExitCode(
            "bytebuffer: pushing after commit panics",
            """
fn main(): int {
    let b = ByteBuffer();
    b.push("a");
    b.commit();
    b.push("b");
    return 0;
}
""",
            255);

        s.runExitCode(
            "bytebuffer: a string view before commit panics",
            """
fn main(): int {
    let b = ByteBuffer();
    b.push("a");
    fmt.println(b.string());
    return 0;
}
""",
            255);

        s.runExitCode(
            "bytebuffer: a bytes view before commit panics, even while still borrowing an immutable str",
            """
fn main(): int {
    let b = ByteBuffer("immutable anyway");
    fmt.println(f"{b.bytes().length}");
    return 0;
}
""",
            255);

        s.runExitCode(
            "bytebuffer: a measuring buffer has no contents to read",
            """
fn main(): int {
    let stackref m = ByteBuffer.measuring();
    m.push("abc");
    fmt.println(f"{m.getAt(0)}");
    return 0;
}
""",
            255);

        s.runExitCode(
            "bytebuffer: a measuring buffer cannot be committed",
            """
fn main(): int {
    let stackref m = ByteBuffer.measuring();
    m.push("abc");
    m.commit();
    return 0;
}
""",
            255);

        s.runExitCode(
            "bytebuffer: writing past a fixed capacity panics",
            """
fn main(): int {
    let stackref f = ByteBuffer.fixed(4, Alloc.heap());
    f.push("12345");
    return 0;
}
""",
            255);

        s.runExitCode(
            "bytebuffer: reading out of bounds panics",
            """
fn main(): int {
    let b = ByteBuffer("abc");
    fmt.println(f"{b.getAt(3)}");
    return 0;
}
""",
            255);

        s.runExitCode(
            "bytebuffer: inserting out of bounds panics",
            """
fn main(): int {
    let b = ByteBuffer("abc");
    b.insert(4, "x");
    return 0;
}
""",
            255);

        s.runExitCode(
            "bytebuffer: a String view before commit panics",
            """
fn main(): int {
    let s = String("abc");
    fmt.println(s.string());
    return 0;
}
""",
            255);

        // ── nocopy: no second writer can exist (§9) ──────────────────────────
        s.compileFails(
            "bytebuffer: a buffer cannot be copied",
            """
fn main(): int {
    let a = ByteBuffer();
    let b = a;
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.NocopySecondBinding)]);

        // `buffer[i]` is a value holding a checked reference to the buffer,
        // so the buffer has to be one that can be referenced.
        s.compileFails(
            "bytebuffer: indexing needs a buffer that can be referenced",
            """
fn main(): int {
    let b = ByteBuffer("abc");
    b[0] := 65 as u8;
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.ReceiverStorageTooWeak)]);

        s.compileFails(
            "bytebuffer: a built buffer cannot be returned, only its views",
            """
fn build(): ByteBuffer {
    let b = ByteBuffer();
    b.push("x");
    return b;
}
fn main(): int {
    let b = build();
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.NocopySecondBinding)]);
    }
}
