// ============================================================================
// REGRESSION TEST — this is a real, load-bearing test, not a placeholder.
//
// Bug: json.parse / json.stringify could not handle a type that contains
// itself. A file tree is the ordinary example:
//
//   struct FSFileEntry { type: "file"; filename: str; }
//   struct FSDirEntry  { type: "directory"; dirname: str; children: []FSEntry; }
//   type FSEntry = FSFileEntry | FSDirEntry;
//
//   Error H7091: Function parseJsonNodeFromFfi() is not fully elaborated yet.
//   If it is part of a recursive call chain, it requires a
//   "fn foo(): T :: final" annotation ...
//
// parseJsonNodeFromFfi<[]FSEntry> needs parseJsonStruct<FSDirEntry>, which
// needs parseJsonNodeFromFfi<[]FSEntry> again while it is still being
// elaborated. The compiler lets a recursive call use a function's signature
// before its body is done only if the function is `:: final`, and the JSON
// functions were not.
//
// Each case round-trips parse -> stringify -> parse and walks the result, so
// it tests both directions without depending on stringify's exact layout.
// (A union of structs has to name its tag with json.discriminator either way:
// JSON cannot tell two objects apart on its own.)
// ============================================================================

namespace cases_json_recursive {

    export fn register(s: mut testsuite.Suite) {

        s.run(
            "json recursive: a discriminated union that contains itself",
            """
struct FSFileEntry {
    type: "file";
    filename: str;
}

struct FSDirEntry {
    type: "directory";
    dirname: str;
    children: []FSEntry;
}

[[json.discriminator="type"]]
type FSEntry = FSFileEntry | FSDirEntry;

struct Vault {
    entries: []FSEntry = [];
    expanded: []FSEntry | none = none;
}

fn walk(entries: []FSEntry, depth: int) :: final {
    for entry in entries {
        if entry is FSDirEntry {
            fmt.println(f"{depth} dir {entry.dirname}");
            walk(entry.children, depth + 1);
        } else if entry is FSFileEntry {
            fmt.println(f"{depth} file {entry.filename}");
        }
    }
}

fn main(): int {
    let text = \"\"\"{"entries": [
        {"type": "directory", "dirname": "notes", "children": [
            {"type": "file", "filename": "a.md"},
            {"type": "directory", "dirname": "deep", "children": [
                {"type": "file", "filename": "b.md"}
            ]}
        ]},
        {"type": "file", "filename": "top.md"}
    ]}\"\"\";
    let parsed = json.parse<Vault>(text);
    assert(parsed);
    let again = json.parse<Vault>(json.stringify(parsed));
    assert(again);
    walk(again.entries, 0);
    fmt.println(f"expanded absent {again.expanded is none}");
    fmt.println(f"stable {json.stringify(again) == json.stringify(parsed)}");
    return 0;
}
""",
            """
0 dir notes
1 file a.md
1 dir deep
2 file b.md
0 file top.md
expanded absent true
stable true
""");

        s.run(
            "json recursive: a struct holding an array of itself",
            """
struct Node {
    name: str;
    children: []Node;
}

fn walk(node: Node, depth: int) :: final {
    fmt.println(f"{depth} {node.name}");
    for child in node.children {
        walk(child, depth + 1);
    }
}

fn main(): int {
    let text = \"\"\"{"name": "root", "children": [
        {"name": "a", "children": []},
        {"name": "b", "children": [{"name": "c", "children": []}]}
    ]}\"\"\";
    let parsed = json.parse<Node>(text);
    assert(parsed);
    let again = json.parse<Node>(json.stringify(parsed));
    assert(again);
    walk(again, 0);
    return 0;
}
""",
            """
0 root
1 a
1 b
2 c
""");

        s.run(
            "json recursive: a list linked through an optional",
            """
ref struct Link {
    value: int;
    next: Link | none = none;
}

fn main(): int {
    let text = \"\"\"{"value": 1, "next": {"value": 2, "next": {"value": 3}}}\"\"\";
    let parsed = json.parse<Link>(text);
    assert(parsed);
    let again = json.parse<Link>(json.stringify(parsed));
    assert(again);
    let current: Link | none = again;
    while current is Link {
        fmt.println(f"value {current.value}");
        current = current.next;
    }
    return 0;
}
""",
            """
value 1
value 2
value 3
""");
    }
}
