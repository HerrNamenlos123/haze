// REGRESSION TEST -- array methods that live in the standard library.
//
// `items.map(f)` and `items.filter(p)` are not compiler features. A method call
// on an array naming something the compiler does not implement itself is
// rewritten to a call of that function in the stdlib `array` namespace with the
// receiver as its first argument (Elaborate.ts, tryResolveArrayExtensionCall),
// so these cases cover the dispatch as much as the functions:
//
//   * element and result types are deduced, including a map that changes the
//     type (int -> str), and calls chain because the result is a normal array,
//   * an empty receiver, an empty result, struct elements and capturing
//     closures are not special cases,
//   * `push` and `reserve` were MOVED OUT of the compiler into that namespace
//     and must still behave exactly as the built-ins did -- in particular
//     `bytes.push(0)`, where an int literal converts to the element type
//     without deducing the generic away from the array (what `NoInfer<T>` in
//     the signature is for),
//   * a struct with its own `push`/`map` keeps them: the namespace is only
//     consulted for receivers that are arrays,
//   * the methods the compiler still implements (length/insert/pop/clear) keep
//     taking precedence,
//   * an array literal and an array method both work through a type alias
//     (`type Row = []int`), which used to fail an internal assertion with no
//     message and no source location.

namespace cases_array_methods {

    export fn register(s: mut testsuite.Suite) {

        s.run(
            "array methods: map/filter from the standard library, push/reserve moved out",
            """
struct Point { x: int; y: int; }

// A struct with its own push/map must keep them: the array namespace is only
// consulted for receivers that really are arrays.
ref struct Bag {
    items: mut []int = [];

    mut fn push(v: int) {
        this.items.push(v * 10);
    }

    fn map(v: int): int {
        return v + 1;
    }
}

type Row = []int;

fn describe(items: []int): str {
    let out = "";
    for item in items {
        out = f"{out}{item},";
    }
    return out;
}

fn main(): int {
    let nums: mut []int = [];
    for (let i = 1; i <= 5; i++) { nums.push(i); }

    fmt.println(f"doubled  {describe(nums.map((v: int) => v * 2))}");
    fmt.println(f"filtered {describe(nums.filter((v: int) => v % 2 == 0))}");

    let names = nums.map((v: int) => f"n{v}");
    let joined = "";
    for n in names { joined = f"{joined}{n},"; }
    fmt.println(f"names    {joined}");

    fmt.println(f"chained  {describe(nums.filter((v: int) => v > 2).map((v: int) => v * v))}");
    fmt.println(f"none     {describe(nums.filter((v: int) => v > 99))}");

    let empty: []int = [];
    fmt.println(f"empty    {describe(empty.map((v: int) => v + 1))}");

    let pts: mut []Point = [];
    pts.push(Point { x: 1, y: 2 });
    pts.push(Point { x: 3, y: 4 });
    fmt.println(f"xs       {describe(pts.map((p: Point) => p.x))}");
    let threshold = 2;
    fmt.println(f"captured {describe(pts.filter((p: Point) => p.x > threshold).map((p: Point) => p.y))}");

    // push/reserve come from the standard library now, and must still convert
    // an int literal to the element type.
    let bytes: mut []u8 = [];
    bytes.reserve(4);
    bytes.push(0);
    bytes.push(255);
    fmt.println(f"bytes    {bytes.length} {bytes[0]} {bytes[1]}");

    // The methods the compiler still implements itself.
    nums.insert(0, 99);
    let popped = nums.pop();
    nums.clear();
    fmt.println(f"builtins {nums.length} {popped}");

    // Struct members win over the array namespace, including an overload set.
    let bag: mut ref Bag = Bag {};
    bag.push(1);
    bag.push(2);
    let buf = ByteBuffer();
    buf.push("ab");
    buf.push("cd");
    let buflen = buf.length();
    fmt.println(f"members  {bag.items.length} {bag.items[0]} {bag.items[1]} {bag.map(5)} {buflen}");

    // An array literal, and an array method, through a type alias.
    let r: Row = [];
    let r2: Row = [1, 2, 3];
    fmt.println(f"alias    {r.length} {describe(r2.map((v: int) => v * 2))}");
    return 0;
}
""",
            """
doubled  2,4,6,8,10,
filtered 2,4,
names    n1,n2,n3,n4,n5,
chained  9,16,25,
none     
empty    
xs       1,3,
captured 4,
bytes    2 0 255
builtins 0 5
members  2 10 20 6 4
alias    0 2,4,6,
""");

        // `sort` is a stable merge sort in place. Stability is checked with
        // elements that compare equal but carry their original position, and
        // the element kinds cover what codegen treats differently: a
        // primitive, a str, a value struct, a ref struct and a union of value
        // structs (indexing an array of value structs is where generated C
        // has gone wrong before).
        s.run(
            "array methods: sort is a stable in-place sort",
            """
struct Item { key: int; seq: int; }
ref struct Node { key: int; seq: int; }
struct Leaf { name: str; }
struct Branch { name: str; size: int; }
type Entry = Leaf | Branch;

fn describe(items: []int): str {
    let out = "";
    for item in items {
        out = f"{out}{item},";
    }
    return out;
}

fn entryName(e: Entry): str {
    if e is Leaf { return e.name; }
    if e is Branch { return e.name; }
    return "";
}

fn compareStr(a: str, b: str): int {
    let n = a.length < b.length ? a.length : b.length;
    for (let i = 0; i < n; i++) {
        if a[i] != b[i] { return a[i] < b[i] ? -1 : 1; }
    }
    return a.length == b.length ? 0 : (a.length < b.length ? -1 : 1);
}

fn main(): int {
    let nums: []int = [5, 3, 9, 1, 3, 7, 0, 3];
    nums.sort((a: int, b: int) => a - b);
    fmt.println(f"ints     {describe(nums)}");
    nums.sort((a: int, b: int) => b - a);
    fmt.println(f"reversed {describe(nums)}");

    let empty: []int = [];
    empty.sort((a: int, b: int) => a - b);
    let one: []int = [42];
    one.sort((a: int, b: int) => a - b);
    fmt.println(f"small    {empty.length} {describe(one)}");

    let words: []str = ["pear", "apple", "fig", "apple", "banana"];
    words.sort((a: str, b: str) => compareStr(a, b));
    let joined = "";
    for w in words { joined = f"{joined}{w},"; }
    fmt.println(f"strs     {joined}");

    // Stable: equal keys keep their order (seq ascending within a key).
    let items: []Item = [];
    let nodes: []Node = [];
    for (let i = 0; i < 12; i++) {
        items.push(Item { key: (i * 7) % 4, seq: i });
        nodes.push(Node { key: (i * 5) % 3, seq: i });
    }
    items.sort((a: Item, b: Item) => a.key - b.key);
    let itemOut = "";
    for it in items { itemOut = f"{itemOut}{it.key}.{it.seq},"; }
    fmt.println(f"values   {itemOut}");
    nodes.sort((a: Node, b: Node) => a.key - b.key);
    let nodeOut = "";
    for n in nodes { nodeOut = f"{nodeOut}{n.key}.{n.seq},"; }
    fmt.println(f"refs     {nodeOut}");

    // A union of value structs, with a capturing comparator.
    let entries: []Entry = [];
    entries.push(Leaf { name: "c" });
    entries.push(Branch { name: "b", size: 2 });
    entries.push(Leaf { name: "a" });
    entries.push(Branch { name: "d", size: 1 });
    let calls: ref Box<int> = { value: 0 };
    entries.sort((a: Entry, b: Entry) => {
        calls.value += 1;
        return compareStr(entryName(a), entryName(b));
    });
    let entryOut = "";
    for e in entries { entryOut = f"{entryOut}{entryName(e)},"; }
    fmt.println(f"unions   {entryOut} {calls.value > 0}");

    // Many elements: sorted, and still the same multiset.
    let big: []int = [];
    let x = 12345;
    let sum = 0;
    for (let i = 0; i < 1000; i++) {
        x = (x * 1103515245 + 12345) % 2147483648;
        big.push(x % 100);
        sum += x % 100;
    }
    big.sort((a: int, b: int) => a - b);
    let ordered = true;
    let after = 0;
    for (let i = 0; i < big.length; i++) {
        after += big[i];
        if i > 0 && big[i - 1] > big[i] { ordered = false; }
    }
    fmt.println(f"big      {big.length} {ordered} {after == sum}");
    return 0;
}
""",
            """
ints     0,1,3,3,3,5,7,9,
reversed 9,7,5,3,3,3,1,0,
small    0 42,
strs     apple,apple,banana,fig,pear,
values   0.0,0.4,0.8,1.3,1.7,1.11,2.2,2.6,2.10,3.1,3.5,3.9,
refs     0.0,0.3,0.6,0.9,1.2,1.5,1.8,1.11,2.1,2.4,2.7,2.10,
unions   a,b,c,d, true
big      1000 true true
""");

        // The rewrite must not invent a candidate: a closure of the wrong shape
        // is an ordinary argument mismatch against array.map.
        s.compileFails(
            "array methods: a closure of the wrong arity does not match map",
            """
fn main(): int {
    let nums: mut []int = [];
    nums.push(1);
    let bad = nums.map((a: int, b: int) => a + b);
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.NoSuitableConversionFound)]);

        // A name that is neither a compiler built-in nor a function in the
        // `array` namespace is still just a missing member.
        s.compileFails(
            "array methods: an unknown array method is still an error",
            """
fn main(): int {
    let nums: mut []int = [];
    let bad = nums.frobnicate((v: int) => v);
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.DatatypeDoesNotHaveMemberNamed3)]);
    }
}
