// ============================================================================
// sys.cpuCount: how many threads of the program can truly run in parallel.
// Never a hardware figure: the CPUs of the process's affinity, lowered by a
// CPU quota of its container (cgroups v2 and v1 on Linux, a job object on
// Windows), a quota rounded up (docs/async-decisions.md S5-I9).
//
// - The affinity: the count follows it, also when it changes.
// - Real quotas (Linux): the case runs itself under
//   `systemd-run --user --scope -p CPUQuota=...`, which needs no privileges;
//   with Delegate=yes the child makes a cgroup of its own below the scope.
// - The parsing of /proc/self/cgroup, mountinfo and the quota files, for
//   layouts no machine here has (v1, hybrid, containers): made-up trees read
//   through hzstd_cgroup_cpu_limit, the function sys.cpuCount reads the real
//   ones with.
// ============================================================================

namespace cases_cpu_count {

    export fn register(s: mut testsuite.Suite) {

        s.run(
            "sys.cpuCount: as many CPUs as the affinity holds, read anew on every call",
            """
__c__("#ifdef _WIN32");
__c__("#include <windows.h>");
__c__("static hzstd_int_t hz_t_affinity(void) { DWORD_PTR p = 0; DWORD_PTR s = 0; GetProcessAffinityMask(GetCurrentProcess(), &p, &s); hzstd_int_t n = 0; for (; p != 0; p &= p - 1) { n++; } return n; }");
__c__("static void hz_t_limit_to_three(void) { SetProcessAffinityMask(GetCurrentProcess(), 7); }");
__c__("#else");
__c__("#include <sys/syscall.h>");
__c__("#include <unistd.h>");
__c__("static hzstd_int_t hz_t_affinity(void) { unsigned long m[64] = { 0 }; syscall(SYS_sched_getaffinity, 0, sizeof(m), m); hzstd_int_t n = 0; for (int i = 0; i < 64; i++) { n += __builtin_popcountl(m[i]); } return n; }");
__c__("static void hz_t_limit_to_three(void) { unsigned long m[64] = { 7 }; syscall(SYS_sched_setaffinity, 0, sizeof(m), m); }");
__c__("#endif");
extern C fn hz_t_affinity(): int :: final;
extern C fn hz_t_limit_to_three(): void :: final;

fn main(): int {
    fmt.println(f"as many as the affinity: {sys.cpuCount() == hz_t_affinity()}");
    hz_t_limit_to_three();
    fmt.println(f"three CPUs: {sys.cpuCount()}");
    return 0;
}
""",
            "as many as the affinity: true\nthree CPUs: 3");

        s.run(
            "sys.cpuCount: a cgroup's CPU quota, rounded up, the lowest of every level, below the affinity",
            """
__c__("#include <stdio.h>");
__c__("#include <string.h>");
__c__("#include <sys/stat.h>");
__c__("#include <sys/syscall.h>");
__c__("#include <unistd.h>");
__c__("static void hz_t_limit_to_three(void) { unsigned long m[64] = { 7 }; syscall(SYS_sched_setaffinity, 0, sizeof(m), m); }");
__c__("static int hz_t_write(const char *path, const char *text) { FILE *f = fopen(path, \\"w\\"); if (!f) { return 0; } int ok = fputs(text, f) >= 0; return fclose(f) == 0 && ok; }");
__c__("static int hz_t_own_cgroup(char *dir, size_t size) { char line[4096]; FILE *f = fopen(\\"/proc/self/cgroup\\", \\"r\\"); if (!f) { return 0; } int ok = fgets(line, sizeof(line), f) != NULL; fclose(f); if (!ok || strncmp(line, \\"0::\\", 3) != 0) { return 0; } line[strcspn(line, \\"\\\\n\\")] = 0; snprintf(dir, size, \\"/sys/fs/cgroup%s\\", line + 3); return 1; }");
__c__("static hzstd_int_t hz_t_has_quota_file(void) { char dir[4096]; char path[4200]; struct stat st; if (!hz_t_own_cgroup(dir, sizeof(dir))) { return 0; } snprintf(path, sizeof(path), \\"%s/cpu.max\\", dir); return stat(path, &st) == 0; }");
// Moves this process into a new cgroup below its own, with `quota` as that
// cgroup's cpu.max unless it is empty; the step that failed, or 0.
__c__("static hzstd_int_t hz_t_into_leaf(hzstd_str_t quota) { char dir[4096]; char path[4200]; char pid[32]; char max[64]; if (!hz_t_own_cgroup(dir, sizeof(dir))) { return 1; } snprintf(path, sizeof(path), \\"%s/leaf\\", dir); if (mkdir(path, 0755) != 0) { return 2; } snprintf(path, sizeof(path), \\"%s/leaf/cgroup.procs\\", dir); snprintf(pid, sizeof(pid), \\"%d\\", (int)getpid()); if (!hz_t_write(path, pid)) { return 3; } if (quota.length == 0) { return 0; } snprintf(path, sizeof(path), \\"%s/cgroup.subtree_control\\", dir); if (!hz_t_write(path, \\"+cpu\\")) { return 4; } snprintf(max, sizeof(max), \\"%.*s\\", (int)quota.length, quota.data); snprintf(path, sizeof(path), \\"%s/leaf/cpu.max\\", dir); if (!hz_t_write(path, max)) { return 5; } return 0; }");
extern C fn hz_t_limit_to_three(): void :: final;
extern C fn hz_t_has_quota_file(): int :: final;
extern C fn hz_t_into_leaf(quota: str): int :: final;

fn child(mode: str): int {
    if hz_t_has_quota_file() == 0 {
        fmt.print("no cpu.max: the user's cgroups have no cpu controller");
        return 1;
    }
    if mode == "three" {
        hz_t_limit_to_three();
    }
    else if mode == "leaf" {
        let step = hz_t_into_leaf("");
        if step != 0 {
            fmt.print(f"moving into a cgroup of its own failed at step {step}");
            return 1;
        }
    }
    else if mode != "plain" {
        let step = hz_t_into_leaf(mode);
        if step != 0 {
            fmt.print(f"moving into a cgroup of its own failed at step {step}");
            return 1;
        }
    }
    fmt.print(f"{sys.cpuCount()}");
    return 0;
}

fn show(label: str, value: str) {
    fmt.println(f"{label}: {value}");
}

fn under(exe: str, quota: str, mode: str): str {
    let r = process.runCaptured("systemd-run", ["--user", "--scope", "--quiet", "-p", "Delegate=yes", "-p", f"CPUQuota={quota}", exe, "child", mode]);
    if r.exitCode != 0 {
        return f"exit {r.exitCode}: {r.stdoutResult} {r.stderrResult}";
    }
    return r.stdoutResult;
}

fn main(): int {
    let args = sys.args();
    if args.length > 2 && args[1] == "child" {
        return child(args[2]);
    }
    let exe = args[0];
    show("150%", under(exe, "150%", "plain"));
    show("50%", under(exe, "50%", "plain"));
    show("100%", under(exe, "100%", "plain"));
    show("250%", under(exe, "250%", "plain"));
    show("1000% on three CPUs", under(exe, "1000%", "three"));
    show("150% on three CPUs", under(exe, "150%", "three"));
    show("a cgroup without a quota below 150%", under(exe, "150%", "leaf"));
    show("50% below 150%", under(exe, "150%", "50000 100000"));
    show("300% below 150%", under(exe, "150%", "300000 100000"));
    return 0;
}
""",
            "150%: 2\n50%: 1\n100%: 1\n250%: 3\n1000% on three CPUs: 3\n150% on three CPUs: 2\na cgroup without a quota below 150%: 2\n50% below 150%: 1\n300% below 150%: 2");
        s.onlyOn(sys.Platform.Linux, "cgroups and systemd-run exist only on Linux");

        s.run(
            "sys.cpuCount: cgroup v2 and v1 quotas found through /proc/self/cgroup and mountinfo, in made-up trees",
            """
__c__("#include <stdio.h>");
__c__("static hzstd_int_t hz_t_limit(hzstd_str_t dir) { char root[4096]; char cgroup[4200]; char mountinfo[4200]; snprintf(root, sizeof(root), \\"%.*s\\", (int)dir.length, dir.data); snprintf(cgroup, sizeof(cgroup), \\"%s/cgroup\\", root); snprintf(mountinfo, sizeof(mountinfo), \\"%s/mountinfo\\", root); hzstd_int_t limit = 0; return hzstd_cgroup_cpu_limit(cgroup, mountinfo, root, &limit) ? limit : -1; }");
extern C fn hz_t_limit(dir: str): int :: final;

fn workPath(name: str): str {
    let dir = env.get("HAZE_TEST_WORKDIR");
    if dir is str {
        return f"{dir}/{name}";
    }
    return f"/tmp/{name}";
}

fn show(label: str, value: str) {
    fmt.println(f"{label}: {value}");
}

// A made-up tree in `name`: its "cgroup" file (none when empty), its
// "mountinfo", and `files` as triples of directory, file name, content.
fn limitIn(name: str, cgroup: str, mountinfo: str, files: []str): str {
    let dir = workPath(f"cpu_count_cgroups/{name}");
    fs.createDirectory(dir);
    if cgroup.length > 0 {
        fs.writeText(f"{dir}/cgroup", cgroup);
    }
    fs.writeText(f"{dir}/mountinfo", mountinfo);
    for (let i = 0; i + 2 < files.length; i += 3) {
        fs.createDirectory(f"{dir}{files[i]}");
        fs.writeText(f"{dir}{files[i]}/{files[i + 1]}", files[i + 2]);
    }
    let limit = hz_t_limit(dir);
    return limit < 0 ? "none" : f"{limit}";
}

fn main(): int {
    let v2 = "30 1 0:26 / /sys/fs/cgroup rw,nosuid shared:4 - cgroup2 cgroup2 rw,nsdelegate\\n";
    let hybrid = "25 24 0:22 / /sys/fs/cgroup/unified rw,nosuid shared:5 - cgroup2 cgroup2 rw\\n33 24 0:30 / /sys/fs/cgroup/cpu,cpuacct rw,nosuid shared:12 - cgroup cgroup rw,cpu,cpuacct\\n";
    let hybridCgroup = "12:pids:/p\\n4:cpu,cpuacct:/docker/abc\\n1:name=systemd:/s\\n0::/u\\n";
    show("v2, the lowest of the levels", limitIn("a", "0::/a/b\\n", v2, ["/sys/fs/cgroup/a", "cpu.max", "100000 100000\\n", "/sys/fs/cgroup/a/b", "cpu.max", "max 100000\\n"]));
    show("v2, rounded up", limitIn("b", "0::/x\\n", v2, ["/sys/fs/cgroup/x", "cpu.max", "150000 100000\\n"]));
    show("v2 at a namespace's root", limitIn("c", "0::/\\n", v2, ["/sys/fs/cgroup", "cpu.max", "250000 100000\\n"]));
    show("v2 without a quota", limitIn("d", "0::/a\\n", v2, ["/sys/fs/cgroup/a", "cpu.max", "max 100000\\n"]));
    show("v1 beside an empty v2", limitIn("e", hybridCgroup, hybrid, ["/sys/fs/cgroup/cpu,cpuacct/docker/abc", "cpu.cfs_quota_us", "150000\\n", "/sys/fs/cgroup/cpu,cpuacct/docker/abc", "cpu.cfs_period_us", "100000\\n", "/sys/fs/cgroup/cpu,cpuacct/docker", "cpu.cfs_quota_us", "-1\\n", "/sys/fs/cgroup/cpu,cpuacct/docker", "cpu.cfs_period_us", "100000\\n", "/sys/fs/cgroup/unified/u", "cgroup.procs", "1\\n"]));
    show("v1 mounted at the container's cgroup", limitIn("f", "4:cpu,cpuacct:/docker/abc\\n", "33 24 0:30 /docker/abc /sys/fs/cgroup/cpu rw,nosuid - cgroup cgroup rw,cpuacct,cpu\\n", ["/sys/fs/cgroup/cpu", "cpu.cfs_quota_us", "250000\\n", "/sys/fs/cgroup/cpu", "cpu.cfs_period_us", "100000\\n"]));
    show("v1, the lowest of the levels", limitIn("g", "4:cpu,cpuacct:/docker/abc\\n", hybrid, ["/sys/fs/cgroup/cpu,cpuacct/docker/abc", "cpu.cfs_quota_us", "300000\\n", "/sys/fs/cgroup/cpu,cpuacct/docker/abc", "cpu.cfs_period_us", "100000\\n", "/sys/fs/cgroup/cpu,cpuacct/docker", "cpu.cfs_quota_us", "100000\\n", "/sys/fs/cgroup/cpu,cpuacct/docker", "cpu.cfs_period_us", "100000\\n"]));
    show("the lower of v1 and v2", limitIn("h", hybridCgroup, hybrid, ["/sys/fs/cgroup/cpu,cpuacct/docker/abc", "cpu.cfs_quota_us", "300000\\n", "/sys/fs/cgroup/cpu,cpuacct/docker/abc", "cpu.cfs_period_us", "100000\\n", "/sys/fs/cgroup/unified/u", "cpu.max", "100000 100000\\n"]));
    show("the lower of v2 and v1", limitIn("h2", hybridCgroup, hybrid, ["/sys/fs/cgroup/cpu,cpuacct/docker/abc", "cpu.cfs_quota_us", "100000\\n", "/sys/fs/cgroup/cpu,cpuacct/docker/abc", "cpu.cfs_period_us", "100000\\n", "/sys/fs/cgroup/unified/u", "cpu.max", "300000 100000\\n"]));
    show("an escaped mount point", limitIn("i", "0::/q\\n", "30 1 0:26 / /sys/fs/cgroup\\\\040x rw - cgroup2 cgroup2 rw\\n", ["/sys/fs/cgroup x/q", "cpu.max", "200000 100000\\n"]));
    show("a cgroup outside the mount", limitIn("j", "4:cpu:/other\\n", "33 24 0:30 /docker/abc /sys/fs/cgroup/cpu rw - cgroup cgroup rw,cpu\\n", ["/sys/fs/cgroup/cpu", "cpu.cfs_quota_us", "100000\\n", "/sys/fs/cgroup/cpu", "cpu.cfs_period_us", "100000\\n"]));
    show("the mount that holds the cgroup", limitIn("k", "0::/a\\n", "40 1 0:26 /sub /mnt/part rw - cgroup2 cgroup2 rw\\n30 1 0:26 / /sys/fs/cgroup rw - cgroup2 cgroup2 rw\\n", ["/mnt/part", "cpu.max", "100000 100000\\n", "/sys/fs/cgroup/a", "cpu.max", "300000 100000\\n"]));
    show("no cgroup file", limitIn("l", "", v2, ["/sys/fs/cgroup", "cpu.max", "100000 100000\\n"]));
    return 0;
}
""",
            "v2, the lowest of the levels: 1\nv2, rounded up: 2\nv2 at a namespace's root: 3\nv2 without a quota: none\nv1 beside an empty v2: 2\nv1 mounted at the container's cgroup: 3\nv1, the lowest of the levels: 1\nthe lower of v1 and v2: 1\nthe lower of v2 and v1: 1\nan escaped mount point: 2\na cgroup outside the mount: none\nthe mount that holds the cgroup: 3\nno cgroup file: none");
        s.onlyOn(sys.Platform.Linux, "cgroups exist only on Linux");

        // A hard cap of 1.5 CPUs: CpuRate is a share of every processor of
        // the machine in hundredths of a percent, rounded up here so that the
        // cap is at least 1.5 CPUs and below 1.5 plus a hair.
        s.run(
            "sys.cpuCount: a job object's hard CPU cap, rounded up",
            """
__c__("#include <windows.h>");
__c__("static hzstd_int_t hz_t_cap_at_one_and_a_half(void) { DWORD n = GetActiveProcessorCount(ALL_PROCESSOR_GROUPS); HANDLE job = CreateJobObjectW(NULL, NULL); if (!job) { return 1; } JOBOBJECT_CPU_RATE_CONTROL_INFORMATION rate; ZeroMemory(&rate, sizeof(rate)); rate.ControlFlags = JOB_OBJECT_CPU_RATE_CONTROL_ENABLE | JOB_OBJECT_CPU_RATE_CONTROL_HARD_CAP; rate.CpuRate = (15000 + n - 1) / n; if (!SetInformationJobObject(job, JobObjectCpuRateControlInformation, &rate, sizeof(rate))) { return 2; } if (!AssignProcessToJobObject(job, GetCurrentProcess())) { return 3; } return 0; }");
extern C fn hz_t_cap_at_one_and_a_half(): int :: final;

fn main(): int {
    let step = hz_t_cap_at_one_and_a_half();
    if step != 0 {
        fmt.println(f"setting up the job failed at step {step}");
        return 0;
    }
    fmt.println(f"1.5 CPUs: {sys.cpuCount()}");
    return 0;
}
""",
            "1.5 CPUs: 2");
        s.onlyOn(sys.Platform.Win32, "job objects exist only on Windows");
    }
}
