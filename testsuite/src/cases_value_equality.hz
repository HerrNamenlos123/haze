// Regression coverage for VALUE-BASED equality: `==`/`!=` dispatch to a
// user-defined operator when one exists, and are otherwise autogenerated
// member by member and recursive.
//
// The rules being pinned down here (see Conversion.typeSupportsComparison and
// Elaborate.expandStructuralComparison):
//
//   - Equality compares CONTENTS, never addresses. This replaced reference
//     identity: two distinct `ref struct`s with equal fields used to compare
//     UNEQUAL, and that is exactly the trap this suite exists to keep shut --
//     it silently disabled every props-equality check in ui_components for as
//     long as it existed. Identity is a separate concept and has no spelling
//     yet.
//   - Autogeneration is all-or-nothing per type: a struct that declares either
//     operator gets neither generated, so a type that defines only
//     `operator!=` deliberately has no `==`.
//   - It recurses THROUGH the normal comparison path, so a member type's own
//     operator is used for that member.
//   - A member that is not comparable makes its whole enclosing type not
//     comparable, however deeply it is nested.
//   - Opaque and self-referential types never get it.

namespace cases_value_equality {

    export fn register(s: mut testsuite.Suite) {

        // ── The basics, and the recursion ────────────────────────────────
        s.run(
            "value equality: memberwise, recursive, and by contents",
            """
struct Inner { x: int = 0; s: str = ""; }
struct Outer { a: int = 0; inner: Inner = {}; flag: bool = false; }
struct Empty {}
enum Kind { A, B }
struct WithEnum { k: Kind; }
struct WithReal { r: real = 0.0; }

fn main(): int {
    let o1 = Outer { a: 1, inner: { x: 2, s: "hi" }, flag: true };
    let o2 = Outer { a: 1, inner: { x: 2, s: "hi" }, flag: true };
    fmt.println(f"{o1 == o2}");
    fmt.println(f"{o1 != o2}");

    // Differing only in the innermost member, and only by string CONTENTS --
    // two separately built strings, so a pointer comparison would call these
    // equal.
    let o3 = Outer { a: 1, inner: { x: 2, s: "h" + "I" }, flag: true };
    fmt.println(f"{o1 == o3}");
    fmt.println(f"{o1 != o3}");

    // ... and differing only in the outermost member.
    let o4 = Outer { a: 9, inner: { x: 2, s: "hi" }, flag: true };
    fmt.println(f"{o1 == o4}");

    // A bool member is enough on its own.
    let o5 = Outer { a: 1, inner: { x: 2, s: "hi" }, flag: false };
    fmt.println(f"{o1 == o5}");

    // Same string contents built two different ways.
    let s1 = Inner { x: 0, s: "abc" };
    let s2 = Inner { x: 0, s: "a" + "bc" };
    fmt.println(f"{s1 == s2}");

    // A struct with no members has exactly one value.
    let e1 = Empty {};
    let e2 = Empty {};
    fmt.println(f"{e1 == e2}");
    fmt.println(f"{e1 != e2}");

    let k1 = WithEnum { k: Kind.A };
    let k2 = WithEnum { k: Kind.A };
    let k3 = WithEnum { k: Kind.B };
    fmt.println(f"{k1 == k2}");
    fmt.println(f"{k1 == k3}");

    let r1 = WithReal { r: 1.5 };
    let r2 = WithReal { r: 1.5 };
    let r3 = WithReal { r: 1.6 };
    fmt.println(f"{r1 == r2}");
    fmt.println(f"{r1 == r3}");
    return 0;
}
""",
            """
true
false
false
true
false
false
true
true
false
true
false
true
false
""");

        // ── Contents, not addresses ──────────────────────────────────────
        s.run(
            "value equality: storage class does not change the answer",
            """
ref struct RefBox { v: int = 0; s: str = ""; }
struct ValBox { v: int = 0; }

fn main(): int {
    // Two DISTINCT heap objects with equal contents. Under the old
    // reference-identity rule this printed false, which is the bug this case
    // exists for.
    let r1 = RefBox { v: 5, s: "x" };
    let r2 = RefBox { v: 5, s: "x" };
    fmt.println(f"{r1 == r2}");
    fmt.println(f"{r1 != r2}");

    let r3 = RefBox { v: 6, s: "x" };
    fmt.println(f"{r1 == r3}");

    // A stackref reaches the same verdict as a ref: both compare what they
    // point AT.
    let stackref sv = ValBox { v: 7 };
    let stackref sv2 = ValBox { v: 7 };
    let stackref sv3 = ValBox { v: 8 };
    fmt.println(f"{sv == sv2}");
    fmt.println(f"{sv == sv3}");
    return 0;
}
""",
            """
true
false
false
true
false
""");

        // ── User operators win, and are used by enclosing autogen ─────────
        s.run(
            "value equality: a declared operator wins, including for members",
            """
// Deliberately disagrees with what memberwise equality would say, so the test
// can tell which one actually ran: only `id` counts, `noise` is ignored.
struct ById {
    id: int = 0;
    noise: int = 0;
    fn operator==(other: ById): bool {
        return this.id == other.id;
    }
}

// The interesting case: Holder gets an AUTOGENERATED comparison, and that
// generated code must route the `key` member through ById's own operator
// rather than comparing ById's fields itself.
struct Holder { tag: int = 0; key: ById = {}; }

fn main(): int {
    let a = ById { id: 1, noise: 100 };
    let b = ById { id: 1, noise: 999 };
    fmt.println(f"{a == b}");

    let c = ById { id: 2, noise: 100 };
    fmt.println(f"{a == c}");

    // Same question one level up: differing only in the ignored member.
    let h1 = Holder { tag: 7, key: { id: 1, noise: 100 } };
    let h2 = Holder { tag: 7, key: { id: 1, noise: 999 } };
    fmt.println(f"{h1 == h2}");

    // The autogenerated part still does its job for the other member.
    let h3 = Holder { tag: 8, key: { id: 1, noise: 100 } };
    fmt.println(f"{h1 == h3}");

    // ... and the operator still decides its own member.
    let h4 = Holder { tag: 7, key: { id: 2, noise: 100 } };
    fmt.println(f"{h1 == h4}");
    return 0;
}
""",
            """
true
false
true
false
false
""");

        // ── Fixed arrays ─────────────────────────────────────────────────
        s.run(
            "value equality: fixed arrays compare element-wise",
            """
struct Cell { v: int = 0; }
struct HasFixed { xs: [4]int; }
struct HasStructs { cs: [2]Cell; }

fn main(): int {
    let a = HasFixed { xs: [1, 2, 3, 4] };
    let b = HasFixed { xs: [1, 2, 3, 4] };
    fmt.println(f"{a == b}");
    fmt.println(f"{a != b}");

    // Differing in the first element, and separately in the last, so an
    // off-by-one in the unrolled walk cannot pass.
    let c = HasFixed { xs: [9, 2, 3, 4] };
    let d = HasFixed { xs: [1, 2, 3, 9] };
    fmt.println(f"{a == c}");
    fmt.println(f"{a == d}");

    // Element type that is itself a struct: the walk recurses.
    let e = HasStructs { cs: [{ v: 1 }, { v: 2 }] };
    let g = HasStructs { cs: [{ v: 1 }, { v: 2 }] };
    let h = HasStructs { cs: [{ v: 1 }, { v: 3 }] };
    fmt.println(f"{e == g}");
    fmt.println(f"{e == h}");
    return 0;
}
""",
            """
true
false
false
false
true
false
""");

        // ── Callables and optionals ──────────────────────────────────────
        s.run(
            "value equality: callables compare as {fn, env}",
            """
struct HasFn { id: int = 0; f?: (x: int) => none; }

fn main(): int {
    // One callable VALUE handed to both: same function, same environment.
    let shared = (x: int) => { };
    let a = HasFn { id: 1, f: shared };
    let b = HasFn { id: 1, f: shared };
    fmt.println(f"{a == b}");

    // Two lambdas written out separately are different environments, so they
    // are not equal -- which is precisely why a handler rebuilt every render
    // never compares equal to last render's.
    let c = HasFn { id: 1, f: (x: int) => { } };
    let d = HasFn { id: 1, f: (x: int) => { } };
    fmt.println(f"{c == d}");

    // The optional member's absence compares too (union tag, then payload).
    let e = HasFn { id: 1 };
    let g = HasFn { id: 1 };
    fmt.println(f"{e == g}");
    fmt.println(f"{e == a}");
    fmt.println(f"{e != a}");

    // A bare callable, outside any struct.
    let f1 = shared;
    fmt.println(f"{f1 == shared}");
    return 0;
}
""",
            """
true
false
true
false
true
true
""");

        // ── Non-comparable members poison the enclosing type ─────────────
        s.compileFails(
            "value equality: a dynamic-array member makes the struct incomparable",
            """
struct HasArray { xs: []int = []; }
fn main(): int {
    let a = HasArray {};
    let b = HasArray {};
    fmt.println(f"{a == b}");
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.NoSafeComparisonAvailableBetweenTypesAnd2)]);

        s.compileFails(
            "value equality: incomparability propagates through nesting",
            """
struct Deep { xs: []int = []; }
struct Middle { d: Deep = {}; }
struct Top { m: Middle = {}; ok: int = 0; }
fn main(): int {
    let a = Top {};
    let b = Top {};
    fmt.println(f"{a == b}");
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.NoSafeComparisonAvailableBetweenTypesAnd2)]);

        s.compileFails(
            "value equality: a cptr member makes the struct incomparable",
            """
struct HasPtr { p: cptr = none; }
fn main(): int {
    let a = HasPtr {};
    let b = HasPtr {};
    fmt.println(f"{a == b}");
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.NoSafeComparisonAvailableBetweenTypesAnd2)]);

        s.compileFails(
            "value equality: a bare dynamic array is not comparable",
            """
fn main(): int {
    let a: []int = [];
    let b: []int = [];
    fmt.println(f"{a == b}");
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.NoSafeComparisonAvailableBetweenTypesAnd2)]);

        // ── Self-reference ───────────────────────────────────────────────
        s.compileFails(
            "value equality: a self-referential type gets no autogenerated comparison",
            """
ref struct Node { v: int = 0; next?: Node; }
fn main(): int {
    let a = Node { v: 1 };
    let b = Node { v: 1 };
    fmt.println(f"{a == b}");
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.NoSafeComparisonAvailableBetweenTypesAnd2)]);

        s.compileFails(
            "value equality: mutual recursion is caught as well as direct",
            """
ref struct A { b?: B; }
ref struct B { a?: A; }
fn main(): int {
    let x = A {};
    let y = A {};
    fmt.println(f"{x == y}");
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.NoSafeComparisonAvailableBetweenTypesAnd2)]);

        // ── All-or-nothing autogeneration ────────────────────────────────
        s.compileFails(
            "value equality: declaring only operator!= means there is no ==",
            """
struct OnlyNe {
    x: int = 0;
    fn operator!=(o: OnlyNe): bool { return this.x != o.x; }
}
fn main(): int {
    let a = OnlyNe {};
    let b = OnlyNe {};
    fmt.println(f"{a == b}");
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.NoSafeComparisonAvailableBetweenTypesAnd2)]);

        s.compileFails(
            "value equality: declaring only operator== means there is no !=",
            """
struct OnlyEq {
    x: int = 0;
    fn operator==(o: OnlyEq): bool { return this.x == o.x; }
}
fn main(): int {
    let a = OnlyEq {};
    let b = OnlyEq {};
    fmt.println(f"{a != b}");
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.NoSafeComparisonAvailableBetweenTypesAnd2)]);

        s.compileFails(
            "value equality: two different struct types never compare",
            """
struct A { x: int = 0; }
struct B { x: int = 0; }
fn main(): int {
    let a = A {};
    let b = B {};
    fmt.println(f"{a == b}");
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.NoSafeComparisonAvailableBetweenTypesAnd2)]);

        // ── An incomparable member is fine as long as nobody compares ────
        s.run(
            "value equality: an incomparable type is only an error where it is compared",
            """
struct HasArray { xs: []int = []; tag: int = 0; }
fn main(): int {
    // Building, copying and reading it is unaffected -- only `==`/`!=` are.
    let a = HasArray { xs: [1, 2], tag: 5 };
    let b = a;
    fmt.println(f"{b.tag}");
    fmt.println(f"{b.xs.length}");
    return 0;
}
""",
            """
5
2
""");
    }
}
