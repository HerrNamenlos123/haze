// ============================================================================
// The hidden context (Axiom C209-C214, C390-C406, C468-C477, C567-C569).
//
// Every Haze function receives its caller's context, and `context` names it,
// like `this`. In C the context holds hidden runtime data (the task and its
// thread) and the settings; in Haze `context` is only the settings (allocator,
// logger, two user boxes): reading it copies them, writing it (a member, or the
// whole value) goes through to the current context (C567), and no reference to
// it can be formed. `context.clone(body)` runs a body under a copy and gives
// the caller's own context back afterwards (C397). Assigning or cloning carries
// settings only, never the runtime data (C474). An `extern C` function defined
// in Haze takes the context as its first C parameter, which C passes (C401),
// and has `context` like every Haze function (C402). C makes a context for the
// current thread with hzstd_context_for_current_thread (C504); on a thread Haze
// does not manage that panics (C505). A closure runs under the context of
// whoever calls it.
//
// The runtime cases observe which context code runs under through user box 1:
// `held()` reports the integer the caller's context holds, `setHeld(n)` changes
// it (a member write), `setHeldWhole(n)` changes it by assigning the whole
// context. Each observation runs under its own value, so a callee handed the
// wrong context (the root one, a stale one, its creator's) cannot pass by
// accident. The runtime data is observed with `sys.threadId()` and inline C on
// `sys.contextPtr()`.
//
// Written from the contract before the implementation and shown to fail
// without it. Do not weaken a case to make an implementation pass.
// Function types with and without a context: cases_extern_c_function_types.hz.
// ============================================================================

namespace cases_context {

    export fn register(s: mut testsuite.Suite) {

        s.run(
            "context: copies, whole assignment, clone, panics, closures, every kind of call, extern C entry, member names",
            """
ref struct Checks {
    checks: int = 0;
    failures: int = 0;

    mut fn check(name: str, ok: bool) {
        this.checks = this.checks + 1;
        if !ok {
            this.failures = this.failures + 1;
            fmt.println(f"FAIL: {name}");
        }
    }
}

// ── observing the context ───────────────────────────────────────────────────
// The integer a context holds in user box 1; an empty box reads as 0.
fn heldOf(c: Context): int {
    let v = sys.userBoxValue<int>(c.userBox1);
    if v is int {
        return v;
    }
    return 0;
}

fn withHeld(c: Context, n: int): Context {
    let copy = c;
    copy.userBox1 = sys.makeUserBox(n);
    return copy;
}

// The caller's context: a function runs under the context of its caller.
fn held(): int {
    return heldOf(context);
}

// Changes the caller's context: a member write goes through (C567).
fn setHeld(n: int) {
    context.userBox1 = sys.makeUserBox(n);
}

// The same by assigning the whole context, from a modified copy (C567, C473).
fn setHeldWhole(n: int) {
    let c = context;
    c.userBox1 = sys.makeUserBox(n);
    context = c;
}

fn snapshot(): Context { return context; }

struct CtxHolder { ctx: Context; }
struct Pair { a: int = 0; b: int = 0; }
type IntFn = () => int;

// ── 1. copies, whole assignment, Context() ──────────────────────────────────
fn tValues(t: mut Checks) {
    t.check("Context() has empty user boxes", heldOf(Context()) == 0 && sys.userBoxValue<int>(Context().userBox2) is none);
    setHeld(1);
    t.check("a callee's write goes through to its caller's context", held() == 1);
    let c = context;
    setHeld(2);
    t.check("let c = context is a copy: a later write to context does not reach it", heldOf(c) == 1 && held() == 2);
    let d = context;
    d.userBox1 = sys.makeUserBox<int>(99);
    t.check("writing the copy does not change context", held() == 2 && heldOf(d) == 99);
    context = d;
    t.check("context = c copies the settings", held() == 99);
    d = withHeld(d, 3);
    t.check("after context = c, the two stay separate", held() == 99 && heldOf(d) == 3);
    context = Context();
    t.check("context = Context() gives the defaults", held() == 0);
    setHeld(4);
    let holder = CtxHolder { ctx: context };
    let list: []Context = [context, Context()];
    let returned = snapshot();
    setHeld(5);
    t.check("stored in a field, an array, returned: copies", heldOf(holder.ctx) == 4 && heldOf(list[0]) == 4 && heldOf(list[1]) == 0 && heldOf(returned) == 4);
    let snap = context;
    let captured = () => { return heldOf(snap); };
    setHeld(6);
    t.check("a captured context value is a copy", captured() == 5 && held() == 6);

    // C567: assigning the whole context, and one field of it, inside a callee
    // changes the caller's.
    setHeldWhole(7);
    t.check("a callee assigning the whole context changes its caller's", held() == 7);
    setHeld(8);
    t.check("a callee assigning one field changes its caller's", held() == 8);
    let before = context;
    setHeldWhole(9);
    t.check("whole assignment replaces every setting, member write keeps the others", held() == 9 && heldOf(before) == 8);
}

// ── 2. context.clone ────────────────────────────────────────────────────────
fn arrowBody(): int {
    setHeld(16);
    return held() + 2;
}

fn tClone(t: mut Checks) {
    setHeld(10);
    context.clone(() => {
        t.check("clone: the body starts with a copy of the current context", held() == 10);
        setHeld(11);
        t.check("clone: a write inside is visible inside", held() == 11);
    });
    t.check("clone: a write inside is gone after it", held() == 10);

    let nested = context.clone(() => {
        setHeld(20);
        let deeper = context.clone(() => {
            setHeld(30);
            return held();
        });
        return deeper * 100 + held();
    });
    t.check("clone: nested clones each give their caller's context back", nested == 3020 && held() == 10);

    let pair = context.clone((): Pair => {
        setHeld(12);
        return Pair { a: held(), b: 7 };
    });
    t.check("clone: returns the body's struct", pair.a == 12 && pair.b == 7 && held() == 10);

    let nothing = context.clone(() => { setHeld(13); });
    t.check("clone: a body returning none", nothing is none && held() == 10);

    let body = () => {
        setHeld(14);
        return held() + 1;
    };
    t.check("clone: a closure value as the body", context.clone(body) == 15 && held() == 10);

    let fp: () -> int = arrowBody;
    t.check("clone: a -> function value as the body", context.clone(fp) == 18 && held() == 10);

    t.check("clone: a -> literal as the body", context.clone((): int -> { setHeld(17); return held(); }) == 17 && held() == 10);

    let direct = context.clone(() => {
        context = withHeld(context, 19);
        return held();
    });
    t.check("clone: the body's own `context` is the copy", direct == 19 && held() == 10);

    // The body is an immediate argument: narrowing reaches into it.
    let maybe: Pair | none = Pair { a: 1, b: 2 };
    if maybe is Pair {
        t.check("clone: narrowing flows into the body", context.clone(() => { return maybe.b; }) == 2);
    }
}

// ── 3. a panic inside clone ─────────────────────────────────────────────────
fn tPanic(t: mut Checks) {
    setHeld(10);
    let recovered = attempt {
        context.clone(() => {
            setHeld(66);
            if held() == 66 {
                sys.panic("boom inside clone");
            }
        });
        0
    } recover e {
        1
    };
    t.check("panic in clone: recovered", recovered == 1);
    t.check("panic in clone: the outer context is intact", held() == 10);

    let mid = context.clone(() => {
        setHeld(70);
        let r = attempt {
            context.clone(() => {
                setHeld(71);
                if held() == 71 {
                    sys.panic("boom inside a nested clone");
                }
            });
            0
        } recover e {
            1
        };
        return held() * 10 + r;
    });
    t.check("panic in a nested clone, recovered in the outer one: its context is intact", mid == 701 && held() == 10);
}

// ── 4. closures run under the context of whoever calls them ─────────────────
fn makeReader(): IntFn {
    setHeld(held() + 1000);
    return () => { return held(); };
}

fn tClosures(t: mut Checks) {
    setHeld(10);
    let stored = context.clone((): IntFn => {
        setHeld(100);
        return () => { return held(); };
    });
    t.check("a stored closure sees its caller's context, not its creator's", stored() == 10);
    t.check("a stored closure called inside a clone sees the clone's", context.clone(() => { setHeld(200); return stored(); }) == 200);

    let made = context.clone(() => { return makeReader(); });
    t.check("a closure returned from a callee sees its caller's context", made() == 10);

    let reader = () => {
        let c = context;
        return heldOf(c);
    };
    t.check("a lambda's `context` is its caller's", reader() == 10);
    t.check("a lambda's `context` is never the outer one captured", context.clone(() => { setHeld(300); return reader(); }) == 300);

    let writer = () => { context = withHeld(context, 400); };
    t.check("a lambda assigning `context` changes its caller's", context.clone(() => { writer(); return held(); }) == 400 && held() == 10);

    let outer = () => {
        let inner = () => { return held(); };
        return context.clone(() => { setHeld(500); return inner(); });
    };
    t.check("nested lambdas: each runs under its caller's", outer() == 500 && held() == 10);
}

// ── 5. every kind of call hands the callee the caller's context ─────────────
struct Other { v: int = 0; }

struct Probe {
    v: int = 0;
    fn seen(): int { return held() + this.v; }
    fn constructor(x: int): Probe { return Probe { v: held() + x }; }
    fn operator<(o: Probe): bool { return held() == o.v; }
    fn operator as(): Other { return Other { v: held() + this.v }; }
}

struct EqInner {
    x: int = 0;
    fn operator==(o: EqInner): bool { return held() == o.x; }
}
struct EqOuter { inner: EqInner = {}; }

ref struct Counter {
    n: int = 0;
    fn seen(): int { return held() + this.n; }
}

struct Gen<T> {
    v: T;
    fn seen(): int { return held(); }
}

fn seenFree(): int { return held(); }
fn seenGeneric<T>(x: T): int { return held(); }
fn viaTwoLevels(): int { return seenFree(); }

fn tCalls(t: mut Checks) {
    setHeld(10);
    context.clone(() => {
        setHeld(500);
        let p = Probe { v: 1 };
        t.check("method", p.seen() == 501);
        t.check("constructor", Probe(2).v == 502);
        t.check("operator", p < Probe { v: 500 });
        let o: Other = p;
        t.check("implicit conversion (operator as)", o.v == 501);
        t.check("explicit conversion (operator as)", (p as Other).v == 501);
        t.check("== reaching a member's operator", EqOuter { inner: { x: 500 } } == EqOuter { inner: { x: 500 } });
        t.check("generic function", seenGeneric<int>(1) == 500 && seenGeneric("s") == 500);
        t.check("method of a generic struct", Gen<int> { v: 1 }.seen() == 500);
        t.check("passed along two levels", viaTwoLevels() == 500);
        let cl = () => { return held(); };
        t.check("closure", cl() == 500);
        let fp: () -> int = seenFree;
        t.check("-> function value", fp() == 500);
        let fl = (): int -> { return held(); };
        t.check("-> literal", fl() == 500);
        let c = Counter { n: 3 };
        let bm = c.seen;
        t.check("bound method", bm() == 503);
        let stackref sp = Probe { v: 4 };
        let sm = sp.seen;
        t.check("bound method on a stackref receiver (stackref callable)", sm() == 504);
        let stackref sc = () => { return held(); };
        t.check("in-place (stackref) lambda", sc() == 500);
        let comp = rx.computed(() => { return held() + 1; });
        t.check("f-string formatting (a computed read inside the formatter)", f"{comp}" == "501");
    });
    t.check("calls: the caller's context is back after the clone", held() == 10);
}

// ── 6. extern C functions defined in Haze take the context first ────────────
// C passes the context (C401); the body has `context` like every Haze function
// and can call any Haze code (C402).
extern C fn enterFromC(add: int): int {
    setHeld(held() + add);
    return held();
}

extern C fn describeFromC(): int {
    return sys.threadId() * 1000 + held();
}

// Calls enterFromC from C with this function's own context pointer.
fn callThroughC(add: int): int {
    let p = sys.contextPtr();
    let r = 0;
    do unsafe { __c__("r = enterFromC((hzstd_context_t *)p, add);"); };
    return r;
}

// C504: a context made by hzstd for the current thread, handed to an extern C
// function. The calling Haze function's settings are not part of it.
fn callWithFreshContext(): int {
    let r = 0;
    do unsafe { __c__("hzstd_context_t fresh = hzstd_context_for_current_thread(); r = describeFromC(&fresh);"); };
    return r;
}

fn tExternC(t: mut Checks) {
    setHeld(10);
    t.check("extern C called from Haze: the body runs under the caller's context", enterFromC(1) == 11 && held() == 11);
    t.check("extern C called from C with sys.contextPtr(): the body sees the caller's user box", callThroughC(2) == 13 && held() == 13);
    context.clone(() => {
        setHeld(700);
        t.check("round trip: Haze -> C -> extern C -> Haze, inside a clone", callThroughC(2) == 702 && held() == 702);
    });
    t.check("extern C: the clone's write did not reach the caller", held() == 13);
    t.check("C504: a fresh context on the main thread has thread id 1 and empty user boxes", callWithFreshContext() == 1000);
    t.check("C504: the caller's context is untouched", held() == 13);
}

// ── 6b. the runtime data: derived, never assigned (C474-C477, C209) ─────────
fn addressOf(p: cptr): int {
    let n = 0;
    do unsafe { __c__("n = (hzstd_int_t)(intptr_t)p;"); };
    return n;
}

fn taskOf(): int {
    let p = sys.contextPtr();
    let n = 0;
    do unsafe { __c__("n = (hzstd_int_t)(intptr_t)((hzstd_context_t *)p)->task;"); };
    return n;
}

fn calleePtr(): int {
    return addressOf(sys.contextPtr());
}

fn tRuntimeData(t: mut Checks) {
    let thread = sys.threadId();
    let task = taskOf();
    t.check("the main thread has id 1", thread == 1);
    t.check("a task exists", task != 0);

    let saved = context;
    setHeld(41);
    context = Context();
    t.check("context = Context() changes the settings", held() == 0);
    t.check("context = Context() leaves the thread id and the task", sys.threadId() == thread && taskOf() == task);
    context = saved;
    t.check("context = c restores the settings", held() == heldOf(saved));
    t.check("context = c leaves the thread id and the task", sys.threadId() == thread && taskOf() == task);

    let inClone = context.clone(() => {
        setHeld(42);
        let pair: []int = [sys.threadId(), taskOf()];
        return pair;
    });
    t.check("context.clone keeps the thread id and the task", inClone[0] == thread && inClone[1] == task);

    let mine = addressOf(sys.contextPtr());
    t.check("C209: a callee's contextPtr is its caller's", calleePtr() == mine);
    let cl = () => { return addressOf(sys.contextPtr()); };
    t.check("C209: a closure's contextPtr is its caller's", cl() == mine);
    let cloned = context.clone(() => {
        let inside = addressOf(sys.contextPtr());
        let triple: []int = [inside, calleePtr(), cl()];
        return triple;
    });
    t.check("C209: inside context.clone the context is another one, handed on to callees", cloned[0] != mine && cloned[1] == cloned[0] && cloned[2] == cloned[0]);
}

// ── 6c. the default settings (C398, C479) ───────────────────────────────────
fn tDefaults(t: mut Checks) {
    let fresh = Context();
    let ok = false;
    do unsafe {
        __c__("ok = fresh.allocator.allocate != NULL && fresh.logger.write != NULL && fresh.logger.state == NULL && fresh.userBox1.value == NULL && fresh.userBox2.value == NULL;");
    };
    t.check("Context(): an allocator, the default logger, empty user boxes", ok);
    let same = false;
    do unsafe {
        __c__("same = fresh.logger.write == hzstd_context_settings_default().logger.write && fresh.allocator.allocate == hzstd_make_heap_allocator().allocate;");
    };
    t.check("Context() is hzstd's default settings", same);
}

// ── 6d. sys.log goes through the context's logger ───────────────────────────
// The logger's write function is an `extern C` function defined in Haze: its C
// type (context, state, text, returning none) is exactly the logger's `write`,
// so C assigns it without a cast (a mismatch fails to compile).
extern C fn captureLine(state: cptr, text: str) {
    do unsafe {
        let sink: mut ref Box<str> = uninitialized;
        __c__("sink = state;");
        sink.value = sink.value + f"{text}{held()}|";
    };
}

fn installLogger(sink: ref Box<str>) {
    let p = sys.contextPtr();
    let st = none as cptr;
    do unsafe {
        __c__("st = sink;");
        __c__("hzstd_context_t *c = (hzstd_context_t *)p; c->settings.logger.write = captureLine; c->settings.logger.state = st;");
    };
}

fn logDeeper() {
    sys.log("deep");
}

fn tLog(t: mut Checks) {
    let saved = context;
    setHeld(1);
    let outer: ref Box<str> = { value: "" };
    let inner: ref Box<str> = { value: "" };
    installLogger(outer);
    sys.log("a");
    context.clone(() => {
        setHeld(5);
        installLogger(inner);
        sys.log("b");
        logDeeper();
    });
    sys.log("c");
    t.check("sys.log writes through the logger of the context it runs under, with that context", outer.value == "a1|c1|" && inner.value == "b5|deep5|");
    context = saved;
}

// ── 7. `context` stays an ordinary name for members ─────────────────────────
struct Named {
    context: int = 5;
    fn both(): int { return this.context * 1000 + heldOf(context); }
}
struct WithMethod {
    n: int = 1;
    fn context(): int { return this.n + 1; }
}

fn tNames(t: mut Checks) {
    setHeld(7);
    let named = Named {};
    t.check("a field named context", named.context == 5);
    named.context = 6;
    t.check("x.context assigns the field", named.context == 6);
    t.check("bare `context` in a method of a struct with such a field is the context", named.both() == 6007);
    t.check("a method named context", WithMethod {}.context() == 2);
}

fn main(): int {
    let t = Checks {};
    t.check("main starts under the root context, with the defaults", held() == 0);
    tValues(t);
    tClone(t);
    tPanic(t);
    tClosures(t);
    tCalls(t);
    tExternC(t);
    tRuntimeData(t);
    tDefaults(t);
    tLog(t);
    tNames(t);
    if t.failures > 0 {
        fmt.println(f"{t.failures} of {t.checks} checks FAILED");
        return 1;
    }
    fmt.println(f"all {t.checks} checks passed");
    return 0;
}
""",
            "all 74 checks passed");

        // The profiler writes its progress to stdout, so the allocation count is
        // asserted rather than compared as output (see cases_immediate.hz).
        s.runExitCode(
            "context: clone with a lambda literal body, and an extern C entry, allocate nothing",
            """
// The caller's context, observed without allocating: a raw integer kept in a
// field of its settings, read and written through the context pointer.
fn held(): int {
    let p = sys.contextPtr();
    let v = 0;
    do unsafe { __c__("v = ((hzstd_context_t *)p)->settings.userBox2.fingerprint;"); };
    return v;
}

fn setHeld(n: int) {
    let p = sys.contextPtr();
    do unsafe { __c__("((hzstd_context_t *)p)->settings.userBox2.fingerprint = n;"); };
}

extern C fn enter(n: int): int {
    setHeld(n);
    return held();
}

fn main(): int {
    let a = 1;
    let p = Profiler({ samplingRate: 0, memoryInstrumentation: true, memoryInstrumentationStacktraces: false });
    let total = 0;
    for (let i = 0; i < 50; i++) {
        let b = i;
        total = total + context.clone(() => {
            setHeld(b);
            return a + held();
        });
        total = total + context.clone(() => enter(b + 1));
    }
    let result = p.stop();
    assert(total == 2550, f"wrong total {total}");
    assert(held() == 0, "the caller's context changed");
    // The Profiler object itself is the one allocation inside the window.
    assert(result.memoryInstrumentationFrames.length == 1, f"expected no allocations from clone or the entry, got {result.memoryInstrumentationFrames.length - 1}");
    return 0;
}
""",
            0);

        // A generic exported function is re-emitted into the consumer as source and
        // elaborated there, so `context` and `context.clone` in its body have to
        // survive Export.ts (DEVELOPMENT.md: the most common bug shape).
        s.runWithModules(
            "context: calls, closures, clone and an extern C entry across a module boundary",
            [
                testsuite.TestModule {
                    name: "ctxlib",
                    source: """
// The caller's context, seen from this module: a raw integer in its settings.
export fn seen(): int {
    let p = sys.contextPtr();
    let v = 0;
    do unsafe { __c__("v = ((hzstd_context_t *)p)->settings.userBox2.fingerprint;"); };
    return v;
}

export fn set(n: int) {
    let p = sys.contextPtr();
    do unsafe { __c__("((hzstd_context_t *)p)->settings.userBox2.fingerprint = n;"); };
}

export fn seenGeneric<T>(x: T): int { return seen(); }

// Generic bodies are re-emitted into the consumer as source: `context` and
// `context.clone` have to survive that.
export fn snapshotGeneric<T>(x: T): Context { return context; }

export fn cloneGeneric<T>(x: T): int {
    return context.clone(() => {
        set(seen() + 1);
        return seen();
    });
}

export fn callBack(f: () => int): int { return f(); }

export fn callBackInClone(f: () => int): int {
    return context.clone(() => {
        set(42);
        return f();
    });
}

export struct Thing {
    v: int = 0;
    fn look(): int { return seen() + this.v; }
    fn constructor(v: int): Thing { return Thing { v: seen() + v }; }
}

// C calls it with a context (C401); here this module's own C does.
export extern C fn enterLib(n: int): int {
    set(seen() + n);
    return seen();
}

export fn callEnterFromC(n: int): int {
    let p = sys.contextPtr();
    let r = 0;
    do unsafe { __c__("r = enterLib((hzstd_context_t *)p, n);"); };
    return r;
}
""",
                },
            ],
            """
import ctxlib;

fn heldOf(c: Context): int {
    let copy = c;
    let v = 0;
    do unsafe { __c__("v = copy.userBox2.fingerprint;"); };
    return v;
}

fn held(): int { return heldOf(context); }

fn main(): int {
    let failures = 0;
    ctxlib.set(5);
    if held() != 5 { fmt.println("FAIL: a write in the other module reaches this one"); failures++; }
    if ctxlib.seen() != 5 { fmt.println("FAIL: the other module sees this one's context"); failures++; }
    if ctxlib.seenGeneric<int>(1) != 5 || ctxlib.seenGeneric("s") != 5 { fmt.println("FAIL: generic across the boundary"); failures++; }
    if heldOf(ctxlib.snapshotGeneric(1)) != 5 { fmt.println("FAIL: `context` in a re-emitted generic body"); failures++; }
    if ctxlib.cloneGeneric(1) != 6 || held() != 5 { fmt.println("FAIL: clone in a re-emitted generic body"); failures++; }
    if ctxlib.callBack(() => { return held(); }) != 5 { fmt.println("FAIL: a closure called from the other module"); failures++; }
    if ctxlib.callBackInClone(() => { return held(); }) != 42 || held() != 5 { fmt.println("FAIL: a closure called inside the other module's clone"); failures++; }
    let thing = ctxlib.Thing(1);
    if thing.v != 6 || thing.look() != 11 { fmt.println("FAIL: constructor and method across the boundary"); failures++; }
    let inner = context.clone(() => {
        ctxlib.set(7);
        return ctxlib.seen();
    });
    if inner != 7 || held() != 5 { fmt.println("FAIL: the other module under this one's clone"); failures++; }
    let fromC = context.clone(() => ctxlib.callEnterFromC(3));
    if fromC != 8 || held() != 5 { fmt.println("FAIL: the other module's extern C entry, called from C"); failures++; }
    let fromHaze = context.clone(() => ctxlib.enterLib(2));
    if fromHaze != 7 || held() != 5 { fmt.println("FAIL: the other module's extern C entry, called from Haze"); failures++; }
    if failures > 0 {
        return 1;
    }
    fmt.println("context crosses module boundaries");
    return 0;
}
""",
            "context crosses module boundaries");

        // A default value is evaluated by the caller, so `context` in it is the
        // caller's context. A declaration without a body (a module interface, or
        // a C-implemented `:: context` entry) has such defaults too.
        s.runWithModules(
            "context: a default parameter value naming context, across a module boundary and on a declaration without a body",
            [
                testsuite.TestModule {
                    name: "ctxdef",
                    source: """
__c__("hzstd_int_t cEntry(hzstd_context_t *ctx, hzstd_user_box_t b) { return b.value == NULL ? -1 : 2; }");

export fn withBox(b: UserBox = context.userBox1): int { return sys.userBoxValue<int>(b) ?? -1; }
export fn withSettings(c: Context = context): int { return sys.userBoxValue<int>(c.userBox1) ?? -1; }
export extern C fn entryWithDefault(b: UserBox = context.userBox1): int { return (sys.userBoxValue<int>(b) ?? -1) + 1; }
export extern C fn cEntry(b: UserBox = context.userBox1): int :: final, context;
export fn viaLocalDeclaration(): int { return cEntry(); }
""",
                },
            ],
            """
import ctxdef;

fn main(): int {
    context.userBox1 = sys.makeUserBox<int>(7);
    let inner = context.clone(() => {
        context.userBox1 = sys.makeUserBox<int>(9);
        return ctxdef.withBox();
    });
    fmt.println(f"{ctxdef.withBox()} {ctxdef.withSettings()} {ctxdef.entryWithDefault()} {ctxdef.cEntry()} {ctxdef.viaLocalDeclaration()} {inner}");
    return 0;
}
""",
            "7 7 8 2 2 9");

        // ── C505: a context for a thread Haze does not manage panics ──────────────
        // The program runs itself again as a child; the child starts a plain
        // pthread that asks hzstd for a context. The parent checks the child's
        // exit status and its panic message.
        s.run(
            "context: creating a context on a thread Haze does not manage panics (C505)",
            """
__c__("#ifdef _WIN32\n#include <windows.h>\nstatic DWORD WINAPI haze_unmanaged(LPVOID arg) { (void)arg; hzstd_context_t c = hzstd_context_for_current_thread(); (void)c; return 0; }\nstatic void run_unmanaged(void) { HANDLE t = CreateThread(NULL, 0, haze_unmanaged, NULL, 0, NULL); WaitForSingleObject(t, INFINITE); CloseHandle(t); }\n#else\n#include <pthread.h>\nstatic void *haze_unmanaged(void *arg) { (void)arg; hzstd_context_t c = hzstd_context_for_current_thread(); (void)c; return NULL; }\nstatic void run_unmanaged(void) { pthread_t t; pthread_create(&t, NULL, haze_unmanaged, NULL); pthread_join(t, NULL); }\n#endif");

fn child(): int {
    do unsafe { __c__("run_unmanaged();"); };
    fmt.println("the unmanaged thread got a context");
    return 0;
}

fn main(): int {
    let args = sys.args();
    if args.length > 1 && args[1] == "child" {
        return child();
    }
    // On the main thread, a managed one, C gets a context.
    let onMain = 0;
    do unsafe { __c__("hzstd_context_t c = hzstd_context_for_current_thread(); onMain = (hzstd_int_t)c.thread->id;"); };
    let r = process.runCaptured(args[0], ["child"]);
    let panicked = r.stderrResult.contains("a Haze context was created on a thread Haze does not manage");
    fmt.println(f"{onMain} {r.exitCode} {panicked} {r.stdoutResult.length}");
    return 0;
}
""",
            "1 255 true 0");

        // ── Context values are made only by Context() ──────────────────────────────
        s.compileFails(
            "context: a Context struct literal is rejected (opaque)",
            """
fn main(): int {
    let fine = Context();
    let literal = Context {}; // <- only Context() makes one
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.StructMarkedAsOpaqueAndThereforeNoStruct)]);

        // ── an extern C function defined in Haze has a context (C401, C402) ──────
        // C passes it as the first parameter; the body can do everything a Haze
        // function can, and runs under the context C handed over.
        s.run(
            "context: an extern C body has the context C passes and calls any Haze code",
            """
ref struct Counter { n: int = 0; mut fn bump(): int { this.n = this.n + 1; return this.n; } }
struct Meters { v: int = 0; fn constructor(v: int): Meters { return Meters { v: v }; } fn operator==(o: Meters): bool { return this.v == o.v; } }
fn doubled(n: int): int { return n * 2; }
fn held(): int { return sys.userBoxValue<int>(context.userBox1) ?? 0; }

extern C fn entry(n: int): int {
    let c = Counter {};
    let closure = (x: int) => x + 1;
    let fnValue: (x: int) -> int = doubled;
    let cell = rx.reactive<int>(1);
    let twiceCell = rx.computed(() => cell * 2);
    cell := 5;
    let inner = context.clone(() => {
        context.userBox1 = sys.makeUserBox<int>(9);
        return held();
    });
    let text = f"{n}";
    let sum = doubled(n) + c.bump() + closure(n) + fnValue(1) + twiceCell + inner + text.length + held();
    if Meters(3) == Meters(3) { sum = sum + 100; }
    return sum;
}

fn main(): int {
    context.userBox1 = sys.makeUserBox<int>(1000);
    let p = sys.contextPtr();
    let result = 0;
    do unsafe { __c__("result = entry((hzstd_context_t *)p, 4);"); };
    // 8 + 1 + 5 + 2 + 10 + 9 + 1 + 1000 + 100
    fmt.println(f"{result} {held()}");
    return 0;
}
""",
            "1136 1000");

        // The constructs that call Haze code without looking like a call: each one
        // reads the context's user box, so the sum proves they ran under C's context.
        s.run(
            "context: an extern C body converts with as, calls through ?., iterates computeds and compares under C's context",
            """
fn held(): int { return sys.userBoxValue<int>(context.userBox1) ?? 0; }
struct Other { v: int = 0; }
struct Meters { v: int = 0; fn operator as(): Other { return Other { v: this.v + held() }; } }
struct Inner { x: int = 0; fn operator==(o: Inner): bool { return held() == 1000; } }
struct Outer { inner: Inner = {}; }
struct M { v: int = 0; fn get(): int { return this.v + held(); } }

extern C fn entry(o: M | none): int {
    let other: Other = Meters { v: 3 };
    let items: mut []rx.Computed<int> = [rx.computed(() => { return held(); })];
    let fromComputeds = 0;
    for c in items {
        fromComputeds = fromComputeds + c;
    }
    let sum = other.v + (o?.get() ?? 0) + fromComputeds;
    let same = Outer {} == Outer {};
    if same { sum = sum + 1; }
    return sum;
}

fn main(): int {
    context.userBox1 = sys.makeUserBox<int>(1000);
    let p = sys.contextPtr();
    let o: M | none = M { v: 20 };
    let result = 0;
    do unsafe { __c__("result = entry((hzstd_context_t *)p, o);"); };
    // 1003 + 1020 + 1000 + 1
    fmt.println(f"{result}");
    return 0;
}
""",
            "3024");

        s.compileFails(
            "context: &context is a syntax error",
            """
fn main(): int {
    let p = &context; // <- no reference to the context
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.SyntaxError)]);

        s.compileFails(
            "context: let stackref r = context is rejected",
            """
fn main(): int {
    let stackref r = context; // <- no reference to the context
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.ContextReferenceFormed)]);

        s.compileFails(
            "context: passing context to a stackref parameter is the value-to-reference error",
            """
fn takes(c: stackref Context): int { return 0; }

fn main(): int {
    let n = takes(context); // <- a value cannot be passed as a stackref
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.NoSuitableConversionFound)]);

        // ── nothing else can be named context ──────────────────────────────────────
        s.compileFails(
            "context: a local named context",
            """
fn main(): int {
    let context = 1; // <- would hide the context
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.DeclarationNamedContext)]);

        s.compileFails(
            "context: a parameter named context",
            """
fn f(context: int): int { return 0; } // <- would hide the context

fn main(): int {
    return f(1);
}
""",
            [testsuite.mustHave(errorcodes.Code.DeclarationNamedContext)]);

        s.compileFails(
            "context: a lambda parameter named context",
            """
fn main(): int {
    let f = (context: int) => { return 0; }; // <- would hide the context
    return f(1);
}
""",
            [testsuite.mustHave(errorcodes.Code.DeclarationNamedContext)]);

        s.compileFails(
            "context: a loop variable named context",
            """
fn main(): int {
    let items: []int = [1, 2];
    let sum = 0;
    for context in items { // <- would hide the context
        sum = sum + 1;
    }
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.DeclarationNamedContext)]);

        s.compileFails(
            "context: a global named context",
            """
let context: int = 0; // <- unreachable by name inside every function

fn main(): int {
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.DeclarationNamedContext)]);

        s.compileFails(
            "context: a free function named context",
            """
fn context(): int { return 0; } // <- unreachable by name inside every function

fn main(): int {
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.DeclarationNamedContext)]);

        s.compileFails(
            "context: a namespace named context",
            """
namespace context { // <- unreachable by name inside every function
    export fn f(): int { return 0; }
}

fn main(): int {
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.DeclarationNamedContext)]);

        s.compileFails(
            "context: a type named context",
            """
struct context { x: int = 0; } // <- unreachable by name inside every function

fn main(): int {
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.DeclarationNamedContext)]);

        s.compileFails(
            "context: a generic parameter named context",
            """
fn f<context>(x: context): int { return 0; } // <- would hide the context

fn main(): int {
    return f<int>(1);
}
""",
            [testsuite.mustHave(errorcodes.Code.DeclarationNamedContext)]);
    }
}
