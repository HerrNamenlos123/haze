// REGRESSION TEST -- array storage: an empty literal owns no element buffer.
//
// `[]` used to allocate a 4-element buffer up front, and most empty arrays
// (an element's children, a component's watchers, ...) never get an element:
// a UI mount paid one wasted allocation per such field. Now an empty literal
// allocates only the control struct, the first push jumps to 4, then the
// capacity doubles; a literal with elements is sized as before. The case
// reads the capacity through hzstd_dynamic_array_capacity, and also runs every
// common operation on a still-empty literal (insert, remove, reserve, clear,
// iteration, map/filter, a deep reactive array), since an empty array's
// buffer is now NULL.

namespace cases_array_capacity {

    export fn register(s: mut testsuite.Suite) {

        s.run(
            "arrays: an empty literal owns no buffer, the first push jumps to 4, then the capacity doubles",
            """
struct Item {
    name: str;
    n: int;
}

ref struct Holder {
    items: []Item = [];
    names: []str = [];
}

fn capInts(a: []int): int {
    do unsafe {
        let result: int = 0;
        __c__("result = (hzstd_int_t)hzstd_dynamic_array_capacity(a);");
        return result;
    };
}

fn capItems(a: []Item): int {
    do unsafe {
        let result: int = 0;
        __c__("result = (hzstd_int_t)hzstd_dynamic_array_capacity(a);");
        return result;
    };
}

fn capStrs(a: []str): int {
    do unsafe {
        let result: int = 0;
        __c__("result = (hzstd_int_t)hzstd_dynamic_array_capacity(a);");
        return result;
    };
}

fn describe(items: []int): str {
    let out = "";
    for item in items {
        out = f"{out}{item},";
    }
    return out;
}

fn main(): int {
    // An empty literal owns no element storage until something is put in it.
    let a: mut []int = [];
    assert(a.length == 0, "empty literal has length 0");
    assert(capInts(a) == 0, f"empty literal: capacity {capInts(a)}, expected 0");

    // The first element jumps the capacity to 4, after that it doubles.
    a.push(1);
    assert(capInts(a) == 4, f"after 1 push: capacity {capInts(a)}, expected 4");
    a.push(2);
    a.push(3);
    a.push(4);
    assert(capInts(a) == 4, f"after 4 pushes: capacity {capInts(a)}, expected 4");
    a.push(5);
    assert(capInts(a) == 8, f"after 5 pushes: capacity {capInts(a)}, expected 8");
    for (let i = 6; i <= 9; i++) { a.push(i); }
    assert(capInts(a) == 16, f"after 9 pushes: capacity {capInts(a)}, expected 16");
    assert(describe(a) == "1,2,3,4,5,6,7,8,9,", describe(a));

    // A literal with elements is sized as before: at least 4, else its length.
    let b: mut []int = [1, 2];
    assert(capInts(b) == 4, f"[1, 2]: capacity {capInts(b)}, expected 4");
    let c: mut []int = [1, 2, 3, 4, 5];
    assert(capInts(c) == 5, f"[1..5]: capacity {capInts(c)}, expected 5");
    c.push(6);
    assert(capInts(c) == 10, f"[1..5] + 1: capacity {capInts(c)}, expected 10");

    // Empty struct-field defaults, filled later.
    let h = Holder {};
    assert(capItems(h.items) == 0 && capStrs(h.names) == 0, "empty field defaults own no storage");
    h.items.push({ name: "x", n: 7 });
    h.names.push("y");
    assert(capItems(h.items) == 4 && capStrs(h.names) == 4, "field defaults jump to 4");
    assert(h.items[0].name == "x" && h.items[0].n == 7 && h.names[0] == "y", "field contents");

    // Every other operation on a still-empty literal.
    let d: mut []int = [];
    d.insert(0, 7);
    assert(d.length == 1 && d[0] == 7 && capInts(d) == 4, "insert into an empty literal");
    assert(d.remove(0) == 7 && d.length == 0, "remove back to empty");

    let e: []str = [];
    let count = 0;
    for s in e { count++; }
    assert(count == 0, "iterating an empty literal");

    let f: mut []int = [];
    f.reserve(10);
    assert(capInts(f) == 10, f"reserve on an empty literal: {capInts(f)}");
    f.push(1);
    assert(capInts(f) == 10 && f[0] == 1, "push after reserve");

    let g: mut []int = [];
    g.clear();
    assert(g.length == 0 && capInts(g) == 0, "clear on an empty literal");
    assert(describe(g.map((v: int) => v * 2)) == "", "map over an empty literal");
    assert(describe(g.filter((v: int) => v > 0)) == "", "filter over an empty literal");

    // A deep reactive array made from an empty literal.
    let r = rx.reactive<[]int>([]);
    assert(r.length == 0, "empty reactive array");
    r.push(3);
    r.push(4);
    assert(r.length == 2 && r[0] == 3 && r[1] == 4, "reactive array push");

    fmt.println("array capacity: ok");
    return 0;
}
""",
            "array capacity: ok",
        );
    }
}
