// ============================================================================
// REGRESSION TESTS — storage classes, stack references and `nocopy`.
//
// Design of record: R&D/Storage Classes and References.md. Every rule tested
// here is normative there; the section numbers in the comments point at it.
//
//   * a struct is a C layout; `Foo` is a value, `ref Foo` a GC pointer,
//     `stackref Foo` a generation-checked reference (§3)
//   * the default is value; `ref struct` makes every use a ref (§3.2)
//   * a literal takes the type of its slot; only a `ref` slot allocates (§6.1)
//   * value -> ref / value -> stackref at a use site are errors (§6.2, I6, I7)
//   * `let stackref` is the one creation site; a copied value gets its own
//     buffer and the scope registers a generation (§5.1, §5.2)
//   * every read through a stackref is checked; a dead one panics (§5.3)
//   * closures copy stack values and share refs/stackrefs (§7.1); a lambda
//     literal in `let stackref` lives in place (§7.3)
//   * `nocopy` forbids every second binding except from a temporary (§9)
//   * `this` in a plain method is an lvalue; `stackref fn` hands it out (§12)
//   * a method bound on a stackref receiver checks the witness at the call (§12.4)
//   * references compare by identity (§3.5)
//
// Per framework.hz, everything a running program can verify is bundled into
// ONE compile-and-run case; each must-fail-to-compile rule and the dead
// reference panic get their own.
// ============================================================================

namespace cases_storage_classes {

    export fn register(s: mut testsuite.Suite) {

        s.run(
            "storage classes: values, refs, stackrefs, closures, nocopy, receivers",
            """
struct Vec { x: int; y: int;
    mut fn bump() { this.x = this.x + 1; }
    fn sum(): int { return this.x + this.y; }
    fn copyOfSelf(): Vec { return this; }          // whole-value use of `this` copies (§12.2)
    stackref fn me(): stackref Vec { return this; } // hands out a checked reference (§12.3)
}
ref struct Node { v: int;
    fn get(): int { return this.v; }
    ref fn self(): ref Node { return this; }
}
nocopy struct Writer { buf: []u8; pos: int;
    fn constructor(): Writer { return Writer { buf: [], pos: 0 }; }
    mut fn put(b: u8) { this.buf.push(b); this.pos = this.pos + 1; }
}
struct Counter { n: int; }
ref struct Holder { r: stackref Counter | none = none; }

fn bump(c: mut stackref Counter) { c.n = c.n + 1; }
fn read(c: stackref Counter): int { return c.n; }
fn readNode(n: stackref Node): int { return n.v; }
fn fill(w: mut stackref Writer) { w.put(1); w.put(2); }
fn callTwice(f: stackref (() => int)): int { return f() + f(); }

// ── 1. value semantics, refs, `this` ─────────────────────────────────────────
fn t1() {
    let v = Vec { x: 1, y: 2 };
    let c = v;                 // copy
    v.bump();
    fmt.println(f"1: {v.x} {c.x} {v.sum()} {v.copyOfSelf().x}");
    let n: ref Node = { v: 7 };     // a literal in a `ref` slot allocates (§6.1)
    let m = n;                      // aliases
    m.v = 8;
    fmt.println(f"1: {n.v} {n.get()} {n.self().v}");
}

// ── 2. stackrefs: copy, from ref, from stackref, through params ─────────────
fn t2() {
    let stackref c = Counter { n: 1 };
    bump(c);
    bump(c);
    let n: ref Node = { v: 7 };
    let stackref sn = n;            // immortal: points at the GC object
    let stackref c2 = c;            // copies the reference: same counter
    bump(c2);
    fmt.println(f"2: {read(c)} {c.n} {readNode(n)} {sn.v}");
    let stackref v = Vec { x: 10, y: 1 };
    let r = v.me();
    v.bump();
    fmt.println(f"2: {r.x} {v.x}");
}

// ── 3. loops: every iteration owns a fresh generation (§4.6) ─────────────────
fn t3() {
    let total = 0;
    for (let i = 0; i < 3; i++) {
        let stackref t = Counter { n: i };
        bump(t);
        total = total + read(t);
    }
    let k = 0;
    while k < 2 {
        let stackref t = Counter { n: 5 };
        if k == 0 { k = k + 1; continue; }   // exits the body scope
        total = total + t.n;
        k = k + 1;
    }
    fmt.println(f"3: {total}");
}

// ── 4. early return from inside participating scopes ────────────────────────
fn earlyOut(flag: bool): int {
    let stackref a = Counter { n: 1 };
    if flag {
        let stackref b = Counter { n: 2 };
        return a.n + b.n;         // reads through both, then both scopes exit
    }
    return a.n;
}
fn t4() {
    fmt.println(f"4: {earlyOut(true)} {earlyOut(false)}");
}

// ── 5. closures: values copy, refs and stackrefs share (§7.1, §7.3) ─────────
fn t5() {
    let a = 1;
    let v = Vec { x: 10, y: 0 };
    let r: ref Node = { v: 100 };
    let stackref shared = Counter { n: 0 };
    let stackref f = () => {          // built in place, no heap
        shared.n = shared.n + 1;
        r.v = r.v + 1;
        fmt.println(f"5: sees a={a} v.x={v.x} r.v={r.v} shared={shared.n}");
    };
    f();
    f();
    fmt.println(f"5: after a={a} v.x={v.x} r.v={r.v} shared={shared.n}");
}

// ── 6. nocopy: temporaries only (§9) ─────────────────────────────────────────
fn t6() {
    let stackref w = Writer();
    fill(w);
    let w2 = Writer();
    fmt.println(f"6: {w.pos} {w2.pos} {w.buf.length}");
}

// ── 7. bound methods carry the receiver's witness (§12.4) ───────────────────
fn t7() {
    let stackref v = Vec { x: 10, y: 1 };
    let f = v.sum;
    v.bump();
    let n: ref Node = { v: 5 };
    let g = n.get;
    n.v = 6;
    fmt.println(f"7: {f()} {callTwice(f)} {g()}");
}

// ── 8. equality is by VALUE, whatever the storage class (§3.5, revised) ─────
//
// This case used to assert reference IDENTITY: `a == b` was FALSE for two
// distinct objects with equal contents, and `a != b` was true. That rule is
// gone -- equality is value-based throughout, so a ref, a stackref and the
// object itself all answer the same question about contents, and none of them
// answers "is this the same address". The expected output below changed with
// it, deliberately. (Identity is a separate concept with no spelling yet; when
// it gets one it belongs in its own case, not here.)
//
// `c` is here so the case still discriminates: with every comparison of equal
// contents now true, a test made only of those would pass even if comparison
// were hardcoded to true.
fn t8() {
    let a: ref Node = { v: 1 };
    let b: ref Node = { v: 1 };
    let c: ref Node = { v: 2 };
    let stackref sa = a;
    let stackref sb = b;
    let a2 = a;
    let stackref sa2 = a;
    fmt.println(f"8: {a == a2} {a == b} {sa == sa2} {sa == sb} {sa == a} {a != b}");
    fmt.println(f"8b: {a == c} {a != c} {sa == c} {sa != c}");
}

// ── 9. storing a stackref is legal; it is the use that is checked (§5.5) ────
fn storeWhileAlive(h: ref Holder) {
    let stackref c = Counter { n: 42 };
    h.r = c;
    if h.r { fmt.println(f"9: {h.r.n}"); }
}
fn t9() {
    let h: ref Holder = {};
    storeWhileAlive(h);
}

// ── 10. reflection (§3) ──────────────────────────────────────────────────────
fn t10() {
    static_assert(Vec.isValue);
    static_assert(Vec.isRef == false);
    static_assert(Node.isRef);
    let stackref sv = Vec { x: 0, y: 0 };
    static_assert(typeof(sv).isStackref);
    static_assert(typeof(sv).valueType.isValue);
    static_assert(typeof(sv).valueType.isStackref == false);
    let n: ref Node = { v: 0 };
    static_assert(typeof(n).isRef);
    static_assert(typeof(n).valueType.isValue);
    fmt.println("10: ok");
}

fn main(): int {
    t1(); t2(); t3(); t4(); t5(); t6(); t7(); t8(); t9(); t10();
    return 0;
}
""",
            """
1: 2 1 4 2
1: 8 8 8
2: 4 4 7 7
2: 11 11
3: 11
4: 3 1
5: sees a=1 v.x=10 r.v=101 shared=1
5: sees a=1 v.x=10 r.v=102 shared=2
5: after a=1 v.x=10 r.v=102 shared=2
6: 2 0 2
7: 12 24 6
8: true true true true true false
8b: false true false true
9: 42
10: ok
""");

        // ── The dead reference panics at the use, not silently (§4.2, §5.3) ──
        s.runExitCode(
            "a dead stackref panics on use",
            """
struct Counter { n: int; }
ref struct Holder { r: stackref Counter | none = none; }
fn escape(h: ref Holder) {
    let stackref c = Counter { n: 42 };
    h.r = c;
}
fn main(): int {
    let h: ref Holder = {};
    escape(h);
    if h.r { fmt.println(f"{h.r.n}"); }
    return 0;
}
""",
            255);   // an unrecovered panic ends the process with _exit(-1)

        // ── Compile-time rules ──────────────────────────────────────────────
        s.compileFails(
            "a value never silently becomes a ref (I6)",
            """
ref struct Node { v: int; }
struct Vec { x: int; }
fn takesRef(n: ref Vec) {}
fn main(): int {
    let v = Vec { x: 1 };
    takesRef(v);
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.NoSuitableConversionFound)]);

        s.compileFails(
            "an explicitly typed value literal cannot fill a ref slot (§6.1)",
            """
struct Vec { x: int; }
fn main(): int {
    let v: ref Vec = Vec { x: 1 };
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.NoSuitableConversionFound)]);

        s.compileFails(
            "a value is not passed as stackref at a use site (I7)",
            """
struct Vec { x: int; }
fn takes(v: stackref Vec) {}
fn main(): int {
    let v = Vec { x: 1 };
    takes(v);
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.NoSuitableConversionFound)]);

        s.compileFails(
            "a stackref never becomes a ref (§6.2)",
            """
struct Vec { x: int; }
fn main(): int {
    let stackref v = Vec { x: 1 };
    let r: ref Vec = v;
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.NoSuitableConversionFound)]);

        s.compileFails(
            "mut on a value struct is meaningless and rejected (§3.3)",
            """
struct Vec { x: int; }
fn f(v: mut Vec) {}
fn main(): int { return 0; }
""",
            [testsuite.mustHave(errorcodes.Code.MutModifierOnValueType)]);

        s.compileFails(
            "ref only applies to structs",
            """
fn main(): int {
    let x: ref int = 5;
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.RefModifierOnNonStruct)]);

        s.compileFails(
            "nocopy: no second binding of an existing value (§9)",
            """
nocopy struct W { n: int; }
fn main(): int {
    let a = W { n: 1 };
    let b = a;
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.NoSuitableConversionFound)]);

        s.compileFails(
            "nocopy: a closure cannot capture a nocopy value (§9)",
            """
nocopy struct W { n: int; }
fn main(): int {
    let a = W { n: 1 };
    let f = () => { fmt.println(f"{a.n}"); };
    f();
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.NocopySecondBinding)]);

        s.compileFails(
            "a method cannot be bound on a value receiver (§12.4)",
            """
struct Vec { x: int; fn get(): int { return this.x; } }
fn main(): int {
    let v = Vec { x: 1 };
    let f = v.get;
    return f();
}
""",
            [testsuite.mustHave(errorcodes.Code.BoundMethodOnValueReceiver)]);

        s.compileFails(
            "a stackref fn needs a stackref receiver (§12.3)",
            """
struct Vec { x: int; stackref fn me(): stackref Vec { return this; } }
fn main(): int {
    let v = Vec { x: 1 };
    let m = v.me();
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.ReceiverStorageTooWeak)]);

        s.compileFails(
            "writing to a by-value capture inside a closure is rejected (§7.1)",
            """
fn main(): int {
    let count = 0;
    let f = () => { count = count + 1; };
    f();
    return count;
}
""",
            [testsuite.mustHave(errorcodes.Code.WriteToByValueCapture)]);

        s.compileFails(
            "let stackref needs a struct or a callable",
            """
fn main(): int {
    let stackref x = 5;
    return 0;
}
""",
            [testsuite.mustHave(errorcodes.Code.StackrefModifierOnNonStructOrCallable)]);
    }
}
