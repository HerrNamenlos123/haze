extern C fn hz_t_collected(slot: int): int :: final;
extern C fn hz_t_kind(p: cptr): int :: final;
extern C fn hz_t_str_kind(s: str): int :: final;
extern C fn hz_t_chunks(arena: Allocator, unscanned: bool): str :: final;
extern C fn hz_t_alloc(arena: Allocator, unscanned: bool, size: int): cptr :: final;
extern C fn hz_t_stash(arena: Allocator, unscanned: bool, slot: int): void :: final;
extern C fn hz_t_chunk_data(arena: Allocator, unscanned: bool, index: int): cptr :: final;
extern C fn hz_t_watch(p: cptr, slot: int): void :: final;
extern C fn hz_t_make_view(slot: int): void :: final;
extern C fn hz_t_view_intact(): bool :: final;
extern C fn hz_t_drop_view(): void :: final;

fn allocMany(arena: Allocator, unscanned: bool, size: int, count: int) {
    for (let i = 0; i < count; i++) {
        hz_t_alloc(arena, unscanned, size);
    }
}

fn chunks(arena: Allocator): str {
    return f"scanned [{hz_t_chunks(arena, false)}] unscanned [{hz_t_chunks(arena, true)}]";
}

fn profiler(): Profiler {
    return Profiler({ samplingRate: 0, memoryInstrumentation: true, memoryInstrumentationStacktraces: false });
}

fn main(): int {
    let p = profiler();
    let labelled = Alloc.arena({ label: "probe arena" });
    fmt.formatWithAllocator(labelled, "x");
    hz_t_alloc(labelled, false, 16);
    allocMany(labelled, true, 16, 64);
    let unnamed = Alloc.arena();
    hz_t_alloc(unnamed, true, 16);
    let r = p.stop();
    let lines = "";
    let unlabelled = 0;
    for frame in r.memoryInstrumentationFrames {
        if frame.dataType == "probe arena" {
            if frame.allocationType == 3 {
                lines = lines + "[arena]";
            } else {
                lines = lines + f"[{frame.allocationType} {frame.sizeBytes}]";
            }
        } else if frame.dataType == "" && (frame.allocationType == 3 || frame.allocationType == 6) {
            unlabelled = unlabelled + 1;
        }
    }
    assert(lines == "[arena][6 1024][5 1024][6 2048]", f"labelled events: {lines}");
    assert(unlabelled == 2, f"unlabelled arena events: {unlabelled}");
    // Each chunk is one event, not also a heap allocation under it.
    let events = r.memoryInstrumentationFrames.length - 1;
    assert(events == 6, f"events in all: {events}");
    return 0;
}
""",
            0);

        s.runExitCode(
            "arena: measuring an Arena that does not hold an arena panics",
            """
fn main(): int {
    Arena { _allocator: Alloc.heap() }.measure();
    return 0;
}
""",
            255);

        s.runExitCode(
            "arena: a negative spare panics",
            """
fn main(): int {
    ArenaOptions {}.sizedFor(ArenaUsage { scanned: 16, unscanned: 16 }, -0.5);
    return 0;
}
""",
            255);

        s.runExitCode(
            "arena: growth below 1.0 panics",
            """
fn main(): int {
    Alloc.arena({ scanned: { growth: 0.5 } });
    return 0;
}
""",
            255);

        s.runExitCode(
            "arena: a chunk size below 1 byte panics",
            """
fn main(): int {
    Alloc.arena({ unscanned: { firstBytes: 0 } });
    return 0;
}
""",
            255);

        s.runExitCode(
            "arena: a growing policy whose maxBytes is below nextBytes panics",
            """
fn main(): int {
    Alloc.arena({ scanned: { nextBytes: 4096, maxBytes: 1024 } });
    return 0;
}
""",
            255);

    }
}
