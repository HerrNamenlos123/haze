// The data block of the chain's chunk number `index` (0 = first).
void *hz_t_chunk_data(hzstd_allocator_t arena, bool unscanned, hzstd_int_t index) {
    hzstd_arena_t *a = (hzstd_arena_t *)arena.ctx;
