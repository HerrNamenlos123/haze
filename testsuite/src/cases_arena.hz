void *hz_t_alloc(hzstd_allocator_t arena, bool unscanned, hzstd_int_t size) {
    return unscanned ? hzstd_allocate_unscanned(arena, (size_t)size, NULL) : hzstd_allocate(arena, (size_t)size, NULL);
}
// A GC object whose only reference is stored in the arena (scanned or
// unscanned chain), watched in `slot`.
__attribute__((noinline)) void hz_t_stash(hzstd_allocator_t arena, bool unscanned, hzstd_int_t slot) {
    void *obj = GC_malloc(64);
    hz_t_watch(obj, slot);
    void **cell = (void **)hz_t_alloc(arena, unscanned, sizeof(void *));
