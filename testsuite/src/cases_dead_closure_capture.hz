// ============================================================================
// REGRESSION TESTS — H7190 only speaks about closures that can still be alive.
//
// A closure copies the stack values it captures, so writing the variable
// afterwards leaves a closure that is still around with the old value. H7190
// warns about exactly that. Its own text says "if that closure is still
// alive" — but it used to fire for EVERY by-value capture, including the one
// shape where the compiler already knows the answer:
//
//     acc = fold(() => { ... acc ... });
//
// A lambda literal handed straight to a parameter that does not retain it
// (`immediate`, or inferred non-escaping) is built on the stack and is gone
// when the call returns. The write to `acc` happens after that, so there is no
// copy left to go stale. The compiler's own parser is written in this shape
// throughout (`acc = this.captureWith(() => { ... acc ... })`) and produced
// eleven such warnings on every build.
//
// The rule: a write warns only if some closure that captured the variable by
// value may outlive the call it was created for. The second case checks the
// other side, so that a fix here cannot quietly become "H7190 never fires".
// ============================================================================

namespace cases_dead_closure_capture {

    export fn register(s: mut testsuite.Suite) {

        let foldSource = """
fn applyImmediate(f: immediate () => int): int {
    return f();
}

fn applyInferred(f: () => int): int {
    return f();
}

ref struct Writer {
    out: str = "";

    mut fn captureWith(f: () => void): str {
        f();
        return this.out;
    }

    // The parser's own shape: a method taking a closure, called from a method
    // of the same struct, folding into a local across a loop.
    mut fn chain(): str {
        let acc = "a";
        let i = 0;
        while i < 3 {
            acc = this.captureWith(() => { this.out = acc + "x"; });
            i = i + 1;
        }
        acc = this.captureWith(() => { this.out = acc + "!"; });
        return acc;
    }
}

fn main(): int {
    // ── 1. `immediate` parameter ──────────────────────────────────────────
    let a = 0;
    a = applyImmediate(() => { return a + 1; });
    a = applyImmediate(() => { return a + 1; });
    fmt.println(f"1: {a}");

    // ── 2. the same contract, inferred rather than declared ───────────────
    let b = 0;
    b = applyInferred(() => { return b + 1; });
    fmt.println(f"2: {b}");
    b = 10;

    // ── 3. in a loop, and a plain write far from the capture ──────────────
    let c = 0;
    let n = 0;
    while n < 3 {
        c = applyImmediate(() => { return c + n; });
        n = n + 1;
    }
    fmt.println(f"3: {c}");
    c = 100;

    // ── 4. nested: both closures are gone once the outer call returns ─────
    let d = 1;
    d = applyImmediate(() => { return applyInferred(() => { return d * 2; }); });
    fmt.println(f"4: {d}");
    d = 7;

    // ── 5. method receiving the closure ───────────────────────────────────
    let w = Writer {};
    fmt.println(f"5: {w.chain()}");

    return 0;
}
""";

        s.compileOkWithChecks(
            "writing a variable after a non-retained closure read it is not a stale-copy warning",
            foldSource,
            [testsuite.mustNotHave(errorcodes.Code.WriteAfterByValueCapture)]);

        // The same program, run: every closure above must have seen the value
        // the variable had when it was created, i.e. the fold really folds.
        s.run(
            "folding into a variable through a non-retained closure reads the current value",
            foldSource,
            """
1: 2
2: 1
3: 3
4: 2
5: axxx!
""");

        // The warning side, unchanged. Each numbered block below leaves a
        // closure alive across the write and must warn exactly once; fewer
        // than five means the rule above was widened to closures it does not
        // cover.
        s.compileOkWithChecks(
            "writing a variable after a closure that may still be alive read it still warns",
            """
fn applyImmediate(f: immediate () => int): int {
    return f();
}

fn keep(f: () => int): () => int {
    return f;
}

ref struct Holder {
    f: () => int;
}

fn main(): int {
    // 1. A closure in a local is alive at the write.
    let a = 0;
    let readA = () => { return a; };
    a = 1;

    // 2. A closure handed to a function that retains it.
    let b = 0;
    let keptB = keep(() => { return b; });
    b = 1;

    // 3. An in-place stack closure is alive at the write as well.
    let c = 0;
    let stackref readC = () => { return c; };
    c = 1;

    // 4. Nested: the outer closure is gone after the call, but the inner one
    //    copied `d` too, was stored, and is still alive.
    let d = 0;
    let holder = Holder { f: () => { return 0; } };
    let r = applyImmediate(() => { holder.f = () => { return d; }; return 0; });
    d = 1;

    // 5. A dead closure does not excuse a live one that captured the same
    //    variable.
    let e = 0;
    let s = applyImmediate(() => { return e; });
    let readE = () => { return e; };
    e = 1;

    return readA() + keptB() + readC() + holder.f() + r + s + readE();
}
""",
            [testsuite.exactCount(errorcodes.Code.WriteAfterByValueCapture, 5)]);
    }
}
