// ============================================================================
// REGRESSION TEST — this is a real, load-bearing test, not a placeholder.
//
// Bug: json.CacheFile watches its own file, and reloaded it with
//
//   cache.data := rx.reactive<T>(rawData);
//
// which fills `data` with a brand-new cell for every field. Anything that had
// taken a field's handle before -- a computed subscribed to it, a component
// given it as a prop -- kept the old cell, which nothing ever wrote again.
// And the watch fires for the cache's OWN writes (it polls the modification
// date), so this happened right after the first flush and after every write
// since. haze-notes' file tree could not open a folder: FileTree's layout was
// subscribed to the startup cell of `expandedFolders`, and every click pushed
// into whichever cell the latest reload had made.
//
// Fix: the cache knows the file state its own last write left, and a watch
// event that finds exactly that state is its own write echoing back -- the
// file holds what `data` does, so it is not read at all. A real external
// change is read, and written into the cells already there (rx.assign), so
// every handle stays live. rx.sameHandle is the identity test hzui now
// compares reactive props with, so a component handed a different handle
// does re-render.
//
// The cache cases drive the frame loop by hand: an app.App host flushes and
// pumps fs.pollEvents every frame, and nothing else ever delivers the watch.
// ============================================================================

namespace cases_cache_file {

    // Shared by the CacheFile cases. A function, not a const: a const declared
    // in a namespace crashes the compiler when referenced.
    export fn cachePrelude(): str {
        return """
struct Inner {
    k: int = 0;
}

struct Cache {
    list: []str = [];
    n: int = 0;
    inner: Inner = {};
}

fn cachePath(name: str): str {
    let dir = env.get("HAZE_TEST_WORKDIR");
    if dir is str {
        return f"{dir}/{name}";
    }
    return f"/tmp/{name}";
}

// What an app.App host does every frame, spread out enough that the watch's
// 0.1s poll interval has passed.
fn nextFrame(cache: json.CacheFile<Cache>) {
    cache.flush();
    time.sleep(0.15);
    fs.pollEvents();
}
""";
    }

    export fn register(s: mut testsuite.Suite) {

        s.run(
            "CacheFile: its own writes are never read back, and handles taken earlier stay live",
            cachePrelude() + """
fn main(): int {
    let path = cachePath("cachefile_own_write.json");
    fs.writeText(path, "{}");
    let cache = json.CacheFile<Cache>(path);
    nextFrame(cache);

    // Taken once and kept, the way a component keeps a prop.
    let list = cache.data.list;
    let count = rx.computed((): int => list.length);
    // Reads `n` through `cache.data` every time, so a reload -- which is the
    // only other thing that could write to it -- shows up here.
    let reads: ref Box<int> = { value: 0 };
    let n = rx.computed((): int => {
        reads.value = reads.value + 1;
        return cache.data.n;
    });
    rx.get(n);

    let i = 0;
    while i < 3 {
        cache.data.list.push(f"item{i}");
        nextFrame(cache);
        fmt.println(f"frame {i}: held handle sees {rx.get(count)}, n dirty {rx.isDirty(n)}, n read {reads.value}");
        i = i + 1;
    }
    rx.get(n);
    fmt.println(f"n evaluated {reads.value} times");
    if let text = fs.readText(path) {
        fmt.println(text);
    }
    return 0;
}
""",
            """
frame 0: held handle sees 1, n dirty false, n read 1
frame 1: held handle sees 2, n dirty false, n read 1
frame 2: held handle sees 3, n dirty false, n read 1
n evaluated 1 times
{"list":["item0","item1","item2"],"n":0,"inner":{"k":0}}
""");

        s.run(
            "CacheFile: an external write is read into the cells that are already there",
            cachePrelude() + """
fn main(): int {
    let path = cachePath("cachefile_external_write.json");
    fs.writeText(path, "{}");
    let cache = json.CacheFile<Cache>(path);
    nextFrame(cache);

    let list = cache.data.list;
    let inner = cache.data.inner;
    let count = rx.computed((): int => list.length);
    let k = rx.computed((): int => inner.k);
    fmt.println(f"before: {rx.get(count)} {rx.get(k)} {cache.data.n}");

    // Another program writes the file.
    let external = \"\"\"{"list":["x","y"],"n":5,"inner":{"k":7}}\"\"\";
    fs.writeText(path, external);
    nextFrame(cache);
    fmt.println(f"after: {rx.get(count)} {rx.get(k)} {cache.data.n}");

    // Reading it back is not a write: the file is exactly what the other
    // program left.
    if let text = fs.readText(path) {
        fmt.println(f"untouched: {text == external}");
    }

    // And the cache keeps saving, through the handles it had before.
    list.push("z");
    inner.k := 8;
    nextFrame(cache);
    if let text = fs.readText(path) {
        fmt.println(text);
    }
    return 0;
}
""",
            """
before: 0 0 0
after: 2 7 5
untouched: true
{"list":["x","y","z"],"n":5,"inner":{"k":8}}
""");

        s.run(
            "rx.assign writes a deep struct in place: every field keeps its cell",
            """
struct Inner {
    k: int = 0;
    tags: []str = [];
}

enum Mode { A, B }

struct State {
    name: str = "";
    count: int = 0;
    items: []int = [];
    inner: Inner = {};
    maybe: str | none = none;
    mode: Mode = Mode.A;
}

fn main(): int {
    let state = rx.reactive<State>(State { name: "a", items: [1] });

    // Every handle taken before the assign, and kept.
    let name = state.name;
    let count = state.count;
    let items = state.items;
    let inner = state.inner;
    let tags = state.inner.tags;
    let maybe = state.maybe;
    let mode = state.mode;

    let nameRuns: ref Box<int> = { value: 0 };
    let nameNow = rx.computed((): str => {
        nameRuns.value = nameRuns.value + 1;
        return name;
    });
    let countNow = rx.computed((): int => count);
    let itemCount = rx.computed((): int => items.length);
    let k = rx.computed((): int => inner.k);
    let tagCount = rx.computed((): int => tags.length);
    let maybeNow = rx.computed((): str => {
        let m: str | none = maybe;
        if m is str {
            return m;
        }
        return "none";
    });
    let isB = rx.computed((): bool => {
        let m: Mode = mode;
        return m == Mode.B;
    });
    fmt.println(f"before: {rx.get(nameNow)} {rx.get(countNow)} {rx.get(itemCount)} {rx.get(k)} {rx.get(tagCount)} {rx.get(maybeNow)} {rx.get(isB)}");

    rx.assign(state, State {
        name: "a",
        count: 3,
        items: [1, 2, 3],
        inner: Inner { k: 9, tags: ["t"] },
        maybe: "m",
        mode: Mode.B,
    });
    fmt.println(f"after: {rx.get(nameNow)} {rx.get(countNow)} {rx.get(itemCount)} {rx.get(k)} {rx.get(tagCount)} {rx.get(maybeNow)} {rx.get(isB)}");

    // A scalar that already held the value is not written, so nothing that
    // reads it re-runs.
    fmt.println(f"name evaluated {nameRuns.value} times");

    // Still the live cells: writes through the state reach the held handles.
    state.items.push(4);
    state.inner.k := 10;
    state.inner.tags.push("u");
    fmt.println(f"live: {rx.get(itemCount)} {rx.get(k)} {rx.get(tagCount)}");
    return 0;
}
""",
            """
before: a 0 1 0 0 none false
after: a 3 3 9 1 m true
name evaluated 1 times
live: 4 10 2
""");

        s.run(
            "rx.sameHandle is identity: the same handle, never merely an equal value",
            """
struct Pair {
    a: int = 0;
    b: int = 0;
}

fn main(): int {
    let a = rx.reactive<int>(1);
    let b = rx.reactive<int>(1);
    let a2 = a;
    fmt.println(f"reactive: {rx.sameHandle(a, a2)} {rx.sameHandle(a, b)}");

    let xs = rx.reactive<[]int>([1]);
    let ys = rx.reactive<[]int>([1]);
    let xs2 = xs;
    fmt.println(f"deep array: {rx.sameHandle(xs, xs2)} {rx.sameHandle(xs, ys)}");

    let s = rx.shallowReactive<str>("x");
    let t = rx.shallowReactive<str>("x");
    let s2 = s;
    fmt.println(f"shallow: {rx.sameHandle(s, s2)} {rx.sameHandle(s, t)}");

    let c = rx.computed((): int => 1);
    let d = rx.computed((): int => 1);
    let c2 = c;
    fmt.println(f"computed: {rx.sameHandle(c, c2)} {rx.sameHandle(c, d)}");

    // A field of a deep struct is a handle of its own, the same one each
    // time it is taken.
    let pair = rx.reactive<Pair>(Pair {});
    fmt.println(f"field: {rx.sameHandle(pair.a, pair.a)} {rx.sameHandle(pair.a, pair.b)}");
    return 0;
}
""",
            """
reactive: true false
deep array: true false
shallow: true false
computed: true false
field: true false
""");
    }
}
