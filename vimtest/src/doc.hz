
// Wires the shared `text_document.Document` into the textedit engine.
//
// The harness deliberately uses the SAME document model the real editor
// uses, so the differential suite exercises the production data
// structure (in-place line mutation, array insert/remove) rather than a
// simplified stand-in that could hide a bug.

export fn makeContext(doc: mut text_document.Document): mut textedit_behavior.Context {
    let ctx = textedit_behavior.Context({
        getLineLength: (lineIndex: int) => doc.lineLength(lineIndex),
        getLine: (lineIndex: int) => doc.line(lineIndex),
        getLineCount: () => doc.lineCount(),
        getTimeInSeconds: () => 0.0,
        replaceRange: (start: Vec2i, end: Vec2i, text: String): void => {
            doc.replaceRange(start, end, text.cloneString());
        },
        initialMode: textedit_behavior.Mode.Normal,
    });
    return ctx;
}
