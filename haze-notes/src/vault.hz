import unicode

// ── Order ───────────────────────────────────────────────────────────────
//
// Every folder's entries are in technicalsketcher.web's order: its
// compareEntries (src/components/store.ts), which the sidebar sorted each
// folder with. Folders come first. Then come names starting with a date
// (DD.MM.YYYY or DD-MM-YYYY), oldest first. Everything else follows by
// `a.localeCompare(b, "de", { numeric: true })`: ICU's collation, which
// unicode.collate reproduces.
//
// Wherever compareEntries returned 0, the web app's stable sort kept the
// order the folder was listed in, and its Electron build listed with node's
// readdir, which sorts by bytes. So both of its ties go by byte order here
// too: two names with the same date ("12.03.2024 Physik" before
// "12.03.2024 analysis"), and two names that collate equal ("a01" and "a1",
// whose numbers are equal).

// Byte order: plain memcmp, because haze has no `<` on str and a byte loop
// in Haze is far slower.
fn compareBytes(a: str, b: str): int {
    let result = 0;
    do unsafe {
        __c__("{ size_t n = a.length < b.length ? (size_t)a.length : (size_t)b.length; int c = n ? memcmp(a.data, b.data, n) : 0; result = c < 0 ? -1 : (c > 0 ? 1 : (a.length < b.length ? -1 : (a.length > b.length ? 1 : 0))); }");
    };
    return result;
}

fn floorDiv(a: int, b: int): int {
    let q = a / b;
    if a % b != 0 && ((a < 0) != (b < 0)) {
        q = q - 1;
    }
    return q;
}

// Days since 1970-01-01 of a proleptic Gregorian date (month 1-12).
// Howard Hinnant's days_from_civil.
fn daysFromCivil(year: int, month: int, day: int): int {
    let y = month <= 2 ? year - 1 : year;
    let era = floorDiv(y, 400);
    let yearOfEra = y - era * 400;
    let shiftedMonth = month > 2 ? month - 3 : month + 9;
    let dayOfYear = (153 * shiftedMonth + 2) / 5 + day - 1;
    let dayOfEra = yearOfEra * 365 + yearOfEra / 4 - yearOfEra / 100 + dayOfYear;
    return era * 146097 + dayOfEra - 719468;
}

// The day JavaScript's `new Date(year, monthIndex, day)` lands on, as a day
// count. Years 0-99 mean 1900-1999, and a month or day out of range rolls
// over (31.02.2026 is 3 March; month 00 is December of the year before; day
// 00 is the last day of the month before). The web app compared such dates
// by getTime(), the local midnight of that day, which orders days exactly
// as this count does.
fn javascriptDateDay(year: int, monthIndex: int, day: int): int {
    let fullYear = year >= 0 && year <= 99 ? year + 1900 : year;
    let yearShift = floorDiv(monthIndex, 12);
    let month = monthIndex - yearShift * 12;
    return daysFromCivil(fullYear + yearShift, month + 1, 1) + day - 1;
}

fn isAsciiDigit(c: int): bool {
    return c >= 48 && c <= 57;
}

fn digitsValue(name: str, start: int, count: int): int {
    let value = 0;
    for (let i = start; i < start + count; i++) {
        value = value * 10 + (name[i] as int - 48);
    }
    return value;
}

// The date a name starts with, as a day count, or none without one. This is
// the web app's /^(\d{2})[-.](\d{2})[-.](\d{4})/: ASCII digits only, each
// separator "-" or ".", and anything may follow, so "12.03.20245" is
// 12.03.2024. Any digits pass (00.00.0000 is 30 November 1899): the web
// app's validity check could never fail for them.
fn nameDateDay(name: str): int | none {
    if name.length < 10 {
        return none;
    }
    let digitPositions: []int = [0, 1, 3, 4, 6, 7, 8, 9];
    for position in digitPositions {
        if !isAsciiDigit(name[position] as int) {
            return none;
        }
    }
    let separatorPositions: []int = [2, 5];
    for position in separatorPositions {
        let c = name[position] as int;
        if c != 45 && c != 46 { // '-' '.'
            return none;
        }
    }
    let day = digitsValue(name, 0, 2);
    let month = digitsValue(name, 3, 2);
    let year = digitsValue(name, 6, 4);
    return javascriptDateDay(year, month - 1, day);
}

// What the order looks at in an entry, worked out once per entry rather than
// once per comparison: building a collation key is the expensive part.
struct VaultOrderKey {
    isDirectory: bool;
    name: str;
    hasDate: bool;
    day: int;
    collation: str;
}

fn vaultOrderKey(isDirectory: bool, name: str): VaultOrderKey {
    let hasDate = false;
    let day = 0;
    if let d = nameDateDay(name) {
        hasDate = true;
        day = d;
    }
    return VaultOrderKey {
        isDirectory: isDirectory,
        name: name,
        hasDate: hasDate,
        day: day,
        collation: unicode.collationKey(name, { numeric: true }),
    };
}

// The web app's compareEntries, with its ties broken as described above.
fn compareVaultOrder(a: VaultOrderKey, b: VaultOrderKey): int {
    if a.isDirectory != b.isDirectory {
        return a.isDirectory ? -1 : 1;
    }
    if a.hasDate && b.hasDate {
        if a.day != b.day {
            return a.day < b.day ? -1 : 1;
        }
        return compareBytes(a.name, b.name);
    }
    if a.hasDate {
        return -1;
    }
    if b.hasDate {
        return 1;
    }
    let order = unicode.compareCollationKeys(a.collation, b.collation);
    if order != 0 {
        return order;
    }
    return compareBytes(a.name, b.name);
}


// ── Indexing ────────────────────────────────────────────────────────────
//
// What the tree holds: notes (files ending in noteExtension), folders whose
// name does not start with "."
// (.hznotes is the app's own; .obsidian, .trash and .git belong to other
// tools), and of those folders only the ones with something left in them. A
// vault is often shared with other tools, and a file haze-notes cannot open
// has no place in its tree -- clicking one used to close the open note.
//
// The one exception is a folder holding a keep file (KEEP_FILE): it is shown
// with no note in it. A folder created in the app gets one, so it shows up
// before anything is written in it.

// The extension every note has: an .hznote file (hznote.hz).
const comptime noteExtension = ".hznote";

fn isNoteFile(name: str): bool {
    return name.endsWith(noteExtension) && name.length > noteExtension.length;
}

fn isHiddenFolder(name: str): bool {
    return name.startsWith(".");
}

// Deeper than any real vault's folders go. A folder linked into itself (a
// symlink cycle) would otherwise be followed forever.
const MAX_FOLDER_DEPTH = 32;

// The empty file that keeps a folder in the tree with no note in it. It is
// no note itself, and it is never listed.
const KEEP_FILE = ".hznotekeep";

// ── The index ───────────────────────────────────────────────────────────
//
// What the tree lists, flat: every entry in the order the tree shows it,
// each folder followed by everything in it (depth first), as plain records
// over one text of vault-relative paths ("Physik/Woche 2/x.hznote", parts
// joined by "/" on every system). Plain bytes, both: the vault's index cache
// stores them as they are, and reading the cache hands them back as views
// of the file's bytes, with nothing built. A walk (VaultWalk) writes them
// into one arena.

// The bytes of one IndexEntry.
const comptime INDEX_ENTRY_BYTES = 28;

// One entry: a note (in an index of every file, any file) or a folder.
// Plain: seven u32, nothing else, so an array of them is one block of bytes.
struct IndexEntry {
    // Its vault-relative path, in VaultIndex.text.
    pathStart: u32;
    pathLength: u32;
    // Its name: the last nameLength bytes of the path.
    nameLength: u32;
    // How many folders it is in: 0 at the vault's top.
    depth: u32;
    // 1 for a folder, 0 for a file.
    folder: u32;
    // 1 for what is not part of the notes: listed only in an index of every
    // file.
    ghost: u32;
    // How many entries after it are inside it: what a closed folder skips.
    descendants: u32;
}

struct VaultIndex {
    // `count` IndexEntry records, side by side, as in memory.
    entries: Bytes;
    count: int;
    // Every entry's path, one after another.
    text: str;

    fn entry(i: int): IndexEntry {
        if i < 0 || i >= this.count {
            sys.panic(f"VaultIndex: entry {i} of {this.count}");
        }
        let e = IndexEntry { pathStart: 0, pathLength: 0, nameLength: 0, depth: 0, folder: 0, ghost: 0, descendants: 0 };
        let bytes = this.entries;
        let at = i * INDEX_ENTRY_BYTES;
        do unsafe {
            __c__("memcpy(&e, (const hzstd_u8_t*)bytes.basePtr + bytes.offset + at, sizeof(e));");
        };
        return e;
    }

    fn path(e: IndexEntry): str {
        let start = e.pathStart as int;
        return this.text.slice(start, start + e.pathLength as int);
    }

    fn name(e: IndexEntry): str {
        let end = e.pathStart as int + e.pathLength as int;
        return this.text.slice(end - e.nameLength as int, end);
    }

    // The entry with this vault-relative path, or -1.
    fn find(path: str): int {
        for (let i = 0; i < this.count; i++) {
            if this.path(this.entry(i)) == path {
                return i;
            }
        }
        return -1;
    }

    // The same entries in the same order.
    fn sameAs(other: VaultIndex): bool {
        return this.count == other.count && this.text == other.text && this.entries == other.entries;
    }
}

fn isIndexFolder(e: IndexEntry): bool {
    return e.folder != 0;
}

fn isIndexGhost(e: IndexEntry): bool {
    return e.ghost != 0;
}

fn emptyIndex(): VaultIndex {
    return VaultIndex { entries: Bytes(), count: 0, text: "" };
}

// The vault-relative path `relative` as a path on disk. "" is the vault.
fn vaultAbsolute(vaultPath: str, relative: str): str {
    if relative.length == 0 {
        return vaultPath;
    }
    return f"{vaultPath}/{relative}";
}

// The path of `absolute` inside the vault ("" for the vault itself), or
// none for a path outside it.
fn vaultRelative(vaultPath: str, absolute: str): str | none {
    if absolute == vaultPath {
        return "";
    }
    if absolute.length > vaultPath.length + 1 && absolute.startsWith(vaultPath) && absolute[vaultPath.length] as int == 47 {
        return absolute.slice(vaultPath.length + 1, absolute.length);
    }
    return none;
}

// ── Walking a vault ─────────────────────────────────────────────────────

// A folder of the walk.
ref struct WalkFolder {
    // Vault-relative ("" for the vault) and on disk.
    relPath: str;
    absPath: str;
    depth: int;
    listed: bool = false;
    // It holds a keep file; a note right in it.
    kept: bool = false;
    noted: bool = false;
    // The tree shows it: a keep file, or a note at any depth.
    shown: bool = false;
    // What it lists: its files at once, its folders once walked.
    items: []WalkItem = [];
    // Its folders, by name, to walk in turn.
    subfolders: []str = [];
    nextSubfolder: int = 0;
}

struct WalkItem {
    key: VaultOrderKey;
    name: str;
    ghost: bool;
    // A folder's own walk; none for a file.
    folder: WalkFolder | none = none;
}

// The walk of a vault that the index is made of: one folder listed per step,
// so it can be spread over frames, or run() at once. With `everything`,
// every file and folder is listed and what the tree would leave out is a
// ghost; without, only what the tree shows. Hidden folders stay out either
// way: the app's own .hznotes and other tools' data, which no note belongs
// in.
//
// Every name and path, and the index made at the end, go into one arena,
// made for the walk and sized by `lastUsage`, what the walk before measured
// (usage()): an unchanged vault walks into a single chunk.
ref struct VaultWalk {
    root: str;
    everything: bool;
    arena: Arena;
    // The folders being walked, innermost last.
    stack: []WalkFolder = [];
    top?: WalkFolder;

    fn constructor(root: str, everything: bool, lastUsage: ArenaUsage): VaultWalk {
        let walk = VaultWalk {
            root: root,
            everything: everything,
            arena: Alloc.arena(ArenaOptions { label: "vault index" }.sizedFor(lastUsage, 0.05)),
        };
        walk.stack.push(WalkFolder { relPath: "", absPath: root, depth: 0 });
        return walk;
    }

    fn done(): bool {
        return this.stack.length == 0;
    }

    // Walks on until `deadline` (time.now()) has passed, at least one step.
    // True once the whole vault is walked.
    fn step(deadline: real): bool {
        while this.stack.length > 0 {
            this.stepOnce();
            if time.now() >= deadline {
                break;
            }
        }
        return this.stack.length == 0;
    }

    // All of it, now.
    fn run() {
        while this.stack.length > 0 {
            this.stepOnce();
        }
    }

    fn stepOnce() {
        let folder = this.stack[this.stack.length - 1];
        if !folder.listed {
            this.list(folder);
            return;
        }
        if folder.nextSubfolder < folder.subfolders.length {
            let name = folder.subfolders[folder.nextSubfolder];
            folder.nextSubfolder = folder.nextSubfolder + 1;
            let rel = name;
            if folder.relPath.length > 0 {
                rel = fmt.formatWithAllocator(this.arena, folder.relPath, "/", name);
            }
            this.stack.push(WalkFolder {
                relPath: rel,
                absPath: fmt.formatWithAllocator(this.arena, this.root, "/", rel),
                depth: folder.depth + 1,
            });
            return;
        }
        // Everything in it walked.
        folder.items.sort((a: WalkItem, b: WalkItem) => compareVaultOrder(a.key, b.key));
        this.stack.pop();
        if this.stack.length == 0 {
            this.top = folder;
            return;
        }
        let parent = this.stack[this.stack.length - 1];
        if folder.shown {
            parent.shown = true;
        }
        if folder.shown || this.everything {
            parent.items.push(WalkItem {
                key: vaultOrderKey(true, entryName(folder.relPath)),
                name: entryName(folder.relPath),
                ghost: !folder.shown,
                folder: folder,
            });
        }
    }

    fn list(folder: WalkFolder) {
        folder.listed = true;
        if folder.depth > MAX_FOLDER_DEPTH {
            return;
        }
        if let dirs = fs.listDir(this.arena, folder.absPath) {
            for dir in dirs {
                if dir.isFile && dir.name == KEEP_FILE {
                    folder.kept = true;
                    folder.shown = true;
                }
                else if dir.isFile {
                    let note = isNoteFile(dir.name);
                    if note {
                        folder.noted = true;
                        folder.shown = true;
                    }
                    if note || this.everything {
                        folder.items.push(WalkItem { key: vaultOrderKey(false, dir.name), name: dir.name, ghost: !note });
                    }
                }
                else if dir.isDirectory && !isHiddenFolder(dir.name) {
                    folder.subfolders.push(dir.name);
                }
            }
        }
    }

    // Whether the tree shows the walked folder itself: false for a folder it
    // leaves out, and for no folder at all. Once done().
    fn shown(): bool {
        if let t = this.top {
            return t.shown;
        }
        return false;
    }

    // The index: the notes and the folders the tree shows, or with
    // `ghosts` (an `everything` walk) every file and folder. Into the walk's
    // arena, both parts allocated once at their exact size. Once done().
    fn index(ghosts: bool): VaultIndex {
        let t = this.top;
        if t is none {
            return emptyIndex();
        }
        let stackref measure = IndexSize {};
        sizeItems(t, ghosts, measure);
        if measure.count == 0 {
            return emptyIndex();
        }
        let stackref entries = ByteBuffer.fixed(measure.count * INDEX_ENTRY_BYTES, this.arena);
        let stackref text = ByteBuffer.fixed(measure.textBytes, this.arena);
        writeItems(t, ghosts, 0, entries, text);
        entries.commit();
        text.commit();
        return VaultIndex { entries: entries.bytes(), count: measure.count, text: text.string() };
    }

    // What the arena holds now: what the next walk of this vault is sized
    // by (see the constructor).
    fn usage(): ArenaUsage {
        return this.arena.measure();
    }
}

// A count, length or offset of the index as the u32 it is stored as. An
// index of 4 GB is no vault's.
fn indexU32(n: int): u32 {
    assert(n >= 0 && n <= 4294967295, "vault index: more than a u32 holds");
    return n as u32;
}

struct IndexSize {
    count: int = 0;
    textBytes: int = 0;
}

// The path of an item in `folder`.
fn itemPathLength(folder: WalkFolder, item: WalkItem): int {
    if folder.relPath.length == 0 {
        return item.name.length;
    }
    return folder.relPath.length + 1 + item.name.length;
}

fn sizeItems(folder: WalkFolder, ghosts: bool, size: mut stackref IndexSize): void :: final {
    for item in folder.items {
        if item.ghost && !ghosts {
            continue;
        }
        size.count = size.count + 1;
        size.textBytes = size.textBytes + itemPathLength(folder, item);
        if let child = item.folder {
            sizeItems(child, ghosts, size);
        }
    }
}

// Writes the entries of `folder` (at `depth`); how many it wrote, nested
// ones included.
fn writeItems(folder: WalkFolder, ghosts: bool, depth: int, entries: mut stackref ByteBuffer, text: mut stackref ByteBuffer): int :: final {
    let written = 0;
    for item in folder.items {
        if item.ghost && !ghosts {
            continue;
        }
        let pathStart = text.length();
        if folder.relPath.length > 0 {
            text.push(folder.relPath);
            text.push("/");
        }
        text.push(item.name);
        let isFolder = item.folder ? true : false;
        let at = entries.length();
        entries.pushU32(indexU32(pathStart));
        entries.pushU32(indexU32(text.length() - pathStart));
        entries.pushU32(indexU32(item.name.length));
        entries.pushU32(indexU32(depth));
        entries.pushU32(isFolder ? 1 as u32 : 0 as u32);
        entries.pushU32(item.ghost ? 1 as u32 : 0 as u32);
        entries.pushU32(0);
        written = written + 1;
        if let child = item.folder {
            let inside = writeItems(child, ghosts, depth + 1, entries, text);
            entries.setU32At(at + 24, indexU32(inside));
            written = written + inside;
        }
    }
    return written;
}

// The notes index of a vault, now (see VaultWalk).
fn indexNotes(vaultPath: str): VaultIndex {
    let walk = VaultWalk(vaultPath, false, ArenaUsage { scanned: 0, unscanned: 0 });
    walk.run();
    return walk.index(false);
}

// Whether the tree shows the folder at `path`: false for a folder it leaves
// out, and for no folder at all.
fn isShownFolder(path: str): bool {
    let walk = VaultWalk(path, false, ArenaUsage { scanned: 0, unscanned: 0 });
    walk.run();
    return walk.shown();
}

// Whether `folder` holds a keep file, which shows it with no note in it.
fn hasKeepFile(folder: str): bool {
    if let entries = fs.listDir(folder) {
        for entry in entries {
            if entry.isFile && entry.name == KEEP_FILE {
                return true;
            }
        }
    }
    return false;
}

// ── Creating notes and folders ──────────────────────────────────────────
//
// Names are refused where a file system would refuse them on any of the
// systems a vault is synced to: a vault written on Linux is opened on Windows
// too, and a name Windows cannot hold breaks the sync. That rules out the
// path separators, < > : " | ? *, control characters, "." and "..", and a
// folder name ending in a dot (Windows drops the dot). A folder name starting
// with a dot is refused as well: the tree hides such folders, so it would
// vanish the moment it was created.

fn equalsIgnoringAsciiCase(a: str, b: str): bool {
    if a.length != b.length {
        return false;
    }
    for (let i = 0; i < a.length; i++) {
        let x = a[i] as int;
        let y = b[i] as int;
        if x >= 65 && x <= 90 { x = x + 32; }
        if y >= 65 && y <= 90 { y = y + 32; }
        if x != y {
            return false;
        }
    }
    return true;
}

// Whether Windows keeps the name for a device: CON, PRN, AUX, NUL, COM1-9 or
// LPT1-9, in any case, with any extension after it ("nul.hznote" too).
fn isWindowsDeviceName(name: str): bool {
    let stemEnd = 0;
    while stemEnd < name.length && name[stemEnd] as int != 46 { // '.'
        stemEnd = stemEnd + 1;
    }
    let stem = name.slice(0, stemEnd);
    let devices: []str = ["con", "prn", "aux", "nul",
        "com1", "com2", "com3", "com4", "com5", "com6", "com7", "com8", "com9",
        "lpt1", "lpt2", "lpt3", "lpt4", "lpt5", "lpt6", "lpt7", "lpt8", "lpt9"];
    for device in devices {
        if equalsIgnoringAsciiCase(stem, device) {
            return true;
        }
    }
    return false;
}

// Why there cannot be a note (or a folder) of this name, or "" when there can.
// The name is taken as typed, before trimming.
fn entryNameError(name: str, isFolder: bool): str {
    let trimmed = name.trim();
    if trimmed.length == 0 {
        return "Enter a name.";
    }
    if trimmed == "." || trimmed == ".." {
        return f"\"{trimmed}\" cannot be a name.";
    }
    for (let i = 0; i < trimmed.length; i++) {
        // Signed: the bytes of a non-ASCII letter are negative here.
        let c = trimmed[i] as int;
        if (c >= 0 && c < 32) || c == 127 {
            return "A name cannot contain tabs, line breaks or other control characters.";
        }
        // / \ < > : " | ? *
        if c == 47 || c == 92 || c == 60 || c == 62 || c == 58 || c == 34 || c == 124 || c == 63 || c == 42 {
            return "A name cannot contain any of / \\ < > : \" | ? *";
        }
    }
    if isWindowsDeviceName(isFolder ? trimmed : noteFileName(trimmed)) {
        return f"\"{trimmed}\" is a name Windows keeps for itself.";
    }
    if !isFolder && noteTitle(noteFileName(trimmed)).length == 0 {
        return f"A note needs a name before \"{noteExtension}\".";
    }
    if isFolder && trimmed.startsWith(".") {
        return "Folders starting with \".\" are hidden from the notes.";
    }
    if isFolder && trimmed.endsWith(".") {
        return "A folder name cannot end with \".\".";
    }
    return "";
}

// The file a note called `name` is saved as. It ends in noteExtension,
// which the name may already do.
fn noteFileName(name: str): str {
    let trimmed = name.trim();
    if trimmed.endsWith(noteExtension) {
        return trimmed;
    }
    return trimmed + noteExtension;
}

// What creating a note or a folder came to: its path, or why there is none.
struct CreatedEntry {
    path: str = "";
    error: str = "";
}

// A file system error as the end of a sentence.
fn fsErrorText(error: fs.Error): str {
    if error == fs.Error.PermissionDenied {
        return "permission denied";
    }
    if error == fs.Error.NameTooLong {
        return "the name is too long";
    }
    if error == fs.Error.InvalidPath || error == fs.Error.NotADirectory {
        return "the file system does not allow this name";
    }
    if error == fs.Error.NotFound {
        return "the folder is not there any more";
    }
    return "the file system reported an error";
}

// Why nothing can be created in `folder`: it was removed outside the app
// since the tree last looked. Nothing creates it again. "" when it is there.
fn missingFolderError(folder: str): str {
    if fs.listDir(folder) {
        return "";
    }
    return f"The folder \"{baseName(folder)}\" is not there any more.";
}

// Creates the note `name` in `folder`, holding `contents`. A file already
// there is never replaced, nor is one whose name differs only in case where
// the file system ignores case.
fn createNote(folder: str, name: str, contents: Bytes): CreatedEntry {
    let problem = entryNameError(name, false);
    if problem.length > 0 {
        return CreatedEntry { error: problem };
    }
    let gone = missingFolderError(folder);
    if gone.length > 0 {
        return CreatedEntry { error: gone };
    }
    let fileName = noteFileName(name);
    let title = noteTitle(fileName);
    let written = fs.createBinary(f"{folder}/{fileName}", contents);
    if !written {
        if written == fs.Error.AlreadyExists {
            return CreatedEntry { error: f"\"{title}\" already exists in this folder." };
        }
        return CreatedEntry { error: f"Could not create \"{title}\": {fsErrorText(written)}." };
    }
    return CreatedEntry { path: f"{folder}/{fileName}" };
}

// Gives `folder` a keep file, or takes it away: whether the tree shows it
// with no note in it. "" when done, else why not. A keep file that is there
// already is left as it is.
fn setFolderKept(folder: str, kept: bool): str {
    let keepPath = f"{folder}/{KEEP_FILE}";
    if kept {
        let gone = missingFolderError(folder);
        if gone.length > 0 {
            return gone;
        }
        let written = fs.createText(keepPath, "");
        if !written {
            if written != fs.Error.AlreadyExists {
                return f"Could not keep \"{baseName(folder)}\": {fsErrorText(written)}.";
            }
        }
        return "";
    }
    let removed = fs.removeFile(keepPath);
    if !removed {
        if removed != fs.Error.NotFound {
            return f"Could not change \"{baseName(folder)}\": {fsErrorText(removed)}.";
        }
    }
    return "";
}

// Creates the folder `name` in `folder`, with a keep file so the tree shows
// it. A folder of that name that is there already but not in the tree (it
// holds no note) gets the keep file and is shown from then on; one the tree
// shows already is an error, and is left alone.
fn createFolder(folder: str, name: str): CreatedEntry {
    let problem = entryNameError(name, true);
    if problem.length > 0 {
        return CreatedEntry { error: problem };
    }
    let gone = missingFolderError(folder);
    if gone.length > 0 {
        return CreatedEntry { error: gone };
    }
    let folderName = name.trim();
    let path = f"{folder}/{folderName}";
    if isShownFolder(path) {
        return CreatedEntry { error: f"A folder named \"{folderName}\" already exists here." };
    }
    let made = fs.createDirectory(path);
    if !made {
        // What createDirectory says when something other than a folder is
        // at the path.
        if made == fs.Error.NotAFile {
            return CreatedEntry { error: f"There is a file named \"{folderName}\" here already." };
        }
        return CreatedEntry { error: f"Could not create \"{folderName}\": {fsErrorText(made)}." };
    }
    let keepError = setFolderKept(path, true);
    if keepError.length > 0 {
        return CreatedEntry { error: keepError };
    }
    return CreatedEntry { path: path };
}

// ── Names ───────────────────────────────────────────────────────────────

fn isSeparator(c: int): bool {
    return c == 47 || c == 92;
}

// The last part of a path, either separator: a vault's or a folder's own name.
fn baseName(path: str): str {
    let end = path.length;
    while end > 1 && isSeparator(path[end - 1] as int) {
        end = end - 1;
    }
    let start = end;
    while start > 0 && !isSeparator(path[start - 1] as int) {
        start = start - 1;
    }
    return path.slice(start, end);
}

// The last part of the path of an entry in a vault. Below the vault's own
// path the separator is "/" on every system (fs.listDir joins with it), and
// on Linux a name may hold a backslash, so only "/" splits here.
fn entryName(path: str): str {
    let start = path.length;
    while start > 0 && path[start - 1] as int != 47 {
        start = start - 1;
    }
    return path.slice(start, path.length);
}

// What a note is called in the tree and the app bar: its file name without
// the extension every note has.
fn noteTitle(path: str): str {
    let name = entryName(path);
    if name.endsWith(noteExtension) {
        return name.slice(0, name.length - noteExtension.length);
    }
    return name;
}
