import unicode

struct FSFileEntry {
  type: "file";
  filename: str;
  fullPath: str;
  // Not a note: listed only while the tree shows every file (see
  // indexAllFiles), and drawn faded. Never saved: the saved index holds notes
  // only.
  [[json.ignore]]
  ghost: bool = false;
}

struct FSDirEntry {
  type: "directory";
  dirname: str;
  fullPath: str;
  children: []FSEntry;
  // A folder the tree leaves out (no note in it, no keep file), listed only
  // while it shows every file. Never saved, as for a file.
  [[json.ignore]]
  ghost: bool = false;
}

[[json.discriminator="type"]]
type FSEntry = FSFileEntry | FSDirEntry;

struct VaultFS {
  entries: rx.Reactive<[]FSEntry>;
}

// ── Order ───────────────────────────────────────────────────────────────
//
// Every folder's entries are in technicalsketcher.web's order: its
// compareEntries (src/components/store.ts), which the sidebar sorted each
// folder with. Folders come first. Then come names starting with a date
// (DD.MM.YYYY or DD-MM-YYYY), oldest first. Everything else follows by
// `a.localeCompare(b, "de", { numeric: true })`: ICU's collation, which
// unicode.collate reproduces.
//
// Wherever compareEntries returned 0, the web app's stable sort kept the
// order the folder was listed in, and its Electron build listed with node's
// readdir, which sorts by bytes. So both of its ties go by byte order here
// too: two names with the same date ("12.03.2024 Physik" before
// "12.03.2024 analysis"), and two names that collate equal ("a01" and "a1",
// whose numbers are equal).

// Byte order: plain memcmp, because haze has no `<` on str and a byte loop
// in Haze is far slower.
fn compareBytes(a: str, b: str): int {
    let result = 0;
    do unsafe {
        __c__("{ size_t n = a.length < b.length ? (size_t)a.length : (size_t)b.length; int c = n ? memcmp(a.data, b.data, n) : 0; result = c < 0 ? -1 : (c > 0 ? 1 : (a.length < b.length ? -1 : (a.length > b.length ? 1 : 0))); }");
    };
    return result;
}

fn floorDiv(a: int, b: int): int {
    let q = a / b;
    if a % b != 0 && ((a < 0) != (b < 0)) {
        q = q - 1;
    }
    return q;
}

// Days since 1970-01-01 of a proleptic Gregorian date (month 1-12).
// Howard Hinnant's days_from_civil.
fn daysFromCivil(year: int, month: int, day: int): int {
    let y = month <= 2 ? year - 1 : year;
    let era = floorDiv(y, 400);
    let yearOfEra = y - era * 400;
    let shiftedMonth = month > 2 ? month - 3 : month + 9;
    let dayOfYear = (153 * shiftedMonth + 2) / 5 + day - 1;
    let dayOfEra = yearOfEra * 365 + yearOfEra / 4 - yearOfEra / 100 + dayOfYear;
    return era * 146097 + dayOfEra - 719468;
}

// The day JavaScript's `new Date(year, monthIndex, day)` lands on, as a day
// count. Years 0-99 mean 1900-1999, and a month or day out of range rolls
// over (31.02.2026 is 3 March; month 00 is December of the year before; day
// 00 is the last day of the month before). The web app compared such dates
// by getTime(), the local midnight of that day, which orders days exactly
// as this count does.
fn javascriptDateDay(year: int, monthIndex: int, day: int): int {
    let fullYear = year >= 0 && year <= 99 ? year + 1900 : year;
    let yearShift = floorDiv(monthIndex, 12);
    let month = monthIndex - yearShift * 12;
    return daysFromCivil(fullYear + yearShift, month + 1, 1) + day - 1;
}

fn isAsciiDigit(c: int): bool {
    return c >= 48 && c <= 57;
}

fn digitsValue(name: str, start: int, count: int): int {
    let value = 0;
    for (let i = start; i < start + count; i++) {
        value = value * 10 + (name[i] as int - 48);
    }
    return value;
}

// The date a name starts with, as a day count, or none without one. This is
// the web app's /^(\d{2})[-.](\d{2})[-.](\d{4})/: ASCII digits only, each
// separator "-" or ".", and anything may follow, so "12.03.20245" is
// 12.03.2024. Any digits pass (00.00.0000 is 30 November 1899): the web
// app's validity check could never fail for them.
fn nameDateDay(name: str): int | none {
    if name.length < 10 {
        return none;
    }
    let digitPositions: []int = [0, 1, 3, 4, 6, 7, 8, 9];
    for position in digitPositions {
        if !isAsciiDigit(name[position] as int) {
            return none;
        }
    }
    let separatorPositions: []int = [2, 5];
    for position in separatorPositions {
        let c = name[position] as int;
        if c != 45 && c != 46 { // '-' '.'
            return none;
        }
    }
    let day = digitsValue(name, 0, 2);
    let month = digitsValue(name, 3, 2);
    let year = digitsValue(name, 6, 4);
    return javascriptDateDay(year, month - 1, day);
}

// What the order looks at in an entry, worked out once per entry rather than
// once per comparison: building a collation key is the expensive part.
struct VaultOrderKey {
    isDirectory: bool;
    name: str;
    hasDate: bool;
    day: int;
    collation: str;
}

fn vaultOrderKey(isDirectory: bool, name: str): VaultOrderKey {
    let hasDate = false;
    let day = 0;
    if let d = nameDateDay(name) {
        hasDate = true;
        day = d;
    }
    return VaultOrderKey {
        isDirectory: isDirectory,
        name: name,
        hasDate: hasDate,
        day: day,
        collation: unicode.collationKey(name, { numeric: true }),
    };
}

// The web app's compareEntries, with its ties broken as described above.
fn compareVaultOrder(a: VaultOrderKey, b: VaultOrderKey): int {
    if a.isDirectory != b.isDirectory {
        return a.isDirectory ? -1 : 1;
    }
    if a.hasDate && b.hasDate {
        if a.day != b.day {
            return a.day < b.day ? -1 : 1;
        }
        return compareBytes(a.name, b.name);
    }
    if a.hasDate {
        return -1;
    }
    if b.hasDate {
        return 1;
    }
    let order = unicode.compareCollationKeys(a.collation, b.collation);
    if order != 0 {
        return order;
    }
    return compareBytes(a.name, b.name);
}

struct VaultOrderItem {
    key: VaultOrderKey;
    entry: FSEntry;
}

// ── Indexing ────────────────────────────────────────────────────────────
//
// What the tree holds is what technicalsketcher.web's readVault kept: files
// whose name contains ".tsk", folders whose name does not start with "."
// (.hznotes is the app's own; .obsidian, .trash and .git belong to other
// tools), and of those folders only the ones with something left in them. A
// vault is often shared with other tools, and a file haze-notes cannot open
// has no place in its tree -- clicking one used to close the open note.
//
// The one exception is a folder holding a keep file (KEEP_FILE): it is shown
// with no note in it. A folder created in the app gets one, so it shows up
// before anything is written in it.

fn isNoteFile(name: str): bool {
    return name.contains(".tsk");
}

fn isHiddenFolder(name: str): bool {
    return name.startsWith(".");
}

// Deeper than any real vault's folders go. A folder linked into itself (a
// symlink cycle) would otherwise be followed forever.
const MAX_FOLDER_DEPTH = 32;

// The empty file that keeps a folder in the tree with no note in it. Its name
// has no ".tsk", so it is never a note itself, and it is never listed.
const KEEP_FILE = ".hznotekeep";

// A folder as the tree sees it.
struct IndexedFolder {
    // What it lists inside.
    entries: []FSEntry;
    // It holds a keep file.
    kept: bool;
    // The tree shows it: it holds a keep file, or a note at any depth.
    shown: bool;
}

// The folder at `path`. With `everything`, every file and every folder in it
// is listed, and what the tree would leave out is marked a ghost; without,
// only what the tree shows. Hidden folders stay out either way: the app's own
// .hznotes and other tools' data, which no note belongs in.
fn indexFolder(path: str, depth: int, everything: bool): IndexedFolder :: final {
    let items: []VaultOrderItem = [];
    let kept = false;
    let shown = false;
    if depth <= MAX_FOLDER_DEPTH {
        if let dirs = fs.listDir(path) {
            for dir in dirs {
                if dir.isFile && dir.name == KEEP_FILE {
                    kept = true;
                }
                else if dir.isFile {
                    let note = isNoteFile(dir.name);
                    if note {
                        shown = true;
                    }
                    if note || everything {
                        items.push(VaultOrderItem {
                            key: vaultOrderKey(false, dir.name),
                            entry: FSFileEntry {
                                type: "file",
                                filename: dir.name,
                                fullPath: dir.path,
                                ghost: !note,
                            },
                        });
                    }
                }
                else if dir.isDirectory && !isHiddenFolder(dir.name) {
                    let child = indexFolder(dir.path, depth + 1, everything);
                    if child.shown {
                        shown = true;
                    }
                    if child.shown || everything {
                        items.push(VaultOrderItem {
                            key: vaultOrderKey(true, dir.name),
                            entry: FSDirEntry {
                                type: "directory",
                                dirname: dir.name,
                                fullPath: dir.path,
                                children: child.entries,
                                ghost: !child.shown,
                            },
                        });
                    }
                }
            }
        }
    }
    items.sort((a: VaultOrderItem, b: VaultOrderItem) => compareVaultOrder(a.key, b.key));
    let entries: []FSEntry = [];
    entries.reserve(items.length);
    for item in items {
        entries.push(item.entry);
    }
    return IndexedFolder { entries: entries, kept: kept, shown: kept || shown };
}

fn indexDirectory(path: str, depth: int = 0): []FSEntry {
    return indexFolder(path, depth, false).entries;
}

fn indexVault(vaultPath: str): VaultFS {
    let vault = VaultFS {
        entries: rx.reactive<[]FSEntry>(indexDirectory(vaultPath)),
    };
    return vault;
}

// The vault with every file and folder in it, for the tree's "show all
// files": what the notes-only index leaves out is there as a ghost.
fn indexAllFiles(vaultPath: str): VaultFS {
    return VaultFS {
        entries: rx.reactive<[]FSEntry>(indexFolder(vaultPath, 0, true).entries),
    };
}

// The notes index inside an index of every file: what indexDirectory gives
// for the same folder, without walking it again.
fn withoutGhosts(entries: []FSEntry): []FSEntry :: final {
    let kept: []FSEntry = [];
    for entry in entries {
        if entry is FSDirEntry {
            if !entry.ghost {
                kept.push(FSDirEntry {
                    type: "directory",
                    dirname: entry.dirname,
                    fullPath: entry.fullPath,
                    children: withoutGhosts(entry.children),
                });
            }
        } else if entry is FSFileEntry {
            if !entry.ghost {
                kept.push(entry);
            }
        }
    }
    return kept;
}

// Whether the tree shows the folder at `path`: false for a folder it leaves
// out, and for no folder at all.
fn isShownFolder(path: str): bool {
    return indexFolder(path, 0, false).shown;
}

// Whether `folder` holds a keep file, which shows it with no note in it.
fn hasKeepFile(folder: str): bool {
    if let entries = fs.listDir(folder) {
        for entry in entries {
            if entry.isFile && entry.name == KEEP_FILE {
                return true;
            }
        }
    }
    return false;
}

// ── Creating notes and folders ──────────────────────────────────────────
//
// Names are refused where a file system would refuse them on any of the
// systems a vault is synced to: a vault written on Linux is opened on Windows
// too, and a name Windows cannot hold breaks the sync. That rules out the
// path separators, < > : " | ? *, control characters, "." and "..", and a
// folder name ending in a dot (Windows drops the dot). A folder name starting
// with a dot is refused as well: the tree hides such folders, so it would
// vanish the moment it was created.

fn equalsIgnoringAsciiCase(a: str, b: str): bool {
    if a.length != b.length {
        return false;
    }
    for (let i = 0; i < a.length; i++) {
        let x = a[i] as int;
        let y = b[i] as int;
        if x >= 65 && x <= 90 { x = x + 32; }
        if y >= 65 && y <= 90 { y = y + 32; }
        if x != y {
            return false;
        }
    }
    return true;
}

// Whether Windows keeps the name for a device: CON, PRN, AUX, NUL, COM1-9 or
// LPT1-9, in any case, with any extension after it ("nul.tsk" too).
fn isWindowsDeviceName(name: str): bool {
    let stemEnd = 0;
    while stemEnd < name.length && name[stemEnd] as int != 46 { // '.'
        stemEnd = stemEnd + 1;
    }
    let stem = name.slice(0, stemEnd);
    let devices: []str = ["con", "prn", "aux", "nul",
        "com1", "com2", "com3", "com4", "com5", "com6", "com7", "com8", "com9",
        "lpt1", "lpt2", "lpt3", "lpt4", "lpt5", "lpt6", "lpt7", "lpt8", "lpt9"];
    for device in devices {
        if equalsIgnoringAsciiCase(stem, device) {
            return true;
        }
    }
    return false;
}

// Why there cannot be a note (or a folder) of this name, or "" when there can.
// The name is taken as typed, before trimming.
fn entryNameError(name: str, isFolder: bool): str {
    let trimmed = name.trim();
    if trimmed.length == 0 {
        return "Enter a name.";
    }
    if trimmed == "." || trimmed == ".." {
        return f"\"{trimmed}\" cannot be a name.";
    }
    for (let i = 0; i < trimmed.length; i++) {
        // Signed: the bytes of a non-ASCII letter are negative here.
        let c = trimmed[i] as int;
        if (c >= 0 && c < 32) || c == 127 {
            return "A name cannot contain tabs, line breaks or other control characters.";
        }
        // / \ < > : " | ? *
        if c == 47 || c == 92 || c == 60 || c == 62 || c == 58 || c == 34 || c == 124 || c == 63 || c == 42 {
            return "A name cannot contain any of / \\ < > : \" | ? *";
        }
    }
    if isWindowsDeviceName(isFolder ? trimmed : noteFileName(trimmed)) {
        return f"\"{trimmed}\" is a name Windows keeps for itself.";
    }
    if !isFolder && noteTitle(noteFileName(trimmed)).length == 0 {
        return "A note needs a name before \".tsk\".";
    }
    if isFolder && trimmed.startsWith(".") {
        return "Folders starting with \".\" are hidden from the notes.";
    }
    if isFolder && trimmed.endsWith(".") {
        return "A folder name cannot end with \".\".";
    }
    return "";
}

// The file a note called `name` is saved as. It ends in ".tsk", which the
// name may already do.
fn noteFileName(name: str): str {
    let trimmed = name.trim();
    if trimmed.endsWith(".tsk") {
        return trimmed;
    }
    return trimmed + ".tsk";
}

// What creating a note or a folder came to: its path, or why there is none.
struct CreatedEntry {
    path: str = "";
    error: str = "";
}

// A file system error as the end of a sentence.
fn fsErrorText(error: fs.Error): str {
    if error == fs.Error.PermissionDenied {
        return "permission denied";
    }
    if error == fs.Error.NameTooLong {
        return "the name is too long";
    }
    if error == fs.Error.InvalidPath || error == fs.Error.NotADirectory {
        return "the file system does not allow this name";
    }
    if error == fs.Error.NotFound {
        return "the folder is not there any more";
    }
    return "the file system reported an error";
}

// Why nothing can be created in `folder`: it was removed outside the app
// since the tree last looked. Nothing creates it again. "" when it is there.
fn missingFolderError(folder: str): str {
    if fs.listDir(folder) {
        return "";
    }
    return f"The folder \"{baseName(folder)}\" is not there any more.";
}

// Creates the note `name` in `folder`, holding `contents`. A file already
// there is never replaced, nor is one whose name differs only in case where
// the file system ignores case.
fn createNote(folder: str, name: str, contents: str): CreatedEntry {
    let problem = entryNameError(name, false);
    if problem.length > 0 {
        return CreatedEntry { error: problem };
    }
    let gone = missingFolderError(folder);
    if gone.length > 0 {
        return CreatedEntry { error: gone };
    }
    let fileName = noteFileName(name);
    let title = noteTitle(fileName);
    let written = fs.createText(f"{folder}/{fileName}", contents);
    if !written {
        if written == fs.Error.AlreadyExists {
            return CreatedEntry { error: f"\"{title}\" already exists in this folder." };
        }
        return CreatedEntry { error: f"Could not create \"{title}\": {fsErrorText(written)}." };
    }
    return CreatedEntry { path: f"{folder}/{fileName}" };
}

// Gives `folder` a keep file, or takes it away: whether the tree shows it
// with no note in it. "" when done, else why not. A keep file that is there
// already is left as it is.
fn setFolderKept(folder: str, kept: bool): str {
    let keepPath = f"{folder}/{KEEP_FILE}";
    if kept {
        let gone = missingFolderError(folder);
        if gone.length > 0 {
            return gone;
        }
        let written = fs.createText(keepPath, "");
        if !written {
            if written != fs.Error.AlreadyExists {
                return f"Could not keep \"{baseName(folder)}\": {fsErrorText(written)}.";
            }
        }
        return "";
    }
    let removed = fs.removeFile(keepPath);
    if !removed {
        if removed != fs.Error.NotFound {
            return f"Could not change \"{baseName(folder)}\": {fsErrorText(removed)}.";
        }
    }
    return "";
}

// Creates the folder `name` in `folder`, with a keep file so the tree shows
// it. A folder of that name that is there already but not in the tree (it
// holds no note) gets the keep file and is shown from then on; one the tree
// shows already is an error, and is left alone.
fn createFolder(folder: str, name: str): CreatedEntry {
    let problem = entryNameError(name, true);
    if problem.length > 0 {
        return CreatedEntry { error: problem };
    }
    let gone = missingFolderError(folder);
    if gone.length > 0 {
        return CreatedEntry { error: gone };
    }
    let folderName = name.trim();
    let path = f"{folder}/{folderName}";
    if isShownFolder(path) {
        return CreatedEntry { error: f"A folder named \"{folderName}\" already exists here." };
    }
    let made = fs.createDirectory(path);
    if !made {
        // What createDirectory says when something other than a folder is
        // at the path.
        if made == fs.Error.NotAFile {
            return CreatedEntry { error: f"There is a file named \"{folderName}\" here already." };
        }
        return CreatedEntry { error: f"Could not create \"{folderName}\": {fsErrorText(made)}." };
    }
    let keepError = setFolderKept(path, true);
    if keepError.length > 0 {
        return CreatedEntry { error: keepError };
    }
    return CreatedEntry { path: path };
}

// ── Names ───────────────────────────────────────────────────────────────

fn isSeparator(c: int): bool {
    return c == 47 || c == 92;
}

// The last part of a path, either separator: a vault's or a folder's own name.
fn baseName(path: str): str {
    let end = path.length;
    while end > 1 && isSeparator(path[end - 1] as int) {
        end = end - 1;
    }
    let start = end;
    while start > 0 && !isSeparator(path[start - 1] as int) {
        start = start - 1;
    }
    return path.slice(start, end);
}

// The last part of the path of an entry in a vault. Below the vault's own
// path the separator is "/" on every system (fs.listDir joins with it), and
// on Linux a name may hold a backslash, so only "/" splits here.
fn entryName(path: str): str {
    let start = path.length;
    while start > 0 && path[start - 1] as int != 47 {
        start = start - 1;
    }
    return path.slice(start, path.length);
}

// What a note is called in the tree and the app bar: its file name without
// the extension every note has.
fn noteTitle(path: str): str {
    let name = entryName(path);
    if name.endsWith(".tsk") {
        return name.slice(0, name.length - 4);
    }
    return name;
}
