
struct FSFileEntry {
  type: "file";
  filename: str;
  fullPath: str;
}

struct FSDirEntry {
  type: "directory";
  dirname: str;
  fullPath: str;
  children: []FSEntry;
}

[[json.discriminator="type"]]
type FSEntry = FSFileEntry | FSDirEntry;

struct VaultFS {
  entries: rx.Reactive<[]FSEntry>;
}

fn indexDirectory(path: str): []FSEntry :: final {
    let entries: []FSEntry = [];
    if let dirs = fs.listDir(path) {
        for dir in dirs {
            if dir.isFile {
                entries.push(FSFileEntry {
                    type: "file",
                    filename: dir.name,
                    fullPath: dir.path,
                });
            }
            if dir.isDirectory {
                entries.push(FSDirEntry {
                    type: "directory",
                    dirname: dir.name,
                    fullPath: dir.path,
                    children: indexDirectory(dir.path),
                });
            }
        }
    }
    return entries;
}

fn indexVault(vaultPath: str): VaultFS {
    let vault = VaultFS {
        entries: rx.reactive<[]FSEntry>(indexDirectory(vaultPath)),
    };
    return vault;
}


