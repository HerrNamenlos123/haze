import binfile
// Saving and loading a note: an .hznote file (hznote.hz), written and read
// in one go each. Even the largest note reads and decodes in a few tens of
// ms: there is nothing left worth spreading over frames. (The strokes'
// outlines and tessellations, the expensive part of showing a note, are
// still computed tile by tile as they come into view; see render.hz.)

// What a new note holds: technicalsketcher.web's new document (createDocument
// in its store.ts), one blank ruled A4 page.
fn newNoteBytes(): Bytes {
    let blank: []Shape = [];
    let pages: []Page = [Page { shapes: blank }];
    return encodeNote(DocumentFile {
        data: DocumentBody {
            pageColor: "#ffffff",
            gridColor: "#5252524f",
            gridType: "lines",
            pages: pages,
            pageWidthMm: 210.0,
            pageHeightMm: 297.0,
            currentPageIndex: 0,
        },
    });
}

// How much of a file is read to tell whether it is a note at all.
const comptime noteHeadBytes = 16;

// ── Saving ──────────────────────────────────────────────────────────────

// Writes `doc` to `path` when stepped. The file is replaced in one step
// (fs.replaceBinary): a crash or a failed write leaves the old file intact.
// A save that has not started yet is replaced by a newer one (see
// EditorControls.saveNow), and the document stays in memory until its last
// save is written.
ref struct DocumentSave {
    path: str;
    doc: DocumentFile;
    finished: bool = false;
    failed: bool = false;

    fn constructor(path: str, doc: DocumentFile): DocumentSave {
        return DocumentSave { path: path, doc: doc };
    }

    // Whether writing has begun.
    fn started(): bool {
        return this.finished;
    }

    // Writes the note. True once the save is over -- done or failed.
    fn step(deadline: real): bool {
        if this.finished {
            return true;
        }
        this.finished = true;
        let written = fs.replaceBinary(this.path, encodeNote(this.doc));
        if !written {
            fmt.println(f"Failed to save {this.path}: {written}");
            this.failed = true;
        }
        return true;
    }

    // Writes it now.
    fn finish() {
        this.step(0.0);
    }
}

// ── Loading ─────────────────────────────────────────────────────────────

// Reads the note at `path` when stepped: the frame before shows that it is
// being opened.
ref struct DocumentLoad {
    path: str;
    doc: DocumentFile | none = none;
    finished: bool = false;
    failed: bool = false;
    // It failed because the file is not a note at all, rather than a note
    // that is damaged.
    notANote: bool = false;
    // Why it failed otherwise, for the page to say.
    hint: str = "The file is damaged.";

    fn constructor(path: str): DocumentLoad {
        return DocumentLoad { path: path };
    }

    fn fail(message: str) {
        fmt.println(f"Document failed to load: {message}");
        this.failed = true;
        this.finished = true;
    }

    fn cancel() {
        this.finished = true;
        this.failed = true;
    }

    fn progress(): real {
        return this.finished ? 1.0 : 0.0;
    }

    // Loads the note. True once the load is over -- see `doc`, none when it
    // failed.
    fn step(deadline: real): bool {
        if this.finished {
            return true;
        }
        // What a file is, its first bytes say. A file that is no note is
        // turned down before it is read: it may be a video of several
        // gigabytes.
        let head = fs.readHead(this.path, noteHeadBytes);
        if !head {
            // Only a regular file is read: a folder, or a named pipe (which
            // would never answer), is no note either.
            if head == fs.Error.NotAFile {
                this.notANote = true;
            } else if head == fs.Error.NotFound {
                this.hint = "It is not there any more: it was moved or deleted outside Haze Notes.";
            } else if head == fs.Error.PermissionDenied {
                this.hint = "Haze Notes is not allowed to read it.";
            } else {
                this.hint = "It could not be read.";
            }
            this.fail(f"cannot open {this.path}");
            return true;
        }
        let headText: str = head;
        if !isHznote(Bytes(headText)) {
            this.notANote = true;
            this.fail(f"{this.path} is not a note");
            return true;
        }
        let data = fs.readBinary(this.path);
        if !data {
            this.hint = "It could not be read.";
            this.fail(f"cannot read {this.path}");
            return true;
        }
        let decoded = decodeNote(data);
        if decoded is binfile.Error {
            if decoded.problem == binfile.Problem.NotThisFormat {
                this.notANote = true;
            } else if decoded.problem == binfile.Problem.Newer {
                this.hint = "It was saved by a newer Haze Notes.";
            } else if decoded.problem == binfile.Problem.Incompatible {
                this.hint = f"It holds something this version of Haze Notes cannot read: {decoded.describe()}.";
            } else {
                this.hint = f"The file is damaged: {decoded.describe()}.";
            }
            this.fail(f"{this.path}: {decoded.describe()}");
            return true;
        }
        let doc: DocumentFile = decoded;
        settleLoadedShapes(doc);
        this.doc = doc;
        this.finished = true;
        return true;
    }
}

// Earlier builds left a shape dragged onto another page on the one it came
// from, where nothing showed it any more: every shape goes to the page it
// lies on (pageShapeLiesOn), in the order of the file. In memory only; the
// next save writes it so.
fn settleLoadedShapes(doc: DocumentFile) {
    let count = doc.data.pages.length;
    let settled: [][]Shape = [];
    for (let i = 0; i < count; i++) {
        let shapes: []Shape = [];
        settled.push(shapes);
    }
    let moved = false;
    for (let page = 0; page < count; page++) {
        for shape in doc.data.pages[page].shapes {
            let liesOn = pageShapeLiesOn(doc, page, shape);
            if liesOn != page {
                shiftShapeToPage(doc, shape, page, liesOn);
                moved = true;
            }
            settled[liesOn].push(shape);
        }
    }
    if moved {
        for (let page = 0; page < count; page++) {
            doc.data.pages[page].shapes = settled[page];
        }
    }
}
