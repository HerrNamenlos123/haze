// What can be done to the selected strokes: recolour them, or delete them.
// Shown just above the selection.

@emit
color: (str,);
remove: ();

@setup
let colors = penColors();

let pickColor = (color: str) => {
    emits.color(color);
};

let remove = () => {
    emits.remove();
};

@template [w-fit h-fit]

Surface [] {
    #content {
        ColorSwatch for=[color, i in colors] key=[i] [] color=[color] @pick=pickColor {}
        Divider [] {}
        IconButton [] icon="trash" danger=[true] paddingX=[8.0] paddingY=[8.0] @click=remove {}
    }
}
