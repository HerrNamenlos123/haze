// The file tree as a list: what FileTree.hzui shows, worked out without any
// UI so it can be tested on its own.
//
// The tree is drawn the way VS Code draws one: every open folder's children
// are flattened into a single list of rows, all exactly one row high, and only
// the rows in view are built. The list's height is then known exactly
// (rows x row height) whatever is scrolled into view, which is what keeps a
// scroll container from correcting itself frame after frame at the end of the
// list. Clay caps a layout at 8192 elements, so building only the rows in view
// is also what lets a huge open folder render at all.

// One row of the tree.
struct TreeRow {
    // Vault-relative (see VaultIndex).
    path: str;
    // What the row says: a folder's name, or a note's title.
    name: str;
    // How many open folders it sits in.
    depth: int;
    isDir: bool;
    // For a folder, whether its children are listed below it.
    open: bool;
    // Not part of the notes: a file that is no note, or a folder the tree
    // shows only while it shows every file. Drawn faded.
    ghost: bool = false;
}

// The rows of `index`: its top level and everything in the open folders,
// depth first -- the order they are drawn in. `expanded` holds the open
// folders' vault-relative paths. A closed folder's entries are skipped in
// one step (IndexEntry.descendants), so this costs what is shown, not the
// whole index.
fn flattenTree(index: VaultIndex, expanded: LinearMap<str, bool>, out: []TreeRow) {
    let i = 0;
    while i < index.count {
        let e = index.entry(i);
        let path = index.path(e);
        let ghost = isIndexGhost(e);
        if isIndexFolder(e) {
            let open = expanded.has(path);
            out.push(TreeRow {
                path: path,
                name: index.name(e),
                depth: e.depth as int,
                isDir: true,
                open: open,
                ghost: ghost,
            });
            i = i + 1;
            if !open {
                i = i + e.descendants as int;
            }
        } else {
            let name = index.name(e);
            out.push(TreeRow {
                path: path,
                // A file that is no note keeps its whole name: the note
                // extension is only left off where every name has it.
                name: ghost ? name : noteTitle(name),
                depth: e.depth as int,
                isDir: false,
                open: false,
                ghost: ghost,
            });
            i = i + 1;
        }
    }
}

// The open folders, by path, as flattenTree looks them up.
fn expandedSet(paths: []str): LinearMap<str, bool> {
    let set = LinearMap<str, bool>();
    for path in paths {
        set.set(path, true);
    }
    return set;
}

// The index of the row showing `path`, or -1.
fn rowIndexOf(rows: []TreeRow, path: str): int {
    for (let i = 0; i < rows.length; i++) {
        // Bound first: an indexed element of a value-struct array used in
        // a call (string == is one) generates C that does not compile.
        let row = rows[i];
        if row.path == path {
            return i;
        }
    }
    return -1;
}

// The folders the entry at vault-relative `path` lies in, outermost first
// (the ones that have to be open for its row to show), appended to `out`.
// The entry may be a note or a folder. False, and `out` as it was, when no
// entry has that path.
fn folderChainTo(index: VaultIndex, path: str, out: []str): bool {
    let target = index.find(path);
    if target < 0 {
        return false;
    }
    let depth = index.entry(target).depth as int;
    let start = out.length;
    // The folders around it are the nearest folder before it at each
    // smaller depth.
    for (let i = target - 1; i >= 0 && depth > 0; i--) {
        let e = index.entry(i);
        if isIndexFolder(e) && e.depth as int == depth - 1 && i + e.descendants as int >= target {
            out.insert(start, index.path(e));
            depth = depth - 1;
        }
    }
    return true;
}

// `paths` with `path` added when it is missing and removed when it is there:
// opening or closing one folder.
fn toggledPaths(paths: []str, path: str): []str {
    let result: []str = [];
    let found = false;
    for existing in paths {
        if existing == path {
            found = true;
        } else {
            result.push(existing);
        }
    }
    if !found {
        result.push(path);
    }
    return result;
}

// The slice of the list to build: rows [start, end), with the space of the
// rows before and after it held open by a spacer each.
struct TreeWindow {
    start: int = 0;
    end: int = 0;
    rowsBefore: int = 0;
    rowsAfter: int = 0;
}

// Which rows of `count` to build for a viewport `viewHeight` tall scrolled
// `scrollTop` into a list that starts `padding` below the scrolled content's
// top, plus `overscan` rows past each edge so a row scrolling in is already
// there.
fn treeWindow(count: int, rowHeight: real, padding: real, scrollTop: real, viewHeight: real, overscan: int): TreeWindow {
    if count <= 0 || rowHeight <= 0.0 {
        return TreeWindow {};
    }
    let top = scrollTop - padding;
    let first = (top / rowHeight) as int;
    if top < 0.0 {
        first = 0;
    }
    let visible = (viewHeight / rowHeight) as int + 2;
    let start = first - overscan;
    if start < 0 { start = 0; }
    if start > count { start = count; }
    let end = first + visible + overscan;
    if end > count { end = count; }
    if end < start { end = start; }
    return TreeWindow {
        start: start,
        end: end,
        rowsBefore: start,
        rowsAfter: count - end,
    };
}

// The folder the entry at `path` is in (see entryName): "" for an entry at
// the top of a vault-relative path.
fn parentFolder(path: str): str {
    return path.slice(0, max(0, path.length - entryName(path).length - 1));
}

// A context menu asked for in the tree: by a right click, a pen's barrel
// button, or a finger resting on a row.
struct TreeMenuRequest {
    // The row's entry, vault-relative, or "" for the tree's empty space,
    // which is the vault.
    path: str = "";
    isDir: bool = false;
    ghost: bool = false;
    // Where it was asked for, in window px.
    pos: Vec2 = {};
}
