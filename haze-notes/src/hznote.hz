import binfile

// .hznote: Haze Notes' file format, a binfile (stdlib/binfile, where the
// layout, the checksums and the rules for reading other versions are): a
// note's settings (DocumentBody, all but its pages) in the root, each page a
// chunk of its own.

// The format: "\x89HZNOTE\n" (built byte by byte: the two parsers read a
// \x escape above 0x7F differently).
fn hznoteFormat(): binfile.Format {
    let magic = ByteBuffer(8);
    magic.push(0x89 as u8);
    magic.push("HZNOTE\n");
    magic.commit();
    return binfile.Format { magic: magic.bytes(), name: "Haze Notes" };
}

// Whether `head`, the first bytes of a file, are an .hznote's.
export fn isHznote(head: Bytes): bool {
    return binfile.isFormat(hznoteFormat(), head);
}

// ── Notes ───────────────────────────────────────────────────────────────

// The note as a file: its settings in the header, each page a chunk.
export fn encodeNote(doc: DocumentFile): Bytes {
    return binfile.write<DocumentBody, Page>(hznoteFormat(), doc.data, doc.data.pages);
}

export fn decodeNote(data: Bytes): DocumentFile | binfile.Error {
    let file = binfile.read<DocumentBody, Page>(hznoteFormat(), data);
    if file is binfile.Error {
        return file;
    }
    let body = file.root;
    body.pages = file.chunks;
    return DocumentFile { data: body };
}

// ── Shapes on the clipboard ─────────────────────────────────────────────

// What Ctrl+C puts on the clipboard: the shapes in this same format, as a
// file without chunks. Nothing but Haze Notes reads it.
export const comptime shapesMimeType = "application/x-haze-notes-shapes";

struct ShapesOnClipboard {
    shapes: []Shape;
}

export fn encodeShapes(shapes: []Shape): Bytes {
    let noPages: []Page = [];
    return binfile.write<ShapesOnClipboard, Page>(hznoteFormat(), ShapesOnClipboard { shapes: shapes }, noPages);
}

export fn decodeShapes(data: Bytes): []Shape | binfile.Error {
    let file = binfile.read<ShapesOnClipboard, Page>(hznoteFormat(), data);
    if file is binfile.Error {
        return file;
    }
    return file.root.shapes;
}
