@props
[[hzui.untracked]]
cache: json.CacheFile<VaultCache>;
[[hzui.untracked]]
gfx: mut renderer.gfx.Context;

@setup
let currentDocumentPath = reactive<str | none>(none);
if props.cache.data.lastOpenedFile {
    currentDocumentPath := props.cache.data.lastOpenedFile;
}

let openFile = (path: str) => {
    currentDocumentPath := path;
    props.cache.data.lastOpenedFile := path;
}

let documentRenderer = DocumentRenderer(props.gfx);
let canvasAreaRef = ui.elementRef<DivElement>();
let canvasRef = ui.canvasRef();

// The renderer's state is plain data the canvas cannot track, so every
// change to it says so. The redraw happens once, at the canvas's step of the
// next frame, however often this is called before then.
let invalidateCanvas: () => none = () => {
    canvasRef?.invalidate();
};
let controls = EditorControls(documentRenderer, invalidateCanvas);

// The document lives in `controls`, which loads, edits and saves it; its
// documentOpen and loadingDocument are what the template switches on.
ui.watch(() => rx.get(currentDocumentPath), (old, new) => {
    controls.open(rx.get(currentDocumentPath));
}, { immediate: true });

// Unsaved work is written before the app goes -- there are no more frames to
// spread the save over, but the window is already gone.
onExit(() => {
    controls.finishSaves();
});

let loadingText = computed((): str => {
    let percent = (rx.get(controls.loadProgress) * 100.0) as int;
    return f"Loading... {percent}%";
});

// Pointer positions arrive window-global; the controls work in canvas px.
let toLocal = (pos: Vec2): Vec2 => {
    let area = rx.get(canvasAreaRef);
    if area {
        if let origin = area.position() {
            return Vec2(pos.x - origin.x, pos.y - origin.y);
        }
    }
    return pos;
};

let onPointerDown = (e: PointerEvent) => {
    controls.pointerDown(e, toLocal(e.pos));
};
let onPointerMove = (e: PointerEvent) => {
    controls.pointerMove(e, toLocal(e.pos));
};
let onPointerUp = (e: PointerEvent) => {
    controls.pointerUp(e, toLocal(e.pos));
};
let onWheel = (e: WheelEvent) => {
    controls.wheel(e, toLocal(e.pos));
};
let onKeyDown = (e: KeyboardEvent) => {
    controls.keyDown(e, ui);
};

// Polled every frame: a mouse drag that leaves the canvas, a pinch waiting
// out its grace period, the autosave -- see EditorControls.frame. Runs before
// the canvas's step of the same frame, so what it changes is drawn at once.
ui.onFrame(() => {
    controls.frame(ui, toLocal(ui.mousePos));
});

// Runs only when the canvas has to be drawn again: when it is created or
// resized, or when invalidateCanvas() says something on it changed.
let renderCanvas = (r: mut renderer.gfx.Renderer): void => {
    controls.render(r);
    // A settling zoom, and tiles the frame's budget did not reach, need more
    // renders to finish.
    if documentRenderer.hasPendingWork() {
        canvasRef?.invalidate();
    }
};

let colors = penColors();
let sizes = penThicknesses();

let penToolActive = computed((): bool => !rx.get(controls.selectionTool) && !rx.get(controls.eraserTool));

// The pen menu, centred on where the barrel button was tapped (as in the web
// app); its size is fixed by its content, so the offsets are too.
let penMenuOpen = computed((): bool => {
    if rx.get(controls.popup) { return true; }
    return false;
});
let penMenuLeft = computed((): real => {
    if let p = rx.get(controls.popup) { return p.x - 130.0; }
    return 0.0;
});
let penMenuTop = computed((): real => {
    if let p = rx.get(controls.popup) { return p.y - 48.0; }
    return 0.0;
});

// Recolor and delete, just above the selection's top-right corner.
let selectionPanelOpen = computed((): bool => {
    if rx.get(controls.selectionScreenBox) { return true; }
    return false;
});
let selectionPanelLeft = computed((): real => {
    if let box = rx.get(controls.selectionScreenBox) { return box.right; }
    return 0.0;
});
let selectionPanelTop = computed((): real => {
    if let box = rx.get(controls.selectionScreenBox) { return max(0.0, box.top - 48.0); }
    return 0.0;
});

let sidepanelOpen = reactive<bool>(true);
let closeSidepanel = () => {
    sidepanelOpen := false;
}
let openSidepanel = () => {
    sidepanelOpen := true;
}

@template [relative]

div if=[rx.get(controls.loadingDocument)] [w-grow h-grow justify-center items-center] {
    text [] [rx.get(loadingText)]
}

div else-if=[!rx.get(controls.documentOpen)] [w-grow h-grow justify-center items-center] {
    text [] ["No document is selected"]
}

// `touch-none`: the canvas reads fingers itself -- one pans the page, two
// pinch-zoom it (see EditorControls) -- so the framework must not turn a
// finger's drag into a scroll and cancel it.
div else [w-grow h-grow] {
    div [w-grow h-grow touch-none [rx.get(controls.resizeCursor)]?cursor-resize-n-w-s-e] ref=canvasAreaRef
        focusable=[true]
        @pointerdown=onPointerDown
        @pointermove=onPointerMove
        @pointerup=onPointerUp
        @wheel=onWheel
        @keydown=onKeyDown
    {
        canvas [w-grow h-grow] ref=canvasRef @render=renderCanvas
    }
}

div if=sidepanelOpen [absolute col top-0 left-0 h-grow w-[props.cache.data.sidepanelWidth/4.0] p-4 bg-["#222"] border-r-2 border-color-["#FFF"]] {
    div [justify-between w-grow] {
        text [] ["Haze Notes"]
        div [p-2] {
            Button [] icon="menu" @click=closeSidepanel {}
        }
    }

    FileTree if=[props.cache.data.vault] [] expandedEntries=[props.cache.data.expandedFolders] entries=[props.cache.data.vault.entries] @select=openFile {}
}

div else [absolute top-0 left-0 p-4] {
    Button [] icon="menu" @click=openSidepanel {}
}

// The tools: pen (at five thicknesses), selection, eraser, and the pen color.
// The barrel-button menu offers the same; this is for a pen without one.
div if=[rx.get(controls.documentOpen)] [absolute top-0 right-0 p-4] {
    div [row items-center gap-1 p-1 bg-["#222"] rounded-6 border-1 border-color-["#555"]] {
        div for=[size, index in sizes] key=[index]
            [w-[30]px h-[30]px items-center justify-center rounded-4 cursor-pointer
             [rx.get(penToolActive) && rx.get(controls.penSizeMm) == size]?bg-["#555"]]
            @click=[(e: PointerEvent) => { controls.usePen(size); }]
        {
            div [w-[20]px h-[size * 5.0 + 1.0]px rounded-2 bg-[rx.get(controls.penColor)]]
        }
        Button [] icon="inspect" selected=[rx.get(controls.selectionTool)] @click=[() => { controls.useSelectionTool(); }] {}
        Button [] icon="eraser" selected=[rx.get(controls.eraserTool)] @click=[() => { controls.useEraser(); }] {}
        div [w-[1]px h-[24]px bg-["#555"]]
        div for=[color, index in colors] key=[index]
            [w-[26]px h-[26]px items-center justify-center rounded-13 cursor-pointer
             [rx.get(controls.penColor) == color]?bg-["#888"]]
            @click=[(e: PointerEvent) => { controls.setPenColor(color); }]
        {
            div [w-[18]px h-[18]px rounded-9 bg-[color]]
        }
    }
}

div if=[rx.get(selectionPanelOpen)] [absolute left-[rx.get(selectionPanelLeft)] top-[rx.get(selectionPanelTop)]] {
    div [row items-center gap-1 p-1 bg-["#222"] rounded-6 border-1 border-color-["#555"]] {
        div for=[color, index in colors] key=[index]
            [w-[26]px h-[26]px items-center justify-center rounded-13 cursor-pointer]
            @click=[(e: PointerEvent) => { controls.setSelectionColor(color); }]
        {
            div [w-[18]px h-[18]px rounded-9 bg-[color]]
        }
        Button [] icon="trash" @click=[() => { controls.deleteSelection(); }] {}
    }
}

// The pen menu: pen color, then the selection tool and the five pens.
div if=[rx.get(penMenuOpen)] [absolute left-[rx.get(penMenuLeft)] top-[rx.get(penMenuTop)] col items-center gap-2] {
    div [row items-center gap-1 p-1 bg-["#222"] rounded-6 border-1 border-color-["#555"]] {
        div for=[color, index in colors] key=[index]
            [w-[30]px h-[30]px items-center justify-center rounded-15 cursor-pointer]
            @click=[(e: PointerEvent) => { controls.setPenColor(color); }]
        {
            div [w-[22]px h-[22]px rounded-11 bg-[color]]
        }
    }
    div [row items-center gap-1 p-1 bg-["#222"] rounded-6 border-1 border-color-["#555"]] {
        Button [] icon="inspect" @click=[() => { controls.useSelectionTool(); }] {}
        div for=[size, index in sizes] key=[index]
            [w-[34]px h-[34]px items-center justify-center rounded-4 cursor-pointer]
            @click=[(e: PointerEvent) => { controls.usePen(size); }]
        {
            div [w-[24]px h-[size * 5.0 + 1.0]px rounded-2 bg-["#DDD"]]
        }
    }
}
