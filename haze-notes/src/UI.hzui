import filedialog
from binfile import CacheFile

// The app: which vault is open, and the welcome screen before any vault is.

// What the app remembers between runs, in the platform's cache directory
// (globalCachePath).
struct GlobalCache {
    currentVaultDir: str | none = none;
    knownVaultDirs: []str | none = none;
}

// What the app remembers of a vault, in its .hznotes/vault.hzcache. A field
// missing from the file (written before the field existed) takes its default.
// Paths are vault-relative (see VaultIndex), so a vault moved or copied keeps
// all of it.
struct VaultCache {
    lastOpenedFile: str | none = none;
    expandedFolders: []str = [];
    // In px.
    sidepanelWidth: real = 260.0;
    sidepanelOpen: bool = true;
    // The tree lists every file and folder, not only the notes.
    showAllFiles: bool = false;
    // Where the tree was scrolled to, in px.
    treeScrollTop: real = 0.0;
}

// The vault's notes index as last walked, in its .hznotes/index.hzcache: the
// tree shows it from the first frame, and the vault is walked again once the
// app has settled (Workspace). A file of its own: the index is written only
// when it changes, the rest of the vault's state whenever that does.
struct IndexCache {
    // none until the vault was first walked.
    index: VaultIndex | none = none;
    // What the walk that made it used of its arena (ArenaUsage): the next
    // walk's arena is made that size (VaultWalk).
    arenaScanned: int = 0;
    arenaUnscanned: int = 0;
}

// An open vault. `id` counts vaults opened in this run, so each one mounts
// a fresh Workspace.
ref struct VaultSession {
    id: int;
    path: str;
    cache: CacheFile<VaultCache>;
    indexCache: CacheFile<IndexCache>;

    fn flush() {
        this.cache.flush();
        this.indexCache.flush();
    }

    fn close() {
        this.cache.close();
        this.indexCache.close();
    }
}

// Where the app keeps what it remembers between runs: the platform's cache
// directory.
fn globalCachePath(): str {
    if let dir = env.get("XDG_CACHE_HOME") {
        if dir.length > 0 { return f"{dir}/haze-notes/app.hzcache"; }
    }
    if let home = env.get("HOME") {
        if home.length > 0 { return f"{home}/.cache/haze-notes/app.hzcache"; }
    }
    if let local = env.get("LOCALAPPDATA") {
        if local.length > 0 { return f"{local}/haze-notes/app.hzcache"; }
    }
    return "haze-notes-app.hzcache";
}

// A folder picker in flight. The dialog runs beside the app rather than
// blocking it, and is asked every frame whether it is done.
ref struct VaultPicker {
    pending?: filedialog.PendingDialog;
}

@props
[[hzui.untracked]]
gfx: mut renderer.gfx.Context;

@setup
let cache = CacheFile<GlobalCache>(globalCachePath());

// Remembered vaults, the one opened last at the end.
let rememberVault = (dir: str) => {
    let known: []str = [];
    if let dirs = rx.get(cache.data.knownVaultDirs) {
        for d in dirs {
            if d != dir {
                known.push(d);
            }
        }
    }
    known.push(dir);
    cache.data.knownVaultDirs := known;
};

// Forgets a remembered vault -- one that is not there any more.
let forgetVault = (dir: str) => {
    let known: []str = [];
    if let dirs = rx.get(cache.data.knownVaultDirs) {
        for d in dirs {
            if d != dir {
                known.push(d);
            }
        }
    }
    cache.data.knownVaultDirs := known;
};

let openVault = (dir: str) => {
    // A vault on a drive that is gone, or a folder since deleted, is not
    // opened: its cache would be created afresh in its place, or fail to be.
    // `exists` answers with a Result -- its Ok-ness is not the answer.
    let present = false;
    if let exists = fs.exists(dir) {
        present = exists;
    }
    if !present {
        forgetVault(dir);
        return;
    }
    cache.data.currentVaultDir := dir;
    rememberVault(dir);
};

let picker = VaultPicker {};
let pickVault = () => {
    if picker.pending { return; }
    picker.pending = filedialog.pickFolderAsync();
};

onFrame(() => {
    if let pending = picker.pending {
        if pending.done() {
            let result = pending.result();
            picker.pending = none;
            if result is filedialog.DialogSuccess {
                openVault(result.path);
            }
        }
    }
});

// Most recent first, for the welcome screen.
let recentVaults = computed((): []str => {
    let recent: []str = [];
    if let dirs = rx.get(cache.data.knownVaultDirs) {
        for (let i = dirs.length - 1; i >= 0; i--) {
            recent.push(dirs[i]);
        }
    }
    return recent;
});

// The open vault. A new vault is a new session, and a new session a new
// Workspace. The same vault stays the same session however often its path
// is written: another instance's write of the cache may write it again, and
// opening the vault that is already open writes the same path -- neither may
// tear the open note down.
let sessionCount: ref Box<int> = { value: 0 };
let currentSession: ref Box<VaultSession | none> = { value: none };
let session = computed((): VaultSession | none => {
    let dir = rx.get(cache.data.currentVaultDir);
    if !dir {
        currentSession.value = none;
        return none;
    }
    if let existing = currentSession.value {
        if existing.path == dir { return existing; }
    }
    sessionCount.value = sessionCount.value + 1;
    let created = VaultSession {
        id: sessionCount.value,
        path: dir,
        cache: CacheFile<VaultCache>(f"{dir}/.hznotes/vault.hzcache"),
        indexCache: CacheFile<IndexCache>(f"{dir}/.hznotes/index.hzcache"),
    };
    currentSession.value = created;
    return created;
});

// The vault a session replaces is written out and let go. Not inside the
// computed above: a computed must not write state. (Indexing is the
// Workspace's: from the cache at once, walked again once the app settled.)
let activeSession: ref Box<VaultSession | none> = { value: none };
ui.watch(() => rx.get(session), (value, old) => {
    let next = rx.get(session);
    if let p = activeSession.value {
        if let n = next {
            if p.id == n.id { return; }
        }
        p.close();
    }
    activeSession.value = next;
}, { immediate: true });

let sessions = computed((): []VaultSession => {
    let list: []VaultSession = [];
    if let s = rx.get(session) {
        list.push(s);
    }
    return list;
});

let hasSession = computed((): bool => rx.get(sessions).length > 0);

// Changes whenever the list of recent vaults does, order included -- what
// tells the welcome screen to draw it again.
let recentKey = computed((): str => {
    let key = "";
    let dirs: []str = rx.get(recentVaults);
    for dir in dirs {
        key = key + dir + "\n";
    }
    return key;
});

// Every frame, write what changed (once settled, see CacheFile), until there
// is an async event loop; at exit, what is left.
onFrame(() => {
    cache.flush();
    if let s = rx.get(session) {
        s.flush();
    }
});

onExit(() => {
    cache.close();
    if let s = activeSession.value {
        s.close();
    }
});

@template [col w-grow h-grow bg-[theme().chrome] text-color-[theme().text] font-size-13]

Workspace for=[s in sessions] key=[s.id] [] cache=[s.cache] indexCache=[s.indexCache] gfx=[props.gfx] vaultPath=[s.path]
    @switchVault=pickVault {}

div if=[!hasSession] [col w-grow h-grow] {
    AppBar [] title="Haze Notes" sidebarButton=[false] windowControls=[!ui.window.hasNativeTitlebar()] {}
    WelcomeScreen [] recent=[recentVaults] revision=[rx.get(recentKey)]
        @pickVault=pickVault @openVault=openVault {}
}
