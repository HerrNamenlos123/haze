import renderer
import base64
import image

// Vertical gap between stacked pages, in mm (PDF-viewer-style layout: pages
// stack top to bottom at x=0, each pageHeightMm + pageGapMm below the last).
const comptime pageGapMm = 10.0;

// A zoom gesture is considered "finished" once the live zoom value has held
// steady (within zoomEpsilon) for this many consecutive render() calls --
// only then does a page zoomed into retile at the new native resolution.
const comptime zoomSettleFrames = 8;
const comptime zoomEpsilon = 0.0001;

// How long render() may spend per frame drawing tiles, tessellating the
// strokes on them and uploading their images (decoded on worker threads --
// see ImageLoad; a tile is drawn without the ones still loading, and again
// once they are there). Whatever does not fit is drawn in
// the following frames, nearest the middle of the view first; until then a
// square shows another zoom level's tiles stretched over it, or the blank
// page. This is what keeps the editor responsive however much a zoom, a
// scroll or an edit has to redraw -- the frame never waits for the document.
const comptime tileWorkBudgetSeconds = 0.006;

// Tiles of other zoom levels kept on screen while the current level's are
// still being drawn. Beyond this, the ones furthest from the current level
// go first.
const comptime maxFallbackTiles = 96;

// Unused tile canvases (1 MB of GPU memory each) kept for reuse; the rest are
// freed.
const comptime maxFreeTiles = 16;

// How long after the last tile was drawn before what drawing left behind is
// freed -- see DocumentRenderer.releaseIdle.
const comptime drawCacheIdleSeconds = 2.0;

// The ruled lines on every page, as the web app draws them: horizontal only,
// from the top edge down, in the document's gridColor.
const comptime gridLineDistanceMm = 10.0;
const comptime gridLineThicknessMm = 0.2;

// Paper, lines and content are stacked by zIndex, not by drawing order: a
// Renderer draws all its rects and textures before any triangles, so the
// lines (triangles) would otherwise cover pasted images -- and, on the
// panel, the tiles.
const comptime paperZIndex = -2.0;
const comptime gridLineZIndex = -1.0;

fn pageOriginY(doc: DocumentFile, pageIndex: int): real {
    return pageIndex as real * (doc.data.pageHeightMm + pageGapMm);
}

// The file's currentPageIndex, kept to a page that exists.
fn currentPageOf(doc: DocumentFile): int {
    let n = doc.data.pages.length;
    let i = doc.data.currentPageIndex;
    if i >= n { i = n - 1; }
    if i < 0 { i = 0; }
    return i;
}

// ImageShape.base64ImageData is stored as a full data URL
// ("data:image/png;base64,<payload>", per how browsers/paste handlers
// typically produce it), not a raw base64 payload -- base64.decode only
// accepts the latter, so the "data:...;base64," header has to be stripped
// first. A data URL's header can never itself contain a comma (it's
// exactly "data:[<mediatype>][;base64]"), so the first comma is always the
// header/payload boundary. Strings with no comma at all (already a raw
// base64 payload) pass through unchanged.
fn stripDataUrlPrefix(data: str): str {
    for (let i = 0; i < data.length; i++) {
        if data[i] == b"," {
            return data.slice(i + 1, i + 1 + data.length);
        }
    }
    return data;
}

// Decoded-image GPU textures, keyed by the shape's raw base64ImageData
// string. Deliberately *not* a field on ImageShape itself: that struct
// participates in json.parse<DocumentFile>/json.stringify for the whole
// document, and a field whose type reaches into opaque wgpu FFI handles
// (wgpu.Texture/TextureView/BindGroup are forward-declared-only C structs)
// breaks that generic codegen -- sizeof() on an intentionally-incomplete
// struct -- even when marked [[json.ignore]]. Living on DocumentRenderer
// instead (alongside TilePool, which is the same kind of GPU-resource-cache
// paired with the serializable document) sidesteps that entirely, and keying
// by content rather than shape identity means two shapes pasted from the
// same image share one upload for free.
ref struct ImageTextureCache {
    textures: LinearMap<str, renderer.gfx.Texture> = {};
    // Tracks base64 strings that failed to decode, so a corrupt/invalid
    // image is only ever attempted once rather than every frame.
    failed: LinearMap<str, bool> = {};

    // Images on their way to the GPU.
    loads: LinearMap<str, ImageLoad> = {};

    // Whether the image has arrived -- or failed to, so it never will.
    fn isReady(shape: ImageShape): bool {
        return this.textures.has(shape.base64ImageData) || this.failed.has(shape.base64ImageData);
    }

    fn isLoading(): bool {
        return this.loads.size() > 0;
    }

    // Starts getting the shape's image onto the GPU, unless it is there or
    // on its way. Cheap: the work is all done on worker threads.
    fn request(shape: ImageShape) {
        let key = shape.base64ImageData;
        if this.isReady(shape) || this.loads.has(key) {
            return;
        }
        this.loads.set(key, ImageLoad(key));
    }

    // Moves every load along, collecting what the workers finished. The
    // one expensive step is the upload of a finished mip chain (~1 ms per
    // megapixel), so after `deadline` the rest wait for the next call.
    fn advance(gfx: mut renderer.gfx.Context, deadline: real) {
        let finished: []str = [];
        for (let i = 0; i < this.loads.keys.length; i++) {
            if time.now() >= deadline {
                break;
            }
            let key = this.loads.keys[i];
            let load = this.loads.values[i];
            if !load.step(gfx) {
                continue;
            }
            if let texture = load.texture {
                this.textures.set(key, texture);
            } else {
                fmt.println("Image shape: failed to decode the image data");
                this.failed.set(key, true);
            }
            finished.push(key);
        }
        for key in finished {
            this.loads.delete(key);
        }
    }

    // The shape's texture: none while it is loading, or if it failed to.
    fn get(shape: ImageShape): renderer.gfx.Texture | none {
        return this.textures.get(shape.base64ImageData);
    }

    // Frees every texture -- the document they came from is gone. Nothing
    // drawn with one may still be waiting for its commit(). Loads still
    // running are dropped; their workers finish and are never read.
    fn releaseAll() {
        for texture in this.textures.values {
            texture.release();
        }
        this.textures.clear();
        this.failed.clear();
        this.loads.clear();
    }
}

// One image on its way to the GPU: its base64 text decoded, then the PNG or
// JPEG in it, then its mip chain built -- each on a worker thread, as each
// takes tens of ms per megapixel. A step only ever starts one of them, or
// collects one that is done.
ref struct ImageLoad {
    text?: base64.Base64Decode;
    decoding?: image.ImageDecode;
    uploading?: renderer.gfx.PendingTexture;
    texture?: renderer.gfx.Texture;
    failed: bool = false;

    fn constructor(base64ImageData: str): ImageLoad {
        return ImageLoad { text: base64.decodeAsync(stripDataUrlPrefix(base64ImageData)) };
    }

    // Moves the load along. True once it has its texture, or has failed.
    fn step(gfx: mut renderer.gfx.Context): bool {
        if let pending = this.uploading {
            if let texture = pending.poll() {
                this.texture = texture;
                this.uploading = none;
                return true;
            }
            return false;
        }
        if let decode = this.decoding {
            if !decode.done() {
                return false;
            }
            this.decoding = none;
            if let img = decode.result() {
                // stb_image returns straight alpha; premultiply=true converts
                // it to the premultiplied form this renderer's textured-quad
                // shader assumes.
                this.uploading = gfx.createRGBATextureAsync(img.pixels, img.width, img.height, true);
                return false;
            }
            this.failed = true;
            return true;
        }
        if let text = this.text {
            if !text.done() {
                return false;
            }
            this.text = none;
            if let bytes = text.result() {
                this.decoding = image.decodeAsync(bytes);
                return false;
            }
            this.failed = true;
            return true;
        }
        return true;
    }
}

// The web app's paper texture, which every page is drawn on.
ref struct PaperTexture {
    texture?: renderer.gfx.Texture;
    decoding?: image.ImageDecode;
    uploading?: renderer.gfx.PendingTexture;
    // It did not decode: pages are plain white instead.
    failed: bool = false;

    fn isReady(): bool {
        if this.texture {
            return true;
        }
        return this.failed;
    }

    // Moves the texture along towards the GPU. Decoding the 2 MP JPEG and
    // filtering its mip chain take ~100 ms, all of it on worker threads, so
    // a call only ever starts a step or finds one done. Call it every frame
    // until isReady().
    fn prepare(gfx: mut renderer.gfx.Context) {
        if this.isReady() {
            return;
        }
        if let pending = this.uploading {
            if let texture = pending.poll() {
                this.texture = texture;
                this.uploading = none;
            }
            return;
        }
        if let decode = this.decoding {
            if !decode.done() {
                return;
            }
            this.decoding = none;
            if let img = decode.result() {
                this.uploading = gfx.createRGBATextureAsync(img.pixels, img.width, img.height, true);
            } else {
                fmt.println("Paper texture: failed to decode");
                this.failed = true;
            }
            return;
        }
        this.decoding = image.decodeAsync(embed.binary("resources/paper-texture.jpg"));
    }
}

// Draws one shape's content into whatever tile canvas `r` is currently
// bound to (already in tile-local mm-space via Canvas.setViewProj, so no
// CPU-side transform is needed here -- raw mm vertices go straight in).
// `level` is the tile pyramid level this content is being rendered at --
// see LineShape.ensureTesselated for why tesselation is cached per
// level rather than once per shape.
fn drawShapeInto(r: mut renderer.gfx.Renderer, shape: Shape, level: int, imageCache: ImageTextureCache) {
    if shape is LineShape {
        let tess = shape.ensureTesselated(level);
        if tess.indices.length > 0 {
            r.addTriangles(tess.vertices, tess.indices, shape.penColor, 0);
        }
    }
    else if shape is ImageShape {
        // One still loading is left out; the tile is drawn again when it
        // arrives (Tile.waitingForImages).
        if !imageCache.isReady(shape) {
            return;
        }
        let bbox = shape.getBBox();
        if let texture = imageCache.get(shape) {
            r.drawTexture({
                texture: texture,
                pos: Vec2(bbox.left, bbox.top),
                size: Vec2(bbox.right - bbox.left, bbox.bottom - bbox.top),
            });
        } else {
            r.drawRect({
                pos: Vec2(bbox.left, bbox.top),
                size: Vec2(bbox.right - bbox.left, bbox.bottom - bbox.top),
                fillColor: Color(0.6, 0.6, 0.9, 1.0),
                borderColor: Color(0.2, 0.2, 0.6, 1.0),
                borderThickness: 0.5,
            });
        }
    }
    else if shape is TextblockShape {
        let bbox = shape.getBBox();
        r.drawRect({
            pos: Vec2(bbox.left, bbox.top),
            size: Vec2(bbox.right - bbox.left, bbox.bottom - bbox.top),
            fillColor: Color(0.95, 0.95, 0.8, 1.0),
            borderColor: Color(0.6, 0.6, 0.3, 1.0),
            borderThickness: 0.5,
        });
    }
}

fn pageHasShape(page: Page, shape: Shape): bool {
    for s in page.shapes {
        if sameShape(s, shape) {
            return true;
        }
    }
    return false;
}

ref struct PageTileState {
    // The pyramid level this page is tiled at -- see render() for when it
    // changes.
    level: int = 0;
    hasLevel: bool = false;
    // Every tile this page holds: the squares of `level` in view, and tiles
    // of other levels still shown under them until those squares all have a
    // picture.
    tiles: []mut Tile = [];
}

ref struct DocumentRenderer {
    gfx: mut renderer.gfx.Context;
    pool: mut TilePool;
    pages: []mut PageTileState = [];
    viewport: Viewport = {};
    imageCache: mut ImageTextureCache = {};
    paper: mut PaperTexture = {};

    // The document the tiles were drawn from -- render()'s documentId. A tile
    // is cached by page, level and position alone, so this is the only thing
    // that tells it apart from the same tile of another document.
    renderedDocument: int = -1;

    // Zoom-settle tracking (see render() below).
    lastZoomPxPerMm: real = 0.0;
    zoomStableFrames: int = 0;

    // The canvas size (px) at the last render -- where "the middle of the
    // view" is, for anything placed there.
    lastPanelSize: Vec2 = {};
    // Physical pixels per canvas px at the last render -- what "pixel for
    // pixel" means for an image placed in the view.
    lastDpiScale: real = 1.0;

    // Set when a document without a saved viewport is opened: the first
    // render, which is the first moment the canvas size is known, fits the
    // page to it.
    needsFit: bool = false;

    // Draws a tile's content. One for all tiles, re-armed per tile, so its
    // buffers keep their capacity.
    tileRenderer?: mut renderer.gfx.Renderer;

    // The tiles render() still has to draw, nearest the middle of the view
    // first, and their distances from it -- rebuilt every render().
    _work: []mut Tile = [];
    _workDistance: []real = [];
    // How many of them the last render() did not get to.
    pendingTiles: int = 0;
    // When the last tile was drawn, or -1 once releaseIdle has cleaned up
    // after it.
    lastTileDraw: real = -1.0;

    // Shapes changed on a page (added, moved, recoloured) whose tiles do not
    // show them yet: drawn over the tiles until they do, so an edit shows at
    // once even when its tiles wait for a later frame. See markShapeDirty.
    liveShapes: []Shape = [];
    livePages: []int = [];

    fn constructor(gfx: mut renderer.gfx.Context) {
        let result = DocumentRenderer {
            gfx: gfx,
            pool: TilePool(gfx),
        };
        // Under way while the first document loads.
        result.paper.prepare(gfx);
        return result;
    }

    fn ensurePagesArraySized(doc: DocumentFile) {
        while this.pages.length < doc.data.pages.length {
            this.pages.push(PageTileState {});
        }
    }

    // Takes over a newly opened document's saved viewport, or fits its first
    // page if it has none. (Its tiles are dropped by render(), which sees the
    // new documentId.)
    //
    // The file keeps the web app's meaning: the offset places the page
    // `currentPageIndex` (the web app showed one page at a time), not the
    // top of the stack -- see savedViewport for the way back.
    fn adoptViewport(doc: DocumentFile) {
        if let saved = doc.data.viewport {
            this.viewport = saved;
            this.viewport.offsetY = saved.offsetY - pageOriginY(doc, currentPageOf(doc)) * saved.zoomPxPerMm;
            this.needsFit = saved.zoomPxPerMm <= 0.0;
        } else {
            this.viewport = {};
            this.needsFit = true;
        }
        this.zoomStableFrames = 0;
    }

    // The viewport as the file stores it, with `page` as the current page --
    // the reverse of adoptViewport.
    fn savedViewport(doc: DocumentFile, page: int): Viewport {
        let result = this.viewport;
        result.offsetY = this.viewport.offsetY + pageOriginY(doc, page) * this.viewport.zoomPxPerMm;
        return result;
    }

    // The first page, as wide as the canvas allows (never past the web app's
    // 5 px/mm default), centered, just below the top edge.
    fn fitToWidth(doc: DocumentFile, panelW: real) {
        let zoom = min(5.0, (panelW - 40.0) / doc.data.pageWidthMm);
        if zoom < 0.05 {
            zoom = 0.05;
        }
        this.viewport.zoomPxPerMm = zoom;
        this.viewport.offsetX = (panelW - doc.data.pageWidthMm * zoom) / 2.0;
        this.viewport.offsetY = 20.0;
    }

    // Canvas px <-> document mm. The document's space is the pages stacked
    // top to bottom -- see pageOriginY for where each one starts.
    fn screenToWorld(p: Vec2): Vec2 {
        return Vec2((p.x - this.viewport.offsetX) / this.viewport.zoomPxPerMm, (p.y - this.viewport.offsetY) / this.viewport.zoomPxPerMm);
    }

    fn worldToScreen(p: Vec2): Vec2 {
        return Vec2(p.x * this.viewport.zoomPxPerMm + this.viewport.offsetX, p.y * this.viewport.zoomPxPerMm + this.viewport.offsetY);
    }

    fn releasePageTiles(page: mut PageTileState) {
        for tile in page.tiles {
            this.pool.release(tile);
        }
        page.tiles.clear();
    }

    // Releases every tile on every page and forgets each page's level,
    // forcing a full re-tile on the next render() call. render() calls it
    // when the document changes; also for manually invalidating
    // stale-looking content during development.
    fn clearAll() {
        for page in this.pages {
            this.releasePageTiles(page);
            page.hasLevel = false;
        }
    }

    // Pure pan: only ever touches the offset, never forces a retile. This
    // is also what streams new edge tiles in continuously while panning --
    // even mid-zoom-gesture, before the zoom itself has settled -- since
    // render() recomputes each page's visible tx/ty range from the live
    // offset every frame regardless of level changes.
    fn pan(dxScreenPx: real, dyScreenPx: real) {
        this.viewport.offsetX += dxScreenPx;
        this.viewport.offsetY += dyScreenPx;
    }

    // Zooms around a fixed screen point (e.g. panel center) by `factor`,
    // adjusting the offset so the world point currently under that screen
    // point stays under it after the zoom changes.
    fn zoomBy(factor: real, pivotScreenX: real, pivotScreenY: real) {
        let oldZoom = this.viewport.zoomPxPerMm;
        let newZoom = oldZoom * factor;
        if newZoom < 0.05 {
            newZoom = 0.05;
        }
        if newZoom > 200.0 {
            newZoom = 200.0;
        }

        let worldX = (pivotScreenX - this.viewport.offsetX) / oldZoom;
        let worldY = (pivotScreenY - this.viewport.offsetY) / oldZoom;

        this.viewport.zoomPxPerMm = newZoom;
        this.viewport.offsetX = pivotScreenX - worldX * newZoom;
        this.viewport.offsetY = pivotScreenY - worldY * newZoom;
    }

    // Whether render() has work left that only more calls to it finish: a
    // zoom that has not held still for zoomSettleFrames renders yet (its
    // retile is still to come), tiles the frame budget did not reach,
    // edits drawn live until their tiles show them, or images still
    // loading. A caller that only renders on change has to keep calling
    // until this is false.
    fn hasPendingWork(): bool {
        return this.zoomStableFrames < zoomSettleFrames || this.pendingTiles > 0 || this.liveShapes.length > 0 || this.imageCache.isLoading();
    }

    // Has the tiles a shape's bbox overlaps drawn again -- not the whole
    // page. Call after mutating a shape's geometry (points/position/size) and
    // clearing its cached bbox/tesselation, before the next render(), and
    // for a shape added to or removed from the page. Until its tiles are
    // drawn, a shape that is on the page is drawn live over them.
    fn markShapeDirty(pageIndex: int, shape: Shape) {
        if pageIndex < 0 || pageIndex >= this.pages.length {
            return;
        }
        let bbox = shape.getBBox();
        let page = this.pages[pageIndex];
        for tile in page.tiles {
            if bbox.overlaps(tile.bbox()) {
                tile.dirty = true;
            }
        }
        if isShapeHidden(shape) {
            return;
        }
        for live in this.liveShapes {
            if sameShape(live, shape) {
                return;
            }
        }
        this.liveShapes.push(shape);
        this.livePages.push(pageIndex);
    }

    fn findTile(page: PageTileState, level: int, tx: int, ty: int): bool {
        for tile in page.tiles {
            if tile.isAt(level, tx, ty) {
                return true;
            }
        }
        return false;
    }

    // Every shape a tile shows is tessellated at the tile's level, and every
    // image on it is on its way to the GPU -- or false, when the deadline
    // came first. That work is kept, and the next call goes on from there.
    // Images are not waited for: see Tile.waitingForImages.
    fn prepareTile(tile: Tile, page: Page, deadline: real): bool {
        let box = tile.bbox();
        for shape in page.shapes {
            if isShapeHidden(shape) {
                continue;
            }
            if shape is LineShape {
                if !shape.hasTesselation(tile.level) && shape.getBBox().overlaps(box) {
                    if time.now() >= deadline {
                        return false;
                    }
                    shape.ensureTesselated(tile.level);
                }
            }
            else if shape is ImageShape {
                if shape.getBBox().overlaps(box) {
                    this.imageCache.request(shape);
                }
            }
        }
        return true;
    }

    // A page's paper and ruled lines, the page's own mm placed by `transform`
    // (identity inside a tile, the page's place on the panel otherwise),
    // where a mm is `pxPerMm` physical pixels.
    fn drawPaper(r: mut renderer.gfx.Renderer, doc: DocumentFile, pxPerMm: real, transform: mat4.Mat4f) {
        let w = doc.data.pageWidthMm;
        let h = doc.data.pageHeightMm;
        if let texture = this.paper.texture {
            // Stretched to cover the page, centred, with what sticks out
            // cropped off -- the web app's drawImageCovering.
            let imageAspect = texture.width as real / texture.height as real;
            let pageAspect = w / h;
            let uvMin = Vec2(0.0, 0.0);
            let uvMax = Vec2(1.0, 1.0);
            if imageAspect > pageAspect {
                let crop = (1.0 - pageAspect / imageAspect) / 2.0;
                uvMin.x = crop;
                uvMax.x = 1.0 - crop;
            } else {
                let crop = (1.0 - imageAspect / pageAspect) / 2.0;
                uvMin.y = crop;
                uvMax.y = 1.0 - crop;
            }
            r.drawTexture({
                texture: texture,
                pos: Vec2(0.0, 0.0),
                size: Vec2(w, h),
                uvMin: uvMin,
                uvMax: uvMax,
                zIndex: paperZIndex,
                transform: transform,
            });
        } else {
            r.drawRect({
                pos: Vec2(0.0, 0.0),
                size: Vec2(w, h),
                fillColor: Color(1, 1, 1, 1),
                zIndex: paperZIndex,
                transform: transform,
            });
        }

        // A line thinner than a pixel covers a varying number of MSAA
        // samples depending on where it falls, so at a low zoom the lines
        // would come out unevenly strong. It is drawn a pixel thick instead,
        // as much fainter as it is thinner.
        let color = Color.fromHexOrDefault(doc.data.gridColor, Color(0.32, 0.32, 0.32, 0.31));
        let thickness = gridLineThicknessMm;
        let minThickness = 1.0 / pxPerMm;
        if thickness < minThickness {
            color.a = color.a * thickness / minThickness;
            thickness = minThickness;
        }
        // Centred on its y, like a canvas stroke: the page's edge cuts the
        // top one in half.
        for (let y = 0.0; y < h; y += gridLineDistanceMm) {
            let top = max(0.0, y - thickness / 2.0);
            let bottom = min(h, y + thickness / 2.0);
            r.addTriangle(Vec2(0.0, top), Vec2(w, top), Vec2(w, bottom), color, color, color, gridLineZIndex, transform);
            r.addTriangle(Vec2(0.0, top), Vec2(w, bottom), Vec2(0.0, bottom), color, color, color, gridLineZIndex, transform);
        }
    }

    // (Re)renders one tile's full content at its native resolution: the
    // paper, then every shape on the page whose bbox overlaps the tile's
    // page-local rect. A tile's rect is grid-aligned and routinely extends
    // past the page edge (pages are rarely exact multiples of the tile
    // size); the paper stops at the edge, and the rest stays transparent.
    // Always a full redraw of the tile (not incremental per-shape), which is
    // what makes markShapeDirty()'s "just mark it dirty" enough.
    fn drawTile(tile: mut Tile, doc: DocumentFile, frame: mut renderer.gfx.Frame) {
        if !this.tileRenderer {
            this.tileRenderer = renderer.gfx.Renderer(frame, tile.canvas);
        }
        let cached = this.tileRenderer;
        assert(cached);
        let r = cached;
        r.reset(frame, tile.canvas);

        tile.canvas.setViewProj(mat4.ortho(
            tile.localMinX, tile.localMinX + tile.localSize,
            tile.localMinY + tile.localSize, tile.localMinY,
            -100000.0, 100000.0
        ));

        this.drawPaper(r, doc, tileSizePx as real / tile.localSize, mat4.identity());

        let page = doc.data.pages[tile.pageIndex];
        let tileBBox = tile.bbox();
        tile.waitingForImages = false;
        for shape in page.shapes {
            // A hidden shape is being drawn by the editor itself -- see
            // LineShape.hidden.
            if isShapeHidden(shape) {
                continue;
            }
            if shape.getBBox().overlaps(tileBBox) {
                if shape is ImageShape {
                    if !this.imageCache.isReady(shape) {
                        tile.waitingForImages = true;
                    }
                }
                drawShapeInto(r, shape, tile.level, this.imageCache);
            }
        }

        r.commit(true);
        tile.dirty = false;
        tile.hasContent = true;
        this.lastTileDraw = time.now();
    }

    // Frees what drawing tiles left behind, once none has been drawn for
    // drawCacheIdleSeconds. Called every frame (EditorControls.frame).
    //
    // A tile's picture is in its texture; everything that went into drawing
    // it is only needed to draw it again. That is a lot: the renderer's vertex
    // array and each tile's vertex buffer hold three vertices per triangle of
    // every stroke on the tile (16 MB for a zoomed-out page), and every stroke
    // keeps its tesselation at up to two zoom levels. Kept forever, zooming
    // and scrolling through a document doubled the memory it took to open it.
    // So after a pause only what the current view draws from stays: strokes on
    // pages in view keep the tesselation of the level they are shown at,
    // strokes on other pages keep nothing but their bbox. The first redraw
    // afterwards computes what it needs again, within the tile budget.
    fn releaseIdle(doc: DocumentFile, now: real) {
        if this.lastTileDraw < 0.0 || now - this.lastTileDraw < drawCacheIdleSeconds {
            return;
        }
        this.lastTileDraw = -1.0;

        this.tileRenderer = none;
        for page in this.pages {
            for tile in page.tiles {
                tile.canvas.releaseMeshVertexBuffer();
            }
        }
        for tile in this.pool.free {
            tile.canvas.releaseMeshVertexBuffer();
        }

        for (let i = 0; i < doc.data.pages.length; i++) {
            let inView = i < this.pages.length && this.pages[i].hasLevel && this.pages[i].tiles.length > 0;
            for shape in doc.data.pages[i].shapes {
                if shape is LineShape {
                    if inView {
                        shape.keepOnlyTesselation(this.pages[i].level);
                    } else {
                        shape.dropDrawCaches();
                    }
                }
            }
        }

        // Dropped is not freed: nothing allocates while the editor is idle,
        // so the collector would not run until the next burst of work.
        sys.releaseUnusedMemory();
    }

    // Whether every image a tile was drawn without has arrived since -- it
    // is then drawn again, with them.
    fn imagesArrived(tile: Tile, page: Page): bool {
        let box = tile.bbox();
        for shape in page.shapes {
            if shape is ImageShape {
                if !isShapeHidden(shape) && shape.getBBox().overlaps(box) {
                    this.imageCache.request(shape);
                    if !this.imageCache.isReady(shape) {
                        return false;
                    }
                }
            }
        }
        return true;
    }

    // Orders `work` nearest the middle of the view first -- what the budget
    // should be spent on when it cannot cover everything.
    fn sortWorkByDistance(doc: DocumentFile, centerX: real, centerY: real) {
        let work = this._work;
        let distance = this._workDistance;
        distance.clear();
        let zoom = this.viewport.zoomPxPerMm;
        for tile in work {
            let half = tile.localSize / 2.0;
            let x = (tile.localMinX + half) * zoom + this.viewport.offsetX - centerX;
            let y = (pageOriginY(doc, tile.pageIndex) + tile.localMinY + half) * zoom + this.viewport.offsetY - centerY;
            distance.push(x * x + y * y);
        }
        for (let i = 1; i < work.length; i++) {
            let tile = work[i];
            let d = distance[i];
            let j = i - 1;
            while j >= 0 && distance[j] > d {
                work[j + 1] = work[j];
                distance[j + 1] = distance[j];
                j -= 1;
            }
            work[j + 1] = tile;
            distance[j + 1] = d;
        }
    }

    // Keeps the tiles of other levels -- the ones shown while the current
    // level's are drawn -- to maxFallbackTiles, dropping those of the level
    // furthest from their page's own first.
    fn limitFallbackTiles() {
        let count = 0;
        for page in this.pages {
            for tile in page.tiles {
                if tile.level != page.level {
                    count += 1;
                }
            }
        }
        while count > maxFallbackTiles {
            let worstPage = -1;
            let worstIndex = -1;
            let worstDistance = 0;
            for (let p = 0; p < this.pages.length; p++) {
                let page = this.pages[p];
                for (let k = 0; k < page.tiles.length; k++) {
                    let d = levelDistance(page.tiles[k].level, page.level);
                    if d > worstDistance {
                        worstDistance = d;
                        worstPage = p;
                        worstIndex = k;
                    }
                }
            }
            if worstPage < 0 {
                return;
            }
            let page = this.pages[worstPage];
            this.pool.release(page.tiles[worstIndex]);
            page.tiles.remove(worstIndex);
            count -= 1;
        }
    }

    // Draws the shapes in liveShapes whose tiles do not show them yet, and
    // forgets the rest: those shown, removed from their page, or hidden.
    fn drawLiveShapes(r: mut renderer.gfx.Renderer, doc: DocumentFile) {
        for (let k = this.liveShapes.length - 1; k >= 0; k--) {
            let shape = this.liveShapes[k];
            let pageIndex = this.livePages[k];
            let keep = pageIndex < doc.data.pages.length && pageIndex < this.pages.length && !isShapeHidden(shape);
            if keep {
                keep = pageHasShape(doc.data.pages[pageIndex], shape) && !this.tilesShow(this.pages[pageIndex], shape);
            }
            if !keep {
                this.liveShapes.remove(k);
                this.livePages.remove(k);
            }
        }
        for (let k = 0; k < this.liveShapes.length; k++) {
            this.drawShapeLive(r, doc, this.livePages[k], this.liveShapes[k], mat4.identity());
        }
    }

    // Whether every tile of the page's level that the shape overlaps has
    // been drawn since the shape last changed.
    fn tilesShow(page: PageTileState, shape: Shape): bool {
        let box = shape.getBBox();
        for tile in page.tiles {
            if tile.level == page.level && tile.dirty && tile.bbox().overlaps(box) {
                return false;
            }
        }
        return true;
    }

    // Draws every page of `doc` into `r`'s panel: culls offscreen pages
    // (releasing their tiles back to the pool), syncs each visible page's
    // tile set against the live viewport (streaming edge tiles in/out every
    // frame), draws as many outdated tiles as tileWorkBudgetSeconds allows,
    // then composites the page background, the tiles of other levels still
    // standing in for missing ones, and every tile with a picture at the
    // *live* on-screen size -- which is what makes tiles visibly
    // stretch/blur mid-zoom instead of updating.
    //
    // `documentId` changes whenever `doc` is a different document, or the
    // same one loaded again. The tiles are then all from the old one, so
    // they are dropped: tile validity alone would keep drawing them.
    fn render(r: mut renderer.gfx.Renderer, doc: DocumentFile, documentId: int) {
        if documentId != this.renderedDocument {
            this.clearAll();
            this.imageCache.releaseAll();
            this.liveShapes.clear();
            this.livePages.clear();
            this.renderedDocument = documentId;
        }
        // Frees tiles released in earlier frames -- before this frame draws
        // any, see TilePool.trim.
        this.pool.trim(maxFreeTiles);

        let panelW = r.canvas.size.logicalSize.x as real;
        let panelH = r.canvas.size.logicalSize.y as real;
        this.lastPanelSize = Vec2(panelW, panelH);
        this.lastDpiScale = r.canvas.size.dpiScale as real;
        if this.needsFit && panelW > 0.0 {
            this.fitToWidth(doc, panelW);
            this.needsFit = false;
        }
        if this.viewport.zoomPxPerMm <= 0.0 {
            return;
        }

        this.ensurePagesArraySized(doc);

        let zoom = this.viewport.zoomPxPerMm;

        let visMinX = (0.0 - this.viewport.offsetX) / zoom;
        let visMaxX = (panelW - this.viewport.offsetX) / zoom;
        let visMinY = (0.0 - this.viewport.offsetY) / zoom;
        let visMaxY = (panelH - this.viewport.offsetY) / zoom;
        let visibleBBox = BBox { left: visMinX, right: visMaxX, top: visMinY, bottom: visMaxY };

        let zoomDelta = zoom - this.lastZoomPxPerMm;
        if zoomDelta < 0.0 {
            zoomDelta = -zoomDelta;
        }
        if zoomDelta > zoomEpsilon {
            this.zoomStableFrames = 0;
        } else if this.zoomStableFrames < zoomSettleFrames {
            this.zoomStableFrames += 1;
        }
        this.lastZoomPxPerMm = zoom;
        let zoomSettled = this.zoomStableFrames >= zoomSettleFrames;

        // Tile native resolution must target *physical* (framebuffer)
        // pixel density, not logical -- `zoom` and the on-screen sizes used
        // to composite tiles below are correctly logical (matching every
        // other draw call in this UI), but a tile only has tileSizePx
        // physical texels of actual detail, and on a HiDPI panel
        // (dpiScale > 1) a tile shown at, say, 400 logical px covers
        // 400*dpiScale physical px -- picking the native level from the
        // logical zoom alone systematically under-resolves by a factor of
        // dpiScale, magnifying every tile's 512 texels well past 1:1 and
        // showing up as blur uniformly, independent of how "zoomed in" the
        // page itself looks.
        let dpiScale = r.canvas.size.dpiScale as real;
        let targetLevel = tilemath.zoomLevelFor(zoom * dpiScale);

        // The frame's share of image uploads and tile drawing. Images first:
        // a tile whose images arrive now is drawn again in this same frame.
        let deadline = time.now() + tileWorkBudgetSeconds;
        this.imageCache.advance(this.gfx, deadline);

        // Which tiles each page needs, and which of those need drawing.
        let work = this._work;
        work.clear();
        for (let i = 0; i < doc.data.pages.length; i++) {
            let page = this.pages[i];
            let originY = pageOriginY(doc, i);
            let pageBBox = BBox {
                left: 0.0,
                right: doc.data.pageWidthMm,
                top: originY,
                bottom: originY + doc.data.pageHeightMm,
            };
            if !pageBBox.overlaps(visibleBBox) {
                this.releasePageTiles(page);
                page.hasLevel = false;
                continue;
            }

            // The level the page is tiled at. Zooming in, the tiles of the
            // old level get fewer and bigger on screen: they are stretched
            // until the zoom settles, instead of redrawn at every step of
            // the gesture. Zooming out, they get smaller and more numerous
            // without limit, so the new level is taken at once -- the old
            // tiles stay under it until it is drawn.
            if !page.hasLevel || targetLevel < page.level || (zoomSettled && targetLevel != page.level) {
                page.level = targetLevel;
                page.hasLevel = true;
            }

            // The page's visible part, page-local.
            let visibleLocal = BBox {
                left: max(visMinX, pageBBox.left),
                right: min(visMaxX, pageBBox.right),
                top: max(visMinY, pageBBox.top) - originY,
                bottom: min(visMaxY, pageBBox.bottom) - originY,
            };

            // Out of view, or of another level and with nothing to show.
            for (let k = page.tiles.length - 1; k >= 0; k--) {
                let tile = page.tiles[k];
                let keep = tile.bbox().overlaps(visibleLocal);
                if tile.level != page.level && !tile.hasContent {
                    keep = false;
                }
                if !keep {
                    this.pool.release(tile);
                    page.tiles.remove(k);
                }
            }

            let tileWorldSizeMm = tilemath.tileWorldSize(page.level);
            let txMin = tilemath.floorToInt(visibleLocal.left / tileWorldSizeMm);
            let txMax = tilemath.floorToInt(visibleLocal.right / tileWorldSizeMm);
            let tyMin = tilemath.floorToInt(visibleLocal.top / tileWorldSizeMm);
            let tyMax = tilemath.floorToInt(visibleLocal.bottom / tileWorldSizeMm);
            for (let ty = tyMin; ty <= tyMax; ty++) {
                for (let tx = txMin; tx <= txMax; tx++) {
                    if !this.findTile(page, page.level, tx, ty) {
                        page.tiles.push(this.pool.acquire(i, page.level, tx, ty));
                    }
                }
            }

            for tile in page.tiles {
                if tile.level != page.level {
                    continue;
                }
                if !tile.dirty && tile.waitingForImages && this.imagesArrived(tile, doc.data.pages[i]) {
                    tile.dirty = true;
                }
                if tile.dirty {
                    work.push(tile);
                }
            }
        }
        this.limitFallbackTiles();

        // Draw what the budget allows, nearest the middle of the view first.
        // Every tile shows the paper, so none is drawn before it is on the
        // GPU.
        this.sortWorkByDistance(doc, panelW / 2.0, panelH / 2.0);
        let drawn = 0;
        this.paper.prepare(this.gfx);
        for tile in work {
            if time.now() >= deadline || !this.paper.isReady() {
                break;
            }
            if !this.prepareTile(tile, doc.data.pages[tile.pageIndex], deadline) {
                break;
            }
            this.drawTile(tile, doc, r.frame);
            drawn += 1;
        }
        this.pendingTiles = work.length - drawn;

        for (let i = 0; i < doc.data.pages.length; i++) {
            let page = this.pages[i];
            if !page.hasLevel {
                continue;
            }

            // Once every square of the page's level has a picture, the other
            // levels' tiles are hidden under them anyway.
            let covered = true;
            let minLevel = page.level;
            let maxLevel = page.level;
            for tile in page.tiles {
                if tile.level == page.level && !tile.hasContent {
                    covered = false;
                }
                minLevel = min(minLevel, tile.level);
                maxLevel = max(maxLevel, tile.level);
            }
            if covered {
                for (let k = page.tiles.length - 1; k >= 0; k--) {
                    if page.tiles[k].level != page.level {
                        this.pool.release(page.tiles[k]);
                        page.tiles.remove(k);
                    }
                }
            }

            // The page as its tiles show it, less the content: what a square
            // without a picture yet shows.
            this.drawPaper(r, doc, zoom * dpiScale, this.pageToScreenTransform(doc, i));

            let originY = pageOriginY(doc, i);
            // Other levels coarse to fine, then the page's own level on top.
            for (let level = minLevel; level <= maxLevel + 1; level++) {
                let drawLevel = level;
                if level == page.level {
                    continue;
                }
                if level == maxLevel + 1 {
                    drawLevel = page.level;
                }
                for tile in page.tiles {
                    if tile.level != drawLevel || !tile.hasContent {
                        continue;
                    }
                    let tileScreenSize = tile.localSize * zoom;
                    r.drawTexture({
                        texture: tile.canvas.asTexture(),
                        pos: Vec2(
                            tile.localMinX * zoom + this.viewport.offsetX,
                            (originY + tile.localMinY) * zoom + this.viewport.offsetY
                        ),
                        size: Vec2(tileScreenSize, tileScreenSize),
                    });
                }
            }
        }

        this.drawLiveShapes(r, doc);
    }

    // Page mm -> canvas px for one page: what a shape's own coordinates go
    // through to land where its page is on screen.
    fn pageToScreenTransform(doc: DocumentFile, pageIndex: int): mat4.Mat4f {
        let zoom = this.viewport.zoomPxPerMm;
        return mat4.translation(Vec3(
            this.viewport.offsetX,
            pageOriginY(doc, pageIndex) * zoom + this.viewport.offsetY,
            0.0
        )).mul(mat4.scaling(Vec3(zoom, zoom, 1.0)));
    }

    // Draws a shape straight onto the panel canvas, bypassing the tiles --
    // so a live pen stroke never waits on a tile (re)render to become
    // visible, and a shape being moved or resized follows the pen every
    // frame. `pageTransform` places it within its page (identity for where
    // it is; a move or resize in progress otherwise), and `color`, when
    // given, replaces a stroke's own (the grey of an erased one).
    fn drawShapeLive(r: mut renderer.gfx.Renderer, doc: DocumentFile, pageIndex: int, shape: Shape, pageTransform: mat4.Mat4f, color: Color | none = none) {
        let transform = this.pageToScreenTransform(doc, pageIndex).mul(pageTransform);
        if shape is LineShape {
            // Same physical-pixel-density level a tile at this live zoom would
            // commit to (see render()'s targetLevel) -- this is also what lets
            // the live overlay and a freshly-tiled version of the same shape
            // share a cache entry instead of tesselating it twice.
            let dpiScale = r.canvas.size.dpiScale as real;
            let level = tilemath.zoomLevelFor(this.viewport.zoomPxPerMm * dpiScale);
            let tess = shape.ensureTesselated(level);
            if tess.indices.length == 0 {
                return;
            }
            let fill = color ?? Color.fromHexOrDefault(shape.penColor, Color(0.0, 0.0, 0.0, 1.0));
            r.addTriangles(tess.vertices, tess.indices, fill, 0, transform);
        }
        else if shape is ImageShape {
            // Nothing until it has loaded (hasPendingWork keeps the frames
            // coming meanwhile).
            this.imageCache.request(shape);
            let bbox = shape.getBBox();
            if let texture = this.imageCache.get(shape) {
                r.drawTexture({
                    texture: texture,
                    pos: Vec2(bbox.left, bbox.top),
                    size: Vec2(bbox.right - bbox.left, bbox.bottom - bbox.top),
                    transform: transform,
                });
            }
        }
        else if shape is TextblockShape {
            let bbox = shape.getBBox();
            r.drawRect({
                pos: Vec2(bbox.left, bbox.top),
                size: Vec2(bbox.right - bbox.left, bbox.bottom - bbox.top),
                fillColor: Color(0.95, 0.95, 0.8, 1.0),
                borderColor: Color(0.6, 0.6, 0.3, 1.0),
                borderThickness: 0.5,
                transform: transform,
            });
        }
    }
}
