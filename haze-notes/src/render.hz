import renderer
import base64
import image

// Vertical gap between stacked pages, in mm (PDF-viewer-style layout: pages
// stack top to bottom at x=0, each pageHeightMm + pageGapMm below the last).
const comptime pageGapMm = 10.0;

// A zoom gesture is considered "finished" once the live zoom value has held
// steady (within zoomEpsilon) for this many consecutive render() calls --
// only then does a page actually retile at the new native resolution.
const comptime zoomSettleFrames = 8;
const comptime zoomEpsilon = 0.0001;

fn pageOriginY(doc: DocumentFile, pageIndex: int): real {
    return pageIndex as real * (doc.data.pageHeightMm + pageGapMm);
}

// The file's currentPageIndex, kept to a page that exists.
fn currentPageOf(doc: DocumentFile): int {
    let n = doc.data.pages.length;
    let i = doc.data.currentPageIndex;
    if i >= n { i = n - 1; }
    if i < 0 { i = 0; }
    return i;
}

// ImageShape.base64ImageData is stored as a full data URL
// ("data:image/png;base64,<payload>", per how browsers/paste handlers
// typically produce it), not a raw base64 payload -- base64.decode only
// accepts the latter, so the "data:...;base64," header has to be stripped
// first. A data URL's header can never itself contain a comma (it's
// exactly "data:[<mediatype>][;base64]"), so the first comma is always the
// header/payload boundary. Strings with no comma at all (already a raw
// base64 payload) pass through unchanged.
fn stripDataUrlPrefix(data: str): str {
    for (let i = 0; i < data.length; i++) {
        if data[i] == b"," {
            return data.slice(i + 1, i + 1 + data.length);
        }
    }
    return data;
}

// Decoded-image GPU textures, keyed by the shape's raw base64ImageData
// string. Deliberately *not* a field on ImageShape itself: that struct
// participates in json.parse<DocumentFile>/json.stringify for the whole
// document, and a field whose type reaches into opaque wgpu FFI handles
// (wgpu.Texture/TextureView/BindGroup are forward-declared-only C structs)
// breaks that generic codegen -- sizeof() on an intentionally-incomplete
// struct -- even when marked [[json.ignore]]. Living on DocumentRenderer
// instead (alongside TilePool, which is the same kind of GPU-resource-cache
// paired with the serializable document) sidesteps that entirely, and keying
// by content rather than shape identity means two shapes pasted from the
// same image share one upload for free.
ref struct ImageTextureCache {
    textures: LinearMap<str, renderer.gfx.Texture> = {};
    // Tracks base64 strings that failed to decode, so a corrupt/invalid
    // image is only ever attempted once rather than every frame.
    failed: LinearMap<str, bool> = {};

    fn getOrCreate(r: mut renderer.gfx.Renderer, shape: ImageShape): renderer.gfx.Texture | none {
        let key = shape.base64ImageData;

        let existing = this.textures.get(key);
        if existing {
            return existing;
        }
        if this.failed.has(key) {
            return none;
        }

        let decoded = base64.decode(stripDataUrlPrefix(key));
        if decoded {
            // stb_image (via the `image` package) returns straight alpha;
            // createRGBATexture's premultiply=true converts it to the
            // premultiplied form this renderer's textured-quad shader
            // assumes.
            let img = image.Image(decoded);
            let texture = r.canvas.gfx.createRGBATexture(img.pixels, img.width, img.height, true);
            this.textures.set(key, texture);
            return texture;
        }

        fmt.println("Image shape: failed to decode base64 image data");
        this.failed.set(key, true);
        return none;
    }
}

// Draws one shape's content into whatever tile canvas `r` is currently
// bound to (already in tile-local mm-space via Canvas.setViewProj, so no
// CPU-side transform is needed here -- raw mm vertices go straight in).
// `level` is the tile pyramid level this content is being rendered at --
// see LineShape.ensureTesselated for why tesselation is cached per
// level rather than once per shape.
fn drawShapeInto(r: mut renderer.gfx.Renderer, shape: Shape, level: int, imageCache: mut ImageTextureCache) {
    if shape is LineShape {
        let tess = shape.ensureTesselated(level);
        if tess.indices.length > 0 {
            r.addTriangles(tess.vertices, tess.indices, shape.penColor, 0);
        }
    }
    else if shape is ImageShape {
        let bbox = shape.getBBox();
        let texture = imageCache.getOrCreate(r, shape);
        if texture {
            r.drawTexture({
                texture: texture,
                pos: Vec2(bbox.left, bbox.top),
                size: Vec2(bbox.right - bbox.left, bbox.bottom - bbox.top),
            });
        } else {
            r.drawRect({
                pos: Vec2(bbox.left, bbox.top),
                size: Vec2(bbox.right - bbox.left, bbox.bottom - bbox.top),
                fillColor: Color(0.6, 0.6, 0.9, 1.0),
                borderColor: Color(0.2, 0.2, 0.6, 1.0),
                borderThickness: 0.5,
            });
        }
    }
    else if shape is TextblockShape {
        let bbox = shape.getBBox();
        r.drawRect({
            pos: Vec2(bbox.left, bbox.top),
            size: Vec2(bbox.right - bbox.left, bbox.bottom - bbox.top),
            fillColor: Color(0.95, 0.95, 0.8, 1.0),
            borderColor: Color(0.6, 0.6, 0.3, 1.0),
            borderThickness: 0.5,
        });
    }
}

// (Re)renders one tile's full content at its native resolution: white page
// background (clipped to the actual page rect -- a tile's page-local rect
// is grid-aligned and routinely extends past the page edge, since pages
// are rarely exact multiples of the tile size), then every shape on the
// page whose bbox overlaps the tile's page-local rect. Always a full redraw
// of the tile (not incremental per-shape), which is what makes
// markShapeDirty()'s "just mark it invalid" enough.
fn renderTileContent(tile: mut Tile, page: Page, pageWidthMm: real, pageHeightMm: real, frame: mut renderer.gfx.Frame, imageCache: mut ImageTextureCache) {
    let r = renderer.gfx.Renderer(frame, tile.canvas);

    tile.canvas.setViewProj(mat4.ortho(
        tile.localMinX, tile.localMinX + tile.localSize,
        tile.localMinY + tile.localSize, tile.localMinY,
        -100000.0, 100000.0
    ));

    let clipMinX = tile.localMinX;
    if clipMinX < 0.0 { clipMinX = 0.0; }
    let clipMinY = tile.localMinY;
    if clipMinY < 0.0 { clipMinY = 0.0; }
    let clipMaxX = tile.localMinX + tile.localSize;
    if clipMaxX > pageWidthMm { clipMaxX = pageWidthMm; }
    let clipMaxY = tile.localMinY + tile.localSize;
    if clipMaxY > pageHeightMm { clipMaxY = pageHeightMm; }
    if clipMaxX > clipMinX && clipMaxY > clipMinY {
        r.drawRect({
            pos: Vec2(clipMinX, clipMinY),
            size: Vec2(clipMaxX - clipMinX, clipMaxY - clipMinY),
            fillColor: Color(1, 1, 1, 1),
        });
    }

    let tileBBox = BBox {
        left: tile.localMinX,
        right: tile.localMinX + tile.localSize,
        top: tile.localMinY,
        bottom: tile.localMinY + tile.localSize,
    };

    for shape in page.shapes {
        // A hidden shape is being drawn by the editor itself -- see
        // LineShape.hidden.
        if isShapeHidden(shape) {
            continue;
        }
        if shape.getBBox().overlaps(tileBBox) {
            drawShapeInto(r, shape, tile.key.level, imageCache);
        }
    }

    r.commit(true);
}

ref struct PageTileState {
    hasCommittedLevel: bool = false;
    committedLevel: int = 0;
    // Keyed by "{level}:{tx}:{ty}". LinearMap.K is constrained to
    // primitives (see containers.hz), so the composite tile position is
    // string-encoded rather than used as a ref struct key directly. .keys/
    // .values are iterated directly (public fields) wherever every entry
    // needs visiting (the stale-tile sweep, markShapeDirty).
    slots: LinearMap<str, mut Tile> = {};
}

ref struct DocumentRenderer {
    gfx: mut renderer.gfx.Context;
    pool: mut TilePool;
    pages: []mut PageTileState = [];
    viewport: Viewport = {};
    imageCache: mut ImageTextureCache = {};

    // The document the tiles were drawn from -- render()'s documentId. A tile
    // is cached by page, level and position alone, so this is the only thing
    // that tells it apart from the same tile of another document.
    renderedDocument: int = -1;

    // Zoom-settle tracking (see render() below).
    lastZoomPxPerMm: real = 0.0;
    zoomStableFrames: int = 0;

    // The canvas size (px) at the last render -- where "the middle of the
    // view" is, for anything placed there.
    lastPanelSize: Vec2 = {};

    // Set when a document without a saved viewport is opened: the first
    // render, which is the first moment the canvas size is known, fits the
    // page to it.
    needsFit: bool = false;

    fn constructor(gfx: mut renderer.gfx.Context) {
        return DocumentRenderer {
            gfx: gfx,
            pool: TilePool(gfx),
        };
    }

    fn ensurePagesArraySized(doc: DocumentFile) {
        while this.pages.length < doc.data.pages.length {
            this.pages.push(PageTileState {});
        }
    }

    // Takes over a newly opened document's saved viewport, or fits its first
    // page if it has none. (Its tiles are dropped by render(), which sees the
    // new documentId.)
    //
    // The file keeps the web app's meaning: the offset places the page
    // `currentPageIndex` (the web app showed one page at a time), not the
    // top of the stack -- see savedViewport for the way back.
    fn adoptViewport(doc: DocumentFile) {
        if let saved = doc.data.viewport {
            this.viewport = saved;
            this.viewport.offsetY = saved.offsetY - pageOriginY(doc, currentPageOf(doc)) * saved.zoomPxPerMm;
            this.needsFit = saved.zoomPxPerMm <= 0.0;
        } else {
            this.viewport = {};
            this.needsFit = true;
        }
        this.zoomStableFrames = 0;
    }

    // The viewport as the file stores it, with `page` as the current page --
    // the reverse of adoptViewport.
    fn savedViewport(doc: DocumentFile, page: int): Viewport {
        let result = this.viewport;
        result.offsetY = this.viewport.offsetY + pageOriginY(doc, page) * this.viewport.zoomPxPerMm;
        return result;
    }

    // The first page, as wide as the canvas allows (never past the web app's
    // 5 px/mm default), centered, just below the top edge.
    fn fitToWidth(doc: DocumentFile, panelW: real) {
        let zoom = min(5.0, (panelW - 40.0) / doc.data.pageWidthMm);
        if zoom < 0.05 {
            zoom = 0.05;
        }
        this.viewport.zoomPxPerMm = zoom;
        this.viewport.offsetX = (panelW - doc.data.pageWidthMm * zoom) / 2.0;
        this.viewport.offsetY = 20.0;
    }

    // Canvas px <-> document mm. The document's space is the pages stacked
    // top to bottom -- see pageOriginY for where each one starts.
    fn screenToWorld(p: Vec2): Vec2 {
        return Vec2((p.x - this.viewport.offsetX) / this.viewport.zoomPxPerMm, (p.y - this.viewport.offsetY) / this.viewport.zoomPxPerMm);
    }

    fn worldToScreen(p: Vec2): Vec2 {
        return Vec2(p.x * this.viewport.zoomPxPerMm + this.viewport.offsetX, p.y * this.viewport.zoomPxPerMm + this.viewport.offsetY);
    }

    fn releasePageTiles(page: mut PageTileState) {
        for tile in page.slots.values {
            this.pool.release(tile);
        }
        page.slots.clear();
    }

    // Releases every tile on every page and forgets each page's committed
    // level, forcing a full re-tile (and, combined with clearing the
    // shapes' own cached bbox/outline/tesselation -- see
    // documents.hz's clearShapeCache -- a full re-render) on the next
    // render() call. render() calls it when the document changes; also for
    // manually invalidating stale-looking content during development.
    fn clearAll() {
        for page in this.pages {
            this.releasePageTiles(page);
            page.hasCommittedLevel = false;
        }
    }

    // Pure pan: only ever touches the offset, never forces a retile. This
    // is also what streams new edge tiles in continuously while panning --
    // even mid-zoom-gesture, before the zoom itself has settled -- since
    // render() recomputes each page's visible tx/ty range from the live
    // offset every frame regardless of committed-level changes.
    fn pan(dxScreenPx: real, dyScreenPx: real) {
        this.viewport.offsetX += dxScreenPx;
        this.viewport.offsetY += dyScreenPx;
    }

    // Zooms around a fixed screen point (e.g. panel center) by `factor`,
    // adjusting the offset so the world point currently under that screen
    // point stays under it after the zoom changes.
    fn zoomBy(factor: real, pivotScreenX: real, pivotScreenY: real) {
        let oldZoom = this.viewport.zoomPxPerMm;
        let newZoom = oldZoom * factor;
        if newZoom < 0.05 {
            newZoom = 0.05;
        }
        if newZoom > 200.0 {
            newZoom = 200.0;
        }

        let worldX = (pivotScreenX - this.viewport.offsetX) / oldZoom;
        let worldY = (pivotScreenY - this.viewport.offsetY) / oldZoom;

        this.viewport.zoomPxPerMm = newZoom;
        this.viewport.offsetX = pivotScreenX - worldX * newZoom;
        this.viewport.offsetY = pivotScreenY - worldY * newZoom;
    }

    // Whether render() still has work that only more calls to it finish: a
    // zoom that has not held still for zoomSettleFrames renders yet, so its
    // retile at the new native resolution is still pending. A caller that
    // only renders on change has to keep calling until this is false.
    fn isSettling(): bool {
        return this.zoomStableFrames < zoomSettleFrames;
    }

    // Rerenders exactly the tiles a given shape's bbox overlaps -- not the
    // whole page -- across every currently-active tile of the shape's page.
    // Call after mutating a shape's geometry (points/position/size) and
    // clearing its cached bbox/tesselation, before the next render().
    fn markShapeDirty(pageIndex: int, shape: Shape) {
        if pageIndex < 0 || pageIndex >= this.pages.length {
            return;
        }
        let bbox = shape.getBBox();
        let page = this.pages[pageIndex];
        for tile in page.slots.values {
            let tileBBox = BBox {
                left: tile.localMinX,
                right: tile.localMinX + tile.localSize,
                top: tile.localMinY,
                bottom: tile.localMinY + tile.localSize,
            };
            if bbox.overlaps(tileBBox) {
                tile.valid = false;
            }
        }
    }

    // Draws every page of `doc` into `r`'s panel: culls offscreen pages
    // (releasing their tiles back to the pool), syncs each visible page's
    // tile set against the live viewport (streaming edge tiles in/out every
    // frame), retiles at a new native resolution only once a zoom gesture
    // has settled, (re)renders any tile marked dirty, then composites the
    // page background + every active tile at the *live* on-screen size --
    // which is what makes tiles visibly stretch/blur mid-zoom instead of
    // updating.
    //
    // `documentId` changes whenever `doc` is a different document, or the
    // same one loaded again. The tiles are then all from the old one, so
    // they are dropped: tile validity alone would keep drawing them.
    fn render(r: mut renderer.gfx.Renderer, doc: DocumentFile, documentId: int) {
        if documentId != this.renderedDocument {
            this.clearAll();
            this.renderedDocument = documentId;
        }

        let panelW = r.canvas.size.logicalSize.x as real;
        let panelH = r.canvas.size.logicalSize.y as real;
        this.lastPanelSize = Vec2(panelW, panelH);
        if this.needsFit && panelW > 0.0 {
            this.fitToWidth(doc, panelW);
            this.needsFit = false;
        }
        if this.viewport.zoomPxPerMm <= 0.0 {
            return;
        }

        this.ensurePagesArraySized(doc);

        let zoom = this.viewport.zoomPxPerMm;

        let visMinX = (0.0 - this.viewport.offsetX) / zoom;
        let visMaxX = (panelW - this.viewport.offsetX) / zoom;
        let visMinY = (0.0 - this.viewport.offsetY) / zoom;
        let visMaxY = (panelH - this.viewport.offsetY) / zoom;
        let visibleBBox = BBox { left: visMinX, right: visMaxX, top: visMinY, bottom: visMaxY };

        let zoomDelta = zoom - this.lastZoomPxPerMm;
        if zoomDelta < 0.0 {
            zoomDelta = -zoomDelta;
        }
        if zoomDelta > zoomEpsilon {
            this.zoomStableFrames = 0;
        } else if this.zoomStableFrames < zoomSettleFrames {
            this.zoomStableFrames += 1;
        }
        this.lastZoomPxPerMm = zoom;
        let zoomSettled = this.zoomStableFrames >= zoomSettleFrames;

        // Tile native resolution must target *physical* (framebuffer)
        // pixel density, not logical -- `zoom` and the on-screen sizes used
        // to composite tiles below are correctly logical (matching every
        // other draw call in this UI), but a tile only has tileSizePx
        // physical texels of actual detail, and on a HiDPI panel
        // (dpiScale > 1) a tile shown at, say, 400 logical px covers
        // 400*dpiScale physical px -- picking the native level from the
        // logical zoom alone systematically under-resolves by a factor of
        // dpiScale, magnifying every tile's 512 texels well past 1:1 and
        // showing up as blur uniformly, independent of how "zoomed in" the
        // page itself looks.
        let dpiScale = r.canvas.size.dpiScale as real;
        let targetLevel = tilemath.zoomLevelFor(zoom * dpiScale);

        for (let i = 0; i < doc.data.pages.length; i++) {
            let page = this.pages[i];
            let originX = 0.0;
            let originY = pageOriginY(doc, i);
            let pageBBox = BBox {
                left: originX,
                right: originX + doc.data.pageWidthMm,
                top: originY,
                bottom: originY + doc.data.pageHeightMm,
            };

            if pageBBox.overlaps(visibleBBox) {
                if !page.hasCommittedLevel {
                    page.committedLevel = targetLevel;
                    page.hasCommittedLevel = true;
                } else if zoomSettled && targetLevel != page.committedLevel {
                    this.releasePageTiles(page);
                    page.committedLevel = targetLevel;
                }

                let tileWorldSizeMm = tilemath.tileWorldSize(page.committedLevel);

                let localMinX = max(visMinX, pageBBox.left) - originX;
                let localMaxX = min(visMaxX, pageBBox.right) - originX;
                let localMinY = max(visMinY, pageBBox.top) - originY;
                let localMaxY = min(visMaxY, pageBBox.bottom) - originY;

                let txMin = tilemath.floorToInt(localMinX / tileWorldSizeMm);
                let txMax = tilemath.floorToInt(localMaxX / tileWorldSizeMm);
                let tyMin = tilemath.floorToInt(localMinY / tileWorldSizeMm);
                let tyMax = tilemath.floorToInt(localMaxY / tileWorldSizeMm);

                let newSlots = LinearMap<str, mut Tile> {};
                for (let ty = tyMin; ty <= tyMax; ty++) {
                    for (let tx = txMin; tx <= txMax; tx++) {
                        let slotKey = f"{page.committedLevel}:{tx}:{ty}";
                        let existing = page.slots.get(slotKey);
                        if existing {
                            newSlots.set(slotKey, existing);
                        } else {
                            // Page-local, not world -- never add originX/originY
                            // here (see Tile's own doc comment in tiles.hz).
                            let localTileMinX = tx as real * tileWorldSizeMm;
                            let localTileMinY = ty as real * tileWorldSizeMm;
                            let tileKey = TileKey { pageIndex: i, level: page.committedLevel, tx: tx, ty: ty };
                            let tile = this.pool.acquire(tileKey, localTileMinX, localTileMinY, tileWorldSizeMm);
                            newSlots.set(slotKey, tile);
                        }
                    }
                }

                for (let k = 0; k < page.slots.keys.length; k++) {
                    if !newSlots.has(page.slots.keys[k]) {
                        this.pool.release(page.slots.values[k]);
                    }
                }
                page.slots = newSlots;

                for tile in page.slots.values {
                    if !tile.valid {
                        renderTileContent(tile, doc.data.pages[i], doc.data.pageWidthMm, doc.data.pageHeightMm, r.frame, this.imageCache);
                        tile.valid = true;
                    }
                }

                r.drawRect({
                    pos: Vec2(originX * zoom + this.viewport.offsetX, originY * zoom + this.viewport.offsetY),
                    size: Vec2(doc.data.pageWidthMm * zoom, doc.data.pageHeightMm * zoom),
                    fillColor: Color(1, 1, 1, 1),
                });

                for tile in page.slots.values {
                    let tileScreenSize = tile.localSize * zoom;
                    let tileScreenPos = Vec2(
                        (originX + tile.localMinX) * zoom + this.viewport.offsetX,
                        (originY + tile.localMinY) * zoom + this.viewport.offsetY
                    );
                    r.drawTexture({
                        texture: tile.canvas.asTexture(),
                        pos: tileScreenPos,
                        size: Vec2(tileScreenSize, tileScreenSize),
                    });
                }
            } else {
                this.releasePageTiles(page);
            }
        }
    }

    // Page mm -> canvas px for one page: what a shape's own coordinates go
    // through to land where its page is on screen.
    fn pageToScreenTransform(doc: DocumentFile, pageIndex: int): mat4.Mat4f {
        let zoom = this.viewport.zoomPxPerMm;
        return mat4.translation(Vec3(
            this.viewport.offsetX,
            pageOriginY(doc, pageIndex) * zoom + this.viewport.offsetY,
            0.0
        )).mul(mat4.scaling(Vec3(zoom, zoom, 1.0)));
    }

    // Draws a shape straight onto the panel canvas, bypassing the tiles --
    // so a live pen stroke never waits on a tile (re)render to become
    // visible, and a shape being moved or resized follows the pen every
    // frame. `pageTransform` places it within its page (identity for where
    // it is; a move or resize in progress otherwise), and `color`, when
    // given, replaces a stroke's own (the grey of an erased one).
    fn drawShapeLive(r: mut renderer.gfx.Renderer, doc: DocumentFile, pageIndex: int, shape: Shape, pageTransform: mat4.Mat4f, color: Color | none = none) {
        let transform = this.pageToScreenTransform(doc, pageIndex).mul(pageTransform);
        if shape is LineShape {
            // Same physical-pixel-density level a tile at this live zoom would
            // commit to (see render()'s targetLevel) -- this is also what lets
            // the live overlay and a freshly-tiled version of the same shape
            // share a cache entry instead of tesselating it twice.
            let dpiScale = r.canvas.size.dpiScale as real;
            let level = tilemath.zoomLevelFor(this.viewport.zoomPxPerMm * dpiScale);
            let tess = shape.ensureTesselated(level);
            if tess.indices.length == 0 {
                return;
            }
            let fill = color ?? Color.fromHexOrDefault(shape.penColor, Color(0.0, 0.0, 0.0, 1.0));
            r.addTriangles(tess.vertices, tess.indices, fill, 0, transform);
        }
        else if shape is ImageShape {
            let bbox = shape.getBBox();
            let texture = this.imageCache.getOrCreate(r, shape);
            if texture {
                r.drawTexture({
                    texture: texture,
                    pos: Vec2(bbox.left, bbox.top),
                    size: Vec2(bbox.right - bbox.left, bbox.bottom - bbox.top),
                    transform: transform,
                });
            }
        }
        else if shape is TextblockShape {
            let bbox = shape.getBBox();
            r.drawRect({
                pos: Vec2(bbox.left, bbox.top),
                size: Vec2(bbox.right - bbox.left, bbox.bottom - bbox.top),
                fillColor: Color(0.95, 0.95, 0.8, 1.0),
                borderColor: Color(0.6, 0.6, 0.3, 1.0),
                borderThickness: 0.5,
                transform: transform,
            });
        }
    }
}
