from ui_widgets import ScrollView, ScrollViewComponent, ScrollViewSlotContent

// The vault's notes and folders, as a scrolling list of rows that builds only
// the rows in view -- see filetree.hz for the model and why.

// Space around the rows inside the scrolled content.
const TREE_PADDING = 6.0;
// Rows built past each edge of the viewport, so a row scrolling in is
// already there.
const TREE_OVERSCAN = 6;

@props
index: VaultIndex;
// The open folders' paths. A model, as v-model is in Vue: the tree writes it
// when a folder is opened or closed, and its owner keeps (and saves) it --
// rows come and go as they scroll, so no row could hold that state.
expanded: Reactive<[]str>;
// Where the list is scrolled to, in px: a model too. The tree starts there
// (a vault reopens where it was left, from the first frame) and writes it as
// it scrolls.
scrollTop: Reactive<real>;
// The note that is open in the editor (vault-relative, as every path here).
activePath: str = "";
// An entry to bring into view, its folders opened: one just created. Asked
// for again each time `revealSerial` changes.
reveal: str = "";
revealSerial: int = 0;
rowHeight: real = 28.0;
indent: real = 16.0;

@emit
open: (str,);
// A row's menu, or the vault's (path "") from the space around the rows.
menu: (TreeMenuRequest,);

@setup
let scrollView = ui.componentRef<ScrollView>();
// Where the tree was left. Read once: from here on the tree writes it.
let startScrollTop = rx.untracked(() => rx.get(props.scrollTop));

let rows = computed((): []TreeRow => {
    // A plain copy of the open paths: flattenTree looks them up by value.
    let open: []str = [];
    for path in props.expanded {
        open.push(path);
    }
    let out: []TreeRow = [];
    flattenTree(props.index, expandedSet(open), out);
    return out;
});

// The rows are ScrollView's slot content, and a slot runs again only when
// something it READ changed -- so everything the rows are built from comes
// through here, scrolling included.
// Until the viewport is measured (its first frame), a tall screenful: right
// for any window, and corrected the next frame.
const UNMEASURED_VIEW_HEIGHT = 1600.0;

let window = computed((): TreeWindow => {
    let all: []TreeRow = rx.get(rows);
    let view = rx.get(scrollView);
    if !view {
        return treeWindow(all.length, props.rowHeight, TREE_PADDING, startScrollTop, UNMEASURED_VIEW_HEIGHT, TREE_OVERSCAN);
    }
    let viewHeight = rx.get(view.scroll.clientHeight);
    if viewHeight <= 0.0 {
        viewHeight = UNMEASURED_VIEW_HEIGHT;
    }
    return treeWindow(all.length, props.rowHeight, TREE_PADDING,
        rx.get(view.scroll.scrollTop), viewHeight, TREE_OVERSCAN);
});

// The list's height, exactly: every row is rowHeight tall.
let contentHeight = computed((): real => 2.0 * TREE_PADDING + rx.get(rows).length as real * props.rowHeight);

// A scroll view measures its content from the last layout, a frame late, so
// when the list shrinks -- a folder closing near the end -- it would draw one
// frame scrolled past the end, blank below the last row. The tree knows its
// new height the moment its rows change, so it says so before that frame is
// built, and the scroll position is clamped in time.
ui.watch(() => rx.get(contentHeight), (height, old) => {
    let view = rx.get(scrollView);
    if !view { return; }
    let scroll = view.scroll;
    if rx.get(scroll.clientHeight) <= 0.0 { return; }
    scroll.setMetrics(Vec2(rx.get(scroll.clientWidth), rx.get(scroll.clientHeight)),
        Vec2(rx.get(scroll.scrollWidth), height));
});

let visibleRows = computed((): []TreeRow => {
    let all: []TreeRow = rx.get(rows);
    let w = rx.get(window);
    let result: []TreeRow = [];
    for (let i = w.start; i < w.end; i++) {
        let row = all[i];
        result.push(row);
    }
    return result;
});

let spacerBefore = computed((): real => rx.get(window).rowsBefore as real * props.rowHeight);
let spacerAfter = computed((): real => rx.get(window).rowsAfter as real * props.rowHeight);

let toggle = (path: str) => {
    let current: []str = [];
    for open in props.expanded {
        current.push(open);
    }
    // A reactive array is replaced whole by an array of cells.
    let cells: []Reactive<str> = [];
    for open in toggledPaths(current, path) {
        cells.push(reactive<str>(open));
    }
    props.expanded := cells;
};

let openNote = (path: str) => {
    emits.open(path);
};

let forwardMenu = (request: TreeMenuRequest) => {
    emits.menu(request);
};

// The space around the rows: the vault's own menu. A row's menu stops before
// it gets here.
let vaultMenu = (event: PointerEvent) => {
    event.stopPropagation();
    emits.menu(TreeMenuRequest { path: "", pos: event.pos });
};

// An entry to scroll into view, its folders opened: `reveal`, each time
// `revealSerial` changes (one just created), scrolled to only as far as it
// takes. Closed folders it is in are opened first, and it is scrolled to the
// frame after, when its row exists. Nothing is revealed on mount: the tree
// starts where it was left (scrollTop).
let revealPath: ref Box<str> = { value: "" };
let revealed: ref Box<bool> = { value: true };
let openedForReveal: ref Box<bool> = { value: false };

ui.watch(() => props.revealSerial, (serial, previous) => {
    if props.reveal.length == 0 { return; }
    revealPath.value = props.reveal;
    revealed.value = false;
    openedForReveal.value = false;
});

ui.onFrame(() => {
    let view = rx.get(scrollView);
    if !view { return; }
    // The scroll position goes to the owner (the vault's cache, which
    // writes it to disk once it has settled).
    let top = rx.get(view.scroll.scrollTop);
    if top != rx.untracked(() => rx.get(props.scrollTop)) {
        props.scrollTop := top;
    }
    if revealed.value { return; }
    if rx.get(view.scroll.clientHeight) <= 0.0 || rx.get(view.scroll.scrollHeight) <= 0.0 { return; }
    let target = revealPath.value;
    let index = rowIndexOf(rx.get(rows), target);
    if index < 0 && !openedForReveal.value && target.length > 0 {
        openedForReveal.value = true;
        let chain: []str = [];
        if folderChainTo(props.index, target, chain) {
            let current: []str = [];
            for open in props.expanded {
                current.push(open);
            }
            let cells: []Reactive<str> = [];
            for open in current {
                cells.push(reactive<str>(open));
            }
            let opened = false;
            for folder in chain {
                let known = false;
                for open in current {
                    if open == folder { known = true; }
                }
                if !known {
                    cells.push(reactive<str>(folder));
                    opened = true;
                }
            }
            if opened {
                props.expanded := cells;
                return;
            }
        }
    }
    revealed.value = true;
    if index >= 0 {
        view.scroll.scrollIntoView(TREE_PADDING + index as real * props.rowHeight, props.rowHeight);
    }
});

@template [w-grow h-grow] @contextmenu=vaultMenu

ScrollView [] ref=scrollView padding=[TREE_PADDING] barSize=[8.0] initialScrollTop=[startScrollTop]
    thumbColor=[theme().scrollThumb] thumbHoverColor=[theme().scrollThumbHover]
    thumbActiveColor=[theme().scrollThumbActive]
{
    #content {
        div if=[spacerBefore > 0.0] [w-grow h-[spacerBefore]px]
        // Keyed by the slot in the window, not the row's place in the list:
        // a slot shows the next row as the list scrolls, so the set of
        // element ids stays the same size however far it is scrolled. Keyed
        // by list position, every row ever scrolled past minted ids of its
        // own, and the layout engine's id table (8192 entries, never freed
        // in the vendored Clay) ran full in a big open vault -- every new
        // element after that got no box, and the tree went blank.
        FileTreeRow for=[row, i in visibleRows] key=[i] []
            path=[row.path] name=[row.name] depth=[row.depth] isDir=[row.isDir]
            expanded=[row.open] active=[!row.isDir && row.path == props.activePath] ghost=[row.ghost]
            rowHeight=[props.rowHeight] indent=[props.indent]
            @toggle=toggle @open=openNote @menu=forwardMenu
        {}
        div if=[spacerAfter > 0.0] [w-grow h-[spacerAfter]px]
    }
}
