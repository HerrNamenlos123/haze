// Drives haze-notes' DocumentLoad and DocumentSave (src/persistence.hz): a
// note saved and loaded back, a new note, and files that are not notes.
// Clicking a PDF in the file tree once made the load panic, and the PDF
// stayed the vault's lastOpenedFile, so every start crashed. A file that is
// not a note must end the load as failed, never take the app down, and be
// told apart from a note that is damaged.
//
// Run: TMPDIR=<scratch> haze-notes/tests/run-test.sh haze-notes/tests/document-load-tests.hz persistence.hz hznote.hz documents.hz tiles.hz

ref struct State {
    checks: int = 0;
    failures: int = 0;

    mut fn check(name: str, ok: bool) {
        this.checks = this.checks + 1;
        if !ok {
            this.failures = this.failures + 1;
            fmt.println(f"FAIL: {name}");
        }
    }
}

__c__("#include <sys/stat.h>");

fn makeFifo(path: str) {
    do unsafe {
        __c__("char *p = malloc((size_t)path.length + 1); memcpy(p, path.data, (size_t)path.length); p[path.length] = 0; mkfifo(p, 0600); free(p);");
    };
}

// Where the fixtures are written.
fn fixtureDir(): str {
    if let tmp = env.get("TMPDIR") {
        return f"{tmp}/haze-notes-document-load-tests";
    }
    if let tmp = env.get("TEMP") {
        return f"{tmp}/haze-notes-document-load-tests";
    }
    return "/tmp/haze-notes-document-load-tests";
}

fn sampleDocument(): DocumentFile {
    let points: []Point = [Point { x: 10.0, y: 10.0, pressure: 0.5 }, Point { x: 20.0, y: 15.0, pressure: 0.5 }, Point { x: 30.0, y: 12.0, pressure: 0.5 }];
    let first: []Shape = [LineShape { variant: "Line", points: points, penColor: "#000000", penThickness: 1.0 }];
    let second: []Shape = [];
    let pages: []Page = [Page { shapes: first }, Page { shapes: second }];
    return DocumentFile {
        data: DocumentBody {
            pageColor: "#ffffff",
            gridColor: "#cccccc",
            gridType: "dots",
            pages: pages,
            pageWidthMm: 210.0,
            pageHeightMm: 297.0,
            currentPageIndex: 0,
        },
    };
}

// Loads `path` the way the editor does; "note", "not a note" (the file is
// not one at all) or "damaged" (it is a note, but one that cannot be read).
fn outcomeOf(load: DocumentLoad): str {
    load.step(time.now() + 10.0);
    if !load.failed && load.doc {
        return "note";
    }
    return load.notANote ? "not a note" : "damaged";
}

fn checkOutcome(state: mut State, name: str, data: Bytes, expected: str) {
    let path = f"{fixtureDir()}/{name}";
    state.check(f"{name}: fixture written", fs.writeBinary(path, data) ? true : false);
    let actual = outcomeOf(DocumentLoad(path));
    state.check(f"{name}: {expected} (got {actual})", actual == expected);
}

fn main(): int {
    let state = State {};
    fs.createDirectory(fixtureDir());

    // A real document, saved and loaded back.
    fmt.println("case: round trip");
    let path = f"{fixtureDir()}/roundtrip.hznote";
    let original = sampleDocument();
    let save = DocumentSave(path, original);
    save.finish();
    state.check("round trip: saved", !save.failed && save.started());
    let load = DocumentLoad(path);
    state.check("round trip: loaded", outcomeOf(load) == "note");
    if let doc = load.doc {
        state.check("round trip: the same note", documentDifference(original, doc) == "");
    } else {
        state.check("round trip: has a document", false);
    }
    // A save replaces the file: saved again with a stroke more, it holds
    // that, and no `.saving` file is left beside it.
    original.data.pages[1].shapes.push(LineShape { variant: "Line", points: [Point { x: 1.0, y: 2.0, pressure: 0.5 }], penColor: "#ff0000", penThickness: 0.5 });
    DocumentSave(path, original).finish();
    let again = DocumentLoad(path);
    state.check("saved again: loaded", outcomeOf(again) == "note");
    if let doc = again.doc {
        state.check("saved again: the new stroke is there", documentDifference(original, doc) == "");
    }
    state.check("saved again: nothing left beside it", !fs.statFile(f"{path}.saving"));
    let savedBytes = fs.readBinary(path);
    state.check("round trip: file readable", savedBytes ? true : false);
    let valid: Bytes = savedBytes ? savedBytes : Bytes();

    // What a note created in the app starts as: technicalsketcher.web's new
    // document, which the editor opens as one blank A4 page.
    fmt.println("case: new note");
    let newPath = f"{fixtureDir()}/new-note.hznote";
    state.check("new note: written", fs.writeBinary(newPath, newNoteBytes()) ? true : false);
    let fresh = DocumentLoad(newPath);
    state.check("new note: loaded", outcomeOf(fresh) == "note");
    if let doc = fresh.doc {
        state.check("new note: one page", doc.data.pages.length == 1);
        if doc.data.pages.length == 1 {
            state.check("new note: the page is blank", doc.data.pages[0].shapes.length == 0);
        }
        state.check("new note: A4", doc.data.pageWidthMm == 210.0 && doc.data.pageHeightMm == 297.0);
        state.check("new note: the web app's colours",
            doc.data.pageColor == "#ffffff" && doc.data.gridColor == "#5252524f");
        state.check("new note: ruled", doc.data.gridType is "lines");
        state.check("new note: on its first page", doc.data.currentPageIndex == 0);
    } else {
        state.check("new note: has a document", false);
    }

    // ── Not a note ──────────────────────────────────────────────────
    //
    // A note is an .hznote, which its first bytes say; anything else is not
    // a note, however it fails, and is told apart from a note that is
    // damaged.
    fmt.println("case: not a note");
    checkOutcome(state, "doc.pdf", Bytes("%PDF-1.7\n%\n1 0 obj\n<< /Type /Catalog >>\nendobj\n"), "not a note");
    checkOutcome(state, "readme.md", Bytes("# Notes\nhello"), "not a note");
    checkOutcome(state, "empty.bin", Bytes(), "not a note");
    // The magic's first four bytes only (0x89 'H' 'Z' 'N').
    let magicStart = ByteBuffer();
    magicStart.push(0x89 as u8);
    magicStart.push("HZN");
    magicStart.commit();
    checkOutcome(state, "short.bin", magicStart.bytes(), "not a note");
    checkOutcome(state, "old.tsk", Bytes("{\"filetype\":\"technicalsketcher\",\"fileversion\":1,\"data\":{}}"), "not a note");
    checkOutcome(state, "saved.hznote", valid, "note");
    checkOutcome(state, "truncated.hznote", valid.slice(0, valid.length / 2), "damaged");
    checkOutcome(state, "cut-at-the-end.hznote", valid.slice(0, valid.length - 1), "damaged");
    checkOutcome(state, "only-the-magic.hznote", valid.slice(0, 8), "damaged");

    // A large file that is no note is turned down by its first bytes, at the
    // load's first step: it is never read whole.
    fmt.println("case: large file that is no note");
    let bigText = String();
    for (let i = 0; i < 400000; i++) {
        bigText.append("0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123");
    }
    let bigPath = f"{fixtureDir()}/video.mp4";
    state.check("large file: fixture written", fs.writeText(bigPath, bigText.cloneString()) ? true : false);
    let started = time.now();
    let big = DocumentLoad(bigPath);
    state.check("large file: over at the first step", big.step(time.now() + 10.0));
    state.check("large file: not a note", big.failed && big.notANote);
    state.check("large file: turned down without reading it", time.now() - started < 0.01);

    // ── Why a file could not be opened ──────────────────────────────
    fmt.println("case: why not");
    let missing = DocumentLoad(f"{fixtureDir()}/deleted elsewhere.hznote");
    state.check("missing: failed, and not for being no note", outcomeOf(missing) == "damaged");
    state.check(f"missing: says it is gone ({missing.hint})", missing.hint.contains("not there any more"));
    let broken = DocumentLoad(f"{fixtureDir()}/truncated.hznote");
    outcomeOf(broken);
    state.check(f"damaged: says so ({broken.hint})", broken.failed && !broken.notANote && broken.hint.startsWith("The file is damaged"));
    let newerBytes = ByteBuffer(valid);
    newerBytes.setAt(8, 2 as u8);
    newerBytes.commit();
    let newerPath = f"{fixtureDir()}/newer.hznote";
    fs.writeBinary(newerPath, newerBytes.bytes());
    let newer = DocumentLoad(newerPath);
    outcomeOf(newer);
    state.check(f"newer: says so ({newer.hint})", newer.failed && newer.hint.contains("newer Haze Notes"));
    // A named pipe is listed while the tree shows every file. Opening it must
    // not wait for a writer that never comes: it is simply no note.
    let pipePath = f"{fixtureDir()}/pipe";
    makeFifo(pipePath);
    let pipe = DocumentLoad(pipePath);
    state.check("a named pipe: over at the first step", pipe.step(time.now() + 10.0));
    state.check("a named pipe: not a note", pipe.failed && pipe.notANote);
    let folderLoad = DocumentLoad(fixtureDir());
    state.check("a folder: over at the first step", folderLoad.step(time.now() + 10.0));
    state.check("a folder: not a note", folderLoad.failed && folderLoad.notANote);

    fs.removeFile(bigPath);
    if state.failures > 0 {
        fmt.println(f"{state.failures} of {state.checks} checks FAILED");
        return 1;
    }
    fmt.println(f"all {state.checks} checks passed");
    return 0;
}
