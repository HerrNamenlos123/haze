// A fresh folder per run: the file system API cannot delete, and a file left
// over from an earlier run would be listed with the fixture.
fn fixtureDir(): str {
    let base = "/tmp";
    if let tmp = env.get("TEMP") {
        base = tmp;
    }
    if let tmp = env.get("TMPDIR") {
        base = tmp;
    }
    let stamp = time.now() * 1000000.0;
    return f"{base}/haze-notes-vault-order-tests-{stamp}";
}

fn flatten(entries: []FSEntry, indent: str, lines: []str): void :: final {
    for entry in entries {
        if entry is FSDirEntry {
            lines.push(f"{indent}{entry.dirname}/");
            flatten(entry.children, indent + "  ", lines);
        }
        if entry is FSFileEntry {
            lines.push(f"{indent}{entry.filename}");
        }
    }
}

fn main(): int {
    let state: mut ref State = State {};
    let root = fixtureDir();
    for file in fixtureFiles() {
        let path = f"{root}/{file}";
        let slash = -1;
        for (let i = 0; i < path.length; i++) {
            if path[i] == 47 {
                slash = i;
            }
        }
        fs.createDirectory(path.slice(0, slash));
        state.check(f"fixture written: {file}", fs.writeText(path, "") ? true : false);
    }

    let vault = indexVault(root);
    // A deep reactive array is read element by element.
    let top: []FSEntry = [];
    for entry in vault.entries {
        top.push(entry);
    }
    let actual: []str = [];
    flatten(top, "", actual);
    let expected = expectedOrder();

    state.check(f"entry count: {actual.length} listed, {expected.length} expected", actual.length == expected.length);
    let shown = 0;
    for (let i = 0; i < expected.length && i < actual.length; i++) {
        if actual[i] != expected[i] && shown < 10 {
            shown = shown + 1;
            fmt.println(f"  line {i}: expected \"{expected[i]}\", got \"{actual[i]}\"");
        }
        state.check(f"line {i} in order", actual[i] == expected[i]);
    }

    fmt.println(f"{state.checks - state.failures}/{state.checks} checks passed");
    return state.failures == 0 ? 0 : 1;
}
