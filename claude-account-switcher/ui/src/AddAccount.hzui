from ui_widgets import ButtonComponent, ButtonSlotContent, TextInputComponent

@emit
// The account was added.
added: ();
cancel: ();

@setup
// What is typed here stays while the window is closed and opened again: the
// form is not rebuilt for that, only when it is closed.
let name = reactive<str>("");
let token = reactive<str>("");

let pickIcon = () => {
    switcher().requestPick(PickKind.Icon);
};

let add = () => {
    let iconFile = rx.get(switcher().pickedIcon) ?? "";
    if switcher().addAccount(rx.get(name), iconFile, rx.get(token)) {
        name := "";
        token := "";
        switcher().clearPicked();
        emits.added();
    }
};

let submit = (value: str) => {
    add();
};

let cancel = () => {
    emits.cancel();
};

let keyPressed = (event: KeyboardEvent) => {
    if event.key == Key.Escape {
        event.stopPropagation();
        cancel();
    }
};

@template [col w-grow h-fit gap-[10]px p-[10]px mb-[6]px rounded-[radiusRow]px bg-[panel] border-[1] border-color-[border]] @keydown=keyPressed

div [col w-grow h-fit gap-[4]px] {
    text [text-color-[text2] font-size-[smallSize]] ["Name"]
    div [row w-grow h-fit gap-[6]px items-center] {
        Button [] paddingX=[3] paddingY=[3] rounded=[radiusControl] bg=[canvas] bgHover=[hover] textColor=[text3] focusRing=[0] @click=pickIcon {
            #content {
                AccountIcon [] accountId=[draftIconId] size=[20] {}
            }
        }
        TextInput [] text=[name] autofocus=[true] fontSize=[textSize] fontFamily=[fontRegular]
            backgroundColor=[canvas] borderColor=[borderStrong] textColor=[text1] placeholderColor=[text3]
            selectionColor=[pressed] caretColor=[accent] paddingX=[8] paddingY=[5] rounded=[radiusControl] focusRing=[0]
            @submit=submit {}
    }
}
div [col w-grow h-fit gap-[4]px] {
    text [text-color-[text2] font-size-[smallSize]] ["Token"]
    TextInput [] text=[token] placeholder="sk-ant-oat01-..." fontSize=[smallSize] fontFamily=[fontMono]
        backgroundColor=[canvas] borderColor=[borderStrong] textColor=[text1] placeholderColor=[text3]
        selectionColor=[pressed] caretColor=[accent] paddingX=[8] paddingY=[6] rounded=[radiusControl] focusRing=[0]
        @submit=submit {}
}
div [row w-grow h-fit gap-[6]px] {
    div [w-grow] {}
    Button [] label="Cancel" bg=[raised] bgHover=[hover] bgActive=[pressed] textColor=[text1]
        paddingX=[10] paddingY=[5] rounded=[radiusControl] focusRing=[0] @click=cancel {}
    Button [] label="Add account" bg=[accent] bgHover=[accentHover] bgActive=[accentPressed] textColor=[accentInk]
        paddingX=[10] paddingY=[5] rounded=[radiusControl] focusRing=[0] @click=add {}
}
