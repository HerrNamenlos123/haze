from ui_widgets import ButtonComponent, TextInputComponent

@props
account: Account;
active: bool;
// This row asks whether to remove the account.
confirmingRemove: bool;

@emit
askRemove: (str,);
cancelRemove: ();

@setup
let rootRef = elementRef<DivElement>();
let hovered = computed(() => rootRef?.hover() ?? false);
let token = reactive<str>("");

let saveToken = () => {
    if switcher().setToken(props.account.id, rx.get(token)) {
        token := "";
    }
};

let submitToken = (value: str) => {
    saveToken();
};

let askRemove = () => {
    emits.askRemove(props.account.id);
};

let remove = () => {
    switcher().removeAccount(props.account.id);
    emits.cancelRemove();
};

let cancel = () => {
    emits.cancelRemove();
};

@template [
        col w-grow h-fit gap-2 px-3 py-2 rounded-[6]px
        bg-[props.active ? "#26262F" : (rx.get(hovered) ? "#1E1E25" : "#00000000")]
        border-[1] border-color-[props.active ? "#6D5BD0" : "#00000000"]
    ]
    ref=rootRef

div [row w-grow h-fit items-center gap-3] {
    AccountIcon [] accountId=[props.account.id] {}
    div [w-grow h-fit] {
        text [text-color-[props.account.hasToken ? "#E4E4E7" : "#A1A1AA"]] [props.account.name]
    }
    div if=[props.confirmingRemove] [row h-fit gap-1 items-center] {
        Button [] label="Remove" bg="#C42B1C" bgHover="#D13A2B" bgActive="#B0271A" textColor="#FFFFFF"
            paddingX=[10] paddingY=[3] focusRing=[0] @click=remove {}
        Button [] icon="close" paddingX=[4] paddingY=[3] textColor="#A1A1AA" focusRing=[0] @click=cancel {}
    }
    // Always laid out, so the name keeps its width whether the button shows.
    div else [w-[24]px h-fit items-center justify-center] {
        Button if=[rx.get(hovered)] [] icon="trash" paddingX=[4] paddingY=[2]
            textColor="#71717A" focusRing=[0] @click=askRemove {}
    }
}
div if=[!props.account.hasToken] [row w-grow h-fit gap-2 items-center] {
    TextInput [] text=[token] placeholder="Token for this machine" fontSize=[13]
        backgroundColor="#1F1F26" borderColor="#2E2E38" textColor="#E4E4E7" focusRing=[0] @submit=submitToken {}
    Button [] label="Save" bg="#6D5BD0" bgHover="#7C6BDB" bgActive="#5E4EC0" textColor="#FFFFFF"
        paddingX=[12] paddingY=[5] focusRing=[0] @click=saveToken {}
}
