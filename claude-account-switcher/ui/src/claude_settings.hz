// Claude Code's own setting for the switcher, in its settings.json: while an
// account is active, `apiKeyHelper` runs the installed switcher with
// --print-token and the token is read again every second
// (CLAUDE_CODE_API_KEY_HELPER_TTL_MS); while none is, neither is there, and
// Claude Code uses its own login. The switcher keeps this true on every
// machine it runs on, so no machine sets it by hand and none can drift.
//
// Only these two entries are ever touched; every other one stays as it is.
// The host decides which file and which program; nothing here knows a real
// path.

export const helperKey = "apiKeyHelper";
export const envKey = "env";
export const ttlKey = "CLAUDE_CODE_API_KEY_HELPER_TTL_MS";
export const ttlValue = "1000";

// The apiKeyHelper command that runs `executable`: its full path, quoted, so
// nothing depends on PATH or on spaces in the path.
export fn helperCommand(executable: str): str {
    return f"\"{executable}\" --print-token";
}

// Makes the settings file at `path` hold `command` as its apiKeyHelper (and
// the token refresh interval), or neither when `command` is none. True when
// the file was written, false when it already said so. A file that is not
// there counts as `{}`. One that is there but cannot be read, or is not a
// JSON object with an object as "env", is an error and is never written to.
export fn applyClaudeSettings(path: str, command: str | none): Result<bool, str> {
    let text = "{}";
    let read = fs.readText(path);
    if read {
        let content: str = read;
        text = content;
    } else if read != fs.Error.NotFound {
        return Result<bool, str>.Err(f"{path} could not be read: {read}");
    }
    let parsed = json.parseToJsonNode(text);
    if !parsed {
        return Result<bool, str>.Err(f"{path} is not JSON");
    }
    let root: json.Node = parsed;
    if !root.isObject() {
        return Result<bool, str>.Err(f"{path} is not a JSON object");
    }
    // Claude Code reads the last of a key that is there twice, this code the
    // first: with two, which one counts is not this program's to decide.
    if root.memberCount(envKey) > 1 || root.memberCount(helperKey) > 1 {
        return Result<bool, str>.Err(f"{path} has \"env\" or \"apiKeyHelper\" twice");
    }
    let env = root.member(envKey);
    if let existing = env {
        if !existing.isObject() {
            return Result<bool, str>.Err(f"{path}: \"env\" is not an object");
        }
        if existing.memberCount(ttlKey) > 1 {
            return Result<bool, str>.Err(f"{path} has {ttlKey} twice");
        }
    }
    let before = root.print({ pretty: true });

    root.remove(helperKey);
    if let existing = env {
        // An "env" that only held the interval goes with it.
        let removedTtl = existing.remove(ttlKey);
        if removedTtl && existing.objectEntryCount() == 0 && !command {
            root.remove(envKey);
        }
    }
    // "env" first, then the helper at the end: the order a first write leaves
    // is the order every later one makes again, so an unchanged state is
    // never written again. Every key by its exact name: an "Env" is not
    // Claude Code's "env".
    if let wanted = command {
        if let existing = env {
            existing.addString(ttlKey, ttlValue);
        } else {
            let created = root.addObject(envKey);
            created.addString(ttlKey, ttlValue);
        }
        root.addString(helperKey, wanted);
    }

    let after = root.print({ pretty: true });
    if after == before {
        return Result<bool, str>.Ok(false);
    }
    let written = fs.replaceText(path, after);
    if !written {
        return Result<bool, str>.Err(f"{path} could not be written: {written}");
    }
    return Result<bool, str>.Ok(true);
}
