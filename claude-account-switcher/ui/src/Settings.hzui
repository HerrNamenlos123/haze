from ui_widgets import ButtonComponent

@emit
close: ();
quit: ();

@setup
let close = () => {
    emits.close();
};

let quit = () => {
    emits.quit();
};

@template [col w-grow h-grow p-[14]px gap-[10]px]

ProfileRepo [] @done=close {}
div [row w-grow h-fit pt-[10]px border-t-[1] border-color-[border]] {
    div [w-grow] {}
    Button [] label="Quit" bg=[raised] bgHover=[danger] bgActive=[dangerHover] textColor=[text1]
        paddingX=[10] paddingY=[5] rounded=[radiusControl] focusRing=[0] @click=quit {}
}
