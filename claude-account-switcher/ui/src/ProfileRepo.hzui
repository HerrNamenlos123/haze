from ui_widgets import ButtonComponent, TextInputComponent

// Where the profile repo is on this machine: typed, or picked with a native
// folder picker. The first view the switcher ever shows, and the top of its
// settings.

@emit
// The folder was taken (setProfileRepo succeeded).
done: ();

@setup
let path = reactive<str>(rx.get(switcher().profileRepo) ?? "");

ui.watch(() => rx.get(switcher().pickedFolder), (value, old) => {
    if let picked = value {
        path := picked;
    }
});

let browse = () => {
    switcher().requestPick(PickKind.Folder);
};

let use = () => {
    if switcher().setProfileRepo(rx.get(path)) {
        emits.done();
    }
};

let submit = (value: str) => {
    use();
};

@template [col w-grow h-grow gap-[10]px]

div [col w-grow h-fit gap-[4]px] {
    text [text-color-[text2] font-size-[smallSize]] ["Profile repo"]
    div [row w-grow h-fit gap-[6]px items-center] {
        TextInput [] text=[path] placeholder="C:\\Users\\...\\Projects\\profile" fontSize=[textSize] fontFamily=[fontRegular]
            backgroundColor=[canvas] borderColor=[borderStrong] textColor=[text1] placeholderColor=[text3]
            selectionColor=[pressed] caretColor=[accent] paddingX=[8] paddingY=[5] rounded=[radiusControl] focusRing=[0]
            @submit=submit {}
        Button [] label="Browse" bg=[raised] bgHover=[hover] bgActive=[pressed] textColor=[text1]
            paddingX=[10] paddingY=[5] rounded=[radiusControl] focusRing=[0] @click=browse {}
    }
}
div [w-grow h-grow] {}
div [row w-grow h-fit] {
    div [w-grow] {}
    Button [] label="Use folder" bg=[accent] bgHover=[accentHover] bgActive=[accentPressed] textColor=[accentInk]
        paddingX=[10] paddingY=[5] rounded=[radiusControl] focusRing=[0] @click=use {}
}
