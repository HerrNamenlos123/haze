fn scenarioSlugs(sim: mut Sim) {
    sim.checkStr("plain", claude_account_switcher_ui.slugOf("Personal"), "personal");
    sim.checkStr("spaces and symbols", claude_account_switcher_ui.slugOf("  Max 20x / Work!! "), "max-20x-work");
    sim.checkStr("non-ASCII dropped", claude_account_switcher_ui.slugOf("Ärger"), "rger");
    sim.checkStr("nothing left", claude_account_switcher_ui.slugOf("!!!"), "account");
    sim.checkStr("dashes collapse", claude_account_switcher_ui.slugOf("a--b__c"), "a-b-c");
    sim.check("token shape ok", !claude_account_switcher_ui.invalidToken(TOKEN_A));
    sim.check("token with tab", claude_account_switcher_ui.invalidToken("sk-ant-a\tb") ? true : false);
}

// ── image.resize ─────────────────────────────────────────────────────

fn scenarioResize(sim: mut Sim) {
    // Left half red, right half blue.
    let px = ByteBuffer(8 * 4 * 4);
    for (let y = 0; y < 4; y++) {
        for (let x = 0; x < 8; x++) {
            if x < 4 { px.push(255 as u8); px.push(0 as u8); px.push(0 as u8); }
            else { px.push(0 as u8); px.push(0 as u8); px.push(255 as u8); }
            px.push(255 as u8);
        }
    }
    px.commit();
    let img = image.Image.fromPixels(8, 4, 4, px.bytes());
    let small = image.resize(img, 4, 2);
    sim.check("shape", small.width == 4 && small.height == 2 && small.channels == 4 && small.pixels.length == 32);
    sim.check("left stays red", small.pixels[0] > 200 && small.pixels[2] < 50);
    sim.check("right stays blue", small.pixels[12] < 50 && small.pixels[14] > 200);
    sim.check("opaque", small.pixels[3] == 255 && small.pixels[31] == 255);
    let big = image.resize(img, 64, 64);
    sim.check("upscaled shape", big.width == 64 && big.height == 64 && big.pixels.length == 64 * 64 * 4);
    let grey = image.resize(image.Image.fromPixels(1, 1, 1, Bytes(128 as u8)), 3, 3);
    sim.check("grey 1x1 to 3x3", grey.channels == 1 && grey.pixels.length == 9 && grey.pixels[4] == 128);

    // RGB and grey with alpha keep their channel count and their colour.
    let rgb = ByteBuffer(4 * 3);
    for (let i = 0; i < 4; i++) { rgb.push(10 as u8); rgb.push(200 as u8); rgb.push(30 as u8); }
    rgb.commit();
    let rgbSmall = image.resize(image.Image.fromPixels(2, 2, 3, rgb.bytes()), 1, 1);
    sim.check("rgb 2x2 to 1x1", rgbSmall.channels == 3 && rgbSmall.pixels.length == 3
        && rgbSmall.pixels[0] < 20 && rgbSmall.pixels[1] > 190 && rgbSmall.pixels[2] < 40);
    let ga = ByteBuffer(2 * 2);
    ga.push(255 as u8); ga.push(255 as u8);
    ga.push(0 as u8); ga.push(0 as u8);
    ga.commit();
    let gaSmall = image.resize(image.Image.fromPixels(2, 1, 2, ga.bytes()), 1, 1);
    // Alpha-weighted: the transparent black pixel adds no darkness.
    sim.check("grey+alpha keeps white", gaSmall.channels == 2 && gaSmall.pixels[0] > 240 && gaSmall.pixels[1] > 100 && gaSmall.pixels[1] < 160);

    // Transparent red next to opaque blue: no red fringe in the blend.
    let fringe = ByteBuffer(2 * 4);
    fringe.push(255 as u8); fringe.push(0 as u8); fringe.push(0 as u8); fringe.push(0 as u8);
    fringe.push(0 as u8); fringe.push(0 as u8); fringe.push(255 as u8); fringe.push(255 as u8);
    fringe.commit();
    let blend = image.resize(image.Image.fromPixels(2, 1, 4, fringe.bytes()), 1, 1);
    sim.check("no colour from transparent pixels", blend.pixels[0] < 20 && blend.pixels[2] > 230);
}

// ── The window ───────────────────────────────────────────────────────

ref struct Window {
    sim: mut Sim;
    ui: ui_components.UIContext;
    layout: ui_layout.LayoutContext;

    mut fn frame() {
        let sim = this.sim;
        sim.now = sim.now + STEP;
        let tree = this.ui.process();
        if !tree { return; }
        if !this.ui.frameNeedsPaint() { return; }
        sim.pass = this.ui.beginRenderFeedback();
        sim.drawingTexts = [];
        this.layout.render(tree, {
            renderFilledRectangle: (position: Vec2, size: Vec2, color: Color, cornerRadius: ui_layout.CornerRadiusValues): void => {},
            renderText: (element: ui_layout.ffi.hzui_draw_text_element_t): void => {
                sim.drawingTexts.push({ text: element.text, x: element.position.x, y: element.position.y, w: element.size.x, h: element.size.y });
            },
            onBoundingBox: (element: ui_elements.Element, pos: Vec2, size: Vec2): void => {
                ui_components.applyRenderFeedback(element, pos, size, sim.pass);
            },
            renderCanvas: (element: ui_elements.CanvasElement): void => {},
            renderBorder: (position: Vec2, size: Vec2, borderColor: Color, cornerRadius: ui_layout.CornerRadiusValues, borderWidth: ui_layout.ffi.hzui_border_widths_t): void => {},
            setClip: (clip: ui_layout.ResolvedClip): void => {},
        });
        sim.textDraws = sim.drawingTexts;
    }

    mut fn frames(count: int) {
        for (let i = 0; i < count; i++) {
            this.frame();
        }
    }

    mut fn click(pos: Vec2) {
        this.sim.now = this.sim.now + 2.0;
        this.sim.mouse = pos;
        this.sim.pointerEdges.push({ button: ui_components.PointerButton.None, kind: ui_components.PointerEdgeKind.Moved, pos: pos });
        this.frames(2);
        this.sim.leftHeld = true;
        this.sim.pointerEdges.push({ button: ui_components.PointerButton.Left, kind: ui_components.PointerEdgeKind.Pressed, pos: pos });
        this.frame();
        this.sim.leftHeld = false;
        this.sim.pointerEdges.push({ button: ui_components.PointerButton.Left, kind: ui_components.PointerEdgeKind.Released, pos: pos });
        this.frames(3);
    }

    // A right click, which asks for the menu of whatever is under it.
    mut fn rightClick(pos: Vec2) {
        this.sim.now = this.sim.now + 2.0;
        this.sim.mouse = pos;
        this.sim.pointerEdges.push({ button: ui_components.PointerButton.None, kind: ui_components.PointerEdgeKind.Moved, pos: pos });
        this.frames(2);
        this.sim.pointerEdges.push({ button: ui_components.PointerButton.Right, kind: ui_components.PointerEdgeKind.Pressed, pos: pos });
        this.frame();
        this.sim.pointerEdges.push({ button: ui_components.PointerButton.Right, kind: ui_components.PointerEdgeKind.Released, pos: pos });
        this.frames(3);
    }

    mut fn key(k: ui_components.Key) {
        this.sim.keyEdges.push({ key: k, kind: ui_components.KeyEdgeKind.Pressed, repeat: false, modifiers: KeyModifiers.None });
        this.frame();
        this.sim.keyEdges.push({ key: k, kind: ui_components.KeyEdgeKind.Released, repeat: false, modifiers: KeyModifiers.None });
        this.frames(2);
    }

    mut fn hover(pos: Vec2) {
        this.sim.mouse = pos;
        this.sim.pointerEdges.push({ button: ui_components.PointerButton.None, kind: ui_components.PointerEdgeKind.Moved, pos: pos });
        this.frames(3);
    }

    mut fn type(text: str) {
        this.sim.texts.push(text);
        this.frames(2);
    }
}

fn openWindow(sim: mut Sim, activation: rx.Reactive<int>): mut Window {
    let layout = ui_layout.LayoutContext({
        width: WIDTH,
        height: HEIGHT,
        fonts: [{ name: "default", id: 0 }, { name: "geist", id: 0 }, { name: "geist-medium", id: 0 }, { name: "geist-mono", id: 0 }],
        getFontLineHeight: (fontId: int, fontSize: real): real => fontSize * 1.3,
        measureText: (fontId: int, fontSize: real, text: str): Vec2 => Vec2(text.length as real * CHAR, fontSize * 1.3),
    });
    layout.setLayoutSize(WIDTH, HEIGHT);
    let ui = ui_components.UIContext({
        ui: (ui: ui_components.UIContext) => {
            claude_account_switcher_ui.RootComponent(ui, { id: 0, activation: activation });
        },
        mousePos: () => sim.mouse,
        clock: () => sim.now,
        pointerButtons: ui_components.PointerHeldCallbacks {
            leftHeld: () => sim.leftHeld,
            middleHeld: () => false,
            rightHeld: () => false,
            edgesThisFrame: (): []ui_components.PointerEdge => {
                let out: []ui_components.PointerEdge = [];
                for e in sim.pointerEdges { out.push(e); }
                sim.pointerEdges.clear();
                return out;
            },
            reportsMotion: true,
        },
        inputExtras: ui_components.InputExtrasCallbacks {
            wheelDelta: () => Vec2(0.0, 0.0),
            modifiers: () => KeyModifiers.None,
        },
        keyboard: ui_components.KeyboardCallbacks {
            keyEdgesThisFrame: (): []ui_components.KeyEdge => {
                let out: []ui_components.KeyEdge = [];
                for e in sim.keyEdges { out.push(e); }
                sim.keyEdges.clear();
                return out;
            },
            textInputThisFrame: (): []str => {
                let out: []str = [];
                for t in sim.texts { out.push(t); }
                sim.texts.clear();
                return out;
            },
        },
        measureText: (fontFamily: str, fontSize: real, text: str): Vec2 => {
            return layout.measureText(fontFamily, fontSize, text);
        },
        provideFont: (name: str, bytes: Bytes): void => {
            layout.registerFont(name, 0);
        },
    });
    let w = Window { sim: sim, ui: ui, layout: layout };
    w.frames(5);
    return w;
}

fn findText(sim: mut Sim, text: str): TextDraw | none {
    for d in sim.textDraws {
        if d.text == text {
            return d;
        }
    }
    return none;
}

fn shows(sim: mut Sim, text: str): bool {
    if findText(sim, text) { return true; }
    return false;
}

fn centerOf(sim: mut Sim, text: str): Vec2 {
    if let d = findText(sim, text) {
        return Vec2(d.x + d.w / 2.0, d.y + d.h / 2.0);
    }
    return Vec2(-100.0, -100.0);
}

// A text box, found by its placeholder (drawn while it is empty): a click
// into it focuses it.
fn clickBox(w: mut Window, placeholder: str): bool {
    if !shows(w.sim, placeholder) { return false; }
    w.click(centerOf(w.sim, placeholder));
    return true;
}

// The whole first start, as the user does it: the folder, then an account.
fn scenarioWindowFirstStart(sim: mut Sim) {
    let f = newFixture(sim);
    open(sim, f);
    let activation = rx.reactive<int>(0);
    let w = openWindow(sim, activation);
    sim.check("asks for the profile repo", shows(sim, "Profile repo"));
    sim.check("no accounts view yet", !shows(sim, "No accounts"));

    // A wrong folder: shown, still asking.
    sim.check("path box", clickBox(w, "C:\\Users\\...\\Projects\\profile"));
    w.type(f"{f.repo}/nope");
    w.click(centerOf(sim, "Use folder"));
    sim.check("still asking", shows(sim, "Profile repo"));
    sim.check("problem shown", s().hasProblem());

    // The folder picker fills the box.
    sim.answer = f.repo;
    s().requestPick(claude_account_switcher_ui.PickKind.Folder);
    w.frames(3);
    w.click(centerOf(sim, "Use folder"));
    sim.check("accounts view", shows(sim, "No accounts"));
    sim.check("repo taken", s().hasProfileRepo());
    sim.check("problem gone", !s().hasProblem());
}

fn scenarioWindowTokenMissing(sim: mut Sim) {
    let f = newFixture(sim);
    open(sim, f);
    s().setProfileRepo(f.repo);
    fs.createDirectory(f.synced());
    fs.writeText(f"{f.synced()}/accounts.json", "{\"accounts\":[{\"id\":\"work\",\"name\":\"Work\"}]}");
    s().reload();
    let activation = rx.reactive<int>(0);
    let w = openWindow(sim, activation);
    sim.check("account listed", shows(sim, "Work"));
    sim.check("asks for its token", clickBox(w, "sk-ant-oat01-..."));
    w.type(TOKEN_A);
    w.click(centerOf(sim, "Save"));
    sim.checkStr("saved", readOr(f"{f.state}/tokens/work.token", "<missing>"), TOKEN_A);
    sim.checkStr("now active", activeId(), "work");
    sim.check("token box gone", !shows(sim, "sk-ant-oat01-..."));
    sim.check("token never drawn", !shows(sim, TOKEN_A));
}

fn scenarioWindowRemoveAsks(sim: mut Sim) {
    let f = threeAccounts(sim);
    let activation = rx.reactive<int>(0);
    let w = openWindow(sim, activation);
    sim.check("three rows", shows(sim, "A") && shows(sim, "B") && shows(sim, "C"));
    sim.check("no menu yet", !shows(sim, "Rename"));
    w.rightClick(centerOf(sim, "B"));
    sim.check("right click opens the menu", shows(sim, "Make active") && shows(sim, "Replace token") && shows(sim, "Change icon") && shows(sim, "Rename") && shows(sim, "Remove"));
    w.click(centerOf(sim, "Remove"));
    sim.check("menu closed", !shows(sim, "Rename"));
    sim.check("the row asks first", shows(sim, "Remove"));
    sim.checkStr("nothing removed yet", ids(), "a+,b+,c+");
    w.click(centerOf(sim, "Remove"));
    sim.checkStr("b removed", ids(), "a+,c+");
    sim.check("b's row gone", !shows(sim, "B"));
}

// A click on a row makes that account active; one without a token on this
// machine says so instead.
fn scenarioWindowRowClickActivates(sim: mut Sim) {
    let f = threeAccounts(sim);
    let activation = rx.reactive<int>(0);
    let w = openWindow(sim, activation);
    sim.checkStr("a active", activeId(), "a");
    w.click(centerOf(sim, "C"));
    sim.checkStr("c active after its row was clicked", activeId(), "c");
    sim.checkStr("c's token in use", readOr(f"{f.state}/active.token", ""), TOKEN_C);
    w.click(centerOf(sim, "C"));
    sim.checkStr("a second click changes nothing", activeId(), "c");
    fs.removeFile(f"{f.state}/tokens/b.token");
    s().reload();
    w.frames(3);
    sim.check("b asks for its token", shows(sim, "no token"));
    w.click(centerOf(sim, "B"));
    sim.checkStr("b without a token stays inactive", activeId(), "c");
    sim.check("and says why", s().problemText().contains("no token on this machine"));
    checkConsistent(sim, f, "after row clicks");
}

// Rename and replace the token through the menu.
fn scenarioWindowMenuEdits(sim: mut Sim) {
    let f = threeAccounts(sim);
    let activation = rx.reactive<int>(0);
    let w = openWindow(sim, activation);
    w.rightClick(centerOf(sim, "B"));
    w.click(centerOf(sim, "Rename"));
    // The old name is selected: typing replaces it.
    w.type("Bee");
    w.key(ui_components.Key.Return);
    sim.check("renamed", shows(sim, "Bee") && !shows(sim, "B"));
    sim.checkStr("stored", readOr(f"{f.synced()}/accounts.json", ""),
        "{\"accounts\":[{\"id\":\"a\",\"name\":\"A\"},{\"id\":\"b\",\"name\":\"Bee\"},{\"id\":\"c\",\"name\":\"C\"}]}");
    sim.checkStr("its id stays", ids(), "a+,b+,c+");

    w.rightClick(centerOf(sim, "A"));
    w.click(centerOf(sim, "Replace token"));
    sim.check("asks for the token", shows(sim, "sk-ant-oat01-..."));
    w.type(TOKEN_C);
    w.key(ui_components.Key.Return);
    sim.checkStr("a's new token", readOr(f"{f.state}/tokens/a.token", ""), TOKEN_C);
    sim.checkStr("in use at once (a is active)", readOr(f"{f.state}/active.token", ""), TOKEN_C);
    sim.check("token box gone", !shows(sim, "sk-ant-oat01-..."));
    sim.check("token never drawn", !shows(sim, TOKEN_C));
}

// Closing and opening the window (clicking elsewhere hides it) keeps what is
// typed and which form is open.
fn scenarioWindowKeepsState(sim: mut Sim) {
    let f = threeAccounts(sim);
    let activation = rx.reactive<int>(0);
    let w = openWindow(sim, activation);
    // The + button: the leftmost icon in the title bar, right of the title.
    let plus = Vec2(-100.0, -100.0);
    for d in sim.textDraws {
        if d.y < 34.0 && d.text != "Claude Accounts" && (plus.x < 0.0 || d.x < plus.x) {
            plus = Vec2(d.x + d.w / 2.0, d.y + d.h / 2.0);
        }
    }
    sim.check("the + button is drawn", plus.x > 0.0);
    w.click(plus);
    sim.check("add form open", shows(sim, "Add account"));
    w.type("Half typ");
    activation := rx.get(activation) + 1;
    w.frames(4);
    sim.check("still open after reopening", shows(sim, "Add account"));
    sim.check("what was typed is still there", shows(sim, "Half typ"));
}

// The account menu offers "Make active" only where it would do something.
fn scenarioStoreActivateRenameIcon(sim: mut Sim) {
    let f = threeAccounts(sim);
    sim.check("activate b", s().activateAccount("b"));
    sim.checkStr("b active", activeId(), "b");
    sim.check("activate the active one is fine", s().activateAccount("b"));
    sim.check("unknown refused", !s().activateAccount("zzz"));
    sim.check("rename refused without a name", !s().renameAccount("b", "   "));
    sim.check("rename", s().renameAccount("b", "  Bee  "));
    sim.checkStr("name trimmed, others kept", readOr(f"{f.synced()}/accounts.json", ""),
        "{\"accounts\":[{\"id\":\"a\",\"name\":\"A\"},{\"id\":\"b\",\"name\":\"Bee\"},{\"id\":\"c\",\"name\":\"C\"}]}");
    let blue = f"{f.repo}/blue.png";
    fs.writeBinary(blue, solidPng(64, 64, 0 as u8, 0 as u8, 255 as u8));
    s().requestIconFor("c");
    sim.answer = blue;
    s().picked(claude_account_switcher_ui.PickKind.Icon, blue);
    let icon = s().iconOf("c");
    sim.check("c's icon replaced", icon ? true : false);
    if let img = icon {
        sim.check("now blue", img.pixels[2 + 4 * (32 * 64 + 32)] > 200 && img.pixels[4 * (32 * 64 + 32)] < 50);
    }
    sim.check("the add form's icon untouched", !rx.get(s().pickedIcon));
    checkConsistent(sim, f, "after activate, rename, icon");
}

// ── Claude Code's settings ───────────────────────────────────────────

fn scenarioClaudeSettings(sim: mut Sim) {
    let dir = freshDir(sim.scenario);
    let path = f"{dir}/settings.json";
    let cmd = claude_account_switcher_ui.helperCommand("C:\\Program Files\\x\\switcher.exe");
    sim.checkStr("the command quotes the full path", cmd, "\"C:\\Program Files\\x\\switcher.exe\" --print-token");

    let applied = claude_account_switcher_ui.applyClaudeSettings(path, cmd);
    sim.check("a missing file is written", applied ? (applied as bool) : false);
    let made = json.parseToJsonNode(readOr(path, "{}"));
    sim.check("it holds the helper and the interval", readOr(path, "").contains("apiKeyHelper") && readOr(path, "").contains("CLAUDE_CODE_API_KEY_HELPER_TTL_MS"));

    let again = claude_account_switcher_ui.applyClaudeSettings(path, cmd);
    sim.check("unchanged: not written again", again ? !(again as bool) : false);

    fs.writeText(path, "{\"model\": \"opus\", \"permissions\": {\"allow\": [\"Bash(ls)\"]}, \"env\": {\"FOO\": \"1\"}, \"apiKeyHelper\": \"old\"}");
    claude_account_switcher_ui.applyClaudeSettings(path, cmd);
    let text = readOr(path, "");
    sim.check("other entries kept", text.contains("\"model\"") && text.contains("opus") && text.contains("Bash(ls)") && text.contains("FOO"));
    sim.check("old helper replaced", !text.contains("\"old\"") && text.contains("--print-token"));

    claude_account_switcher_ui.applyClaudeSettings(path, none);
    let off = readOr(path, "");
    sim.check("off: helper and interval gone", !off.contains("apiKeyHelper") && !off.contains("CLAUDE_CODE_API_KEY_HELPER_TTL_MS"));
    sim.check("off: the user's env stays", off.contains("FOO") && off.contains("Bash(ls)"));

    fs.writeText(path, "{\"env\": {\"CLAUDE_CODE_API_KEY_HELPER_TTL_MS\": \"1000\"}, \"apiKeyHelper\": \"x\", \"theme\": \"dark\"}");
    claude_account_switcher_ui.applyClaudeSettings(path, none);
    let emptied = readOr(path, "");
    sim.check("an env that only held the interval goes", !emptied.contains("\"env\"") && emptied.contains("theme"));

    fs.writeText(path, "{\"env\": {}}");
    claude_account_switcher_ui.applyClaudeSettings(path, none);
    sim.check("an env that was empty already stays", readOr(path, "").contains("\"env\""));

    let broken: []str = ["{", "[1]", "{\"env\": 3}", "\"text\""];
    for content in broken {
        fs.writeText(path, content);
        let refused = claude_account_switcher_ui.applyClaudeSettings(path, cmd);
        sim.check(f"refuses {content}", refused ? false : true);
        sim.checkStr(f"{content} untouched", readOr(path, "<missing>"), content);
    }
}

// Opening the window reads the files again: what a pull changed shows.
fn scenarioWindowReloadsOnOpen(sim: mut Sim) {
    let f = threeAccounts(sim);
    let activation = rx.reactive<int>(0);
    let w = openWindow(sim, activation);
    fs.writeText(f"{f.synced()}/accounts.json", "{\"accounts\":[{\"id\":\"c\",\"name\":\"C\"},{\"id\":\"x\",\"name\":\"Pulled\"}]}");
    activation := rx.get(activation) + 1;
    w.frames(4);
    sim.check("pulled account shows", shows(sim, "Pulled"));
    sim.check("removed one gone", !shows(sim, "A"));
    sim.checkStr("active moved to c", activeId(), "c");
}

fn main(): int {
    let args = sys.args();
    let only = args.length >= 2 ? args[1] : "";
    let sim = Sim {};
    let run = (name: str, body: (s: mut Sim) => none): none => {
        if only.length > 0 && only != name { return; }
        sim.scenario = name;
        sim.answer = "";
        body(sim);
    };
    run("first-start", (s: mut Sim) => { scenarioFirstStart(s); });
    run("unreadable-settings", (s: mut Sim) => { scenarioUnreadableSettings(s); });
    run("add-first-becomes-active", (s: mut Sim) => { scenarioAddFirstBecomesActive(s); });
    run("add-refused", (s: mut Sim) => { scenarioAddRefused(s); });
    run("switch-cycles", (s: mut Sim) => { scenarioSwitchCycles(s); });
    run("switch-single-and-none", (s: mut Sim) => { scenarioSwitchSingleAndNone(s); });
    run("replace-active-token", (s: mut Sim) => { scenarioReplaceActiveToken(s); });
    run("synced-from-elsewhere", (s: mut Sim) => { scenarioSyncedFromElsewhere(s); });
    run("remove", (s: mut Sim) => { scenarioRemove(s); });
    run("removed-elsewhere", (s: mut Sim) => { scenarioRemovedElsewhere(s); });
    run("bad-accounts-file", (s: mut Sim) => { scenarioBadAccountsFile(s); });
    run("accounts-file-missing", (s: mut Sim) => { scenarioAccountsFileMissing(s); });
    run("empty-list-pulled", (s: mut Sim) => { scenarioEmptyListPulled(s); });
    run("active-token-restored", (s: mut Sim) => { scenarioActiveTokenRestored(s); });
    run("bad-token-file", (s: mut Sim) => { scenarioBadTokenFile(s); });
    run("switch-while-read", (s: mut Sim) => { scenarioSwitchWhileRead(s); });
    run("reserved-names", (s: mut Sim) => { scenarioReservedNames(s); });
    run("window-shows-switch-failure", (s: mut Sim) => { scenarioWindowShowsSwitchFailure(s); });
    run("slugs", (s: mut Sim) => { scenarioSlugs(s); });
    run("resize", (s: mut Sim) => { scenarioResize(s); });
    run("window-first-start", (s: mut Sim) => { scenarioWindowFirstStart(s); });
    run("window-token-missing", (s: mut Sim) => { scenarioWindowTokenMissing(s); });
    run("window-remove-asks", (s: mut Sim) => { scenarioWindowRemoveAsks(s); });
    run("window-reloads-on-open", (s: mut Sim) => { scenarioWindowReloadsOnOpen(s); });
    run("window-row-click-activates", (s: mut Sim) => { scenarioWindowRowClickActivates(s); });
    run("window-menu-edits", (s: mut Sim) => { scenarioWindowMenuEdits(s); });
    run("window-keeps-state", (s: mut Sim) => { scenarioWindowKeepsState(s); });
    run("store-activate-rename-icon", (s: mut Sim) => { scenarioStoreActivateRenameIcon(s); });
    run("claude-settings", (s: mut Sim) => { scenarioClaudeSettings(s); });
    run("claude-settings-exact-keys", (s: mut Sim) => { scenarioClaudeSettingsExactKeys(s); });
    run("window-menu-moves", (s: mut Sim) => { scenarioWindowMenuMoves(s); });
    run("icon-pick-while-open", (s: mut Sim) => { scenarioIconPickWhileOpen(s); });
    run("window-row-keeps-its-draft", (s: mut Sim) => { scenarioWindowRowKeepsItsDraft(s); });
    run("window-escape-order", (s: mut Sim) => { scenarioWindowEscapeOrder(s); });
    run("window-rename-ends-on-click-outside", (s: mut Sim) => { scenarioWindowRenameEndsOnClickOutside(s); });
    run("window-menu-button-is-not-a-row-click", (s: mut Sim) => { scenarioWindowMenuButtonIsNotARowClick(s); });
    run("window-menu-covers-rows", (s: mut Sim) => { scenarioWindowMenuCoversRows(s); });
    fmt.println(f"{sim.checks - sim.failures}/{sim.checks} checks passed");
    return sim.failures;
}
