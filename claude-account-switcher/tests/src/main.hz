import claude_account_switcher_ui
import image
import ui_components
import ui_elements
import ui_layout

// The switcher's store against scratch folders (a machine folder and a profile
// repo of its own for every scenario), and its window driven headlessly: the
// real UIContext and Clay layout with a fixed-advance text measure, synthetic
// pointer and key input. Nothing here knows where the real files live.
//
// What is checked is what a user or Claude Code could see: the files on disk
// (above all active.token, the one Claude Code reads), what the store lists,
// and what the window draws.
//
// Run:  __haze__/claude_account_switcher_tests/bin/claude_account_switcher_tests [scenario]
// Without a scenario it runs all of them; the exit code is the failure count.

const WIDTH = 380;
const HEIGHT = 420;
const CHAR = 8.0;
const STEP = 0.016;

const TOKEN_A = "sk-ant-oat01-aaaaaaaaaaaaaaaaaaaa";
const TOKEN_B = "sk-ant-oat01-bbbbbbbbbbbbbbbbbbbb";
const TOKEN_C = "sk-ant-oat01-cccccccccccccccccccc";

ref struct TextDraw {
    text: str;
    x: real;
    y: real;
    w: real;
    h: real;
}

ref struct Sim {
    mouse: Vec2 = { x: -100.0, y: -100.0 };
    leftHeld: bool = false;
    pointerEdges: []ui_components.PointerEdge = [];
    keyEdges: []ui_components.KeyEdge = [];
    texts: []str = [];
    now: real = 1.0;
    pass: int = 0;
    textDraws: []TextDraw = [];
    drawingTexts: []TextDraw = [];
    // What the store asked the host to pick, and what the test answers.
    picks: []claude_account_switcher_ui.PickKind = [];
    pickBusy: bool = false;
    answer: str = "";
    checks: int = 0;
    failures: int = 0;
    scenario: str = "";

    mut fn check(name: str, ok: bool) {
        this.checks = this.checks + 1;
        if !ok {
            this.failures = this.failures + 1;
            fmt.println(f"FAIL [{this.scenario}] {name}");
        }
    }

    mut fn checkStr(name: str, actual: str, expected: str) {
        this.checks = this.checks + 1;
        if actual != expected {
            this.failures = this.failures + 1;
            fmt.println(f"FAIL [{this.scenario}] {name}\n  expected '{expected}'\n  got      '{actual}'");
        }
    }
}

// ── Fixtures ─────────────────────────────────────────────────────────

// A folder of its own for every scenario, created here so the next call
// cannot pick it again.
fn freshDir(name: str): str {
    let base = "/tmp";
    if let t = env.get("TMPDIR") { base = t; }
    if let t = env.get("TEMP") { base = t; }
    for (let i = 0; i < 100000; i++) {
        let dir = f"{base}/cas-tests-{name}-{i}";
        if let present = fs.exists(dir) {
            if !present {
                fs.createDirectory(dir);
                return dir;
            }
        }
    }
    sys.panic("no free fixture directory");
}

ref struct Fixture {
    state: str;
    repo: str;
    // An icon file to pick: 100x50, opaque red.
    iconFile: str;
    // A file that is no image.
    notImage: str;

    fn synced(): str { return f"{this.repo}/claude-account-switcher"; }
}

fn solidPng(width: int, height: int, r: u8, g: u8, b: u8): Bytes {
    let px = ByteBuffer(width * height * 4);
    for (let i = 0; i < width * height; i++) {
        px.push(r);
        px.push(g);
        px.push(b);
        px.push(255 as u8);
    }
    px.commit();
    let png = image.encodePng(image.Image.fromPixels(width, height, 4, px.bytes()));
    if !png { sys.panic("fixture PNG"); }
    let out: Bytes = png;
    return out;
}

fn newFixture(sim: mut Sim): Fixture {
    let root = freshDir(sim.scenario);
    let f = Fixture {
        state: f"{root}/state",
        repo: f"{root}/profile",
        iconFile: f"{root}/icon.png",
        notImage: f"{root}/notes.txt",
    };
    fs.createDirectory(f.repo);
    fs.writeBinary(f.iconFile, solidPng(100, 50, 255 as u8, 0 as u8, 0 as u8));
    fs.writeText(f.notImage, "not an image");
    return f;
}

fn open(sim: mut Sim, f: Fixture): bool {
    // Like the host's: refused while one is open (pickBusy); otherwise
    // answered at once with `answer` (none when it is empty, a cancel).
    let opened = claude_account_switcher_ui.openSwitcher(f.state, (kind: claude_account_switcher_ui.PickKind): bool => {
        if sim.pickBusy { return false; }
        sim.picks.push(kind);
        let answer = sim.answer;
        let path: str | none = none;
        if answer.length > 0 { path = answer; }
        claude_account_switcher_ui.switcher().picked(kind, path);
        return true;
    });
    if opened { return true; }
    return false;
}

fn s(): mut claude_account_switcher_ui.Switcher {
    return claude_account_switcher_ui.switcher();
}

fn readOr(path: str, missing: str): str {
    let text = fs.readText(path);
    if text {
        let value: str = text;
        return value;
    }
    return missing;
}

fn exists(path: str): bool {
    if let present = fs.exists(path) {
        return present;
    }
    return false;
}

fn activeId(): str {
    if let id = rx.get(s().active) { return id; }
    return "<none>";
}

fn ids(): str {
    let out = "";
    for account in s().list() {
        if out.length > 0 { out = out + ","; }
        out = out + account.id + (account.hasToken ? "+" : "-");
    }
    return out;
}

// A fixture with the profile repo chosen and three accounts, a b c, each
// with a token; `a` is active.
fn threeAccounts(sim: mut Sim): Fixture {
    let f = newFixture(sim);
    open(sim, f);
    s().setProfileRepo(f.repo);
    s().addAccount("A", f.iconFile, TOKEN_A);
    s().addAccount("B", f.iconFile, TOKEN_B);
    s().addAccount("C", f.iconFile, TOKEN_C);
    return f;
}

// ── First start and the profile repo ─────────────────────────────────

fn scenarioFirstStart(sim: mut Sim) {
    let f = newFixture(sim);
    sim.check("opens without settings", open(sim, f));
    sim.check("no profile repo yet", !s().hasProfileRepo());
    sim.check("nothing written at start", !exists(f"{f.state}/settings.json"));

    sim.check("a missing folder is refused", !s().setProfileRepo(f"{f.repo}/nope"));
    sim.check("refusal is shown", s().hasProblem());
    sim.check("refused folder not saved", !exists(f"{f.state}/settings.json"));
    sim.check("an empty path is refused", !s().setProfileRepo("   "));

    sim.check("an existing folder is taken", s().setProfileRepo(f.repo + "/"));
    sim.check("problem cleared", !s().hasProblem());
    sim.checkStr("settings file", readOr(f"{f.state}/settings.json", "<missing>"),
        json.stringify(claude_account_switcher_ui.SettingsFile { profileRepo: f.repo, active: none }));
    sim.checkStr("no accounts", ids(), "");
    sim.check("synced folder only made with the first account", !exists(f.synced()));

    // Opened again, it remembers.
    open(sim, f);
    sim.check("profile repo remembered", s().hasProfileRepo());
}

fn scenarioUnreadableSettings(sim: mut Sim) {
    let f = newFixture(sim);
    fs.createDirectory(f.state);
    let path = f"{f.state}/settings.json";
    let shapes: []str = ["{", "{}", "{\"active\":null}", "[1,2]", "{\"profileRepo\":3,\"active\":null}"];
    for content in shapes {
        fs.writeText(path, content);
        sim.check(f"refuses settings {content}", !open(sim, f));
        sim.checkStr(f"settings {content} untouched", readOr(path, "<missing>"), content);
    }
}

// ── Adding ───────────────────────────────────────────────────────────

fn scenarioAddFirstBecomesActive(sim: mut Sim) {
    let f = newFixture(sim);
    open(sim, f);
    s().setProfileRepo(f.repo);
    sim.check("added", s().addAccount("  Personal Max  ", f.iconFile, "  " + TOKEN_A + "\r\n"));
    sim.checkStr("listed", ids(), "personal-max+");
    sim.checkStr("name trimmed", s().list()[0].name, "Personal Max");
    sim.checkStr("accounts.json", readOr(f"{f.synced()}/accounts.json", "<missing>"),
        "{\"accounts\":[{\"id\":\"personal-max\",\"name\":\"Personal Max\"}]}");
    sim.checkStr("token stored trimmed", readOr(f"{f.state}/tokens/personal-max.token", "<missing>"), TOKEN_A);
    sim.checkStr("active.token is exactly the token", readOr(f"{f.state}/active.token", "<missing>"), TOKEN_A);
    sim.checkStr("active", activeId(), "personal-max");
    sim.check("token not in the repo", !readOr(f"{f.synced()}/accounts.json", "").contains("sk-ant"));

    let png = fs.readBinary(f"{f.synced()}/icons/personal-max.png");
    sim.check("icon stored", png ? true : false);
    if png {
        let decoded = image.decode(png, 4);
        sim.check("icon decodes", decoded ? true : false);
        if decoded {
            let icon: image.Image = decoded;
            sim.check("icon is 64x64", icon.width == 64 && icon.height == 64);
            // 100x50 fits as 64x32, centred: rows 0..15 transparent, 16..47 red.
            let at = (y: int, x: int): int => (y * 64 + x) * 4;
            sim.check("top row transparent", icon.pixels[at(0, 32) + 3] == 0);
            sim.check("bottom row transparent", icon.pixels[at(63, 32) + 3] == 0);
            sim.check("middle opaque red", icon.pixels[at(32, 32) + 3] == 255 && icon.pixels[at(32, 32)] > 200 && icon.pixels[at(32, 32) + 2] < 50);
            sim.check("first image row opaque", icon.pixels[at(16, 32) + 3] > 200);
            sim.check("row above it transparent", icon.pixels[at(15, 32) + 3] < 50);
        }
    }

    sim.check("second added", s().addAccount("Personal Max", f.iconFile, TOKEN_B));
    sim.checkStr("same name gets its own id", ids(), "personal-max+,personal-max-2+");
    sim.checkStr("first stays active", activeId(), "personal-max");
    sim.checkStr("active.token unchanged", readOr(f"{f.state}/active.token", "<missing>"), TOKEN_A);
}

fn scenarioAddRefused(sim: mut Sim) {
    let f = newFixture(sim);
    open(sim, f);
    sim.check("refused before a profile repo", !s().addAccount("A", f.iconFile, TOKEN_A));
    s().setProfileRepo(f.repo);
    let cases: []str = ["no name", "no token", "not a token", "token with space", "no icon", "icon not an image", "icon missing"];
    sim.check(cases[0], !s().addAccount("  ", f.iconFile, TOKEN_A));
    sim.check(cases[1], !s().addAccount("A", f.iconFile, "   "));
    sim.check(cases[2], !s().addAccount("A", f.iconFile, "hello"));
    sim.check(cases[3], !s().addAccount("A", f.iconFile, "sk-ant-oat01 abc"));
    sim.check(cases[4], !s().addAccount("A", "", TOKEN_A));
    sim.check(cases[5], !s().addAccount("A", f.notImage, TOKEN_A));
    sim.check(cases[6], !s().addAccount("A", f"{f.repo}/gone.png", TOKEN_A));
    sim.check("each refusal is shown", s().hasProblem());
    sim.check("nothing synced", !exists(f.synced()));
    sim.check("no token written", !exists(f"{f.state}/tokens"));
    sim.check("nothing active", !exists(f"{f.state}/active.token"));
}

// ── Switching ────────────────────────────────────────────────────────

fn scenarioSwitchCycles(sim: mut Sim) {
    let f = threeAccounts(sim);
    sim.checkStr("a active", activeId(), "a");
    sim.check("switch", s().switchToNext());
    sim.checkStr("then b", activeId(), "b");
    sim.checkStr("b's token is active", readOr(f"{f.state}/active.token", ""), TOKEN_B);
    s().switchToNext();
    sim.checkStr("then c", activeId(), "c");
    s().switchToNext();
    sim.checkStr("wraps to a", activeId(), "a");
    sim.checkStr("a's token is active", readOr(f"{f.state}/active.token", ""), TOKEN_A);
    sim.checkStr("remembered", readOr(f"{f.state}/settings.json", ""),
        json.stringify(claude_account_switcher_ui.SettingsFile { profileRepo: f.repo, active: "a" }));

    // b without a token on this machine (as after a pull): skipped.
    fs.removeFile(f"{f.state}/tokens/b.token");
    sim.check("switch skipping b", s().switchToNext());
    sim.checkStr("skips b", activeId(), "c");
    sim.checkStr("listed without token", ids(), "a+,b-,c+");
    s().switchToNext();
    sim.checkStr("back to a", activeId(), "a");
}

fn scenarioSwitchSingleAndNone(sim: mut Sim) {
    let f = newFixture(sim);
    open(sim, f);
    s().setProfileRepo(f.repo);
    sim.check("nothing to switch to", !s().switchToNext());
    s().addAccount("Only", f.iconFile, TOKEN_A);
    sim.check("single account switches to itself", s().switchToNext());
    sim.checkStr("still only", activeId(), "only");
    sim.checkStr("its token", readOr(f"{f.state}/active.token", ""), TOKEN_A);
}

// ── Tokens ───────────────────────────────────────────────────────────

fn scenarioReplaceActiveToken(sim: mut Sim) {
    let f = threeAccounts(sim);
    sim.check("replaced", s().setToken("a", TOKEN_C));
    sim.checkStr("token file", readOr(f"{f.state}/tokens/a.token", ""), TOKEN_C);
    sim.checkStr("active.token follows", readOr(f"{f.state}/active.token", ""), TOKEN_C);
    sim.check("inactive replaced", s().setToken("b", TOKEN_A));
    sim.checkStr("active.token not touched", readOr(f"{f.state}/active.token", ""), TOKEN_C);
    sim.check("bad token refused", !s().setToken("b", "nope"));
    sim.checkStr("old one kept", readOr(f"{f.state}/tokens/b.token", ""), TOKEN_A);
    sim.check("unknown account refused", !s().setToken("zzz", TOKEN_A));
    sim.check("no token file for it", !exists(f"{f.state}/tokens/zzz.token"));
}

// Another machine added accounts; this one pulled the repo but has no token.
fn scenarioSyncedFromElsewhere(sim: mut Sim) {
    let f = newFixture(sim);
    open(sim, f);
    s().setProfileRepo(f.repo);
    fs.createDirectory(f"{f.synced()}/icons");
    fs.writeText(f"{f.synced()}/accounts.json", "{\"accounts\":[{\"id\":\"work\",\"name\":\"Work\"},{\"id\":\"home\",\"name\":\"Home\"}]}");
    fs.writeBinary(f"{f.synced()}/icons/work.png", solidPng(64, 64, 0 as u8, 0 as u8, 255 as u8));
    sim.check("reloads", s().reload());
    sim.checkStr("listed, no tokens", ids(), "work-,home-");
    sim.checkStr("nothing active", activeId(), "<none>");
    sim.check("no active.token", !exists(f"{f.state}/active.token"));
    sim.check("work has its icon", s().iconOf("work") ? true : false);
    sim.check("home has none", s().iconOf("home") ? false : true);
    sim.check("switch has nothing", !s().switchToNext());

    sim.check("token entered", s().setToken("home", TOKEN_B));
    sim.checkStr("home now active", activeId(), "home");
    sim.checkStr("its token", readOr(f"{f.state}/active.token", ""), TOKEN_B);
    sim.checkStr("accounts.json untouched by a token", readOr(f"{f.synced()}/accounts.json", ""),
        "{\"accounts\":[{\"id\":\"work\",\"name\":\"Work\"},{\"id\":\"home\",\"name\":\"Home\"}]}");
}

// ── Removing ─────────────────────────────────────────────────────────

fn scenarioRemove(sim: mut Sim) {
    let f = threeAccounts(sim);
    sim.check("remove inactive", s().removeAccount("b"));
    sim.checkStr("b gone", ids(), "a+,c+");
    sim.check("b's icon gone", !exists(f"{f.synced()}/icons/b.png"));
    sim.check("b's token gone", !exists(f"{f.state}/tokens/b.token"));
    sim.checkStr("a still active", activeId(), "a");

    sim.check("remove active", s().removeAccount("a"));
    sim.checkStr("c takes over", activeId(), "c");
    sim.checkStr("c's token active", readOr(f"{f.state}/active.token", ""), TOKEN_C);

    sim.check("remove last", s().removeAccount("c"));
    sim.checkStr("none active", activeId(), "<none>");
    sim.check("active.token removed", !exists(f"{f.state}/active.token"));
    sim.checkStr("empty list saved", readOr(f"{f.synced()}/accounts.json", ""), "{\"accounts\":[]}");
}

// The active account was removed on another machine, and this one pulled.
fn scenarioRemovedElsewhere(sim: mut Sim) {
    let f = threeAccounts(sim);
    fs.writeText(f"{f.synced()}/accounts.json", "{\"accounts\":[{\"id\":\"b\",\"name\":\"B\"},{\"id\":\"c\",\"name\":\"C\"}]}");
    sim.check("reloads", s().reload());
    sim.checkStr("a gone", ids(), "b+,c+");
    sim.checkStr("b takes over", activeId(), "b");
    sim.checkStr("b's token active", readOr(f"{f.state}/active.token", ""), TOKEN_B);
    sim.check("a's orphan token removed", !exists(f"{f.state}/tokens/a.token"));
}

// ── Files that cannot be used are never written ─────────────────────

fn scenarioBadAccountsFile(sim: mut Sim) {
    let f = threeAccounts(sim);
    let path = f"{f.synced()}/accounts.json";
    let shapes: []str = [
        "{",
        "{}",
        "{\"accounts\":[{\"id\":\"a\"}]}",
        "{\"accounts\":[{\"id\":\"../../evil\",\"name\":\"E\"}]}",
        "{\"accounts\":[{\"id\":\"A\",\"name\":\"Upper\"}]}",
        "{\"accounts\":[{\"id\":\"a\",\"name\":\"A\"},{\"id\":\"a\",\"name\":\"Again\"}]}",
        "{\"accounts\":[{\"id\":\"a\",\"name\":\"  \"}]}",
    ];
    for content in shapes {
        fs.writeText(path, content);
        sim.check(f"reload refuses {content}", !s().reload());
        sim.check(f"shown: {content}", s().hasProblem());
        sim.checkStr(f"nothing listed: {content}", ids(), "");
        sim.check(f"add refused: {content}", !s().addAccount("D", f.iconFile, TOKEN_A));
        sim.check(f"switch refused: {content}", !s().switchToNext());
        sim.checkStr(f"file untouched: {content}", readOr(path, "<missing>"), content);
        sim.check(f"tokens kept: {content}", exists(f"{f.state}/tokens/a.token") && exists(f"{f.state}/tokens/c.token"));
        sim.checkStr(f"active.token kept: {content}", readOr(f"{f.state}/active.token", ""), TOKEN_A);
    }
    sim.check("no file escaped the folders", !exists(f"{f.repo}/../evil.png"));
}

// ── Found by the review (2026-11-04) ─────────────────────────────────

// active.token is the active account's token, or absent while none is: the
// invariant every operation must leave behind.
fn checkConsistent(sim: mut Sim, f: Fixture, name: str) {
    let active = readOr(f"{f.state}/active.token", "<missing>");
    if let id = rx.get(s().active) {
        sim.checkStr(f"{name}: active.token is {id}'s token", active, readOr(f"{f.state}/tokens/{id}.token", "<no token file>"));
        let settings = readOr(f"{f.state}/settings.json", "");
        sim.check(f"{name}: settings name {id}", settings.contains(f"\"active\":\"{id}\""));
    } else {
        sim.checkStr(f"{name}: no active.token while none is active", active, "<missing>");
    }
}

// The profile repo folder without accounts.json (moved, a wrong folder, a
// branch without it) while this machine has tokens: nothing is deleted.
fn scenarioAccountsFileMissing(sim: mut Sim) {
    let f = threeAccounts(sim);
    let path = f"{f.synced()}/accounts.json";
    fs.removeFile(path);
    sim.check("reload refuses", !s().reload());
    sim.check("shown", s().hasProblem());
    sim.check("tokens kept", exists(f"{f.state}/tokens/a.token") && exists(f"{f.state}/tokens/b.token") && exists(f"{f.state}/tokens/c.token"));
    sim.checkStr("active.token kept", readOr(f"{f.state}/active.token", "<missing>"), TOKEN_A);
    sim.check("switch refused", !s().switchToNext());
    sim.checkStr("still a's token", readOr(f"{f.state}/active.token", "<missing>"), TOKEN_A);
    sim.check("add refused", !s().addAccount("D", f.iconFile, TOKEN_A));
    sim.check("no accounts.json made", !exists(path));

    // Another existing folder chosen by mistake: the same.
    let other = f"{f.repo}/elsewhere";
    fs.createDirectory(other);
    s().setProfileRepo(other);
    sim.check("wrong folder: tokens kept", exists(f"{f.state}/tokens/a.token"));
    sim.checkStr("wrong folder: active.token kept", readOr(f"{f.state}/active.token", "<missing>"), TOKEN_A);
}

// An empty list pulled from another machine removes every account there, so
// here too: their tokens go, and nothing is active.
fn scenarioEmptyListPulled(sim: mut Sim) {
    let f = threeAccounts(sim);
    fs.writeText(f"{f.synced()}/accounts.json", "{\"accounts\":[]}");
    sim.check("reloads", s().reload());
    sim.checkStr("none listed", ids(), "");
    sim.check("tokens removed", !exists(f"{f.state}/tokens/a.token") && !exists(f"{f.state}/tokens/c.token"));
    checkConsistent(sim, f, "after empty list");
}

// active.token missing or holding another token (deleted by hand, a crash, a
// settings save that failed after it was written): the next reload restores
// it from the active account's token.
fn scenarioActiveTokenRestored(sim: mut Sim) {
    let f = threeAccounts(sim);
    fs.removeFile(f"{f.state}/active.token");
    s().reload();
    checkConsistent(sim, f, "after delete");
    fs.writeText(f"{f.state}/active.token", TOKEN_C);
    s().reload();
    checkConsistent(sim, f, "after foreign token");
    // Opened again from disk (a restart), too.
    fs.writeText(f"{f.state}/active.token", TOKEN_B);
    open(sim, f);
    checkConsistent(sim, f, "after restart");
    sim.checkStr("still a", activeId(), "a");
    s().switchToNext();
    checkConsistent(sim, f, "after switch");
    s().setToken("b", TOKEN_C);
    checkConsistent(sim, f, "after new token");
    s().removeAccount("b");
    checkConsistent(sim, f, "after remove");
}

// A token file that is no token (edited by hand, cut short): never copied
// into active.token, and the failure is shown.
fn scenarioBadTokenFile(sim: mut Sim) {
    let f = threeAccounts(sim);
    fs.writeText(f"{f.state}/tokens/b.token", "garbage");
    sim.check("switch to b fails", !s().switchToNext());
    sim.check("shown", s().hasProblem());
    sim.checkStr("a stays", activeId(), "a");
    sim.checkStr("a's token stays", readOr(f"{f.state}/active.token", "<missing>"), TOKEN_A);
    checkConsistent(sim, f, "after failed switch");
}

// A switch while something reads active.token (Claude Code's credential
// command does, many times a minute): the replacement is never refused, and
// the reader goes on reading what it opened.
fn scenarioSwitchWhileRead(sim: mut Sim) {
    let f = threeAccounts(sim);
    let opened = fs.openRead(f"{f.state}/active.token");
    if opened is fs.Error {
        sim.check("reader opened", false);
        return;
    }
    let reader: mut fs.FileReader = opened;
    sim.check("switch while read", s().switchToNext());
    sim.checkStr("switched", activeId(), "b");
    sim.checkStr("new token in place", readOr(f"{f.state}/active.token", "<missing>"), TOKEN_B);
    while !reader.done() {
        reader.readSome(4096);
    }
    sim.checkStr("reader saw the old token", reader.text(), TOKEN_A);
    // And a read that is still open while the file is replaced twice.
    let again = fs.openRead(f"{f.state}/active.token");
    if again is fs.Error {
        sim.check("second reader opened", false);
        return;
    }
    let held: mut fs.FileReader = again;
    sim.check("second switch while read", s().switchToNext());
    sim.check("third switch while read", s().switchToNext());
    held.close();
    sim.checkStr("back to a", activeId(), "a");
    checkConsistent(sim, f, "after switches while read");
}

// Names Windows keeps for devices: tokens/nul.token is not a file there.
fn scenarioReservedNames(sim: mut Sim) {
    let f = newFixture(sim);
    open(sim, f);
    s().setProfileRepo(f.repo);
    s().addAccount("Nul", f.iconFile, TOKEN_A);
    s().addAccount("CON", f.iconFile, TOKEN_B);
    s().addAccount("com1", f.iconFile, TOKEN_C);
    sim.checkStr("reserved names get another id", ids(), "nul-2+,con-2+,com1-2+");
    fs.writeText(f"{f.synced()}/accounts.json", "{\"accounts\":[{\"id\":\"aux\",\"name\":\"Aux\"}]}");
    sim.check("a reserved id from elsewhere is refused", !s().reload());
}

// A failed switch, then the window opens: the reason is still there.
fn scenarioWindowShowsSwitchFailure(sim: mut Sim) {
    let f = threeAccounts(sim);
    let activation = rx.reactive<int>(0);
    let w = openWindow(sim, activation);
    fs.writeText(f"{f.state}/tokens/b.token", "garbage");
    s().switchToNext();
    activation := rx.get(activation) + 1;
    w.frames(4);
    sim.check("problem still shown", s().hasProblem());
    sim.check("problem drawn", findTextStarting(sim, "The token of b") ? true : false);
}

fn findTextStarting(sim: mut Sim, prefix: str): TextDraw | none {
    for d in sim.textDraws {
        if d.text.startsWith(prefix) {
            return d;
        }
    }
    return none;
}

// ── Found by the second review (2026-11-04) ─────────────────────────

fn countOf(text: str, needle: str): int {
    return text.split(needle).length - 1;
}

// JSON keys are exact: an "Env" of the user's is not Claude Code's "env",
// and nothing piles up however often the state is written.
fn scenarioClaudeSettingsExactKeys(sim: mut Sim) {
    let dir = freshDir(sim.scenario);
    let path = f"{dir}/settings.json";
    let cmd = claude_account_switcher_ui.helperCommand("C:\\x\\switcher.exe");
    fs.writeText(path, "{\"Env\": {\"KEEP\": \"1\"}, \"ApiKeyHelper\": \"theirs\"}");
    claude_account_switcher_ui.applyClaudeSettings(path, cmd);
    claude_account_switcher_ui.applyClaudeSettings(path, none);
    claude_account_switcher_ui.applyClaudeSettings(path, cmd);
    let on = readOr(path, "");
    sim.check("one interval", countOf(on, "CLAUDE_CODE_API_KEY_HELPER_TTL_MS") == 1);
    sim.check("one helper", countOf(on, "--print-token") == 1);
    sim.check("in an exact \"env\"", on.contains("\"env\""));
    sim.check("the user's Env and ApiKeyHelper untouched", on.contains("\"Env\"") && on.contains("KEEP") && on.contains("theirs"));
    claude_account_switcher_ui.applyClaudeSettings(path, none);
    let off = readOr(path, "");
    sim.check("off: no interval left anywhere", countOf(off, "CLAUDE_CODE_API_KEY_HELPER_TTL_MS") == 0 && countOf(off, "--print-token") == 0);
    sim.check("off: theirs still there", off.contains("KEEP") && off.contains("theirs"));

    fs.writeText(path, "{\"env\": {\"FOO\": \"1\"}}");
    claude_account_switcher_ui.applyClaudeSettings(path, cmd);
    claude_account_switcher_ui.applyClaudeSettings(path, none);
    claude_account_switcher_ui.applyClaudeSettings(path, cmd);
    claude_account_switcher_ui.applyClaudeSettings(path, cmd);
    sim.check("with the user's env: one interval after on, off, on, on", countOf(readOr(path, ""), "CLAUDE_CODE_API_KEY_HELPER_TTL_MS") == 1);

    let twice = "{\"env\": {}, \"env\": {}}";
    fs.writeText(path, twice);
    let refused = claude_account_switcher_ui.applyClaudeSettings(path, cmd);
    sim.check("two \"env\" are refused", refused ? false : true);
    sim.checkStr("and left as they are", readOr(path, ""), twice);
}

// A right click on another row while a menu is open moves the menu there.
fn scenarioWindowMenuMoves(sim: mut Sim) {
    let f = threeAccounts(sim);
    let activation = rx.reactive<int>(0);
    let w = openWindow(sim, activation);
    // The menu opens below the pointer: the second right click goes to a
    // row above it, which the menu does not cover.
    w.rightClick(centerOf(sim, "C"));
    w.rightClick(centerOf(sim, "A"));
    sim.check("menu open again", shows(sim, "Rename"));
    w.click(centerOf(sim, "Rename"));
    w.type("Aye");
    w.key(ui_components.Key.Return);
    sim.checkStr("the menu was A's", readOr(f"{f.synced()}/accounts.json", ""),
        "{\"accounts\":[{\"id\":\"a\",\"name\":\"Aye\"},{\"id\":\"b\",\"name\":\"B\"},{\"id\":\"c\",\"name\":\"C\"}]}");
}

// "Change icon" while another picker is open: the answer that comes is the
// open picker's, and goes where that one was for.
fn scenarioIconPickWhileOpen(sim: mut Sim) {
    let f = threeAccounts(sim);
    let blue = f"{f.repo}/blue.png";
    fs.writeBinary(blue, solidPng(64, 64, 0 as u8, 0 as u8, 255 as u8));
    sim.pickBusy = true;
    s().requestIconFor("c");
    s().picked(claude_account_switcher_ui.PickKind.Icon, blue);
    sim.pickBusy = false;
    sim.check("the add form got it", rx.get(s().pickedIcon) ? true : false);
    if let icon = s().iconOf("c") {
        sim.check("c's icon unchanged (still red)", icon.pixels[4 * (32 * 64 + 32)] > 200);
    }
}

// A row keeps what is typed into it when another row goes.
fn scenarioWindowRowKeepsItsDraft(sim: mut Sim) {
    let f = threeAccounts(sim);
    let activation = rx.reactive<int>(0);
    let w = openWindow(sim, activation);
    w.rightClick(centerOf(sim, "C"));
    w.click(centerOf(sim, "Replace token"));
    w.type("sk-ant-oat01-half");
    s().removeAccount("b");
    w.frames(4);
    sim.check("the half token is still in C's box", shows(sim, "sk-ant-oat01-half"));
    w.type("done");
    w.key(ui_components.Key.Return);
    sim.checkStr("and saved to C", readOr(f"{f.state}/tokens/c.token", ""), "sk-ant-oat01-halfdone");
    sim.checkStr("a untouched", readOr(f"{f.state}/tokens/a.token", ""), TOKEN_A);
}

// Esc first undoes what is open in the window (menu, a row's edit), and the
// menu does not survive closing the window.
fn scenarioWindowEscapeOrder(sim: mut Sim) {
    let f = threeAccounts(sim);
    let activation = rx.reactive<int>(0);
    let w = openWindow(sim, activation);
    w.rightClick(centerOf(sim, "B"));
    w.click(centerOf(sim, "Remove"));
    sim.check("asks", shows(sim, "Remove"));
    w.key(ui_components.Key.Escape);
    sim.check("Esc cancels the question", !shows(sim, "Remove"));
    sim.checkStr("nothing removed", ids(), "a+,b+,c+");
    w.rightClick(centerOf(sim, "B"));
    sim.check("menu open", shows(sim, "Rename"));
    activation := rx.get(activation) + 1;
    w.frames(4);
    sim.check("closing and opening the window closes the menu", !shows(sim, "Rename"));
}

// A click anywhere else ends a rename and keeps what was typed (Esc is what
// throws it away).
fn scenarioWindowRenameEndsOnClickOutside(sim: mut Sim) {
    let f = threeAccounts(sim);
    let activation = rx.reactive<int>(0);
    let w = openWindow(sim, activation);
    w.rightClick(centerOf(sim, "B"));
    w.click(centerOf(sim, "Rename"));
    w.type("Zed");
    w.click(Vec2((WIDTH as real) / 2.0, (HEIGHT as real) - 40.0));
    sim.check("the box is gone", shows(sim, "Zed") && !shows(sim, "B"));
    sim.checkStr("and the name kept", readOr(f"{f.synced()}/accounts.json", ""),
        "{\"accounts\":[{\"id\":\"a\",\"name\":\"A\"},{\"id\":\"b\",\"name\":\"Zed\"},{\"id\":\"c\",\"name\":\"C\"}]}");
    sim.checkStr("nothing else happened", activeId(), "a");

    w.rightClick(centerOf(sim, "C"));
    w.click(centerOf(sim, "Rename"));
    w.type("Nope");
    w.key(ui_components.Key.Escape);
    sim.check("Esc throws it away", shows(sim, "C") && !shows(sim, "Nope"));
    sim.check("and stores nothing", !readOr(f"{f.synced()}/accounts.json", "").contains("Nope"));
}

// The row's menu button is the button's, not a click on the row: it opens
// the menu and does not make the account active.
fn scenarioWindowMenuButtonIsNotARowClick(sim: mut Sim) {
    let f = threeAccounts(sim);
    let activation = rx.reactive<int>(0);
    let w = openWindow(sim, activation);
    let row = centerOf(sim, "B");
    w.hover(row);
    // Its icon: the drawn glyph on B's line, right of the name.
    let button = Vec2(-100.0, -100.0);
    for d in sim.textDraws {
        if d.x > (WIDTH as real) - 60.0 && d.y < row.y + 8.0 && d.y + d.h > row.y - 8.0 {
            button = Vec2(d.x + d.w / 2.0, d.y + d.h / 2.0);
        }
    }
    sim.check("the button shows on hover", button.x > 0.0);
    w.click(button);
    sim.checkStr("b not made active", activeId(), "a");
    sim.check("the menu opened", shows(sim, "Rename"));
}

// The open menu covers what is under it: the pointer on the menu hovers no
// row beneath it (whose hover shows its menu button).
fn scenarioWindowMenuCoversRows(sim: mut Sim) {
    let f = threeAccounts(sim);
    let activation = rx.reactive<int>(0);
    let w = openWindow(sim, activation);
    let rowC = centerOf(sim, "C");
    // Opened on A, the menu hangs down over B's and C's rows.
    w.rightClick(centerOf(sim, "A"));
    sim.check("menu open", shows(sim, "Rename"));
    let onMenu = Vec2(centerOf(sim, "Change icon").x, rowC.y);
    w.hover(onMenu);
    let buttonOnC = false;
    for d in sim.textDraws {
        if d.x > (WIDTH as real) - 60.0 && d.y < rowC.y + 8.0 && d.y + d.h > rowC.y - 8.0 {
            buttonOnC = true;
        }
    }
    sim.check("the row under the menu is not hovered", !buttonOnC);
    // Off the menu again, a row does hover.
    w.hover(Vec2((WIDTH as real) - 30.0, rowC.y));
    sim.check("menu still open", shows(sim, "Rename"));
}

