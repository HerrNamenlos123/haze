import unicode

// For this entire module, the convention is that
// "lineIndex" and "lineNumber"
// are both used, whereas "lineIndex" is the 0-based array index,
// while "lineNumber" is the user-facing, 1-based line number.
//
// === Architecture =============================================
//
// This module is the *editing engine*. It owns text mutation, selections,
// motions, undo and modes. It owns no keybindings and no editing model:
// it does not know what "w" means, whether there are modes at all, or
// whether "d" waits for another key. That lives in a *behavior* (see
// `Behavior` below) -- e.g. the optional `vim_behavior` module, or the
// built-in `DefaultBehavior` that reproduces ordinary desktop textbox
// semantics.
//
// The engine is deliberately free of any rendering concern. It never
// draws and never measures; it exposes queries (selectionRangeForLine,
// cursorPosition, mode, scrollRequest, ...) that a host renders however
// it likes.
//
// === What a "column" is =======================================
//
// A column (the `.x` of every Vec2i here, every `startCol`/`endCol`, every
// `getLineLength` result) is a BYTE OFFSET into the line, because that is
// what `str.length` and every slicing operation in Haze mean. The engine
// does not maintain a second index space in characters -- one index space
// is the whole reason the offsets it hands to the host, to the LSP layer
// and to `replaceRange` all agree without conversion.
//
// The invariant on top of that is:
//
//     every column the engine stores or returns sits on a grapheme
//     cluster boundary (UAX #29).
//
// So a column is a byte offset, but not just any byte offset: it is always
// a legal place for a caret to be. Moving right by "one character" adds 1
// byte for 'a', 3 for a decomposed 'e'+accent, 8 for a flag emoji and 25
// for a family emoji. `_moveTo` is the single chokepoint that enforces
// this: anything arriving there is snapped to a boundary, so no motion,
// click, restored cursor or sticky column can ever leave the caret inside
// a codepoint where the next edit would corrupt the buffer.
//
// Consequently `getLineLength` is a BYTE length, and the maximum column on
// a line in an on-a-character mode is the offset of the LAST CLUSTER, not
// `length - 1` (which would be the last byte, i.e. the middle of a
// multi-byte character).
//
// Quantities that are genuinely not byte offsets are named so they cannot
// be confused with one -- see `characterColumn()` and `displayColumn()`.

// === Modes ====================================================
//
// The engine knows *that* modes exist and what each one means for the
// two things the engine itself must decide -- how the caret clamps, and
// whether a selection tracks the caret -- but nothing about which keys
// switch between them. A behavior with no modes simply stays in Insert
// forever (the default), which is exactly a normal textbox.
export enum Mode {
    // Caret sits BETWEEN characters, max column == line length.
    // This is normal textbox behavior and the default.
    Insert,
    // Caret sits ON a character, max column == line length - 1.
    Normal,
    // Like Normal for clamping, but a selection is anchored and tracks
    // the caret. Characterwise.
    Visual,
    // Visual, but the selection always covers whole lines.
    VisualLine,
    // Visual, but the selection covers a rectangle.
    VisualBlock,
    // Caret sits ON a character and the document is immutable.
    ReadOnly,
}

// True when the caret sits ON a character rather than between them, i.e.
// the maximum legal column is lineLength-1 rather than lineLength. This
// single predicate is the only place the Vim/textbox caret distinction
// is encoded in the engine.
//
// Visual modes are deliberately NOT included: vim lets the caret sit one
// past the last character while selecting (verified: `vj` onto a
// one-character line reports column 1, while a plain `j` reports 0), so
// that a selection can cover the final character.
export fn modeClampsToLastChar(mode: Mode): bool {
    return mode == Mode.Normal || mode == Mode.ReadOnly;
}

export fn modeIsVisual(mode: Mode): bool {
    return mode == Mode.Visual || mode == Mode.VisualLine || mode == Mode.VisualBlock;
}

// === Ranges ===================================================

// How a range of text is to be interpreted by an operation. Vim's
// "motion kind", but it is a genuinely general concept: any editor that
// can delete "these lines" as opposed to "this text" needs it.
export enum RangeKind {
    // Exactly from start to end, end exclusive.
    Characterwise,
    // Whole lines from start.y to end.y inclusive, including the
    // trailing newline.
    Linewise,
    // Rectangle between the two columns on each line in the row span.
    Blockwise,
}

// A normalized (start before end) region of the document plus how it
// should be interpreted. This is what every editing operation consumes,
// and what every motion/text-object produces.
export struct Range {
    start: Vec2i = {};
    end: Vec2i = {};
    kind: RangeKind = RangeKind.Characterwise;
}

// A half-open column range on a single line, as selected. Returned by
// Context.selectionRangeForLine() so a host can render one highlight rect
// per visual line without having to re-derive the per-line clamping of a
// possibly multi-line selection itself.
//
// `includesLineEnd` marks a line whose selection extends past its last
// character -- i.e. the newline itself is selected, which is always true
// for the interior of a linewise selection. On an EMPTY line that makes
// startCol == endCol == 0, so a host that sizes its highlight purely from
// the column span would draw nothing at all; vim instead shows a narrow
// block there. The engine cannot pick that width (it has no idea what a
// pixel is), so it reports the fact and lets the host render it.
export struct LineSelectionRange {
    startCol: int;
    endCol: int;
    includesLineEnd: bool = false;
}

// What the engine wants the viewport to do. The engine cannot scroll --
// it has no idea how tall the viewport is -- so instead it records an
// intent that the host applies when it renders. This is how Vim's `zz`
// (center the cursor) reaches the UI without the engine knowing what a
// pixel is.
export enum ScrollIntent {
    None,
    // Ensure the cursor line is visible, minimal movement.
    Reveal,
    // Put the cursor line in the vertical middle of the viewport.
    Center,
    // Put the cursor line at the top / bottom of the viewport.
    Top,
    Bottom,
}

// === Registers ================================================

// Yanked/deleted text plus how it was taken, because pasting linewise
// text must open a new line while pasting characterwise text must not.
export struct RegisterContent {
    text: String;
    kind: RangeKind = RangeKind.Characterwise;

    fn constructor() {
        return RegisterContent { text: String("") };
    }
}

// === Behavior interface =======================================
//
// A behavior translates raw input into engine calls. The engine owns a
// single optional behavior and routes input to it; if there is none, the
// engine applies `DefaultBehavior`-style handling itself.
//
// Every field is a callback so a behavior can be assembled from plain
// closures without the language needing interfaces/vtables. A behavior
// that does not care about a hook leaves it as `none`.
//
// `onKey` returns true if it consumed the key. `onTextInput` likewise:
// returning false lets the engine insert the text itself, which is what
// a behavior wants in Insert mode.
export type KeyHandler = (key: str) => bool;
export type TextHandler = (text: String) => bool;
export type VoidHandler = () => void;

export inline struct Behavior {
    // Raw key press. `key` is a normalized key name: a single character
    // for printable keys ("a", "$", " "), or a bracketed name for the
    // rest ("<Esc>", "<CR>", "<C-d>", "<M-Up>").
    onKey: KeyHandler | none = none;

    // Committed text (IME / paste / ordinary typing). Return true to
    // suppress the engine's own insertion.
    onTextInput: TextHandler | none = none;

    // Called after the engine has been constructed and wired, so a
    // behavior can push its initial mode.
    onAttach: VoidHandler | none = none;
}

export type ClipboardGetter = () => String;
export type ClipboardSetter = (text: String) => void;

export inline struct ContextArgs {
    // In Hertz
    cursorBlinkFrequency: real = 1;

    getLineLength: (lineIndex: int) => int;
    getLine: (lineIndex: int) => String;
    getLineCount: () => int;
    getTimeInSeconds: () => real;

    // The single mutation primitive the engine uses to edit the document.
    // Replaces everything between `start` and `end` (a normalized,
    // start-before-end position pair, as produced by every editing method
    // below) with `text`. Insertion is `start == end`; deletion is
    // `text == ""`; a plain typed character is a 1-char replace of a
    // collapsed range. `text` may contain "\n" (paste of multiple lines).
    //
    // Must apply synchronously: immediately after this call returns, the
    // engine calls `getLine`/`getLineLength`/`getLineCount` again and
    // expects them to reflect the edit. The host owns how (or whether) it
    // schedules any reactive re-render around that -- the engine only
    // needs the *data* to be current.
    replaceRange: (start: Vec2i, end: Vec2i, text: String) => void;

    // Optional OS clipboard bridge. When absent, the engine's internal
    // register is used for everything (fine for a self-contained app);
    // when present, a behavior can opt into routing the unnamed register
    // through the system clipboard, which is what Vim's
    // `set clipboard=unnamedplus` does.
    getClipboard: ClipboardGetter | none = none;
    setClipboard: ClipboardSetter | none = none;

    // Starting mode. A plain textbox leaves this at Insert.
    initialMode: Mode = Mode.Insert;
}

export struct Context {
    args: ContextArgs;

    cursorVisible: rx.Computed<bool>;
    _cursorLastMovedAt: real;

    // The active editing mode. See Mode. The engine only uses this to
    // decide caret clamping and selection tracking; behaviors own the
    // transitions.
    mode: rx.Reactive<Mode>;

    // The cursor is BETWEEN characters in Insert mode and ON a character
    // in Normal/Visual modes (see modeClampsToLastChar).
    // cursorPos.x is the column, where
    // cursorPos.x = 0 -> left of first character
    // cursorPos.x = 1 -> right of first, left of second character
    // cursorPos.x = lineLength -> right of last character (Insert only)
    // The y position refers to actual lineINDICES, starting at 0 for the first line.
    //
    // cursorPosition is where the cursor is actually rendered/edits happen.
    // _desiredCursorPosition.x is the "sticky column": the x an Up/Down move is
    // trying to reach, remembered across shorter lines so that arrowing down
    // through short lines and back onto a long one restores the original
    // column, like every mainstream text editor. It is only updated by
    // horizontal movement (left/right/word/home/end), never by up/down.
    //
    // It is a BYTE OFFSET like every other column, which means that carrying
    // it to another line can land it inside a character -- byte 8 may be a
    // boundary on one line and the middle of an emoji on the next. _moveTo
    // snaps it, so the sticky column is stored raw (preserving the user's
    // intended reach across short lines) and only ever *applied* aligned.
    _desiredCursorPosition: Vec2i = {};
    cursorPosition: rx.Reactive<Vec2i>;

    // none => no selection, cursorPosition is just a caret.
    // Otherwise the selection spans from this anchor to the (active)
    // cursorPosition, in whichever order the user dragged/shift-moved it.
    selectionAnchor: rx.Reactive<Vec2i | none>;
    hasSelection: rx.Computed<bool>;
    selectionStart: rx.Computed<Vec2i>;
    selectionEnd: rx.Computed<Vec2i>;

    // Internal yank/paste register. Not wired to the OS clipboard by
    // default -- that's a host-level concern (platform clipboard API) --
    // but `useSystemClipboard` routes it through args.get/setClipboard,
    // which is how Vim's clipboard=unnamedplus is implemented.
    _register: RegisterContent;
    useSystemClipboard: bool = false;

    // What the engine would like the viewport to do next. The host reads
    // and clears this. See ScrollIntent.
    scrollIntent: rx.Reactive<ScrollIntent>;

    // Optional input behavior (Vim, Helix, ...). none => the engine
    // applies default textbox handling to input itself.
    behavior: Behavior | none = none;

    // --- Undo ---------------------------------------------------
    // Undo stores whole-document snapshots. That is O(document) per
    // step rather than O(edit), which is the wrong complexity for a
    // 100k-line file but is completely invisible for the sizes this
    // engine actually sees, and it makes undo correct by construction
    // for every possible edit (including multi-line replaces and
    // future multi-cursor edits) instead of correct-per-operation.
    // Swapping in a piece table later requires no interface change:
    // nothing outside these three methods touches the stacks.
    _undoStack: []UndoEntry = [];
    _redoStack: []UndoEntry = [];
    _txDepth: int = 0;
    // The undo entry being accumulated by the transaction in progress.
    // `_txOpen` says whether anything has actually been edited yet, so a
    // transaction that changes nothing leaves no undo step behind.
    _txEntry: UndoEntry = {};
    _txOpen: bool = false;
    _txCursorBefore: Vec2i = {};
    // Depth of an "undo group": everything typed between
    // beginUndoGroup()/endUndoGroup() collapses into ONE undo step, even
    // though each keystroke is its own transaction. Vim works the same
    // way -- a whole insert session (`ihello<Esc>`) undoes at once, not
    // one character at a time.
    _undoGroupDepth: int = 0;

    fn constructor(args: ContextArgs): mut Context {
        let context = Context {
            args: args,
            cursorVisible: rx.computed(() => false),
            _cursorLastMovedAt: args.getTimeInSeconds(),
            mode: rx.reactive<Mode>(args.initialMode),
            cursorPosition: rx.reactive(Vec2i(0, 0)),
            selectionAnchor: rx.reactive<Vec2i | none>(none),
            hasSelection: rx.computed(() => false),
            selectionStart: rx.computed((): Vec2i => ({ x: 0, y: 0 })),
            selectionEnd: rx.computed((): Vec2i => ({ x: 0, y: 0 })),
            _register: RegisterContent(),
            scrollIntent: rx.reactive<ScrollIntent>(ScrollIntent.None),
        };

        context.cursorVisible = rx.computed(() => {
            let now = context.args.getTimeInSeconds();
            let elapsed = now - context._cursorLastMovedAt;
            let blinkInterval = 1.0 / context.args.cursorBlinkFrequency;
            return math.modulo(elapsed, blinkInterval) <= blinkInterval / 2.0;
        });

        // In visual modes the selection always exists (it is anchored at
        // the point visual mode started), even when it is one character
        // wide and anchor == cursor. Outside visual modes a zero-width
        // selection is no selection at all, matching a plain textbox.
        context.hasSelection = rx.computed(() => {
            let anchor = rx.get(context.selectionAnchor);
            if !anchor {
                return false;
            }
            if modeIsVisual(rx.get(context.mode)) {
                return true;
            }
            return anchor.x != context.cursorPosition.x || anchor.y != context.cursorPosition.y;
        });

        context.selectionStart = rx.computed((): Vec2i => {
            let anchor = rx.get(context.selectionAnchor);
            let cx = context.cursorPosition.x;
            let cy = context.cursorPosition.y;
            if !anchor {
                return { x: cx, y: cy };
            }
            if anchor.y < cy || (anchor.y == cy && anchor.x < cx) {
                return { x: anchor.x, y: anchor.y };
            }
            return { x: cx, y: cy };
        });

        context.selectionEnd = rx.computed((): Vec2i => {
            let anchor = rx.get(context.selectionAnchor);
            let cx = context.cursorPosition.x;
            let cy = context.cursorPosition.y;
            if !anchor {
                return { x: cx, y: cy };
            }
            if anchor.y < cy || (anchor.y == cy && anchor.x < cx) {
                return { x: cx, y: cy };
            }
            return { x: anchor.x, y: anchor.y };
        });

        return context;
    }

    // Install an input behavior (Vim, Helix, ...). Returns the context so
    // wiring can be chained at the call site.
    // Detach the current behavior, returning the engine to its built-in
    // textbox handling. The document, the caret and the undo history are
    // untouched -- switching editing models mid-session keeps your place.
    mut fn clearBehavior() {
        this.behavior = none;
    }

    mut fn setBehavior(behavior: Behavior) {
        this.behavior = behavior;
        let attach = behavior.onAttach;
        if attach {
            attach();
        }
    }

    // === Input entry points =======================================
    //
    // A host funnels all raw input through these two. They delegate to
    // the behavior if there is one and fall back to plain textbox
    // handling otherwise, so a host never has to branch on "is there a
    // Vim attached".

    mut fn handleTextInput(text: String) {
        let b = this.behavior;
        if b {
            let handler = b.onTextInput;
            if handler {
                if handler(text) {
                    return;
                }
            }
        }
        if this.mode == Mode.ReadOnly {
            return;
        }
        this.insertText(text);
    }

    // Returns true if the key was consumed by a behavior.
    mut fn handleKey(key: str): bool {
        let b = this.behavior;
        if b {
            let handler = b.onKey;
            if handler {
                return handler(key);
            }
        }
        return false;
    }

    // === Mode =====================================================

    mut fn setMode(mode: Mode) {
        let previous = rx.get(this.mode);
        if previous == mode {
            return;
        }
        this.mode := mode;

        if modeIsVisual(mode) {
            // Entering a visual mode anchors the selection at the caret
            // if nothing is anchored yet.
            if !this.selectionAnchor {
                this.selectionAnchor := this._cursorPos();
            }
        } else if !modeIsVisual(mode) && modeIsVisual(previous) {
            this.selectionAnchor := none;
        }

        // Leaving Insert for an on-a-character mode can strand the caret
        // one past the end of the line; re-clamp through _moveTo.
        this._moveTo(this._cursorPos(), false, this.selectionAnchor ? true : false);
    }

    mut fn requestScroll(intent: ScrollIntent) {
        this.scrollIntent := intent;
    }

    // Host calls this once it has applied the intent.
    mut fn clearScrollRequest() {
        this.scrollIntent := ScrollIntent.None;
    }

    // === Movement ================================================
    //
    // Every move function is a thin wrapper around a pure "_target*"
    // function (computes where the motion goes, without side effects) and
    // _moveTo (applies it: clamps, updates the sticky column, and grows or
    // collapses the selection). Keeping the target computation pure means
    // the same motion can be reused to move the caret, to extend a
    // selection (`extend: true`, i.e. Shift held), and to compute the
    // range an operator (Vim's d/y/c) or a click-drag should act on --
    // without three divergent copies of word/line-boundary logic.
    //
    // The `target*` variants are public precisely so a behavior can ask
    // "where would this motion land?" and turn the answer into an
    // operator range instead of a cursor move.

    mut fn moveCursorRight(extend: bool = false) {
        let pos = this._cursorPos();
        this._moveTo(this._targetRight(pos), true, extend);
    }

    mut fn moveCursorLeft(extend: bool = false) {
        let pos = this._cursorPos();
        this._moveTo(this._targetLeft(pos), true, extend);
    }

    mut fn moveCursorUp(extend: bool = false) {
        let pos = this._cursorPos();
        this._moveTo(this._targetUp(pos), false, extend);
    }

    mut fn moveCursorDown(extend: bool = false) {
        let pos = this._cursorPos();
        this._moveTo(this._targetDown(pos), false, extend);
    }

    // Ctrl+Left in every mainstream editor: jump to the start of the previous
    // word, crossing to the end of the previous line if already at column 0.
    mut fn moveCursorWordLeft(extend: bool = false) {
        let pos = this._cursorPos();
        this._moveTo(this._targetWordLeft(pos), true, extend);
    }

    // Ctrl+Right: jump to the start of the next word, crossing to the start
    // of the next line if already at the end of the current one.
    mut fn moveCursorWordRight(extend: bool = false) {
        let pos = this._cursorPos();
        this._moveTo(this._targetWordRight(pos), true, extend);
    }

    // Home / End: start / end of the current line.
    mut fn moveCursorHome(extend: bool = false) {
        let pos = this._cursorPos();
        this._moveTo(this._targetHome(pos), true, extend);
    }

    mut fn moveCursorEnd(extend: bool = false) {
        let pos = this._cursorPos();
        this._moveTo(this._targetEnd(pos), true, extend);
    }

    // Ctrl+Home / Ctrl+End: start / end of the whole document.
    mut fn moveCursorDocumentStart(extend: bool = false) {
        this._moveTo(this._targetDocumentStart(), true, extend);
    }

    mut fn moveCursorDocumentEnd(extend: bool = false) {
        this._moveTo(this._targetDocumentEnd(), true, extend);
    }

    // Generic entry point for behaviors: place the caret anywhere,
    // clamped, optionally extending the selection. This is what a Vim
    // motion ultimately calls.
    mut fn moveTo(target: Vec2i, updateDesiredX: bool = true, extend: bool = false) {
        this._moveTo(target, updateDesiredX, extend);
    }

    // Ctrl+A.
    mut fn selectAll() {
        this.selectionAnchor := this._targetDocumentStart();
        this._moveTo(this._targetDocumentEnd(), true, true);
    }

    // Explicit selection control, for behaviors that own their own
    // selection lifecycle (visual modes, click-drag).
    mut fn setSelectionAnchor(anchor: Vec2i) {
        this.selectionAnchor := anchor;
    }

    mut fn clearSelection() {
        this.selectionAnchor := none;
    }

    fn anchorPosition(): Vec2i | none {
        let a = rx.get(this.selectionAnchor);
        if !a {
            return none;
        }
        let result: Vec2i = { x: a.x, y: a.y };
        return result;
    }

    // Swap caret and anchor, keeping the same span. Vim's `o` in visual
    // mode; also what a host wants when a drag crosses its origin.
    mut fn swapSelectionEnds() {
        let anchor = rx.get(this.selectionAnchor);
        if !anchor {
            return;
        }
        let oldAnchor: Vec2i = { x: anchor.x, y: anchor.y };
        let cursor = this._cursorPos();
        this.selectionAnchor := cursor;
        this._moveTo(oldAnchor, true, true);
    }

    // === Editing ==================================================

    // Anything that produces committed text: regular typing (one
    // TextInputEvent chunk at a time), and paste. If there's a selection it
    // is replaced; otherwise `text` is inserted at the caret. The caret ends
    // up right after the inserted text either way.
    mut fn insertText(text: String) {
        if this.mode == Mode.ReadOnly {
            return;
        }
        this.beginTransaction();
        let insertAt: Vec2i = this._cursorPos();
        if this.hasSelection {
            let start = this._selStart();
            let end = this._selEnd();
            insertAt = start;
            this._applyReplace(start, end, String(""));
            this.selectionAnchor := none;
        }
        this._applyReplace(insertAt, insertAt, text);

        let parts = text.cloneString().split("\n");
        let target: Vec2i = {};
        if parts.length <= 1 {
            target = { x: insertAt.x + text.length(), y: insertAt.y };
        } else {
            target = { x: parts[parts.length - 1].length, y: insertAt.y + parts.length - 1 };
        }
        this._moveTo(target, true, false);
        this.endTransaction();
    }

    // Enter/Return.
    mut fn insertNewline() {
        this.insertText(String("\n"));
    }

    // Backspace. `wholeWord: true` (Ctrl+Backspace) deletes back to the
    // start of the previous word instead of a single character -- but only
    // when there's no selection, matching Chrome/VS Code: with a selection,
    // plain Backspace already deletes exactly the selection regardless of
    // modifiers.
    mut fn deleteBackward(wholeWord: bool = false) {
        if this.mode == Mode.ReadOnly {
            return;
        }
        if this.hasSelection {
            this._deleteSelection();
            return;
        }
        let pos = this._cursorPos();
        if pos.x == 0 && pos.y == 0 {
            return;
        }
        let deleteFrom = wholeWord ? this._targetWordLeft(pos) : this._targetLeft(pos);
        this.beginTransaction();
        this._applyReplace(deleteFrom, pos, String(""));
        this._moveTo(deleteFrom, true, false);
        this.endTransaction();
    }

    // Delete. `wholeWord: true` (Ctrl+Delete) deletes forward to the start
    // of the next word; same selection caveat as deleteBackward.
    mut fn deleteForward(wholeWord: bool = false) {
        if this.mode == Mode.ReadOnly {
            return;
        }
        if this.hasSelection {
            this._deleteSelection();
            return;
        }
        let pos = this._cursorPos();
        let lastLine = this.args.getLineCount() - 1;
        if pos.x == this.args.getLineLength(pos.y) && pos.y == lastLine {
            return;
        }
        // Deliberately NOT _targetRight: that motion clamps to maxColumn, so
        // in an on-a-character mode it would refuse to move past the last
        // character and Delete would erase nothing there. Deletion wants the
        // next character boundary itself, or the start of the following line
        // when the caret is already at the end.
        let deleteTo: Vec2i = {};
        if wholeWord {
            deleteTo = this._targetWordRight(pos);
        } else if pos.x >= this.args.getLineLength(pos.y) {
            // At end of line: swallow the newline and join the next line.
            deleteTo = { x: 0, y: pos.y + 1 };
        } else {
            deleteTo = {
                x: unicode.nextClusterOffset(this._lineText(pos.y), pos.x),
                y: pos.y,
            };
        }
        this.beginTransaction();
        this._applyReplace(pos, deleteTo, String(""));
        this._moveTo(pos, true, false);
        this.endTransaction();
    }

    // === Range-based editing (what behaviors/operators use) =======
    //
    // These are the primitives a Vim operator is built from. They take an
    // explicit Range so the *behavior* decides what to act on and the
    // engine only performs it.

    fn textInRange(range: Range): String {
        let normalized = this.normalizeRange(range);
        if normalized.kind == RangeKind.Linewise {
            return this._getLinewiseText(normalized.start.y, normalized.end.y);
        }
        if normalized.kind == RangeKind.Blockwise {
            return this._getBlockwiseText(range);
        }
        return this._getTextInRange(normalized.start, normalized.end);
    }

    // The column span of a blockwise range. normalizeRange only orders
    // the two corners top-to-bottom; for a rectangle the LEFT column is
    // the smaller of the two x's regardless of which corner it came
    // from (dragging up-and-left is still a rectangle).
    fn _blockColumns(range: Range): Vec2i {
        let left = range.start.x < range.end.x ? range.start.x : range.end.x;
        let right = range.start.x < range.end.x ? range.end.x : range.start.x;
        let cols: Vec2i = { x: left, y: right };
        return cols;
    }

    // One line per row of the rectangle, each clamped to that row's
    // length -- a short line inside the block contributes what it has.
    fn _getBlockwiseText(range: Range): String {
        let normalized = this.normalizeRange(range);
        let cols = this._blockColumns(range);
        let result = "";
        for (let y = normalized.start.y; y <= normalized.end.y; y++) {
            if y > normalized.start.y {
                result = f"{result}\n";
            }
            let lineLen = this.args.getLineLength(y);
            // The block's right column is INCLUSIVE, so the slice ends at
            // the start of the NEXT character on this line -- not the next
            // byte, which would split a multi-byte character. The boundary
            // is resolved per line because the same byte column can be a
            // character start on one row and mid-character on another.
            let sliceStart = this._snapColumn(y, clamp<int>(cols.x, 0, lineLen));
            let sliceEnd = clamp<int>(this.nextColumn(y, clamp<int>(cols.y, 0, lineLen)), 0, lineLen);
            if sliceEnd > sliceStart {
                result = f"{result}{this.args.getLine(y).cloneString().slice(sliceStart, sliceEnd)}";
            }
        }
        return String(result);
    }

    // Delete a range and place the caret where Vim would leave it.
    mut fn deleteRange(range: Range, keepColumn: int = -1) {
        if this.mode == Mode.ReadOnly {
            return;
        }
        let normalized = this.normalizeRange(range);
        this.beginTransaction();
        if normalized.kind == RangeKind.Linewise {
            this._deleteLines(normalized.start.y, normalized.end.y, keepColumn);
        } else if normalized.kind == RangeKind.Blockwise {
            this._deleteBlock(range);
        } else {
            this._applyReplace(normalized.start, normalized.end, String(""));
            this._moveTo(normalized.start, true, false);
        }
        this.endTransaction();
    }

    // Cut the rectangle out of each row, leaving the rows themselves in
    // place. Rows are edited BOTTOM-UP so that each replaceRange call
    // cannot shift the line indices of the rows still to be edited.
    mut fn _deleteBlock(range: Range) {
        let normalized = this.normalizeRange(range);
        let cols = this._blockColumns(range);
        for (let y = normalized.end.y; y >= normalized.start.y; y--) {
            let lineLen = this.args.getLineLength(y);
            // Inclusive right column -> exclusive end at the next CHARACTER
            // boundary on this line, so a block edge never cuts a
            // multi-byte character in half. See _getBlockwiseText.
            let cutStart = this._snapColumn(y, clamp<int>(cols.x, 0, lineLen));
            let cutEnd = clamp<int>(this.nextColumn(y, clamp<int>(cols.y, 0, lineLen)), 0, lineLen);
            if cutEnd > cutStart {
                let a: Vec2i = { x: cutStart, y: y };
                let b: Vec2i = { x: cutEnd, y: y };
                this._applyReplace(a, b, String(""));
            }
        }
        // The caret lands on the block's top-left corner.
        let landing: Vec2i = { x: cols.x, y: normalized.start.y };
        this._moveTo(landing, true, false);
    }

    mut fn replaceRangeWith(range: Range, text: String) {
        if this.mode == Mode.ReadOnly {
            return;
        }
        let normalized = this.normalizeRange(range);
        this.beginTransaction();
        if normalized.kind == RangeKind.Linewise {
            this._deleteLines(normalized.start.y, normalized.end.y);
            this._applyReplace(this._cursorPos(), this._cursorPos(), text);
        } else {
            this._applyReplace(normalized.start, normalized.end, text);
            this._moveTo(normalized.start, true, false);
        }
        this.endTransaction();
    }

    // Ensure start <= end, and expand a linewise range to full lines.
    fn normalizeRange(range: Range): Range {
        let start: Vec2i = { x: range.start.x, y: range.start.y };
        let end: Vec2i = { x: range.end.x, y: range.end.y };
        if end.y < start.y || (end.y == start.y && end.x < start.x) {
            let tmp: Vec2i = { x: start.x, y: start.y };
            start = { x: end.x, y: end.y };
            end = { x: tmp.x, y: tmp.y };
        }
        let result: Range = { start: start, end: end, kind: range.kind };
        return result;
    }

    // The range currently selected, as a Range the operators accept.
    // Visual mode is *inclusive* of the character under the caret, which
    // is the single most common source of off-by-one bugs when
    // reimplementing Vim, so it is centralized here.
    fn selectionAsRange(): Range {
        let start = this._selStart();
        let end = this._selEnd();
        let mode = rx.get(this.mode);

        if mode == Mode.VisualLine {
            let r: Range = { start: { x: 0, y: start.y }, end: { x: 0, y: end.y }, kind: RangeKind.Linewise };
            return r;
        }

        if mode == Mode.VisualBlock {
            // A blockwise range keeps BOTH corners inclusive: the
            // rectangle is defined by its corners, not by a half-open
            // run, and _blockColumns()/_getBlockwiseText() add the +1
            // themselves. Converting to exclusive here as well would
            // widen every block by one column.
            let r: Range = { start: start, end: end, kind: RangeKind.Blockwise };
            return r;
        }

        if modeIsVisual(mode) {
            // inclusive -> exclusive. The exclusive end is the start of the
            // NEXT character, not the next byte: the caret sits on a whole
            // grapheme cluster, so a visual selection covering an emoji has
            // to take all of its bytes or the yank/delete would cut it in
            // half and corrupt the buffer.
            let inclusiveEnd: Vec2i = {
                x: unicode.nextClusterOffset(this._lineText(end.y), end.x),
                y: end.y,
            };
            let r: Range = { start: start, end: inclusiveEnd, kind: RangeKind.Characterwise };
            return r;
        }

        let kind = RangeKind.Characterwise;
        let r: Range = { start: start, end: end, kind: kind };
        return r;
    }

    // === Registers / clipboard ====================================

    mut fn setRegister(text: String, kind: RangeKind) {
        this._register = RegisterContent { text: text, kind: kind };
        let setter = this.args.setClipboard;
        if this.useSystemClipboard && setter {
            setter(text);
        }
    }

    fn getRegister(): RegisterContent {
        let getter = this.args.getClipboard;
        if this.useSystemClipboard && getter {
            let external = getter();
            // The system clipboard has no notion of linewise-ness; Vim
            // infers it from a trailing newline, and so do we.
            let kind = external.cloneString().endsWith("\n") ? RangeKind.Linewise : RangeKind.Characterwise;
            let r: RegisterContent = { text: external, kind: kind };
            return r;
        }
        return this._register;
    }

    mut fn copy() {
        if !this.hasSelection {
            return;
        }
        let range = this.selectionAsRange();
        this.setRegister(this.textInRange(range), range.kind);
    }

    mut fn cut() {
        if !this.hasSelection {
            return;
        }
        let range = this.selectionAsRange();
        this.setRegister(this.textInRange(range), range.kind);
        this.deleteRange(range);
        this.selectionAnchor := none;
    }

    mut fn paste() {
        let reg = this.getRegister();
        if reg.text.length() == 0 {
            return;
        }
        this.insertText(reg.text);
    }

    // === Undo / transactions ======================================
    //
    // Everything between begin/endTransaction collapses into one undo
    // step, so a compound edit (delete selection + insert replacement,
    // or a Vim `cw`) undoes as a unit. Nested transactions join the
    // outermost one, which lets primitives call each other freely
    // without each one creating its own undo step.

    // Open an undo GROUP: nested transactions inside it all accumulate
    // into a single undo entry, which is only pushed when the group ends.
    // A behavior wraps an insert session in this so the whole session
    // undoes as a unit.
    mut fn beginUndoGroup() {
        if this._undoGroupDepth == 0 {
            this._txCursorBefore = this._cursorPos();
            this._txOpen = false;
        }
        this._undoGroupDepth = this._undoGroupDepth + 1;
    }

    mut fn endUndoGroup() {
        if this._undoGroupDepth == 0 {
            return;
        }
        this._undoGroupDepth = this._undoGroupDepth - 1;
        if this._undoGroupDepth > 0 {
            return;
        }
        if !this._txOpen {
            return;
        }
        this._txOpen = false;
        this._txEntry.cursorAfter = this._cursorPos();
        this._undoStack.push(this._txEntry);
        this._redoStack = [];
    }

    mut fn beginTransaction() {
        if this._txDepth == 0 && this._undoGroupDepth == 0 {
            this._txOpen = false;
            this._txCursorBefore = this._cursorPos();
        }
        this._txDepth = this._txDepth + 1;
    }

    mut fn endTransaction() {
        if this._txDepth == 0 {
            return;
        }
        this._txDepth = this._txDepth - 1;
        if this._txDepth > 0 {
            return;
        }
        // Inside an undo group the entry stays open until the group ends.
        if this._undoGroupDepth > 0 {
            return;
        }
        if !this._txOpen {
            // Nothing was edited -> no undo step.
            return;
        }
        this._txOpen = false;
        this._txEntry.cursorAfter = this._cursorPos();
        this._undoStack.push(this._txEntry);
        this._redoStack = [];
    }

    // Record what a pending edit is about to overwrite. Called by
    // _applyReplace BEFORE the host mutates anything, so the "before"
    // lines are still readable through getLine.
    //
    // Within one transaction the recorded range only ever GROWS: a
    // compound edit (delete selection, then insert) saves the union of
    // the lines it touched, which is exactly what neovim's u_save does
    // when several changes land in one undo block.
    mut fn _recordEdit(startLine: int, endLine: int, insertedLines: int) {
        if !this._txOpen {
            let saved: []str = [];
            for (let y = startLine; y <= endLine; y++) {
                saved.push(this.args.getLine(y).cloneString());
            }
            let before = this._txCursorBefore;
            let beforeY = clamp<int>(before.y, 0, this.args.getLineCount() - 1);
            let clampedBefore: Vec2i = {
                x: clamp<int>(before.x, 0, this.args.getLineLength(beforeY)),
                y: beforeY,
            };
            this._txEntry = UndoEntry {
                startLine: startLine,
                removedCount: endLine - startLine + 1,
                removedLines: saved,
                insertedCount: insertedLines,
                cursorBefore: clampedBefore,
            };
            this._txOpen = true;
            return;
        }

        // Extend an already-open entry to cover this edit too.
        let entry = this._txEntry;
        let coveredEnd = entry.startLine + entry.insertedCount - 1;
        if startLine < entry.startLine {
            let prefix: []str = [];
            for (let y = startLine; y < entry.startLine; y++) {
                prefix.push(this.args.getLine(y).cloneString());
            }
            for old in entry.removedLines {
                prefix.push(old);
            }
            entry.removedLines = prefix;
            entry.removedCount = entry.removedCount + (entry.startLine - startLine);
            entry.startLine = startLine;
        }
        if endLine > coveredEnd {
            for (let y = coveredEnd + 1; y <= endLine; y++) {
                entry.removedLines.push(this.args.getLine(y).cloneString());
                entry.removedCount = entry.removedCount + 1;
            }
        }
        let newCovered = endLine > coveredEnd ? endLine : coveredEnd;
        entry.insertedCount = newCovered - entry.startLine + 1
                              + (insertedLines - (endLine - startLine + 1));
        this._txEntry = entry;
    }

    // Record an undo step that changes nothing. Some commands are no-ops
    // on the text but still consume an undo step in vim (`x` on an empty
    // line); without this the undo stack drifts out of step.
    // Mark the in-progress undo entry as a whole-line replacement, so
    // undoing it lands the caret at column 0 (see UndoEntry.linewise).
    mut fn markUndoEntryLinewise() {
        if this._txOpen {
            this._txEntry.linewise = true;
            return;
        }
        // The transaction may already have been committed by the time the
        // behavior knows the edit was linewise; mark the entry it pushed.
        if this._undoStack.length > 0 {
            this._undoStack[this._undoStack.length - 1].linewise = true;
        }
    }

    mut fn pushEmptyUndoStep() {
        let pos = this._cursorPos();
        let entry = UndoEntry {
            startLine: pos.y,
            removedCount: 1,
            removedLines: [this.args.getLine(pos.y).cloneString()],
            insertedCount: 1,
            cursorBefore: pos,
            cursorAfter: pos,
        };
        this._undoStack.push(entry);
        this._redoStack = [];
    }

    mut fn undo() {
        if this._undoStack.length == 0 {
            return;
        }
        let entry = this._undoStack[this._undoStack.length - 1];
        this._undoStack.pop();
        this._redoStack.push(this._applyUndoEntry(entry));
        // Clamp against the line as it is AFTER the restore: a delete
        // that emptied the buffer leaves nowhere for a saved column to
        // land, and vim reports column 0 there.
        let landing: Vec2i = {
            x: entry.linewise ? 0 : entry.cursorBefore.x,
            y: entry.cursorBefore.y,
        };
        this._moveTo(landing, true, false);
        this.clampToLine();
    }

    mut fn redo() {
        if this._redoStack.length == 0 {
            return;
        }
        let entry = this._redoStack[this._redoStack.length - 1];
        this._redoStack.pop();
        this._undoStack.push(this._applyUndoEntry(entry));
        this._moveTo(entry.cursorAfter, true, false);
        this.clampToLine();
    }

    // Swap the lines currently occupying an entry's range for the ones it
    // saved, and return the inverse entry (what was just replaced), which
    // is what makes undo and redo the same operation in both directions.
    mut fn _applyUndoEntry(entry: UndoEntry): UndoEntry {
        let lineCount = this.args.getLineCount();
        let firstLine = clamp<int>(entry.startLine, 0, lineCount - 1);
        let lastLine = clamp<int>(entry.startLine + entry.insertedCount - 1, firstLine, lineCount - 1);

        let current: []str = [];
        for (let y = firstLine; y <= lastLine; y++) {
            current.push(this.args.getLine(y).cloneString());
        }

        let replacement = "";
        for line, i in entry.removedLines {
            if i > 0 {
                replacement = f"{replacement}\n";
            }
            replacement = f"{replacement}{line}";
        }

        let start: Vec2i = { x: 0, y: firstLine };
        let end: Vec2i = { x: this.args.getLineLength(lastLine), y: lastLine };
        this.args.replaceRange(start, end, String(replacement));

        let inverse = UndoEntry {
            startLine: firstLine,
            removedCount: current.length,
            removedLines: current,
            insertedCount: entry.removedLines.length,
            cursorBefore: entry.cursorAfter,
            cursorAfter: entry.cursorBefore,
        };
        return inverse;
    }

    // Re-clamp the caret after an undo/redo changed the line under it.
    //
    // The saved column is clamped against the line's length at the time
    // of the EDIT, not after the restore: a delete that emptied the line
    // leaves nowhere for column 3 to land, and vim reports column 0 --
    // so the clamp has to happen before the old text comes back.
    mut fn clampToLine() {
        let pos = this._cursorPos();
        let maxY = this.args.getLineCount() - 1;
        let y = clamp<int>(pos.y, 0, maxY);
        let x = clamp<int>(pos.x, 0, this.maxColumn(y));
        if x != pos.x || y != pos.y {
            let target: Vec2i = { x: x, y: y };
            this._moveTo(target, true, false);
        }
    }

    // === Selection queries, for rendering =========================

    // The selected column range on a given line, or none if that line
    // isn't touched by the selection at all. For lines strictly inside a
    // multi-line selection this spans the whole line; the first/last line
    // are clamped to where the selection actually starts/ends.
    fn selectionRangeForLine(lineIndex: int): LineSelectionRange | none {
        if !this.hasSelection {
            return none;
        }
        let mode = rx.get(this.mode);
        let start = this._selStart();
        let end = this._selEnd();
        if lineIndex < start.y || lineIndex > end.y {
            return none;
        }

        if mode == Mode.VisualLine {
            // Every line of a linewise selection includes its newline.
            let full: LineSelectionRange = {
                startCol: 0,
                endCol: this.args.getLineLength(lineIndex),
                includesLineEnd: true,
            };
            return full;
        }

        if mode == Mode.VisualBlock {
            let left = start.x < end.x ? start.x : end.x;
            let right = start.x < end.x ? end.x : start.x;
            let lineLen = this.args.getLineLength(lineIndex);
            // Inclusive right column -> exclusive end at the next CHARACTER
            // boundary on this line. See _getBlockwiseText.
            let block: LineSelectionRange = {
                startCol: this._snapColumn(lineIndex, clamp<int>(left, 0, lineLen)),
                endCol: clamp<int>(this.nextColumn(lineIndex, clamp<int>(right, 0, lineLen)), 0, lineLen),
            };
            return block;
        }

        let startCol = lineIndex == start.y ? start.x : 0;
        let endCol = lineIndex == end.y ? end.x : this.args.getLineLength(lineIndex);
        // Visual mode includes the character under the caret.
        if modeIsVisual(mode) && lineIndex == end.y {
            endCol = clamp<int>(endCol + 1, 0, this.args.getLineLength(lineIndex));
        }
        // Every line except the last one in a multi-line characterwise
        // selection runs through its newline.
        let result: LineSelectionRange = {
            startCol: startCol,
            endCol: endCol,
            includesLineEnd: lineIndex < end.y,
        };
        return result;
    }

    // === Public pure motions ======================================
    //
    // Behaviors compute destinations with these and then decide whether
    // to move the caret, extend the selection, or hand the span to an
    // operator. They never mutate.

    fn targetLeft(pos: Vec2i): Vec2i { return this._targetLeft(pos); }
    fn targetRight(pos: Vec2i): Vec2i { return this._targetRight(pos); }
    fn targetUp(pos: Vec2i): Vec2i { return this._targetUp(pos); }
    fn targetDown(pos: Vec2i): Vec2i { return this._targetDown(pos); }
    fn targetHome(pos: Vec2i): Vec2i { return this._targetHome(pos); }
    fn targetEnd(pos: Vec2i): Vec2i { return this._targetEnd(pos); }
    fn targetDocumentStart(): Vec2i { return this._targetDocumentStart(); }
    fn targetDocumentEnd(): Vec2i { return this._targetDocumentEnd(); }
    fn targetWordLeft(pos: Vec2i): Vec2i { return this._targetWordLeft(pos); }
    fn targetWordRight(pos: Vec2i): Vec2i { return this._targetWordRight(pos); }

    // First non-blank column of a line (Vim's ^, and where linewise
    // operations leave the caret).
    fn firstNonBlank(lineIndex: int): int {
        let len = this.args.getLineLength(lineIndex);
        if len == 0 {
            return 0;
        }
        // Leading whitespace is always ASCII in practice, but walk by
        // clusters anyway so the returned column is guaranteed to be a
        // legal caret position on any line.
        let line = this._lineText(lineIndex);
        let x = 0;
        while x < len && unicode.classifyAt(line, x) == unicode.CharClass.Whitespace {
            x = unicode.nextClusterOffset(line, x);
        }
        if x >= len {
            // An all-whitespace line: land on the last CHARACTER, which is
            // not `len - 1` when that character is multi-byte.
            return len > 0 ? unicode.previousClusterOffset(line, len) : 0;
        }
        return x;
    }

    // Character class at a BYTE OFFSET, exposed so a behavior can implement
    // its own word motions (Vim's w vs W) without duplicating the
    // classification. 0 = whitespace, 1 = word character, 2 = punctuation.
    fn charClassAt(lineIndex: int, column: int): int {
        let len = this.args.getLineLength(lineIndex);
        if column < 0 || column >= len {
            return 0;
        }
        return this._charClassAt(this._lineText(lineIndex), column);
    }

    fn lineLength(lineIndex: int): int {
        return this.args.getLineLength(lineIndex);
    }

    fn lineCount(): int {
        return this.args.getLineCount();
    }

    fn line(lineIndex: int): String {
        return this.args.getLine(lineIndex);
    }

    fn cursor(): Vec2i {
        return this._cursorPos();
    }

    // The sticky column an Up/Down move aims at. Exposed so a behavior
    // can build its own vertical motions on the same rule the engine's
    // moveCursorUp/Down use.
    fn desiredColumn(): int {
        return this._desiredCursorPosition.x;
    }

    // Highest legal column (BYTE OFFSET) for the current mode on a line.
    //
    // In on-a-character modes this is the offset of the LAST GRAPHEME
    // CLUSTER, not `length - 1`. Those differ whenever a line ends in a
    // multi-byte character: on a line holding one flag emoji, `length - 1`
    // is byte 7, which is the middle of the flag, while the correct answer
    // is byte 0 -- the caret sits ON the flag.
    fn maxColumn(lineIndex: int): int {
        let len = this.args.getLineLength(lineIndex);
        if modeClampsToLastChar(rx.get(this.mode)) {
            if len <= 0 {
                return 0;
            }
            return unicode.previousClusterOffset(this._lineText(lineIndex), len);
        }
        return len;
    }

    // The line's text as a slice.
    //
    // cloneString() is zero-copy while a line is still committed/borrowed,
    // but a host whose lines are mutated in place (text_document does this
    // deliberately, to keep a keystroke O(line) instead of O(document))
    // hands back a live buffer, and cloning one costs a malloc + memcpy --
    // measured at ~14ns for lines up to 400 bytes.
    //
    // That is the dominant cost of a cursor motion, which is otherwise ~3ns
    // on the ASCII fast path, and it is still three orders of magnitude
    // below a keystroke. If it ever matters, the fix is to cache the
    // boundary array per line and invalidate it from the host's ChangeSet,
    // NOT to hand a live mutable buffer to the FFI layer -- that would
    // violate the `str` immutability invariant this clone exists to keep.
    fn _lineText(lineIndex: int): str {
        return this.args.getLine(lineIndex).cloneString();
    }

    // === Character stepping =======================================
    //
    // The byte offset one CHARACTER left/right of `column` on a line, and
    // the alignment guard. Behaviors must use these instead of `column + 1`
    // and `column - 1`: those step one BYTE, which lands inside multi-byte
    // characters and corrupts the buffer on the next edit.
    //
    // Both clamp at the ends of the line and never wrap.

    fn nextColumn(lineIndex: int, column: int): int {
        return unicode.nextClusterOffset(this._lineText(lineIndex), column);
    }

    fn previousColumn(lineIndex: int, column: int): int {
        return unicode.previousClusterOffset(this._lineText(lineIndex), column);
    }

    // Snap an arbitrary byte offset onto the character boundary at or before
    // it. Use on any column that came from arithmetic rather than from the
    // two steppers above.
    fn snapColumn(lineIndex: int, column: int): int {
        return this._snapColumn(lineIndex, column);
    }

    // Snap a byte offset onto the nearest cluster boundary at or before it.
    //
    // This is what makes the engine's central invariant hold. Every column
    // that reaches the cursor passes through here, so an offset computed by
    // arithmetic -- a sticky column carried onto a line whose characters sit
    // at different offsets, a click converted from pixels, a cursor restored
    // from an undo snapshot -- can never land inside a character.
    fn _snapColumn(lineIndex: int, column: int): int {
        if column <= 0 {
            return 0;
        }
        return unicode.clusterStart(this._lineText(lineIndex), column);
    }

    // === Character-space queries ==================================
    //
    // Everything else in this engine speaks byte offsets. These two are the
    // exceptions, and they are named so they cannot be mistaken for one.
    // They exist for UI that must show a human a count, and their results
    // must never be fed back into a slice, an edit or a column.

    // How many CHARACTERS (grapheme clusters) precede the cursor on its
    // line -- what a status bar means by "column 12". Not a byte offset.
    fn characterColumn(): int {
        let pos = this._cursorPos();
        return unicode.characterIndexAt(this._lineText(pos.y), pos.x);
    }

    // How many monospace CELLS precede the cursor on its line. Differs from
    // characterColumn wherever CJK or emoji appear, since those occupy two
    // cells each. This is the number a fixed-advance renderer needs to
    // place a caret; it is not a byte offset and not a character count.
    fn displayColumn(): int {
        let pos = this._cursorPos();
        return this.displayColumnAt(pos.y, pos.x);
    }

    // How many monospace CELLS precede a given BYTE OFFSET on a line.
    //
    // This is the conversion a fixed-advance renderer needs to turn any
    // engine column into an x position: a byte offset is not proportional to
    // screen distance once a line contains multi-byte or double-width
    // characters. Multiplying a byte column by a character width -- the
    // obvious thing to do, and correct for pure ASCII -- puts the caret four
    // cells to the right of a single emoji.
    fn displayColumnAt(lineIndex: int, column: int): int {
        let line = this._lineText(lineIndex);
        return unicode.displayWidth(line.slice(0, clamp<int>(column, 0, line.length)));
    }

    // Width in monospace CELLS of the character at a byte offset: 2 for CJK
    // and emoji, 1 otherwise. A block caret in normal mode should be this
    // wide so it covers the character it is sitting on.
    fn displayWidthOfCharacterAt(lineIndex: int, column: int): int {
        return unicode.clusterColumnWidth(this._lineText(lineIndex), column);
    }

    // === Internals =================================================

    // Vec2i field reads coming straight off `cursorPosition`/`selectionStart`/
    // `selectionEnd` are reactive-wrapped per-field, not plain Vec2i values --
    // fine for reading `.x`/`.y` off directly, but not for passing on as a
    // `Vec2i` argument or return value. These three rebuild a genuine plain
    // Vec2i so the rest of the engine (_target*, replaceRange, ...) can stay
    // written in terms of ordinary Vec2i values.
    fn _cursorPos(): Vec2i {
        let pos = this.cursorPosition;
        return { x: pos.x, y: pos.y };
    }

    fn _selStart(): Vec2i {
        let s = this.selectionStart;
        return { x: s.x, y: s.y };
    }

    fn _selEnd(): Vec2i {
        let e = this.selectionEnd;
        return { x: e.x, y: e.y };
    }

    // All document mutation funnels through here so undo snapshotting has
    // exactly one place to hook, and so a bare replaceRange outside a
    // transaction still produces its own undo step.
    mut fn _applyReplace(start: Vec2i, end: Vec2i, text: String) {
        let standalone = this._txDepth == 0;
        if standalone {
            this.beginTransaction();
        }
        // Save what this edit is about to overwrite, while the old lines
        // are still readable, then perform it. How many lines the new
        // text occupies decides the range undo has to take back out.
        let insertedLines = 1;
        let raw = text.cloneString();
        for (let i = 0; i < raw.length; i++) {
            if raw[i] == b"\n" {
                insertedLines = insertedLines + 1;
            }
        }
        this._recordEdit(start.y, end.y, insertedLines);
        this.args.replaceRange(start, end, text);
        if standalone {
            this.endTransaction();
        }
    }

    mut fn _deleteSelection() {
        let range = this.selectionAsRange();
        this.beginTransaction();
        if range.kind == RangeKind.Linewise {
            this._deleteLines(range.start.y, range.end.y);
        } else {
            let normalized = this.normalizeRange(range);
            this._applyReplace(normalized.start, normalized.end, String(""));
            this._moveTo(normalized.start, true, false);
        }
        this.selectionAnchor := none;
        this.endTransaction();
    }

    // Delete whole lines startY..endY inclusive, including one newline,
    // and leave the caret at the first non-blank of the line that slid
    // into place -- which is what Vim does after `dd`.
    // `keepColumnOverride` is the column the caret should keep; pass it
    // when the caret is not already at the right one. In visual mode the
    // caret sits at the selection's moving END, but vim leaves it on the
    // column the selection STARTED at, so the caller supplies that.
    mut fn _deleteLines(startY: int, endY: int, keepColumnOverride: int = -1) {
        let keepColumn = keepColumnOverride >= 0 ? keepColumnOverride : this._cursorPos().x;
        let lineCount = this.args.getLineCount();
        let cutStart: Vec2i = { x: 0, y: startY };
        let cutEnd: Vec2i = {};
        if endY < lineCount - 1 {
            // Take the trailing newline with it.
            cutEnd = { x: 0, y: endY + 1 };
        } else if startY > 0 {
            // Last line(s): take the *preceding* newline instead.
            cutStart = { x: this.args.getLineLength(startY - 1), y: startY - 1 };
            cutEnd = { x: this.args.getLineLength(endY), y: endY };
        } else {
            // Deleting every line: the buffer keeps one empty line.
            cutEnd = { x: this.args.getLineLength(endY), y: endY };
        }
        this._applyReplace(cutStart, cutEnd, String(""));

        // Keep the column rather than jumping to the first non-blank:
        // neovim ships with 'startofline' OFF, so `dd` leaves the caret
        // on the same column of the line that slid into place (clamped
        // to that line's length by _moveTo).
        let landingY = clamp<int>(startY, 0, this.args.getLineCount() - 1);
        let target: Vec2i = { x: keepColumn, y: landingY };
        this._moveTo(target, true, false);
    }

    fn _getTextInRange(start: Vec2i, end: Vec2i): String {
        if start.y == end.y {
            let lineLen = this.args.getLineLength(start.y);
            let s = clamp<int>(start.x, 0, lineLen);
            let e = clamp<int>(end.x, 0, lineLen);
            if e <= s {
                return String("");
            }
            return String(this.args.getLine(start.y).cloneString().slice(s, e));
        }
        let firstLine = this.args.getLine(start.y);
        let startLen = this.args.getLineLength(start.y);
        let result = firstLine.cloneString().slice(clamp<int>(start.x, 0, startLen), startLen);
        for (let y = start.y + 1; y < end.y; y++) {
            result = f"{result}\n{this.args.getLine(y).cloneString()}";
        }
        let lastLine = this.args.getLine(end.y);
        let endLen = this.args.getLineLength(end.y);
        result = f"{result}\n{lastLine.cloneString().slice(0, clamp<int>(end.x, 0, endLen))}";
        return String(result);
    }

    // Linewise text always carries a trailing newline, which is exactly
    // what makes a linewise paste open a new line.
    fn _getLinewiseText(startY: int, endY: int): String {
        let result = "";
        for (let y = startY; y <= endY; y++) {
            result = f"{result}{this.args.getLine(y).cloneString()}\n";
        }
        return String(result);
    }

    fn _documentText(): str {
        let result = "";
        let count = this.args.getLineCount();
        for (let y = 0; y < count; y++) {
            if y > 0 {
                result = f"{result}\n";
            }
            result = f"{result}{this.args.getLine(y).cloneString()}";
        }
        return result;
    }

    // Single point of truth for placing the cursor: clamps to valid
    // document/line bounds, decides whether this move updates the sticky
    // column, and decides whether it grows/shrinks a selection (Shift held)
    // or collapses to a plain caret. Every move/edit function above -- and
    // any future one (click-to-place, drag, Vim visual mode, ...) -- should
    // go through this rather than writing cursorPosition/selectionAnchor
    // directly.
    mut fn _moveTo(target: Vec2i, updateDesiredX: bool, extend: bool) {
        this._cursorLastMovedAt = this.args.getTimeInSeconds();

        let lineCount = this.args.getLineCount();
        let y = clamp<int>(target.y, 0, lineCount - 1);
        let x = this._snapColumn(y, clamp<int>(target.x, 0, this.maxColumn(y)));

        if extend {
            if !this.selectionAnchor {
                this.selectionAnchor := this._cursorPos();
            }
        } else if this.selectionAnchor && !modeIsVisual(rx.get(this.mode)) {
            // Visual modes own their anchor: an unextended move inside
            // visual mode still tracks the existing anchor rather than
            // dropping the selection.
            this.selectionAnchor := none;
        }

        if this.cursorPosition.x != x {
            this.cursorPosition.x := x;
        }
        if this.cursorPosition.y != y {
            this.cursorPosition.y := y;
        }

        this._desiredCursorPosition.y = y;
        if updateDesiredX {
            this._desiredCursorPosition.x = x;
        }
    }

    // --- Pure motions: (position) => target position. No side effects. ---

    fn _targetRight(pos: Vec2i): Vec2i {
        let lineLength = this.args.getLineLength(pos.y);
        let limit = this.maxColumn(pos.y);
        if pos.x < limit {
            // One character to the right, which is 1..25 bytes depending on
            // what is actually there. Clamped to `limit` so that in
            // on-a-character modes a cluster at the end of the line cannot
            // push the caret past the last legal position.
            let next = unicode.nextClusterOffset(this._lineText(pos.y), pos.x);
            return { x: next < limit ? next : limit, y: pos.y };
        }
        // In on-a-character modes, `l` never wraps to the next line.
        if !modeClampsToLastChar(rx.get(this.mode)) && pos.x >= lineLength {
            if pos.y < this.args.getLineCount() - 1 {
                return { x: 0, y: pos.y + 1 };
            }
        }
        return pos;
    }

    fn _targetLeft(pos: Vec2i): Vec2i {
        if pos.x > 0 {
            // One character to the left. Note this walks to the START of the
            // preceding cluster, so a single press clears a whole flag or
            // family emoji rather than stepping into the middle of it.
            return { x: unicode.previousClusterOffset(this._lineText(pos.y), pos.x), y: pos.y };
        }
        // In on-a-character modes, `h` never wraps to the previous line.
        if !modeClampsToLastChar(rx.get(this.mode)) && pos.y > 0 {
            return { x: this.args.getLineLength(pos.y - 1), y: pos.y - 1 };
        }
        return pos;
    }

    fn _targetUp(pos: Vec2i): Vec2i {
        if pos.y > 0 {
            return { x: this._desiredCursorPosition.x, y: pos.y - 1 };
        }
        return pos;
    }

    fn _targetDown(pos: Vec2i): Vec2i {
        if pos.y < this.args.getLineCount() - 1 {
            return { x: this._desiredCursorPosition.x, y: pos.y + 1 };
        }
        return pos;
    }

    fn _targetWordLeft(pos: Vec2i): Vec2i {
        if pos.x == 0 {
            if pos.y > 0 {
                return { x: this.args.getLineLength(pos.y - 1), y: pos.y - 1 };
            }
            return pos;
        }

        // Walks CHARACTERS, not bytes: stepping byte-by-byte would classify
        // each byte of a multi-byte character separately and stop in the
        // middle of "naive" or "日本語".
        let line = this._lineText(pos.y);
        let x = pos.x;

        // Skip whitespace directly to the left of the cursor
        let scan = unicode.previousClusterOffset(line, x);
        while x > 0 && unicode.classifyAt(line, scan) == unicode.CharClass.Whitespace {
            x = scan;
            scan = unicode.previousClusterOffset(line, x);
        }

        // Skip one run of same-class characters to land on the word's start
        if x > 0 {
            let previous = unicode.previousClusterOffset(line, x);
            let targetClass = unicode.classifyAt(line, previous);
            while x > 0 && unicode.classifyAt(line, previous) == targetClass {
                x = previous;
                previous = unicode.previousClusterOffset(line, x);
            }
        }

        return { x: x, y: pos.y };
    }

    fn _targetWordRight(pos: Vec2i): Vec2i {
        let lineLength = this.args.getLineLength(pos.y);
        if pos.x >= lineLength {
            if pos.y < this.args.getLineCount() - 1 {
                return { x: 0, y: pos.y + 1 };
            }
            return pos;
        }

        // Walks CHARACTERS, not bytes -- see _targetWordLeft.
        let line = this._lineText(pos.y);
        let x = pos.x;

        // Skip whitespace immediately ahead, if any -- matching Chrome's
        // textarea: Ctrl+Right from inside a word stops at the end of THAT
        // word (doesn't also swallow the whitespace after it), but from
        // whitespace (or the end of a word) it skips the gap and stops at
        // the end of the next run instead. So whitespace is only ever
        // consumed as a leading skip, never trailing.
        while x < lineLength && unicode.classifyAt(line, x) == unicode.CharClass.Whitespace {
            x = unicode.nextClusterOffset(line, x);
        }

        // Skip one run of the resulting class (word or punctuation).
        if x < lineLength {
            let targetClass = unicode.classifyAt(line, x);
            while x < lineLength && unicode.classifyAt(line, x) == targetClass {
                x = unicode.nextClusterOffset(line, x);
            }
        }

        return { x: x, y: pos.y };
    }

    fn _targetHome(pos: Vec2i): Vec2i {
        return { x: 0, y: pos.y };
    }

    fn _targetEnd(pos: Vec2i): Vec2i {
        return { x: this.args.getLineLength(pos.y), y: pos.y };
    }

    fn _targetDocumentStart(): Vec2i {
        return { x: 0, y: 0 };
    }

    fn _targetDocumentEnd(): Vec2i {
        let lastLine = this.args.getLineCount() - 1;
        return { x: this.args.getLineLength(lastLine), y: lastLine };
    }

    // Classify the character at a BYTE OFFSET. Unicode-aware: non-ASCII
    // letters, marks and ideographs count as word characters, so a word
    // motion crosses "naive" and "日本語" as single words rather than
    // splitting them at every non-ASCII byte.
    fn _charClassAt(line: str, index: int): int {
        let classification = unicode.classifyAt(line, index);
        if classification == unicode.CharClass.Whitespace {
            return 0;
        }
        if classification == unicode.CharClass.Word {
            return 1;
        }
        return 2;
    }
}

// One undo step, modelled on neovim's `u_save(lo, hi)`.
//
// Neovim does not snapshot the buffer; it records, for each change, the
// LINE RANGE that is about to be replaced together with the lines that
// were there before. Undoing swaps the current contents of that range
// back out for the saved ones (which is itself recorded, so redo is the
// same operation in reverse).
//
// That model is what keeps the engine storage-agnostic: an entry holds
// only line strings the host handed over via `getLine`, plus indices --
// never a copy of the document, and no assumption about how the host
// stores it (array of lines, rope, piece table, ...). It is also O(edit)
// rather than O(document), so typing a character in a 100k-line file
// costs the same as in a 10-line one.
export struct UndoEntry {
    // The range replaced, as line indices: [startLine, startLine+removedCount).
    startLine: int = 0;
    // How many lines the edit removed from that position...
    removedCount: int = 0;
    // ...and the text of those lines, to put back on undo.
    removedLines: []str = [];
    // How many lines the edit put there instead (needed to find the
    // range to take back out when undoing).
    insertedCount: int = 0;
    // Caret position before the edit, restored along with the text.
    cursorBefore: Vec2i = {};
    // Caret position after the edit, restored on redo.
    cursorAfter: Vec2i = {};
    // True when the edit replaced WHOLE lines (a linewise delete/change).
    // Undoing one of those puts the caret at column 0 of the first
    // restored line, which is what vim reports -- the saved column
    // belonged to text that no longer exists in the same shape.
    linewise: bool = false;
}
