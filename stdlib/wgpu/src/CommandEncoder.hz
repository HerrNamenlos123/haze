
export struct CommandEncoderDescriptor {
    label: str;
}

fn fromFFI(v: ffi.WGPUCommandEncoderDescriptor): CommandEncoderDescriptor :: final {
    return CommandEncoderDescriptor {
        label: fromFFI(v.label),
    };
}

fn fromOptionalFFI(v: ffi.WGPUCommandEncoderDescriptor | none): CommandEncoderDescriptor | none :: final {
    if !v {
        return none;
    }
    return CommandEncoderDescriptor {
        label: fromFFI(v.label),
    };
}

fn toFFI(c: CommandEncoderDescriptor): ffi.WGPUCommandEncoderDescriptor :: final {
    return ffi.WGPUCommandEncoderDescriptor {
        nextInChain: none,
        label: toFFI(c.label),
    };
}

export struct CommandEncoder {
    handle: mut ffi.WGPUCommandEncoderImpl;

    fn beginRenderPass(descriptor: RenderPassDescriptor): Result<RenderPassEncoder, none> {
        do unsafe {
            // The two optional sub-structs the WGPURenderPassDescriptor points at
            // are built HERE rather than inside toFFI(), because the pointers it
            // carries must stay valid for the whole call -- a toFFI() borrowing
            // its own frame would hand back two dangling pointers the moment it
            // returned. wgpuCommandEncoderBeginRenderPass reads all three through
            // `Option<&...>` and rebuilds them as owned wgpu-core values before
            // it does anything else, so none of them escapes the call.
            let depthStencil: ffi.WGPURenderPassDepthStencilAttachment = uninitialized;
            if descriptor.depthStencilAttachment {
                depthStencil = toFFI(descriptor.depthStencilAttachment);
            }
            let stackref depthStencilStorage = depthStencil;
            let depthStencilPtr = none as ref ffi.WGPURenderPassDepthStencilAttachment | none;
            if descriptor.depthStencilAttachment {
                let depthStencilRaw = ffi.extractRawUnsafeStackrefPointer(depthStencilStorage);
                __c__("depthStencilPtr = depthStencilRaw;");
            }

            let timestamps: ffi.WGPURenderPassTimestampWrites = uninitialized;
            if descriptor.timestampWrites {
                timestamps = toFFI(descriptor.timestampWrites);
            }
            let stackref timestampStorage = timestamps;
            let timestampPtr = none as ref ffi.WGPURenderPassTimestampWrites | none;
            if descriptor.timestampWrites {
                let timestampRaw = ffi.extractRawUnsafeStackrefPointer(timestampStorage);
                __c__("timestampPtr = timestampRaw;");
            }

            // The attachments go into a fixed buffer on this frame instead of a
            // freshly heap-allocated array per pass -- see ColorAttachmentBuffer.
            // Left uninitialized on purpose: fillColorAttachments writes every
            // slot up to the count it returns, and wgpu only ever reads that
            // many -- zeroing 8 attachments per frame to overwrite one or two
            // of them would be pure waste.
            let colorAttachmentBuffer: ColorAttachmentBuffer = uninitialized;
            let stackref colorAttachments = colorAttachmentBuffer;
            let colorAttachmentCount = fillColorAttachments(colorAttachments, descriptor.colorAttachments);
            let colorAttachmentsRaw = ffi.extractRawUnsafeStackrefPointer(colorAttachments);

            let stackref d = toFFI(
                descriptor,
                colorAttachmentsRaw,
                colorAttachmentCount,
                depthStencilPtr,
                timestampPtr,
            );
            let dPtr: ref ffi.WGPURenderPassDescriptor = uninitialized;
            let dRaw = ffi.extractRawUnsafeStackrefPointer(d);
            __c__("dPtr = dRaw;");
            let handle = ffi.wgpuCommandEncoderBeginRenderPass(this.handle, dPtr);
            if handle {
                return fromFFI(handle);
            }
            return none;
        };
    }

    fn finish(descriptor?: CommandBufferDescriptor): Result<CommandBuffer, none> {
        do unsafe {
            let value: ffi.WGPUCommandBufferDescriptor = uninitialized;
            if descriptor {
                value = toFFI(descriptor);
            }
            let stackref storage = value;
            let descriptorPtr = none as ref ffi.WGPUCommandBufferDescriptor | none;
            if descriptor {
                let storageRaw = ffi.extractRawUnsafeStackrefPointer(storage);
                __c__("descriptorPtr = storageRaw;");
            }
            let buffer = ffi.wgpuCommandEncoderFinish(this.handle, descriptorPtr);
            if buffer {
                return fromFFI(buffer);
            }
            return none;
        };
    }
}

fn fromFFI(v: mut ffi.WGPUCommandEncoderImpl): CommandEncoder :: final {
    return CommandEncoder {
        handle: v,
    };
}

fn toFFI(v: CommandEncoder): mut ffi.WGPUCommandEncoderImpl :: final {
    return v.handle;
}