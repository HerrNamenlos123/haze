
export struct ShaderModuleDescriptor {
    debugLabel?: str;
    code: str;
}

// The WGSL source is a CHAINED struct: the descriptor carries a pointer to it in
// `nextInChain`, so -- like every other pointer field in this module -- it is
// built by the caller, in the frame that makes the wgpu call, and borrowed into
// place here. See Device.createShaderModule and borrowForCall in utils.hz.
fn wgslSourceToFFI(v: ShaderModuleDescriptor): ffi.WGPUShaderSourceWGSL :: final {
    return ffi.WGPUShaderSourceWGSL {
        chain: {
            next: none,
            sType: ffi.WGPUSType_ShaderSourceWGSL,
        },
        code: toFFI(v.code),
    };
}

fn toFFI(v: ShaderModuleDescriptor, source: ref ffi.WGPUShaderSourceWGSL): ffi.WGPUShaderModuleDescriptor :: final {
    do unsafe {
        let desc = ffi.WGPUShaderModuleDescriptor {
            nextInChain: none,
            label: toOptionalFFI(v.debugLabel),
        };
        // WGPUShaderSourceWGSL is not a WGPUChainedStruct, it merely starts with
        // one -- the cast is what the C API's chaining convention is built on.
        __c__("desc.nextInChain = (void*)source;");
        return desc;
    };
}

export struct ShaderModule {
    handle: mut ffi.WGPUShaderModuleImpl;
}

fn fromFFI(v: mut ffi.WGPUShaderModuleImpl): ShaderModule :: final {
    return ShaderModule {
        handle: v,
    };
}

fn toFFI(v: ShaderModule): mut ffi.WGPUShaderModuleImpl :: final {
    return v.handle;
}

export enum bitflag ShaderStage {
    None = 0,
    Vertex = 1,
    Fragment = 2,
    Compute = 4,
}

fn shaderStageFromFFI(v: ffi.WGPUShaderStage): ShaderStage :: final {
    do unsafe {
        let usage: ShaderStage = uninitialized; // This is a bitflag
        __c__("usage = (int)v;");
        return usage;
    };
}

fn toFFI(v: ShaderStage): ffi.WGPUShaderStage :: final {
    do unsafe {
        let usage: ffi.WGPUShaderStage = uninitialized; // This is a bitflag
        __c__("usage = (int)v;");
        return usage;
    };
}
