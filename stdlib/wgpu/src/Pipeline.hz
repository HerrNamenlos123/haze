
export struct RenderPipeline {
    handle: mut ffi.WGPURenderPipelineImpl;
}

fn fromFFI(v: mut ffi.WGPURenderPipelineImpl): RenderPipeline :: final {
    return RenderPipeline { handle: v };
}

fn toFFI(v: RenderPipeline): mut ffi.WGPURenderPipelineImpl :: final {
    return v.handle;
}

export struct PipelineLayout {
    handle: mut ffi.WGPUPipelineLayoutImpl;
}

fn fromFFI(v: mut ffi.WGPUPipelineLayoutImpl): PipelineLayout :: final {
    return PipelineLayout { handle: v };
}

fn toFFI(v: PipelineLayout): mut ffi.WGPUPipelineLayoutImpl :: final {
    return v.handle;
}

export struct RenderPipelineDescriptor {
    debugLabel?: str;
    layout?: PipelineLayout;
    vertex: VertexState;
    primitive: PrimitiveState;
    depthStencil?: DepthStencilState;
    multisample: MultisampleState = default;
    fragment?: FragmentState;
}

// `depthStencil` and `fragment` are pointer fields, so their storage has to
// belong to whoever makes the wgpu call -- see Device.createRenderPipeline and
// borrowForCall in utils.hz.
fn toFFI(
    v: RenderPipelineDescriptor,
    depthStencil: ref ffi.WGPUDepthStencilState | none,
    fragment: ref ffi.WGPUFragmentState | none,
): ffi.WGPURenderPipelineDescriptor :: final {
    return ffi.WGPURenderPipelineDescriptor {
        nextInChain: none,
        label: toOptionalFFI(v.debugLabel),
        layout: v.layout ? toFFI(v.layout) : none,
        vertex: toFFI(v.vertex),
        primitive: toFFI(v.primitive),
        depthStencil: depthStencil,
        multisample: toFFI(v.multisample),
        fragment: fragment,
    };
}

export struct MultisampleState {
    count: u32 = 1;
    mask: u32 = 0xFFFFFFFF;
    alphaToCoverageEnabled: bool = false;
}

fn fromFFI(v: ffi.WGPUMultisampleState): MultisampleState :: final {
    return {
        count: v.count,
        mask: v.mask,
        alphaToCoverageEnabled: v.alphaToCoverageEnabled,
    };
}

fn toFFI(v: MultisampleState): ffi.WGPUMultisampleState :: final {
    return {
        nextInChain: none,
        count: v.count,
        mask: v.mask,
        alphaToCoverageEnabled: v.alphaToCoverageEnabled,
    };
}

export struct PipelineLayoutDescriptor {
    debugLabel?: str;
    bindGroupLayouts: [](BindGroupLayout);
}

fn fromFFI(v: ffi.WGPUPipelineLayoutDescriptor): PipelineLayoutDescriptor :: final {
    let c = none as cptr;
    __c__("c = (void*)v.bindGroupLayouts;"); // ignoring constness issue
    return {
        debugLabel: fromOptionalFFI(v.label),
        bindGroupLayouts: arrayFromFFI<BindGroupLayout, mut ffi.WGPUBindGroupLayoutImpl>(v.bindGroupLayoutCount, c),
    };
}

fn toFFI(v: PipelineLayoutDescriptor): ffi.WGPUPipelineLayoutDescriptor :: final {
    let layouts = arrayToFFI<BindGroupLayout, mut ffi.WGPUBindGroupLayoutImpl>(v.bindGroupLayouts);
    return {
        nextInChain: none,
        label: toOptionalFFI(v.debugLabel),
        bindGroupLayoutCount: layouts.length,
        bindGroupLayouts: layouts.data,
    };
}