
export ref struct ConstantEntry {
    key: str;
    value: real;
}

fn fromFFI(v: ffi.WGPUConstantEntry): ConstantEntry :: final {
    return ConstantEntry {
        key: fromFFI(v.key),
        value: v.value,
    };
}

fn toFFI(v: ConstantEntry): ref ffi.WGPUConstantEntry :: final {
    return ref ffi.WGPUConstantEntry {
        nextInChain: none,
        key: toFFI(v.key),
        value: v.value,
    };
}