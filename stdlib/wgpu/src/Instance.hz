export struct Instance {
    handle: mut ffi.WGPUInstanceImpl;

    fn requestAdapterAsync(adapterOpts: RequestAdapterOptions | none, callbackInfo: RequestAdapterCallbackInfo) {

        let callback: ref Box<RequestAdapterCallback> = { value: callbackInfo.callback };
        let userdata1: cptr = none;
        __c__("userdata1 = (void*)callback;"); // Pass the function pointer to the highlevel callback into the lowlevel hook

        let ffiCallbackInfo = {
            nextInChain: none,
            callback: requestAdapterCallbackProxy,
            mode: toFFI(callbackInfo.mode),
            userdata1: userdata1,
            userdata2: none,
        } as ffi.WGPURequestAdapterCallbackInfo;

        if adapterOpts {
            let surface = adapterOpts.compatibleSurface;
            let compatibleSurface: mut ffi.WGPUSurfaceImpl | none = none;
            if surface {
                compatibleSurface = surface.handle;
            }

            return fromFFI(
                ffi.wgpuInstanceRequestAdapter(this.handle, {
                    nextInChain: none,
                    featureLevel: toFFI(adapterOpts.featureLevel),
                    powerPreference: toFFI(adapterOpts.powerPreference),
                    forceFallbackAdapter: adapterOpts.forceFallbackAdapter,
                    backendType: toFFI(adapterOpts.backendType),
                    compatibleSurface: compatibleSurface,
                }, ffiCallbackInfo)
            );
        }
        else {
            return fromFFI(ffi.wgpuInstanceRequestAdapter(this.handle, none, ffiCallbackInfo));
        }
    }

    fn requestAdapterSync(adapterOpts: RequestAdapterOptions | none): Result<Adapter, str> {
        // Shared with the callback through stack references: the closure
        // captures the references, the cells themselves live in this frame.
        let stackref adapter = Box<Adapter | none>(none);
        let stackref adapterReady = Box<bool>(false);
        let stackref message = Box<str>("");
        this.requestAdapterAsync(adapterOpts, { 
            callback: (status: RequestAdapterStatus, _adapter: Adapter, _message: str): void => {
                if (status == RequestAdapterStatus.Success) {
                    adapter.value = _adapter;
                    adapterReady.value = true;
                }
                else {
                    adapterReady.value = true;
                }
                message.value = _message;
            }
        });
        let timeout = 100;
        while !adapterReady.value && timeout > 0 {
            time.sleep(0.1);
            timeout--;
        }
        if adapter.value {
            return adapter.value;
        }
        return message.value;
    }
}

fn fromFFI(v: mut ffi.WGPUInstanceImpl): Instance :: final {
    return Instance { handle: v };
}

fn toFFI(v: Instance): mut ffi.WGPUInstanceImpl :: final {
    return v.handle;
}