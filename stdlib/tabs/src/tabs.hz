import ui_elements
import ui_styling
import ui_components
import headwind
type presets = headwind.presets;

// === Tabs =====================================================
//
// A generic tab strip and tab panels, in the shape a UI library is
// expected to provide them: the component owns the chrome (the strip, the
// per-tab button, hover/active styling, the close affordance) and knows
// nothing whatsoever about what a tab CONTAINS. The host supplies a list
// of tabs and a callback that renders one tab's body; anything can go in
// there.
//
// ── The one thing that makes this a real tab system ───────────
//
// Inactive tabs stay MOUNTED. Their content components are declared every
// frame exactly like the active one, and are merely hidden with
// `display: none` (see ui_styling.Display and presets.show()). This is
// Vue's `v-show`, not `v-if`, and it is deliberate:
//
// A tab's interesting state does not live in the host's model, it lives
// inside its content components -- scroll offset, caret position, undo
// history, selection, in-flight requests, cached syntax tokens. Rendering
// only the active tab would destroy those components on every switch (the
// component system unmounts anything not re-declared during a render pass
// -- see defineComponentImpl), so switching away and back would silently
// reset every one of them. Keeping them mounted and hidden is what makes
// "switch tabs" mean "look somewhere else" instead of "throw this away and
// build it again".
//
// The cost is that hidden tabs keep their memory, which is exactly the
// trade every real editor makes. What they do NOT cost is layout, paint or
// input: a `display: none` subtree is never declared to the layout engine,
// so it is not measured, not drawn, not hit-tested, and cannot hold focus.
//
// ── Usage ─────────────────────────────────────────────────────
//
//   Tabs(ui, {
//       id: 1,
//       tabs: myTabs,                       // []TabItem
//       activeKey: rx.get(activeKey),
//       onSelect: (key: int) => { activeKey := key; },
//       onClose: (key: int) => { closeTab(key); },
//       renderTab: (key: int) => { MyEditor(ui, { id: key, ... }); },
//   });
//
// `renderTab` is called once per tab, every frame, for ALL tabs -- not
// just the active one. It must therefore identify its content by the
// `key` it is handed and give that content a stable component id derived
// from it, so each tab keeps its own component instance across frames.

// One tab, as the host describes it. Purely data -- the host owns the
// list, the component only reads it.
export ref struct TabItem {
    // Stable identity for this tab, chosen by the host. Used as the
    // component id of the tab's panel, so it MUST be unique among the
    // tabs and MUST NOT change while the tab exists -- if it changed, the
    // component system would treat it as a different component, unmount
    // the old one and rebuild it, losing exactly the state this whole
    // component exists to preserve. An index is therefore a poor key
    // (closing a tab renumbers everything after it); a monotonically
    // increasing counter is the usual right answer.
    key: int;
    title: str;
    // Shown as a trailing dot, the way editors mark unsaved work.
    modified: bool = false;
    // Whether this particular tab offers a close button. Independent of
    // TabsArgs.closable, which turns the affordance off for the whole
    // strip at once.
    closable: bool = true;
}

// Colours of the strip, so a host can theme it without forking the
// component. Defaults are a neutral dark scheme.
export ref struct TabsStyle {
    barBackground: str = "#1B1B1B";
    tabBackground: str = "#1B1B1B";
    tabHoverBackground: str = "#2A2A2A";
    tabActiveBackground: str = "#252525";
    tabText: str = "#9A9A9A";
    tabActiveText: str = "#FFFFFF";
    // The accent line marking the active tab.
    indicator: str = "#3391FF";
    indicatorThickness: real = 2.0;
    border: str = "#333333";
    closeHoverBackground: str = "#4A4A4A";
    height: real = 34.0;
}

export ref struct TabsArgs {
    id: int;
    tabs: []TabItem;
    // Which tab's panel is visible. A key not present in `tabs` simply
    // means no panel is shown, which is the correct rendering of "there
    // is no active tab" (e.g. the last tab was just closed).
    activeKey: int;
    style: TabsStyle = {};
    // Master switch for the close affordance; individual tabs can still
    // opt out via TabItem.closable.
    closable: bool = true;
    onSelect?: (key: int) => none;
    onClose?: (key: int) => none;
    // Renders one tab's body. Called for EVERY tab each frame, active or
    // not -- see the note on mounting above.
    renderTab?: (key: int) => none;

    // Props equality drives the component's re-render (see
    // defineComponent). The tab list is compared element-wise because its
    // contents are what the strip draws: a renamed or newly-modified tab
    // has to repaint even though the list length never changed.
    fn operator!=(other: TabsArgs) {
        if this.id != other.id
            || this.activeKey != other.activeKey
            || this.closable != other.closable
            || this.tabs.length != other.tabs.length {
            return true;
        }
        for (let i = 0; i < this.tabs.length; i++) {
            if this.tabs[i].key != other.tabs[i].key
                || this.tabs[i].title != other.tabs[i].title
                || this.tabs[i].modified != other.tabs[i].modified
                || this.tabs[i].closable != other.tabs[i].closable {
                return true;
            }
        }
        return false;
    }
}

// Element ids inside this component. Kept well apart from the per-tab ids
// below, which are derived from a tab's key and so could otherwise
// collide with a hand-picked small number.
const comptime ID_ROOT = 1;
const comptime ID_BAR = 2;
const comptime ID_PANELS = 3;
// Per-tab ids are offset into their own ranges so a tab keyed 0 cannot
// collide with the fixed ids above.
const comptime ID_TAB_BASE = 1000000;
const comptime ID_PANEL_BASE = 2000000;

// The tab strip on its own, without the panels.
//
// Most hosts want Tabs() below, which is this plus the panel stack. This
// is exported separately for the layouts where the two cannot be
// siblings -- a strip docked in a toolbar with the content elsewhere in
// the tree, say.
export fn TabBar(ui: ui_components.UIContext, args: TabsArgs) {
    ui.defineComponent(args.id, args, (instance: ui_components.InstanceData<TabsArgs>) => {
        // The strip is a fixed-height rail across the full width. Its
        // wrapper must shrink-wrap vertically or it would split the column
        // with the panels below it -- half the window of empty tab strip
        // above a half-height editor, which is exactly what a Grow wrapper
        // (the default) produces here.
        ui.componentSize(ui_styling.SizeMode.Grow, ui_styling.SizeMode.Fit);

        return (): void => {
            let props = instance.props();
            let style = props.style;

            ui.div({
                id: ID_BAR,
                // Fixed height, set on `style` (which wins over presets) so
                // the strip is a rail of exactly this size and every bit of
                // the remaining column goes to the panels below it.
                style: { height: style.height },
                presets: [
                    presets.row(),
                    presets.wGrow(),
                    presets.bg(style.barBackground),
                    presets.borderB(1),
                    presets.borderColor(style.border),
                    // The strip is a fixed-height rail: if more tabs are
                    // open than fit, they are clipped rather than allowed
                    // to push the editor out of the window.
                    presets.overflowHidden(),
                ],
            }, (): void => {
                for tab, index in props.tabs {
                    let isActive = tab.key == props.activeKey;
                    TabButton(ui, {
                        id: ID_TAB_BASE + index,
                        tab: tab,
                        active: isActive,
                        style: style,
                        closable: props.closable && tab.closable,
                        onSelect: props.onSelect,
                        onClose: props.onClose,
                    });
                }
            });
        };
    });
}

ref struct TabButtonArgs {
    id: int;
    tab: TabItem;
    active: bool;
    style: TabsStyle;
    closable: bool;
    onSelect?: (key: int) => none;
    onClose?: (key: int) => none;

    fn operator!=(other: TabButtonArgs) {
        return this.id != other.id
            || this.tab.key != other.tab.key
            || this.tab.title != other.tab.title
            || this.tab.modified != other.tab.modified
            || this.active != other.active
            || this.closable != other.closable;
    }
}

// One tab in the strip: label, modified dot, close button, and the active
// indicator. A component of its own so each tab owns its own hover state
// rather than the strip having to track "which tab is the mouse over".
fn TabButton(ui: ui_components.UIContext, args: TabButtonArgs) {
    ui.defineComponent(args.id, args, (instance: ui_components.InstanceData<TabButtonArgs>) => {
        // A tab is as wide as its label and as tall as the strip. This has
        // to be said about the COMPONENT, not just about the div below:
        // every component sits inside a wrapper that defaults to Grow on
        // both axes, and a Grow wrapper would hand each tab an equal share
        // of the strip's full width no matter what its contents asked for.
        ui.componentSize(ui_styling.SizeMode.Fit, ui_styling.SizeMode.Grow);

        let tabRef = ui.elementRef<ui_elements.DivElement>();
        let closeRef = ui.elementRef<ui_elements.DivElement>();

        let isHovered = rx.computed(() => {
            let element = rx.get(tabRef);
            return element ? element.hover() : false;
        });

        let closeHovered = rx.computed(() => {
            let element = rx.get(closeRef);
            return element ? element.hover() : false;
        });

        return (): void => {
            let props = instance.props();
            let style = props.style;
            let active = props.active;

            let background = active
                ? style.tabActiveBackground
                : (isHovered ? style.tabHoverBackground : style.tabBackground);

            ui.div({
                id: 1,
                elementRef: tabRef,
                presets: [
                    // `relative` so the active indicator below can be
                    // absolutely positioned against this tab rather than
                    // against the whole strip.
                    presets.relative(),
                    presets.row(),
                    // Width shrink-wraps the label; height fills the strip.
                    // NOT wGrow: tabs sized to the container would divide
                    // the whole width between them, so three open files
                    // would each be a third of the window wide and the
                    // titles would sit marooned in the middle of them.
                    presets.wFit(),
                    presets.hGrow(),
                    presets.crossAlign(ui_styling.CrossAlign.Center),
                    presets.gap(2),
                    presets.p(2),
                    presets.bg(background),
                    presets.borderR(1),
                    presets.borderColor(style.border),
                    presets.cursorPointer(),
                ],
                onPointerDown: (event: ui_components.PointerEvent) => {
                    // Middle-click closes, as in every browser and editor.
                    let p = instance.props();
                    if event.button == ui_components.PointerButton.Middle {
                        if p.closable {
                            event.stopPropagation();
                            let onClose = p.onClose;
                            if onClose { onClose(p.tab.key); }
                        }
                        return;
                    }
                    if event.button != ui_components.PointerButton.Left {
                        return;
                    }
                    // Selection happens on press rather than on click,
                    // which is what native tab strips do -- the new tab is
                    // shown the instant the button goes down.
                    event.stopPropagation();
                    let onSelect = p.onSelect;
                    if onSelect { onSelect(p.tab.key); }
                },
            }, (): void => {
                ui.text({
                    id: 2,
                    text: props.tab.title,
                    presets: [
                        presets.textColor(active ? style.tabActiveText : style.tabText),
                        presets.noWrap(),
                    ],
                });

                // Unsaved marker. Shown in place of the close button
                // unless the tab is hovered, again matching what editors
                // do: the dot tells you there is something to lose, and
                // reaching for the tab swaps it for the way to close it.
                if props.tab.modified && !isHovered {
                    ui.text({
                        id: 3,
                        text: "●",
                        presets: [presets.textColor(style.tabActiveText)],
                    });
                }
                else if props.closable {
                    ui.div({
                        id: 4,
                        elementRef: closeRef,
                        presets: [
                            presets.rounded(3),
                            presets.bg(closeHovered ? style.closeHoverBackground : "#00000000"),
                            presets.cursorPointer(),
                        ],
                        onPointerDown: (event: ui_components.PointerEvent) => {
                            if event.button != ui_components.PointerButton.Left {
                                return;
                            }
                            // Must not also select the tab being closed.
                            event.stopPropagation();
                            let p = instance.props();
                            let onClose = p.onClose;
                            if onClose { onClose(p.tab.key); }
                        },
                    }, (): void => {
                        ui.text({
                            id: 5,
                            text: "×",
                            presets: [
                                presets.textColor(active ? style.tabActiveText : style.tabText),
                            ],
                        });
                    });
                }

                // Active indicator: a line along the top edge of the
                // active tab. Absolute, so it never participates in the
                // row layout and cannot shift the label.
                if active {
                    ui.div({
                        id: 6,
                        style: { height: style.indicatorThickness },
                        presets: [
                            presets.absolute(),
                            presets.top(0),
                            presets.left(0),
                            presets.wGrow(),
                            presets.bg(style.indicator),
                        ],
                    }, (): void => {});
                }
            });
        };
    });
}

// The panel stack: every tab's body, all mounted, with only the active
// one visible.
//
// Exported alongside TabBar for hosts that need the strip and the panels
// in different places in the tree.
export fn TabPanels(ui: ui_components.UIContext, args: TabsArgs) {
    ui.defineComponent(args.id, args, (instance: ui_components.InstanceData<TabsArgs>) => {
        return (): void => {
            let props = instance.props();

            ui.div({
                id: ID_PANELS,
                presets: [
                    presets.relative(),
                    presets.col(),
                    presets.wGrow(),
                    presets.hGrow(),
                ],
            }, (): void => {
                let renderTab = props.renderTab;
                if !renderTab {
                    return;
                }
                for tab in props.tabs {
                    let isActive = tab.key == props.activeKey;
                    // THE tab-system primitive: every panel is declared
                    // every frame, so every tab's components stay mounted
                    // and keep their state; only the inactive ones are
                    // switched off with display:none. Swapping `show()`
                    // here for an `if isActive` would turn this back into
                    // v-if and throw that state away on each switch.
                    //
                    // Keyed by the tab's own key rather than its position,
                    // so closing a tab does not renumber the panels and
                    // hand tab N the component instance of tab N+1.
                    ui.div({
                        id: ID_PANEL_BASE + tab.key,
                        presets: [
                            presets.show(isActive),
                            presets.col(),
                            presets.wGrow(),
                            presets.hGrow(),
                        ],
                    }, (): void => {
                        renderTab(tab.key);
                    });
                }
            });
        };
    });
}

// Strip + panels, the whole control. This is what a host normally wants.
export fn Tabs(ui: ui_components.UIContext, args: TabsArgs) {
    ui.defineComponent(args.id, args, (instance: ui_components.InstanceData<TabsArgs>) => {
        return (): void => {
            let props = instance.props();

            ui.div({
                id: ID_ROOT,
                presets: [
                    presets.col(),
                    presets.wGrow(),
                    presets.hGrow(),
                ],
            }, (): void => {
                // Distinct ids so the two children are separate component
                // instances even though both are handed the same props.
                TabBar(ui, TabsArgs {
                    id: 1,
                    tabs: props.tabs,
                    activeKey: props.activeKey,
                    style: props.style,
                    closable: props.closable,
                    onSelect: props.onSelect,
                    onClose: props.onClose,
                });
                TabPanels(ui, TabsArgs {
                    id: 2,
                    tabs: props.tabs,
                    activeKey: props.activeKey,
                    style: props.style,
                    closable: props.closable,
                    renderTab: props.renderTab,
                });
            });
        };
    });
}
