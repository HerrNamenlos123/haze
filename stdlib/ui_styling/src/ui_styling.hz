
// Concrete, fully-resolved value types (no "unset" representation -- these
// are what a resolved style actually holds, not what a user wrote).

export inline struct Padding {
    left: real = 0.0;
    right: real = 0.0;
    top: real = 0.0;
    bottom: real = 0.0;
}

export inline struct CornerRadius {
    topLeft: real = 0.0;
    topRight: real = 0.0;
    bottomLeft: real = 0.0;
    bottomRight: real = 0.0;
}

export inline struct BorderWidth {
    left: real = 0.0;
    right: real = 0.0;
    top: real = 0.0;
    bottom: real = 0.0;
}

export enum Direction { Row, Column }

// How children are packed along the *main* axis -- the same axis as
// `direction` (X when Row, Y when Column). Named to avoid CSS's
// "justify-content", which says nothing about which axis it means (and
// people reliably confuse it with `crossAlign` below because of that).
export enum Packing { Start, Center, End, SpaceBetween }

// How children are positioned/sized along the *cross* axis -- always the
// axis perpendicular to `direction` (Y when Row, X when Column). Named to
// avoid CSS's "align-items", for the same reason as Packing above.
//   - Start/Center/End: each child keeps its own cross-axis size, positioned
//     within the container's cross-extent.
//   - Stretch: opt-in only, never the default. Children whose cross-axis
//     size is still at its default (SizeMode.Fit) are forced to Grow to
//     fill the container's cross-extent instead; children with an explicit
//     size (Grow or a fixed value) are left alone.
export enum CrossAlign { Start, Center, End, Stretch }

// Whether content larger than this element's box is clipped to it, mirroring
// CSS `overflow` on a per-axis basis. Purely about *painting*: clipping here
// never changes layout, so a clipped child still occupies the size it would
// have had, it simply stops being drawn past the edge.
//   - Visible: the default, exactly as in CSS -- content spills out of the
//     box and is painted in full.
//   - Hidden: content is clipped to this element's bounds (its padding box,
//     the same box CSS clips to). Descendant clips intersect with this one,
//     so nesting composes the way nested overflow:hidden containers do.
// Scrolling is deliberately not a mode here: this element clips, and a
// scroll offset is applied by whoever owns the scroll state (see
// ui_components.ScrollState, whose own Overflow adds Auto/Scroll on top of
// this to decide whether a *scrollbar* is drawn).
export enum Overflow { Visible, Hidden }

// CSS `display`, restricted to the distinction that actually matters here:
// is this element part of the layout at all?
//
//   - Flex: the default. The element is laid out, painted, hit-tested and
//     focusable, exactly as before this enum existed.
//   - None: the element and its whole subtree are removed from layout (they
//     occupy no space and do not affect siblings), are not painted, and are
//     invisible to hit-testing, hover tracking, focus and event dispatch --
//     CSS `display: none`.
//
// The point of None is that it is a STYLE, not an absence: the elements (and
// therefore the components that own them, along with all their state) stay
// alive and keep being declared every frame. That is what makes it the
// equivalent of Vue's `v-show` rather than `v-if` -- see
// headwind.presets.hidden() and ui_components' hidden-subtree skipping.
export enum Display { Flex, None }

// How an element's width/height is determined along one axis.
//   - Fit: wraps tightly to the size of the element's contents. The default
//     when unset, on both axes -- an element with no sized content shrinks
//     to 0 on that axis, which is expected (nothing here mirrors flexbox's
//     "stretch the cross axis" default; every axis behaves the same way).
//   - Grow: expands to fill available space in the parent, sharing it with
//     other Grow elements on the same axis.
//   - a bare real: an exact size in pixels.
//   - _Unset: internal-only sentinel meaning "the user didn't set this" --
//     never construct it directly. It exists only because DivStyle.width/
//     height (below) need three states (unset / mode / fixed value) but
//     can't be a plain `Size?` -- an *optional* multi-member union field
//     (`width?: Size`, or the equivalent written out inline) reliably breaks
//     the compiler: real-literal conversion into it fails outright
//     ("No suitable conversion from real to (none | Size)"), and even where
//     construction slips through, narrowing+comparing it later hits an
//     internal assertion failure (SemanticBuilder.binaryChain). The
//     *non-optional* union (this one) doesn't hit either bug, so "unset"
//     gets folded into the enum instead of expressed via `| none`.
export enum SizeMode { Fit, Grow, _Unset }
export type Size = real | SizeMode;

fn isUnset(s: Size): bool {
    if s is SizeMode { return s == SizeMode._Unset; }
    return false;
}

// Size is a union of two otherwise-unrelated types, so `==` isn't safe to
// use directly between two Size values (the compiler can't tell whether to
// compare as real or as SizeMode) -- this does the variant-aware comparison.
export fn sizeEquals(a: Size, b: Size): bool {
    if a is real {
        if b is real { return a == b; }
        return false;
    }
    if a is SizeMode {
        if b is SizeMode { return a == b; }
        return false;
    }
    return false;
}

// CSS-like out-of-flow positioning, resolved by the layout engine (ui_layout)
// against the element tree, not by anything in this module.
//   - Static: normal flow (default).
//   - Relative: normal flow, but becomes the containing block that a
//     descendant `Absolute` element resolves against if it doesn't name an
//     explicit anchor -- mirrors CSS's "nearest positioned ancestor" rule.
//   - Absolute: out of flow. Resolves against an explicit `anchorTo` target
//     if one is set; otherwise the nearest enclosing Relative/Absolute/Fixed
//     ancestor; otherwise this UI Context's own viewport.
//   - Fixed: out of flow, always relative to this UI Context's own viewport
//     (not a literal OS screen -- a given ui_layout.Context only ever knows
//     about its own root, so this is already scoped correctly for apps with
//     multiple simultaneous UI contexts/canvases).
export enum Position { Static, Relative, Absolute, Fixed }

// The mouse cursor shown while the pointer is over this element -- CSS's
// `cursor` property, and the same vocabulary Tailwind's `cursor-*`
// utilities expose.
//
// Named by INTENT ("this is text you can select", "this is a link"), not by
// picture ("I-beam", "hand"): the actual bitmap is whatever the desktop
// theme uses, which is the entire point of asking the OS for a system
// cursor rather than drawing one.
//
// Like CSS, this INHERITS: an element that doesn't set a cursor shows
// whatever its nearest ancestor that did set one asks for. That's resolved
// at hit-test time by walking the hit path outward (see ui_components's
// resolveCursor), not by a cascade pass over the tree -- the hit path is
// already computed every frame, so inheritance costs nothing extra.
//
// Members map onto SDL3's SDL_SystemCursor, which in turn maps onto the
// platform's native cursors. Only the subset with an unambiguous CSS
// counterpart is exposed; SDL has more (the eight individual resize
// corners), but CSS/Tailwind code doesn't reach for those.
// Values are pinned EXPLICITLY (not left to auto-assignment) because they
// cross an FFI boundary as plain ints: the host casts this to an int and the
// C side indexes a table with it (see sdl_impl.c's
// haze_sdl_system_cursor_for). Reordering these members, or inserting one in
// the middle, silently repoints every cursor after it -- keep the table in
// sdl_impl.c in sync with this list.
export enum Cursor {
    // `cursor: default` -- the ordinary arrow.
    Default = 0,
    // `cursor: pointer` -- a link or anything clickable. (CSS calls the
    // arrow "default" and the hand "pointer"; SDL's constant of the same
    // name means the hand too, but its older releases named it HAND -- don't
    // be misled when cross-referencing.)
    Pointer = 1,
    // `cursor: text` -- selectable text. The I-beam.
    Text = 2,
    // `cursor: wait` / `cursor: progress`.
    Wait = 3,
    Progress = 4,
    // `cursor: crosshair`.
    Crosshair = 5,
    // `cursor: move` -- draggable in any direction.
    Move = 6,
    // `cursor: not-allowed`.
    NotAllowed = 7,
    // `cursor: ns-resize` / `ew-resize` / `nwse-resize` / `nesw-resize`.
    ResizeNS = 8,
    ResizeEW = 9,
    ResizeNWSE = 10,
    ResizeNESW = 11,
}

// Cursor crosses to the platform as a plain int (see the enum's comment).
// Raw C for the same reason hasButton does it: there's no language-level
// enum-to-int conversion.
export fn cursorToInt(cursor: Cursor): int :: final {
    do unsafe {
        let result: int = uninitialized;
        __c__("result = (int)cursor;");
        return result;
    };
}

// top/right/bottom/left offsets, CSS/Tailwind-style -- independent optional
// edges, not Clay's corner-pair attach points (that stays an internal
// ui_layout concern). Only one edge per axis is meaningful: if both left and
// right (or both top and bottom) are set, left/top wins -- there's no Clay
// equivalent of "stretch by opposing offsets" since floating elements are
// never sized from their offsets, only positioned by them.
export inline struct PositionValues {
    top?: real;
    right?: real;
    bottom?: real;
    left?: real;
}

// CSS `translate` / Tailwind `translate-*`: a post-layout shift of this
// element by a multiple of ITS OWN size, applied after everything else has
// placed it. This is the piece top/right/bottom/left cannot express -- those
// offset by absolute pixels against the *containing block*, so "center this
// box on a point" (`left: 50%` + `translate: -50%`) is impossible without a
// term measured in the element's own dimensions.
//
// Units are FRACTIONS OF THE ELEMENT'S OWN SIZE, not pixels and not percent:
// 1.0 means "one full width to the right" / "one full height down", -0.5 means
// "half of my own width to the left". CSS writes those as `100%` and `-50%`;
// this drops the percent so the value is directly the multiplier the layout
// engine applies (`x * width`), with no /100 hiding in the plumbing.
//
// Pixel translation is deliberately NOT a second mode here: an absolute pixel
// shift is exactly what left/top already do, so adding it would be a second
// spelling of an existing feature. The self-relative fraction is the only
// thing this adds.
//
// Like CSS, this NEVER affects layout -- it moves the element (and its
// subtree) at placement time only. Siblings lay out as though the element
// were untranslated, which is what makes it usable for centering and for
// nudging a popup off its anchor without disturbing anything around it.
//
// Also like CSS, translate applies to any positioned element -- resolved by
// ui_layout against Clay's floating offset, so it is only meaningful on an
// element that is actually placed by that path (Absolute/Fixed, or anything
// with an explicit anchorTo()). On a Static/Relative in-flow element it is
// inert, exactly as `translate` on a non-transformable box is in CSS.
export inline struct TranslateValues {
    x: real = 0.0;
    y: real = 0.0;
}

// A hollow anchor handle: created empty (see ui_components.UIContext.anchor),
// handed to a target element's `anchor:` prop, and to any number of other
// elements' `anchorTo()` position op -- in either order. The target element
// registers *itself* (via TypeErasedBox, type-erased here the same way
// ui_elements' own `_runtimeData` is, since this module can't name
// ui_elements.DivElement without an import cycle) the moment it's declared.
// ui_layout resolves it to an actual Clay id off the element's own
// `globalId` field -- not this module's own path string (there isn't one to
// precompute here), and not the component system's own idPath convention
// (scoped per component, reset at each component boundary) either, since
// that one is a differently-scoped string ui_components keeps purely for
// its own diagnostics. `globalId` is the one both sides actually agree on:
// ui_components computes it once, at construction, by extending the
// parent's own globalId (see ui_components.childGlobalId()) -- a
// convention that, unlike the component-local idPath, does count every
// node including a component's own wrapper root, so it's the one Clay
// actually uses.
export type AnchorTarget = rx.ShallowReactive<TypeErasedBox | null>;

// How text behaves when it is wider than the space available.
//
// `Words` (the default, and what CSS does) breaks onto a new visual line
// at word boundaries. `None` lets the text run past its container --
// which is what a code editor, a table cell or any single-line control
// needs: wrapping would move glyphs onto a second visual row, so a
// caret/hit-test that maps x to a column by dividing by the character
// advance would silently address the wrong character.
export enum TextWrap { Words, Newlines, None }

export enum LineHeightMode { Auto, Relative, Pixels }
export struct LineHeight {
    mode: LineHeightMode;
    value: real;
};

// User-facing, all-optional shorthand inputs -- "value" sets all four
// sides/corners at once, "Full" sets them independently. `none` on any
// field of either means "not set".

export inline struct StylePaddingSimple {
    value?: real;
}

export inline struct StylePaddingFull {
    left?: real;
    right?: real;
    top?: real;
    bottom?: real;
}

export type StylePadding = StylePaddingSimple | StylePaddingFull | none;

export inline struct StyleCornerRadiusSimple {
    value?: real;
}

export inline struct StyleCornerRadiusFull {
    topLeft?: real;
    topRight?: real;
    bottomLeft?: real;
    bottomRight?: real;
}

export type StyleCornerRadius = StyleCornerRadiusSimple | StyleCornerRadiusFull | none;

// Independent optional edges, like PositionValues -- not a Simple/Full union
// like padding/cornerRadius above, because border widths must be combinable
// across separate preset calls in the same array (`[presets.borderT(2),
// presets.borderR(4)]`, mirroring Tailwind's `border-t-2 border-r-4`, each
// setting one edge independently) rather than one call replacing the whole
// thing.
export inline struct BorderWidthValues {
    top?: real;
    right?: real;
    bottom?: real;
    left?: real;
}

fn resolvePadding(padding: StylePadding): Padding {
    if padding is StylePaddingSimple {
        let v = padding.value ? padding.value : 0.0;
        return Padding { left: v, right: v, top: v, bottom: v };
    }
    else if padding is StylePaddingFull {
        return Padding {
            left: padding.left ? padding.left : 0.0,
            right: padding.right ? padding.right : 0.0,
            top: padding.top ? padding.top : 0.0,
            bottom: padding.bottom ? padding.bottom : 0.0,
        };
    }
    return Padding {};
}

fn resolveCornerRadius(cornerRadius: StyleCornerRadius): CornerRadius {
    if cornerRadius is StyleCornerRadiusSimple {
        let v = cornerRadius.value ? cornerRadius.value : 0.0;
        return CornerRadius { topLeft: v, topRight: v, bottomLeft: v, bottomRight: v };
    }
    else if cornerRadius is StyleCornerRadiusFull {
        return CornerRadius {
            topLeft: cornerRadius.topLeft ? cornerRadius.topLeft : 0.0,
            topRight: cornerRadius.topRight ? cornerRadius.topRight : 0.0,
            bottomLeft: cornerRadius.bottomLeft ? cornerRadius.bottomLeft : 0.0,
            bottomRight: cornerRadius.bottomRight ? cornerRadius.bottomRight : 0.0,
        };
    }
    return CornerRadius {};
}

fn resolveBorderWidth(values: BorderWidthValues): BorderWidth {
    return BorderWidth {
        left: values.left ? values.left : 0.0,
        right: values.right ? values.right : 0.0,
        top: values.top ? values.top : 0.0,
        bottom: values.bottom ? values.bottom : 0.0,
    };
}

// User-facing raw styles: everything optional, meaning "not set by this
// component" -- computeDivStyle()/computeTextStyle() below are the only
// place that turns "not set" into an actual value.

export inline struct DivStyle {
    // "Unset" is represented in-band via SizeMode._Unset (see its comment),
    // not `?` -- these fields are deliberately non-optional.
    width: Size = SizeMode._Unset;
    height: Size = SizeMode._Unset;
    padding: StylePadding = none;
    direction?: Direction;
    packing?: Packing;
    crossAlign?: CrossAlign;
    cornerRadius: StyleCornerRadius = none;
    gap?: real;
    backgroundColor?: Color;

    // Unset means Flex (laid out normally); see Display. Setting None takes
    // this element and its subtree out of layout, painting and input while
    // keeping them mounted.
    display?: Display;

    // Per-axis clipping of overflowing content -- see Overflow. Unset means
    // Visible, matching CSS's own default.
    overflowX?: Overflow;
    overflowY?: Overflow;

    position?: Position;
    positionValues: PositionValues = {};
    // Non-optional with a 0/0 default, like positionValues above: "no
    // translation" and "translate by zero" are the same thing, so there is
    // nothing for `none` to mean here that 0.0 doesn't already say.
    translate: TranslateValues = {};
    zIndex?: int;
    anchorTarget?: AnchorTarget;

    // Unset means "inherit from an ancestor" (and Default if none set one),
    // which is why this stays optional all the way into ComputedDivStyle --
    // see the note on ComputedDivStyle.cursor.
    cursor?: Cursor;

    borderWidth: BorderWidthValues = {};
    borderColor?: Color;

    fontFamily?: str;
    fontSize?: real;
    fontWeight?: real;
    lineHeight?: LineHeight;
    letterSpacing?: real;
    textColor?: Color;

    fn operator:=(other: DivStyle) {
        this.width = other.width;
        this.height = other.height;
        this.padding = other.padding;
        this.direction = other.direction;
        this.packing = other.packing;
        this.crossAlign = other.crossAlign;
        this.cornerRadius = other.cornerRadius;
        this.gap = other.gap;
        this.backgroundColor = other.backgroundColor;
        this.display = other.display;
        this.overflowX = other.overflowX;
        this.overflowY = other.overflowY;
        this.position = other.position;
        this.positionValues = other.positionValues;
        this.translate = other.translate;
        this.zIndex = other.zIndex;
        this.anchorTarget = other.anchorTarget;
        this.cursor = other.cursor;
        this.borderWidth = other.borderWidth;
        this.borderColor = other.borderColor;
        this.fontFamily = other.fontFamily;
        this.fontSize = other.fontSize;
        this.fontWeight = other.fontWeight;
        this.lineHeight = other.lineHeight;
        this.letterSpacing = other.letterSpacing;
        this.textColor = other.textColor;
    }

    fn operator==(other: DivStyle) {
        return
            sizeEquals(this.width, other.width) &&
            sizeEquals(this.height, other.height) &&
            this.direction == other.direction &&
            this.packing == other.packing &&
            this.crossAlign == other.crossAlign &&
            this.gap == other.gap &&
            this.display == other.display &&
            this.overflowX == other.overflowX &&
            this.overflowY == other.overflowY &&
            this.position == other.position &&
            this.translate.x == other.translate.x &&
            this.translate.y == other.translate.y &&
            this.zIndex == other.zIndex &&
            this.cursor == other.cursor &&
            this.fontFamily == other.fontFamily &&
            this.fontSize == other.fontSize &&
            this.fontWeight == other.fontWeight &&
            this.letterSpacing == other.letterSpacing
        ;
    }

    fn operator!=(other: DivStyle) {
        return !(this == other);
    }
}

export inline struct TextStyle {
    fontFamily?: str;
    fontSize?: real;
    fontWeight?: real;
    lineHeight?: LineHeight;
    letterSpacing?: real;
    textColor?: Color;
    textWrap?: TextWrap;

    fn operator:=(other: TextStyle) {
        this.fontFamily = other.fontFamily;
        this.fontSize = other.fontSize;
        this.fontWeight = other.fontWeight;
        this.lineHeight = other.lineHeight;
        this.letterSpacing = other.letterSpacing;
        this.textColor = other.textColor;
        this.textWrap = other.textWrap;
    }

    fn operator==(other: TextStyle) {
        return
            this.fontFamily == other.fontFamily &&
            this.fontSize == other.fontSize &&
            this.fontWeight == other.fontWeight &&
            this.letterSpacing == other.letterSpacing
        ;
    }

    fn operator!=(other: TextStyle) {
        return !(this == other);
    }
}

// The fully-resolved style ui_elements actually stores. Concrete everywhere
// except where "unset" is a real, meaningful layout state rather than a
// missing default:
//   - width/height: always resolved (default SizeMode.Fit), never "unset".
//   - fontFamily/fontSize/fontWeight/lineHeight/textColor: none means
//     "inherit from ancestor". Resolving inheritance needs the tree (an
//     ancestor's resolved value), which a single element's props can't see
//     in isolation -- that's the layout engine's job, same as today.

export inline struct ComputedDivStyle {
    width: Size = SizeMode.Fit;
    height: Size = SizeMode.Fit;
    padding: Padding = {};
    direction: Direction = Direction.Row;
    packing: Packing = Packing.Start;
    crossAlign: CrossAlign = CrossAlign.Start;
    cornerRadius: CornerRadius = {};
    gap: real = 0.0;
    backgroundColor: Color = {};

    // Resolved from DivStyle.display -- unset there becomes Flex here, so
    // consumers (layout, painting, hit-testing) always get a concrete answer
    // to "does this element participate at all". See Display.
    display: Display = Display.Flex;

    // Resolved from DivStyle.overflowX/Y -- unset there becomes Visible
    // here, so this pair is always a concrete answer to "does this element
    // clip on that axis".
    overflowX: Overflow = Overflow.Visible;
    overflowY: Overflow = Overflow.Visible;

    position: Position = Position.Static;
    positionValues: PositionValues = {};
    translate: TranslateValues = {};
    zIndex: int = 0;
    anchorTarget?: AnchorTarget;

    // Stays OPTIONAL after resolution, unlike overflowX/Y above, because
    // `cursor` inherits: "unset" and "explicitly Default" are different
    // answers. Unset lets an ancestor's cursor win; Default overrides an
    // ancestor back to the plain arrow. Collapsing unset to Default here
    // would make every element opt out of its parent's cursor.
    cursor?: Cursor;

    borderWidth: BorderWidth = {};
    borderColor: Color = {};

    fontFamily?: str;
    fontSize?: real;
    fontWeight?: real;
    lineHeight?: LineHeight;
    letterSpacing?: real;
    textColor?: Color;

    fn operator:=(other: ComputedDivStyle) {
        this.width = other.width;
        this.height = other.height;
        this.padding = other.padding;
        this.direction = other.direction;
        this.packing = other.packing;
        this.crossAlign = other.crossAlign;
        this.cornerRadius = other.cornerRadius;
        this.gap = other.gap;
        this.backgroundColor = other.backgroundColor;
        this.display = other.display;
        this.overflowX = other.overflowX;
        this.overflowY = other.overflowY;
        this.position = other.position;
        this.positionValues = other.positionValues;
        this.translate = other.translate;
        this.zIndex = other.zIndex;
        this.anchorTarget = other.anchorTarget;
        this.cursor = other.cursor;
        this.borderWidth = other.borderWidth;
        this.borderColor = other.borderColor;
        this.fontFamily = other.fontFamily;
        this.fontSize = other.fontSize;
        this.fontWeight = other.fontWeight;
        this.lineHeight = other.lineHeight;
        this.letterSpacing = other.letterSpacing;
        this.textColor = other.textColor;
    }
}

export inline struct ComputedTextStyle {
    fontFamily?: str;
    fontSize?: real;
    fontWeight?: real;
    lineHeight?: LineHeight;
    letterSpacing?: real;
    textColor?: Color;
    textWrap?: TextWrap;

    fn operator:=(other: ComputedTextStyle) {
        this.fontFamily = other.fontFamily;
        this.fontSize = other.fontSize;
        this.fontWeight = other.fontWeight;
        this.lineHeight = other.lineHeight;
        this.letterSpacing = other.letterSpacing;
        this.textColor = other.textColor;
        this.textWrap = other.textWrap;
    }
}

// The preset vocabulary: one op per overridable field, not per preset name.
// ui_styling owns this because it's just ui_styling's own field set restated
// as data -- it never needs to know what produces these or what they're
// called as "presets" (bg/p/gap/...).

export inline struct BackgroundColorOp { color: Color; }
export inline struct TextColorOp { color: Color; }
export inline struct PaddingOp { padding: StylePadding; }
export inline struct GapOp { value: real; }
export inline struct DisplayOp { value: Display; }
// Both axes at once (the CSS `overflow` shorthand); OverflowXOp/OverflowYOp
// are the per-axis longhands.
export inline struct OverflowOp { x: Overflow; y: Overflow; }
export inline struct OverflowXOp { value: Overflow; }
export inline struct OverflowYOp { value: Overflow; }
export inline struct CrossAlignOp { value: CrossAlign; }
export inline struct PackingOp { value: Packing; }
export inline struct DirectionOp { value: Direction; }
export inline struct CornerRadiusOp { cornerRadius: StyleCornerRadius; }
export inline struct WidthOp { value: Size; }
export inline struct HeightOp { value: Size; }
export inline struct PositionOp { value: Position; }
export inline struct TopOp { value: real; }
export inline struct RightOp { value: real; }
export inline struct BottomOp { value: real; }
export inline struct LeftOp { value: real; }
// Per-axis rather than one combined op, for the same reason the border-width
// ops are split: `[presets.translateX(-0.5), presets.translateY(-1.0)]` must
// compose within one array (mirroring Tailwind's `-translate-x-1/2
// -translate-y-full`) instead of the second call replacing the first.
// TranslateOp sets both axes at once -- the `translate-*` shorthand.
export inline struct TranslateOp { x: real; y: real; }
export inline struct TranslateXOp { value: real; }
export inline struct TranslateYOp { value: real; }
export inline struct ZIndexOp { value: int; }
export inline struct AnchorToOp { target: AnchorTarget; }
export inline struct CursorOp { value: Cursor; }
export inline struct BorderWidthOp { value: real; }
export inline struct BorderTopWidthOp { value: real; }
export inline struct BorderRightWidthOp { value: real; }
export inline struct BorderBottomWidthOp { value: real; }
export inline struct BorderLeftWidthOp { value: real; }
export inline struct BorderColorOp { color: Color; }
export inline struct FontFamilyOp { value: str; }
export inline struct FontSizeOp { value: real; }
export inline struct FontWeightOp { value: real; }
export inline struct LineHeightOp { value: LineHeight; }
export inline struct LetterSpacingOp { value: real; }
export inline struct TextWrapOp { value: TextWrap; }

// Text-only ops are a sub-union of the div ops, so a single op value (e.g.
// from presets.textColor(...)) satisfies both `[]TextStyleOp` and
// `[]DivStyleOp` structurally -- no separate vocabularies needed.
export type TextStyleOp =
    TextColorOp | FontFamilyOp | FontSizeOp | FontWeightOp | LineHeightOp | LetterSpacingOp
    | TextWrapOp;

// Flat (not nested) so a TextStyleOp member's value -- e.g. from
// presets.textColor(...) -- is directly usable wherever DivStyleOp is
// expected too: union membership doesn't see through a nested union, so
// `TextStyleOp | ...` here wouldn't actually include its variants.
export type DivStyleOp =
    BackgroundColorOp | TextColorOp | PaddingOp | GapOp | CrossAlignOp | PackingOp
    | DisplayOp
    | OverflowOp | OverflowXOp | OverflowYOp
    | DirectionOp | CornerRadiusOp | WidthOp | HeightOp
    | PositionOp | TopOp | RightOp | BottomOp | LeftOp
    | TranslateOp | TranslateXOp | TranslateYOp
    | ZIndexOp | AnchorToOp | CursorOp
    | BorderWidthOp | BorderTopWidthOp | BorderRightWidthOp | BorderBottomWidthOp | BorderLeftWidthOp
    | BorderColorOp | TextWrapOp
    | FontFamilyOp | FontSizeOp | FontWeightOp | LineHeightOp | LetterSpacingOp;

// Applies `ops` onto `raw`, with explicitly-set fields on `raw` always
// winning over a preset op for the same field (presets only fill gaps),
// then resolves the result into a ComputedDivStyle. One flat exhaustive
// match, plain data in and out -- no function pointers, fully inlinable.
// `ops` is optional (rather than requiring an empty array when a caller has
// no presets) purely so callers like ui_components.div() can pass their own
// already-optional `props.presets` straight through, with nothing to
// allocate at all in the common no-presets case.
export fn computeDivStyle(raw: DivStyle, ops: []DivStyleOp | none): ComputedDivStyle {
    let working: inline DivStyle = raw;

    if ops is not none {
        for op in ops {
            if op is BackgroundColorOp { if !working.backgroundColor { working.backgroundColor = op.color; } }
            else if op is TextColorOp { if !working.textColor { working.textColor = op.color; } }
            else if op is PaddingOp { if !working.padding { working.padding = op.padding; } }
            else if op is GapOp { if !working.gap { working.gap = op.value; } }
            else if op is DisplayOp { if !working.display { working.display = op.value; } }
            else if op is OverflowOp {
                if !working.overflowX { working.overflowX = op.x; }
                if !working.overflowY { working.overflowY = op.y; }
            }
            else if op is OverflowXOp { if !working.overflowX { working.overflowX = op.value; } }
            else if op is OverflowYOp { if !working.overflowY { working.overflowY = op.value; } }
            else if op is CrossAlignOp { if !working.crossAlign { working.crossAlign = op.value; } }
            else if op is PackingOp { if !working.packing { working.packing = op.value; } }
            else if op is DirectionOp { if !working.direction { working.direction = op.value; } }
            else if op is CornerRadiusOp { if !working.cornerRadius { working.cornerRadius = op.cornerRadius; } }
            else if op is WidthOp { if isUnset(working.width) { working.width = op.value; } }
            else if op is HeightOp { if isUnset(working.height) { working.height = op.value; } }
            else if op is PositionOp { if !working.position { working.position = op.value; } }
            else if op is TopOp { if !working.positionValues.top { working.positionValues.top = op.value; } }
            else if op is RightOp { if !working.positionValues.right { working.positionValues.right = op.value; } }
            else if op is BottomOp { if !working.positionValues.bottom { working.positionValues.bottom = op.value; } }
            else if op is LeftOp { if !working.positionValues.left { working.positionValues.left = op.value; } }
            // "Not set by the component" is 0.0 here (the field's own
            // default), so a preset only fills in an axis the raw style left
            // at zero -- the same fill-the-gaps rule every other op follows.
            // Translating by an explicit 0.0 and not translating at all are
            // the same placement, so nothing is lost by conflating them.
            else if op is TranslateOp {
                if working.translate.x == 0.0 { working.translate.x = op.x; }
                if working.translate.y == 0.0 { working.translate.y = op.y; }
            }
            else if op is TranslateXOp { if working.translate.x == 0.0 { working.translate.x = op.value; } }
            else if op is TranslateYOp { if working.translate.y == 0.0 { working.translate.y = op.value; } }
            else if op is ZIndexOp { if !working.zIndex { working.zIndex = op.value; } }
            else if op is AnchorToOp { if !working.anchorTarget { working.anchorTarget = op.target; } }
            else if op is CursorOp { if !working.cursor { working.cursor = op.value; } }
            else if op is BorderWidthOp {
                if !working.borderWidth.top { working.borderWidth.top = op.value; }
                if !working.borderWidth.right { working.borderWidth.right = op.value; }
                if !working.borderWidth.bottom { working.borderWidth.bottom = op.value; }
                if !working.borderWidth.left { working.borderWidth.left = op.value; }
            }
            else if op is BorderTopWidthOp { if !working.borderWidth.top { working.borderWidth.top = op.value; } }
            else if op is BorderRightWidthOp { if !working.borderWidth.right { working.borderWidth.right = op.value; } }
            else if op is BorderBottomWidthOp { if !working.borderWidth.bottom { working.borderWidth.bottom = op.value; } }
            else if op is BorderLeftWidthOp { if !working.borderWidth.left { working.borderWidth.left = op.value; } }
            else if op is BorderColorOp { if !working.borderColor { working.borderColor = op.color; } }
            else if op is FontFamilyOp { if !working.fontFamily { working.fontFamily = op.value; } }
            else if op is FontSizeOp { if !working.fontSize { working.fontSize = op.value; } }
            else if op is FontWeightOp { if !working.fontWeight { working.fontWeight = op.value; } }
            else if op is LineHeightOp { if !working.lineHeight { working.lineHeight = op.value; } }
            else if op is LetterSpacingOp { if !working.letterSpacing { working.letterSpacing = op.value; } }
        }
    }

    let result = ComputedDivStyle {
        padding: resolvePadding(working.padding),
        cornerRadius: resolveCornerRadius(working.cornerRadius),
        positionValues: working.positionValues,
        translate: working.translate,
        anchorTarget: working.anchorTarget,
        cursor: working.cursor,
        borderWidth: resolveBorderWidth(working.borderWidth),
        fontFamily: working.fontFamily,
        fontSize: working.fontSize,
        fontWeight: working.fontWeight,
        lineHeight: working.lineHeight,
        letterSpacing: working.letterSpacing,
        textColor: working.textColor,
    };
    if !isUnset(working.width) { result.width = working.width; }
    if !isUnset(working.height) { result.height = working.height; }
    if working.direction { result.direction = working.direction; }
    if working.packing { result.packing = working.packing; }
    if working.crossAlign { result.crossAlign = working.crossAlign; }
    if working.gap { result.gap = working.gap; }
    if working.backgroundColor { result.backgroundColor = working.backgroundColor; }
    if working.display { result.display = working.display; }
    if working.overflowX { result.overflowX = working.overflowX; }
    if working.overflowY { result.overflowY = working.overflowY; }
    if working.position { result.position = working.position; }
    if working.zIndex { result.zIndex = working.zIndex; }
    if working.borderColor { result.borderColor = working.borderColor; }
    return result;
}

// ops is optional -- see computeDivStyle's own comment.
export fn computeTextStyle(raw: TextStyle, ops: []TextStyleOp | none): ComputedTextStyle {
    let working: inline TextStyle = raw;

    if ops is not none {
        for op in ops {
            if op is TextColorOp { if !working.textColor { working.textColor = op.color; } }
            else if op is TextWrapOp { if !working.textWrap { working.textWrap = op.value; } }
            else if op is FontFamilyOp { if !working.fontFamily { working.fontFamily = op.value; } }
            else if op is FontSizeOp { if !working.fontSize { working.fontSize = op.value; } }
            else if op is FontWeightOp { if !working.fontWeight { working.fontWeight = op.value; } }
            else if op is LineHeightOp { if !working.lineHeight { working.lineHeight = op.value; } }
            else if op is LetterSpacingOp { if !working.letterSpacing { working.letterSpacing = op.value; } }
        }
    }

    return ComputedTextStyle {
        fontFamily: working.fontFamily,
        fontSize: working.fontSize,
        fontWeight: working.fontWeight,
        lineHeight: working.lineHeight,
        letterSpacing: working.letterSpacing,
        textColor: working.textColor,
    };
}
