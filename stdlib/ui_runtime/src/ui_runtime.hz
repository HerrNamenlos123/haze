import ui_elements;
import ui_styling;
import ui_layout;
import ui_components;
import renderer;

export struct RuntimeArgs {
    gfx: mut renderer.gfx.Context;
    windowState: renderer.gfx.CanvasSize;
    fonts: []ui_layout.FontEntry;
    mousePos: () => Vec2;
    // Optional: whether mousePos() is meaningful yet. See
    // ui_components.UIContext.mousePosKnown -- omitting it means the
    // pointer position is always trusted, which is the old behavior.
    mousePosKnown?: ui_components.MousePosKnownCallback;
    pointerButtons?: ui_components.PointerHeldCallbacks;
    inputExtras?: ui_components.InputExtrasCallbacks;
    keyboard?: ui_components.KeyboardCallbacks;
    setCursor?: ui_components.CursorCallback;
    // The platform clipboard, for widgets that cut/copy/paste. Optional like
    // the rest: omit it and ui.hasClipboard() reports false, which widgets
    // read as "fall back to whatever register you keep yourself".
    clipboard?: ui_components.ClipboardCallbacks;
    ui: (ui: ui_components.UIContext) => none;
}

// The single module that names ui_layout, ui_components and renderer all at
// once -- everything else stays loosely coupled (ui_components never heard
// of Clay/flexbox, ui_layout never heard of the component system or WGPU,
// renderer never heard of either). Swap this module out for a different
// Runtime to retarget the same ui_components-authored UI onto a different
// layout engine or renderer without touching application code or any of
// the other modules.
export opaque ref struct Runtime {
    gfx: mut renderer.gfx.Context;
    layout: mut ui_layout.Context;
    ui: mut ui_components.UIContext;
    dpiScale: real;
    // The screen Renderer, kept for the Runtime's lifetime and re-armed each
    // frame (see Renderer.reset) rather than rebuilt. Its contents are still
    // fully rebuilt every frame -- only the arrays' backing storage survives.
    screenRenderer?: mut renderer.gfx.Renderer;
    // The Frame of the render pass currently in progress -- set for the
    // duration of render() only. It exists so the render callbacks below can
    // be plain METHODS of this Runtime instead of lambdas: a bound method
    // passed as a callable uses the receiver pointer itself as its env and
    // allocates nothing, while a lambda that captures `frame`/`r`/`this`
    // heap-allocates a closure env on every single frame, per callback.
    currentFrame?: mut renderer.gfx.Frame;

    fn constructor(args: RuntimeArgs) {
        let layout = ui_layout.Context({
            width: args.windowState.logicalSize.x,
            height: args.windowState.logicalSize.y,
            fonts: args.fonts,
            getFontLineHeight: (fontId: int, fontSize: real): real => {
                let metrics = args.gfx.fontRenderer.fs.getMetrics(fontId, fontSize as f32);
                return metrics.lineh;
            },
            measureText: (fontId: int, fontSize: real, text: str): Vec2 => {
                let dims = args.gfx.fontRenderer.fs.measureText(fontId, fontSize, text);
                return Vec2(dims.width, dims.height);
            },
        });
        let ui = ui_components.UIContext({
            ui: args.ui,
            mousePos: args.mousePos,
            mousePosKnown: args.mousePosKnown,
            pointerButtons: args.pointerButtons,
            inputExtras: args.inputExtras,
            keyboard: args.keyboard,
            setCursor: args.setCursor,
            clipboard: args.clipboard,
            measureText: (fontFamily: str, fontSize: real, text: str): Vec2 => {
                return layout.measureText(fontFamily, fontSize, text);
            },
        });
        return Runtime {
            gfx: args.gfx,
            layout: layout,
            ui: ui,
            dpiScale: args.windowState.dpiScale as real,
        };
    }

    // Measures a standalone run of text (e.g. a single word or label) by
    // font family name -- the same font-name resolution and real
    // glyph-advance measurement the layout engine itself uses during a
    // render pass, but callable any time (before the first frame, from an
    // event handler, ...), not just while a UI tree is being built. Use
    // ui.measureText() instead from inside component code, which doesn't
    // have direct access to this Runtime handle.
    fn measureText(fontFamily: str, fontSize: real, text: str): Vec2 {
        return this.layout.measureText(fontFamily, fontSize, text);
    }

    // Call whenever the render target's logical size or DPI scale changes.
    fn resize(windowState: renderer.gfx.CanvasSize) {
        this.dpiScale = windowState.dpiScale as real;
        this.layout.setLayoutSize(windowState.logicalSize.x, windowState.logicalSize.y);
    }

    // Runs this frame's component tree + flexbox layout, drawing the result
    // into `canvas` through a fresh Renderer recorded into `frame`'s shared
    // encoder. Caller owns `frame`/`canvas` (and presents the frame exactly
    // once, after however many Canvases -- screen or offscreen -- it draws
    // this way), since those are renderer-module concerns this runtime has
    // no opinion about.
    fn render(frame: mut renderer.gfx.Frame, canvas: mut renderer.gfx.Canvas) {
        if !this.screenRenderer {
            this.screenRenderer = renderer.gfx.Renderer(frame, canvas);
        }
        let cachedRenderer = this.screenRenderer;
        assert(cachedRenderer);
        let r = cachedRenderer;
        // Idempotent on a just-constructed Renderer -- reset() leaves exactly
        // the state the constructor does -- so this one line covers both paths.
        r.reset(frame, canvas);
        this.currentFrame = frame;
        let tree = this.ui.process();
        if !tree {
            r.commit();
            this.currentFrame = none;
            return;
        }

        // Bound methods, deliberately not lambdas: see currentFrame. Every
        // callback reaches the renderer through this.screenRenderer (see
        // activeRenderer()) and the frame through this.currentFrame.
        this.layout.render(tree, {
            renderFilledRectangle: this.renderFilledRectangle,
            renderText: this.renderText,
            onBoundingBox: this.onBoundingBox,
            renderCanvas: this.renderCanvas,
            setClip: this.setClip,
            renderBorder: this.renderBorder,
        });

        this.currentFrame = none;
        r.commit();
    }

    // ── render callbacks (see render()) ──────────────────────────────────

    // The screen Renderer while a render pass is in progress. Only ever
    // called from the callbacks below, which ui_layout.render invokes
    // synchronously from inside render() -- so both fields are always set.
    fn activeRenderer(): mut renderer.gfx.Renderer {
        let r = this.screenRenderer;
        assert(r);
        return r;
    }

    fn renderFilledRectangle(position: Vec2, size: Vec2, backgroundColor: Color, cornerRadius: ui_layout.CornerRadiusValues): void {
        this.activeRenderer().drawRect({
            pos: position,
            size: size,
            fillColor: backgroundColor,
            cornerRadius: {
                topLeft: cornerRadius.topLeft,
                topRight: cornerRadius.topRight,
                bottomLeft: cornerRadius.bottomLeft,
                bottomRight: cornerRadius.bottomRight,
            },
        });
    }

    fn renderText(element: ui_layout.ffi.hzui_draw_text_element_t): void {
        this.activeRenderer().drawText({
            font: element.fontId,
            size: element.fontSize,
            position: element.position,
            text: element.text,
            color: element.color,
        });
    }

    fn onBoundingBox(element: ui_elements.Element, pos: Vec2, size: Vec2): void {
        ui_components.applyRenderFeedback(element, pos, size);
    }

    fn renderCanvas(element: ui_elements.CanvasElement): void {
        let frame = this.currentFrame;
        assert(frame);
        this.renderCanvasElement(element, frame, this.activeRenderer());
    }

    // Arrives already intersected through every clipping ancestor
    // (see ui_layout.collectClipsRecursive), so this just replaces
    // whatever was set for the previous draw rather than maintaining
    // a stack. setClipRect takes the same screen-space min/max the
    // per-primitive clipRect is stored as.
    fn setClip(clip: ui_layout.ResolvedClip): void {
        if clip.active {
            this.activeRenderer().setClipRect(clip.minX, clip.minY, clip.maxX, clip.maxY);
        }
        else {
            this.activeRenderer().clearClipRect();
        }
    }

    fn renderBorder(position: Vec2, size: Vec2, borderColor: Color, cornerRadius: ui_layout.CornerRadiusValues, borderWidth: ui_layout.ffi.hzui_border_widths_t): void {
        this.activeRenderer().drawRect({
            pos: position,
            size: size,
            fillColor: Color(0.0, 0.0, 0.0, 0.0),
            cornerRadius: {
                topLeft: cornerRadius.topLeft,
                topRight: cornerRadius.topRight,
                bottomLeft: cornerRadius.bottomLeft,
                bottomRight: cornerRadius.bottomRight,
            },
            borderColor: borderColor,
            borderWidths: {
                top: borderWidth.top,
                right: borderWidth.right,
                bottom: borderWidth.bottom,
                left: borderWidth.left,
            },
        });
    }

    fn renderCanvasElement(element: ui_elements.CanvasElement, frame: mut renderer.gfx.Frame, screenRenderer: mut renderer.gfx.Renderer) {
        let data = ui_components.runtimeDataOf(element);
        let feedback = data.renderFeedback;
        assert(feedback);
        let size = feedback.size;

        let fbSize = Vec2i(
            (size.x * this.dpiScale) as i32,
            (size.y * this.dpiScale) as i32
        );
        if fbSize.x <= 0 || fbSize.y <= 0 {
            return;
        }

        let canvasSize = renderer.gfx.CanvasSize {
            logicalSize: Vec2i(size.x as i32, size.y as i32),
            framebufferSize: fbSize,
            dpiScale: this.dpiScale as f32,
        };

        if !data.handle {
            let offscreen = renderer.gfx.Canvas({ gfx: this.gfx, size: canvasSize, msaaSamples: data.msaaSamples, postEffect: data.postEffect });
            let handle = ui_components.CanvasHandle { canvas: offscreen };
            data.handle = TypeErasedBox<ui_components.CanvasHandle>(handle);

            // A brand new offscreen texture has undefined contents --
            // always start it from transparent before anything else
            // touches it this frame.
            renderer.gfx.Renderer(frame, handle.canvas).commit(true);

            this.drawCanvasAndComposite(data.drawFn, handle, feedback, size, frame, screenRenderer);
        } else {
            let handle = data.handle.get<ui_components.CanvasHandle>();
            if handle.canvas.size.framebufferSize.x != fbSize.x || handle.canvas.size.framebufferSize.y != fbSize.y {
                handle.canvas.resize(canvasSize);
                // A freshly resized texture has undefined contents too.
                renderer.gfx.Renderer(frame, handle.canvas).commit(true);
            }
            this.drawCanvasAndComposite(data.drawFn, handle, feedback, size, frame, screenRenderer);
        }
    }

    // Runs this frame's declarative drawFn (if any) into the canvas
    // element's offscreen canvas, then composites its current content onto
    // `screenRenderer` at the element's current bounding box.
    fn drawCanvasAndComposite(drawFnBox: TypeErasedBox | none, handle: ui_components.CanvasHandle, feedback: ui_components.RenderFeedback, size: Vec2, frame: mut renderer.gfx.Frame, screenRenderer: mut renderer.gfx.Renderer) {
        if drawFnBox {
            let r = renderer.gfx.Renderer(frame, handle.canvas);
            ui_components.runCanvasDrawFn(drawFnBox, r);
            r.commit(true);
        }

        screenRenderer.drawTexture({
            texture: handle.canvas.asTexture(),
            pos: feedback.position,
            size: size,
        });
    }
}
