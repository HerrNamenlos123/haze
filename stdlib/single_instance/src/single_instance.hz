import sha256

__c__("#include \"ffi/haze_single_instance.c\"");
export __c__("#include \"ffi/public/haze_single_instance.h\"");

namespace ffi {
    export extern C noemit struct haze_si_acquire_result_t {
        role: i32;
        error: str;
    }

    export extern C noemit struct haze_si_send_result_t {
        status: i32;
        exitCode: i32;
        message: str;
    }

    export extern C noemit struct haze_si_take_result_t {
        hasRequest: bool;
        value: cptr;
    }

    export extern C fn haze_si_user_key(): str :: final;
    // `entry` is called on the server thread with `thunk` and each request's
    // JSON (see haze_si_parse_entry).
    export extern C fn haze_si_set_parser(entry: extern C (thunk: cptr, text: str) -> cptr, thunk: cptr): void :: final;
    export extern C fn haze_si_acquire(key: str, mangledName: str, fingerprint: int, prettyName: str): haze_si_acquire_result_t :: final;
    export extern C fn haze_si_send(json: str): haze_si_send_result_t :: final;
    export extern C fn haze_si_take(): haze_si_take_result_t :: final;
    export extern C fn haze_si_respond(exitCode: int): void :: final;
    export extern C fn haze_si_release(): void :: final;
}

export enum unscoped Status {
    Primary = 0,
    Secondary = 1,
    Error = 2,
}

export enum unscoped SendStatus {
    Delivered = 0,
    Rejected = 1,
    Failed = 2,
}

export struct Args {
    appId: str;
}

export struct SendResult {
    status: SendStatus = SendStatus.Failed;
    exitCode: int = 1;
    message: str = "";
}

export fn _parsePayload<T>(text: str): cptr {
    let parsed = json.parse<T>(text);
    if !parsed {
        return none as cptr;
    }

    let boxed: ref Box<T> = { value: parsed };
    let raw = none as cptr;
    __c__("raw = boxed;");
    return raw;
}

export fn _unboxPayload<T>(raw: cptr): T {
    do unsafe {
        let boxed: ref Box<T> = uninitialized;
        __c__("boxed = raw;");
        return boxed.value;
    };
}

// The payload parser, as the C server thread calls it. That thread is not one
// Haze started and nothing on it has a context to hand over, so the parse runs
// under a fresh one. `thunk` is the type-specific parser init<T> registered
// (_parsePayload<T>, boxed by _setParser): a generic cannot be `extern C`, so
// this one entry reaches it through the box.
extern C fn haze_si_parse_entry(thunk: cptr, text: str): cptr {
    do unsafe {
        let parser: ref Box<(text: str) -> cptr> = uninitialized;
        __c__("parser = thunk;");
        return Context.init(Context(), (): cptr => {
            return parser.value(text);
        });
    };
}

// Registers the parser init<T> made for its T. Not generic: the parser's type
// no longer mentions T, and only code compiled in this module names the
// `extern C` entry.
export fn _setParser(parser: (text: str) -> cptr) {
    let boxed: ref Box<(text: str) -> cptr> = { value: parser };
    let thunk = none as cptr;
    __c__("thunk = boxed;");
    ffi.haze_si_set_parser(haze_si_parse_entry, thunk);
}

export struct Instance<T> {
    status: Status = Status.Error;
    error: str = "";
    onActivate: (data: T) => int;

    fn poll() {
        if this.status != Status.Primary {
            return;
        }

        let taken = ffi.haze_si_take();
        if !taken.hasRequest {
            return;
        }

        let value = _unboxPayload<T>(taken.value);
        let exitCode = this.onActivate(value);
        ffi.haze_si_respond(exitCode);
    }

    fn send(data: T): SendResult {
        if this.status != Status.Secondary {
            return SendResult { message: "send() is only valid for a secondary instance" };
        }

        let encoded = json.stringify<T>(data);
        let raw = ffi.haze_si_send(encoded);

        let status = SendStatus.Failed;
        if raw.status == 0 {
            status = SendStatus.Delivered;
        }
        else if raw.status == 1 {
            status = SendStatus.Rejected;
        }

        return SendResult {
            status: status,
            exitCode: raw.exitCode as int,
            message: raw.message,
        };
    }

    fn release() {
        if this.status == Status.Primary {
            ffi.haze_si_release();
            this.status = Status.Error;
        }
    }
}

export fn init<T>(args: Args, onActivate: (data: T) => int): Instance<T> {
    let userKey = ffi.haze_si_user_key();
    let key = sha256.hex(f"{userKey}|{args.appId}");

    _setParser(_parsePayload<T>);

    let acquired = ffi.haze_si_acquire(key, T.mangledName, T.fingerprint, T.prettyName);

    let status = Status.Error;
    if acquired.role == 0 {
        status = Status.Primary;
    }
    else if acquired.role == 1 {
        status = Status.Secondary;
    }

    return Instance<T> {
        status: status,
        error: acquired.error,
        onActivate: onActivate,
    };
}
