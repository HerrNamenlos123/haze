
__c__("#include \"ffi/filedialog.c\"");

namespace filedialog_ffi {
    extern C noemit enum unscoped hz_filedialog_result_t {
        hz_filedialog_result_ok = 1,
        hz_filedialog_result_cancel = 2,
        hz_filedialog_result_error = 3,
    }

    extern C noemit struct hz_filedialog_path_result_t {
        result: hz_filedialog_result_t;
        path: str;
        error: str;
    };

    extern C noemit struct hz_filedialog_multiple_result_t {
        result: hz_filedialog_result_t;
        error: str;
    };

    extern C fn hz_filedialog_open_dialog(filters: str, defaultPath: str): hz_filedialog_path_result_t :: final;
    extern C fn hz_filedialog_open_dialog_multiple(filters: str, defaultPath: str, outPaths: []str): hz_filedialog_multiple_result_t :: final;
    extern C fn hz_filedialog_save_dialog(filters: str, defaultPath: str): hz_filedialog_path_result_t :: final;
    extern C fn hz_filedialog_open_folder_dialog(defaultPath: str): hz_filedialog_path_result_t :: final;
}

export struct DialogOpenArgs {
    // Filters = String with filters for file extensions
    // Example: "jpg,png;txt;exe"
    // , -> Delimiter for extensions within a single filter
    // ; -> Delimiter between filters
    // TODO: Make the filters structural so it is easier to understand and hide this internal format
    filters: str = "";
    defaultPath: str = "";
}

export struct DialogOpenFolderArgs {
    defaultPath: str = "";
}

export ref struct DialogSuccess {
    path: str;
}

export ref struct DialogMultipleSuccess {
    paths: []str;
}

export ref struct DialogCancel {}

export ref struct DialogError {
    error: str;
}

export type DialogResult = DialogSuccess | DialogCancel | DialogError;
export type DialogMultipleResult = DialogMultipleSuccess | DialogCancel | DialogError;

export fn pickFile(args: DialogOpenArgs = {}): DialogResult {
    let result = filedialog_ffi.hz_filedialog_open_dialog(args.filters, args.defaultPath);
    if result.result == filedialog_ffi.hz_filedialog_result_ok {
        return DialogSuccess { path: result.path };
    }
    else if result.result == filedialog_ffi.hz_filedialog_result_cancel {
        return DialogCancel {};
    }
    else {
        return DialogError { error: result.error };
    }
}

export fn saveFile(args: DialogOpenArgs = {}): DialogResult {
    let result = filedialog_ffi.hz_filedialog_save_dialog(args.filters, args.defaultPath);
    if result.result == filedialog_ffi.hz_filedialog_result_ok {
        return DialogSuccess { path: result.path };
    }
    else if result.result == filedialog_ffi.hz_filedialog_result_cancel {
        return DialogCancel {};
    }
    else {
        return DialogError { error: result.error };
    }
}

export fn pickFilesMultiple(args: DialogOpenArgs = {}): DialogMultipleResult {
    let outPaths: []str = [];

    let result = filedialog_ffi.hz_filedialog_open_dialog_multiple(args.filters, args.defaultPath, outPaths);
    if result.result == filedialog_ffi.hz_filedialog_result_ok {
        return DialogMultipleSuccess { paths: outPaths };
    }
    else if result.result == filedialog_ffi.hz_filedialog_result_cancel {
        return DialogCancel {};
    }
    else {
        return DialogError { error: result.error };
    }
}

export fn pickFolder(args: DialogOpenFolderArgs = {}): DialogResult {
    let result = filedialog_ffi.hz_filedialog_open_folder_dialog(args.defaultPath);
    if result.result == filedialog_ffi.hz_filedialog_result_ok {
        return DialogSuccess { path: result.path };
    }
    else if result.result == filedialog_ffi.hz_filedialog_result_cancel {
        return DialogCancel {};
    }
    else {
        return DialogError { error: result.error };
    }
}