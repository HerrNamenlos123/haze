__c__("#include \"ffi/haze_image.c\"");
export __c__("#include \"ffi/public/haze_image.h\"");

namespace ffi {
    export extern C fn haze_image_load_memory(data: cptr, length: int, desiredChannels: int): haze_image_result_t :: final;
    export extern C fn haze_image_failure_reason(): str :: final;
    export extern C fn haze_image_encode_png(pixels: cptr, width: int, height: int, channels: int): haze_image_png_result_t :: final;
    export extern C fn haze_image_decode_start(data: cptr, length: int, desiredChannels: int): cptr :: final;
    export extern C fn haze_image_decode_done(job: cptr): bool :: final;
    export extern C fn haze_image_decode_result(job: cptr): haze_image_result_t :: final;
    export extern C fn haze_image_decode_failure(job: cptr): str :: final;
    export extern C fn haze_image_info(data: cptr, length: int): haze_image_info_t :: final;
    export extern C fn haze_image_png_start(data: cptr, length: int, pixels: cptr, width: int, height: int, channels: int): cptr :: final;
    export extern C fn haze_image_png_done(job: cptr): bool :: final;
    export extern C fn haze_image_png_result(job: cptr): haze_image_png_result_t :: final;
    export extern C fn haze_image_png_failure(job: cptr): str :: final;

    export extern C noemit struct haze_image_result_t {
        pixels: cptr;
        width: int;
        height: int;
        channels: int;
        sourceChannels: int;
    }

    export extern C noemit struct haze_image_png_result_t {
        data: cptr;
        length: int;
    }

    export extern C noemit struct haze_image_info_t {
        ok: bool;
        width: int;
        height: int;
        channels: int;
    }
}

export ref struct Error {
    message: str;
}

// Decoded once at construction into GC-owned memory (see haze_image.c) --
// there is deliberately no destroy()/free() here: `pixels` behaves like any
// other GC-managed Bytes and is reclaimed automatically once unreachable.
export opaque ref struct Image {
    width: int;
    height: int;
    channels: int;       // channel count of the returned pixel buffer
    sourceChannels: int; // channel count found in the source file
    pixels: Bytes;        // width * height * channels, row-major top-to-bottom,
                          // 8 bits per channel -- ready for a GPU texture upload
                          // (e.g. wgpu writeTexture) once a WebGPU binding builds on top.

    // desiredChannels: 0 keeps whatever channel count the file itself has
    // (see Image.sourceChannels); 1=grey, 2=grey+alpha, 3=RGB, 4=RGBA.
    // Defaults to RGBA since that's what a GPU texture upload usually wants.
    //
    // Both constructors panic on a file that doesn't decode, which suits
    // assets shipped with the program. For data from outside -- a download,
    // a paste -- use decode(), which reports it instead.
    fn constructor(path: str, desiredChannels: int = 4) {
        if let d = fs.readBinary(path) {
            return Image.fromMemory(path, d, desiredChannels);
        }
        sys.panic(f"Failed to load image: could not read file '{path}'");
    }

    fn constructor(data: Bytes, desiredChannels: int = 4) {
        return Image.fromMemory("<memory>", data, desiredChannels);
    }

    static fn fromMemory(label: str, data: Bytes, desiredChannels: int): Image {
        let decoded = Image.decode(data, desiredChannels);
        if decoded {
            return decoded;
        }
        sys.panic(f"Failed to decode image '{label}': {decoded.message}");
    }

    // The body of decode() below; a method because an opaque struct can only
    // be built inside its own definition.
    static fn decode(data: Bytes, desiredChannels: int): Result<Image, Error> {
        if desiredChannels < 0 || desiredChannels > 4 {
            return Error { message: f"desiredChannels must be 0 to 4, not {desiredChannels}" };
        }

        // A one-byte Bytes holds its byte inline and has no buffer to point
        // at; hand C a pointer to a copy instead.
        let single: u8 = 0;
        let ptr = none as cptr;
        let length = data.length;
        if length == 1 {
            single = data[0];
            __c__("ptr = &single;");
        }
        else {
            __c__("ptr = data.basePtr + data.offset;");
        }

        let result = ffi.haze_image_load_memory(ptr, length, desiredChannels);

        let valid = false;
        __c__("valid = result.pixels != NULL;");
        if !valid {
            return Error { message: ffi.haze_image_failure_reason() };
        }
        return Image.fromDecoded(result);
    }

    // Wraps what haze_image_load_memory decoded, which has pixels.
    static fn fromDecoded(result: ffi.haze_image_result_t): Result<Image, Error> {
        do unsafe {
            // Bytes() rather than `uninitialized`: Bytes has more fields than
            // the three set below, and a garbage singleByte reads as present,
            // so every pixels[i] would return it instead of the buffer.
            let pixels = Bytes();
            __c__("pixels.basePtr = result.pixels;");
            __c__("pixels.offset = 0;");
            __c__("pixels.length = result.width * result.height * result.channels;");

            let image = Image {
                width: result.width,
                height: result.height,
                channels: result.channels,
                sourceChannels: result.sourceChannels,
                pixels: pixels,
            };
            return Result<Image, Error>.Ok(image);
        };
    }

    // Wraps pixels that are already decoded -- rendered, captured, or taken
    // from a clipboard bitmap -- in the same layout decoding produces:
    // width * height * channels bytes, rows top to bottom. Panics if the
    // buffer is the wrong size for the dimensions, which is a programming
    // error rather than bad input.
    static fn fromPixels(width: int, height: int, channels: int, pixels: Bytes): Image {
        if width <= 0 || height <= 0 || channels < 1 || channels > 4 {
            sys.panic(f"Image.fromPixels: invalid shape {width}x{height} with {channels} channels");
        }
        if pixels.length != width * height * channels {
            sys.panic(f"Image.fromPixels: {width}x{height}x{channels} needs {width * height * channels} bytes, got {pixels.length}");
        }
        return Image {
            width: width,
            height: height,
            channels: channels,
            sourceChannels: channels,
            pixels: pixels,
        };
    }
}

// An image being decoded on a worker thread -- see decodeAsync.
export opaque ref struct ImageDecode {
    job: cptr;
    // The encoded image, which the worker reads until it is done.
    data: Bytes;

    static fn start(data: Bytes, desiredChannels: int): ImageDecode {
        // A one-byte Bytes holds its byte inline (see Image.decode), where
        // the worker could not read it once this returns -- and one byte is
        // no image anyway, so the worker is given none, and says so.
        let ptr = none as cptr;
        let length = data.length;
        if length == 1 {
            length = 0;
        }
        else {
            __c__("ptr = data.basePtr + data.offset;");
        }
        return ImageDecode {
            job: ffi.haze_image_decode_start(ptr, length, desiredChannels),
            data: data,
        };
    }

    fn done(): bool {
        return ffi.haze_image_decode_done(this.job);
    }

    // What decode() would have returned. Panics before done().
    fn result(): Result<Image, Error> {
        if !this.done() {
            sys.panic("ImageDecode.result() before the image is decoded -- check done() first");
        }
        let result = ffi.haze_image_decode_result(this.job);
        let valid = false;
        __c__("valid = result.pixels != NULL;");
        if !valid {
            return Error { message: ffi.haze_image_decode_failure(this.job) };
        }
        return Image.fromDecoded(result);
    }
}

// Decodes an image file held in memory: PNG, JPEG, BMP, GIF (first frame),
// TGA, PSD, PNM. desiredChannels works as in the Image constructors.
export fn decode(data: Bytes, desiredChannels: int = 4): Result<Image, Error> {
    return Image.decode(data, desiredChannels);
}

// decode() on a worker thread, for a caller that must not wait for it: a
// megapixel takes tens of milliseconds. Poll done() (once a frame, say),
// then take the result(). The work goes on even if the ImageDecode is
// dropped; it is simply never read.
export fn decodeAsync(data: Bytes, desiredChannels: int = 4): ImageDecode {
    if desiredChannels < 0 || desiredChannels > 4 {
        sys.panic(f"decodeAsync: desiredChannels must be 0 to 4, not {desiredChannels}");
    }
    return ImageDecode.start(data, desiredChannels);
}

// What an image file's header says about the image in it.
export struct Info {
    width: int;
    height: int;
    // The channel count in the file: 1=grey, 2=grey+alpha, 3=RGB, 4=RGBA.
    channels: int;
}

// The size of an image file held in memory, read from its header alone: no
// pixel is decoded, so it costs next to nothing whatever the image's size.
// Fails for data decode() could not read either.
export fn info(data: Bytes): Result<Info, Error> {
    // A one-byte Bytes holds its byte inline (see Image.decode).
    let single: u8 = 0;
    let ptr = none as cptr;
    let length = data.length;
    if length == 1 {
        single = data[0];
        __c__("ptr = &single;");
    }
    else {
        __c__("ptr = data.basePtr + data.offset;");
    }
    let found = ffi.haze_image_info(ptr, length);
    if !found.ok {
        return Error { message: ffi.haze_image_failure_reason() };
    }
    let result = Info { width: found.width, height: found.height, channels: found.channels };
    return result;
}

// Why `img` cannot be a PNG, or "" when it can.
fn pngObstacle(img: Image): str {
    if img.width <= 0 || img.height <= 0 || img.channels < 1 || img.channels > 4 {
        return f"cannot encode a {img.width}x{img.height} image with {img.channels} channels";
    }
    if img.pixels.length != img.width * img.height * img.channels {
        return f"pixel buffer holds {img.pixels.length} bytes, the image needs {img.width * img.height * img.channels}";
    }
    return "";
}

// Wraps the PNG haze_image_encode_png wrote, which has data.
fn pngOf(result: ffi.haze_image_png_result_t): Result<Bytes, Error> {
    do unsafe {
        let png = Bytes();
        __c__("png.basePtr = result.data;");
        __c__("png.offset = 0;");
        __c__("png.length = result.length;");
        return Result<Bytes, Error>.Ok(png);
    };
}

// Encodes an image as a PNG file, keeping its channel count (grey, grey with
// alpha, RGB or RGBA).
export fn encodePng(img: Image): Result<Bytes, Error> {
    let obstacle = pngObstacle(img);
    if obstacle.length > 0 {
        return Error { message: obstacle };
    }

    let pixels = img.pixels;
    let single: u8 = 0;
    let ptr = none as cptr;
    if pixels.length == 1 {
        // A 1x1 grey image: the byte may be held inline (see decode).
        single = pixels[0];
        __c__("ptr = &single;");
    }
    else {
        __c__("ptr = pixels.basePtr + pixels.offset;");
    }

    let result = ffi.haze_image_encode_png(ptr, img.width, img.height, img.channels);

    let valid = false;
    __c__("valid = result.data != NULL;");
    if !valid {
        return Error { message: "PNG encoding failed" };
    }
    return pngOf(result);
}

// A PNG being made on a worker thread -- see encodePngAsync and
// convertToPngAsync.
export opaque ref struct PngEncode {
    job: cptr;
    // The pixels or the image file, which the worker reads until it is done.
    source: Bytes;
    // Why there is nothing to encode -- then there is no job either.
    obstacle: str = "";

    static fn ofPixels(img: Image): PngEncode {
        let obstacle = pngObstacle(img);
        if obstacle.length > 0 {
            return PngEncode { job: none as cptr, source: img.pixels, obstacle: obstacle };
        }
        // A 1x1 grey image: the byte may be held inline (see decode). The
        // worker could not read a local once this returns, but so small an
        // image is encoded before haze_image_png_start does.
        let pixels = img.pixels;
        let single: u8 = 0;
        let ptr = none as cptr;
        if pixels.length == 1 {
            single = pixels[0];
            __c__("ptr = &single;");
        }
        else {
            __c__("ptr = pixels.basePtr + pixels.offset;");
        }
        return PngEncode {
            job: ffi.haze_image_png_start(none as cptr, 0, ptr, img.width, img.height, img.channels),
            source: pixels,
        };
    }

    static fn ofFile(data: Bytes): PngEncode {
        // No image fits in one byte -- and that byte may be held inline,
        // where there is nothing to point at.
        if data.length <= 1 {
            return PngEncode { job: none as cptr, source: data, obstacle: "not an image" };
        }
        let ptr = none as cptr;
        __c__("ptr = data.basePtr + data.offset;");
        return PngEncode {
            job: ffi.haze_image_png_start(ptr, data.length, none as cptr, 0, 0, 0),
            source: data,
        };
    }

    fn done(): bool {
        if this.obstacle.length > 0 {
            return true;
        }
        return ffi.haze_image_png_done(this.job);
    }

    // The PNG file. Panics before done().
    fn result(): Result<Bytes, Error> {
        if this.obstacle.length > 0 {
            return Error { message: this.obstacle };
        }
        if !this.done() {
            sys.panic("PngEncode.result() before the PNG is encoded -- check done() first");
        }
        let result = ffi.haze_image_png_result(this.job);
        let valid = false;
        __c__("valid = result.data != NULL;");
        if !valid {
            let failure = ffi.haze_image_png_failure(this.job);
            return Error { message: failure.length > 0 ? failure : "PNG encoding failed" };
        }
        return pngOf(result);
    }
}

// encodePng() on a worker thread, for a caller that must not wait for it: a
// megapixel takes a hundred milliseconds and more. Poll done() (once a
// frame, say), then take the result(). The work goes on even if the
// PngEncode is dropped; it is simply never read.
export fn encodePngAsync(img: Image): PngEncode {
    return PngEncode.ofPixels(img);
}

// Turns any image file decode() reads -- a JPEG, a BMP, ... -- into a PNG
// file, on a worker thread like encodePngAsync. The PNG keeps the file's
// channel count.
export fn convertToPngAsync(data: Bytes): PngEncode {
    return PngEncode.ofFile(data);
}
