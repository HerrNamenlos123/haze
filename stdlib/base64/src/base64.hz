
__c__("#include \"ffi/haze_base64.c\"");
export __c__("#include \"ffi/public/haze_base64.h\"");

namespace ffi {
    export extern C fn haze_base64_encode(data: cptr, length: int): str :: final;
    export extern C fn haze_base64_decode(data: str): haze_base64_decode_result_t :: final;
    export extern C fn haze_base64_decode_start(text: str): cptr :: final;
    export extern C fn haze_base64_decode_done(job: cptr): bool :: final;
    export extern C fn haze_base64_decode_result(job: cptr): haze_base64_decode_result_t :: final;
    export extern C fn haze_base64_encode_start(data: cptr, length: int): cptr :: final;
    export extern C fn haze_base64_encode_done(job: cptr): bool :: final;
    export extern C fn haze_base64_encode_result(job: cptr): str :: final;

    export extern C noemit struct haze_base64_decode_result_t {
        success: bool;
        data: cptr;
        length: int;
        error: str;
    }
}

export ref struct Error {
    message: str;
}

// Encodes arbitrary bytes into a Base64 (RFC 4648) string. Always succeeds --
// any byte sequence has a valid Base64 representation.
export fn encode(data: Bytes): str {
    // A one-byte Bytes holds its byte inline and has no buffer to point at.
    let single: u8 = 0;
    let ptr = none as cptr;
    let length = data.length;
    if length == 1 {
        single = data[0];
        __c__("ptr = &single;");
    }
    else {
        __c__("ptr = data.basePtr + data.offset;");
    }

    return ffi.haze_base64_encode(ptr, length);
}

// Bytes being encoded on a worker thread -- see encodeAsync.
export opaque ref struct Base64Encode {
    job: cptr;
    // The bytes, which the worker reads until it is done.
    data: Bytes;

    static fn start(data: Bytes): Base64Encode {
        // A one-byte Bytes holds its byte inline (see encode). The worker
        // could not read a local once this returns, but so few bytes are
        // encoded before haze_base64_encode_start does.
        let single: u8 = 0;
        let ptr = none as cptr;
        let length = data.length;
        if length == 1 {
            single = data[0];
            __c__("ptr = &single;");
        }
        else {
            __c__("ptr = data.basePtr + data.offset;");
        }
        return Base64Encode { job: ffi.haze_base64_encode_start(ptr, length), data: data };
    }

    fn done(): bool {
        return ffi.haze_base64_encode_done(this.job);
    }

    // What encode() would have returned. Panics before done().
    fn result(): str {
        if !this.done() {
            sys.panic("Base64Encode.result() before the bytes are encoded -- check done() first");
        }
        return ffi.haze_base64_encode_result(this.job);
    }
}

// encode() on a worker thread, for a caller that must not wait for it: a
// megabyte takes several milliseconds in an unoptimized build. Poll done()
// (once a frame, say), then take the result().
export fn encodeAsync(data: Bytes): Base64Encode {
    return Base64Encode.start(data);
}

// Decodes a Base64 (RFC 4648) string back into raw bytes. Fails if the input
// length isn't a multiple of 4, or it contains characters outside the Base64
// alphabet (or a misplaced '=' padding character).
export fn decode(data: str): Result<Bytes, Error> {
    return bytesOf(ffi.haze_base64_decode(data));
}

// A Base64 string being decoded on a worker thread -- see decodeAsync.
export opaque ref struct Base64Decode {
    job: cptr;
    // The text, which the worker reads until it is done.
    text: str;

    static fn start(text: str): Base64Decode {
        return Base64Decode { job: ffi.haze_base64_decode_start(text), text: text };
    }

    fn done(): bool {
        return ffi.haze_base64_decode_done(this.job);
    }

    // What decode() would have returned. Panics before done().
    fn result(): Result<Bytes, Error> {
        if !this.done() {
            sys.panic("Base64Decode.result() before the text is decoded -- check done() first");
        }
        return bytesOf(ffi.haze_base64_decode_result(this.job));
    }
}

// decode() on a worker thread, for a caller that must not wait for it: a
// megabyte of text takes tens of milliseconds in an unoptimized build. Poll
// done() (once a frame, say), then take the result().
export fn decodeAsync(data: str): Base64Decode {
    return Base64Decode.start(data);
}

fn bytesOf(result: ffi.haze_base64_decode_result_t): Result<Bytes, Error> {
    if !result.success {
        return Error { message: result.error };
    }

    do unsafe {
        // Bytes() rather than `uninitialized`: Bytes has more fields than the
        // three set below, and a garbage singleByte reads as present, so
        // every bytes[i] would return it instead of the decoded data.
        let bytes = Bytes();
        __c__("bytes.basePtr = result.data;");
        __c__("bytes.offset = 0;");
        __c__("bytes.length = result.length;");
        return Result<Bytes, Error>.Ok(bytes);
    };
}
