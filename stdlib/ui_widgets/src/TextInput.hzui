import textedit_behavior
import unicode

// === TextInput ================================================
//
// A single-line text box, driven entirely by textedit_behavior: this file
// owns no cursor, no selection and no undo history of its own. It supplies
// the engine with a document (one line, the `text` prop), turns key and
// pointer events into engine calls, and draws what the engine says.
//
// ── Controlled through a reactive handle ──────────────────────
//
// `text` is a `Reactive<str>`, not a plain str with a change callback. The
// owner holds the handle, this box writes through it, and both sides see the
// same value with no round trip -- which is what lets a caller mutate the
// text from elsewhere (a Clear button, a form reset) and have the box simply
// show it. `change` is still emitted for owners that want to react rather
// than poll.
//
// ── One line, on purpose ──────────────────────────────────────
//
// getLineCount() is 1 and always will be. Return does not insert a newline,
// it emits `submit`. Line breaks reaching the box from ANYWHERE -- a paste, or
// the owner writing multi-line text straight into the handle -- are STRIPPED
// and everything else kept, so multi-line text arrives joined into one line
// rather than losing all but its first. See `line` below for why that is a
// correctness requirement and not a formatting preference.

@props
text: Reactive<str>;
placeholder: str = "";
enabled: bool = true;

fontSize: real = 14.0;
fontFamily: str = "default";
backgroundColor: str = "#1F1F1F";
borderColor: str = "#3C3C3C";
textColor: str = "#CCCCCC";
textColorDisabled: str = "#6A6A6A";
placeholderColor: str = "#6A6A6A";
selectionColor: str = "#264F78";
caretColor: str = "#FFFFFF";
paddingX: real = 8.0;
paddingY: real = 4.0;
borderWidth: real = 1.0;
rounded: real = 3.0;
// See button.hzui -- drawn only on :focus-visible, so clicking into the box
// does not ring it but tabbing to it does.
focusRing: real = 2.0;
focusRingColor: str = "#0078D4";
focusRingOffset: real = 1.0;

@emit
// The whole value, after any edit.
change: (str,);
// Return was pressed. A single-line box has no use for a newline.
submit: (str,);

@expose
// Focus the box from the outside, e.g. when a dialog opens.
focus: () => none;
selectAll: () => none;

@setup
let rootRef = elementRef<DivElement>();
// The clipping viewport: the window the line is seen through, and the thing
// the runs are positioned and hit-tested against. See the @template.
let viewRef = elementRef<DivElement>();

// How far the line is scrolled left, in pixels. Sticky state, not a
// derivation: a view only moves when the caret would otherwise leave it, so
// where it sits depends on where it already was. revealCaret() below is the
// only writer.
let scrollX = rx.reactive<real>(0.0);

// Whether a press is still down and dragging out a selection. A reactive cell
// rather than a plain `let` because closures here capture by copy -- two
// lambdas sharing a bare bool would each get their own.
let dragging = rx.reactive<bool>(false);

// A textbox is one line, so any line break in text arriving from outside is
// removed and everything around it kept -- a three-line paste lands as one
// joined line. Keeping only the first line instead would silently discard
// most of what the user pasted, which is a worse answer than joining: they
// can see and edit a joined line, they cannot get the dropped text back.
//
// "\r" goes with it, so a CRLF clipboard does not leave stray carriage
// returns sitting in the value as unrenderable glyphs.
//
// This runs on EVERY edit, keystrokes included (see applyReplaceRange), so
// the no-break case must not build anything: it walks the one or two bytes it
// was given and falls straight through to the single-slice return.
let withoutLineBreaks = (text: String): str => {
    let result = "";
    let segmentStart = 0;
    let i = 0;
    while i < text.length() {
        let byte = text.getAt(i);
        if byte == b"\n" || byte == b"\r" {
            result = result + text.cloneSlice(segmentStart, i);
            segmentStart = i + 1;
        }
        i = i + 1;
    }
    if segmentStart == 0 {
        return text.cloneSlice(0);
    }
    return result + text.cloneSlice(segmentStart);
};

// THE value, as far as everything below is concerned: the prop with its line
// breaks stripped out.
//
// Stripping on the way in (applyReplaceRange, getClipboard) is not enough,
// because `text` is a handle the OWNER holds and writes directly -- that is
// the whole point of it being a Reactive<str>, see the note at the top of this
// file -- and those writes never pass through this component at all. One
// `text := "a\nb"` from a caller is all it takes.
//
// And a line break is not a cosmetic problem here. The renderer breaks on
// "\n" whatever the wrap mode says: text-nowrap turns off WIDTH wrapping (a
// long line correctly overflows the box on one line) but Clay's wrap loop
// never consults wrapMode for newlines, so the run becomes two visual lines,
// the box doubles in height, and every caret/selection/hit-test x below --
// all of it prefix widths measured along ONE line -- is silently measuring
// the wrong thing.
//
// So the box reads its own value through here and nowhere else. It does not
// write the normalization back on its own: that would emit a `change` the
// owner never asked for. The first real edit persists it, since the head and
// tail spliced below come from this same normalized string.
let line = computed((): str => withoutLineBreaks(String(rx.get(props.text))));

// The engine's one mutation primitive. Everything it does -- typing,
// backspace, word-delete, paste, undo -- arrives here as "replace the bytes
// between these two columns with this text", so this is the only place in the
// component that writes the value.
// `: void` is not decoration -- ContextArgs.replaceRange is declared `=> void`
// and an unannotated lambda infers `=> none`, which is a different type here.
let applyReplaceRange = (start: Vec2i, end: Vec2i, replacement: String): void => {
    let handle = props.text;
    let current = String(rx.get(line));
    let head = current.cloneSlice(0, start.x);
    let tail = current.cloneSlice(end.x);
    let next = head + withoutLineBreaks(replacement) + tail;
    // Written through the handle the owner gave us, so both sides see it at
    // once. The engine reads the document back immediately after this returns
    // (see ContextArgs.replaceRange), which a reactive write satisfies.
    handle := next;
    emits.change(next);
};

let textedit = textedit_behavior.Context({
    // One line, forever -- see the note at the top of this file.
    getLineCount: () => 1,
    getLine: (lineIndex: int) => String(rx.get(line)),
    getLineLength: (lineIndex: int) => line.length,
    getTimeInSeconds: () => ui.now(),
    replaceRange: applyReplaceRange,

    // Route the engine's register through the OS clipboard, so ctrl+c here
    // pastes into other applications and ctrl+v brings theirs in. A widget
    // cannot reach the windowing layer itself -- ui_widgets depends on none
    // of app/sdl, by design -- so the host hands its clipboard down through
    // UIContext (see ui_components.ClipboardCallbacks). This only WIRES the
    // bridge; useSystemClipboard below is what turns it on.
    //
    // Stripped HERE, at the box's own edge, and not left to applyReplaceRange
    // alone: insertText() works out where to leave the caret from the string
    // it was HANDED, not from what the document ended up storing. Hand it
    // "a\nb" while the document stores "ab" and it targets line 1, which does
    // not exist, and the caret is clamped back to somewhere arbitrary on line
    // 0. Clipboard text carries a line break constantly -- every line copied
    // from a terminal or an editor ends in one -- so this is the common path,
    // not a corner case. Strip before the engine sees it and the two agree.
    getClipboard: () => {
        let text: String = String(withoutLineBreaks(String(ui.getClipboardText())));
        return text;
    },
    setClipboard: (text: String): void => {
        ui.setClipboardText(text.cloneString());
    },
});

// ...and only when there is actually a clipboard behind it. A host that
// wired none (a headless context, an embedder that just didn't pass one)
// leaves the engine on its own internal register, so ctrl+c/ctrl+v still
// work within the box -- rather than reading an always-empty system
// clipboard over the top of a register that had the text all along.
textedit.useSystemClipboard = ui.hasClipboard();

// --- geometry -------------------------------------------------
//
// Every x below is measured with the same font this box draws with, passed
// explicitly rather than left to cascade: these run inside computeds, not at
// a point in the element tree, so there is no ambient font to inherit.
let widthUpTo = (column: int): real => {
    let value = String(rx.get(line));
    let head = value.cloneSlice(0, column);
    return ui.measureText(head, props.fontFamily, props.fontSize).x;
};

let caretX = computed(() => widthUpTo(textedit.cursorPosition.x));
let showPlaceholder = computed(() => line.length == 0 && props.placeholder.length > 0);

// The line cut into the three runs the template draws: before the selection,
// inside it, after it. The highlight is the middle run's BACKGROUND rather
// than a rectangle laid over the text, because an absolutely positioned
// element here always paints ABOVE its in-flow siblings -- it becomes its own
// Clay render root, ordered after the document root (see
// ui_layout.resolveFloating) -- so an overlay hides exactly the characters it
// is meant to highlight. Nor is a negative z-index a way out: that sorts the
// rect ahead of the document root, i.e. behind this box's own background.
// Only the caret, which belongs on top, is still drawn as an overlay.
//
// Cutting the line costs no accuracy: every cut lands on a prefix width
// widthUpTo already measures, which is what the caret and columnAtX assume.
// With no selection head and middle are empty and the tail is the whole line,
// so the common case is still a single uninterrupted run.
let headText = computed((): str => {
    if !textedit.hasSelection { return ""; }
    return String(rx.get(line)).cloneSlice(0, textedit.selectionStart.x);
});
let selectedText = computed((): str => {
    if !textedit.hasSelection { return ""; }
    return String(rx.get(line)).cloneSlice(textedit.selectionStart.x, textedit.selectionEnd.x);
});
let tailText = computed((): str => {
    if !textedit.hasSelection { return rx.get(line); }
    return String(rx.get(line)).cloneSlice(textedit.selectionEnd.x);
});
// How wide the highlight box has to be told it is, rather than left to hug
// its own text.
//
// Clay shrinks fit-sized children to absorb a row's overflow, and this row
// overflows the moment the value is wider than the box. The text runs are
// immune -- a nowrap text element is excluded from Clay's resizable set --
// but a plain div is not, so the highlight would collapse (measured: 32px ->
// 16px) while the nowrap text inside it kept its full width, and every run
// after it slid left straight over the selection. A FIXED width is excluded
// from that set as well, which pins the row rigid.
//
// Measured with the very call Clay will measure that text element with, so
// the box hugs its glyphs. The one seam: Clay measures a run word by word
// while this measures it whole, and fontstash kerns across the join, so a
// selection containing a space can disagree by a kern pair -- under a pixel,
// at the highlight's right edge only.
let selectionWidth = computed(() => ui.measureText(selectedText, props.fontFamily, props.fontSize).x);

// The caret must be exactly as tall as a line of this text, so measure one
// rather than guessing a multiple of the font size. "M" is only a probe --
// measureText's height does not depend on which glyph it is given. (The
// selection needs no such measurement: it is a run's background, and a run is
// already exactly one line tall.)
let lineHeight = computed(() => ui.measureText("M", props.fontFamily, props.fontSize).y);

// Which column a click at `localX` (pixels from the text's left edge) lands
// on. Stepped by GRAPHEME CLUSTER, never by byte: a column that fell inside a
// multi-byte character would slice the string mid-character, and every
// measurement after it would be measuring garbage.
//
// Linear rather than a binary search because a textbox holds a line, not a
// document, and each step is one measureText of a short prefix.
// math's helpers are not exported from core (see its own file), so this is
// the one place that needs one.
let distance = (a: real, b: real): real => {
    return a > b ? a - b : b - a;
};

let columnAtX = (localX: real): int => {
    let value = rx.get(line);
    let best = 0;
    let bestDistance = distance(0.0, localX);
    let column = 0;
    while column < value.length {
        let next = unicode.nextClusterOffset(value, column);
        if next <= column {
            break;
        }
        let d = distance(widthUpTo(next), localX);
        if d < bestDistance {
            bestDistance = d;
            best = next;
        }
        column = next;
    }
    return best;
};

// The width of the window the line is seen through. 0 before the first
// layout, which every caller treats as "cannot scroll yet".
let viewportWidth = (): real => {
    let view = rx.get(viewRef);
    if !view { return 0.0; }
    let size = view.size();
    if size is none { return 0.0; }
    return size.x;
};

// How far the line can scroll before its end reaches the viewport's right
// edge. The extra pixel is the caret's own width: the caret sits AFTER the
// last character, so a line scrolled flush with its last glyph would clip it.
let maxScrollX = (): real => {
    let viewport = viewportWidth();
    if viewport <= 0.0 { return 0.0; }
    let contentWidth = ui.measureText(line, props.fontFamily, props.fontSize).x;
    let slack = contentWidth + 1.0 - viewport;
    return slack > 0.0 ? slack : 0.0;
};

// scrollX clamped to what the current text actually allows -- and THIS is
// what gets drawn and hit-tested, never scrollX itself.
//
// The two are separate because the owner can replace the value through the
// handle at any time (a Clear button, a form reset -- see the note at the top
// of this file) without any handler here running. That would leave the sticky
// offset scrolled past text that no longer exists, and nothing would pull it
// back until the user next touched the box. Clamping on the way out means the
// view is sane the very frame the text changes, while scrollX keeps the
// position the user actually scrolled to.
let scrollOffset = computed((): real => {
    let current = rx.get(scrollX);
    let limit = maxScrollX();
    if current > limit { return limit; }
    if current < 0.0 { return 0.0; }
    return current;
});

// Where column 0 sits on screen right now: the viewport's left edge, pushed
// left by however far the line is scrolled. Everything that converts between
// a column and an x -- the caret, the runs, hit-testing -- is measured from
// here, and the viewport is what the overlays are positioned against too, so
// there is no padding or border term anywhere in this: the viewport is
// already inside both.
//
// Clicks arrive in window coordinates (see PointerEvent.pos), so this is what
// makes them local.
let textOriginX = (): real => {
    let view = rx.get(viewRef);
    if !view { return 0.0; }
    let pos = view.position();
    if pos is none { return 0.0; }
    return pos.x - rx.get(scrollOffset);
};

// Keep the caret inside the viewport, moving as little as possible -- the
// DOM's scrollIntoView({inline: "nearest"}), and what every text field does.
//
// Called from the handlers rather than recomputed per frame, because those
// are exactly the moments the caret can move. It reads the viewport width
// measured during the LAST layout, which is right: the box's width does not
// change between a keystroke and the frame that draws it.
let revealCaret = (): none => {
    let viewport = viewportWidth();
    if viewport <= 0.0 { return; }

    // The caret is drawn one pixel wide at caretX, so the last offset that
    // still shows all of it is viewport - 1, not viewport. Without that the
    // caret at end-of-line sits exactly on the clip edge and vanishes.
    let caretWidth = 1.0;
    let caret = caretX;
    // Started from what is actually on screen, not from the raw scrollX --
    // otherwise a reveal just after the owner replaced the text would move
    // relative to an offset the user never saw.
    let next = rx.get(scrollOffset);
    if caret < next {
        next = caret;
    }
    else if caret > next + viewport - caretWidth {
        next = caret - viewport + caretWidth;
    }

    let limit = maxScrollX();
    if next > limit { next = limit; }
    if next < 0.0 { next = 0.0; }
    scrollX := next;
};

// --- input ----------------------------------------------------

// Committed text (layout- and IME-aware), never raw key events -- see
// ui_components.TextInputEvent for why reconstructing typed text from keys is
// the wrong move.
let typed = (event: TextInputEvent) => {
    if !props.enabled { return; }
    textedit.handleTextInput(String(event.text));
    revealCaret();
};

let keyPressed = (event: KeyboardEvent) => {
    if !props.enabled { return; }
    let ctrl = hasModifier(event.modifiers, KeyModifiers.Ctrl);
    let shift = hasModifier(event.modifiers, KeyModifiers.Shift);

    if event.key == Key.Left {
        if ctrl { textedit.moveCursorWordLeft(shift); }
        else { textedit.moveCursorLeft(shift); }
    }
    else if event.key == Key.Right {
        if ctrl { textedit.moveCursorWordRight(shift); }
        else { textedit.moveCursorRight(shift); }
    }
    else if event.key == Key.Home {
        textedit.moveCursorHome(shift);
    }
    else if event.key == Key.End {
        textedit.moveCursorEnd(shift);
    }
    else if event.key == Key.Backspace {
        textedit.deleteBackward(ctrl);
    }
    else if event.key == Key.Delete {
        textedit.deleteForward(ctrl);
    }
    else if event.key == Key.Return {
        // One line: Return is the box's commit gesture, not a newline.
        emits.submit(rx.get(line));
    }
    else if ctrl && event.key == Key.A {
        textedit.selectAll();
    }
    else if ctrl && event.key == Key.C {
        textedit.copy();
    }
    else if ctrl && event.key == Key.X {
        textedit.cut();
    }
    else if ctrl && event.key == Key.V {
        textedit.paste();
    }
    else if ctrl && event.key == Key.Z {
        if shift { textedit.redo(); } else { textedit.undo(); }
    }
    else {
        // Anything not handled here keeps its default action -- notably Tab,
        // which must still move focus out of the box. Everything above is
        // claimed, so it does not also navigate away or scroll an ancestor.
        return;
    }
    revealCaret();
    event.preventDefault();
    event.stopPropagation();
};

// Click places the caret; dragging with the button held extends the
// selection, which is the same gesture a click-then-shift-click makes.
//
// The click COUNT decides what the gesture snaps to (see
// textedit_behavior.SelectionGranularity): a plain press drags character by
// character, a double press selects the word under it and then drags word by
// word, a triple press takes the whole line -- which, in a one-line box, is
// everything. Shift+click extends the existing selection instead of starting
// a new one, keeping whatever granularity is in force, so double-click then
// shift-click still extends by whole words.
//
// Only the primary button does any of this. A right or middle press leaves
// the caret and the selection exactly where they are, as a browser does --
// right-clicking inside a selection must not destroy the thing the user is
// about to act on.
let pressed = (event: PointerEvent) => {
    if !props.enabled { return; }
    // Before the button check, and for EVERY button: a press inside this box
    // is never an interaction "outside" the dismissable panel it may live in,
    // whichever button it was. Only what the press DOES is primary-only.
    event.stopPropagation();
    if event.button != PointerButton.Left { return; }
    let column = columnAtX(event.pos.x - textOriginX());
    let target: Vec2i = { x: column, y: 0 };

    if hasModifier(event.modifiers, KeyModifiers.Shift) {
        textedit.extendSelectionTo(target);
    } else {
        textedit.beginSelection(target, textedit_behavior.granularityForClickCount(event.detail));
    }
    revealCaret();
    dragging := true;
};

// Move the selection's moving end to whatever column is under `windowX`.
// Takes a window coordinate rather than an event, because the pointer is read
// from two places -- an event while it is over the box, ui.mousePos while it
// is not -- and both must land in the same place.
let dragSelectionTo = (windowX: real): none => {
    if !props.enabled { return; }
    let column = columnAtX(windowX - textOriginX());
    let target: Vec2i = { x: column, y: 0 };
    // The engine keeps the anchor AND the granularity the press established,
    // so this one call is a character drag after a single click and a
    // word-by-word drag after a double click -- see
    // textedit_behavior.extendSelectionTo.
    textedit.extendSelectionTo(target);
    revealCaret();
};

// Pointer capture, and with it the auto-scroll.
//
// A @pointermove handler cannot do this. Move is dispatched along the CURRENT
// hit path (see ui_components.process), so the instant the pointer leaves this
// box the events stop and the selection freezes wherever it was -- which is
// why dragging out of the box used to need the pointer kept within a few
// pixels of the edge. Polling the pointer per frame is what the framework
// offers instead; ui.leftMouseHeld() exists for exactly this case.
//
// The auto-scroll is not written here -- it falls out. The column is resolved
// from the pointer's position in CONTENT space, and content space shifts every
// time the view scrolls. Hold the pointer 5px past the left edge: this frame
// resolves a column 5px left of the view, revealCaret scrolls 5px to show it,
// and next frame the same pointer position is 5px further left again. So it
// scrolls continuously, faster the further out the pointer is held, which is
// what a browser does -- and it stops dead when the pointer comes back inside,
// because then the column is already visible and there is nothing to reveal.
ui.onFrame(() => {
    if !rx.get(dragging) { return; }
    if !ui.leftMouseHeld() {
        // Released -- possibly outside the window entirely, where no
        // pointerup for this element is ever going to arrive.
        dragging := false;
        return;
    }
    dragSelectionTo(ui.mousePos.x);
});

// --- exposed API ----------------------------------------------
let focus = (): none => {
    let root = rx.get(rootRef);
    if root { root.focus(); }
};
let selectAll = (): none => {
    textedit.selectAll();
    revealCaret();
};

// --- style ----------------------------------------------------
let ringVisible = computed(() => (rootRef?.focusVisible() ?? false) && props.focusRing > 0.0);
let caretVisible = computed(() => (rootRef?.focused() ?? false) && textedit.cursorVisible);
let contentColor = computed(() => {
    if !props.enabled { return props.textColorDisabled; }
    return props.textColor;
});

@template [
        relative row items-center w-grow h-fit
        px-[props.paddingX]px py-[props.paddingY]px
        bg-[props.backgroundColor] rounded-[props.rounded]px
        border-[props.borderWidth] border-color-[props.borderColor]
        [props.enabled]?cursor-text
        [ringVisible]?outline-[props.focusRing]
        [ringVisible]?outline-color-[props.focusRingColor]
        [ringVisible]?outline-offset-[props.focusRingOffset]
    ]
    ref=rootRef
    focusable=[props.enabled]
    @pointerdown=pressed
    @keydown=keyPressed
    @textinput=typed

// The viewport: the window the line is seen through, and the only thing here
// that clips. It deliberately is NOT the root, because an element's resolved
// clip includes its OWN box (see ui_layout.collectClipsRecursive) and
// drawOutline clips the focus ring with it -- overflow-hidden on the root
// would cut the ring off, since a ring is drawn OUTSIDE the border box.
//
// Being `relative` also makes it the anchor for everything below: their
// offsets are viewport-local, so no padding or border term appears in any of
// them. And an explicit height is what keeps the box one line tall while its
// content floats out of flow -- this is the root's only in-flow child, so
// h-fit above still resolves to one line plus its padding.
div [
        relative w-grow h-[lineHeight]px
        overflow-hidden
    ]
    ref=viewRef
{
    // In flow, unlike everything else here: a placeholder never scrolls, and
    // `absolute` is a div style that ui.text has no field for anyway.
    text if=[showPlaceholder] [
            text-color-[props.placeholderColor] text-nowrap
            font-size-[props.fontSize] font-family-[props.fontFamily]
        ] [props.placeholder]

    // The line, in three runs -- see headText for why the highlight is a
    // run's background and not an overlay. Font and colour sit on this row
    // and cascade into all three runs (ui_layout.pushCascadingStack), so they
    // cannot drift apart. The tail is drawn unconditionally, empty or not, so
    // the row is never childless.
    //
    // Floated out of flow purely to be SHIFTABLE: `left` is the only way to
    // move a box by pixels in this engine (position:relative stays in flow
    // and translate-* is a fraction of the element's own size), and it only
    // applies to something out of flow. The viewport's fixed height is what
    // pays for the height this no longer contributes.
    div else [
            absolute left-[0.0 - scrollOffset]
            row items-center gap-0 w-fit h-fit
            text-color-[contentColor]
            font-size-[props.fontSize] font-family-[props.fontFamily]
        ] {
        text if=[headText.length > 0] [text-nowrap] [headText]

        div if=[selectedText.length > 0] [
                row items-center gap-0 h-fit w-[selectionWidth]px
                bg-[props.selectionColor]
            ] {
            text [text-nowrap] [selectedText]
        }

        text [text-nowrap] [tailText]
    }

    // Caret last, and floating -- which is exactly what makes it paint above
    // the runs. A caret is the one thing in this box that genuinely belongs
    // on top of the text and its highlight, so the paint order that broke the
    // selection is the one this needs. Scrolled by the same offset as the
    // runs, so it stays on the character it marks.
    div if=[caretVisible] [
            absolute bg-[props.caretColor]
            left-[caretX - scrollOffset]
            w-[1]px h-[lineHeight]px
        ]
}
