
@props

@slot

@setup
let isOpen = rx.reactive<bool>(false);
let open = (event: ui_components.PointerEvent) => {
    isOpen := true;
};

@template [relative w-100 h-100 bg-["#333"]]
div [w-grow h-grow col] {
    FloatingPanel if=isOpen [] position=[PanelPosition.Top] marginTop=[16] {
        #body {
            div [bg-["#F00"] p-2 rounded-4] {
                text [] ["Hello World"]
            }
        }
    }

    Button [] label=["Open panel"] @click=open
}