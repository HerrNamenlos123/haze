
@props

@slot

@setup
let isOpen = rx.reactive<bool>(false);
let open = () => {
    isOpen := true;
};
let close = () => {
    isOpen := false;
}

let button = () => {
    fmt.println("Button clicked");
}

@template [relative w-100 h-100 bg-["#111"]]
div [w-grow h-grow col] {
    FloatingPanel if=isOpen [] position=[PanelPosition.Top] marginTop=[16] @close=close {
        #body {
            div [w-50 h-50 items-center gap-4 col] {
                div [bg-["#F00"] p-2 rounded-4] {
                    text [] ["Hello World"]
                }
                Button [] label=["Panel button"] @click=button
            }
        }
    }

    Button [] label=["Open panel"] @click=open
}