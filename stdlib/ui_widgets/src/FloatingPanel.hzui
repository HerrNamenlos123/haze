
export enum PanelPosition {
    TopLeft,
    Top,
    TopRight,
    Left,
    Center,
    Right,
    BottomLeft,
    Bottom,
    BottomRight,
}

@props
position: PanelPosition = PanelPosition.Center;
marginLeft: real = 0;
marginRight: real = 0;
marginTop: real = 0;
marginBottom: real = 0;
backgroundColor?: Color;
radius: real = 12;

@emit
close: ();

@slot
body: {};

@setup
let left = computed(() => {
    return props.position == PanelPosition.TopLeft || props.position == PanelPosition.Left || props.position == PanelPosition.BottomLeft;
});
let centerx = computed(() => {
    return props.position == PanelPosition.Top || props.position == PanelPosition.Center || props.position == PanelPosition.Bottom;
});
let right = computed(() => {
    return props.position == PanelPosition.TopRight || props.position == PanelPosition.Right || props.position == PanelPosition.BottomRight;
});
let top = computed(() => {
    return props.position == PanelPosition.TopLeft || props.position == PanelPosition.Top || props.position == PanelPosition.TopRight;
});
let centery = computed(() => {
    return props.position == PanelPosition.Left || props.position == PanelPosition.Center || props.position == PanelPosition.Right;
});
let bottom = computed(() => {
    return props.position == PanelPosition.BottomLeft || props.position == PanelPosition.Bottom || props.position == PanelPosition.BottomRight;
});
let background = computed<Color>(() => {
    let bg = props.backgroundColor;
    if (bg) {
        return bg;
    }
    return "#333";
});

let pointerOut = (event: PointerEvent) => {
    emits.close();
}
let focusOut = (event: FocusEvent) => {
    emits.close();
}

@template [absolute 
    left?justify-start
    centerx?justify-center
    right?justify-end
    top?items-start
    centery?items-center
    bottom?items-end
]
div [w-fit h-fit 
        ml-[props.marginLeft]px mr-[props.marginRight]px mt-[props.marginTop]px mb-[props.marginBottom]px 
        rounded-[props.radius] bg-[background]
    ] 
    @pointerdownoutside=pointerOut
    @focusoutside=focusOut
{
    slot body {}
}
