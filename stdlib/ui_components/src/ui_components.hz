import ui_elements;
import ui_styling;
import renderer;

// Set by anything that changes state the reactive graph cannot see, and
// consumed by UIContext.needsUpdate() -- the one escape hatch out of "no
// invalidation, no frame". File-level rather than a UIContext field because
// the things that need to set it are free functions holding an element and
// nothing else (ui_focus/ui_blur), and only ever touched through the two
// non-generic functions below, for the same reason rx.activeWatcher is a
// function: a generic method of UIContext is re-elaborated in the importing
// module, where this variable does not exist.
let __ui_updateRequested: bool = false;

// Which single button triggered a given event. None for events not tied to
// one specific button (move, hover/hit enter+leave).
export enum PointerButton {
    None,
    Left,
    Middle,
    Right,
}

// Which buttons are held *during* an event, as a bitmask -- mirrors the
// DOM's MouseEvent.buttons. Values are auto-assigned (Left=1, Right=2,
// Middle=4); `None` is pinned to 0 and must stay declared *last* so the
// auto-assignment for the others still starts from 1 -- an explicit 0
// member followed by auto-assigned members hangs the compiler (it keeps
// doubling zero forever looking for an unused value).
// TODO: Check this, i think this is actually not an issue, IIRC the compiler actually always provides
// a "None" variant, as well as "All" for convenience, so there should not be any reason to 
// even specify None in the first place.
export enum bitflag PointerButtons {
    Left,
    Right,
    Middle,
    None = 0,
}

// Bitflag enums only support construction/combination via `|` -- there's no
// language-level `&` expression operator to test membership (`&` is taken
// for reference-of), so this drops to raw C to do the AND.
export fn hasButton(buttons: PointerButtons, button: PointerButtons): bool :: final {
    do unsafe {
        let result: bool = uninitialized;
        __c__("result = (((int)buttons) & ((int)button)) != 0;");
        return result;
    };
}

// Which phase/kind of pointer event this is. Internal bookkeeping only --
// never exposed on PointerEvent itself. Exported only because it appears in
// the signatures of UIContext's (exported) dispatch methods.
export enum PointerEventKind { Down, Up, Move }

// Which of the three SYNTHESIZED press+release events a given release
// produces. Internal bookkeeping like PointerEventKind above, exported only
// because it appears in the signatures of UIContext's dispatch methods.
//
// A release never produces more than one of Click/AuxClick -- the DOM splits
// them strictly by button, primary vs. everything else -- while DoubleClick
// is an EXTRA event dispatched after Click, never instead of it.
export enum ClickEventKind { Click, DoubleClick, AuxClick }

// What still counts as "the same click sequence", so that two presses become
// a double click rather than two unrelated clicks. Both numbers are
// Chromium's, from ui/events/event.cc:
//
//     static const int kDoubleClickTimeMS = 500;
//     static const int kDoubleClickWidth = 4;
//     static const int kDoubleClickHeight = 4;
//
// ...where the width/height are compared as HALF-extents (Chromium tests
// `abs(dx) > kDoubleClickWidth / 2`), i.e. the press has to land within 2
// logical pixels of the previous one in each axis. That is deliberately
// tight: a double click is a gesture made without moving the mouse, and a
// generous radius turns "click one word, then click the next" into a double
// click on the second word.
const comptime DOUBLE_CLICK_TIME_SECONDS = 0.5;
const comptime DOUBLE_CLICK_SLOP_PX = 2.0;
// Chromium's cap (MouseEvent::GetRepeatCount clamps to 3): a fourth rapid
// press reports 3 again rather than climbing. See PointerEvent.detail.
const comptime MAX_CLICK_COUNT = 3;

// Platform-independent pointer event, modelled after the HTML PointerEvent API.
// Covers mouse, touch, and stylus in one type. stopPropagation() halts both
// the remaining capture and bubble phases -- see dispatchCapturing()/
// dispatchBubbling() below for exactly how.
export struct PointerEvent {
    pointerId: int;
    pointerType: str;
    pos: Vec2;
    button: PointerButton;
    buttons: PointerButtons;
    pressure: real;
    isPrimary: bool;
    modifiers: KeyModifiers;

    // The DOM's MouseEvent.detail: how many presses of the SAME button have
    // now landed in one uninterrupted rapid sequence at (nearly) the same
    // place. 1 for a plain click, 2 for the second press of a double click,
    // 3 for the third. Down, Up and the synthesized click/auxclick all carry
    // the count of the press that started them; Move carries 0, which is
    // also what the DOM reports for a mousemove.
    //
    // Capped at 3, exactly as Chromium caps it (ui/events/event.cc,
    // MouseEvent::GetRepeatCount): a fourth rapid press keeps reporting 3
    // rather than climbing, because nothing above "select the whole line"
    // exists to escalate to. See UIContext._clickCount for the timing and
    // distance thresholds that decide what counts as "one sequence".
    detail: int = 0;

    _stopped: bool = false;

    fn stopPropagation() {
        this._stopped = true;
    }
}

// Scroll-wheel event. Not a PointerEventKind variant -- it has no
// button/pressure semantics, it's a distinct interaction the same way
// hover/hit already get their own dedicated (non-PointerEventKind) handling
// below. delta.y > 0 is scroll "away" from the user (matches SDL's
// convention, see sdl.hz's MouseWheelEvent).
export ref struct WheelEvent {
    pos: Vec2;
    delta: Vec2;
    modifiers: KeyModifiers;
    _stopped: bool = false;

    fn stopPropagation() {
        this._stopped = true;
    }
}

// Physical key identity, independent of the platform layer's own key enum
// (e.g. sdl.Key) -- same reasoning as PointerButton(s) above: this module
// never imports sdl, so it can't reuse SDL's enum directly, and shouldn't
// bake in an assumption that every future runtime numbers keys the same way
// SDL happens to. Values are deliberately pinned to match USB HID usage IDs
// (the same real hardware-standard numbering SDL3 scancodes already use --
// see sdl.hz's own Key enum), purely as a pragmatic choice so the
// SDL-to-ui_components translation glue (see main.hz) is a single cheap cast
// instead of an N-armed mapping function; nothing here actually depends on
// SDL, and a future non-SDL runtime is free to translate however it needs to
// in its own glue layer.
export enum Key {
    Unknown = 0,
    A = 4, B = 5, C = 6, D = 7, E = 8, F = 9, G = 10, H = 11,
    I = 12, J = 13, K = 14, L = 15, M = 16, N = 17, O = 18, P = 19,
    Q = 20, R = 21, S = 22, T = 23, U = 24, V = 25, W = 26, X = 27,
    Y = 28, Z = 29,
    Num1 = 30, Num2 = 31, Num3 = 32, Num4 = 33, Num5 = 34,
    Num6 = 35, Num7 = 36, Num8 = 37, Num9 = 38, Num0 = 39,
    Return = 40,
    Escape = 41,
    Backspace = 42,
    Tab = 43,
    Space = 44,
    Minus = 45,
    Equals = 46,
    LeftBracket = 47,
    RightBracket = 48,
    Backslash = 49,
    Semicolon = 51,
    Apostrophe = 52,
    Grave = 53,
    Comma = 54,
    Period = 55,
    Slash = 56,
    CapsLock = 57,
    F1 = 58, F2 = 59, F3 = 60, F4 = 61, F5 = 62, F6 = 63,
    F7 = 64, F8 = 65, F9 = 66, F10 = 67, F11 = 68, F12 = 69,
    Insert = 73,
    Home = 74,
    PageUp = 75,
    Delete = 76,
    End = 77,
    PageDown = 78,
    Right = 79,
    Left = 80,
    Down = 81,
    Up = 82,
    LCtrl = 224,
    LShift = 225,
    LAlt = 226,
    LGui = 227,
    RCtrl = 228,
    RShift = 229,
    RAlt = 230,
    RGui = 231,
}

// Which phase/kind of key edge this is. Internal bookkeeping, exported only
// because it appears in UIContext's dispatch method signatures.
export enum KeyEdgeKind { Pressed, Released }

// Platform-independent physical key event, modelled after the DOM's
// KeyboardEvent (keydown/keyup). Fires for *every* physical key, modifiers
// included -- doesn't tell you what character (if any) was produced; that's
// TextInputEvent below, same division of labor as the DOM's keydown vs.
// input/beforeinput. Use this for shortcuts (modifiers + key, e.g. ctrl+L)
// and non-character keys (F5, Escape, arrows, ...).
export ref struct KeyboardEvent {
    key: Key;
    repeat: bool;
    modifiers: KeyModifiers;
    _stopped: bool = false;
    _defaultPrevented: bool = false;

    fn stopPropagation() {
        this._stopped = true;
    }

    // The DOM's preventDefault(), and a genuinely different thing from
    // stopPropagation(): that one stops OTHER ELEMENTS from seeing the key,
    // this one stops the FRAMEWORK from acting on it afterwards. Today that
    // means exactly one thing -- Tab moving focus (see moveFocusByTab) -- and
    // a text editor that inserts an indent on Tab must call this, or the key
    // would both indent and navigate away.
    fn preventDefault() {
        this._defaultPrevented = true;
    }

    fn defaultPrevented(): bool {
        return this._defaultPrevented;
    }
}

// Committed, layout/unicode-aware text ready to insert -- e.g. the physical
// key event for shift+A is a single KeyboardEvent{key: A, modifiers: Shift},
// but the resulting TextInputEvent carries the already-resolved "A" (or "Ä",
// or nothing yet mid-IME-composition). Use this for textbox content, not
// KeyboardEvent -- trying to reconstruct typed text from raw key events
// yourself would have to reinvent shift/caps-lock/layout/IME handling that
// the platform layer already did once, correctly.
export ref struct TextInputEvent {
    text: str;
    _stopped: bool = false;

    fn stopPropagation() {
        this._stopped = true;
    }
}

// HTML's FocusEvent, carried by all four focus events (see DivProps.onFocus).
//
// `relatedTarget` is the OTHER element in the transfer, exactly as in the DOM:
// the element GAINING focus for blur/focusout, the element LOSING it for
// focus/focusin. `none` when focus came from, or went to, nothing at all --
// a click outside every focusable element, or the first focus of the frame.
//
// It is what makes focusout usable: HTML fires focusout on every ancestor of
// the old element even when focus merely moved to a sibling INSIDE that
// ancestor, so "did focus actually leave me?" is answered by asking whether
// relatedTarget is still inside you -- see ui_contains/ElementWrapper.contains.
export ref struct FocusEvent {
    relatedTarget: ui_elements.Element | none = none;
    _stopped: bool = false;

    fn stopPropagation() {
        this._stopped = true;
    }
}

// Which of HTML's four focus events is being dispatched. They come in two
// pairs that fire at the same two moments; the difference is propagation:
// focus/blur do NOT bubble, focusin/focusout do. See dispatchFocusBubbling.
export enum FocusEventKind { Blur, FocusOut, Focus, FocusIn }

// One key press or release, in the exact order the platform layer delivered
// it -- same reasoning as PointerEdge: a single level/latch can only
// describe one transition per frame, and typing (or key auto-repeat) easily
// produces several within one frame.
export ref struct KeyEdge {
    key: Key;
    kind: KeyEdgeKind;
    repeat: bool;
    modifiers: KeyModifiers;
}

// Optional keyboard callbacks bundled as a struct, same reasoning as
// PointerHeldCallbacks. keyEdgesThisFrame()/textInputThisFrame() are this
// frame's queues, in order -- see KeyEdge and TextInputEvent above.
export ref struct KeyboardCallbacks {
    keyEdgesThisFrame: () => []KeyEdge;
    textInputThisFrame: () => []str;
}

export struct DivProps {
    // Identifies this element among its siblings, for the whole lifetime of
    // the tree -- see getOrCreateDiv. Ignored in exactly one place: the
    // DivProps a component's template RETURNS describes the component's own
    // root element, whose id is the component instance's id and was fixed
    // when the instance was created (see ComponentInstance.createChild).
    // Everything else on that DivProps applies normally.
    id: int;
    style?: ui_styling.DivStyle;
    elementRef?: ElementRef<ui_elements.DivElement>;
    // Registers this element's resolved id into `anchor` the moment it's
    // declared -- see ui_styling.AnchorTarget and UIContext.anchor(). Lets
    // some other element elsewhere in the tree target this one via
    // headwind.presets.anchorTo(), regardless of declaration order.
    anchor?: ui_styling.AnchorTarget;

    // Bubble phase (target -> root). Runs after the capture phase below.
    onPointerDown?: (e: PointerEvent) => none;
    onPointerUp?: (e: PointerEvent) => none;
    onPointerMove?: (e: PointerEvent) => none;
    onWheel?: (e: WheelEvent) => none;

    // A completed press+release of the PRIMARY (left) button, both landing
    // on this element -- HTML's `click`, and deliberately primary-only just
    // like it: a middle or right press that completes here fires onAuxClick
    // below instead, so a handler written for "the user clicked this button"
    // never has to defend itself against a right-click it did not mean.
    onClick?: (e: PointerEvent) => none;

    // The second press of a double click, after that press's own onClick --
    // HTML's `dblclick`, primary button only, and fired at e.detail == 2.
    // Note that the first click is NOT withheld waiting to see whether a
    // second one arrives (browsers do not do that either): a double click
    // fires click, click, dblclick, in that order.
    onDoubleClick?: (e: PointerEvent) => none;

    // A completed press+release of a NON-primary button (middle/wheel or
    // right) -- HTML's `auxclick`. This is where a middle-click paste, a
    // middle-click "close tab", or an open-in-background gesture belongs.
    onAuxClick?: (e: PointerEvent) => none;

    // The user asked for a context menu -- HTML's `contextmenu`. Fired on
    // the right button going DOWN, not on release, which is what Chrome
    // does on Linux and macOS (Windows is the odd one out and pops the menu
    // on release). Firing on press is also what makes press-drag-release
    // menus possible at all, so it is the more useful of the two.
    //
    // The right press ALSO produces the ordinary onPointerDown/onPointerUp/
    // onAuxClick sequence, exactly as in a browser; stopPropagation() on
    // this event stops only the contextmenu chain.
    onContextMenu?: (e: PointerEvent) => none;

    // Capture phase (root -> target). Always runs, even if a descendant's
    // bubble-phase handler calls stopPropagation() -- that call happens
    // later than every capture handler on this element's ancestors, so it
    // can't undo them. Calling stopPropagation() from a capture handler
    // itself does suppress everything queued after it, capture or bubble.
    onPointerDownCapture?: (e: PointerEvent) => none;
    onPointerUpCapture?: (e: PointerEvent) => none;
    onPointerMoveCapture?: (e: PointerEvent) => none;
    onClickCapture?: (e: PointerEvent) => none;
    onDoubleClickCapture?: (e: PointerEvent) => none;
    onAuxClickCapture?: (e: PointerEvent) => none;
    onContextMenuCapture?: (e: PointerEvent) => none;
    onWheelCapture?: (e: WheelEvent) => none;

    // "Hover": mouse is within this element's own bounds, whether or not a
    // child also claims that same point. Matches the DOM/CSS meaning of
    // :hover / mouseenter+mouseleave exactly -- ancestor-inclusive, so a
    // button stays "hovered" while the cursor is over its label text too.
    onHoverEnter?: (e: PointerEvent) => none;
    onHoverLeave?: (e: PointerEvent) => none;

    // "Hit": mouse is within this element's own bounds *and* no child is
    // also claiming that point -- i.e. this is genuinely the topmost thing
    // under the cursor. False for an element while a child is hit/hovered.
    // HTML/CSS has no equivalent to this one; it's stricter than :hover.
    onHitEnter?: (e: PointerEvent) => none;
    onHitLeave?: (e: PointerEvent) => none;

    // Opts this element into being a click target for focus (see
    // UIContext.process()'s Down handling): clicking anywhere inside a
    // focusable element focuses the *nearest* focusable element on the
    // click path (innermost wins, like tabindex on a DOM container),
    // clicking outside every focusable element blurs whatever was focused.
    // Unfocusable (the default) elements are simply skipped when searching
    // the click path for a focus target -- they neither gain focus
    // themselves nor block an ancestor from getting it.
    focusable?: bool;

    // Focus this element as soon as it first appears, without waiting for a
    // click -- the DOM's autofocus attribute. Use it so the app is usable
    // from the keyboard the instant the window opens (e.g. a text editor you
    // can type into immediately). Only meaningful together with
    // `focusable: true`, and only applied once, on this element's first
    // build; afterwards focus follows clicks and ui_focus() as usual.
    //
    // For focus that has to be decided at runtime rather than declared here,
    // use a `elementRef:` and call .focus()/.blur() on it (see ElementWrapper).
    autofocus?: bool;

    // HTML's four focus events, in the order they fire when focus moves from
    // one element to another:
    //
    //     blur (old) -> focusout (old) -> focus (new) -> focusin (new)
    //
    // focus/blur do NOT bubble -- they reach the element itself and no
    // ancestor. They DO have a capture phase, which is precisely what the
    // DOM's addEventListener(..., true) exists for: an ancestor that wants to
    // observe focus moving among its descendants registers there.
    //
    // focusin/focusout fire at the same two moments and DO bubble. This is
    // what a container uses to learn that focus entered or left its subtree --
    // but note it fires even when focus moves WITHIN that subtree, exactly as
    // in HTML. Compare `e.relatedTarget` (see FocusEvent) to tell the two
    // apart; a panel that closes when focus leaves wants
    // `if !ui_contains(self, e.relatedTarget) { close(); }`, not a bare
    // focusout handler.
    //
    // Each of the four is a separate event object, so stopPropagation() on one
    // does not suppress the others -- again matching the DOM.
    onFocus?: (e: FocusEvent) => none;
    onBlur?: (e: FocusEvent) => none;
    onFocusIn?: (e: FocusEvent) => none;
    onFocusOut?: (e: FocusEvent) => none;

    onFocusCapture?: (e: FocusEvent) => none;
    onBlurCapture?: (e: FocusEvent) => none;
    onFocusInCapture?: (e: FocusEvent) => none;
    onFocusOutCapture?: (e: FocusEvent) => none;

    // ---- Dismissal: interactions that happen OUTSIDE this element ---------
    //
    // The one thing ordinary dispatch cannot tell an element, because dispatch
    // only ever reaches what is on the path: a press that landed somewhere
    // else never puts this element on any path at all. Setting either of these
    // makes this element a DISMISSABLE LAYER -- a popup, dropdown, command
    // palette, menu -- and the framework reports outside interactions to it.
    //
    // Being in the tree IS the registration. There is nothing to subscribe or
    // unsubscribe: stop declaring the element (or hide it) and it stops being
    // a layer on the very next frame, so nothing can leak and no two
    // components have to agree about anything.
    //
    // "Outside" means outside this element's SUBTREE, which is honest here in
    // a way it is not in a browser: floating elements are still declared as
    // children of wherever they appear (ui_layout.resolveFloating tells Clay
    // where to *place* them, not where they live), so no portal can put a
    // visually-inside thing structurally elsewhere. A component rendered
    // inside a popup is genuinely inside it.
    //
    // Nesting needs no layer stack: a dropdown inside a dialog is inside the
    // dialog's subtree, so a press in the dropdown dismisses neither, and a
    // press in the dialog but outside the dropdown dismisses only the
    // dropdown. That falls out of containment for free.
    //
    // Fired AFTER the normal bubble phase, so the press that toggles a popup's
    // own trigger wins: the other way round, the trigger would read "closed"
    // and immediately reopen -- the flicker that makes popups feel broken. For
    // the same reason a handler on the normal path can call stopPropagation()
    // to suppress dismissal outright, which is how a trigger opts out of being
    // "outside".
    onPointerDownOutside?: (e: PointerEvent) => none;

    // Focus moved to an element outside this subtree -- tabbing away, or any
    // programmatic focus() elsewhere. `relatedTarget` is the element that took
    // focus. Unlike onFocusOut (the HTML event) this does NOT require focus to
    // have been inside first, which is what makes it right for a popup that
    // never took focus at all.
    //
    // Deliberately not fired for a focus change caused by a pointer press:
    // onPointerDownOutside already reports that, and reporting it twice would
    // put the dismissal ahead of the trigger's own handler.
    onFocusOutside?: (e: FocusEvent) => none;

    // Keyboard/text input is delivered only to the currently focused
    // element's ancestor chain (capture root->target, then bubble
    // target->root) -- there's no cursor position to hit-test against, so
    // unlike pointer events there's no "topmost element wins" concept here.
    onKeyDown?: (e: KeyboardEvent) => none;
    onKeyUp?: (e: KeyboardEvent) => none;
    onTextInput?: (e: TextInputEvent) => none;

    onKeyDownCapture?: (e: KeyboardEvent) => none;
    onKeyUpCapture?: (e: KeyboardEvent) => none;
    onTextInputCapture?: (e: TextInputEvent) => none;
}

export struct TextProps {
    id: int;
    style?: ui_styling.TextStyle;
    text: str;
    elementRef?: ElementRef<ui_elements.TextElement>;
}

export struct CanvasProps {
    id: int;
    style?: ui_styling.DivStyle;
    elementRef?: ElementRef<ui_elements.CanvasElement>;
    // Defaults to 4 (real hardware MSAA), applied to everything this canvas
    // draws. Set to 1 to skip it (e.g. many small canvases where the extra
    // memory/bandwidth isn't worth it); see renderer.gfx.CanvasOptions.msaaSamples.
    msaaSamples?: int;
    // Optional custom full-canvas fragment shader effect (water refraction,
    // color grading, glitch looks, ...) -- see
    // renderer.gfx.CanvasOptions.postEffect for what it can do and exactly
    // what WGSL it needs to define. Pass something like
    // embed.watchText("resources/my_effect.wgsl") created once (e.g. in your
    // component's setup closure, not freshly every frame) so hot-reloading
    // the file recompiles the effect automatically. Only read once, when
    // this canvas element's underlying GPU canvas is first created.
    postEffect?: rx.Reactive<str>;
}

// The concrete renderer handle stored, type-erased, inside this layer's own
// per-element runtime data (see ComponentElementRuntimeData below). Neither
// ui_elements nor ui_layout ever read this -- only this module (here and in
// ui_runtime's renderCanvas glue) does, via
// TypeErasedBox.get<CanvasHandle>()/set<CanvasHandle>(). Both sides must
// agree on this exact type: TypeErasedBox has no runtime type tag.
export ref struct CanvasHandle {
    canvas: mut renderer.gfx.Canvas;
}

// The concrete type stored, type-erased, inside a canvas element's runtime
// data drawFn slot. Named so it can be used as a generic argument to
// TypeErasedBox<T> (a bare function-type literal there doesn't parse).
//
// Not exported: this alias's body references a cross-module qualified type
// (renderer.gfx.Renderer), and the compiler's cross-module shim generator
// mangles qualified types correctly for ref struct fields and function/method
// parameters, but has a codegen bug specifically for top-level exported
// `type X = (...) => Y;` aliases that reference a qualified cross-module
// type -- it leaves the module prefix unmangled, which then fails to
// resolve in a consumer project. runCanvasDrawFn() below is the safe
// boundary other modules use instead of naming this type directly.
export type CanvasDrawFn = (r: mut renderer.gfx.Renderer) => void;

// Invokes the draw closure boxed by canvas()'s `drawFn` parameter against
// `r`, if one was provided. Lets other modules (e.g. ui_runtime) trigger a
// canvas element's per-frame redraw without ever naming CanvasDrawFn
// themselves -- exported plain functions, unlike exported type aliases,
// don't hit the bug described above, so this is the boundary that's safe
// to cross.
export fn runCanvasDrawFn(drawFnBox: TypeErasedBox | none, r: mut renderer.gfx.Renderer): void {
    if drawFnBox {
        let drawFn = drawFnBox.get<CanvasDrawFn>();
        drawFn(r);
    }
}

// Render/input feedback and an element's GPU canvas handle/drawFn used to
// live as dedicated fields on the element itself (ui_elements.*Element).
// They don't anymore -- ui_elements only knows about an opaque
// `_runtimeData` slot, and this ref struct is what *this* module (the only
// thing that creates elements) stores there. position()/size()/hover()
// below read it back out; ui_elements and ui_layout never see this type.
export ref struct RenderFeedback {
    position: Vec2;
    size: Vec2;
}

export ref struct InputFeedback {
    // Bounds-based: mouse is within this element, possibly also within a
    // child. Matches HTML/CSS :hover.
    hover: bool;
    // Strict: mouse is within this element and not also within any child --
    // i.e. this is genuinely the topmost thing under the cursor. No HTML/CSS
    // equivalent.
    hit: bool;
    pointerDownHere: bool;  // tracks whether a pointerdown landed on this element (for click)
}

// One entry in a parent element's own child-element cache -- see
// ComponentElementRuntimeData.childElements below. Keyed by the child's bare
// per-level id (unique only among its siblings, not globally), so finding an
// already-created child never needs this module's slash-separated idPath
// convention -- that convention still exists (see childIdPath()) but is only
// ever computed once, the moment a given child is first created, and stored
// permanently here afterwards.
export struct ChildElementEntry {
    id: int;
    // Full slash-separated id path from the component root, computed once
    // via childIdPath() when this entry was first created and never touched
    // again. Not used for lookup -- kept only so this element's full path
    // remains available without re-deriving it (e.g. for diagnostics).
    path: str;
    element: mut ui_elements.Element;
}

// A pending programmatic focus change, parked on an element's runtime data
// until the next process() applies it -- see
// ComponentElementRuntimeData.focusRequested and UIContext.applyPendingFocus.
// `Blur` is distinct from `None` on purpose: "this element asked to be
// blurred" and "this element has no pending request" have to be told apart,
// otherwise a blur() would be indistinguishable from never having been called.
export enum FocusRequest { None, Focus, Blur }

// Out-parameter for UIContext.takeFocusRequest's tree walk, which has to
// report two things at once (which kind of request, and whose) while still
// recursing -- a plain return value can't carry both back up out of a
// recursive walk without allocating on every level.
export struct FocusRequestTarget {
    kind: FocusRequest = FocusRequest.None;
    // The ELEMENT, not its runtime data: applyFocusChange needs the node
    // itself, both to walk its ancestor path and to hand it to the other side
    // of the transfer as FocusEvent.relatedTarget.
    element: ui_elements.Element | none = none;
}

export ref struct ComponentElementRuntimeData {
    renderFeedback?: RenderFeedback;
    renderFeedbackVersion: rx.Reactive<bool>;
    inputFeedback?: InputFeedback;
    inputFeedbackVersion: rx.Reactive<bool>;
    handle?: TypeErasedBox;
    drawFn?: TypeErasedBox;
    msaaSamples: int = 4;
    postEffect?: rx.Reactive<str>;

    // This element's own direct children, created via div()/text()/canvas()
    // while this element was `currentParent` -- see getOrCreateDiv/Text/
    // Canvas below. Living here (per-parent) rather than as one flat array
    // on the whole ComponentInstance (the old design) means each lookup only
    // scans however many direct children this element actually has, not
    // every element anywhere in the component.
    childElements: []ChildElementEntry = [];

    onPointerDown?: (e: PointerEvent) => none;
    onPointerUp?: (e: PointerEvent) => none;
    onPointerMove?: (e: PointerEvent) => none;
    onClick?: (e: PointerEvent) => none;
    onDoubleClick?: (e: PointerEvent) => none;
    onAuxClick?: (e: PointerEvent) => none;
    onContextMenu?: (e: PointerEvent) => none;
    onWheel?: (e: WheelEvent) => none;

    onPointerDownCapture?: (e: PointerEvent) => none;
    onPointerUpCapture?: (e: PointerEvent) => none;
    onPointerMoveCapture?: (e: PointerEvent) => none;
    onClickCapture?: (e: PointerEvent) => none;
    onDoubleClickCapture?: (e: PointerEvent) => none;
    onAuxClickCapture?: (e: PointerEvent) => none;
    onContextMenuCapture?: (e: PointerEvent) => none;
    onWheelCapture?: (e: WheelEvent) => none;

    onHoverEnter?: (e: PointerEvent) => none;
    onHoverLeave?: (e: PointerEvent) => none;
    onHitEnter?: (e: PointerEvent) => none;
    onHitLeave?: (e: PointerEvent) => none;

    // Focus: see DivProps.focusable. `focused` is plain per-element state
    // (not a UIContext-held pointer to "the" focused element) so that
    // finding the currently-focused element's ancestor chain each frame is
    // just a tree walk checking this flag (see UIContext.buildFocusPath) --
    // deliberately avoiding needing to compare two element/ref struct handles
    // for identity, which Haze has no safe operator for.
    focusable: bool = false;
    focused: bool = false;
    focusVersion: rx.Reactive<bool>;

    // Programmatic focus (ElementWrapper.focus()/blur(), see also
    // UIContext.applyPendingFocus): a *request*, not the focus state itself.
    // Focusing has to blur whatever else was focused, which needs the tree
    // root -- and an ElementWrapper only knows its own element, so it cannot
    // do that work itself. Instead it just flags its intent here and the next
    // process() resolves it against the real root, exactly like every other
    // piece of per-element state in this module (a flag found by a tree walk,
    // never a remembered handle -- see buildFocusPath's comment).
    //
    // Deliberately not reactive: nothing renders off "a focus was requested",
    // only off `focused` above, which applyFocusChange already bumps.
    focusRequested: FocusRequest = FocusRequest.None;
    // CSS :focus-visible. True while this element is focused AND the focus did
    // not arrive from a pointer press -- keyboard navigation, or a
    // programmatic focus(). It is what a focus RING should be drawn from:
    // showing one on every click is the thing everyone turns off, and showing
    // none on tab makes the UI unusable from the keyboard.
    //
    // Reported through the same focusVersion reactive as `focused`, so a style
    // that reads it re-evaluates on exactly the same events.
    focusVisible: bool = false;

    // Whether DivProps.autofocus has already had its one and only chance to
    // fire for this element. Set on the first build regardless of whether
    // autofocus was actually set, so that toggling `autofocus` on later
    // (after the element already exists) doesn't retroactively steal focus --
    // matching the DOM, where the attribute only matters at insertion time.
    autofocusApplied: bool = false;

    onFocus?: (e: FocusEvent) => none;
    onBlur?: (e: FocusEvent) => none;
    onFocusIn?: (e: FocusEvent) => none;
    onFocusOut?: (e: FocusEvent) => none;
    onFocusCapture?: (e: FocusEvent) => none;
    onBlurCapture?: (e: FocusEvent) => none;
    onFocusInCapture?: (e: FocusEvent) => none;
    onFocusOutCapture?: (e: FocusEvent) => none;
    onPointerDownOutside?: (e: PointerEvent) => none;
    onFocusOutside?: (e: FocusEvent) => none;

    onKeyDown?: (e: KeyboardEvent) => none;
    onKeyUp?: (e: KeyboardEvent) => none;
    onTextInput?: (e: TextInputEvent) => none;
    onKeyDownCapture?: (e: KeyboardEvent) => none;
    onKeyUpCapture?: (e: KeyboardEvent) => none;
    onTextInputCapture?: (e: TextInputEvent) => none;
}

fn newRuntimeData(): ComponentElementRuntimeData {
    return ComponentElementRuntimeData {
        renderFeedbackVersion: rx.reactive<bool>(false),
        inputFeedbackVersion: rx.reactive<bool>(false),
        focusVersion: rx.reactive<bool>(false),
    };
}

// Lazily attaches a ComponentElementRuntimeData to `element` if it doesn't
// have one yet, and returns it. The one and only place that knows
// `_runtimeData`'s concrete type.
fn makeButtons(left: bool, middle: bool, right: bool): PointerButtons {
    let b: PointerButtons = PointerButtons.None;
    if left { b = b | PointerButtons.Left; }
    if middle { b = b | PointerButtons.Middle; }
    if right { b = b | PointerButtons.Right; }
    return b;
}

export fn runtimeDataOf(element: ui_elements.Element): ComponentElementRuntimeData {
    if element is ui_elements.DivElement {
        if element._runtimeData {
            return element._runtimeData.get<ComponentElementRuntimeData>();
        }
        let data = TypeErasedBox<ComponentElementRuntimeData>(newRuntimeData());
        element._runtimeData = data;
        return data.get<ComponentElementRuntimeData>();
    }
    else if element is ui_elements.TextElement {
        if element._runtimeData {
            return element._runtimeData.get<ComponentElementRuntimeData>();
        }
        let data = TypeErasedBox<ComponentElementRuntimeData>(newRuntimeData());
        element._runtimeData = data;
        return data.get<ComponentElementRuntimeData>();
    }
    else {
        if element._runtimeData {
            return element._runtimeData.get<ComponentElementRuntimeData>();
        }
        let data = TypeErasedBox<ComponentElementRuntimeData>(newRuntimeData());
        element._runtimeData = data;
        return data.get<ComponentElementRuntimeData>();
    }
}

// Same convention ui_layout.hz uses to build its idPath while walking the
// rendered tree, kept in sync here so both sides agree on what "the path to
// this element" means. Only ever called when an element is first created
// (see getOrCreateDiv/Text/Canvas below) -- every later frame's lookup for
// that same element is a plain per-parent id comparison and never reaches
// this function, which is the one that used to run, and allocate a fresh
// string, for every element on every frame.
fn childIdPath(parentPath: str, id: int): str {
    return parentPath == "" ? f"{id}" : parentPath + "/" + f"{id}";
}

// A new element's own globally-unique id across the whole tree: its
// parent's own globalId (see DivElement.globalId's own comment) extended
// with its local `id`. Distinct from childIdPath() above -- that one is a
// different, component-scoped convention this module only uses for its own
// diagnostics; this is the one ui_layout actually registers elements with
// Clay under, and the one AnchorTarget resolves anchorTo() targets through.
// Only ever called once per element, right here at creation, with an
// already-constructed `parent`, whose own globalId is therefore always
// already known (all the way up to the tree root -- see
// makeCurrentComponentAvailable, the only place that ever mints one from
// scratch instead of extending a parent's).
fn childGlobalId(parent: ui_elements.DivElement, id: int): str {
    return parent.globalId + "/" + f"{id}";
}

struct DivLookup {
    element: mut ui_elements.DivElement;
    path: str;
}

struct TextLookup {
    element: mut ui_elements.TextElement;
    path: str;
}

struct CanvasLookup {
    element: mut ui_elements.CanvasElement;
    path: str;
}

// Finds `id`'s existing child of `parent`, or creates and caches a new one --
// see ComponentElementRuntimeData.childElements for why this is a per-parent
// cache keyed by plain id instead of one flat component-wide cache keyed by
// full path. `parentPath` (parent's own full path, cheap to pass down --
// it's just a stored string, not something built fresh here) is only read on
// a genuine miss, to compute and permanently store this new element's own
// full path; an existing element's path is read back off its cache entry
// instead of being recomputed.
fn getOrCreateDiv(parent: mut ui_elements.DivElement, id: int, parentPath: str): DivLookup {
    let parentData = runtimeDataOf(parent);
    for n in parentData.childElements {
        if n.id == id {
            assert(n.element is mut ui_elements.DivElement, "Div expected but other node type encountered");
            return { element: n.element, path: n.path };
        }
    }
    let path = childIdPath(parentPath, id);
    let newElement = ui_elements.DivElement({ id: id, globalId: childGlobalId(parent, id), style: {} });
    parentData.childElements.push({ id: id, path: path, element: newElement });
    return { element: newElement, path: path };
}

fn getOrCreateText(parent: ui_elements.DivElement, id: int, parentPath: str): TextLookup {
    let parentData = runtimeDataOf(parent);
    for n in parentData.childElements {
        if n.id == id {
            assert(n.element is mut ui_elements.TextElement, "Text element expected but other node type encountered");
            return { element: n.element, path: n.path };
        }
    }
    let path = childIdPath(parentPath, id);
    let newElement = ui_elements.TextElement({ id: id, globalId: childGlobalId(parent, id), text: "", style: {} });
    parentData.childElements.push({ id: id, path: path, element: newElement });
    return { element: newElement, path: path };
}

fn getOrCreateCanvas(parent: mut ui_elements.DivElement, id: int, parentPath: str): CanvasLookup {
    let parentData = runtimeDataOf(parent);
    for n in parentData.childElements {
        if n.id == id {
            assert(n.element is mut ui_elements.CanvasElement, "Canvas element expected but other node type encountered");
            return { element: n.element, path: n.path };
        }
    }
    let path = childIdPath(parentPath, id);
    let newElement = ui_elements.CanvasElement({ id: id, globalId: childGlobalId(parent, id), style: {} });
    parentData.childElements.push({ id: id, path: path, element: newElement });
    return { element: newElement, path: path };
}

// Reactive accessors over an element's layout/input feedback. These used to
// be methods on the element structs themselves; now they're free functions
// over the runtime data this module owns, since ui_elements holds neither
// the data nor the concept.
// A hidden element (`display: none`) reports NO geometry, rather than the
// geometry it had when it was last visible.
//
// Nothing clears render feedback when an element stops being laid out -- the
// layout pass simply never mentions it again -- so the stored box would
// otherwise persist indefinitely and read as a real, current position. That
// is a stale value dressed up as a live one: a caller measuring a hidden
// element (an inactive tab's viewport, say) would size or place something
// against coordinates from an arbitrary earlier frame. `none` is the honest
// answer and the one callers already handle, since it is what any element
// that has not been laid out yet returns.
export fn ui_position(element: ui_elements.Element): Vec2 | none {
    let data = runtimeDataOf(element);
    rx.get(data.renderFeedbackVersion);
    if ui_elements.isDisplayNone(element) {
        return none;
    }
    return data.renderFeedback ? data.renderFeedback.position : none;
}

export fn ui_size(element: ui_elements.Element): Vec2 | none {
    let data = runtimeDataOf(element);
    rx.get(data.renderFeedbackVersion);
    if ui_elements.isDisplayNone(element) {
        return none;
    }
    return data.renderFeedback ? data.renderFeedback.size : none;
}

export fn ui_hover(element: ui_elements.Element): bool {
    let data = runtimeDataOf(element);
    rx.get(data.inputFeedbackVersion);
    return data.inputFeedback ? data.inputFeedback.hover : false;
}

export fn ui_hit(element: ui_elements.Element): bool {
    let data = runtimeDataOf(element);
    rx.get(data.inputFeedbackVersion);
    return data.inputFeedback ? data.inputFeedback.hit : false;
}

// Mirrors CSS :active -- true while the pointer is both held down *and*
// currently over this element (bounds-based, ancestor-inclusive, same as
// `hover`; not `hit`), given that the press also started on this element (or
// a descendant) in the first place. Answers your "off, then back on" case
// directly: while the pointer is off, `hover` is false, so this is false
// (falls back to the normal color) regardless of the button still being
// held; drag back on and it's true again (pressed/active color) -- no
// separate "was this the original press target" bookkeeping needed here,
// since pointerDownHere (see process()'s Down/Up handling) already only
// stays true on elements the press actually started on.
export fn ui_active(element: ui_elements.Element): bool {
    let data = runtimeDataOf(element);
    rx.get(data.inputFeedbackVersion);
    if !data.inputFeedback { return false; }
    return data.inputFeedback.hover && data.inputFeedback.pointerDownHere;
}

// Mirrors CSS :focus -- true for the one element (if any) currently focused.
// See DivProps.focusable/onFocus/onBlur for how an element becomes focused.
// Every element's own tree-wide identity string -- see DivElement.globalId.
fn globalIdOf(element: ui_elements.Element): str {
    if element is ui_elements.DivElement { return element.globalId; }
    else if element is ui_elements.TextElement { return element.globalId; }
    else if element is ui_elements.CanvasElement { return element.globalId; }
    return "";
}

// The DOM's Node.contains(): true if `other` IS `element` or sits anywhere
// beneath it. Lives here rather than in ui_elements because the reason it
// exists is FocusEvent.relatedTarget -- HTML's focusout fires on an ancestor
// even when focus only moved between its own descendants, so "did focus really
// leave this subtree?" is `!ui_contains(self, e.relatedTarget)` and nothing
// else. A `none` other is never contained, which gives that check the right
// answer for free when focus went nowhere at all.
//
// A prefix test rather than a subtree walk, because globalId already IS the
// path: it is built as parent.globalId + "/" + localId (see childGlobalId), so
// a descendant's id is the ancestor's id followed by a separator. Testing for
// that separator is what keeps "1/2" from claiming to contain "1/23".
export fn ui_contains(element: ui_elements.Element, other: ui_elements.Element | none): bool {
    if other is none {
        return false;
    }
    let self = globalIdOf(element);
    let target = globalIdOf(other);
    if self == target {
        return true;
    }
    return target.startsWith(self + "/");
}

export fn ui_focused(element: ui_elements.Element): bool {
    let data = runtimeDataOf(element);
    rx.get(data.focusVersion);
    return data.focused;
}

// CSS :focus-visible -- see ComponentElementRuntimeData.focusVisible. Focused,
// and focused by something other than a pointer press.
export fn ui_focusVisible(element: ui_elements.Element): bool {
    let data = runtimeDataOf(element);
    rx.get(data.focusVersion);
    return data.focused && data.focusVisible;
}

// Forces the next frame to actually run, even when nothing reactive changed
// -- see UIContext.needsUpdate for the gate this opens.
//
// Needed by everything that changes what the frame would produce WITHOUT
// going through a reactive cell: a programmatic focus request (below), a
// layout-size change (ui_runtime.Runtime.resize), or a host that mutated
// plain state behind the UI's back. Reactive writes need none of this --
// they invalidate the template or trip a watcher's scheduler on their own,
// which is what opens the gate for them.
//
// One flag, not a count: it means "run one more frame", and one frame is
// enough no matter how many requests piled up before it.
export fn ui_requestUpdate(): none {
    __ui_updateRequested = true;
}

// Reads and clears the flag. Called once per frame that actually runs, at
// the point that frame has committed to doing the work -- so a request made
// *during* that frame (a handler calling ui_focus, say) sets it again and
// is honoured by the next one rather than being swallowed.
fn ui_takeUpdateRequest(): bool {
    let requested = __ui_updateRequested;
    __ui_updateRequested = false;
    return requested;
}

// Whether a frame has been requested, without consuming the request.
fn ui_updateRequested(): bool {
    return __ui_updateRequested;
}

// Programmatic counterpart to clicking a focusable element -- the equivalent
// of the DOM's HTMLElement.focus(). Takes effect on the next process(), not
// here (see ComponentElementRuntimeData.focusRequested for why), so
// ui_focused() keeps reporting the old value until then; onFocus/onBlur fire
// from that frame's normal FIRE PHASE, in the same order and with the same
// timing a click-driven focus change would produce.
//
// Focusing an element that isn't `focusable` is a no-op, mirroring
// click-to-focus (which skips non-focusable elements entirely) rather than
// silently creating a focus target keyboard events could reach but no click
// ever could.
export fn ui_focus(element: ui_elements.Element): void {
    let data = runtimeDataOf(element);
    if !data.focusable {
        return;
    }
    data.focusRequested = FocusRequest.Focus;
    // focusRequested is a plain field, invisible to the reactive graph, and
    // it is applied by the NEXT process() (see applyPendingFocus) -- so that
    // frame has to be made to happen, or a focus() from a click handler
    // would sit unapplied until something else invalidated the tree.
    ui_requestUpdate();
}

// Programmatic blur -- the DOM's HTMLElement.blur(). Only blurs if this
// element is actually the focused one by the time the request is applied,
// so a stale blur() can never knock out whatever got focused after it.
export fn ui_blur(element: ui_elements.Element): void {
    let data = runtimeDataOf(element);
    data.focusRequested = FocusRequest.Blur;
    ui_requestUpdate();
}

// Sets pointerDownHere and bumps inputFeedbackVersion, but only when the
// value actually changes -- pointerDownHere feeds ui_active() above, so a
// change here must be reactive (unlike before ui_active() existed, when
// pointerDownHere was write-only state nothing needed to react to).
fn setPointerDownHere(data: ComponentElementRuntimeData, value: bool): void :: final {
    if !data.inputFeedback { return; }
    if data.inputFeedback.pointerDownHere != value {
        data.inputFeedback.pointerDownHere = value;
        data.inputFeedbackVersion := !data.inputFeedbackVersion;
    }
}

// Meant to be plugged in as a layout engine's "bounding box" callback (e.g.
// ui_layout.RenderCallbacks.onBoundingBox, wired up by ui_runtime). Bumps
// the reactive render-feedback version only when the box actually changed,
// same as the old per-field dirty-checking that used to live in hzui's
// applyBoundingBoxTrampoline.
export fn applyRenderFeedback(element: ui_elements.Element, pos: Vec2, size: Vec2): void {
    let data = runtimeDataOf(element);
    if !data.renderFeedback {
        data.renderFeedback = { position: pos, size: size };
        data.renderFeedbackVersion := !data.renderFeedbackVersion;
        return;
    }
    if data.renderFeedback.position.x != pos.x || data.renderFeedback.position.y != pos.y ||
       data.renderFeedback.size.x != size.x || data.renderFeedback.size.y != size.y {
        data.renderFeedback.position = pos;
        data.renderFeedback.size = size;
        data.renderFeedbackVersion := !data.renderFeedbackVersion;
    }
}

// ── OS titlebar regions ──────────────────────────────────────────────────
//
// The walk that turns "this element is styled `os-titlebar`" into the flat
// list of boxes the platform's hit test reads. See ui_styling.OSTitlebar for
// what the style axis means and WindowRegion for what comes out.

// This element's own explicit answer, or none if it took no position.
// Only Div and Canvas carry a ComputedDivStyle; a TextElement has no style
// axis of its own and is covered by the div wrapping it, exactly as it is for
// `cursor` (see UIContext.resolveCursor).
fn osTitlebarOf(element: ui_elements.Element): ui_styling.OSTitlebar | none :: final {
    if element is ui_elements.DivElement {
        return element.style.osTitlebar;
    }
    if element is ui_elements.CanvasElement {
        return element.style.osTitlebar;
    }
    return none;
}

// Does this element take pointer input of its own?
//
// A titlebar's buttons do, and so must NOT be part of the draggable region: a
// press on a close button has to arrive here, while a press on the strip
// beside it has to go to the window manager. Read off the handlers the
// element actually has rather than requiring an annotation, so an ordinary
// Button dropped into a titlebar simply works -- which is both what anyone
// would expect and the version that cannot be forgotten. An explicit
// `os-titlebar` still wins, for the rare case where something interactive
// really should drag the window.
//
// `focusable` counts: an element that can take focus by being clicked is
// click-driven by definition, even with no handler of its own yet.
fn isPointerInteractive(element: ui_elements.Element): bool :: final {
    let data = runtimeDataOf(element);
    if data.focusable { return true; }
    if data.onPointerDown { return true; }
    if data.onPointerUp { return true; }
    if data.onClick { return true; }
    if data.onDoubleClick { return true; }
    if data.onAuxClick { return true; }
    if data.onContextMenu { return true; }
    if data.onWheel { return true; }
    if data.onPointerDownCapture { return true; }
    if data.onClickCapture { return true; }
    return false;
}

// Depth first, in declaration order -- which is paint order, so the platform
// resolves every overlap by taking the LAST match and nothing here has to
// compute intersections or sort anything.
//
// Only TRANSITIONS are emitted, never one box per element: an element
// contributes nothing unless its own answer differs from the region it sits
// inside. A titlebar is therefore one box plus one hole per control, however
// many wrappers, labels and icons it happens to be built out of.
//
// `inTitlebar` is what the enclosing boxes decided, and it is also why
// interactivity is only consulted INSIDE a titlebar: an editor is full of
// clickable things and not one of them is a hole in anything.
fn collectWindowRegions(element: ui_elements.Element, out: []WindowRegion, inTitlebar: bool): void :: final {
    // A hidden subtree keeps whatever box it had when it was last visible
    // (nothing clears render feedback -- see collectHitPath), so this check
    // has to be explicit: without it a closed panel would go on donating a
    // draggable strip to a window that no longer shows one.
    if ui_elements.isDisplayNone(element) {
        return;
    }

    let decided = false;
    let draggable = false;
    let explicit = osTitlebarOf(element);
    if explicit {
        decided = true;
        draggable = explicit == ui_styling.OSTitlebar.Drag;
    }
    else if inTitlebar && isPointerInteractive(element) {
        decided = true;
        draggable = false;
    }

    let childInTitlebar = inTitlebar;
    if decided {
        childInTitlebar = draggable;
        let pos = ui_position(element);
        let size = ui_size(element);
        // No box yet (an element that has never been laid out) simply
        // contributes nothing this frame; its children still can, so the walk
        // continues either way.
        if pos && size {
            out.push({ pos: pos, size: size, draggable: draggable });
        }
    }

    if element is ui_elements.DivElement {
        for child in element.children {
            collectWindowRegions(child, out, childInTitlebar);
        }
    }
}

// When a watcher's callback runs relative to the frame's template pass
// (Vue's `flush` option). See UIContext.flushJobs.
export enum WatchFlush {
    // Before the template pass: what the callback writes is rendered in the
    // same frame. The default.
    Pre,
    // After the template pass, once this frame's element refs are bound.
    Post,
    // Synchronously, inside the very write that triggered it.
    Sync,
}

// Vue's job queue (scheduler.ts) for watcher jobs. Sorted by watcher id --
// creation order, so a parent's watchers run before its children's -- and
// a job is never queued twice. A job queued while the queue is flushing
// lands behind the cursor and runs in the same flush; a job that keeps
// re-queueing itself is cut off after Vue's 100 runs and skipped, which
// breaks the cycle.
export ref struct WatchJobQueue {
    jobs: []rx.WatchJob = [];
    flushing: bool = false;
    cursor: int = 0;
    generation: int = 0;

    fn queue(job: rx.WatchJob) {
        let i = 0;
        if this.flushing {
            i = this.cursor + 1;
        }
        while i < this.jobs.length {
            let queued = this.jobs[i];
            if queued.id == job.id {
                return;
            }
            if queued.id > job.id {
                break;
            }
            i = i + 1;
        }
        this.jobs.insert(i, job);
    }

    fn flush() {
        this.flushing = true;
        this.generation = this.generation + 1;
        this.cursor = 0;
        while this.cursor < this.jobs.length {
            let job = this.jobs[this.cursor];
            if job.flushGeneration != this.generation {
                job.flushGeneration = this.generation;
                job.runs = 0;
            }
            if job.runs >= 100 {
                fmt.println("[ui] Maximum recursive updates exceeded. A watcher keeps writing state that triggers it again.");
            } else {
                job.runs = job.runs + 1;
                job.run();
            }
            this.cursor = this.cursor + 1;
        }
        this.jobs.clear();
        this.flushing = false;
    }
}

export ref struct ComponentInstance {
    id: int;

    templateComputed?: rx.Computed<none>;
    setupDone: bool = false;
    // A template returns the props of the component's own root element -- the
    // template IS an element declaration, exactly like every div inside it.
    // See defineComponentImpl for what happens to the result.
    currentTemplate: (() => DivProps) | null = null;
    propsVersion: rx.Reactive<int>;
    prevProps?: TypeErasedBox;
    instanceDataForCapturing?: TypeErasedBox;

    struct ComponentCache {
        id: int;
        component: ComponentInstance;
    }

    childComponents: []ComponentCache = [];
    newChildComponents: []ComponentCache = [];

    rootElement: mut ui_elements.DivElement;

    onMounted?: () => none;
    onUnmount?: () => none;
    // See UIContext.onFrame.
    onFrame?: () => none;
    // Every watcher this component's setup created (UIContext.watch); all
    // stopped when the component is destroyed, like Vue's effect scope.
    watchers: []rx.WatchHandle = [];

    mounted: bool = false;
    crashed: bool = false;
    crashInfo: sys.PanicInfo | none = none;

    fn findChild(id: int): ComponentInstance | null {
        for n in this.childComponents {
            if n.id == id {
                return n.component;
            }
        }
        return null;
    }

    // `parentElement` is the real DivElement this component is being
    // instantiated under -- always available, since this is only ever
    // called from makeCurrentComponentAvailable's renderStack-non-empty
    // branch -- used to resolve this component's own wrapper root's
    // permanent global id (see childGlobalId()) the one time it's created.
    fn createChild(id: int, parentElement: ui_elements.DivElement): ComponentInstance {
        // This element is the component's ROOT: the template declares it and
        // returns its props, so from the first render on its style comes from
        // there (see defineComponentImpl). The Grow/Grow here is only what it
        // looks like before that first render -- and it is also the base layer
        // defineComponentImpl resolves against, for the reason spelled out
        // there: a component boundary must be a transparent pass-through by
        // default, not a Fit box that blocks an ancestor's Grow from reaching
        // a descendant that wants it.
        let rootElement = ui_elements.DivElement({
            id: id,
            globalId: childGlobalId(parentElement, id),
            style: { width: ui_styling.SizeMode.Grow, height: ui_styling.SizeMode.Grow },
        });
        return ComponentInstance {
            id: id,
            rootElement: rootElement,
            propsVersion: rx.reactive<int>(0),
        };
    }
}

// A value: renderStack holds these inline, so pushing a context for every
// div()/component during a render pass costs no allocation.
export struct RenderContext {
    currentComponent: ComponentInstance;
    currentParent: mut ui_elements.DivElement;
    // currentParent's own full slash-separated id path from the component
    // root (e.g. "0/3"), mirroring the idPath convention ui_layout.hz uses
    // for the same tree. Carried down purely so a *newly created* child can
    // compute and permanently store its own full path (see childIdPath() and
    // getOrCreateDiv/Text/Canvas) -- element lookup itself is now keyed by
    // the bare per-level id against currentParent's own child cache (see
    // ComponentElementRuntimeData.childElements), never against this path.
    idPath: str;
    // How many of currentParent.children have been (re-)declared so far in
    // this build pass -- see attachChild()/truncateChildrenToCursor(). Starts
    // at 0 for free every time a fresh RenderContext is pushed; nothing needs
    // to reset it explicitly.
    childIndex: int = 0;
}

export ref struct InstanceData<TProps> {
    _props: TProps;
    _propsVersion: rx.Reactive<int>;

    fn props() {
        rx.get(this._propsVersion);
        return this._props;
    }
}

export enum PointerEdgeKind { Pressed, Released }

// One this-frame press or release, in the exact order the platform layer
// delivered it, with the cursor position at that moment. edgesThisFrame()
// below returns every one of these queued so far this frame -- not just
// whether *a* press/release happened -- because a single boolean (whether
// read as a level or a latch) can only ever describe one transition per
// frame. Two, three, or a burst of clicks landing within the same frame
// (trivially reachable at a low frame rate, or from a fast enough clicker
// even at a high one) would otherwise collapse to whatever the net effect
// happens to be -- typically nothing, since each down+up pair cancels out --
// silently dropping every click but the last. See UIContext.process(), which
// replays this queue in order so nothing reported within a frame is ever
// lost, no matter how many events land in that frame.
export ref struct PointerEdge {
    button: PointerButton;
    kind: PointerEdgeKind;
    pos: Vec2;
}

// Optional pointer-button callbacks bundled as a struct. Using a ref struct avoids
// the (() => bool) | none union that Haze cannot implicitly coerce a lambda into.
//
// *Held is the continuous level state (used for the PointerEvent.buttons
// bitmask and for Move's drag pressure). edgesThisFrame() is the ordered
// press/release queue described on PointerEdge above, used for Down/Up/Click.
export ref struct PointerHeldCallbacks {
    leftHeld: () => bool;
    middleHeld: () => bool;
    rightHeld: () => bool;
    edgesThisFrame: () => []PointerEdge;
}

// Optional wheel/modifier poll callbacks, bundled for the same reason as
// PointerHeldCallbacks above. wheelDelta() is this-frame's accumulated
// scroll delta (zero most frames); modifiers() is read every frame and
// stamped onto every event this module produces (PointerEvent and
// WheelEvent alike), not just wheel.
export ref struct InputExtrasCallbacks {
    wheelDelta: () => Vec2;
    modifiers: () => KeyModifiers;
}

// Optional OS clipboard bridge, bundled for the same reason as
// PointerHeldCallbacks above.
//
// It has to come from the host for the same reason setCursor does: this
// module knows nothing about any windowing layer, and neither may the
// widgets built on it -- ui_widgets depends on none of app/sdl, so a text
// box cannot call app.getClipboardText() itself. The host, which is the one
// piece that does know, hands its clipboard down here.
//
// getText() returns "" when the clipboard is empty or holds something that
// is not text (an image, say), matching app.getClipboardText(). setText()
// reports whether the platform took it.
export ref struct ClipboardCallbacks {
    getText: () => str;
    setText: (text: str) => bool;
}

// ── The OS window ────────────────────────────────────────────────────────
//
// One box the UI publishes to the platform as part of (or explicitly not part
// of) the window's own titlebar -- see ui_styling.OSTitlebar for what that
// means and why a native application needs it at all.
//
// Emitted in PAINT order, so a later box wins wherever two overlap. That is
// what makes a hole work: a close button's box comes after the titlebar's
// because it is drawn after it.
//
// `pos`/`size` are in the same logical coordinate space as everything else
// the UI works in.
export struct WindowRegion {
    pos: Vec2;
    size: Vec2;
    // False marks a hole: this box is NOT titlebar, even inside one that is.
    draggable: bool;
}

// The host's window, bundled and optional for exactly the reason
// ClipboardCallbacks above is: this module knows nothing about SDL or any
// other windowing layer, and neither may anything built on it, so a titlebar
// component cannot reach for app.requestClose() itself. The host, which is
// the one piece that does know, hands its window down here.
//
// Reached from component code as `ui.window` -- see WindowApi, which is the
// small curated surface those callbacks are offered through. A context with
// none of this wired up (a headless test, an embedded surface) answers
// `ui.window.available()` with false and treats every call as a no-op.
export ref struct WindowCallbacks {
    // Ask the window to close. This must take the SAME path the platform's
    // own close button takes -- app.App.requestClose pushes the platform's
    // close event rather than shortcutting to a shutdown flag -- so that an
    // application has one shutdown sequence and not two.
    requestClose: () => void;
    minimize: () => void;
    maximize: () => void;
    restore: () => void;
    // Polled once a frame (see WindowApi.poll), because the platform can
    // change this without any input this process ever sees: a double click on
    // the titlebar, a keyboard gesture, a snap to the side of the screen.
    isMaximized: () => bool;
    // Does the OS draw this window's titlebar? False is what tells a UI shell
    // that it owes the window one of its own.
    hasNativeTitlebar: () => bool;
    // This frame's titlebar boxes, in paint order. Called only on frames
    // where something could have moved -- see UIContext.syncWindowRegions.
    setRegions: (regions: []WindowRegion) => void;
}

// The window this UI is running in, as component code is allowed to touch it:
// `ui.window.close()`, `ui.window.toggleMaximize()`, and nothing else.
//
// Deliberately its own small object rather than more methods on UIContext.
// UIContext's surface is large and mostly framework internals (defineComponent,
// process, the hit-path walks), and none of that is something a component
// should be offered -- so the window operations live behind a name that
// contains exactly them, and an editor completing `ui.window.` shows the whole
// list.
//
// Per-UIContext rather than global, because a window is: one context drives
// one window, so `ui.window.close()` means "the window THIS component is in".
// The day a second window exists that sentence still picks the right one, with
// nothing here to change.
export ref struct WindowApi {
    _cb?: WindowCallbacks;
    // The platform's maximized flag, mirrored into a reactive cell so a
    // titlebar's maximize/restore icon re-renders the moment it flips -- see
    // poll(), which is the only thing that ever writes it.
    _maximized: rx.Reactive<bool>;
    // The last value poll() read from the platform. A plain field, not a read
    // of the cell above: poll() runs outside any reactive scope and must
    // decide whether to write WITHOUT taking a dependency on what it writes.
    _maximizedSeen: bool = false;

    // Whether a host wired a real window up at all. False in a headless or
    // embedded context, where every call below does nothing -- worth asking
    // before drawing window controls that could not work.
    fn available(): bool {
        return this._cb is not none;
    }

    // Close this window, exactly as if its titlebar's X had been clicked.
    //
    // Not a shortcut to a shutdown flag: the request goes out as the
    // platform's own close event and comes back through the ordinary event
    // loop, so whatever an application already does when the user closes its
    // window -- prompting for unsaved work, flushing caches, tearing the
    // window down -- happens here too, because it is literally the same path.
    fn close() {
        let cb = this._cb;
        if cb { cb.requestClose(); }
    }

    fn minimize() {
        let cb = this._cb;
        if cb { cb.minimize(); }
    }

    fn maximize() {
        let cb = this._cb;
        if cb { cb.maximize(); }
    }

    fn restore() {
        let cb = this._cb;
        if cb { cb.restore(); }
    }

    // What a maximize BUTTON actually does -- and what the OS itself does on
    // a double click in the titlebar, which is why a custom titlebar needs no
    // handler for that: the window manager already has one.
    fn toggleMaximize() {
        if this.isMaximized() { this.restore(); }
        else { this.maximize(); }
    }

    // Reactive: reading this from a template or a computed re-renders it when
    // the window is maximized or restored, however that happened.
    fn isMaximized(): bool {
        return this._maximized;
    }

    // Does the OS draw this window's titlebar? False means the application
    // does, which is exactly the condition a shell should render its own
    // titlebar on -- rather than hard-coding that decision a second time
    // somewhere it can drift from the window it describes.
    //
    // Fixed for the window's lifetime (decorations are chosen at creation),
    // so it is a plain read with nothing reactive about it.
    fn hasNativeTitlebar(): bool {
        let cb = this._cb;
        if cb { return cb.hasNativeTitlebar(); }
        // Nothing wired up: claim the platform has it covered, so a shell
        // does not draw a titlebar for a window it knows nothing about.
        return true;
    }

    // Re-reads the platform state reported above, once a frame.
    //
    // Called from the very top of UIContext.process(), BEFORE its "is there
    // anything to do this frame?" gate, because the answer can change with no
    // input of ours involved at all: the user double-clicks the titlebar, hits
    // the keyboard maximize gesture, or drags the window into a screen edge,
    // and the flag flipping is the first this process hears of it. Writing the
    // reactive from here is what carries that into the UI -- and writing it
    // ONLY on a real change is what keeps a titlebar that reads it from
    // re-rendering on every single frame.
    fn poll() {
        let cb = this._cb;
        if !cb { return; }
        let maximized = cb.isMaximized();
        if maximized != this._maximizedSeen {
            this._maximizedSeen = maximized;
            this._maximized := maximized;
        }
    }
}

// How the resolved mouse cursor reaches the platform. Unlike the callbacks
// above this is an OUTPUT: the UI decides a shape each frame and hands it
// down, rather than polling the host for state.
//
// `index` is a ui_styling.Cursor cast to int -- ui_components stays free of
// any platform cursor type, and the host maps the index to whatever its
// windowing layer wants (app.setCursor does exactly this).
//
// Called every frame with the current shape, not only on change, so hosts
// must make it cheap to repeat; the SDL-backed implementation caches and
// early-outs.
export type CursorCallback = (index: int) => void;

// Hands a font's bytes to whatever backend the composition root wired up (see
// ui_runtime.Runtime), to be bound to `name` so elements can select it by that
// name. Called from provideFont() below, never directly.
export type ProvideFontCallback = (name: str, bytes: Bytes) => void;

// One name currently bound, and the exact slice it was last bound from. The
// slice is what makes the per-frame call cheap -- see provideFont().
//
// Exported only because UIContext holds a field of this type: a name used from
// inside a struct body is resolved against the module's EXPORTED declarations,
// so a module-private struct works as a free function's return type (DivLookup
// above) but not as a member's. Same reason RenderContext, ChildElementEntry
// and PendingPointerEvent are exported.
export struct ProvidedFont {
    name: str;
    bytes: Bytes;
}

// Reports whether the pointer position is known yet -- see
// UIContext.mousePosKnown.
//
// The `:: final, pure` is load-bearing, not decoration. A trivial getter
// lambda like `() => a.mousePosKnown()` is INFERRED final+pure, and that
// inferred type does not unify with a plainly-declared `() => bool` once
// the field is optional (`none | Callback`) -- the conversion is simply
// not found. Spelling the attributes here makes the declared type match
// what the call site actually produces. CursorCallback next door gets
// away without them only because it returns void.
export type MousePosKnownCallback = () => (bool) :: final, pure;

// Internal pending pointer event before it is dispatched to elements. A
// value (stored inline in UIContext's per-frame buffer), so an input event
// costs no allocation of its own.
export struct PendingPointerEvent {
    kind: PointerEventKind;
    button: PointerButton;
    buttons: PointerButtons;
    pos: Vec2;
    // The click count this edge belongs to -- see PointerEvent.detail. A
    // release carries the count of the press it completes, which is why it
    // is computed once when the press is replayed and carried through here
    // rather than recomputed per event.
    detail: int = 0;
}

export opaque ref struct UIContext {
    _mousePosCb: (() => Vec2);
    // Optional: when supplied, says whether _mousePosCb's answer is
    // meaningful yet (see mousePosKnown below). Omitted means "always
    // meaningful", which is what a headless/test context wants and what
    // every existing caller got before this existed.
    _mousePosKnownCb?: MousePosKnownCallback;
    _pointerButtons?: PointerHeldCallbacks;
    _inputExtras?: InputExtrasCallbacks;
    _keyboard?: KeyboardCallbacks;
    _setCursor?: CursorCallback;
    // Optional: a headless/test context, or a host that simply never wired
    // one, has no clipboard at all. See hasClipboard() for why that is worth
    // telling apart from an empty one.
    _clipboard?: ClipboardCallbacks;
    // The OS window this UI is running in, as component code may touch it --
    // `ui.window.close()`. A field rather than a set of methods here on
    // purpose; see WindowApi.
    window: WindowApi;
    // Reused by syncWindowRegions every frame it publishes; clear() keeps the
    // capacity, so a titlebar costs no allocation after the first frame.
    _windowRegions: []WindowRegion = [];
    // Did process() get past its gate this frame? Read (and reset) by
    // syncWindowRegions, which has nothing to re-publish on a frame where
    // nothing was rebuilt.
    _workedThisFrame: bool = false;
    // Optional so a headless/test UIContext (no layout engine wired up) can
    // still be constructed -- measureText() below asserts before using it.
    _measureText?: (fontFamily: str, fontSize: real, text: str) => Vec2;
    // Optional for the same reason _measureText is: a headless/test context
    // has no font backend at all. provideFont() asserts before using it.
    _provideFont?: ProvideFontCallback;
    // Which names are currently bound, and to what. Grows once per distinct
    // font and never per frame; see provideFont().
    _providedFonts: []ProvidedFont = [];

    _leftHeld: bool = false;
    _middleHeld: bool = false;
    _rightHeld: bool = false;

    // ── Click counting (PointerEvent.detail) ─────────────────────────
    //
    // The running length of the current rapid-click sequence, plus what it
    // takes to decide whether the NEXT press continues it: when and where
    // the previous press landed, and which button it was. A sequence is
    // continued only by the same button, within DOUBLE_CLICK_TIME_SECONDS,
    // within DOUBLE_CLICK_SLOP_PX in each axis -- anything else starts over
    // at 1. Pressing a different button resets rather than interleaving,
    // which is what Chromium does (its last_click_event_ holds exactly one
    // press, not one per button).
    //
    // This lives here rather than in the platform layer on purpose. SDL does
    // report its own SDL_MouseButtonEvent.clicks, but it is the OS's idea of
    // a double click (a per-user system setting on Windows/macOS, a guess on
    // Linux) and it is not available from every backend a future host might
    // use. Deriving it here from timestamps we already have makes every
    // host agree, and makes the thresholds inspectable and testable.
    _clickCount: int = 0;
    _lastPressTime: real = 0.0;
    _lastPressPos: Vec2 = {};
    _lastPressButton: PointerButton = PointerButton.None;

    // Runtime-data of every element marked pointerDownHere=true by the most
    // recent "down", so "up" can fully consume (reset) that flag even for
    // elements no longer under the pointer at release time -- without this,
    // an element the pointer was dragged away from and never returned to
    // would keep a stale pointerDownHere=true forever, ready to wrongly
    // participate in click eligibility on some *later*, unrelated up-event
    // that happens to hit it. See process()'s Down/Up handling.
    _pointerDownTargets: []ComponentElementRuntimeData = [];

    // Per-frame scratch buffers, allocated once and cleared each frame
    // (clear() keeps the capacity). An idle frame used to build six fresh
    // arrays plus a closure in process(); now it allocates nothing.
    _pendingEvents: []PendingPointerEvent = [];
    _eventQueue: [](() => void) = [];
    _finalHitPath: []ui_elements.Element = [];
    _eventHitPath: []ui_elements.Element = [];
    _focusPath: []ui_elements.Element = [];
    _oldFocusPath: []ui_elements.Element = [];
    // The path to the element GAINING focus, built after the flags have been
    // moved -- see applyFocusChange. A third buffer rather than reusing one of
    // the two above: releaseHiddenInputState holds _focusPath across its call
    // into applyFocusChange, and applyFocusChange itself needs the old and new
    // paths at the same time.
    _newFocusPath: []ui_elements.Element = [];
    // Every dismissable layer currently in the tree -- see
    // collectDismissLayers, refreshed once per frame.
    _dismissLayers: []ui_elements.Element = [];
    // Scratch for moveFocusByTab's tree-order walk. Only touched on an actual
    // Tab press, but kept here so that press costs no allocation either.
    _tabbableScratch: []ui_elements.Element = [];
    _clickEligible: []bool = [];
    _noEdges: []PointerEdge = [];
    // Stand-ins for a host that wired up no keyboard/wheel callbacks, so
    // process() can hold this frame's input in plain locals without an
    // allocation or an optional on every read. Never written to.
    _noKeyEdges: []KeyEdge = [];
    _noTextChunks: []str = [];

    renderStack: []RenderContext = [];
    // Watcher jobs waiting for this frame's flush -- see flushJobs. A job
    // lands here the moment a write triggers its watcher (UIContext.watch's
    // scheduler), whether that write came from a handler, a hook, or the
    // host between frames.
    _preJobs: WatchJobQueue;
    _postJobs: WatchJobQueue;
    // Every live component that registered an onFrame hook, in creation
    // order (so a parent's hook runs before its children's). Held here
    // rather than only on the instance because these have to run on EVERY
    // frame, and a component's own defineComponentImpl only runs when its
    // parent's template does -- which, in a pull-based tree, is exactly the
    // frames where something already changed. See UIContext.onFrame.
    _frameHooks: []ComponentInstance = [];
    rootComponent: ComponentInstance | null = null;
    rootTemplate: rx.Computed<none>;
    _framecount: rx.Reactive<int>;
    _deltaTime: rx.Reactive<real>;
    _timeNow: rx.Reactive<real>;
    _prevTime: real;

    mousePos: Vec2 = {};
    pmousePos: Vec2 = {};
    dmousePos: Vec2 = {};
    // Whether mousePos above is a real position yet. Sampled once per
    // frame alongside it, so everything in one frame agrees.
    mousePosKnown: bool = true;

    struct UIContextArgs {
        ui: ((ui: UIContext) => none);
        mousePos: () => Vec2;
        // See UIContext._mousePosKnownCb. Optional; omitting it means the
        // pointer position is always trusted.
        mousePosKnown?: MousePosKnownCallback;
        pointerButtons?: PointerHeldCallbacks;
        inputExtras?: InputExtrasCallbacks;
        keyboard?: KeyboardCallbacks;
        setCursor?: CursorCallback;
        clipboard?: ClipboardCallbacks;
        // The OS window, for `ui.window` -- see WindowCallbacks. Optional:
        // omitting it leaves every window operation a no-op, which is what a
        // headless or embedded context wants.
        window?: WindowCallbacks;
        measureText?: (fontFamily: str, fontSize: real, text: str) => Vec2;
        // See UIContext.provideFont. Optional; a context without one cannot
        // accept fonts, which is exactly right for a headless/test context.
        provideFont?: ProvideFontCallback;
    }

    fn constructor(args: UIContextArgs) {
        let ctx = UIContext {
            rootTemplate: rx.computed<none>(() => {}),
            _preJobs: WatchJobQueue {},
            _postJobs: WatchJobQueue {},
            _framecount: rx.reactive<int>(0),
            _deltaTime: rx.reactive<real>(0),
            _timeNow: rx.reactive<real>(0),
            _prevTime: time.now(),
            _mousePosCb: args.mousePos,
            _mousePosKnownCb: args.mousePosKnown,
            _pointerButtons: args.pointerButtons,
            _inputExtras: args.inputExtras,
            _keyboard: args.keyboard,
            _setCursor: args.setCursor,
            _clipboard: args.clipboard,
            window: WindowApi { _cb: args.window, _maximized: rx.reactive<bool>(false) },
            _measureText: args.measureText,
            _provideFont: args.provideFont,
        };

        // UI Context depends on itself
        ctx.rootTemplate = rx.computed<none>(() => {
            args.ui(ctx);
        });

        return ctx;
    }

    fn framecount(): int {
        return this._framecount;
    }

    fn deltaTime(): real {
        return this._deltaTime;
    }

    fn now(): real {
        return this._timeNow;
    }

    // Whether a mouse button is held RIGHT NOW, independent of which
    // element the cursor happens to be over.
    //
    // This is what makes browser-style pointer capture possible: once a
    // drag has started, the dragging element keeps receiving updates from
    // `mousePos` for as long as the button is down -- even when the
    // cursor has moved off the element, or outside the OS window
    // entirely. Per-element onPointerMove cannot do that, because it only
    // fires while the cursor is actually over that element.
    fn leftMouseHeld(): bool {
        return this._leftHeld;
    }

    fn middleMouseHeld(): bool {
        return this._middleHeld;
    }

    fn rightMouseHeld(): bool {
        return this._rightHeld;
    }

    // Finds whichever font family/size is currently in effect at this exact
    // point in the tree, by walking the div-ancestor chain -- renderStack,
    // innermost (top) first -- the same way ui_layout's render-time cascade
    // walks its fontFamilyStack/fontSizeStack. Each div already has its
    // fully-resolved style by the time childrenFn() runs (see div() below:
    // computeDivStyle() happens before the push), so this sees exactly the
    // same values a sibling ui.text() call at this point would inherit.
    // Falls back to "default"/16.0 if nothing in the chain sets it, matching
    // the root defaults ui_layout.Context.render() itself pushes before
    // walking the tree.
    fn currentFontFamily(): str {
        let i = this.renderStack.length - 1;
        while i >= 0 {
            let fontFamily = this.renderStack[i].currentParent.style.fontFamily;
            if fontFamily {
                return fontFamily;
            }
            i = i - 1;
        }
        return "default";
    }

    fn currentFontSize(): real {
        let i = this.renderStack.length - 1;
        while i >= 0 {
            let fontSize = this.renderStack[i].currentParent.style.fontSize;
            if fontSize {
                return fontSize;
            }
            i = i - 1;
        }
        return 16.0;
    }

    // Measures a standalone run of text (e.g. a single word or label) using
    // the same real glyph-advance measurement the layout engine applies when
    // it actually lays this text out (see ui_runtime.Runtime, which wires
    // this up) -- so a component can size itself around text before/without
    // waiting on a layout pass. fontFamily/fontSize default to whatever is
    // currently cascading at this point in the tree (see currentFontFamily/
    // currentFontSize above), i.e. exactly what a sibling ui.text() call
    // would use; pass them explicitly to measure as a different font/size.
    fn measureText(text: str, fontFamily?: str, fontSize?: real): Vec2 {
        let family = fontFamily ? fontFamily : this.currentFontFamily();
        let size = fontSize ? fontSize : this.currentFontSize();
        assert(this._measureText, "measureText was not provided to this UIContext (see UIContextArgs.measureText)");
        return this._measureText(family, size, text);
    }

    // Binds `name` to a font, so that anything selecting that family name
    // (`font-family-["codicons"]`) renders with it. This is the supply side;
    // an element only ever names a font, never carries one.
    //
    // What the hzui `@font <name> [<expr>]` directive lowers to. That call
    // lands in the component's RENDER body rather than its setup, which is
    // what makes the binding live: the expression is read where a reactive
    // read is tracked, so a component whose font is a `computed` re-runs its
    // template when that computed changes, and this rebinds the name to the
    // new bytes on exactly that frame. A font can therefore be picked
    // dynamically -- per theme, per user setting, per frame -- and nothing
    // downstream needs to know it can change.
    //
    // Costs nothing to leave in a hot path, in two layers. The template is a
    // memoised computed (see defineComponentImpl), so on a frame where
    // nothing this component reads has changed, this is not called at all.
    // When it IS called, an unchanged font stops at refersToSameMemory():
    // a handful of integer compares against the slice bound last time, with
    // no look at the bytes themselves and no call into the backend. Only an
    // actual change reaches the backend, which is where the real work (parsing
    // the font, growing the glyph atlas) lives.
    //
    // The scan is over distinct font NAMES this context has ever been given --
    // a handful, not a per-frame quantity -- and _providedFonts grows once per
    // name, never per call.
    fn provideFont(name: str, bytes: Bytes) {
        for (let i = 0; i < this._providedFonts.length; i++) {
            if this._providedFonts[i].name == name {
                if this._providedFonts[i].bytes.refersToSameMemory(bytes) {
                    return;
                }
                // Whole-element assignment: `[i].bytes = ...` would be a write
                // into a copy for a value-typed element.
                this._providedFonts[i] = ProvidedFont { name: name, bytes: bytes };
                this.bindFont(name, bytes);
                return;
            }
        }
        this._providedFonts.push(ProvidedFont { name: name, bytes: bytes });
        this.bindFont(name, bytes);
    }

    // The one call into the font backend. Split out so provideFont above reads
    // as the cache it is, and so the assert names the missing wiring once.
    fn bindFont(name: str, bytes: Bytes) {
        assert(this._provideFont, "provideFont was not provided to this UIContext (see UIContextArgs.provideFont)");
        this._provideFont(name, bytes);
        // The font a name resolves to is not reactive state the tree reads --
        // it lives in the layout engine's table -- so rebinding one invalidates
        // nothing on its own. Anything already laid out with the old font has
        // to be measured and drawn again. See ui_requestUpdate.
        ui_requestUpdate();
    }

    // Whether a host actually wired an OS clipboard up (see
    // UIContextArgs.clipboard). Worth asking BEFORE reading: "no clipboard"
    // and "an empty clipboard" both read as "", but they call for opposite
    // behavior -- a widget with its own internal register (textedit_behavior
    // has one) should keep using it rather than paste "" over the top of it.
    fn hasClipboard(): bool {
        return this._clipboard is not none;
    }

    // The OS clipboard's text: "" when it is empty, when it holds something
    // that is not text, or when no host wired one up.
    fn getClipboardText(): str {
        if this._clipboard {
            return this._clipboard.getText();
        }
        return "";
    }

    // Puts `text` on the OS clipboard. Reports whether it got there, which is
    // false when no host wired a clipboard up as well as when the platform
    // refused it -- callers that care about the difference ask hasClipboard().
    fn setClipboardText(text: str): bool {
        if this._clipboard {
            return this._clipboard.setText(text);
        }
        return false;
    }

    // Hands this frame's OS titlebar boxes to the host window.
    //
    // Called by the composition root once LAYOUT HAS RUN (see
    // ui_runtime.Runtime.render), not from inside process(). The boxes are
    // read back out of render feedback, and the pass that produces it is the
    // one that has only just finished -- collect them any earlier and what
    // gets published is the PREVIOUS frame's geometry. Hit-testing lives with
    // that lag quite happily; a window manager should not have to, and on the
    // very first frame there would be no geometry to publish at all, which an
    // otherwise idle UI would then never get around to correcting.
    //
    // Does nothing on a frame where process() stayed behind its gate: nothing
    // was rebuilt, so nothing moved, so what is already published is still
    // right.
    fn syncWindowRegions(root: ui_elements.Element): void {
        if !this._workedThisFrame {
            return;
        }
        this._workedThisFrame = false;

        let cb = this.window._cb;
        if !cb {
            return;
        }
        // A window the OS still draws the titlebar for has no regions to
        // publish, and checking here is what keeps the whole tree walk off
        // the frame of every application that never asked for one.
        if cb.hasNativeTitlebar() {
            return;
        }

        let regions = this._windowRegions;
        regions.clear();
        collectWindowRegions(root, regions, false);
        cb.setRegions(regions);
    }

    // Returns ordered path [root, ..., deepest-hit-element] using last-child-on-top z-order.
    // Returns empty array when mousePos misses element entirely.
    //
    // ONE array for the whole walk, filled by collectHitPath below. Written
    // the obvious way instead -- every level returning a list of its own and
    // each parent copying its child's into a fresh one -- this allocated an
    // array per element VISITED, the great majority of them the empty
    // "missed" list of a subtree the pointer is nowhere near. That made it
    // the single largest allocation site in an idle frame: it runs over the
    // whole element tree once per frame for the cursor, again in
    // updateHoverState's sibling walk, and once more per pointer event.
    // Fills `out` (cleared first) with the root-first hit path; the caller
    // owns the buffer so it can be reused frame after frame.
    fn buildHitPathInto(out: []ui_elements.Element, element: ui_elements.Element, mousePos: Vec2): void :: final {
        out.clear();
        this.collectHitPath(element, mousePos, out);
    }

    // Appends this element's own contribution to `out` and reports whether
    // anything at or under it was hit.
    //
    // An element only ever writes to `out` on a path that returns true, and
    // a true return propagates all the way up, so a subtree that misses
    // leaves `out` exactly as it found it -- which is what lets every level
    // share the caller's one array. The deepest hit element pushes itself
    // and each ancestor then inserts itself at the FRONT as the recursion
    // unwinds, so the result comes out root-first with no second pass.
    fn collectHitPath(element: ui_elements.Element, mousePos: Vec2,
        out: []ui_elements.Element): bool :: final {
        // `display: none` removes the element and its subtree from hit
        // testing entirely, exactly as in CSS.
        //
        // This test cannot be left to the bounding box below. An element
        // that stops being declared to the layout engine KEEPS the last box
        // it was given (nothing clears render feedback), so a hidden
        // element would otherwise still answer "yes, the pointer is inside
        // me" using coordinates from whenever it was last visible -- an
        // invisible click target sitting over whatever replaced it. The
        // note below about missing boxes not stopping the walk is what
        // makes an explicit check necessary rather than merely tidy.
        if ui_elements.isDisplayNone(element) {
            return false;
        }
        let elementPos = ui_position(element);
        let elementSize = ui_size(element);
        let hit = false;
        if elementPos && elementSize {
            hit =
                (mousePos.x >= elementPos.x) && (mousePos.x < (elementPos.x + elementSize.x)) &&
                (mousePos.y >= elementPos.y) && (mousePos.y < (elementPos.y + elementSize.y));
        }
        // Note: a missing bounding box (elementPos/elementSize is none) does NOT
        // stop the walk here -- content-less structural wrappers (e.g. a
        // component's auto-generated root div with no background/border) never
        // get a Clay render command and so never receive position feedback, but
        // their children still can and must be reachable for hit-testing.
        // Check children in reverse so the last (topmost) child wins.
        if element is ui_elements.DivElement {
            let i = element.children.length - 1;
            while i >= 0 {
                if this.collectHitPath(element.children[i], mousePos, out) {
                    if hit { out.insert(0, element); }
                    return true;
                }
                i = i - 1;
            }
        }
        if !hit {
            return false;
        }
        out.push(element);
        return true;
    }

    // CSS `cursor` resolution for the element under the pointer.
    //
    // Walks this frame's hit path from the DEEPEST element outward and takes
    // the first one that set a cursor. That single walk gives CSS's
    // inheritance for free: an element with no cursor of its own shows its
    // nearest positioned-ancestor-with-a-cursor's shape, because that
    // ancestor is what the walk reaches next. Nothing has to cascade the
    // property down the tree at layout time.
    //
    // Only DivElement and CanvasElement carry a ComputedDivStyle; a
    // TextElement's style has no cursor field, so text is transparent to
    // this walk and inherits from the div wrapping it -- which is what you
    // want, since a label inside a button should show the button's cursor.
    //
    // Returns Default when the path is empty (pointer outside the window) or
    // nothing along it set a cursor.
    fn resolveCursor(hitPath: []ui_elements.Element): ui_styling.Cursor :: final {
        let i = hitPath.length - 1;
        while i >= 0 {
            let element = hitPath[i];
            if element is ui_elements.DivElement {
                let c = element.style.cursor;
                if c { return c; }
            }
            else if element is ui_elements.CanvasElement {
                let c = element.style.cursor;
                if c { return c; }
            }
            i = i - 1;
        }
        return ui_styling.Cursor.Default;
    }

    // Returns ordered path [root, ..., focused-element], mirroring
    // buildHitPath's shape but keyed on the persistent focused flag (see
    // ComponentElementRuntimeData.focused) instead of mouse position -- a
    // full-tree walk each frame rather than tracking a stored "focus
    // target" handle, since Haze has no safe way to compare two element/
    // ref struct handles for identity (see runtimeDataOf's callers elsewhere in
    // this file, which all key persistent per-element state off the element
    // reached during a traversal, never off a remembered handle compared
    // later). Empty when nothing is focused, or when whatever *was* focused
    // didn't get rendered this frame (e.g. its branch was conditionally
    // unmounted) -- both cases naturally fall out of not finding the flag
    // during the walk, no explicit cleanup needed.
    //
    // Filled through one shared array, exactly like buildHitPath above and
    // for the same reason: this is a FULL-TREE walk on every frame, so a
    // list per visited element meant one heap allocation per element in the
    // UI, per frame, almost all of them empty.
    // See buildHitPathInto.
    fn buildFocusPathInto(out: []ui_elements.Element, element: ui_elements.Element): void :: final {
        out.clear();
        this.collectFocusPath(element, out);
    }

    // See collectHitPath: writes to `out` only on the branch that finds the
    // focused element, and inserts each ancestor at the front on the way
    // back up so the path reads root-first.
    fn collectFocusPath(element: ui_elements.Element, out: []ui_elements.Element): bool :: final {
        if element is ui_elements.DivElement {
            let i = 0;
            while i < element.children.length {
                if this.collectFocusPath(element.children[i], out) {
                    out.insert(0, element);
                    return true;
                }
                i = i + 1;
            }
        }
        let data = runtimeDataOf(element);
        if data.focused {
            out.push(element);
            return true;
        }
        return false;
    }

    // Is any element on `path` inside a `display: none` subtree?
    //
    // A focus path is ordered root -> focused element, so a hidden ancestor
    // anywhere along it hides the target too -- which is why this tests the
    // whole path rather than just its last element.
    fn pathIsHidden(path: []ui_elements.Element): bool :: final {
        for element in path {
            if ui_elements.isDisplayNone(element) {
                return true;
            }
        }
        return false;
    }

    // Releases input state held by elements that have since been hidden.
    //
    // Everything else in this module derives state by FINDING an element
    // during a walk, which means simply not visiting it any more freezes its
    // last known state instead of clearing it. For focus that is a real bug
    // rather than an inefficiency: the focused flag would stay set on a
    // hidden element, ui_focused() would keep reporting true, onBlur would
    // never fire, and the element would still be sitting there claiming
    // focus when it came back. Browsers blur an element when it (or an
    // ancestor) becomes display:none, so this does the same.
    //
    // Runs before input is dispatched, so a keystroke in the same frame that
    // hid the focused element already goes nowhere. Hover is handled by
    // updateHoverState's own `hidden` parameter instead -- see its comment.
    fn releaseHiddenInputState(tree: ui_elements.Element, eventQueue: [](() => void)): void :: final {
        let focusPath = this._focusPath;
        this.buildFocusPathInto(focusPath, tree);
        if focusPath.length > 0 && this.pathIsHidden(focusPath) {
            // Blur by the same route a click uses (`none` target = "focus
            // nothing"), so blur/focusout fire and the focusVersion bump wakes
            // anything watching -- no separate teardown path to drift.
            this.applyFocusChange(tree, none, eventQueue, false);
        }
    }

    // Focuses `newTarget` (a click landed on it, or a descendant, and it's
    // the nearest focusable ancestor -- see process()'s Down handling), or
    // just blurs whatever's currently focused if `newTarget` is null (the
    // click landed outside every focusable element). No-op if `newTarget`
    // is already the focused element. Schedules all four HTML focus events onto
    // `eventQueue` same as every other callback in this module -- see FIRE
    // PHASE in process().
    // Every element Tab can reach, in tree order -- which is the order Tab
    // moves through them, exactly as the DOM walks document order.
    //
    // `focusable` is the whole membership test, so it is this system's
    // tabindex="0" and there is currently no way to express tabindex="-1"
    // (focusable by click or focus(), but skipped by Tab). Hidden subtrees are
    // skipped whole: an element nobody can see must not silently swallow a
    // Tab press.
    fn collectTabbable(element: ui_elements.Element, out: []ui_elements.Element, hidden: bool = false): void :: final {
        if hidden || ui_elements.isDisplayNone(element) {
            return;
        }
        if runtimeDataOf(element).focusable {
            out.push(element);
        }
        if element is ui_elements.DivElement {
            let i = 0;
            while i < element.children.length {
                this.collectTabbable(element.children[i], out, false);
                i = i + 1;
            }
        }
    }

    // Tab / Shift+Tab: the DEFAULT ACTION of the key event, run only if no
    // handler called preventDefault() -- see KeyboardEvent.preventDefault.
    //
    // Requests the move rather than applying it, so this is safe to call from
    // inside the FIRE phase (applyFocusChange queues callbacks, and the queue
    // is being iterated at that point). It lands at the start of the next
    // frame through applyPendingFocus, the same one-frame path every
    // programmatic focus() already takes -- and because that path is not
    // pointer-driven, the element arrives :focus-visible and shows its ring.
    //
    // Wraps at both ends. A browser would step out into its own chrome here;
    // an application window has nowhere else to go, so cycling is the only
    // behaviour that does not strand the keyboard user at the last element.
    fn moveFocusByTab(tree: ui_elements.Element, backwards: bool): void :: final {
        let tabbable = this._tabbableScratch;
        tabbable.clear();
        this.collectTabbable(tree, tabbable);
        if tabbable.length == 0 {
            return;
        }

        // Where focus is now. -1 means nothing is focused, in which case Tab
        // enters at the first element and Shift+Tab at the last -- matching a
        // browser entering a document from either end.
        let current = -1;
        let i = 0;
        while i < tabbable.length {
            if runtimeDataOf(tabbable[i]).focused {
                current = i;
                break;
            }
            i = i + 1;
        }

        let next = 0;
        if backwards {
            next = current <= 0 ? tabbable.length - 1 : current - 1;
        } else {
            next = current >= tabbable.length - 1 ? 0 : current + 1;
        }
        ui_focus(tabbable[next]);
    }

    // One walk per frame, gathering every element that asked to hear about
    // interactions outside itself -- see DivProps.onPointerDownOutside.
    //
    // A walk rather than a registry, because an element's presence in the tree
    // IS its registration: there is nothing to subscribe or unsubscribe, a
    // popup that stops being declared stops being a layer immediately, and
    // nothing can leak. Not folded into updateHoverState's walk, even though
    // that one already visits every element: it is skipped entirely until the
    // pointer's position is known (see process()), and a focus-driven
    // dismissal has to work before the mouse has ever moved.
    //
    // Hidden subtrees are skipped whole. A display:none popup is not on
    // screen, so nothing can be "outside" it in any sense a user would
    // recognise -- and no descendant of a hidden element can be a layer
    // either, which is why this returns rather than recursing.
    fn collectDismissLayers(element: ui_elements.Element, out: []ui_elements.Element, hidden: bool = false): void :: final {
        if hidden || ui_elements.isDisplayNone(element) {
            return;
        }
        let data = runtimeDataOf(element);
        if data.onPointerDownOutside is not none || data.onFocusOutside is not none {
            out.push(element);
        }
        if element is ui_elements.DivElement {
            let i = 0;
            while i < element.children.length {
                this.collectDismissLayers(element.children[i], out, false);
                i = i + 1;
            }
        }
    }

    // Reports a press that landed outside a layer to that layer. Queued AFTER
    // the press's own capture and bubble phases -- see
    // DivProps.onPointerDownOutside for why the order is load-bearing.
    //
    // An empty hit path (the press landed on nothing at all) leaves every
    // layer uncontained, which dismisses all of them. That is the right answer
    // and it needs no special case: ui_contains reports `none` as never
    // contained.
    fn dispatchPointerDownOutside(hitPath: []ui_elements.Element, event: PointerEvent, eventQueue: [](() => void)): void :: final {
        let target = none as ui_elements.Element | none;
        if hitPath.length > 0 {
            target = hitPath[hitPath.length - 1];
        }
        let layers = this._dismissLayers;
        let i = 0;
        while i < layers.length {
            let layer = layers[i];
            if !ui_contains(layer, target) {
                let cb = runtimeDataOf(layer).onPointerDownOutside;
                if cb {
                    // Narrowed copy for the closure: an enclosing narrowing does not
                    // reach into a closure that runs later (the FIRE phase).
                    let fire = cb;
                    eventQueue.push((): void => {
                        if event._stopped { return; }
                        fire(event);
                    });
                }
            }
            i = i + 1;
        }
    }

    // Focus counterpart of the above -- see DivProps.onFocusOutside. Each
    // layer gets its OWN event, so one layer stopping propagation cannot
    // silence another.
    fn dispatchFocusOutside(newTarget: ui_elements.Element, eventQueue: [](() => void)): void :: final {
        let layers = this._dismissLayers;
        let i = 0;
        while i < layers.length {
            let layer = layers[i];
            if !ui_contains(layer, newTarget) {
                let cb = runtimeDataOf(layer).onFocusOutside;
                if cb {
                    let event = FocusEvent { relatedTarget: newTarget };
                    // Narrowed copy for the closure: an enclosing narrowing does not
                    // reach into a closure that runs later (the FIRE phase).
                    let fire = cb;
                    eventQueue.push((): void => {
                        if event._stopped { return; }
                        fire(event);
                    });
                }
            }
            i = i + 1;
        }
    }

    // `pointerDriven`: did this focus change come from a press? It decides two
    // things that turn on the same distinction.
    //
    //   - Whether the new element counts as :focus-visible, i.e. whether it
    //     should show a focus ring. Clicking a button must not ring it;
    //     tabbing to it must.
    //   - Whether dismissable layers are told about it (onFocusOutside). A
    //     press is already reported by onPointerDownOutside, and reporting it
    //     twice would queue the dismissal ahead of the trigger's own handler.
    fn applyFocusChange(tree: ui_elements.Element, newTarget: ui_elements.Element | none, eventQueue: [](() => void), pointerDriven: bool): void :: final {
        if newTarget is not none {
            if runtimeDataOf(newTarget).focused {
                return;
            }
        }

        // Both paths are needed at once, and both must be read BEFORE the
        // callbacks run -- they are scratch buffers, so nothing queued below
        // may capture them. The dispatch helpers walk them here and queue
        // closures over the callbacks themselves, never over the path.
        let oldPath = this._oldFocusPath;
        this.buildFocusPathInto(oldPath, tree);
        let oldTarget = none as ui_elements.Element | none;
        if oldPath.length > 0 {
            oldTarget = oldPath[oldPath.length - 1];
        }

        // Move the flags first, so collectFocusPath below finds the NEW
        // element and only it. Both bumps happen before any callback runs,
        // which is what lets a handler read ui_focused() and see the state
        // after the transfer, exactly as the DOM does.
        if oldTarget is not none {
            let oldData = runtimeDataOf(oldTarget);
            oldData.focused = false;
            oldData.focusVisible = false;
            oldData.focusVersion := !oldData.focusVersion;
        }
        let newPath = this._newFocusPath;
        newPath.clear();
        if newTarget is not none {
            let newData = runtimeDataOf(newTarget);
            newData.focused = true;
            newData.focusVisible = !pointerDriven;
            newData.focusVersion := !newData.focusVersion;
            this.buildFocusPathInto(newPath, tree);
        }

        // HTML's focus update steps, in order:
        //     blur (old) -> focusout (old) -> focus (new) -> focusin (new)
        // Four distinct event objects, so stopPropagation() on one leaves the
        // rest alone. Queue order IS fire order -- see FIRE PHASE in process().
        if oldTarget is not none {
            // relatedTarget of a blur/focusout is the element GAINING focus.
            let blurEvent = FocusEvent { relatedTarget: newTarget };
            this.dispatchFocusCapturing(oldPath, blurEvent, FocusEventKind.Blur, eventQueue);
            this.dispatchFocusBubbling(oldPath, blurEvent, FocusEventKind.Blur, false, eventQueue);

            let focusOutEvent = FocusEvent { relatedTarget: newTarget };
            this.dispatchFocusCapturing(oldPath, focusOutEvent, FocusEventKind.FocusOut, eventQueue);
            this.dispatchFocusBubbling(oldPath, focusOutEvent, FocusEventKind.FocusOut, true, eventQueue);
        }

        if newTarget is not none {
            // ...and of a focus/focusin, the element that LOST it.
            let focusEvent = FocusEvent { relatedTarget: oldTarget };
            this.dispatchFocusCapturing(newPath, focusEvent, FocusEventKind.Focus, eventQueue);
            this.dispatchFocusBubbling(newPath, focusEvent, FocusEventKind.Focus, false, eventQueue);

            let focusInEvent = FocusEvent { relatedTarget: oldTarget };
            this.dispatchFocusCapturing(newPath, focusInEvent, FocusEventKind.FocusIn, eventQueue);
            this.dispatchFocusBubbling(newPath, focusInEvent, FocusEventKind.FocusIn, true, eventQueue);

            // Last, so a layer's dismissal is queued behind every handler that
            // legitimately reacted to the focus arriving somewhere.
            if !pointerDriven {
                this.dispatchFocusOutside(newTarget, eventQueue);
            }
        }
    }

    // Capture phase, root -> target inclusive. Runs for all four focus events:
    // in the DOM a non-bubbling event still has a full capture phase (that is
    // exactly what addEventListener(..., true) buys you for `focus`), and a
    // capture listener on the target itself fires too.
    fn dispatchFocusCapturing(path: []ui_elements.Element, event: FocusEvent, kind: FocusEventKind, eventQueue: [](() => void)): void :: final {
        let i = 0;
        while i < path.length {
            let data = runtimeDataOf(path[i]);
            let cb = none as ((e: FocusEvent) => none) | none;
            if kind == FocusEventKind.Blur { cb = data.onBlurCapture; }
            else if kind == FocusEventKind.FocusOut { cb = data.onFocusOutCapture; }
            else if kind == FocusEventKind.Focus { cb = data.onFocusCapture; }
            else { cb = data.onFocusInCapture; }
            if cb {
                // Narrowed copy for the closure: an enclosing narrowing does not
                // reach into a closure that runs later (the FIRE phase).
                let fire = cb;
                eventQueue.push((): void => {
                    if event._stopped { return; }
                    fire(event);
                });
            }
            i = i + 1;
        }
    }

    // Target -> root. `bubbles` is what separates the two pairs: focusin and
    // focusout walk the whole way up, focus and blur stop at the target and
    // reach no ancestor at all. That single flag is the entire difference
    // between the pairs in HTML.
    fn dispatchFocusBubbling(path: []ui_elements.Element, event: FocusEvent, kind: FocusEventKind, bubbles: bool, eventQueue: [](() => void)): void :: final {
        let i = path.length - 1;
        while i >= 0 {
            let data = runtimeDataOf(path[i]);
            let cb = none as ((e: FocusEvent) => none) | none;
            if kind == FocusEventKind.Blur { cb = data.onBlur; }
            else if kind == FocusEventKind.FocusOut { cb = data.onFocusOut; }
            else if kind == FocusEventKind.Focus { cb = data.onFocus; }
            else { cb = data.onFocusIn; }
            if cb {
                // Narrowed copy for the closure: an enclosing narrowing does not
                // reach into a closure that runs later (the FIRE phase).
                let fire = cb;
                eventQueue.push((): void => {
                    if event._stopped { return; }
                    fire(event);
                });
            }
            if !bubbles {
                return;
            }
            i = i - 1;
        }
    }

    // Finds an element with a pending programmatic focus request (see
    // ui_focus/ui_blur), clearing the flag on every element it walks past so
    // a request is consumed exactly once whether or not it ends up applying.
    // Returns the first request found in tree order, or None.
    //
    // Requests are cleared even while one has already been found, so that two
    // elements each calling focus() in the same frame don't leave the loser's
    // flag set to spuriously re-fire on the next frame -- last writer in tree
    // order would win a frame late, which is worse than simply dropping it.
    fn takeFocusRequest(element: ui_elements.Element, found: mut stackref FocusRequestTarget): void :: final {
        let data = runtimeDataOf(element);
        if data.focusRequested != FocusRequest.None {
            if found.kind == FocusRequest.None {
                found.kind = data.focusRequested;
                found.element = element;
            }
            data.focusRequested = FocusRequest.None;
        }
        if element is ui_elements.DivElement {
            let i = 0;
            while i < element.children.length {
                this.takeFocusRequest(element.children[i], found);
                i = i + 1;
            }
        }
    }

    // Applies whatever ui_focus()/ui_blur() asked for since the last frame,
    // routing it through the very same applyFocusChange() a click uses -- so
    // programmatic and click-driven focus cannot drift apart in behavior
    // (blur-the-old-one, fire onBlur then onFocus, both onto `eventQueue`).
    fn applyPendingFocus(tree: ui_elements.Element, eventQueue: [](() => void)): void :: final {
        let stackref found = FocusRequestTarget {};
        this.takeFocusRequest(tree, found);

        if found.kind == FocusRequest.Focus {
            // Programmatic focus -- tabbing, or any focus() call. This is the
            // one route that means "the user deliberately went elsewhere", so
            // it is the one that tells layers about it.
            this.applyFocusChange(tree, found.element, eventQueue, false);
        }
        else if found.kind == FocusRequest.Blur {
            // Only a blur of the *currently* focused element means anything;
            // blurring something that isn't focused must not clear whatever
            // else happens to be focused right now.
            let el = found.element;
            if el is not none {
                if runtimeDataOf(el).focused {
                    this.applyFocusChange(tree, none, eventQueue, false);
                }
            }
        }
    }

    // Traverses the full tree, updates hover/hit reactive state, and
    // schedules onHoverEnter/Leave + onHitEnter/Leave callbacks onto
    // `eventQueue`. Neither is bubbling: every element that geometrically
    // contains mousePos gets its own independent hover-transition (ancestors
    // included -- this matches HTML/CSS :hover exactly), and separately,
    // whichever of those is not itself contained by a hit child also gets
    // its own hit-transition. Callbacks are only scheduled here, not
    // invoked -- see process()'s FIRE PHASE.
    //
    // Returns whether mousePos is over this element's own bounds *or* any
    // descendant's (recursively) -- used by the caller (a parent frame of
    // this same recursion) to know whether it's disqualified from "hit".
    // `hidden` -- this element is inside a `display: none` subtree (either
    // it is hidden itself or an ancestor is). Such an element is NOT simply
    // skipped: the walk still descends into it, but with every hit forced
    // to false. That distinction matters, because "stop visiting it" and
    // "it is not hovered" are different things here -- hover/hit state is
    // persistent per element, so an element that was hovered at the moment
    // it got hidden would keep `hover: true` forever if the walk just
    // stopped coming, and its onHoverLeave/onHitLeave would never fire.
    // Descending with false lets the ordinary transition code below notice
    // the change and fire those leave callbacks exactly once, which is what
    // a browser does when you hide an element out from under the cursor.
    //
    // `pointerPresent` -- whether the pointer is over this window at all (see
    // UIContext.mousePosKnown). False forces every hit to false for exactly
    // the same reason `hidden` does, and it is a separate input rather than a
    // position the caller could pick because there IS no position that means
    // "nowhere": mousePos still holds the last real coordinates, which are
    // usually sitting right on top of whatever the pointer left through.
    //
    // Note this walk must still RUN when the pointer is absent. Skipping it
    // does not un-hover anything -- hover/hit are persistent per element -- it
    // freezes the last frame's answer, so the element under the pointer's exit
    // point stays lit and its onHoverLeave never fires. Same trap as `hidden`,
    // same fix.
    fn updateHoverState(element: ui_elements.Element, mousePos: Vec2, buttons: PointerButtons, eventQueue: [](() => void), pointerPresent: bool = true, hidden: bool = false): bool :: final {
        let subtreeHidden = hidden || ui_elements.isDisplayNone(element);
        let elementPos = ui_position(element);
        let elementSize = ui_size(element);
        let selfHit = false;
        // A hidden element keeps the bounding box it had when it was last
        // visible, so the geometry test would still pass -- it has to be
        // suppressed explicitly rather than relying on the box being gone.
        if pointerPresent && !subtreeHidden && elementPos && elementSize {
            selfHit =
                (mousePos.x >= elementPos.x) && (mousePos.x < (elementPos.x + elementSize.x)) &&
                (mousePos.y >= elementPos.y) && (mousePos.y < (elementPos.y + elementSize.y));
        }

        // Recurse first: hit for *this* element depends on whether any
        // child claims the same point, which we can only know after they've
        // all been visited.
        let childHover = false;
        if element is ui_elements.DivElement {
            for child in element.children {
                if this.updateHoverState(child, mousePos, buttons, eventQueue, pointerPresent, subtreeHidden) {
                    childHover = true;
                }
            }
        }

        let hover = selfHit || childHover;
        let hit = selfHit && !childHover;

        let data = runtimeDataOf(element);
        if !data.inputFeedback {
            data.inputFeedback = { hover: false, hit: false, pointerDownHere: false };
            data.inputFeedbackVersion := !data.inputFeedbackVersion;
        }
        assert(data.inputFeedback);

        let prevHover = data.inputFeedback.hover;
        let prevHit = data.inputFeedback.hit;

        if prevHover != hover {
            data.inputFeedback.hover = hover;
            data.inputFeedbackVersion := !data.inputFeedbackVersion;

            let cb = hover ? data.onHoverEnter : data.onHoverLeave;
            if cb {
                // Narrowed copy for the closure: an enclosing narrowing does not
                // reach into a closure that runs later (the FIRE phase).
                let fire = cb;
                let pos = mousePos;
                let b = buttons;
                eventQueue.push((): void => {
                    let e = PointerEvent { pointerId: 1, pointerType: "mouse", pos: pos, button: PointerButton.None, buttons: b, pressure: 0.0, isPrimary: true, modifiers: this.currentModifiers() };
                    fire(e);
                });
            }
            // Deliberately NOT resetting pointerDownHere here on hover-loss.
            // A click's eligibility is decided purely by "was this element in
            // both the down-hitPath and the up-hitPath" (see process()'s Up
            // handling) -- matching the DOM rule that click fires on the
            // nearest common ancestor of the down- and up-targets, regardless
            // of anything that happened in between. Resetting on every
            // hover-loss used to break exactly the case where the pointer
            // drags off an element and back onto the *same* element before
            // release: hover would flip false then true again, but this flag
            // never got set back to true (only a fresh "down" does that), so
            // the click would wrongly fall through to an ancestor instead of
            // firing on the element the user actually released on.
        }

        if prevHit != hit {
            data.inputFeedback.hit = hit;
            data.inputFeedbackVersion := !data.inputFeedbackVersion;

            let cb = hit ? data.onHitEnter : data.onHitLeave;
            if cb {
                // Narrowed copy for the closure: an enclosing narrowing does not
                // reach into a closure that runs later (the FIRE phase).
                let fire = cb;
                let pos = mousePos;
                let b = buttons;
                eventQueue.push((): void => {
                    let e = PointerEvent { pointerId: 1, pointerType: "mouse", pos: pos, button: PointerButton.None, buttons: b, pressure: 0.0, isPrimary: true, modifiers: this.currentModifiers() };
                    fire(e);
                });
            }
        }

        return hover;
    }

    // Currently-held modifier keys, polled once per frame via
    // UIContextArgs.inputExtras (none if the caller didn't supply one, e.g.
    // a headless/test UIContext) -- stamped onto every PointerEvent/
    // WheelEvent this module constructs.
    fn currentModifiers(): KeyModifiers {
        if this._inputExtras {
            return this._inputExtras.modifiers();
        }
        return KeyModifiers.None;
    }

    // Schedules a pointer event along hitPath from root down to target onto
    // `eventQueue` -- the capture phase. Always scheduled before the
    // corresponding bubble-phase pass for the same event (see process()), so
    // it always runs first regardless of what a bubble handler later does.
    fn dispatchCapturing(hitPath: []ui_elements.Element, event: PointerEvent, kind: PointerEventKind, eventQueue: [](() => void)): void :: final {
        let i = 0;
        while i < hitPath.length {
            let data = runtimeDataOf(hitPath[i]);
            let cb = none as ((e: PointerEvent) => none) | none;
            if kind == PointerEventKind.Down { cb = data.onPointerDownCapture; }
            else if kind == PointerEventKind.Up { cb = data.onPointerUpCapture; }
            else if kind == PointerEventKind.Move { cb = data.onPointerMoveCapture; }
            if cb {
                // Narrowed copy for the closure: an enclosing narrowing does not
                // reach into a closure that runs later (the FIRE phase).
                let fire = cb;
                eventQueue.push((): void => {
                    if event._stopped { return; }
                    fire(event);
                });
            }
            i = i + 1;
        }
    }

    // Wheel's capture/bubble pair, mirroring dispatchCapturing/
    // dispatchBubbling exactly -- wheel isn't a PointerEventKind (no
    // button/pressure), so it has no `kind` to switch on and just reads
    // onWheelCapture/onWheel unconditionally.
    fn dispatchWheelCapturing(hitPath: []ui_elements.Element, event: WheelEvent, eventQueue: [](() => void)): void :: final {
        let i = 0;
        while i < hitPath.length {
            let data = runtimeDataOf(hitPath[i]);
            let cb = data.onWheelCapture;
            if cb {
                // Narrowed copy for the closure: an enclosing narrowing does not
                // reach into a closure that runs later (the FIRE phase).
                let fire = cb;
                eventQueue.push((): void => {
                    if event._stopped { return; }
                    fire(event);
                });
            }
            i = i + 1;
        }
    }

    fn dispatchWheelBubbling(hitPath: []ui_elements.Element, event: WheelEvent, eventQueue: [](() => void)): void :: final {
        let i = hitPath.length - 1;
        while i >= 0 {
            let data = runtimeDataOf(hitPath[i]);
            let cb = data.onWheel;
            if cb {
                // Narrowed copy for the closure: an enclosing narrowing does not
                // reach into a closure that runs later (the FIRE phase).
                let fire = cb;
                eventQueue.push((): void => {
                    if event._stopped { return; }
                    fire(event);
                });
            }
            i = i - 1;
        }
    }

    // Key/text input's capture/bubble pairs, mirroring the wheel pair above
    // exactly -- `focusPath` (root -> focused element, see buildFocusPath)
    // plays the same role `hitPath` plays for pointer events, just found by
    // focus instead of hit-testing.
    fn dispatchKeyCapturing(focusPath: []ui_elements.Element, event: KeyboardEvent, kind: KeyEdgeKind, eventQueue: [](() => void)): void :: final {
        let i = 0;
        while i < focusPath.length {
            let data = runtimeDataOf(focusPath[i]);
            let cb = none as ((e: KeyboardEvent) => none) | none;
            if kind == KeyEdgeKind.Pressed { cb = data.onKeyDownCapture; }
            else { cb = data.onKeyUpCapture; }
            if cb {
                // Narrowed copy for the closure: an enclosing narrowing does not
                // reach into a closure that runs later (the FIRE phase).
                let fire = cb;
                eventQueue.push((): void => {
                    if event._stopped { return; }
                    fire(event);
                });
            }
            i = i + 1;
        }
    }

    fn dispatchKeyBubbling(focusPath: []ui_elements.Element, event: KeyboardEvent, kind: KeyEdgeKind, eventQueue: [](() => void)): void :: final {
        let i = focusPath.length - 1;
        while i >= 0 {
            let data = runtimeDataOf(focusPath[i]);
            let cb = none as ((e: KeyboardEvent) => none) | none;
            if kind == KeyEdgeKind.Pressed { cb = data.onKeyDown; }
            else { cb = data.onKeyUp; }
            if cb {
                // Narrowed copy for the closure: an enclosing narrowing does not
                // reach into a closure that runs later (the FIRE phase).
                let fire = cb;
                eventQueue.push((): void => {
                    if event._stopped { return; }
                    fire(event);
                });
            }
            i = i - 1;
        }
    }

    fn dispatchTextInputCapturing(focusPath: []ui_elements.Element, event: TextInputEvent, eventQueue: [](() => void)): void :: final {
        let i = 0;
        while i < focusPath.length {
            let data = runtimeDataOf(focusPath[i]);
            let cb = data.onTextInputCapture;
            if cb {
                // Narrowed copy for the closure: an enclosing narrowing does not
                // reach into a closure that runs later (the FIRE phase).
                let fire = cb;
                eventQueue.push((): void => {
                    if event._stopped { return; }
                    fire(event);
                });
            }
            i = i + 1;
        }
    }

    fn dispatchTextInputBubbling(focusPath: []ui_elements.Element, event: TextInputEvent, eventQueue: [](() => void)): void :: final {
        let i = focusPath.length - 1;
        while i >= 0 {
            let data = runtimeDataOf(focusPath[i]);
            let cb = data.onTextInput;
            if cb {
                // Narrowed copy for the closure: an enclosing narrowing does not
                // reach into a closure that runs later (the FIRE phase).
                let fire = cb;
                eventQueue.push((): void => {
                    if event._stopped { return; }
                    fire(event);
                });
            }
            i = i - 1;
        }
    }

    // Schedules a pointer event along hitPath from target (deepest) up to
    // root onto `eventQueue` -- the bubble phase. Not invoked here -- see
    // process()'s FIRE PHASE. stopPropagation(), called from a handler
    // during that later fire phase, still stops the rest of this same
    // chain: every scheduled closure below re-checks event._stopped right
    // before running, and skips if it's set.
    fn dispatchBubbling(hitPath: []ui_elements.Element, event: PointerEvent, kind: PointerEventKind, eventQueue: [](() => void)): void :: final {
        let i = hitPath.length - 1;
        while i >= 0 {
            let data = runtimeDataOf(hitPath[i]);
            let cb = none as ((e: PointerEvent) => none) | none;
            if kind == PointerEventKind.Down { cb = data.onPointerDown; }
            else if kind == PointerEventKind.Up { cb = data.onPointerUp; }
            else if kind == PointerEventKind.Move { cb = data.onPointerMove; }
            if cb {
                // Narrowed copy for the closure: an enclosing narrowing does not
                // reach into a closure that runs later (the FIRE phase).
                let fire = cb;
                eventQueue.push((): void => {
                    if event._stopped { return; }
                    fire(event);
                });
            }
            i = i - 1;
        }
    }

    // Schedules the capture phase of one of the three SYNTHESIZED
    // press+release events (click / dblclick / auxclick) along hitPath from
    // root down to target, for elements whose pointerdown also landed within
    // this same hit path (see clickEligible, computed once by the caller in
    // process() -- eligibility is shared between this and
    // dispatchClickBubbling so the underlying pointerDownHere state only
    // gets consumed once per up-event, not once per phase).
    //
    // All three share one implementation because they differ in exactly one
    // thing: which handler they read. Which of them a given release produces
    // is decided in process(), from the button and the click count.
    fn dispatchClickCapturing(hitPath: []ui_elements.Element, clickEligible: []bool, event: PointerEvent, kind: ClickEventKind, eventQueue: [](() => void)): void :: final {
        let i = 0;
        while i < hitPath.length {
            if clickEligible[i] {
                let data = runtimeDataOf(hitPath[i]);
                let cb = none as ((e: PointerEvent) => none) | none;
                if kind == ClickEventKind.Click { cb = data.onClickCapture; }
                else if kind == ClickEventKind.DoubleClick { cb = data.onDoubleClickCapture; }
                else { cb = data.onAuxClickCapture; }
                if cb {
                    // Narrowed copy for the closure: an enclosing narrowing does not
                    // reach into a closure that runs later (the FIRE phase).
                    let fire = cb;
                    eventQueue.push((): void => {
                        if event._stopped { return; }
                        fire(event);
                    });
                }
            }
            i = i + 1;
        }
    }

    // Bubbles one of the synthesized press+release events along hitPath for
    // elements marked eligible in clickEligible (see dispatchClickCapturing
    // above for where that comes from and why one function covers all three).
    fn dispatchClickBubbling(hitPath: []ui_elements.Element, clickEligible: []bool, event: PointerEvent, kind: ClickEventKind, eventQueue: [](() => void)): void :: final {
        let i = hitPath.length - 1;
        while i >= 0 {
            if clickEligible[i] {
                let data = runtimeDataOf(hitPath[i]);
                let cb = none as ((e: PointerEvent) => none) | none;
                if kind == ClickEventKind.Click { cb = data.onClick; }
                else if kind == ClickEventKind.DoubleClick { cb = data.onDoubleClick; }
                else { cb = data.onAuxClick; }
                if cb {
                    // Narrowed copy for the closure: an enclosing narrowing does not
                    // reach into a closure that runs later (the FIRE phase).
                    let fire = cb;
                    eventQueue.push((): void => {
                        if event._stopped { return; }
                        fire(event);
                    });
                }
            }
            i = i - 1;
        }
    }

    // contextmenu's capture/bubble pair. Not eligibility-gated like the three
    // above, because it is not a press+release pair at all: it fires from the
    // right button going down (see DivProps.onContextMenu), so the only path
    // it could possibly use is that press's own.
    fn dispatchContextMenuCapturing(hitPath: []ui_elements.Element, event: PointerEvent, eventQueue: [](() => void)): void :: final {
        let i = 0;
        while i < hitPath.length {
            let data = runtimeDataOf(hitPath[i]);
            let cb = data.onContextMenuCapture;
            if cb {
                // Narrowed copy for the closure: an enclosing narrowing does not
                // reach into a closure that runs later (the FIRE phase).
                let fire = cb;
                eventQueue.push((): void => {
                    if event._stopped { return; }
                    fire(event);
                });
            }
            i = i + 1;
        }
    }

    fn dispatchContextMenuBubbling(hitPath: []ui_elements.Element, event: PointerEvent, eventQueue: [](() => void)): void :: final {
        let i = hitPath.length - 1;
        while i >= 0 {
            let data = runtimeDataOf(hitPath[i]);
            let cb = data.onContextMenu;
            if cb {
                // Narrowed copy for the closure: an enclosing narrowing does not
                // reach into a closure that runs later (the FIRE phase).
                let fire = cb;
                eventQueue.push((): void => {
                    if event._stopped { return; }
                    fire(event);
                });
            }
            i = i - 1;
        }
    }

    // Folds one press into the running click sequence -- see _clickCount for
    // the thresholds and why they live here rather than in the platform
    // layer. Called once per Pressed edge, in the order they arrived.
    fn _advanceClickCount(button: PointerButton, pos: Vec2, now: real): void :: final {
        let dx = pos.x - this._lastPressPos.x;
        let dy = pos.y - this._lastPressPos.y;
        if dx < 0.0 { dx = -dx; }
        if dy < 0.0 { dy = -dy; }
        let continues = this._clickCount > 0
            && button == this._lastPressButton
            && (now - this._lastPressTime) <= DOUBLE_CLICK_TIME_SECONDS
            && dx <= DOUBLE_CLICK_SLOP_PX
            && dy <= DOUBLE_CLICK_SLOP_PX;
        if continues {
            if this._clickCount < MAX_CLICK_COUNT {
                this._clickCount = this._clickCount + 1;
            }
        } else {
            this._clickCount = 1;
        }
        this._lastPressTime = now;
        this._lastPressPos = pos;
        this._lastPressButton = button;
    }

    fn process() {
        // The platform's own window state, re-read before this frame's gate
        // rather than after it -- the window can be maximized, restored or
        // snapped without any input this process sees, and noticing that is
        // itself a reason to render a frame. See WindowApi.poll.
        this.window.poll();

        let now = time.now();
        let elapsed = now - this._prevTime;
        this._prevTime = now;

        // Written unconditionally, and that is what makes the clock
        // self-gating rather than a special case in needsUpdate(): a write
        // to a cell nobody reads marks nothing dirty and costs nothing, so
        // a UI that never asks the time idles at zero work; the moment a
        // template or a watcher DOES read one of these, the very next
        // write invalidates it and the gate below opens every frame. In
        // other words, reading ui.now()/deltaTime()/framecount() is the
        // request for continuous frames, and it needs no other machinery.
        this._framecount++;
        this._deltaTime := elapsed;
        this._timeNow := now;

        let prevMousePosKnown = this.mousePosKnown;
        this.pmousePos = this.mousePos;
        this.mousePos = this._mousePosCb();
        // Sampled with the position, so every consumer this frame agrees
        // on whether it means anything. No callback = always trusted.
        this.mousePosKnown = this._mousePosKnownCb ? this._mousePosKnownCb() : true;
        this.dmousePos = {
            x: this.mousePos.x - this.pmousePos.x,
            y: this.mousePos.y - this.pmousePos.y,
        };

        // Read pointer button level state (for the buttons bitmask/drag
        // pressure, and to seed the replay below) plus this-frame's queued
        // press/release edges (for Down/Up events). The queue is read as-is,
        // not derived by diffing the level frame-to-frame: any number of
        // down+up pairs landing within this same frame (a burst of clicks,
        // or any frame slow enough for multiple SDL events to land in one
        // poll) each still needs its own Down and Up -- see PointerEdge for
        // why a level or a latch can't do that.
        let prevLeftHeld = this._leftHeld;
        let prevMiddleHeld = this._middleHeld;
        let prevRightHeld = this._rightHeld;
        this._leftHeld = this._pointerButtons ? this._pointerButtons.leftHeld() : false;
        this._middleHeld = this._pointerButtons ? this._pointerButtons.middleHeld() : false;
        this._rightHeld = this._pointerButtons ? this._pointerButtons.rightHeld() : false;

        let edges = this._pointerButtons ? this._pointerButtons.edgesThisFrame() : this._noEdges;

        let buttons = makeButtons(this._leftHeld, this._middleHeld, this._rightHeld);

        // Replay the queue in order, tracking a running held-state per
        // button seeded from last frame's final level (i.e. the level as it
        // stood *before* any of this frame's edges applied) so each
        // PendingPointerEvent.buttons reflects exactly what was actually
        // held at that specific edge, not just this frame's net result.
        let runningLeft = prevLeftHeld;
        let runningMiddle = prevMiddleHeld;
        let runningRight = prevRightHeld;

        let pendingEvents = this._pendingEvents;
        pendingEvents.clear();
        for edge in edges {
            if edge.kind == PointerEdgeKind.Pressed {
                if edge.button == PointerButton.Left { runningLeft = true; }
                else if edge.button == PointerButton.Middle { runningMiddle = true; }
                else if edge.button == PointerButton.Right { runningRight = true; }
                // Click counting happens HERE, on the press, and the count
                // is then carried by both this Down and the Up that
                // completes it -- see PendingPointerEvent.detail. `now` is
                // this frame's timestamp, so two presses landing in the same
                // frame compare as simultaneous, which they effectively are.
                this._advanceClickCount(edge.button, edge.pos, now);
                pendingEvents.push({ kind: PointerEventKind.Down, button: edge.button, buttons: makeButtons(runningLeft, runningMiddle, runningRight), pos: edge.pos, detail: this._clickCount });
            }
            else {
                if edge.button == PointerButton.Left { runningLeft = false; }
                else if edge.button == PointerButton.Middle { runningMiddle = false; }
                else if edge.button == PointerButton.Right { runningRight = false; }
                // A release reports the count of the press it completes, as
                // in the DOM -- so the mouseup and the click of a double
                // click both say 2, not 0 and not a fresh 1.
                let releaseDetail = edge.button == this._lastPressButton ? this._clickCount : 0;
                pendingEvents.push({ kind: PointerEventKind.Up, button: edge.button, buttons: makeButtons(runningLeft, runningMiddle, runningRight), pos: edge.pos, detail: releaseDetail });
            }
        }
        if this.dmousePos.x != 0.0 || this.dmousePos.y != 0.0 {
            pendingEvents.push({ kind: PointerEventKind.Move, button: PointerButton.None, buttons: buttons, pos: this.mousePos });
        }

        // Per-frame hooks, before the gate below -- see runFrameHooks for
        // why they are the one thing a skipped frame still does. They see
        // this frame's pointer/clock (both sampled above) and whatever they
        // write is what decides the gate.
        this.runFrameHooks();

        // THE FRAME GATE
        //
        // Below this line is the expensive half of a frame: a full walk of
        // the tree for hidden-input release, dismiss layers, hover, hit
        // paths and focus, plus the template pass. None of it produces a
        // different result than last frame unless either some input arrived
        // or something invalidated the tree, so when neither happened the
        // whole thing is skipped and last frame's tree handed straight back.
        // That is what makes an idle UI cost nothing at all rather than a
        // traversal per frame.
        //
        // Input is checked here rather than inside needsUpdate() because
        // this is the only place that knows what arrived: it has just
        // sampled the pointer, and the key/wheel polls below are the same
        // ones the dispatch further down uses (they read this frame's
        // host-side buffers, so asking twice reports the same thing).
        // Everything else -- reactive invalidation, queued watcher jobs,
        // explicit requests -- lives in needsUpdate(), which is public so a
        // host can ask the same question before it even starts a frame.
        // Polled ONCE, here, and carried down to the dispatch below in these
        // locals rather than asked for again -- edgesThisFrame() above shows
        // why: a host is free to implement any of these as a drain, and the
        // gate must not be the thing that eats this frame's keystrokes.
        let keyEdges = this._noKeyEdges;
        let textChunks = this._noTextChunks;
        let keyboard = this._keyboard;
        if keyboard {
            keyEdges = keyboard.keyEdgesThisFrame();
            textChunks = keyboard.textInputThisFrame();
        }
        let wheelDelta = Vec2(0.0, 0.0);
        if this._inputExtras {
            wheelDelta = this._inputExtras.wheelDelta();
        }
        // A pointer whose position only just became trustworthy changes what
        // is hovered without moving -- see mousePosKnown.
        let pointerKnownChanged = this.mousePosKnown != prevMousePosKnown;

        let hasInput = pendingEvents.length > 0
            || keyEdges.length > 0
            || textChunks.length > 0
            || wheelDelta.x != 0.0 || wheelDelta.y != 0.0
            || pointerKnownChanged;

        if !hasInput && !this.needsUpdate() {
            if !this.rootComponent {
                return none;
            }
            return this.rootComponent.rootElement;
        }

        // Committed to doing the work, so an outstanding request is now
        // satisfied. Cleared HERE rather than at the end so that a request
        // made later in this same frame -- a click handler calling focus(),
        // say -- survives to open the gate for the next one.
        ui_takeUpdateRequest();

        // Past the gate: this frame rebuilds the tree, so this frame's layout
        // will produce fresh boxes and the OS titlebar regions are worth
        // re-publishing once it has. See syncWindowRegions.
        this._workedThisFrame = true;

        // HIT TESTING & EVENT SCHEDULING
        //
        // Every callback below is *scheduled* onto eventQueue instead of being
        // invoked right away. Handlers can mutate elements (reactive state,
        // refs, ...), and mutating mid-walk would let a handler observe or
        // corrupt a tree that's still being traversed for this very frame's
        // hit-testing/hover pass. So: finish walking and decide everything
        // first, then fire it all only once the walk is fully done.
        let eventQueue = this._eventQueue;
        eventQueue.clear();

        if this.rootComponent {
            let tree = this.rootComponent.rootElement;

            // Anything hidden since the last frame gives up the input state
            // it was holding (focus in particular) before this frame's input
            // is looked at, so a hidden element neither keeps claiming focus
            // nor receives the keystrokes that follow.
            this.releaseHiddenInputState(tree, eventQueue);

            // Which elements are dismissable layers this frame. Refreshed
            // before any dispatch, and read by both dismissal routes below.
            let dismissLayers = this._dismissLayers;
            dismissLayers.clear();
            this.collectDismissLayers(tree, dismissLayers);

            // Hover state + enter/leave events (no bubbling) reflect where
            // the pointer physically is *right now* -- always this frame's
            // current position, regardless of where any of pendingEvents
            // below happened.
            //
            // Unless we do not yet know where the pointer is. Until the
            // platform has reported it even once, mousePos is (0,0) -- not
            // as a signal, but simply because that is what an unset Vec2
            // holds -- and (0,0) is a real place: the top-left corner. So
            // hit-testing it hovers whatever is in that corner from the
            // very first frame, before the pointer has ever been over the
            // window. That is a claim we have no evidence for, and it is
            // visible: the first tab lit up on startup and stayed lit
            // until you moved the mouse.
            //
            // An UNKNOWN pointer hovers nothing. Passing an empty hit path
            // and skipping the hover walk entirely is exactly the same
            // state as a pointer sitting outside the window, which is the
            // honest description of what we know.
            let pointerLocated = this.mousePosKnown;
            let finalHitPath = this._finalHitPath;
            finalHitPath.clear();
            if pointerLocated {
                this.buildHitPathInto(finalHitPath, tree, this.mousePos);
            }
            // Deliberately OUTSIDE the check above: when the pointer is not
            // here, the walk still has to run and report that nothing is hit,
            // so whatever was hovered gives that state up and its
            // onHoverLeave/onHitLeave fire. Skipping it instead leaves the
            // last frame's hover frozen in place -- the element the pointer
            // left the window through stays lit, which is a claim about where
            // the pointer is that we know to be false.
            this.updateHoverState(tree, this.mousePos, buttons, eventQueue, pointerLocated);

            // The pointer's shape follows whatever it is currently over, so
            // it is resolved from this frame's hit path -- the same path the
            // wheel uses below, and for the same reason. Done here rather
            // than during event dispatch because the cursor must be correct
            // even on a frame with no input at all: the element under a
            // stationary pointer can change when the UI itself moves.
            let setCursor = this._setCursor;
            if setCursor {
                setCursor(ui_styling.cursorToInt(this.resolveCursor(finalHitPath)));
            }

            // Programmatic focus (ui_focus/ui_blur) is applied before any of
            // this frame's input dispatch, so an element focused from
            // onMounted -- or from any handler that ran last frame -- receives
            // this frame's keystrokes rather than dropping them. A click later
            // in this same frame still wins over it, which is correct: the
            // user's actual pointer input is the more recent intent.
            this.applyPendingFocus(tree, eventQueue);

            // Capture phase (root -> target), then bubble phase (target ->
            // root), for down/up/move; then, on up, the same two phases again
            // for the synthesized click. Each event hit-tests against its
            // *own* pe.pos (the cursor position at the moment that specific
            // press/release happened), not this frame's final mouse
            // position -- multiple edges landing in one frame can each have
            // their own position if the pointer also moved in between.
            for pe in pendingEvents {
                let hitPath = this._eventHitPath;
                this.buildHitPathInto(hitPath, tree, pe.pos);
                let pressure = 0.0;
                if pe.kind == PointerEventKind.Down { pressure = 0.5; }
                else if pe.kind == PointerEventKind.Move && pe.buttons != PointerButtons.None { pressure = 0.5; }
                let event = PointerEvent {
                    pointerId: 1,
                    pointerType: "mouse",
                    pos: pe.pos,
                    button: pe.button,
                    buttons: pe.buttons,
                    pressure: pressure,
                    isPrimary: true,
                    modifiers: this.currentModifiers(),
                    detail: pe.detail,
                };

                if pe.kind == PointerEventKind.Down {
                    // Defensive cleanup: if a previous Down's targets were
                    // never fully consumed (e.g. the matching Up never came,
                    // however that could happen), don't let their
                    // pointerDownHere leak into this new cycle's eligibility.
                    for d in this._pointerDownTargets {
                        setPointerDownHere(d, false);
                    }
                    this._pointerDownTargets.clear();

                    for el in hitPath {
                        let d = runtimeDataOf(el);
                        if !d.inputFeedback {
                            d.inputFeedback = { hover: false, hit: false, pointerDownHere: false };
                        }
                        assert(d.inputFeedback);
                        setPointerDownHere(d, true);
                        this._pointerDownTargets.push(d);
                    }

                    // Focus: click-to-focus the nearest focusable ancestor
                    // in this Down's hitPath (innermost wins), or blur
                    // whatever's focused if there isn't one -- see
                    // DivProps.focusable and applyFocusChange.
                    let newFocusTarget = none as ui_elements.Element | none;
                    for (let fi = hitPath.length - 1; fi >= 0; fi--) {
                        if runtimeDataOf(hitPath[fi]).focusable {
                            newFocusTarget = hitPath[fi];
                            break;
                        }
                    }
                    this.applyFocusChange(tree, newFocusTarget, eventQueue, true);

                    this.dispatchCapturing(hitPath, event, PointerEventKind.Down, eventQueue);
                    this.dispatchBubbling(hitPath, event, PointerEventKind.Down, eventQueue);

                    // contextmenu rides on the right button's press, after
                    // that press's own handlers -- see DivProps.onContextMenu
                    // for why press and not release. Its own event object, so
                    // stopPropagation() on the pointerdown does not silently
                    // swallow the menu (and vice versa).
                    if pe.button == PointerButton.Right {
                        let contextEvent = PointerEvent {
                            pointerId: 1, pointerType: "mouse", pos: pe.pos,
                            button: pe.button, buttons: pe.buttons,
                            pressure: pressure, isPrimary: true,
                            modifiers: this.currentModifiers(),
                            detail: pe.detail,
                        };
                        this.dispatchContextMenuCapturing(hitPath, contextEvent, eventQueue);
                        this.dispatchContextMenuBubbling(hitPath, contextEvent, eventQueue);
                    }

                    // Strictly last: a trigger's own handler must have already
                    // run (and had its chance to stopPropagation) before any
                    // layer is told this press was outside it.
                    this.dispatchPointerDownOutside(hitPath, event, eventQueue);
                }
                else if pe.kind == PointerEventKind.Up {
                    this.dispatchCapturing(hitPath, event, PointerEventKind.Up, eventQueue);
                    this.dispatchBubbling(hitPath, event, PointerEventKind.Up, eventQueue);

                    // Eligibility: was this up-hitPath element also part of
                    // the down-hitPath? pointerDownHere hasn't been touched
                    // since Down (see updateHoverState -- it deliberately no
                    // longer resets this on hover-loss), so it still
                    // correctly answers that regardless of anything the
                    // pointer did in between, including dragging off this
                    // exact element and back onto it before release.
                    let clickEligible = this._clickEligible;
                    clickEligible.clear();
                    for el in hitPath {
                        let d = runtimeDataOf(el);
                        clickEligible.push(d.inputFeedback ? d.inputFeedback.pointerDownHere : false);
                    }

                    // Consume pointerDownHere for *every* Down target, not
                    // just the ones still in this Up's hitPath -- otherwise
                    // an element the pointer left and never returned to
                    // would keep a stale true, ready to wrongly fire on some
                    // later, unrelated click that happens to hit it.
                    for d in this._pointerDownTargets {
                        setPointerDownHere(d, false);
                    }
                    this._pointerDownTargets.clear();

                    let clickEvent = PointerEvent {
                        pointerId: 1, pointerType: "mouse", pos: pe.pos,
                        button: pe.button, buttons: pe.buttons,
                        pressure: 0.0, isPrimary: true,
                        modifiers: this.currentModifiers(),
                        detail: pe.detail,
                    };
                    // Primary button -> click; anything else -> auxclick.
                    // Strictly one or the other, exactly as in the DOM.
                    let primary = pe.button == PointerButton.Left;
                    let clickKind = primary ? ClickEventKind.Click : ClickEventKind.AuxClick;
                    this.dispatchClickCapturing(hitPath, clickEligible, clickEvent, clickKind, eventQueue);
                    this.dispatchClickBubbling(hitPath, clickEligible, clickEvent, clickKind, eventQueue);

                    // dblclick is an EXTRA event after the second click, not a
                    // replacement for it -- a double click fires click, click,
                    // dblclick. Its own event object so that stopping one does
                    // not stop the other.
                    if primary && pe.detail == 2 {
                        let doubleClickEvent = PointerEvent {
                            pointerId: 1, pointerType: "mouse", pos: pe.pos,
                            button: pe.button, buttons: pe.buttons,
                            pressure: 0.0, isPrimary: true,
                            modifiers: this.currentModifiers(),
                            detail: pe.detail,
                        };
                        this.dispatchClickCapturing(hitPath, clickEligible, doubleClickEvent, ClickEventKind.DoubleClick, eventQueue);
                        this.dispatchClickBubbling(hitPath, clickEligible, doubleClickEvent, ClickEventKind.DoubleClick, eventQueue);
                    }
                }
                else if pe.kind == PointerEventKind.Move {
                    this.dispatchCapturing(hitPath, event, PointerEventKind.Move, eventQueue);
                    this.dispatchBubbling(hitPath, event, PointerEventKind.Move, eventQueue);
                }
            }

            // Wheel: acts on whatever's currently under the cursor, so it
            // reuses this frame's finalHitPath rather than computing its own.
            if wheelDelta.x != 0.0 || wheelDelta.y != 0.0 {
                let wheelEvent = WheelEvent {
                    pos: this.mousePos,
                    delta: wheelDelta,
                    modifiers: this.currentModifiers(),
                };
                this.dispatchWheelCapturing(finalHitPath, wheelEvent, eventQueue);
                this.dispatchWheelBubbling(finalHitPath, wheelEvent, eventQueue);
            }

            // Keyboard + text input: delivered only to the currently
            // focused element's ancestor chain, not hit-tested by position
            // at all (see dispatchKeyCapturing/Bubbling). Recomputed fresh
            // here rather than reusing any hitPath/finalHitPath above, since
            // a Down event just above this may have changed focus this very
            // frame -- that new focus target should still receive this
            // frame's key/text queues, same as a real UI wouldn't drop a
            // keystroke that lands in the same tick as the click that
            // focused the field it's meant for.
            if keyEdges.length > 0 || textChunks.length > 0 {
                let focusPath = this._focusPath;
                this.buildFocusPathInto(focusPath, tree);
                // A focused element that got hidden this frame must not keep
                // receiving keystrokes. releaseHiddenInputState() below
                // normally blurs it before we ever get here (that is what
                // fires onBlur and stops ui_focused() from lying); this is
                // the belt-and-braces check for the one frame where a
                // handler hides an element after that pass has already run.
                // Whether anything can receive this frame's keys at all.
                // Tab is handled either way: with nothing focused it is what
                // ENTERS the UI from the keyboard, so gating it on there
                // already being a focused element would make the keyboard
                // unreachable from a cold start.
                let focusUsable = focusPath.length > 0 && !this.pathIsHidden(focusPath);

                for ke in keyEdges {
                    let keyEvent = KeyboardEvent {
                        key: ke.key,
                        repeat: ke.repeat,
                        modifiers: ke.modifiers,
                    };
                    if focusUsable {
                        this.dispatchKeyCapturing(focusPath, keyEvent, ke.kind, eventQueue);
                        this.dispatchKeyBubbling(focusPath, keyEvent, ke.kind, eventQueue);
                    }

                    // Focus navigation is this key's DEFAULT ACTION, so it is
                    // queued behind every handler and skipped if one of them
                    // called preventDefault() -- which is how a text editor
                    // keeps Tab for indentation. Exactly the browser's own
                    // arrangement, and the reason preventDefault exists
                    // separately from stopPropagation.
                    if ke.kind == KeyEdgeKind.Pressed && ke.key == Key.Tab {
                        let backwards = hasModifier(ke.modifiers, KeyModifiers.Shift);
                        eventQueue.push((): void => {
                            if keyEvent._defaultPrevented { return; }
                            this.moveFocusByTab(tree, backwards);
                        });
                    }
                }
                if focusUsable {
                    for chunk in textChunks {
                        let textEvent = TextInputEvent { text: chunk };
                        this.dispatchTextInputCapturing(focusPath, textEvent, eventQueue);
                        this.dispatchTextInputBubbling(focusPath, textEvent, eventQueue);
                    }
                }
            }
        }

        // FIRE PHASE -- the tree has been fully walked and every applicable
        // handler for this frame is now scheduled; only now do any of them
        // actually run.
        for fire in eventQueue { fire(); }
        // Handlers are done; drop them now rather than holding the closures
        // (and whatever they captured) alive until next frame's clear().
        eventQueue.clear();

        // FLUSH PHASE -- Vue's flushJobs: every watcher triggered since the
        // last flush runs around this frame's template pass, and the
        // template pass itself happens in here.
        this.flushJobs();

        if !this.rootComponent {
            return none;
        }
        return this.rootComponent.rootElement;
    }

    // Whether this frame has any work to do at all -- the single gate that
    // makes the tree pull-based instead of per-frame. process() consults it
    // (together with this frame's input, which only process() can see) and
    // does literally nothing when it says no: no traversal, no hit-testing,
    // no template.
    //
    // Everything that can invalidate the frame has to be represented here,
    // and "is the template dirty" alone is NOT enough:
    //
    //  - The root template covers every reactive any template read, at any
    //    depth. A child's templateComputed is read from inside its parent's
    //    (defineComponentImpl), so a write in the deepest leaf marks the
    //    whole chain up to rootTemplate dirty -- mark_dirty in
    //    hzstd_reactive.c walks dependents transitively.
    //
    //  - A WATCHER is a computed of its own and deliberately NOT part of
    //    that chain: rx.watch evaluates its source with the watcher's node
    //    as the only tracking context, precisely so a watch() call inside a
    //    setup does not make the parent template depend on whatever it
    //    watches. So a watched source changing does not touch rootTemplate,
    //    and the template being clean says nothing about whether a watcher
    //    is owed a run. What the write DOES do is call the watcher's
    //    scheduler the instant it lands (hzstd_computed_set_scheduler ->
    //    UIContext.watch's scheduler), which queues the job right here. A
    //    non-empty queue therefore IS the "a watcher fired" signal, and it
    //    is readable without evaluating anything.
    //
    //    That is what keeps a watched property from going stale. Without
    //    this check the sequence is: watched source is written, template
    //    stays clean, gate says no, frame is skipped, the job sits in the
    //    queue -- forever, because nothing else is ever going to dirty the
    //    template either; the callback that WOULD have done it is the one
    //    being skipped. With it: the gate opens, flushJobs runs the
    //    callback, the callback's writes dirty the template, and the same
    //    flush re-runs it before the frame ends. The watcher's dependency
    //    does not need to be mirrored onto the template to achieve that --
    //    the scheduler already delivered the invalidation, and reusing it
    //    here keeps the template's dependency set honest (a `post` watcher,
    //    or one whose callback only talks to the host, still must not force
    //    a re-render of a tree that did not change).
    //
    //  - requestUpdate() is the escape hatch for state the reactive graph
    //    cannot see at all -- a queued focus request, a resized window, a
    //    host mutating something behind the UI's back. See ui_requestUpdate.
    //
    //  - No root component yet means the first frame, which always runs.
    //
    // Purely a query: it evaluates nothing, subscribes to nothing, and
    // clears nothing, so a host may call it as often as it likes.
    fn needsUpdate(): bool {
        if !this.rootComponent {
            return true;
        }
        if ui_updateRequested() {
            return true;
        }
        if this._preJobs.jobs.length > 0 || this._postJobs.jobs.length > 0 {
            return true;
        }
        return rx.isDirty(this.rootTemplate);
    }

    // See ui_requestUpdate -- the method form, for hosts holding a context.
    fn requestUpdate(): none {
        ui_requestUpdate();
    }

    // Vue's flushJobs(), with the frame as the tick. `pre` watchers run
    // before the template pass so what they write is rendered this frame;
    // `post` watchers run after it. Whatever a watcher writes is picked up
    // in the SAME frame: the template re-runs if it went dirty, and a
    // watcher triggered by the template pass (an onMounted hook, a ref being
    // bound) or by another watcher goes round again -- until nothing is
    // left to run, exactly like Vue keeps flushing until its queue is empty.
    // Vue's recursion limit applies twice over: a job that keeps
    // re-queueing itself within one flush is cut off in WatchJobQueue, and
    // a watcher/template ping-pong across rounds is cut off here, with a
    // message rather than a hung frame either way.
    fn flushJobs() {
        let rounds = 0;
        while true {
            this._preJobs.flush();
            rx.get(this.rootTemplate);
            if this._preJobs.jobs.length == 0 {
                this._postJobs.flush();
            }
            // The template is re-checked, not just the queues: a `post`
            // watcher runs AFTER the template pass by definition, so what it
            // writes lands in a template that has already been evaluated this
            // round. Leaving on an empty queue alone would end the frame with
            // the tree still dirty -- rendered one frame behind whatever that
            // callback wrote, until something unrelated happened to
            // invalidate it again. Another round costs one cached read when
            // there is nothing to redo.
            if this._preJobs.jobs.length == 0 && this._postJobs.jobs.length == 0 && !rx.isDirty(this.rootTemplate) {
                return;
            }
            rounds++;
            if rounds > 100 {
                fmt.println("[ui] Maximum recursive updates exceeded. A watcher keeps writing state that triggers it (or the template) again.");
                this._preJobs.jobs.clear();
                this._postJobs.jobs.clear();
                return;
            }
        }
    }

    fn pushRenderContext(ctx: RenderContext) {
        this.renderStack.push(ctx);
    }

    fn popRenderContext() {
        this.renderStack.pop();
    }

    // Places `element` as the next child of whatever's currently being built
    // (the top of renderStack), overwriting the slot already there in place
    // when one exists instead of unconditionally pushing -- so re-declaring
    // the same stable child list, frame after frame, costs zero allocations
    // (no reset, no growth, just overwriting already-allocated slots with the
    // same values). Used by div()/text()/canvas() to attach themselves to
    // their parent, and by defineComponentImpl() to attach a component's
    // root wrapper the same way. Anything left over from a previous, longer
    // list is trimmed by truncateChildrenToCursor() below, once the caller's
    // own children are done.
    fn attachChild(element: ui_elements.Element): void {
        assert(this.renderStack.length > 0);
        let top = this.renderStack.length - 1;
        let parent = this.renderStack[top].currentParent;
        let childIndex = this.renderStack[top].childIndex;
        if childIndex < parent.children.length {
            parent.children[childIndex] = element;
        } else {
            parent.children.push(element);
        }
        this.renderStack[top].childIndex = childIndex + 1;
    }

    // Counterpart to attachChild() above: once a parent's children are done
    // being (re-)declared for this build pass, drops whatever's left past
    // `cursor` -- i.e. children a previous, longer render left behind that
    // didn't get re-declared this time (e.g. a conditional that's now
    // false). A no-op, no-allocation call when nothing was actually removed.
    fn truncateChildrenToCursor(parent: mut ui_elements.DivElement, cursor: int): void {
        while parent.children.length > cursor {
            parent.children.pop();
        }
    }

    // Used by defineComponentImpl's crash-recovery paths, which set the
    // error text as rootElement's one and only child directly (outside the
    // normal attachChild()/RenderContext cursor flow, since there's no
    // nested div()/text() call tracking a cursor there) -- same in-place-
    // overwrite-then-trim shape as attachChild()/truncateChildrenToCursor(),
    // so a component stuck crashed across many frames in a row doesn't
    // reallocate or accumulate children each time either.
    fn setSingleChild(parent: mut ui_elements.DivElement, child: ui_elements.Element): void {
        if parent.children.length > 0 {
            parent.children[0] = child;
        } else {
            parent.children.push(child);
        }
        this.truncateChildrenToCursor(parent, 1);
    }

    fn makeCurrentComponentAvailable(id: int) {
        let instance = null as ComponentInstance | null;

        if this.renderStack.length > 0 {
            let parent = this.renderStack[this.renderStack.length - 1].currentComponent;

            // First check if already registered in this render cycle (avoids double-creation
            // when called from both defineComponent and defineComponentImpl for the same id).
            let child = null as ComponentInstance | null;
            let alreadyRegistered = false;
            for n in parent.newChildComponents {
                if n.id == id {
                    // ids are unique within a render cycle, so the first match
                    // is the only match.
                    child = n.component;
                    alreadyRegistered = true;
                    break;
                }
            }

            if child is null {
                child = parent.findChild(id);
            }

            if child is null {
                child = parent.createChild(id, this.getCurrentParent());
            }
            assert(child);

            if !alreadyRegistered {
                parent.newChildComponents.push({
                    id: id,
                    component: child,
                });
            }

            instance = child;
        } else {
            if !this.rootComponent {
                // Same reasoning as createChild()'s root above: explicit
                // Grow so the very top of the tree fills the window instead
                // of shrink-wrapping to ComputedDivStyle's default (Fit).
                let rootElement = ui_elements.DivElement({
                    id: id,
                    // The one true root -- no parent to extend a global id
                    // from, so its own local id is the whole global id.
                    globalId: f"{id}",
                    style: { width: ui_styling.SizeMode.Grow, height: ui_styling.SizeMode.Grow },
                });
                this.rootComponent = ComponentInstance {
                    id: id,
                    rootElement: rootElement,
                    propsVersion: rx.reactive<int>(0),
                };
            }
            assert(this.rootComponent);
            instance = this.rootComponent;
        }
        assert(instance);

        return instance;
    }

    fn getCurrentComponent() {
        assert(this.renderStack.length > 0);
        return this.renderStack[this.renderStack.length - 1].currentComponent;
    }

    fn getCurrentIdPath(): str {
        assert(this.renderStack.length > 0);
        return this.renderStack[this.renderStack.length - 1].idPath;
    }

    fn getCurrentParent() {
        assert(this.renderStack.length > 0);
        return this.renderStack[this.renderStack.length - 1].currentParent;
    }

    fn destroyComponent(
        component: ComponentInstance
    ) :: final {

        for child in component.childComponents {
            this.destroyComponent(
                child.component
            );
        }

        // Before the unmount hook, like Vue stops a component's effect scope
        // before onUnmounted: nothing the hook does can trigger them again.
        for watcher in component.watchers {
            watcher.stop();
        }
        component.watchers.clear();

        // Same reason, and the same lifetime: a hook parked on the context's
        // per-frame list would otherwise keep running (and keep polling the
        // pointer, or keep writing state) for a component that no longer
        // exists. Clearing the callback is the whole unregistration --
        // runFrameHooks() compacts the dead entry out of the list on its
        // next pass, so this needs no identity search here.
        component.onFrame = none;

        if component.onUnmount {
            component.onUnmount();
        }

        component.childComponents.clear();
        component.newChildComponents.clear();
    }

    fn defineComponentImpl(
        id: int,
        propsChanged: bool,
        setupFn: stackref (() => (() => DivProps))
    ) {
        let instance = this.makeCurrentComponentAvailable(id);

        if !instance.setupDone {
            // Setup runs with a render context pushed for this component, so
            // the hooks that identify "the component being defined" by looking
            // at the top of renderStack -- onMounted/onUnmount, see
            // getCurrentComponent() -- work from inside setup, which is the
            // only place they can sensibly be called (setup runs once; the
            // template re-runs on every reactive change, so registering a
            // mount hook from there would re-register it endlessly).
            //
            // Nothing here builds elements, so this context is only ever
            // consulted for `currentComponent`; the template pushes its own
            // context later for the actual element building.
            this.pushRenderContext({
                currentComponent: instance,
                currentParent: instance.rootElement,
                idPath: "",
            });
            attempt {
                instance.currentTemplate = setupFn();
                instance.setupDone = true;
            } recover e {
                instance.crashed = true;
                instance.crashInfo = e;
                instance.setupDone = true;
                fmt.println(f"[crash] component {instance.id} setup:");
                e.print();
            };
            this.popRenderContext();
        }

        if (propsChanged) {
            instance.propsVersion++;
        }

        if instance.templateComputed is none {
            instance.templateComputed = rx.computed(() => {
                rx.get(instance.propsVersion);

                instance.newChildComponents.clear();

                if instance.crashed && instance.crashInfo {
                    let errEl = getOrCreateText(instance.rootElement, -1, "").element;
                    errEl.text := f"Component error: {instance.crashInfo.message}";
                    errEl.style := ui_styling.computeTextStyle({ textColor: Color(1, 0.2, 0.2, 1) }, none);
                    this.setSingleChild(instance.rootElement, errEl);
                    return none;
                }

                let stackDepthBefore = this.renderStack.length;

                this.pushRenderContext({
                    currentComponent: instance,
                    currentParent: instance.rootElement,
                    idPath: "",
                });

                assert(instance.currentTemplate);
                // The template declares the component's own root element and
                // returns its props -- style, events, refs, focus, anchor, all
                // of it, exactly as a div would (its `id` is the only field
                // that does not apply; see DivProps.id).
                let rootProps = attempt {
                    instance.currentTemplate();
                } recover e {
                    instance.crashed = true;
                    instance.crashInfo = e;
                    fmt.println(f"[crash] component {instance.id}:");
                    e.print();
                    while this.renderStack.length > stackDepthBefore {
                        this.popRenderContext();
                    }
                    let errEl = getOrCreateText(instance.rootElement, -1, "").element;
                    errEl.text := f"Component error: {e.message}";
                    errEl.style := ui_styling.computeTextStyle({ textColor: Color(1, 0.2, 0.2, 1) }, none);
                    this.setSingleChild(instance.rootElement, errEl);
                    return none;
                };

                this.applyDivProps(instance.rootElement, rootProps);

                // The root's style, resolved over one base layer: Grow/Grow,
                // rather than a plain div's Fit. A component boundary has to
                // be a transparent pass-through by default, or every one of
                // them would silently shrink-wrap and block an ancestor's Grow
                // from reaching a descendant that wants it (see createChild).
                // A template that wants Fit says so, like any other element.
                //
                // Nothing outside the component contributes to this. A parent
                // reaches a component through its declared props, slots and
                // emits only -- there is no implicit passthrough to an element
                // the caller cannot see.
                let stackref resolved = ui_styling.DivStyle {
                    width: ui_styling.SizeMode.Grow,
                    height: ui_styling.SizeMode.Grow,
                };
                if rootProps.style is not none {
                    ui_styling.overlayExplicitDiv(resolved, rootProps.style);
                }
                instance.rootElement.style := ui_styling.finishDivStyle(resolved);

                // Swap the two lists: what was registered this pass becomes
                // the current list, and last pass's list is kept around as
                // next pass's (cleared) registration buffer -- the same two
                // arrays live for the component's whole life.
                let oldChildren = instance.childComponents;
                instance.childComponents = instance.newChildComponents;
                instance.newChildComponents = oldChildren;

                for old in oldChildren {

                    let stillExists = false;

                    for new in instance.childComponents {
                        if new.id == old.id {
                            stillExists = true;
                            break;
                        }
                    }

                    if !stillExists {
                        this.destroyComponent(
                            old.component
                        );
                    }
                }

                // Trim anything left over from a previous, longer render of
                // this component's children -- see truncateChildrenToCursor()'s
                // own comment.
                let childCount = this.renderStack[this.renderStack.length - 1].childIndex;
                this.popRenderContext();
                this.truncateChildrenToCursor(instance.rootElement, childCount);

                // Same ordering as div(): the ref is only published once the
                // element is fully declared.
                this.bindElementRef(rootProps, instance.rootElement);

                return none;
            });
        }

        rx.get(instance.templateComputed);

        if !instance.mounted {
            instance.mounted = true;
            if instance.onMounted {
                instance.onMounted();
            }
        }

        // attach root element into current parent if there is one
        if this.renderStack.length > 0 {
            this.attachChild(instance.rootElement);
        }
    }

    fn defineComponent<TProps>(
        id: int,
        props: TProps,
        setupFn: immediate (instance: InstanceData<TProps>) => (() => DivProps)
    ) {
        let instance = this.makeCurrentComponentAvailable(id);

        // This is an object which is created once and then never created again, because component code such as
        // setup and template must capture it. Then we can continuously update the content of the object
        // such as the props with their latest state. After capturing it, component code always gets the latest
        // state of the props as long as it only captures the container and not the props themselves.
        if !instance.instanceDataForCapturing {
            instance.instanceDataForCapturing = TypeErasedBox<InstanceData<TProps>>(InstanceData<TProps> {
                _props: props,
                _propsVersion: instance.propsVersion,
            });
        }
        assert(instance.instanceDataForCapturing);
        let instanceData = instance.instanceDataForCapturing.get<InstanceData<TProps>>();
        instanceData._props = props;

        do unsafe {
            // Whether this component's props actually changed, which is what
            // decides if its template re-runs (propsVersion below feeds the
            // template computed).
            //
            // This is a real value comparison now. It could not be written
            // before: `==`/`!=` on a `ref struct` compared OBJECT IDENTITY, and
            // every call site builds its props as a fresh literal each frame,
            // so `props != prevProps` was true on every single render and the
            // memoization it exists for had never once fired. Equality is
            // value-based throughout the language now, autogenerated member by
            // member for plain structs and dispatching to a props type's own
            // operator!= where it declares one (TabsArgs, DropdownArgs and
            // TitleBarMenusArgs all do, because they carry dynamic arrays,
            // which have no automatic comparison).
            // Whether this component's props actually changed, which is what
            // decides if its template re-runs (propsVersion below feeds the
            // template computed, and the computed re-runs when that OR any
            // reactive it read changes -- so unchanged props never suppress an
            // update that some piece of reactive state actually made).
            //
            // This could not be written before value equality existed: `!=` on
            // a `ref struct` compared OBJECT IDENTITY, and every call site
            // builds its props as a fresh literal each frame, so the comparison
            // was true on every single render and this memoization had never
            // once fired. It compares contents now -- autogenerated member by
            // member for plain props types, and dispatching to a props type's
            // own operator!= where it declares one (TabsArgs, TabButtonArgs,
            // ButtonArgs, DropdownArgs and TitleBarMenusArgs all do, because
            // they carry dynamic arrays and/or want callbacks left out).
            //
            // Callback fields are deliberately excluded by every one of those
            // operators. A closure rebuilt on each render is a different
            // environment and would compare unequal every frame, which would
            // make props "always changed" again and defeat the whole thing.
            // The props types that get the AUTOGENERATED comparison have no
            // callable members at all, so they are unaffected.
            let propsChanged = true;
            if instance.prevProps {
                let prevProps = instance.prevProps.get<TProps>();
                propsChanged = props != prevProps;
            }

            if !instance.prevProps {
                instance.prevProps = TypeErasedBox<TProps>(props);
            }
            assert(instance.prevProps);
            instance.prevProps.set<TProps>(props);

            // Only ever called once (setupDone), but it is *built* on every
            // render of the parent -- in place on the stack, so that costs
            // nothing. Note what it returns: the TEMPLATE closure, so this is
            // `() => (() => DivProps)` -- one arrow more than it looks.
            let stackref setup = () => {
                return setupFn(instanceData);
            };
            return this.defineComponentImpl(id, propsChanged, setup);
        };
    }

    fn onMounted(callback: () => none) {
        let component = this.getCurrentComponent();
        component.onMounted = callback;
    }

    fn onUnmount(callback: () => none) {
        let component = this.getCurrentComponent();
        component.onUnmount = callback;
    }

    // Runs once per frame, for as long as this component is being rendered.
    //
    // For polling that genuinely cannot be expressed as an event: the classic
    // one is pointer capture, where a drag has to keep tracking the pointer
    // after it has left the element. Move events are dispatched along the
    // CURRENT hit path (see process()), so they simply stop arriving -- which
    // is what leftMouseHeld()/mousePos are for, and they have to be READ from
    // somewhere every frame.
    //
    // An ordinary component can just write that code in its render body. One
    // written as a .hzui single-file component cannot: its template is
    // declarative and holds no statements, so this is the hook it uses.
    //
    // The hook runs on EVERY frame, including the ones the frame gate skips
    // (see runFrameHooks) -- it has to, since polling something the reactive
    // graph cannot see is the entire reason it exists, and a gate that only
    // opened once that thing had already been noticed could never notice it.
    // It is therefore held on the context, not reached through the tree:
    // walking to it would mean re-running the ancestors' templates, which is
    // exactly the work being avoided. Registration is undone when the
    // component is destroyed (destroyComponent), like a watcher's.
    //
    // Prefer reactive state and events; reach for this only when neither can
    // see what you need.
    fn onFrame(callback: () => none) {
        let component = this.getCurrentComponent();
        if !component.onFrame {
            this._frameHooks.push(component);
        }
        component.onFrame = callback;
    }

    // Runs every registered onFrame hook. Called once per process(), BEFORE
    // the frame gate -- deliberately: a hook is the framework's answer to
    // "I have to look at something the reactive graph cannot see" (the
    // pointer, the clock, the host), so it is the one thing that must still
    // run on a frame that would otherwise be skipped. That costs a walk of
    // this list and nothing else -- no tree traversal, no template -- and
    // whatever a hook writes drives the gate the ordinary way: a write to a
    // reactive the template read reopens it, a write to a watched source
    // queues a job. A hook that finds nothing to do writes nothing, the
    // gate stays shut, and the frame still costs nothing.
    fn runFrameHooks() {
        // Compacting walk: entries whose callback was cleared by
        // destroyComponent are dropped as they are passed over, so an
        // unregistration costs nothing at destroy time and the list never
        // grows past the number of live hooks. Written as an explicit
        // read/write cursor rather than a removal, so a hook that itself
        // destroys a component (clearing another entry) cannot make the
        // walk skip or repeat one.
        let write = 0;
        for (let read = 0; read < this._frameHooks.length; read++) {
            let component = this._frameHooks[read];
            let hook = component.onFrame;
            if !hook {
                continue;
            }
            this._frameHooks[write] = component;
            write++;
            hook();
        }
        while this._frameHooks.length > write {
            this._frameHooks.pop();
        }
    }

    ref struct WatchOptions {
        immediate?: bool;
        deep?: bool;
        once?: bool;
        // When the callback runs relative to the frame's template pass --
        // see WatchFlush. Default: Pre.
        flush?: WatchFlush;
    }

    // Vue's watch(), scheduled on the frame. `callback(value, oldValue)`
    // runs when the value `getter` returns changes; see rx.watch for the
    // full semantics (immediate, deep, once, onWatcherCleanup, the handle's
    // stop/pause/resume) -- this adds only the flush timing and the
    // component binding.
    //
    // Call it from a component's setup: the watcher is then stopped with
    // the component. Called anywhere else it lives until stopped through
    // the returned handle.
    fn watch<T>(
        getter: () => T,
        callback: (value: rx.UnwrapReactive<T>, oldValue: rx.UnwrapReactive<T> | none) => none,
        options: WatchOptions = {}
    ): rx.WatchHandle {
        let flush = WatchFlush.Pre;
        let requestedFlush = options.flush;
        if requestedFlush is not none {
            flush = requestedFlush;
        }

        let scheduler: (job: rx.WatchJob) => none = (job: rx.WatchJob): none => {
            this._preJobs.queue(job);
        };
        if flush == WatchFlush.Post {
            scheduler = (job: rx.WatchJob): none => {
                this._postJobs.queue(job);
            };
        } else if flush == WatchFlush.Sync {
            scheduler = (job: rx.WatchJob): none => {
                job.run();
            };
        }

        let handle = rx.watch(getter, callback, {
            immediate: options.immediate,
            deep: options.deep,
            once: options.once,
            scheduler: scheduler,
        });

        if this.renderStack.length > 0 {
            this.getCurrentComponent().watchers.push(handle);
        }
        return handle;
    }

    // Presets are a parameter pack -- `ui.div(props, children, presets.wFit(),
    // presets.p(1))` -- so nothing is allocated per call: the pack
    // computeDivStyle() unrolls them at compile time straight off the
    // caller's stack. Only this thin wrapper is instantiated per distinct
    // preset combination; the element work lives in divImpl() once.
    //
    // `childrenFn` is `immediate`: it is invoked right here, inside this
    // call, and never kept -- so a call site's `() => { ... }` literal gets
    // its env on the stack (no allocation per div per render) and the
    // narrowings in effect at the call site hold inside the child tree.
    fn div(props: DivProps, childrenFn: immediate () => void, presets: ...) {
        let rawStyle: ui_styling.DivStyle = {};
        if props.style is not none { rawStyle := props.style; }
        return this.divImpl(props, ui_styling.computeDivStyle(rawStyle, ...presets), childrenFn);
    }

    // Everything a DivProps says about an element other than its children and
    // its resolved style: anchor publication, every event callback, and the
    // focus flags. Split out of divImpl because a component's root element is
    // a real div too -- built from the DivProps its template returns rather
    // than from a div() call -- and has to honour the exact same props, with
    // no second implementation to drift from this one. See
    // defineComponentImpl.
    fn applyDivProps(element: mut ui_elements.DivElement, props: DivProps) {
        if props.anchor is not none {
            // NOTE: publishing an anchor target works, but CONSUMING one via
            // presets.anchorTo() currently panics inside ui_layout's
            // resolveFloating(): TypeErasedBox checks identity with
            // T.fingerprint, and the fingerprint computed for
            // ui_elements.DivElement where the box is written here does not
            // match the one computed for the same type where it is read in
            // ui_layout. The panic even names the identical type on both
            // sides. Nothing in the repo used anchorTo(), so this had never
            // been hit. Until that is fixed, position floating elements
            // with presets.absolute() against a positioned ancestor -- see
            // the editor's hover popup and ui_widgets' Dropdown.
            props.anchor := TypeErasedBox<ui_elements.DivElement>(element);
        }

        // Store event callbacks into runtime data so the event system can read them.
        let data = runtimeDataOf(element);
        data.onPointerDown = props.onPointerDown;
        data.onPointerUp = props.onPointerUp;
        data.onPointerMove = props.onPointerMove;
        data.onClick = props.onClick;
        data.onDoubleClick = props.onDoubleClick;
        data.onAuxClick = props.onAuxClick;
        data.onContextMenu = props.onContextMenu;
        data.onWheel = props.onWheel;
        data.onPointerDownCapture = props.onPointerDownCapture;
        data.onPointerUpCapture = props.onPointerUpCapture;
        data.onPointerMoveCapture = props.onPointerMoveCapture;
        data.onClickCapture = props.onClickCapture;
        data.onDoubleClickCapture = props.onDoubleClickCapture;
        data.onAuxClickCapture = props.onAuxClickCapture;
        data.onContextMenuCapture = props.onContextMenuCapture;
        data.onWheelCapture = props.onWheelCapture;
        data.onHoverEnter = props.onHoverEnter;
        data.onHoverLeave = props.onHoverLeave;
        data.onHitEnter = props.onHitEnter;
        data.onHitLeave = props.onHitLeave;
        data.focusable = props.focusable is not none ? props.focusable : false;
        // autofocus: request focus the first time this element is built, and
        // never again -- re-requesting every frame would make it impossible to
        // ever focus anything else (each frame would steal focus straight
        // back). `autofocusApplied` is what makes it fire exactly once, which
        // is why it lives on the persistent runtime data and not here.
        if !data.autofocusApplied {
            data.autofocusApplied = true;
            if data.focusable && props.autofocus is not none && props.autofocus {
                data.focusRequested = FocusRequest.Focus;
                // Same as ui_focus(): this is set during the template pass,
                // and only next frame's applyPendingFocus acts on it.
                ui_requestUpdate();
            }
        }
        data.onFocus = props.onFocus;
        data.onBlur = props.onBlur;
        data.onFocusIn = props.onFocusIn;
        data.onFocusOut = props.onFocusOut;
        data.onFocusCapture = props.onFocusCapture;
        data.onBlurCapture = props.onBlurCapture;
        data.onFocusInCapture = props.onFocusInCapture;
        data.onFocusOutCapture = props.onFocusOutCapture;
        data.onPointerDownOutside = props.onPointerDownOutside;
        data.onFocusOutside = props.onFocusOutside;
        data.onKeyDown = props.onKeyDown;
        data.onKeyUp = props.onKeyUp;
        data.onTextInput = props.onTextInput;
        data.onKeyDownCapture = props.onKeyDownCapture;
        data.onKeyUpCapture = props.onKeyUpCapture;
        data.onTextInputCapture = props.onTextInputCapture;
    }

    // The other half of divImpl that a component root needs verbatim: publish
    // the element into `props.elementRef`, if the caller asked for one. Runs
    // after the children are built, so that a ref is only ever handed out for
    // a fully declared element.
    fn bindElementRef(props: DivProps, element: ui_elements.DivElement) {
        if props.elementRef is not none {
            if props.elementRef is null || props.elementRef.raw.id != element.id {
                props.elementRef := ElementWrapper<ui_elements.DivElement> { raw: element, _element: element };
            }
        }
    }

    fn divImpl(props: DivProps, style: ui_styling.ComputedDivStyle, childrenFn: immediate () => void) {
        let parent = this.getCurrentParent();
        let lookup = getOrCreateDiv(parent, props.id, this.getCurrentIdPath());
        let element = lookup.element;
        let idPath = lookup.path;

        element.style := style;
        this.applyDivProps(element, props);

        // attach into current parent
        this.attachChild(element);

        // descend into element
        this.pushRenderContext({
            currentComponent: this.getCurrentComponent(),
            currentParent: element,
            idPath: idPath,
        });

        childrenFn();

        // Trim anything left over from a previous, longer render of this
        // element's children -- see truncateChildrenToCursor()'s own comment.
        let childCount = this.renderStack[this.renderStack.length - 1].childIndex;
        this.popRenderContext();
        this.truncateChildrenToCursor(element, childCount);

        this.bindElementRef(props, element);

        return element;
    }

    // Presets as a parameter pack -- see div().
    fn text(props: TextProps, presets: ...) {
        let rawTextStyle: ui_styling.TextStyle = {};
        if props.style is not none { rawTextStyle := props.style; }
        return this.textImpl(props, ui_styling.computeTextStyle(rawTextStyle, ...presets));
    }

    fn textImpl(props: TextProps, style: ui_styling.ComputedTextStyle) {
        let parent = this.getCurrentParent();
        let element = getOrCreateText(parent, props.id, this.getCurrentIdPath()).element;

        element.text := props.text;
        element.style := style;

        // attach into current parent
        this.attachChild(element);

        if props.elementRef is not none {
            if props.elementRef is null || props.elementRef.raw.id != element.id {
                props.elementRef := ElementWrapper<ui_elements.TextElement> { raw: element, _element: element };
            }
        }

        return element;
    }

    // A standalone element with an auto-managed offscreen GPU canvas.
    // `drawFn`, if given, is invoked once per frame -- not here during the
    // build phase, but later from ui_runtime's renderCanvas callback, which
    // runs right after layout when this frame's size is already known (so
    // there's no one-frame lag, even on the very first frame). It's cleared
    // before each such automatic redraw.
    //
    // For content that should persist across frames instead of being fully
    // redrawn every frame, draw imperatively whenever via drawToCanvas()
    // (e.g. from an event handler) instead of passing drawFn here.
    //
    // Presets are a trailing parameter pack (see div()); since the pack must
    // be last, the optional drawFn is an overload instead of `drawFn?`.
    fn canvas(props: CanvasProps, drawFn: CanvasDrawFn, presets: ...) {
        let rawCanvasStyle: ui_styling.DivStyle = {};
        if props.style is not none { rawCanvasStyle := props.style; }
        return this.canvasImpl(props, ui_styling.computeDivStyle(rawCanvasStyle, ...presets), drawFn);
    }

    fn canvas(props: CanvasProps, presets: ...) {
        let rawCanvasStyle: ui_styling.DivStyle = {};
        if props.style is not none { rawCanvasStyle := props.style; }
        return this.canvasImpl(props, ui_styling.computeDivStyle(rawCanvasStyle, ...presets), none);
    }

    fn canvasImpl(props: CanvasProps, style: ui_styling.ComputedDivStyle, drawFn?: CanvasDrawFn) {
        let parent = this.getCurrentParent();
        let element = getOrCreateCanvas(parent, props.id, this.getCurrentIdPath()).element;

        element.style := style;

        // attach into current parent
        this.attachChild(element);

        let data = runtimeDataOf(element);
        if drawFn is not none {
            if !data.drawFn {
                data.drawFn = TypeErasedBox<CanvasDrawFn>(drawFn);
            } else {
                data.drawFn.set<CanvasDrawFn>(drawFn);
            }
        } else {
            data.drawFn = none;
        }

        let msaaSamples: int = 4;
        if props.msaaSamples is not none { msaaSamples := props.msaaSamples; }
        data.msaaSamples = msaaSamples;

        if props.postEffect is not none {
            data.postEffect = props.postEffect;
        }

        if props.elementRef is not none {
            if props.elementRef is null || props.elementRef.raw.id != element.id {
                props.elementRef := ElementWrapper<ui_elements.CanvasElement> { raw: element, _element: element };
            }
        }

        return element;
    }

    // Imperative drawing entry point: draws into the canvas element's
    // already-existing GPU canvas right now, independent of the normal
    // frame flow (e.g. usable from an event handler). No-ops if this
    // element hasn't been laid out yet (i.e. never rendered a frame), since
    // there's no canvas to draw into yet. `clear` defaults to false so
    // repeated calls accumulate instead of erasing prior content.
    fn drawToCanvas(element: mut ui_elements.CanvasElement, drawFn: CanvasDrawFn, clear: bool = false) {
        let data = runtimeDataOf(element);
        if !data.handle {
            return;
        }
        let handle = data.handle.get<CanvasHandle>();
        // Outside the main render loop there's no frame already in
        // progress to join, so this is its own one-Canvas Frame -- still
        // exactly one queue.submit(), just scoped to this single call
        // instead of to a whole application frame.
        let frame = renderer.gfx.Frame(handle.canvas.gfx);
        let r = renderer.gfx.Renderer(frame, handle.canvas);
        drawFn(r);
        r.commit(clear);
        frame.present();
    }

    fn elementRef<T>(): ElementRef<T> {
        return rx.shallowReactive<ElementWrapper<T> | null>(null);
    }

    // See ComponentRef. T is the child's exposed-API struct, not the child.
    fn componentRef<T>(): ComponentRef<T> {
        return rx.shallowReactive<T | null>(null);
    }

    // A hollow position-anchor handle -- see ui_styling.AnchorTarget. Create
    // once, hand to a target element's `anchor:` prop, and pass to any
    // number of other elements' headwind.presets.anchorTo() in either order.
    fn anchor(): ui_styling.AnchorTarget {
        return rx.shallowReactive<TypeErasedBox | null>(null);
    }
}

// Wrapper around a UI element exposed through an ElementRef. Holds the typed
// raw element for rare direct access and provides reactive methods for the
// common read-only queries so callers don't need the free-function form.
// This is a workaround because ElementWrapper is generic, which means it is copy-pasted, which means
// ui_elements.Element cannot resolve anymore because it's not namespaced. Should be fixed properly
// by implementing preelaboration of generic structs that links types directly to nodes. 
export type ui_Element = ui_elements.Element;
export ref struct ElementWrapper<T> {
    raw: T;
    _element: ui_Element;

    // Bounds-based: cursor is within this element, possibly also within a
    // child. Matches HTML/CSS :hover exactly.
    fn hover(): bool {
        return ui_hover(this._element);
    }

    // Strict: this element and not any child is genuinely under the cursor.
    // No HTML/CSS equivalent.
    fn hit(): bool {
        return ui_hit(this._element);
    }

    // Mirrors CSS :active -- true while the pointer is held down and over
    // this element, given the press also started here (or on a descendant).
    fn active(): bool {
        return ui_active(this._element);
    }

    // Mirrors CSS :focus -- see DivProps.focusable.
    fn focused(): bool {
        return ui_focused(this._element);
    }

    // Mirrors CSS :focus-visible -- focused, but not by a click. This is the
    // one to draw a focus ring from; see ui_focusVisible.
    fn focusVisible(): bool {
        return ui_focusVisible(this._element);
    }

    // Focus this element programmatically, like the DOM's element.focus() --
    // e.g. from onMounted, so a text editor is typeable the moment the window
    // opens without the user having to click into it first. Applied on the
    // next process(); see ui_focus() for the exact semantics.
    fn focus(): void {
        ui_focus(this._element);
    }

    // Give up focus, like the DOM's element.blur(). See ui_blur().
    fn blur(): void {
        ui_blur(this._element);
    }

    // Node.contains() -- see ui_contains. The reason this is on the wrapper at
    // all: a focusout handler holds a ref to its own element and a
    // relatedTarget from the event, and needs to ask whether the second is
    // inside the first.
    fn contains(other: ui_elements.Element | none): bool {
        return ui_contains(this._element, other);
    }

    fn position(): Vec2 | none {
        return ui_position(this._element);
    }

    fn size(): Vec2 | none {
        return ui_size(this._element);
    }
}

export type ElementRef<T> = rx.ShallowReactive<ElementWrapper<T> | null>;

// A handle a CHILD COMPONENT publishes for its parent -- the component
// counterpart of ElementRef above, and deliberately not the same thing.
//
// ElementRef<T> wraps a real element: its T only types `raw`, and everything
// ElementWrapper does (hover/focus/position/size) works off the element
// underneath. A component has no element to put there, and no instance type to
// name either -- a component IS a function here, and ComponentInstance is the
// framework's own bookkeeping with type-erased props, nothing a parent could
// usefully call.
//
// So T is not "the component". T is the API the component chose to publish:
// the struct its @expose section declares, which is the only thing a parent
// has any business calling. (Vue arrives at the same place from the other
// direction -- defineExpose narrows its instance-typed ref down to exactly
// what was published.) Null until the child's setup has run, which is during
// the parent's first template pass: read it from onMounted or an event
// handler, never from the parent's own setup body.
export type ComponentRef<T> = rx.ShallowReactive<T | null>;
