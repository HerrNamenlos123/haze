// hzui -- SFC UI framework runtime helpers.
//
// The SFC transformer lives in ../plugin (TypeScript, v0; haze in Phase 1).
// Consumers enable it in their haze.toml, in BOTH tables -- [plugins] runs
// the transformer, [dependencies] is what makes the `from hzui import ...`
// line it generates resolve. Declaring only the plugin is an error:
//
//   [dependencies]
//   hzui = { path = "path/to/stdlib/hzui" }
//
//   [plugins]
//   hzui = { path = "path/to/stdlib/hzui" }
//
// Runtime helpers referenced by generated code live here.

import ui_components
import ui_elements
import ui_styling
import headwind

// The element id of a keyed child inside a `for=` loop, as the SFC
// transformer lowers it (see plugin/template.ts).
//
// An id is a component/element IDENTITY: reuse one and the framework hands
// back the previous occupant's state (see ui_components.getOrCreateDiv). So
// the two inputs must not be able to alias each other, and a keyed child must
// not be able to land on a plain sibling's small sequential id. They are
// therefore kept in disjoint ranges rather than hashed together: the key
// occupies the low 32 bits and the static template position everything above
// it. Exact for any key of 32 bits or fewer, which is every key a list
// actually uses (an index, or a monotonic counter).
export fn keyId(staticId: int, key: int): int {
    const comptime SPAN = 4294967296;
    let folded = key % SPAN;
    if folded < 0 { folded = folded + SPAN; }
    return staticId * SPAN + folded;
}

