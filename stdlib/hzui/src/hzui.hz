export fn keyId(staticId: int, key: int): int {
    sys.panic("keyId NOT IMPLEMENTED");
}

// Here, re-export all the modules and symbols anyone would want to import from hzui

export type Reactive = rx.Reactive;
export type ShallowReactive = rx.ShallowReactive;
export type UnwrapReactive = rx.UnwrapReactive;
export type Computed = rx.Computed;
export alias reactive = rx.reactive;
export alias shallowReactive = rx.shallowReactive;
export alias computed = rx.computed;
export type PointerEvent = ui_components.PointerEvent;
export type WheelEvent = ui_components.WheelEvent;
export type KeyboardEvent = ui_components.KeyboardEvent;
export type TextInputEvent = ui_components.TextInputEvent;
export type FocusEvent = ui_components.FocusEvent;
