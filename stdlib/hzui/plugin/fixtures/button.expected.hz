#source "button.hzui:1" {
import ui_elements
import ui_styling
import ui_components
import headwind
type presets = headwind.presets;

// Demo style struct -- long-term these become class passthrough + theme
// tokens, but the transformer must handle plain prop structs regardless.
export struct ButtonStyle {
    bg: str = "#00000000";
    bgHover: str = "#2A2D2E";
    bgActive: str = "#37373D";
    bgSelected: str = "#37373D";
    textColor: str = "#CCCCCC";
    textColorDisabled: str = "#6A6A6A";
    paddingX: real = 8.0;
    paddingY: real = 4.0;
    rounded: real = 3.0;
    fontSize: real | none = none;
}
}

// ==== generated by hzui SFC transformer from button.hzui ====

export struct ButtonSlotContent {
    label: str;
}

export struct ButtonArgs {
    id: int;

#source "button.hzui:23" {
label: str = "";
enabled: bool = true;
selected: bool = false;
grow: bool = false;
style: ButtonStyle = {};
}

    onClick?: (e0: ui_components.PointerEvent) => none;

    content?: (s: ButtonSlotContent) => none;

    // generated: compares exactly the @props fields. Emits and
    // slots (closures) are excluded by construction.
    fn operator!=(other: ButtonArgs) {
        return this.id != other.id
            || this.label != other.label
            || this.enabled != other.enabled
            || this.selected != other.selected
            || this.grow != other.grow
            || this.style != other.style
            ;
    }
}

struct ButtonEmits {
    instance: ui_components.InstanceData<ButtonArgs>;
    fn click(e0: ui_components.PointerEvent) {
        let p = this.instance.props();
        if p.onClick { p.onClick(e0); }
    }
}

export fn Button(ui: ui_components.UIContext, args: ButtonArgs) {
    ui.defineComponent(args.id, args, (instance: ui_components.InstanceData<ButtonArgs>) => {
        let emits = ButtonEmits { instance: instance };
        ui.componentSize((instance.props().grow) ? ui_styling.SizeMode.Grow : ui_styling.SizeMode.Fit, ui_styling.SizeMode.Fit);

#source "button.hzui:38" {
let buttonRef = ui.elementRef<ui_elements.DivElement>();

let isHovered = rx.computed(() => buttonRef?.hover() ?? false);
let isActive = rx.computed(() => buttonRef?.active() ?? false);

let clicked = (event: ui_components.PointerEvent) => {
    event.stopPropagation();
    if !instance.props().enabled { return; }
    emits.click(event);
};

let backgroundColor = rx.computed(() => {
    let style = instance.props().style;
    if !instance.props().enabled { return style.bg; }
    else if instance.props().selected { return style.bgSelected; }
    else if rx.get(isActive) { return style.bgActive; }
    else if rx.get(isHovered) { return style.bgHover; }
    return style.bg;
});
}

        return (): void => {
            #source "button.hzui:59:1" {
                ui.div({ id: 1, elementRef: buttonRef, onPointerDown: clicked }, (): void => {
                    #source "button.hzui:68:1" {
                        if instance.props().content {
                            instance.props().content(ButtonSlotContent { label: instance.props().label });
                        } else {
                            #source "button.hzui:69:1" {
                                if instance.props().label.length > 0 {
                                    ui.text({ id: 1, text: instance.props().label },
                                        presets.textColor(ui_styling.Px { value: (instance.props().enabled ? instance.props().style.textColor : instance.props().style.textColorDisabled) }),
                                        presets.noWrap(),
                                        (instance.props().style.fontSize) ? presets.fontSize(ui_styling.Px { value: (instance.props().style.fontSize) }) : presets.noop()
                                    );
                                }
                            }
                        }
                    }
                },
                    presets.row(),
                    presets.crossAlignCenter(),
                    presets.gap(0),
                    presets.px(ui_styling.Px { value: (instance.props().style.paddingX) }),
                    presets.py(ui_styling.Px { value: (instance.props().style.paddingY) }),
                    presets.bg(ui_styling.Px { value: (backgroundColor) }),
                    presets.rounded(ui_styling.Px { value: (instance.props().style.rounded) }),
                    presets.hFit(),
                    presets.wFit(),
                    (instance.props().grow) ? presets.wGrow() : presets.noop(),
                    presets.cursorDefault(),
                    (instance.props().enabled) ? presets.cursorPointer() : presets.noop()
                );
            }
        };
    });
}
