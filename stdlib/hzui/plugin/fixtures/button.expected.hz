                        if props.label.length > 0 {
                            ui.text({ id: 1, text: props.label },
                                presets.textColor(props.enabled ? props.style.textColor : props.style.textColorDisabled),
                                presets.textNowrap(),
                                (props.style.fontSize) ? presets.fontSize(props.style.fontSize) : presets.noop()
                            );
                        }
                    }
                }
            }
            #source "button.hzui:62:1" {
                return {
                    id: 0,
                    elementRef: buttonRef,
                    onPointerDown: clicked,
                    style: ui_styling.mergeDivStyle({},
                        presets.row(),
                        presets.itemsCenter(),
                        presets.gap(0),
                        presets.px(ui_styling.Px { value: (props.style.paddingX) }),
                        presets.py(ui_styling.Px { value: (props.style.paddingY) }),
                        presets.bg(backgroundColor),
                        presets.rounded(ui_styling.Px { value: (props.style.rounded) }),
                        presets.hFit(),
                        (props.enabled) ? presets.cursorPointer() : presets.noop(),
                        presets.wFit(),
                        (props.grow) ? presets.wGrow() : presets.noop()
                    ),
                };
            }
        };
    });
}
