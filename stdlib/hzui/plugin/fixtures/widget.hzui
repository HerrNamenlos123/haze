@export

@props
label: str = "";

@emit
click: (PointerEvent,);
dismissed: ();

@setup
let panelRef = elementRef<DivElement>();

let onDown = (event: PointerEvent) => {
    emits.click(event);
};

let onEscape = (event: KeyboardEvent) => {
    emits.dismissed();
};

// The root element carries a ref, a focus flag, a bubble-phase event and a
// capture-phase one -- everything a plain div can carry.
@template [row bg-["#222"]]
    ref=panelRef
    focusable=true
    @pointerdown=onDown
    @key-down-capture=onEscape

text [] [props.label]
