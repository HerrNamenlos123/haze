from hzui import Reactive, ShallowReactive, Computed, UnwrapReactive, reactive, shallowReactive, computed, PointerEvent, WheelEvent, KeyboardEvent, TextInputEvent, FocusEvent, PointerEdge, KeyEdge, Key, PointerButton, PointerButtons, PointerEventKind, KeyEdgeKind, FocusEventKind, ElementRef, ComponentRef, ElementWrapper, DivProps, TextProps, CanvasProps, UIContext, InstanceData, Element, DivElement, TextElement, CanvasElement, Size, SizeMode, Direction, CrossAlign, Packing, Overflow, Position, Display, Cursor, DivStyle, TextStyle, Length, Px, Em, Rem, mergeDivStyle, presets, keyId

#source "fonts.hzui:1" {
// A component that supplies its own font. Nothing outside this file --  no
// main(), no Runtime argument -- knows the font exists; the component names it
// and hands over the bytes, and anything below can select it by that name.


// File-scope, so every instance shares one embed rather than one each. It is
// `| none` because a global initializer must be a compile-time constant and
// `computed(...)` is a call; @setup fills it in.
let iconBytes: Computed<Bytes> | none = none;
}

// ==== generated by hzui SFC transformer from fonts.hzui ====

export struct FontsArgs {
    id: int;

#source "fonts.hzui:12" {
glyph: str = "";
// The font is a PROP here, to pin down the interesting case: the caller picks
// it, so it can be a different font on a later frame, and the binding below
// has to follow it rather than snapshot it.
labelFont: Computed<Bytes>;
}

    // generated: compares exactly the @props fields. Emits and
    // slots (closures) are excluded by construction.
    //
    // Statements rather than one boolean chain so that each field can
    // carry its own #source: a field whose type turns out not to be
    // comparable then reports at ITS line in the @props section,
    // instead of at a line number in generated code that does not
    // exist in the .hzui file at all.
    fn operator!=(other: FontsArgs) {
#source "fonts.hzui:11:1" {
        if this.id != other.id { return true; }
}
#source "fonts.hzui:12:1" {
        if this.glyph != other.glyph { return true; }
}
        // labelFont: a reactive handle -- see PropDecl.stable. The
        // handle does not change, and what is inside it is tracked
        // by the reactive system, so there is nothing here to compare.
        return false;
    }
}

export fn FontsComponent(ui: UIContext, args: FontsArgs) {
    ui.defineComponent(args.id, args, (instance: InstanceData<FontsArgs>) => {

#source "fonts.hzui:19" {
iconBytes = computed(() => embed.binary("resources/icons.ttf"));

// Two directives, two names. The first reads a file-scope reactive, the second
// a prop -- both are just expressions evaluated in the render body.
}

        return (): DivProps => {
            let props = instance.props();
#source "fonts.hzui:23:1" {
            ui.provideFont("icons", iconBytes);
}
#source "fonts.hzui:24:1" {
            ui.provideFont("label", props.labelFont);
}
            #source "fonts.hzui:28:1" {
                ui.text({ id: 1, text: props.glyph },
                    presets.fontFamily("icons")
                );
            }
            #source "fonts.hzui:29:1" {
                ui.text({ id: 2, text: "Aa" },
                    presets.fontFamily("label")
                );
            }
            #source "fonts.hzui:26:1" {
                return {
                    id: 0,
                    style: mergeDivStyle({},
                        presets.row(),
                        presets.itemsCenter(),
                        presets.gap(4)
                    ),
                };
            }
        };
    });
}
