import ui_elements
import ui_styling
import ui_components
import headwind
type presets = headwind.presets;

// Demo style struct -- long-term these become class passthrough + theme
// tokens, but the transformer must handle plain prop structs regardless.
export struct ButtonStyle {
    bg: str = "#00000000";
    bgHover: str = "#2A2D2E";
    bgActive: str = "#37373D";
    bgSelected: str = "#37373D";
    textColor: str = "#CCCCCC";
    textColorDisabled: str = "#6A6A6A";
    paddingX: real = 8.0;
    paddingY: real = 4.0;
    rounded: real = 3.0;
    fontSize: real | none = none;
}

@props
label: str = "";
enabled: bool = true;
selected: bool = false;
grow: bool = false;
style: ButtonStyle = {};

@emit
click: (ui_components.PointerEvent,);

@slot
content: {
    label: str;
};

@setup
let buttonRef = ui.elementRef<ui_elements.DivElement>();

let isHovered = rx.computed(() => buttonRef?.hover() ?? false);
let isActive = rx.computed(() => buttonRef?.active() ?? false);

let clicked = (event: ui_components.PointerEvent) => {
    event.stopPropagation();
    if !props.enabled { return; }
    emits.click(event);
};

let backgroundColor = rx.computed(() => {
    let style = props.style;
    if !props.enabled { return style.bg; }
    else if props.selected { return style.bgSelected; }
    else if rx.get(isActive) { return style.bgActive; }
    else if rx.get(isHovered) { return style.bgHover; }
    return style.bg;
});

@template [w-fit [props.grow]?w-grow h-fit]
div [
        row cross-align-center gap-0 px-[props.style.paddingX] py-[props.style.paddingY]
        bg-[backgroundColor] rounded-[props.style.rounded] h-fit
        w-fit [props.grow]?w-grow
        cursor-default [props.enabled]?cursor-pointer
    ]
    ref=buttonRef
    @pointerdown=clicked
{
    slot content label=[props.label] {
        text if=[props.label.length > 0] [
            text-color-[props.enabled ? props.style.textColor : props.style.textColorDisabled]
            no-wrap
            [props.style.fontSize]?font-size-[props.style.fontSize]
        ] [props.label]
    }
}
