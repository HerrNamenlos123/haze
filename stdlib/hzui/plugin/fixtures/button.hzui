import ui_elements
import ui_styling
import ui_components
import headwind
type presets = headwind.presets;

// To show it works, this would not be how we do things, all style vars should be separate props
export struct ButtonStyle {
    bg: str = "#00000000";
    bgHover: str = "#2A2D2E";
    bgActive: str = "#37373D";
    bgSelected: str = "#37373D";
    textColor: str = "#CCCCCC";
    textColorDisabled: str = "#6A6A6A";
    paddingX: real = 8.0;
    paddingY: real = 4.0;
    rounded: real = 3.0;
    fontSize: real | none = none;
}

@props
label: str = "";
enabled: bool = true;
selected: bool = false;
grow: bool = false;
style: ButtonStyle = {};

@slot
content: {
    label: str;
};

@emit
click: (ui_components.PointerEvent,);

@setup
let buttonRef = elementRef<ui_elements.DivElement>();

let isHovered = computed(() => buttonRef?.hover() ?? false);
let isActive = computed(() => buttonRef?.active() ?? false);

let clicked = (event: ui_components.PointerEvent) => {
    event.stopPropagation();
    if !props.enabled { return; }
    emits.click(event);
};

let backgroundColor = computed(() => {
    if !props.enabled { return props.style.bg; } 
    else if props.selected { return props.style.bgSelected; } 
    else if isActive { return props.style.bgActive; } 
    else if isHovered { return props.style.bgHover; }
    return props.style.bg;
});

// The template IS the button's root element: it is styled, it holds the ref
// the hover/active computeds read, and it is what @pointerdown is bound to.
// None of that is reachable from a use site -- a caller's @click goes to the
// declared emit above, and a caller's class list must be empty (`Button []`),
// so this element stays the button's own. Sizing is a prop (`grow`) for the
// same reason.
@template [
        row items-center gap-0 px-[props.style.paddingX]px py-[props.style.paddingY]px bg-[backgroundColor]
        rounded-[props.style.rounded]px h-fit [props.enabled]?cursor-pointer w-fit [props.grow]?w-grow
    ]
    ref=buttonRef
    @pointerdown=clicked

slot content label=[props.label] {
    text if=[props.label.length > 0] [
        text-color-[props.enabled ? props.style.textColor : props.style.textColorDisabled] text-nowrap
        [props.style.fontSize]?font-size-[props.style.fontSize]
    ] [props.label]
}