__c__("#include \"ffi/perfect_freehand.c\"");
export __c__("#include \"ffi/public/perfect_freehand.h\"");

// perfect-freehand 1.2.2, the JavaScript library technicalsketcher.web draws
// its strokes with, ported to C so that it computes the very same outlines,
// bit for bit -- see ffi/perfect_freehand.c.

namespace ffi {
	// The handle is malloc'd; PerfectFreehand.destroy() frees it.
	extern C fn pf_create(): cptr :: final;
	extern C fn pf_destroy(ctx: cptr): void :: final;
	extern C fn pf_clear_points(ctx: cptr): void :: final;
	extern C fn pf_add_point(ctx: cptr, x: f64, y: f64, pressure: f64): void :: final;
	extern C fn pf_set_size(ctx: cptr, size: f64): void :: final;
	extern C fn pf_set_thinning(ctx: cptr, thinning: f64): void :: final;
	extern C fn pf_set_smoothing(ctx: cptr, smoothing: f64): void :: final;
	extern C fn pf_set_streamline(ctx: cptr, streamline: f64): void :: final;
	extern C fn pf_set_simulate_pressure(ctx: cptr, val: i32): void :: final;
	extern C fn pf_set_last(ctx: cptr, val: i32): void :: final;
	extern C fn pf_compute(ctx: cptr): i32 :: final;
	extern C fn pf_get_outline_count(ctx: cptr): i32 :: final;
	extern C fn pf_get_outline_x(ctx: cptr, index: i32): f64 :: final;
	extern C fn pf_get_outline_y(ctx: cptr, index: i32): f64 :: final;
	extern C fn pf_get_outline_min_x(ctx: cptr): f64 :: final;
	extern C fn pf_get_outline_min_y(ctx: cptr): f64 :: final;
	extern C fn pf_get_outline_max_x(ctx: cptr): f64 :: final;
	extern C fn pf_get_outline_max_y(ctx: cptr): f64 :: final;
}

// An outline's bounding box.
export struct Bounds {
	min: Vec2;
	max: Vec2;
}

export ref struct StrokeOptions {
	size: real;
	thinning: real;
	smoothing: real;
	streamline: real;
	simulatePressure: bool;
	last: bool;

	fn constructor(): StrokeOptions {
		return StrokeOptions {
			size: 16.0,
			thinning: 0.5,
			smoothing: 0.5,
			streamline: 0.5,
			simulatePressure: true,
			last: false,
		};
	}
}

// One of these computes any number of strokes: clearPoints(), the next
// stroke's points, compute(). It keeps its buffers from stroke to stroke, so
// after the first few it allocates nothing but the outlines it hands out --
// whereas one made and destroyed per stroke allocates all of them again every
// time. Keep one around wherever strokes are computed in numbers.
export ref struct PerfectFreehand {
	handle: cptr;

	fn constructor(options: StrokeOptions): PerfectFreehand {
		let ctx = ffi.pf_create();
		ffi.pf_set_size(ctx, options.size as f64);
		ffi.pf_set_thinning(ctx, options.thinning as f64);
		ffi.pf_set_smoothing(ctx, options.smoothing as f64);
		ffi.pf_set_streamline(ctx, options.streamline as f64);
		ffi.pf_set_simulate_pressure(ctx, options.simulatePressure ? (1 as i32) : (0 as i32));
		ffi.pf_set_last(ctx, options.last ? (1 as i32) : (0 as i32));
		return PerfectFreehand { handle: ctx };
	}

	fn setOptions(options: StrokeOptions) {
		ffi.pf_set_size(this.handle, options.size as f64);
		ffi.pf_set_thinning(this.handle, options.thinning as f64);
		ffi.pf_set_smoothing(this.handle, options.smoothing as f64);
		ffi.pf_set_streamline(this.handle, options.streamline as f64);
		ffi.pf_set_simulate_pressure(this.handle, options.simulatePressure ? (1 as i32) : (0 as i32));
		ffi.pf_set_last(this.handle, options.last ? (1 as i32) : (0 as i32));
	}

	fn setSize(size: real) {
		ffi.pf_set_size(this.handle, size as f64);
	}

	fn setLast(val: bool) {
		ffi.pf_set_last(this.handle, val ? (1 as i32) : (0 as i32));
	}

	fn clearPoints() {
		ffi.pf_clear_points(this.handle);
	}

	fn addPoint(pos: Vec2) {
		ffi.pf_add_point(this.handle, pos.x as f64, pos.y as f64, -1.0);
	}

	fn addPointWithPressure(pos: Vec2, pressure: real) {
		ffi.pf_add_point(this.handle, pos.x as f64, pos.y as f64, pressure as f64);
	}

	// The outline of the points added so far, or none without any.
	fn compute(): []Vec2 | none {
		return this.computeScaledDown(1.0);
	}

	// compute(), with every coordinate divided by `divisor`: for points that
	// were added scaled up, to get the outline in their own units again.
	//
	// The outline is copied out of the context in one go, into an array of
	// exactly its length. Pushed point by point into an empty one, the array
	// was reallocated at every doubling on its way there.
	fn computeScaledDown(divisor: real): []Vec2 | none {
		let status = ffi.pf_compute(this.handle);
		if status != 0 {
			return none;
		}

		let count = ffi.pf_get_outline_count(this.handle) as int;
		let result: []Vec2 = [];
		if count > 0 {
			let handle = this.handle;
			let ok = false;
			__c__("ok = hzstd_dynamic_array_resize_zeroed(result, (size_t)count) == hzstd_dynamic_array_result_ok;");
			if !ok {
				sys.panic("PerfectFreehand.compute(): out of memory");
			}
			__c__("pf_copy_outline(handle, hzstd_dynamic_array_raw_buffer(result), divisor);");
		}
		return result;
	}

	// The bounds of the outline compute() would return, without building it:
	// this allocates nothing. none without points, and for an outline without
	// any (a stroke of size 0).
	fn computeBounds(): Bounds | none {
		let status = ffi.pf_compute(this.handle);
		if status != 0 {
			return none;
		}
		if ffi.pf_get_outline_count(this.handle) == 0 {
			return none;
		}
		return Bounds {
			min: Vec2(ffi.pf_get_outline_min_x(this.handle) as real, ffi.pf_get_outline_min_y(this.handle) as real),
			max: Vec2(ffi.pf_get_outline_max_x(this.handle) as real, ffi.pf_get_outline_max_y(this.handle) as real),
		};
	}

	fn destroy() {
		ffi.pf_destroy(this.handle);
	}
}
