@export

struct IconMeta {
    slug: str;
    icon: str;
    code: str;
}

let codicon_ttf: rx.Computed<Bytes> | none = none;
let codicon_metadata: rx.Computed<[]IconMeta> | none = none;

@props
icon: str;

@setup

// The Visual Studio Code icon font, (c) Microsoft, CC BY 4.0 -- NOT MIT; the
// MIT half of that repo covers its build scripts, which we do not ship. This
// embed bakes the font into the binary, so an app using this widget
// redistributes it and owes attribution. See ../resources/NOTICE-codicons.md
// and THIRD-PARTY-NOTICES.md at the repo root.
codicon_ttf = computed(() => {
    return embed.binary("resources/codicon.ttf");
});
@font codicons [do { assert(codicon_ttf); codicon_ttf; }]

codicon_metadata = computed(() => {
    let file = embed.text("resources/codicon.csv").trim();
    let lines = file.split("\n");

    let meta: []IconMeta = [];
    meta.reserve(lines.length);

    for line in lines {
        let parts = line.split(",");
        assert(parts.length == 3);
        meta.push({
            slug: parts[0],
            icon: parts[1],
            code: parts[2],
        });
    }
    return meta;
});

let findIconBySlug = (slug: str) => {
    assert(codicon_metadata);
    for meta in codicon_metadata {
        if meta.slug == slug {
            return meta;
        }
    }
}

let selectedIcon = computed(() => {
    let icon = findIconBySlug(props.icon);
    if icon { return icon; }

    let fallback = findIconBySlug("question");
    assert(fallback);
    return fallback;
});

@template [h-fit w-fit font-family-["codicons"]]

text [] [selectedIcon.icon]