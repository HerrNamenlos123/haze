// ── ChromeTrace ───────────────────────────────────────────────────────────
//
// A self-contained library for emitting Chrome/V8-compatible profiling output:
// both the legacy ".cpuprofile" format and the modern DevTools "trace.json"
// (Trace Event Format / JSON Array Format) the Performance panel loads.
//
// Everything callers need to know about how Chrome/V8/DevTools actually
// parse these formats lives here, reverse-engineered against real
// Chrome-recorded traces and devtools-frontend's own source (not just the
// informal docs, which are missing several load-bearing details). Callers
// (e.g. profiling.hz) only need to feed in samples and events through the
// public builder API below; they should never need to know what a
// "ProfileChunk" is.
//
// ── Two hard-won invariants baked into this file ───────────────────────────
//
// 1. Sample/task ordering (see TraceBuilder.addTask/addCpuProfileSamples):
//    DevTools reconstructs each CPU sample's timestamp as
//    `profile.startTime + cumulative sum of timeDeltas`, and the FIRST
//    sample's timestamp is therefore `profile.startTime + timeDeltas[0]` --
//    never exactly `profile.startTime` itself. Samples and trace events
//    (e.g. a task) are then merged by timestamp and walked to build nested
//    flame chart rectangles; a task's JS stack gets reset to empty exactly
//    when the task event starts. If a sample's timestamp lands BEFORE the
//    task event meant to contain it, that sample gets merged in first and
//    becomes a top-level sibling instead of a nested child -- silent,
//    plausible-looking nonsense (e.g. "foo -> Task -> bar" instead of
//    "Task -> foo -> bar"). TraceBuilder avoids this by construction: a
//    profile's startTime always equals its owning task's start time, and
//    the first timeDelta is always tiny (1us) rather than a full sampling
//    interval.
//
// 2. Marker event visibility (see TraceBuilder.addInstantMarker):
//    DevTools only renders an event in the flame chart/track if its `name`
//    matches a predefined style (Styles.ts's hardcoded event registry) or
//    it is one of a handful of recognized "timing API" shapes -- an
//    arbitrary custom event name is silently invisible, and since a
//    track's header is only appended once it has a visible entry, an
//    all-custom-named track like a memory allocation timeline would never
//    even show up. Of the recognized shapes, a `PerformanceMark`-shaped
//    event (cat: "blink.user_timing", ph: "I") is the only one whose
//    custom name is actually used as the on-chart label (console.timeStamp's
//    custom text is not; it always displays as "Timestamp"). That shape
//    also gets its embedded stack trace's line/column numbers
//    auto-decremented by DevTools, so (unlike every other call frame in
//    this file) the frames passed to addInstantMarker must be 1-indexed.
//
// See stdlib/core/src/profiling.hz for the only current consumer.

namespace ChromeTrace {
    // ── Generic call frame + CPU profile tree model ─────────────────────────
    //
    // FrameRef is the caller-facing input: whatever "one frame of a call
    // stack" means to the caller (a real captured frame, or a synthetic
    // marker like "(truncated)"), reduced to just what a call frame needs to
    // be represented in either output format. `line`/`column` are 1-indexed
    // (Haze source location convention) with 0 meaning "unknown/absent" --
    // CpuProfileBuilder does whatever index conversion each output format
    // needs internally, callers never adjust these themselves.
    export struct FrameRef {
        name: str;
        url: str = "";
        line: int = 0;
        column: int = 0;

        // Optional precomputed hashFrameRef() value; 0 means "not computed", in which case
        // hashFrameRef falls back to computing it on the spot. Purely a cache: it is derived
        // from the other fields, takes no part in identity (see operator== below), and a
        // FrameRef carrying it hashes to exactly what the same FrameRef without it does.
        //
        // It exists because hashing is per (sample, frame depth), while the set of DISTINCT
        // frames a profile ever sees is tiny by comparison -- one entry per resolved address.
        // A session with hundreds of thousands of samples over stacks tens of frames deep
        // hashes millions of times, over the same few thousand strings, and measured with
        // perf that was ~20% of all the time this file's caller spent building a trace.
        // A caller that already knows its frames up front (profiling.hz builds one FrameRef
        // per frame-table entry) can hash each one once via frameRefWithHash and hand the
        // result out repeatedly instead. Callers that don't care keep constructing FrameRefs
        // exactly as before and pay the old cost.
        hash: int = 0;

        // Structs don't get a default `==` -- this is what lets CpuProfileBuilder's dedup
        // (findOrCreateChild) compare two frames' identity directly, field by field, instead of
        // formatting both into a combined string first just to compare (see hashFrameRef's own
        // doc comment for why that string-building was the actual bottleneck it looked like it
        // shouldn't be).
        //
        // Deliberately does NOT compare `hash`: it is a cache of the other four fields, so two
        // frames that differ only in whether that cache is filled in are the same frame, and
        // must dedup to the same node.
        fn operator==(other: FrameRef): bool {
            return this.line == other.line && this.column == other.column
                && this.url == other.url && this.name == other.name;
        }
    }

    // Returns `frame` with its `hash` cache filled in. See FrameRef.hash.
    export fn frameRefWithHash(frame: FrameRef): FrameRef {
        let withHash = frame;
        withHash.hash = computeFrameRefHash(frame);
        return withHash;
    }

    // ── .cpuprofile-compatible call tree (legacy CDP Profiler.Profile shape) ─

    export ref struct CpuProfileCallFrame {
        functionName: str;
        scriptId: str;
        url: str;
        lineNumber: int;
        columnNumber: int;
    }

    export ref struct CpuProfileNode {
        id: int;
        callFrame: CpuProfileCallFrame;
        hitCount: int;
        children: []int;
    }

    export ref struct CpuProfile {
        nodes: []CpuProfileNode;
        startTime: real;
        endTime: real;
        samples: []int;
        timeDeltas: []int;
    }

    // V8's inspector protocol uses 0-indexed line/column numbers; FrameRef's
    // are 1-indexed (0 means absent), hence the "- 1" below.
    fn cpuProfileCallFrame(frame: FrameRef): CpuProfileCallFrame {
        return CpuProfileCallFrame {
            functionName: frame.name.length > 0 ? frame.name : "(unknown)",
            scriptId: frame.url.length > 0 ? "1" : "0",
            url: frame.url,
            lineNumber: frame.line > 0 ? frame.line - 1 : -1,
            columnNumber: frame.url.length > 0 ? frame.column - 1 : -1,
        };
    }

    // ── trace.json-compatible call tree (the shape "Profile"/"ProfileChunk" ──
    // trace events carry, which differs from CpuProfileNode above in several
    // load-bearing ways DevTools silently refuses to render without: nodes
    // use a single `parent` id instead of a `children` list and have no
    // `hitCount`; scriptId is a JSON number, not a string; url/lineNumber/
    // columnNumber are omitted entirely (not ""/-1) when absent.

    export ref struct TraceCallFrame {
        functionName: str;
        codeType: str;
        scriptId: int;
        url?: str;
        lineNumber?: int;
        columnNumber?: int;
    }

    // ── The marker-stack call frame, and why it is a separate, smaller type ──
    //
    // A PerformanceMark's stackTrace has to be inlined into every single
    // event (see TraceEventInstantMarker's own comment: `sf` was tried and
    // confirmed not to work for this event category). With one allocation
    // marker per allocation, and stacks routinely 60-90 frames deep, this
    // ref struct is emitted MILLIONS of times in a single trace -- so every
    // field it carries is multiplied by ~5 million, and a field that
    // DevTools does not read is pure file size.
    //
    // Measured on a real 15-second capture (1.10 GB, 80,339 markers,
    // 5.0M frames), as a share of the WHOLE file:
    //   codeType      7.4%  -- not part of V8's Runtime.CallFrame at all;
    //                          it is a CpuProfile-node extension, and the
    //                          PerformanceMark path never looks at it.
    //   scriptId      6.0%  -- constant (1 for real frames, 0 otherwise);
    //                          carries no information here.
    //   columnNumber  7.4%  -- every single value in the file was 0; Haze
    //                          source locations are line-granular, so this
    //                          only ever encoded "unknown".
    //
    // Dropping those three removes ~21% of the file and loses nothing that
    // was ever read back. What remains is exactly what DevTools'
    // PerformanceMark handler consumes: the function name, and the source
    // location it renders on click.
    //
    // lineNumber stays 1-indexed on the way in and is decremented here, the
    // same as cpuProfileCallFrame does -- see invariant 2 in the file header
    // (DevTools decrements it again for this event shape specifically).
    export ref struct TraceMarkerCallFrame {
        functionName: str;
        url?: str;
        lineNumber?: int;
    }

    export ref struct TraceProfileNode {
        id: int;
        callFrame: TraceCallFrame;
        parent?: int;
    }

    // Sentinel FrameRefs for CpuProfileBuilder's own synthetic nodes (root/truncated/lost-
    // samples markers). A `name` starting with "$" can never collide with a real captured frame:
    // frameRefForNameAndLoc (profiling.hz) always replaces an empty name with "(unknown)" and
    // never produces one starting with "$" from real symbol data, so comparing the whole
    // FrameRef (see operator== below) is enough to keep these distinct from any real frame
    // without needing a separate tag.
    const rootFrameRef = FrameRef { name: "$root" };
    const truncatedFrameRef = FrameRef { name: "$truncated" };
    const lostSamplesFrameRef = FrameRef { name: "$lostSamples" };

    // A simple base-31 polynomial rolling hash (the same shape as java.lang.String.hashCode),
    // mixed directly from FrameRef's own fields -- no string ever gets built just to compute a
    // hash or to check identity (see operator== below for the latter). This used to route
    // through a formatted "{url}:{line}:{column}:{name}" string on every single
    // findOrCreateChild call (once per (sample, frame depth) pair); at real profiling-session
    // call volumes (hundreds of thousands of calls) that string allocation was the actual
    // bottleneck (confirmed live via gdb: every allocation here was a GC_malloc candidate to
    // trigger a full Boehm collection) -- not the lookup it was feeding.
    //
    // Haze `int` arithmetic panics on overflow rather than wrapping (no wrapping-arithmetic op
    // exists), so unlike a typical C/Java hash this can't just let `h` grow and overflow --
    // instead it's kept bounded by reducing mod `hashModulus` after every step, small enough
    // that `h * hashBase` can never overflow int64 no matter what `h` was.
    const hashBase = 31;
    const hashModulus = 1000000007; // hashModulus * hashBase + 255 is far below int64's range

    fn hashStrInto(h: int, s: str): int {
        for (let i = 0; i < s.length; i++) {
            h = (h * hashBase + (s[i] as int)) % hashModulus;
        }
        return h;
    }

    fn hashIntInto(h: int, value: int): int {
        // value can be negative (e.g. 0 for "absent"/never actually negative today, but kept
        // defensive); force it non-negative first so the running hash itself never goes
        // negative (the `% hashModulus` result would otherwise inherit the sign).
        let v = value < 0 ? -value : value;
        return (h * hashBase + (v % hashModulus)) % hashModulus;
    }

    fn computeFrameRefHash(frame: FrameRef): int {
        let h = hashStrInto(0, frame.url);
        h = hashIntInto(h, frame.line);
        h = hashIntInto(h, frame.column);
        h = hashStrInto(h, frame.name);
        // 0 is FrameRef.hash's "not cached" marker, so never hand it back as a real hash --
        // a frame that legitimately hashed to 0 would otherwise be rehashed on every single
        // lookup instead of using its cache. Which bucket a frame lands in is all this value
        // decides (identity is always confirmed with operator==, see ChildTable), so folding
        // one value onto another is free of consequence beyond a vanishingly rare collision.
        return h == 0 ? 1 : h;
    }

    fn hashFrameRef(frame: FrameRef): int {
        if frame.hash != 0 {
            return frame.hash;
        }
        return computeFrameRefHash(frame);
    }

    // Open-addressing (linear probing) index from a child's identifying FrameRef to its slot in
    // the owning CpuProfileNode.children array, one per node. findOrCreateChild used to answer
    // "does this parent already have a child for this key" by rescanning every existing child
    // and string-comparing each one -- fine for a handful of children, but a hot call site's
    // node can end up with hundreds/thousands of distinct children over a long profile, and this
    // scan runs once per (sample, frame depth) pair, so that rescan dominated real profiling
    // sessions. This table turns that into an O(1) amortized hash lookup instead, while keeping
    // the exact same identity semantics (two children are the same node iff their FrameRefs are
    // `==`, checked directly on a collision, no string involved) -- see
    // CpuProfileBuilder.findOrCreateChild.
    export ref struct ChildTable {
        // buckets[b] == 0 means empty; otherwise it's (childArrayIndex + 1)
        // into the owning node's `children` array (see findOrCreateChild),
        // the same "index + 1" convention `children` itself already uses
        // for node ids so 0 can mean "absent".
        buckets: []int = [];
        count: int = 0;

        fn constructor() {
            let table = ChildTable {};
            table.buckets.reserve(4);
            table.buckets.push(0);
            table.buckets.push(0);
            table.buckets.push(0);
            table.buckets.push(0);
            return table;
        }
    }

    // ── CpuProfileBuilder ────────────────────────────────────────────────────
    //
    // Incrementally builds a deduplicated call tree (the "collapsed call
    // tree" every sampling profiler UI expects) plus the flat chronological
    // samples/timeDeltas lists, from a plain sequence of (timestamp, stack)
    // samples. This is the one generic piece both output formats share;
    // everything Haze-profiler-specific (off-cpu detection, deciding when a
    // gap means lost samples vs. idle time, reading hzstd's raw sample
    // shape) is the caller's job -- see profiling.hz's adapter loop, which
    // is the only thing that decides *whether* and *how* to call addSample.
    //
    // Off-CPU time (the profiled thread simply wasn't running) is
    // represented by NOT calling addSample at all for that gap: the next
    // real sample's timeDelta then simply spans the full gap, same as any
    // other inter-sample interval, so no marker/frame/block appears for it
    // at all -- "nothing in the trace" for time that wasn't spent on-CPU.
    // (A future distinction between "voluntarily yielded" and "kernel
    // preemption" can add a real visible idle marker for the voluntary case
    // without changing this default.)
    export ref struct CpuProfileBuilder {
        nodes: []CpuProfileNode = [];
        // parallel to `nodes`: the FrameRef that identifies each node, used for dedup lookups --
        // two children are the same node iff their FrameRefs are `==` (see findOrCreateChild).
        nodeFrameRefs: []FrameRef = [];
        // parallel to `nodes`: each node's own hash (hashFrameRef of nodeFrameRefs[i]), computed
        // once at insert time. ChildTable's rehash path (insertChild) reseats existing children
        // using THIS, never by recomputing a hash from nodeFrameRefs[...] on the fly -- not
        // because it'd be wrong to recompute (hashFrameRef is a pure function of the FrameRef),
        // just to avoid redoing that work for every child on every rehash.
        nodeHashes: []int = [];
        // parallel to `nodes`: childTables[p] indexes nodes[p].children by
        // FrameRef, so findOrCreateChild doesn't have to rescan every
        // existing child on every call (see ChildTable above).
        childTables: []ChildTable = [];
        samples: []int = [];
        timeDeltas: []int = [];
        startTimeUs: real = 0.0;
        lastTimeUs: real = 0.0;
        sampleCount: int = 0;

        fn constructor() {
            let builder = CpuProfileBuilder {};
            builder.nodes.push(CpuProfileNode {
                id: 1,
                callFrame: CpuProfileCallFrame { functionName: "(root)", scriptId: "0", url: "", lineNumber: -1, columnNumber: -1 },
                hitCount: 0,
                children: [],
            });
            builder.nodeFrameRefs.push(rootFrameRef);
            builder.nodeHashes.push(hashFrameRef(rootFrameRef));
            builder.childTables.push(ChildTable());
            return builder;
        }

        // Callers that know the sample count up front (see profiling.hz)
        // should call this before the addSample loop: `samples`/`timeDeltas`
        // otherwise grow one push at a time from Haze's default array
        // capacity, doubling and recopying their entire contents on every
        // regrowth -- the exact "repeated allocation of a large block"
        // pattern hzstd_profiling.c's own comments identify as a confirmed
        // memory/GC-pressure source, avoidable entirely when the final size
        // is already known.
        mut fn reserveSamples(count: int): void {
            this.samples.reserve(count);
            this.timeDeltas.reserve(count);
        }

        // Raw linear-probing insert into `table`, growing+rehashing first if
        // the table's gotten too full. `childArrayIndex` is an index into
        // nodes[parent].children (not a node id). Assumes `frame` is not
        // already present -- findOrCreateChild only calls this right after
        // confirming a lookup miss, and rehashing only ever reinserts keys
        // already known to be distinct.
        mut fn insertChild(parent: int, hash: int, childArrayIndex: int): void {
            let table = this.childTables[parent];
            let children = this.nodes[parent].children;

            // Keep the load factor under ~70% so probe chains stay short.
            if (table.count + 1) * 10 >= table.buckets.length * 7 {
                let oldBuckets = table.buckets;
                let newCapacity = table.buckets.length * 2;
                let newBuckets: []int = [];
                newBuckets.reserve(newCapacity);
                for (let i = 0; i < newCapacity; i++) {
                    newBuckets.push(0);
                }
                table.buckets = newBuckets;
                for (let i = 0; i < oldBuckets.length; i++) {
                    if oldBuckets[i] != 0 {
                        // oldBuckets[i] is (childArrayIndex + 1); recover that child's own
                        // already-computed hash to re-seat it in the bigger table (its bucket
                        // depends on capacity).
                        let existingHash = this.nodeHashes[children[oldBuckets[i] - 1] - 1];
                        this.probeInsert(table, existingHash, oldBuckets[i]);
                    }
                }
            }
            this.probeInsert(table, hash, childArrayIndex + 1);
            table.count += 1;
        }

        // Bucket-array insert shared by insertChild's fresh-key path and
        // its rehash path. `bucketValue` is already in the "+1" encoding
        // (0 means empty).
        fn probeInsert(table: ChildTable, hash: int, bucketValue: int): void {
            let capacity = table.buckets.length;
            let slot = hash % capacity;
            while table.buckets[slot] != 0 {
                slot = (slot + 1) % capacity;
            }
            table.buckets[slot] = bucketValue;
        }

        // Finds (or creates) a child of nodes[parent] identified by `frame`, returning its index
        // into `nodes`. `hash` must be hashFrameRef(frame) -- passed in rather than recomputed
        // here since the caller (addSample) already needs it to pick the initial bucket anyway,
        // no reason to hash twice. Every field access here (hashing, `==` comparison,
        // `callFrame` construction) works directly off FrameRef's own str/int fields -- nothing
        // is ever formatted into a combined string first, which used to be built unconditionally
        // on every single call and was the actual bottleneck at real profiling-session call
        // volumes (confirmed live via gdb: every such allocation was a GC_malloc candidate to
        // trigger a full Boehm collection).
        mut fn findOrCreateChild(parent: int, hash: int, frame: FrameRef, callFrame: CpuProfileCallFrame): int {
            let table = this.childTables[parent];
            let children = this.nodes[parent].children;
            let capacity = table.buckets.length;
            let slot = hash % capacity;
            let childNode = -1;

            // Linear probe: a hash collision only means "keep probing", the
            // actual identity check is still the real FrameRef `==` below,
            // so this can never return a wrong match.
            let probed = 0;
            while probed < capacity && table.buckets[slot] != 0 {
                let candidate = children[table.buckets[slot] - 1] - 1; // node id -> array index
                if this.nodeFrameRefs[candidate] == frame {
                    childNode = candidate;
                    break;
                }
                slot = (slot + 1) % capacity;
                probed += 1;
            }

            if childNode == -1 {
                let newId = this.nodes.length + 1;
                this.nodes.push(CpuProfileNode {
                    id: newId,
                    callFrame: callFrame,
                    hitCount: 0,
                    children: [],
                });
                this.nodeFrameRefs.push(frame);
                this.nodeHashes.push(hash);
                this.childTables.push(ChildTable());
                let childArrayIndex = this.nodes[parent].children.length;
                this.nodes[parent].children.push(newId);
                this.insertChild(parent, hash, childArrayIndex);
                childNode = newId - 1;
            }

            return childNode;
        }

        // Records one sample: the JS stack (outermost-first) that was
        // executing at `timestampUs`. `truncated` marks that the real call
        // chain continued above `frames` but wasn't captured -- inserted as
        // an extra synthetic ancestor so a flamegraph reads this as
        // "execution really did continue further here, we just don't know
        // what it was" instead of silently looking like a shallower call
        // than it actually was.
        mut fn addSample(timestampUs: real, frames: []FrameRef, truncated: bool = false): void {
            if this.sampleCount == 0 {
                this.startTimeUs = timestampUs;
                this.timeDeltas.push(0);
            } else {
                this.timeDeltas.push((timestampUs - this.lastTimeUs) as int);
            }
            this.lastTimeUs = timestampUs;
            this.sampleCount += 1;

            let currentNode = 0; // index into `nodes`; 0 is the root

            if truncated {
                currentNode = this.findOrCreateChild(
                    currentNode,
                    hashFrameRef(truncatedFrameRef),
                    truncatedFrameRef,
                    CpuProfileCallFrame {
                        functionName: "(truncated -- call stack exceeded capture size)",
                        scriptId: "0", url: "", lineNumber: -1, columnNumber: -1,
                    },
                );
            }

            // `frames` is outermost-first; the call tree is built the same way.
            for (let i = 0; i < frames.length; i++) {
                let frame = frames[i];
                currentNode = this.findOrCreateChild(currentNode, hashFrameRef(frame), frame, cpuProfileCallFrame(frame));
            }

            this.nodes[currentNode].hitCount += 1;
            this.samples.push(this.nodes[currentNode].id);
        }

        // Records a sample known to have real code running (a hard fact
        // from the kernel, e.g. PERF_RECORD_LOST -- not an inference from
        // timing like an off-cpu gap), but whose actual stack wasn't
        // captured. Takes an explicit duration in addition to the marker's
        // own point-in-time timestamp, since -- unlike a real sample --
        // there is no "next sample" for the timeline reconstruction to
        // infer this marker's own visual width from.
        mut fn addLostSamplesMarker(timestampUs: real, durationUs: real): void {
            if this.sampleCount == 0 {
                this.startTimeUs = timestampUs;
                this.timeDeltas.push(0);
            } else {
                this.timeDeltas.push((timestampUs - this.lastTimeUs) as int);
            }
            this.sampleCount += 1;

            let lostNode = this.findOrCreateChild(
                0,
                hashFrameRef(lostSamplesFrameRef),
                lostSamplesFrameRef,
                CpuProfileCallFrame {
                    functionName: "(samples lost -- kernel ring buffer overflow, real code ran here but wasn't captured)",
                    scriptId: "0", url: "", lineNumber: -1, columnNumber: -1,
                },
            );
            this.nodes[lostNode].hitCount += 1;
            this.samples.push(this.nodes[lostNode].id);

            // This marker's own visual duration comes from the NEXT
            // timeDelta pushed (timestamp[i+1] - timestamp[i] is what any
            // trace/flamechart viewer treats as sample i's width) -- so it
            // is deliberately not accounted for here; addSample's next call
            // pushes it via `timestampUs - this.lastTimeUs`, and using
            // `timestampUs + durationUs` as that basis (instead of
            // `timestampUs`) is what makes that next delta equal
            // `durationUs` when nothing else has happened in between.
            this.lastTimeUs = timestampUs + durationUs;
        }

        fn build(): CpuProfile {
            return CpuProfile {
                nodes: this.nodes,
                startTime: this.startTimeUs,
                endTime: this.lastTimeUs,
                samples: this.samples,
                timeDeltas: this.timeDeltas,
            };
        }
    }

    export fn cpuProfileToJson(profile: CpuProfile): str {
        return json.stringify<CpuProfile>(profile);
    }

    export fn writeCpuProfile(profile: CpuProfile, path: str) {
        return fs.writeText(path, cpuProfileToJson(profile));
    }

    // ── trace.json wire format ───────────────────────────────────────────────

    export struct TraceMetadata {
        source: str;
        dataOrigin: str;
    }

    export struct Trace {
        metadata: TraceMetadata;
        traceEvents: []TraceEvent;
    }

    export struct Metadata {
        pid: int;
        tid: int;
        ts: real = 0.0;
        ph: str = "M";
        cat: str = "__metadata";
        name: str;

        struct Args {
            name: str;
        }
        args: Args;

        static fn processName(pid: int, tid: int, name: str) {
            return Metadata { pid: pid, tid: tid, name: "process_name", args: { name: name } };
        }

        static fn threadName(pid: int, tid: int, name: str) {
            return Metadata { pid: pid, tid: tid, name: "thread_name", args: { name: name } };
        }
    }

    // The Trace Event Format's documented mechanism for controlling track order within a
    // process's timeline -- lower sort_index sorts first (i.e. higher up) in DevTools'
    // Performance panel -- as an explicit alternative to relying on tid value or thread_name
    // registration order, neither of which actually controlled ordering here (observed: swapping
    // tids so the allocations thread had the lower tid, and registering it first, made no
    // difference -- the "CrRendererMain"-named thread appears to always sort first regardless).
    export struct MetadataSortIndex {
        pid: int;
        tid: int;
        ts: real = 0.0;
        ph: str = "M";
        cat: str = "__metadata";
        name: str = "thread_sort_index";

        struct Args {
            sort_index: int;
        }
        args: Args;

        static fn threadSortIndex(pid: int, tid: int, sortIndex: int) {
            return MetadataSortIndex { pid: pid, tid: tid, args: { sort_index: sortIndex } };
        }
    }

    // A plain complete ("X") duration event, e.g. Chrome's own "RunTask".
    // Real traces never leave a CPU-profiled thread bare between a
    // Profile/ProfileChunk stream and an otherwise-empty track: DevTools'
    // flame chart for the sampled call tree renders as an overlay *within*
    // such task blocks on that thread, not as its own self-sufficient lane
    // -- a thread with zero "X" events was observed to never show a flame
    // chart no matter how correct the Profile/ProfileChunk payload itself
    // was. This is also the anchor event whose start resets the JS call
    // stack DevTools reconstructs (see invariant 1 in the file header).
    export struct TraceEventComplete {
        pid: int;
        tid: int;
        ts: real;
        dur: real;
        ph: str = "X";
        cat: str = "disabled-by-default-devtools.timeline";
        name: str = "RunTask";
    }

    export struct TraceEventProfile {
        pid: int;
        tid: int;
        ts: real;
        ph: str = "P";
        cat: str = "disabled-by-default-v8.cpu_profiler";
        name: str = "Profile";
        id: str;

        struct Args {
            struct Data {
                startTime: real;
                source: str = "Internal";
            }
            data: Data;
        }
        args: Args;
    }

    export struct TraceCpuProfileChunk {
        nodes?: []TraceProfileNode;
        samples: []int;
    }

    export struct TraceEventProfileChunk {
        pid: int;
        tid: int;
        ts: real;
        ph: str = "P";
        cat: str = "disabled-by-default-v8.cpu_profiler";
        name: str = "ProfileChunk";
        id: str;

        struct Args {
            struct Data {
                cpuProfile: TraceCpuProfileChunk;
                timeDeltas: []int;
                source: str = "Internal";
            }
            data: Data;
        }
        args: Args;
    }

    export struct TraceFrame {
        frame: str;
        processId: int;
        url: str;
    }

    // Essential to make stack traces work at all: without this event, the
    // Summary tab always shows raw args JSON instead of a Call Stack panel.
    export struct TraceTracingStartedInBrowser {
        pid: int;
        tid: int;
        ts: real = 0.0;
        ph: str = "I";
        s: str = "t";
        cat: str = "disabled-by-default-devtools.timeline";
        name: str = "TracingStartedInBrowser";

        struct Args {
            struct Data {
                frames: []TraceFrame;
            }
            data: Data;
        }
        args: Args;

        fn constructor(pid: int, tid: int, frame: str, url: str) {
            return TraceTracingStartedInBrowser {
                pid: pid, tid: tid,
                args: { data: { frames: [ { frame: frame, processId: pid, url: url } ] } },
            };
        }
    }

    // A "PerformanceMark"-shaped instant event -- see invariant 2 in the
    // file header for why this exact shape (cat: "blink.user_timing") is
    // required for a custom-named marker to be visible at all, and why its
    // embedded stack trace's line/column numbers must be 1-indexed (unlike
    // every other call frame in this file, DevTools decrements these for
    // us).
    //
    // MUST be args.data.stackTrace, inlined -- confirmed against real Chrome: a `sf` (top-level
    // Trace Event Format field referencing the trace's shared stackFrames dictionary by id) was
    // tried here instead, on the theory that PerformanceMark's stack-on-click behavior would
    // resolve it the same way async/flow events do. It doesn't: DevTools' PerformanceMark
    // handler reads args.data.stackTrace directly and has no knowledge of `sf`/stackFrames at
    // all for this specific event category -- the marker rendered with no source location or
    // stack trace whatsoever, just the bare name. Do not reintroduce `sf` here without a real
    // Chrome trace confirming DevTools actually resolves it for THIS event shape specifically;
    // it clearly doesn't just because it's the documented mechanism in general.
    export struct TraceEventInstantMarker {
        pid: int;
        tid: int;
        ts: real;
        ph: str = "I";
        cat: str = "blink.user_timing";
        name: str;

        struct Args {
            struct Data {
                // TraceMarkerCallFrame, not TraceCallFrame: this array is
                // inlined into every marker and is by far the largest thing
                // in a memory-instrumented trace, so it carries only the
                // fields DevTools actually reads back. See
                // TraceMarkerCallFrame's own comment for the measurements.
                // Optional so a marker with no frames omits the key entirely
                // rather than emitting a useless `"stackTrace":[]` -- see
                // addInstantMarker, and profiling.hz's buildTrace, which
                // deliberately emits stackless markers and keeps the stacks in
                // a deduplicated call tree instead.
                stackTrace?: []TraceMarkerCallFrame;
                // Populated from real allocation instrumentation -- see profiling.hz's
                // buildTrace/allocationMarkerName, fed by hzstd_trace_memory_impl
                // (hzstd_profiling.c) which now receives an allocation's kind/size/static
                // type-name string from the compiler-emitted allocation call sites
                // (HZSTD_ALLOC_STRUCT/HZSTD_DYNAMIC_ARRAY_CREATE) and the runtime allocator
                // plumbing (hzstd_memory.c/hzstd_array.c). Optional/omitted (rather than
                // always-present placeholders) because a small number of internal-only
                // runtime allocations legitimately have no dataType to report.
                dataType?: str;
                sizeBytes?: int;
            }
            data: Data;
        }
        args: Args;
    }

    // json.stringify dumps a union purely by runtime `is Variant` match (no
    // discriminator needed for dump, only for parse), so a heterogeneous
    // JSON Array Format trace can be one flat []TraceEvent serialized in a
    // single json.stringify<Trace> call, no manual string-joining required.
    export type TraceEvent =
        Metadata |
        MetadataSortIndex |
        TraceEventProfile |
        TraceEventProfileChunk |
        TraceTracingStartedInBrowser |
        TraceEventComplete |
        TraceEventInstantMarker;

    // ── TraceBuilder ─────────────────────────────────────────────────────────
    //
    // The public API for assembling a trace.json document. Bakes in both
    // hard-won invariants from the file header so callers can't get them
    // wrong: addTask() and addCpuProfileSamples() together keep a task's
    // Profile.startTime pinned to the task's own start and its first
    // timeDelta tiny; addInstantMarker() always emits the PerformanceMark
    // shape.
    //
    // pid/tid layout mirrors real Chrome traces (one process, several
    // purpose-specific threads/tracks within it) and leaves room to grow --
    // e.g. a future second Haze process (worker/subprocess) would get pid 2
    // rather than requiring these ids to be renumbered.
    export ref struct TraceBuilder {
        pid: int;
        events: []TraceEvent = [];
        nextProfileId: int = 1;

        fn constructor(pid: int = 1) {
            let builder = TraceBuilder { pid: pid };
            // DevTools' modern trace engine classifies processes by this
            // exact reserved name string (confirmed against a real
            // Chrome-recorded trace) to decide whether it's even eligible
            // for JS-profile/flame-chart rendering at all -- an arbitrary
            // process name like "Haze Process" is silently treated as a
            // generic, non-renderer process and nothing in it renders.
            builder.events.push(Metadata.processName(pid, pid, "Renderer"));
            return builder;
        }

        // Callers that know roughly how many events they'll add up front (e.g. profiling.hz,
        // which knows result.memoryInstrumentationFrames.length before calling addInstantMarker
        // that many times) should call this first: otherwise `events` grows one push at a time
        // from Haze's default array capacity, doubling and recopying its entire contents on every
        // regrowth -- see CpuProfileBuilder.reserveSamples for the same fix applied there, for the
        // same reason.
        mut fn reserveEvents(count: int): void {
            this.events.reserve(count);
        }

        // Registers a thread's display name. `mainThread: true` uses
        // Chrome's own main-thread name ("CrRendererMain"), the one
        // DevTools recognizes as the thread eligible to host a JS flame
        // chart (see addCpuProfileSamples); any other thread can be named
        // freely and still renders (as a generic thread track) as long as
        // it has at least one visible event on it.
        //
        // `sortIndex`, if given, emits an explicit thread_sort_index metadata event -- the
        // documented Trace Event Format mechanism for track order within a process (lower sorts
        // first/higher up). Needed because neither tid value nor registration order actually
        // controls track order in DevTools' Performance panel (observed directly: reordering
        // both had no effect) -- the "CrRendererMain"-named thread appears to always render
        // first regardless, so getting another track to sort above it requires this explicit
        // mechanism rather than an implicit ordering convention.
        mut fn addThread(tid: int, name: str, mainThread: bool = false, sortIndex?: int): void {
            this.events.push(Metadata.threadName(this.pid, tid, mainThread ? "CrRendererMain" : name));
            if sortIndex {
                let idx = sortIndex;
                this.events.push(MetadataSortIndex.threadSortIndex(this.pid, tid, idx));
            }
        }

        // A top-level task block on `tid`, e.g. one "run the event loop"
        // iteration. Required to host a JS flame chart on that thread (see
        // file header) and acts as the anchor DevTools nests CPU profile
        // samples under during that [ts, ts+dur) window.
        mut fn addTask(tid: int, ts: real, dur: real, name: str = "RunTask"): void {
            this.events.push(TraceEventComplete { pid: this.pid, tid: tid, ts: ts, dur: dur, name: name });
        }

        // Also emits the TracingStartedInBrowser event a stack trace panel
        // needs to render at all (see that struct's own doc comment) --
        // call this once, before the first addTask/addCpuProfileSamples on
        // whichever thread should own the frame/URL association.
        mut fn addFrame(tid: int, frame: str, url: str): void {
            this.events.push(TraceTracingStartedInBrowser(this.pid, tid, frame, url));
        }

        // Streams a whole already-built CpuProfile onto `tid` as a
        // Profile + chunked ProfileChunk events, anchored to start exactly
        // at `taskTs` (the ts of the addTask call this profile's samples
        // should nest under -- see invariant 1 in the file header). The
        // profile's own first sample timestamp is shifted to
        // `taskTs + 1us` and every other sample's timing preserved
        // relative to that, guaranteeing the ordering invariant holds
        // regardless of what `taskTs` the caller picked.
        mut fn addCpuProfileSamples(tid: int, taskTs: real, profile: CpuProfile): void {
            let id = f"0x{this.nextProfileId}";
            this.nextProfileId += 1;

            this.events.push(TraceEventProfile {
                pid: this.pid, tid: tid, ts: taskTs, id: id,
                args: { data: { startTime: taskTs } },
            });

            let chunks = buildProfileChunks(profile, this.pid, tid, id, taskTs);
            for (let i = 0; i < chunks.length; i++) {
                this.events.push(chunks[i]);
            }
        }

        // A single custom-named, zero-length marker on `tid`, with a full
        // stack trace shown when clicked -- see invariant 2 in the file
        // header. `frames` must be 1-indexed (this is the one place in
        // this API where that's true; every other frame list is the usual
        // FrameRef 1-indexed-in/converted-internally convention -- this
        // one round-trips 1-indexed all the way through because DevTools
        // itself does the decrement for this specific event shape).
        mut fn addInstantMarker(tid: int, ts: real, name: str, frames: []FrameRef, dataType?: str, sizeBytes?: int): void {
            // Stackless markers are the hot case, not an edge case: the memory
            // instrumentation emits one per allocation and deliberately passes no
            // frames at all (see profiling.hz -- the stacks live on the allocation
            // profile's own track instead). Building an empty array to then not
            // emit it costs two GC allocations per marker, which at that call
            // volume is hundreds of thousands of allocations producing nothing.
            if frames.length == 0 {
                this.events.push(TraceEventInstantMarker {
                    pid: this.pid, tid: tid, ts: ts, name: name,
                    args: { data: {
                        stackTrace: none,
                        dataType: dataType,
                        sizeBytes: sizeBytes,
                    } },
                });
                return;
            }
            let callFrames: []TraceMarkerCallFrame = [];
            // Same reasoning as frameRefsForStacktrace (profiling.hz): this is called once per
            // memory-allocation capture, so an unpresized array here regrows from scratch on
            // every single call at exactly the call volume where that becomes very expensive.
            callFrames.reserve(frames.length);
            for (let i = 0; i < frames.length; i++) {
                let frame = frames[i];
                // codeType/scriptId/columnNumber are deliberately not emitted here -- see
                // TraceMarkerCallFrame. They cost ~21% of a real trace's total size and are
                // never read back for this event shape (DevTools' CallFrame type has
                // codeType optional, and every columnNumber this profiler has ever produced
                // was 0, since Haze source locations are line-granular).
                callFrames.push(TraceMarkerCallFrame {
                    functionName: frame.name.length > 0 ? frame.name : "(unknown)",
                    url: frame.url.length > 0 ? frame.url : none,
                    lineNumber: frame.line > 0 ? frame.line : none,
                });
            }
            this.events.push(TraceEventInstantMarker {
                pid: this.pid, tid: tid, ts: ts, name: name,
                args: { data: {
                    // No frames -> omit the key rather than writing an empty
                    // array. At one marker per allocation even 17 bytes of
                    // `"stackTrace":[],` is over a megabyte of nothing.
                    stackTrace: callFrames.length > 0 ? callFrames : none,
                    dataType: dataType,
                    sizeBytes: sizeBytes,
                } },
            });
        }

        fn build(): Trace {
            return Trace {
                metadata: { source: "DevTools", dataOrigin: "TraceEvents" },
                traceEvents: this.events,
            };
        }
    }

    // Real Chrome traces spread the samples of one profile over many
    // ProfileChunk events (~100 samples each) instead of one giant chunk;
    // the node list only needs to appear once, on the first chunk, since
    // node ids are stable/global for the whole profile. A single all-at-once
    // chunk was observed not to render in DevTools, hence the re-chunking
    // here rather than a single TraceEventProfileChunk per profile.
    const chunkSampleCount = 100;

    fn buildProfileChunks(profile: CpuProfile, pid: int, tid: int, id: str, taskTs: real): []TraceEventProfileChunk {
        let traceNodes: []TraceProfileNode = [];
        for (let i = 0; i < profile.nodes.length; i++) {
            let node = profile.nodes[i];
            traceNodes.push(TraceProfileNode {
                id: node.id,
                callFrame: TraceCallFrame {
                    functionName: node.callFrame.functionName,
                    codeType: node.callFrame.url.length > 0 ? "JS" : "other",
                    scriptId: node.callFrame.url.length > 0 ? 1 : 0,
                    url: node.callFrame.url.length > 0 ? node.callFrame.url : none,
                    lineNumber: node.callFrame.lineNumber >= 0 ? node.callFrame.lineNumber : none,
                    columnNumber: node.callFrame.columnNumber >= 0 ? node.callFrame.columnNumber : none,
                },
                parent: none,
            });
        }
        // node.children walks parent -> children; invert it into child ->
        // parent, the shape the trace format wants, once, over the
        // already-deduplicated node list above.
        for (let i = 0; i < profile.nodes.length; i++) {
            let node = profile.nodes[i];
            for (let c = 0; c < node.children.length; c++) {
                let childId = node.children[c];
                traceNodes[childId - 1].parent = node.id;
            }
        }

        let chunks: []TraceEventProfileChunk = [];
        let offset = 0;
        // Anchor the first sample to taskTs + 1us (see invariant 1 in the
        // file header) and preserve every other sample's timing relative
        // to that, regardless of what profile.startTime originally was.
        let chunkTs = taskTs;
        let firstDeltaShifted = false;
        while offset < profile.samples.length {
            let count = profile.samples.length - offset < chunkSampleCount ? profile.samples.length - offset : chunkSampleCount;
            let chunkSamples: []int = [];
            let chunkDeltas: []int = [];
            for (let i = offset; i < offset + count; i++) {
                let delta = profile.timeDeltas[i];
                if !firstDeltaShifted {
                    delta = 1;
                    firstDeltaShifted = true;
                }
                chunkSamples.push(profile.samples[i]);
                chunkDeltas.push(delta);
            }

            chunks.push(TraceEventProfileChunk {
                pid: pid, tid: tid, ts: chunkTs, id: id,
                args: {
                    data: {
                        cpuProfile: { nodes: offset == 0 ? traceNodes : none, samples: chunkSamples },
                        timeDeltas: chunkDeltas,
                    },
                },
            });

            for (let i = 0; i < chunkDeltas.length; i++) {
                chunkTs += chunkDeltas[i] as real;
            }
            offset += count;
        }
        return chunks;
    }

    // How many events share one encoding arena before it is dropped for a fresh
    // one (see json.stringify's allocator overload for why per-event arenas are
    // expensive: each one commits a 64 KiB chunk no matter how small the event).
    //
    // The win saturates as soon as a batch's encoded bytes comfortably exceed one
    // chunk -- past that, chunks are being filled rather than wasted, and a larger
    // batch buys nothing but a higher peak. A few hundred events is already well
    // past that point for any event shape this format produces, while keeping the
    // live arena to roughly one megabyte.
    const eventsPerEncodingArena = 256;

    // Progress reporting cadence for writeTrace's per-event loop -- time-based so the output
    // rate is independent of trace size, with a cheap index test keeping the clock read off
    // the innermost path.
    const writeProgressIntervalSeconds = 0.1;
    const writeProgressCheckInterval = 4096;

    // json.stringify<Trace>(trace) (the obvious implementation) builds ONE json.Node DOM tree
    // for the entire `traceEvents` array before printing any of it -- on a session with
    // hundreds of thousands of memory-allocation markers, that means hundreds of thousands of
    // TraceEventInstantMarker DOM subtrees (each itself a handful of nested cJSON node objects,
    // one per field) are all simultaneously live in memory at once. Measured directly (attaching
    // gdb to a live run under a synthetic stress workload): this is where the real time goes --
    // tens of seconds to multiple minutes of Boehm GC fighting to keep up with an enormous
    // number of small live objects, not `hzstd_profiling_end` (fast) and not buildTrace's own
    // FrameRef construction (fixed separately, see reserve() calls above/in profiling.hz).
    //
    // This serializes `traceEvents` one element at a time instead: each element's DOM tree is
    // built, printed to its own short JSON string via the same, already-correct
    // json.stringify<TraceEvent> (so escaping/formatting is guaranteed identical to before --
    // nothing here reimplements JSON encoding), and then genuinely discarded before the next
    // element's DOM is built, rather than every element's DOM coexisting for the whole array.
    // The output text is byte-for-byte identical to json.stringify<Trace>(trace) -- this is
    // purely a "how", not a "what", change.
    export fn traceToJson(trace: Trace): str {
        let out = String();
        out.append("{\"metadata\":");
        out.append(json.stringify<TraceMetadata>(trace.metadata));
        out.append(",\"traceEvents\":[");
        let arena = Alloc.arena();
        for (let i = 0; i < trace.traceEvents.length; i++) {
            if i > 0 {
                out.append(",");
            }
            if i > 0 && i % eventsPerEncodingArena == 0 {
                // Previous batch's nodes and printed strings are all dead by now
                // (append copies into `out`), so let the whole arena go at once.
                arena = Alloc.arena();
            }
            out.append(json.stringify<TraceEvent>(arena, trace.traceEvents[i]));
        }
        out.append("]}");
        out.commit();
        return out.string();
    }

    // Writes the trace straight to disk, one event at a time.
    //
    // traceToJson above has to build the ENTIRE file as a single string first,
    // which for a real profiling session is the largest allocation the process
    // ever makes -- and it is live simultaneously with the event array it was
    // built from and with each event's intermediate JSON DOM. On a big capture
    // that combination is what pushed writing a trace into many gigabytes of
    // RAM, on top of a String that has to keep doubling and copying itself as
    // it grows.
    //
    // Streaming removes the largest of those: at no point does more than one
    // event's worth of JSON plus a bounded output buffer exist. Same bytes,
    // same order, same file -- only the peak memory differs.
    export fn writeTrace(trace: Trace, path: str): fs.Error {
        let opened = fs.openWrite(path);
        if opened is fs.Error {
            return opened;
        }
        let w = opened;

        w.write("{\"metadata\":");
        w.write(json.stringify<TraceMetadata>(trace.metadata));
        w.write(",\"traceEvents\":[");
        let arena = Alloc.arena();
        // Same time-throttled reporting as profiling.hz's build loops, for the same reason:
        // serializing a large trace is a multi-second stretch with nothing to show for it
        // otherwise, and a print per event would cost more than the encoding does.
        let lastProgressAt = time.now();
        for (let i = 0; i < trace.traceEvents.length; i++) {
            if i > 0 {
                w.write(",");
            }
            if i % writeProgressCheckInterval == 0 {
                let nowSeconds = time.now();
                if nowSeconds - lastProgressAt >= writeProgressIntervalSeconds {
                    fmt.print(f"\r  writing trace: {i} / {trace.traceEvents.length} events");
                    lastProgressAt = nowSeconds;
                }
            }
            if i > 0 && i % eventsPerEncodingArena == 0 {
                // Safe to drop the whole previous batch here: w.write has
                // already copied every string it produced into the writer's own
                // pending buffer (see fs.FileWriter.write), so nothing encoded
                // into that arena is still referenced.
                arena = Alloc.arena();
            }
            // Each event's DOM is built, printed, and dropped before the next
            // one starts -- the same one-at-a-time discipline traceToJson
            // already used, except the printed text now goes to the file
            // instead of accumulating in a string.
            w.write(json.stringify<TraceEvent>(arena, trace.traceEvents[i]));
        }
        fmt.print(f"\r  writing trace: {trace.traceEvents.length} / {trace.traceEvents.length} events\n");
        w.write("]}");

        return w.close();
    }

    // ── Throwaway smoke test ─────────────────────────────────────────────────
    //
    // Exercises the public API end to end (not a real profiling adapter --
    // see profiling.hz for that). Kept around as a quick manual sanity
    // check; not part of the public API.
    export fn exportTrace() {
        const comptime PID = 1;
        const comptime MAIN_TID = 1;
        const comptime MEM_TID = 2;

        let builder = TraceBuilder(PID);
        builder.addThread(MAIN_TID, "CrRendererMain", true);
        builder.addThread(MEM_TID, "MemoryAllocation");
        builder.addFrame(MAIN_TID, "FRAME1", "file:///tmp/example.hz");

        const comptime taskTs = 20000.0;
        builder.addTask(MAIN_TID, taskTs, 100000.0);

        let profile = CpuProfileBuilder();
        profile.addSample(taskTs, [FrameRef { name: "foo", url: "/tmp/example.hz", line: 10, column: 4 }]);
        profile.addSample(taskTs + 10000.0, [FrameRef { name: "foo", url: "/tmp/example.hz", line: 10, column: 4 }]);
        profile.addSample(taskTs + 20000.0, [
            FrameRef { name: "foo", url: "/tmp/example.hz", line: 10, column: 4 },
            FrameRef { name: "bar", url: "/tmp/example.hz", line: 20, column: 4 },
        ]);
        profile.addSample(taskTs + 30000.0, [
            FrameRef { name: "foo", url: "/tmp/example.hz", line: 10, column: 4 },
            FrameRef { name: "bar", url: "/tmp/example.hz", line: 20, column: 4 },
        ]);
        builder.addCpuProfileSamples(MAIN_TID, taskTs, profile.build());

        builder.addInstantMarker(MEM_TID, taskTs + 5000.0, "ALLOCATE example_t (32 bytes)", [
            FrameRef { name: "bar", url: "/tmp/example.hz", line: 20, column: 5 },
            FrameRef { name: "foo", url: "/tmp/example.hz", line: 10, column: 5 },
        ]);

        let _ = writeTrace(builder.build(), "trace.json");
        fmt.println("File written");
    }
}
