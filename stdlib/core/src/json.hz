
namespace ffi {
    export extern C noemit ref struct hzstd_json_node_t {};

    export extern C noemit struct hzstd_json_parse_result_t {
        node: hzstd_json_node_t | none;
        error: str;
    };

    export extern C noemit struct hzstd_json_get_string_result_t {
        found: bool;
        value: str;
    };

    export extern C fn hzstd_json_parse(allocator: Allocator, data: str): hzstd_json_parse_result_t :: final;
    export extern C fn hzstd_json_create_string(allocator: Allocator, data: str): hzstd_json_node_t :: final;
    export extern C fn hzstd_json_create_number(allocator: Allocator, data: real): hzstd_json_node_t :: final;
    export extern C fn hzstd_json_create_bool(allocator: Allocator, data: bool): hzstd_json_node_t :: final;
    export extern C fn hzstd_json_create_object(allocator: Allocator): hzstd_json_node_t :: final;
    export extern C fn hzstd_json_create_array(allocator: Allocator): hzstd_json_node_t :: final;
    export extern C fn hzstd_json_create_null(allocator: Allocator): hzstd_json_node_t :: final;

    export extern C fn hzstd_json_object_has_attribute(json: hzstd_json_node_t, name: str): bool :: final;
    export extern C fn hzstd_json_is_string(json: hzstd_json_node_t): bool :: final;
    export extern C fn hzstd_json_is_object(json: hzstd_json_node_t): bool :: final;
    export extern C fn hzstd_json_is_bool(json: hzstd_json_node_t): bool :: final;
    export extern C fn hzstd_json_is_true(json: hzstd_json_node_t): bool :: final;
    export extern C fn hzstd_json_is_false(json: hzstd_json_node_t): bool :: final;
    export extern C fn hzstd_json_is_number(json: hzstd_json_node_t): bool :: final;
    export extern C fn hzstd_json_is_array(json: hzstd_json_node_t): bool :: final;
    export extern C fn hzstd_json_is_null(json: hzstd_json_node_t): bool :: final;

    export extern C fn hzstd_json_get_string_value(allocator: Allocator, json: hzstd_json_node_t): hzstd_json_get_string_result_t :: final;
    export extern C fn hzstd_json_get_number_value(allocator: Allocator, json: hzstd_json_node_t): real :: final;

    export extern C fn hzstd_json_get_object_item(allocator: Allocator, json: hzstd_json_node_t, name: str): hzstd_json_node_t | none :: final;
    export extern C fn hzstd_json_get_array_size(allocator: Allocator, json: hzstd_json_node_t): usize :: final;
    export extern C fn hzstd_json_get_array_item(allocator: Allocator, json: hzstd_json_node_t, index: usize): hzstd_json_node_t :: final;
    // O(1) per step, unlike indexing -- see hzstd_json.h.
    export extern C fn hzstd_json_get_first_child(json: hzstd_json_node_t): hzstd_json_node_t | none :: final;
    export extern C fn hzstd_json_get_next_sibling(json: hzstd_json_node_t): hzstd_json_node_t | none :: final;

    // Object-key enumeration: unlike hzstd_json_get_object_item(), which
    // requires already knowing the key you want, these walk every key of an
    // object whose key set isn't known ahead of time (e.g. LinearMap<K, V>'s
    // json.parse hook, containers.hz).
    export extern C fn hzstd_json_get_object_size(allocator: Allocator, json: hzstd_json_node_t): usize :: final;
    export extern C fn hzstd_json_get_object_key_at(allocator: Allocator, json: hzstd_json_node_t, index: usize): hzstd_json_get_string_result_t :: final;
    export extern C fn hzstd_json_get_object_value_at(allocator: Allocator, json: hzstd_json_node_t, index: usize): hzstd_json_node_t :: final;

    export extern C fn hzstd_json_add_item_to_object(allocator: Allocator, object: hzstd_json_node_t, name: str, item: hzstd_json_node_t): bool :: final;
    export extern C fn hzstd_json_add_item_to_array(allocator: Allocator, object: hzstd_json_node_t, item: hzstd_json_node_t): bool :: final;

    export extern C fn hzstd_json_print_unformatted(allocator: Allocator, json: hzstd_json_node_t): str :: final;
    export extern C fn hzstd_json_print(allocator: Allocator, json: hzstd_json_node_t): str :: final;
}

namespace json {
    export ref struct Error {
        error: () => str;
    };

    export ref struct Node {
        allocator: Allocator;
        data: ffi.hzstd_json_node_t;

        ref struct Proxy {
            json: Node;
            attribute: str | int;

            fn to<T>() {
                let attr = this.attribute;
                if attr is str {
                    let obj = ffi.hzstd_json_get_object_item(this.json.allocator, this.json.data, attr);
                    if !obj { sys.panic("JSON object does not have attribute"); }
                    if comptime T is str {
                        let value = ffi.hzstd_json_get_string_value(this.json.allocator, obj);
                        if value.found { return value.value; }
                        sys.panic("JSON value is not of type String");
                    }
                    else if comptime T is real {
                        return ffi.hzstd_json_get_number_value(this.json.allocator, obj);
                    }
                    else if comptime T is int {
                        return ffi.hzstd_json_get_number_value(this.json.allocator, obj) as int;
                    }
                    else if comptime T is bool {
                        return ffi.hzstd_json_is_true(obj);
                    }
                    else {
                        static_assert(false, f"to<T>: unsupported type '{T.prettyName}' — use chained [] for objects/arrays");
                    }
                }
                else {
                    sys.panic("to<T>() is not supported for integer-indexed proxies");
                }
            }

            fn operator[](index: str): Result<Proxy, Error> {
                // String access to a proxy, so the parent must be an object
                let attr = this.attribute;
                if attr is str {
                    if ffi.hzstd_json_object_has_attribute(this.json.data, attr) {
                        let obj = ffi.hzstd_json_get_object_item(this.json.allocator, this.json.data, attr);
                        if obj {
                            if !ffi.hzstd_json_is_object(obj) {
                                sys.panic("JSON was expected to be an object");
                            }
                            return Result<Proxy, Error>.Ok({ json: { allocator: this.json.allocator, data: obj }, attribute: index });
                        }
                        sys.panic("JSON object does not have attribute");
                    }
                    else {
                        // Does not exist yet, create
                        let newObj = ffi.hzstd_json_create_object(this.json.allocator);
                        ffi.hzstd_json_add_item_to_object(this.json.allocator, this.json.data, attr, newObj);
                        return Result<Proxy, Error>.Ok({ json: { allocator: this.json.allocator, data: newObj }, attribute: index });
                    }
                }
                else {
                    sys.panic("chained [] on integer-indexed proxy not supported");
                }
            }

            fn operator:=(value: str): void {
                let attr = this.attribute;
                if attr is str {
                    let item = ffi.hzstd_json_create_string(this.json.allocator, value);
                    let success = ffi.hzstd_json_add_item_to_object(this.json.allocator, this.json.data, attr, item);
                    assert(success);
                }
                else {
                    sys.panic("operator:=(str) not supported for integer-indexed proxies");
                }
            }

            fn operator:=(value: real): void {
                let attr = this.attribute;
                if attr is str {
                    let item = ffi.hzstd_json_create_number(this.json.allocator, value);
                    let success = ffi.hzstd_json_add_item_to_object(this.json.allocator, this.json.data, attr, item);
                    assert(success);
                }
                else {
                    sys.panic("operator:=(real) not supported for integer-indexed proxies");
                }
            }

            fn operator:=(value: Node): void {
                let attr = this.attribute;
                if attr is str {
                    let success = ffi.hzstd_json_add_item_to_object(this.json.allocator, this.json.data, attr, value.data);
                    assert(success);
                }
                else {
                    sys.panic("operator:=(Value) not supported for integer-indexed proxies");
                }
            }

            fn push(value: Node): void {
                let attr = this.attribute;
                if attr is str {
                    if ffi.hzstd_json_object_has_attribute(this.json.data, attr) {
                        let obj = ffi.hzstd_json_get_object_item(this.json.allocator, this.json.data, attr);
                        if obj {
                            assert(ffi.hzstd_json_is_array(obj));
                            ffi.hzstd_json_add_item_to_array(this.json.allocator, obj, value.data);
                            return;
                        }
                        sys.panic("JSON object does not have attribute");
                    }
                    else {
                        sys.panic("JSON attribute to push into does not exist");
                    }
                }
                else {
                    sys.panic("push() not supported for integer-indexed proxies");
                }
            }
        }

        ref fn operator[](index: int): Result<Proxy, Error> {
            return Result<Proxy, Error>.Ok({
                json: this,
                attribute: index,
            });
        }

        ref fn operator[](index: str): Result<Proxy, Error> {
            return Result<Proxy, Error>.Ok({
                json: this,
                attribute: index,
            });
        }

        ref struct PrintOptions {
            pretty: bool = false;
        }

        fn print(options: PrintOptions) {
            if (options.pretty) {
                return ffi.hzstd_json_print(this.allocator, this.data);
            }
            else {
                return ffi.hzstd_json_print_unformatted(this.allocator, this.data);
            }
        }

        // Object-key enumeration for consumers that need to walk every key of
        // an object whose key set isn't known ahead of time (unlike
        // operator[](str), which requires already knowing the key). Used by
        // LinearMap<K, V>'s [[json.parse]] hook (containers.hz) to rebuild a
        // map from an arbitrary {"key": value, ...} object. Panics if called
        // on a non-object node, same as the rest of this API (see e.g.
        // Proxy.operator[](str)'s "JSON was expected to be an object").
        fn objectEntryCount(): usize {
            if !ffi.hzstd_json_is_object(this.data) {
                sys.panic("objectEntryCount() called on a JSON node that is not an object");
            }
            return ffi.hzstd_json_get_object_size(this.allocator, this.data);
        }

        fn objectKeyAt(index: usize): str {
            if !ffi.hzstd_json_is_object(this.data) {
                sys.panic("objectKeyAt() called on a JSON node that is not an object");
            }
            let key = ffi.hzstd_json_get_object_key_at(this.allocator, this.data, index);
            if key.found { return key.value; }
            sys.panic("objectKeyAt(): index out of range or entry has no key");
        }

        fn objectValueAt(index: usize): Node {
            if !ffi.hzstd_json_is_object(this.data) {
                sys.panic("objectValueAt() called on a JSON node that is not an object");
            }
            return Node {
                allocator: this.allocator,
                data: ffi.hzstd_json_get_object_value_at(this.allocator, this.data, index),
            };
        }

        // Arrays and numbers, the same way: for a [[json.parse]] or
        // [[json.serialize]] hook that keeps an array as something other than
        // a Haze array of the same shape -- say [[x, y], ...] as one flat
        // []Vec2. Reading panics on a node of another kind, like the rest of
        // this API; isArray()/isNumber() check first.
        fn isArray(): bool {
            return ffi.hzstd_json_is_array(this.data);
        }

        fn isNumber(): bool {
            return ffi.hzstd_json_is_number(this.data);
        }

        fn arrayLength(): usize {
            if !ffi.hzstd_json_is_array(this.data) {
                sys.panic("arrayLength() called on a JSON node that is not an array");
            }
            return ffi.hzstd_json_get_array_size(this.allocator, this.data);
        }

        // The first element of an array node (none if it is empty), then
        // each element's next() until none -- the way to walk an array: its
        // elements are a linked list, so indexing one is O(index).
        fn firstElement(): Node | none {
            if !ffi.hzstd_json_is_array(this.data) {
                sys.panic("firstElement() called on a JSON node that is not an array");
            }
            if let child = ffi.hzstd_json_get_first_child(this.data) {
                return Node { allocator: this.allocator, data: child };
            }
            return none;
        }

        fn next(): Node | none {
            if let sibling = ffi.hzstd_json_get_next_sibling(this.data) {
                return Node { allocator: this.allocator, data: sibling };
            }
            return none;
        }

        fn numberValue(): real {
            if !ffi.hzstd_json_is_number(this.data) {
                sys.panic("numberValue() called on a JSON node that is not a number");
            }
            return ffi.hzstd_json_get_number_value(this.allocator, this.data);
        }

        // Appends to an array node.
        fn append(item: Node) {
            if !ffi.hzstd_json_is_array(this.data) {
                sys.panic("append() called on a JSON node that is not an array");
            }
            ffi.hzstd_json_add_item_to_array(this.allocator, this.data, item.data);
        }

        fn appendNumber(value: real) {
            this.append(Node { allocator: this.allocator, data: ffi.hzstd_json_create_number(this.allocator, value) });
        }

        // A new, empty array node from this node's allocator -- to append to
        // this one.
        fn newArray(): Node {
            return Node { allocator: this.allocator, data: ffi.hzstd_json_create_array(this.allocator) };
        }

    }

    export fn parseToJsonNode(data: str): Result<Node, Error> {
        return parseToJsonNode(Alloc.arena(), data);
    }

    export fn parseToJsonNode(allocator: Allocator, data: str): Result<Node, Error> {
        let result = ffi.hzstd_json_parse(allocator, data);
        if result.node {
            return Result<Node, Error>.Ok({
                allocator: allocator,
                data: result.node,
            } with allocator);
        }
        return Result<Node, Error>.Err({ error: () => result.error });
    }

    export fn object(): Node {
        let allocator = Alloc.arena();
        let obj = ffi.hzstd_json_create_object(allocator);
        return { allocator: allocator, data: obj };
    }

    export fn array(): Node {
        let allocator = Alloc.arena();
        let obj = ffi.hzstd_json_create_array(allocator);
        return { allocator: allocator, data: obj };
    }

    export fn parseJsonArray<T>(allocator: Allocator, node: ffi.hzstd_json_node_t): Result<T, Error> {
        if !ffi.hzstd_json_is_array(node) {
            return Error { error: () => "JSON type mismatch: expected array" };
        }
        let arr: T = [];
        let count = ffi.hzstd_json_get_array_size(allocator, node);
        if count <= 1000000000 {
            arr.reserve(count as int);
        }
        // Walked as the linked list it is: indexing it is O(index), which
        // made every array O(n^2) to read.
        let item = ffi.hzstd_json_get_first_child(node);
        while let current = item {
            let r = parseJsonNodeFromFfi<T.elementType>(allocator, current);
            if !r {
                return r;
            }
            arr.push(r);
            item = ffi.hzstd_json_get_next_sibling(current);
        }
        return arr;
    }

    export fn parseJsonFixedArray<T>(allocator: Allocator, node: ffi.hzstd_json_node_t): Result<T, Error> {
        if !ffi.hzstd_json_is_array(node) { 
            return Error { error: () => "JSON type mismatch: expected array" };
        }
        let actual = ffi.hzstd_json_get_array_size(allocator, node) as usize;
        if actual != T.length as usize { 
            return Error { error: () => f"JSON fixed array length mismatch: expected {T.length}, got {actual}" };
        }
        do unsafe {
            let arr: T = uninitialized;
            __c__("memset(&arr, 0, sizeof(arr));");
            for (let i: usize = 0; i < T.length as usize; i++) {
                let r = parseJsonNodeFromFfi<T.elementType>(allocator, ffi.hzstd_json_get_array_item(allocator, node, i));
                if !r {
                    return r;
                }
                arr[i] = r;
            }
            return arr;
        };
    }

    export fn parseJsonStruct<T>(allocator: Allocator, node: ffi.hzstd_json_node_t): Result<T, Error> {
        if !ffi.hzstd_json_is_object(node) { 
            return Error { error: () => "JSON type mismatch: expected object" };
        }
        do unsafe {
            let result: T = uninitialized;
            if comptime T.isValue {
                // If T is an inline struct, just leave it uninitialized, the loop will later assign each field
            }
            else {
                __c__(f"result = hzstd_allocate(allocator, sizeof(*result), \"JSON {T.prettyName}\"); memset(result, 0, sizeof(*result));");
            }
            for comptime field in T.fields {
                const comptime fieldName = field.name;

                // A [[json.ignore]] field is never read -- not even when the
                // key is there, as it is in a file written before the field
                // was ignored -- and is filled the way an absent key is
                // below: its declared default, else none. Decided at compile
                // time, so its type is never instantiated for parsing, and a
                // field with nothing to fill it with is a compile error
                // rather than a struct handed back with garbage in it.
                if comptime T.hasFieldAttribute(fieldName, "json.ignore") {
                    if comptime T.hasFieldDefault(fieldName) {
                        result.[fieldName] = T.fieldDefault(fieldName);
                    }
                    else {
                        static_assert(T[fieldName].hasVariant<none>(), f"json.parse(): field '{fieldName}' of {T.prettyName} is [[json.ignore]], so it is never read, but it has no default value and does not accept none -- nothing to fill it with. Give it a default value.");
                        result.[fieldName] = none;
                    }
                }
                else {
                    let child = ffi.hzstd_json_get_object_item(allocator, node, fieldName);

                    // An absent key takes the field's declared default -- the
                    // value a struct literal that omits the field gets, so
                    // `expanded: []str = [];` reads as "absent means empty",
                    // exactly as it does in code. Failing it instead used to
                    // reject the WHOLE object, so every input written before a
                    // field existed (a cache file, a config, a theme) stopped
                    // parsing the moment the field was added.
                    //
                    // Without a default, a field that allows none is set to it,
                    // and any other field is required.
                    let absentHandled = false;
                    if !child {
                        if comptime T.hasFieldDefault(fieldName) {
                            absentHandled = true;
                            result.[fieldName] = T.fieldDefault(fieldName);
                        }
                        else if comptime T[fieldName].category == meta.TypeCategory.Union {
                            for comptime Variant in T[fieldName].variants {
                                if comptime Variant is none {
                                    absentHandled = true;
                                    result.[fieldName] = none;
                                }
                            }
                        }
                    }

                    if !absentHandled {
                        if !child {
                            return Error { error: () => f"JSON missing field: {fieldName}" };
                        }
                        let r = parseJsonNodeFromFfi<typeof(result.[fieldName])>(allocator, child);
                        if !r {
                            return r;
                        }
                        result.[fieldName] = r;
                    }
                }
            }
            return result;
        };
    }

    // `:: final`, like dumpJsonNode: every nested value is parsed through
    // here, so a type that contains itself (a tree, a linked list, a
    // discriminated union with a variant holding more of the union) calls it
    // again while it is still being elaborated -- which the compiler only
    // allows for a function whose signature is final.
    export fn parseJsonNodeFromFfi<T>(allocator: Allocator, node: ffi.hzstd_json_node_t): Result<T, Error> :: final {
        if comptime T.category == meta.TypeCategory.Literal {
            if comptime T.baseType is str {
                let resultValue = parseJsonNodeFromFfi<str>(allocator, node);
                if !resultValue { return resultValue; }
                if resultValue == T.literalValue {
                    return Result<T, Error>.Ok(T.literalValue);
                }
                return Error { error: () => f"""JSON type mismatch: Expected string literal "{T.literalValue}", but received "{resultValue}" """ };
            }
            else if comptime T.baseType is int {
                let resultValue = parseJsonNodeFromFfi<int>(allocator, node);
                if !resultValue { return resultValue; }
                if resultValue == T.literalValue {
                    return Result<T, Error>.Ok(T.literalValue);
                }
                return Error { error: () => f"""JSON type mismatch: Expected string literal "{T.literalValue}", but received "{resultValue}" """ };
            }
            else {
                static_assert(false, f"json.parse() only supports comptime literals that are str or int");
            }
        }
        else if comptime T.category == meta.TypeCategory.Reactive && rx.UnwrapReactive<T>.category == meta.TypeCategory.DynamicArray {
            // A deep reactive array: parsed as the plain array of its values,
            // then made reactive exactly as rx.reactive<[]E>(values) would --
            // one cell per element. (Its held value is typed []Reactive<E>,
            // which is why E is unwrapped from the element type.)
            type Element = rx.UnwrapReactive<rx.UnwrapReactive<T>.elementType>;
            let values = parseJsonNodeFromFfi<[]Element>(allocator, node);
            if !values {
                return values;
            }
            return rx.reactive<[]Element>(values);
        }
        else if comptime T.category == meta.TypeCategory.Reactive || T.category == meta.TypeCategory.ShallowReactive {
            // Any other reactive field: its plain value, made reactive the
            // way code would make it (the mirror of dumpJsonNode, which reads
            // through the reactive to write the value).
            let value = parseJsonNodeFromFfi<rx.UnwrapReactive<T>>(allocator, node);
            if !value {
                return value;
            }
            // By type, not category: a shallow reactive of a primitive reports
            // the Reactive category, but only rx.shallowReactive builds it.
            if comptime T is rx.ShallowReactive<rx.UnwrapReactive<T>> {
                return rx.shallowReactive<rx.UnwrapReactive<T>>(value);
            }
            else {
                return rx.reactive<rx.UnwrapReactive<T>>(value);
            }
        }
        else if comptime T is Node {
            return Node {
                allocator: allocator,
                data: node,
            };
        }
        else if comptime T is none {
            return none;
        }
        else if comptime T is str {
            if !ffi.hzstd_json_is_string(node) { 
                return Error { error: () => "JSON type mismatch: expected string" };
            }
            let value = ffi.hzstd_json_get_string_value(allocator, node);
            if value.found { return value.value; }
            return Error { error: () => "JSON: failed to read string value" };
        }
        else if comptime T is int {
            if !ffi.hzstd_json_is_number(node) {
                return Error { error: () => "JSON type mismatch: expected number (int)" };
            }
            return ffi.hzstd_json_get_number_value(allocator, node) as int;
        }
        else if comptime T is i8 || T is i16 || T is i32 || T is i64
              || T is u8 || T is u16 || T is u32 || T is u64 || T is usize {
            // Every fixed-width integer type shares the same shape: read the
            // JSON number as a double (the only numeric representation
            // hzstd_json_node_t has), range-check against T's own min/max
            // (T.min/T.max are compiler-provided for every integer type, see
            // Elaborate.ts elaboratePrimitiveDatatypeMemberAccess), then cast
            // down. The range check compares as `real`, not `int`: u64.max
            // (2^64-1) does not fit in a signed 64-bit int and would wrap
            // around if cast there first. Values beyond a double's exact
            // integer range (+-2^53) can already lose precision coming out
            // of hzstd_json_get_number_value, same pre-existing caveat the
            // plain `int` branch above has.
            if !ffi.hzstd_json_is_number(node) {
                return Error { error: () => f"JSON type mismatch: expected number ({T.prettyName})" };
            }
            let v = ffi.hzstd_json_get_number_value(allocator, node);
            if v >= T.min as real && v <= T.max as real {
                return v as T;
            }
            return Error { error: () => f"JSON range error: Expected number of type {T.prettyName}, but received value is out of range" };
        }
        else if comptime T is real {
            if !ffi.hzstd_json_is_number(node) { 
                return Error { error: () => "JSON type mismatch: expected number (real)" };
            }
            return ffi.hzstd_json_get_number_value(allocator, node);
        }
        else if comptime T is bool {
            if !ffi.hzstd_json_is_bool(node) { 
                return Error { error: () => "JSON type mismatch: expected bool" };
            }
            return ffi.hzstd_json_is_true(node);
        }
        else if comptime T is null {
            if !ffi.hzstd_json_is_null(node) { 
                return Error { error: () => "JSON type mismatch: expected null" };
            }
            return null;
        }
        else if comptime T.category == meta.TypeCategory.DynamicArray {
            return parseJsonArray<T>(allocator, node);
        }
        else if comptime T.category == meta.TypeCategory.Array {
            return parseJsonFixedArray<T>(allocator, node);
        }
        else if comptime T.category == meta.TypeCategory.Struct {
            // Mirror image of the [[json.serialize=...]] hook in dumpJsonNode:
            // a ref struct annotated with [[json.parse="methodName"]] opts out of
            // the default field-by-field object read. Its static
            // `methodName` method is called with the raw json.Node and must
            // return Result<T, json.Error>, exactly like every other
            // parseJsonNodeFromFfi<T> path.
            if comptime T.hasAttribute("json.parse") && T.isAttributeOfType<str>("json.parse") {
                const comptime parseMethod = T.getAttribute<str>("json.parse");
                return T.[parseMethod]({ allocator: allocator, data: node });
            }
            else {
                return parseJsonStruct<T>(allocator, node);
            }
        }
        else if comptime T.category == meta.TypeCategory.Union {

            if comptime T.hasAttribute("json.discriminator") && T.isAttributeOfType<str>("json.discriminator") {
                const comptime discriminatorField = T.getAttribute<str>("json.discriminator");

                // Check if every union member is a struct
                for comptime Variant in T.variants {
                    static_assert(Variant.category == meta.TypeCategory.Struct, f"json.parse(): Variant {Variant.prettyName} of discriminated union {T.prettyName} is not a struct");
                }

                // Check if every union member has the discriminator and the type matches
                for comptime Variant in T.variants {
                    const comptime hasDiscriminator = Variant.hasField(discriminatorField);
                    static_assert(hasDiscriminator, f"json.parse(): Variant {Variant.prettyName} of discriminated union {T.prettyName} does not have the discriminator field '{discriminatorField}'");
                    const comptime discriminatorTypeMatches = Variant[discriminatorField].category == meta.TypeCategory.Literal && Variant[discriminatorField].baseType is str;
                    static_assert(discriminatorTypeMatches, f"json.parse(): Discriminator field '{discriminatorField}' in variant {Variant.prettyName} of union {T.prettyName} is not a compile-time string literal");
                }

                // Check if all discriminators are unique
                for comptime VariantA, i in T.variants {
                    for comptime VariantB, j in T.variants {
                        if comptime i != j {
                            static_assert(VariantA[discriminatorField] != VariantB[discriminatorField], 
                                            f"json.parse(): Discriminator fields '{discriminatorField}' of union {T.prettyName} are not unique for all variants");
                        }
                    }
                }

                // Now parse it
                assert(ffi.hzstd_json_is_object(node));
                let proxy = (Node { allocator: allocator, data: node })[discriminatorField];
                if !proxy {
                    return Error { error: () => f"JSON type mismatch: Expected discriminated union '{T.prettyName}', but the discriminator value is missing" };
                }
                let discriminatorValue = proxy.to<typeof(T.variants[0][discriminatorField]).baseType>();
                if !discriminatorValue {
                    return Error { error: () => f"JSON type mismatch: Expected discriminated union '{T.prettyName}', but the discriminator value is not a string" };
                }
                for comptime Variant in T.variants {
                    assert(Variant[discriminatorField].category == meta.TypeCategory.Literal);
                    if discriminatorValue == Variant[discriminatorField].literalValue {
                        // It matches, parse it as this variant
                        let result = parseJsonStruct<Variant>(allocator, node);
                        if !result {
                            return result;
                        }
                        return result as T;
                    }
                }

                return Error { error: () => f"JSON type mismatch: Expected discriminated union '{T.prettyName}', but the discriminator matched none of the values" };
            }
            else {
                // Comptime ambiguity check: int and real both map to JSON number
                for comptime VariantA, i in T.variants {
                    for comptime VariantB, j in T.variants {
                        if comptime VariantA is int && VariantB is real {
                            static_assert(false, f"Ambiguous JSON union '{T.prettyName}': int and real both serialize as JSON numbers");
                        }
                        if comptime VariantA.category == meta.TypeCategory.Array && VariantB.category == meta.TypeCategory.DynamicArray {
                            static_assert(false, f"Ambiguous JSON union '{T.prettyName}': fixed and dynamic arrays cannot be distinguished");
                        }
                        if comptime i != j && VariantA.category == meta.TypeCategory.Struct && VariantB.category == meta.TypeCategory.Struct {
                            static_assert(false, f"Ambiguous JSON union '{T.prettyName}': multiple structs in union with no discriminator field annotation");
                        }
                    }
                }

                // Now loop over all variants at compile time, and if any of the variants actually exist, return it.
                // `none` is excluded here: by the time we have a real node, the value is present, and `none`
                // (undefined/absent) can only ever come from a missing key, which is handled upstream.
                // At most one error-producing closure per union variant is ever recorded (usually fewer, since
                // the loop returns immediately on the first success), so T.variants.length is a real, comptime
                // upper bound: a fixed-size array of exactly that capacity, with a separate fill count, avoids
                // any heap allocation here (unlike a dynamic array's .push).
                const comptime errorCapacity = T.variants.length;
                let attemptErrors = createStaticArray<() => str, errorCapacity>(() => "");
                let errorCount = 0;
                for comptime Variant in T.variants {
                    if comptime Variant is not none {
                        // Node is this type, return it
                        // Store function in variable and then call it to work around a very weird compiler bug
                        // that fails to resolve Variant otherwise
                        const comptime variantName = Variant.prettyName;
                        let parseFunc = parseJsonNodeFromFfi<Variant>;
                        let attemptResult = parseFunc(allocator, node);
                        if attemptResult {
                            return Result<T, Error>.Ok(attemptResult);
                        }
                        else {
                            // Rebind the narrowed Err: a closure does not
                            // inherit the narrowing above (it is called later).
                            let failed = attemptResult;
                            attemptErrors[errorCount] = () => {
                                return f"{variantName}: {failed.error()}";
                            };
                            errorCount = errorCount + 1;
                        }
                    }
                }

                return Error {
                    error: () => {
                        let combinedErrors = "";
                        for (let i = 0; i < errorCount; i = i + 1) {
                            if i > 0 {
                                combinedErrors = combinedErrors + "; ";
                            }
                            combinedErrors = combinedErrors + attemptErrors[i]();
                        }
                        return f"JSON type mismatch: Expected type {T.prettyName}, received no matching value ({combinedErrors})";
                    }
                };
            }
        }
        else {
            static_assert(false, f"json.parse(): type {T.prettyName} is not supported");
        }
        sys.unreachable();
    }

    export fn parse<T>(value: json.Node): Result<T, Error> {
        let node = parseJsonNodeFromFfi<T>(value.allocator, value.data);
        return node;
    }

    export fn parse<T>(allocator: Allocator, data: str): Result<T, Error> {
        return parse<T>(parseToJsonNode(allocator, data)?!);
    }

    // The parse tree is scratch: it goes into an arena nothing references
    // once the result is built, and the result itself is built on the heap.
    // Built in the arena too, as it once was, any part of the result that
    // lived on kept the whole arena alive -- every node of the parse tree,
    // for as long as the parsed value existed, all of it scanned by the
    // garbage collector on every collection.
    export fn parse<T>(data: str): Result<T, Error> {
        let tree = parseToJsonNode(Alloc.arena(), data)?!;
        return parseJsonNodeFromFfi<T>(Alloc.heap(), tree.data);
    }

    export fn dumpJsonArray<T>(allocator: Allocator, value: T): ffi.hzstd_json_node_t {
        let arr = ffi.hzstd_json_create_array(allocator);
        for (let i = 0; i < value.length; i++) {
            let item = dumpJsonNode<T.elementType>(allocator, value[i]);
            if item {
                ffi.hzstd_json_add_item_to_array(allocator, arr, item);
            }
        }
        return arr;
    }

    export fn dumpJsonFixedArray<T>(allocator: Allocator, value: T): ffi.hzstd_json_node_t {
        let arr = ffi.hzstd_json_create_array(allocator);
        for (let i = 0; i < T.length; i++) {
            let item = dumpJsonNode<T.elementType>(allocator, value[i]);
            if item {
                ffi.hzstd_json_add_item_to_array(allocator, arr, item);
            }
        }
        return arr;
    }

    export fn dumpJsonStruct<T>(allocator: Allocator, value: T): ffi.hzstd_json_node_t {
        let obj = ffi.hzstd_json_create_object(allocator);
        for comptime field in T.fields {
            const comptime fieldName = field.name;
            // A [[json.ignore]] field is not written at all. Decided at
            // compile time, so its type is never instantiated for encoding:
            // it may well be one json has no form for (a GPU handle, a
            // closure, a cache of either).
            if comptime T.hasFieldAttribute(fieldName, "json.ignore") == false {
                let fieldValue = value.[fieldName];
                let node = dumpJsonNode<typeof(fieldValue)>(allocator, fieldValue);
                if node {
                    ffi.hzstd_json_add_item_to_object(allocator, obj, fieldName, node);
                }
            }
        }
        return obj;
    }

    export fn dumpJsonNode<T>(allocator: Allocator, value: T): ffi.hzstd_json_node_t | none :: final {
        if comptime T.category == meta.TypeCategory.Literal {
            let v: T.baseType = value;
            return dumpJsonNode(allocator, v);
        }
        else if comptime T.category == meta.TypeCategory.Deep {
            return dumpJsonStruct<T.baseType>(allocator, value);
        }
        else if comptime T.category == meta.TypeCategory.Reactive && rx.UnwrapReactive<T>.category == meta.TypeCategory.DynamicArray {
            // A deep reactive array: an array field of a reactive struct, as in
            // every CacheFile's data. rx.get() cannot hand it back as a plain
            // array -- it stays a reactive array underneath, and indexing what
            // it returns does not compile -- so it is iterated directly, which
            // reads each element through its own cell.
            let arr = ffi.hzstd_json_create_array(allocator);
            for item in value {
                let node = dumpJsonNode<typeof(item)>(allocator, item);
                if node {
                    ffi.hzstd_json_add_item_to_array(allocator, arr, node);
                }
            }
            return arr;
        }
        else if comptime T.category == meta.TypeCategory.Reactive || T.category == meta.TypeCategory.ShallowReactive {
            return dumpJsonNode<rx.UnwrapReactive<T>>(allocator, rx.get(value));
        }
        else if comptime T is Node {
            return value.data;
        }
        else if comptime T is str {
            return ffi.hzstd_json_create_string(allocator, value);
        }
        else if comptime T is int {
            return ffi.hzstd_json_create_number(allocator, value as real);
        }
        else if comptime T is i8 || T is i16 || T is i32 || T is i64
              || T is u8 || T is u16 || T is u32 || T is u64 || T is usize {
            // Straight to `real`, not via `int`: u64/usize's range (up to
            // 2^64-1) does not fit in a signed 64-bit `int`, so the `as int`
            // hop the old i32-only branch used would reject valid u64/usize
            // values before they ever reached `real`.
            return ffi.hzstd_json_create_number(allocator, value as real);
        }
        else if comptime T is real {
            return ffi.hzstd_json_create_number(allocator, value);
        }
        else if comptime T is bool {
            return ffi.hzstd_json_create_bool(allocator, value);
        }
        else if comptime T is null {
            return ffi.hzstd_json_create_null(allocator);
        }
        else if comptime T is none {
            return none;
        }
        else if comptime T.category == meta.TypeCategory.DynamicArray {
            return dumpJsonArray<T>(allocator, value);
        }
        else if comptime T.category == meta.TypeCategory.Array {
            return dumpJsonFixedArray<T>(allocator, value);
        }
        else if comptime T.category == meta.TypeCategory.Struct {
            // A ref struct annotated with [[json.serialize="methodName"]] opts out
            // of the default field-by-field object walk: instead, its
            // zero-arg `methodName` method (returning json.Node) is called,
            // and that Node is spliced in verbatim. This is how e.g.
            // LinearMap<K, V> (core/src/containers.hz) presents itself as a
            // real {"key": value, ...} JSON object instead of its raw
            // {"keys": [...], "values": [...]} internals.
            if comptime T.hasAttribute("json.serialize") && T.isAttributeOfType<str>("json.serialize") {
                const comptime serializeMethod = T.getAttribute<str>("json.serialize");
                let node: Node = value.[serializeMethod]();
                return node.data;
            }
            else {
                return dumpJsonStruct<T>(allocator, value);
            }
        }
        else if comptime T.category == meta.TypeCategory.Union {
            for comptime Variant in T.variants {
                if value is Variant {
                    return dumpJsonNode<Variant>(allocator, value);
                }
            }
            sys.unreachable();
        }
        else {
            static_assert(false, f"json.stringify(): type {T.prettyName} is not supported");
        }
        sys.unreachable();
    }

    export fn encodeToJsonNode<T>(allocator: Allocator, value: T): json.Node | none {
        let node = dumpJsonNode<T>(allocator, value);
        if !node {
            return none;
        }
        return { allocator: allocator, data: node };
    }

    export fn encodeToJsonNode<T>(value: T): json.Node | none {
        return encodeToJsonNode<T>(Alloc.arena(), value);
    }

    export struct EncodeArgs {
        pretty: bool = false;
    }

    // Encodes into `allocator` rather than into a private, single-use arena.
    //
    // The default overload below is the right thing for a one-off stringify: the
    // arena it creates holds the intermediate node tree AND the returned string,
    // and becomes collectible as a whole the moment the caller drops that string.
    // But a fresh arena is not free -- its first allocation commits a chunk
    // (HZSTD_FIRST_ARENA_CHUNK_SIZE, 1 KiB), regardless of how few bytes the
    // value actually needs. Stringifying one small value at a time in a long
    // loop therefore leaves a chunk of garbage per iteration, which at hundreds
    // of thousands of iterations is several times the output in pure allocator
    // churn.
    //
    // This overload lets such a caller amortize that: hand in one arena, reuse it
    // for a batch of values, and drop it for a fresh one once the batch's peak
    // memory is high enough to matter. The returned string is allocated from
    // `allocator`, so it stays valid exactly as long as `allocator` does -- a
    // caller that recycles arenas must be done with (or have copied) the string
    // before it lets go of the arena it came from. See ChromeTrace.writeTrace for
    // the motivating use.
    export fn stringify<T>(allocator: Allocator, value: T, args: EncodeArgs = {}): str {
        let node = encodeToJsonNode<T>(allocator, value);
        if !node {
            return "";
        }
        return node.print({ pretty: args.pretty });
    }

    export fn stringify<T>(value: T, args: EncodeArgs = {}): str {
        return stringify<T>(Alloc.arena(), value, args);
    }
}

namespace fmt {
    export fn format_to(writer: mut stackref StringWriter, value: json.Node, args: FormatArgs) {
        format_to(writer, value.print({ pretty: true }), args);
    }

    export fn format_to(writer: mut stackref StringWriter, value: json.Error, args: FormatArgs) {
        format_to(writer, f"json error: {value.error()}", args);
    }
}

namespace json {

    export struct CacheFileArgs {
        panicOnFailure: bool = true;
    }

    export ref struct CacheFile<T> {
        data: rx.Reactive<T>;
        _args: CacheFileArgs;
        _path: str;
        _flushComputed: rx.Computed<none>;
        _disableDiskWriteTemporarily: bool = false;
        // The file as this cache's own last write left it. The watch below
        // polls the modification date, so it fires for that write too, and
        // this is how the echo is told apart from another program's write
        // without reading the file: see _isOwnWrite.
        _writtenState: fs.FileState | none = none;

        fn constructor(path: str, args: CacheFileArgs = {}) {
            let rawData = CacheFile<T>._read(path);
            if !rawData {
                if !CacheFile<T>._initial_save(path, T {}) {
                    sys.panic(f"Cache file at '{path}' could not be written to");
                }
                rawData = CacheFile<T>._read(path);
            }
            assert(rawData, f"Cache file at '{path}' could not be created");

            let cache = CacheFile<T> {
                data: rx.reactive<T>(rawData),
                _args: args,
                _path: path,
                _flushComputed: rx.computed(() => {}),
            };

            cache._flushComputed = rx.computed(() => {
                rx.get(cache.data); // Read to trigger dependency
                cache._writeToDisk();
            });

            fs.watch(path, (event: fs.FileChangeEvent): void => {
                // Our own write coming back: the file holds exactly what
                // `data` does, so there is nothing to read.
                if cache._isOwnWrite() {
                    return;
                }

                let rawData = CacheFile<T>._read(path);

                if rawData {
                    // Set this to avoid infinite recursion between loading and saving the file and trigger itself
                    cache._disableDiskWriteTemporarily = true;
                    // In place, never `cache.data := rx.reactive<T>(rawData)`:
                    // that gives every field a new cell, and whatever held
                    // the old one -- a computed subscribed to it, a component
                    // given it as a prop -- would read a cell nothing writes
                    // to again.
                    rx.assign<T>(cache.data, rawData);
                    cache.flush();
                    cache._disableDiskWriteTemporarily = false;
                }
                else if args.panicOnFailure {
                    sys.panic(f"Cache file at '{path}' could not be read from after a detected change");
                }
            }, { 
                immediate: false, 
            });

            return cache;
        }

        fn flush() {
            // Trigger reactive computation and disk writing if required.
            rx.get(this._flushComputed);
        }

        fn _writeToDisk() {
            // Serialize FIRST, and unconditionally. This runs inside
            // _flushComputed, and reading every field is the only thing that
            // subscribes that computed to them. Returning before these reads
            // -- which the reload path asks for -- re-runs the computed with
            // no field reads at all, so it comes back subscribed to nothing
            // but `data` itself and NO later write ever marks it dirty again.
            // The file is then frozen for the life of the process. A reload
            // only happens for another program's write, so this costs one
            // serialization per external change.
            let jsonData = json.stringify(this.data);
            if (this._disableDiskWriteTemporarily) { return; }
            if !fs.writeText(this._path, jsonData) {
                if this._args.panicOnFailure {
                    sys.panic(f"Cache file at '{this._path}' could not be written to");
                }
                return;
            }
            this._writtenState = fs.statFile(this._path);
        }

        // Whether the file is still exactly as this cache's own last write
        // left it. Taken right after the write, so another program writing
        // in the moment between the two would be mistaken for this one; the
        // modification date has nanosecond resolution, and the watch this
        // serves cannot tell such writes apart any better.
        fn _isOwnWrite(): bool {
            let written = this._writtenState;
            if written is none {
                return false;
            }
            let current = fs.statFile(this._path);
            if current is none {
                return false;
            }
            return current.mtime == written.mtime && current.size == written.size;
        }

        static fn _read(path: str): T | none {
            let file = fs.readText(path);
            if !file { return none; }
            let result = parse<T>(file);
            if !result { return none; }
            return result;
        }

        static fn _initial_save(path: str, data: T): Result<none, none> {
            if fs.writeText(path, json.stringify(data)) {
                return Result<none, none>.Ok(none);
            }
            return Result<none, none>.Err(none);
        }
    }
}