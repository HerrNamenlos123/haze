// ============================================================================
// Tasks (docs/async-runtime.md section 2; Axiom C216 to C261, C384, C387,
// C406, C438, C443, C444, C561). The runtime side is hzstd_sched.c.
//
// Every piece of Haze code runs in a task, `main` too. A task runs until it
// suspends (joining a future that is not done, yielding) or returns; then the
// thread's next ready task runs. `task.spawn` starts nothing by itself: the
// new task runs once its spawner suspends (C384). The `task` namespace holds
// only spawning; the tools tasks use live in `sys`.
// ============================================================================

namespace ffi {
    // Called only by _FutureCore's methods, compiled here: nothing else
    // reaches a future's core.
    extern C noemit fn hzstd_future_core_new(): cptr :: final;
    extern C noemit fn hzstd_future_state(core: cptr): int :: final;
    extern C noemit fn hzstd_future_claim(ctx: cptr, core: cptr) :: final;
    extern C noemit fn hzstd_future_complete(ctx: cptr, core: cptr) :: final;
    extern C noemit fn hzstd_future_wait(ctx: cptr, core: cptr): int :: final;
    extern C noemit fn hzstd_task_yield(ctx: cptr) :: final;
}

// Why joining a future gave no value (C438, C561).
export enum TaskError {
    // The task was killed after it had started: a background task its
    // thread ended under (C437).
    Killed,
    // The task was killed before it ever ran.
    NeverRan,
}

// The C side of a future (hzstd_future_core_t), and the only way to it. It
// takes its own lock for every change and every wait (docs/async-decisions.md
// S5-R1), so it crosses threads by its author's promise (S5-15). Opaque, so it
// always holds a real core: no other pointer can be carried across threads in
// it (S5-I1). Exported with its methods, which are compiled here: Future<T> is
// re-elaborated in every module that uses it.
export opaque unsafe crossthread struct _FutureCore {
    private raw: cptr;

    fn constructor(): _FutureCore {
        return _FutureCore { raw: ffi.hzstd_future_core_new() };
    }

    // 0 while pending; then hzstd_future_state_t (1 done, 2 killed, 3 never ran).
    fn state(): int {
        return ffi.hzstd_future_state(this.raw);
    }

    // Suspends the calling task until the future is settled; its state.
    fn wait(): int {
        return ffi.hzstd_future_wait(sys.contextPtr(), this.raw);
    }

    // Claims the future for one completion; panics if it was claimed before.
    fn claim() {
        ffi.hzstd_future_claim(sys.contextPtr(), this.raw);
    }

    // Settles a claimed future and readies its waiters.
    fn settle() {
        ffi.hzstd_future_complete(sys.contextPtr(), this.raw);
    }

    // Runs `thunk` as a new task on this thread (task.spawn); the thunk
    // completes the future.
    fn spawnTask(thunk: task._Thunk, background: bool, location: SourceLocation) {
        let entry = task.__hz_task_run_thunk;
        let ctx = sys.contextPtr();
        let core = this.raw;
        do unsafe {
            __c__("hzstd_task_spawn((hzstd_context_t *)ctx, entry, (void *)thunk, background, (hzstd_future_core_t *)core, location);");
        };
    }

    // Runs `run` as the first task of a new thread (thread.spawn); `run`
    // completes the future. Crossthread: whoever calls this, what `run`
    // holds is checked (C148, S5-2).
    fn spawnThread(run: crossthread () => none, options: thread.SpawnOptions, location: SourceLocation) {
        let thunk = task._Thunk { run: run };
        let entry = task.__hz_task_run_thunk;
        let ctx = sys.contextPtr();
        let core = this.raw;
        let stallWarning = options.stallWarning;
        do unsafe {
            __c__("hzstd_thread_spawn((hzstd_context_t *)ctx, entry, (void *)thunk, (hzstd_future_core_t *)core, stallWarning, location);");
        };
    }
}

// The result of a task, or a value some code hands over later (C387): one
// type for both. `join()` waits for it; `complete(v)` gives it its value,
// once (C444). Meant to be passed to whoever needs the result: a future is a
// reference, every copy is the same future. It crosses threads exactly when
// its value does (C600).
export atomic opaque ref struct Future<T> {
    private const core: _FutureCore;
    // Written once, by the `complete` that claimed the future, before the
    // future is settled; read by `join` only once it is settled. The core's
    // lock orders the two (S5-14, S5-R7): that is what `unsafe` promises.
    private unsafe result: Box<T> | none = none;

    // A future that code completes with `complete(v)` (C443).
    fn constructor(): mut Future<T> {
        return Future<T> { core: _FutureCore() };
    }

    // Suspends the calling task until the future is done (C256), and gives
    // its value, or why there is none: the error case must be handled
    // (C419), a task can be killed (C438) or never run (C561).
    fn join(): Result<T, TaskError> {
        let state = this.core.wait();
        if state == 2 {
            return TaskError.Killed;
        }
        if state == 3 {
            return TaskError.NeverRan;
        }
        if let done = this.result {
            return done.value;
        }
        sys.unreachable();
    }

    // Whether the future is done: completed, or its task killed. Never
    // suspends; meant for polling from code that has other work to do.
    fn isDone(): bool {
        return this.core.state() != 0;
    }

    // Gives the future its value and readies every task waiting in `join`.
    // A future gets its value once: a second `complete` panics (C444), also
    // on a task's future (the task completes it when it returns), and the
    // first value stays.
    mut fn complete(value: T) {
        // The value is in place before the future is settled (S5-14): a
        // join on another thread that sees it settled reads it. Boxed first,
        // since that can fail (an allocation limit) and nothing has changed
        // yet; the claim panics on a second complete before it overwrites the
        // first value.
        let done = Box<T> { value: value };
        this.core.claim();
        this.result = done;
        this.core.settle();
    }

    // Runs `body` as a new task that completes this future.
    mut fn _spawn(body: () => T, background: bool, location: SourceLocation) {
        let me = this;
        this.core.spawnTask(task._Thunk { run: () => { me.complete(body()); } }, background, location);
    }

    // The core, for thread.spawn, which builds the new thread's closure
    // itself: a crossthread conversion in a method here would reject every
    // Future<T> whose T stays on its thread (methods are elaborated for every
    // instantiation, S5-I2).
    fn _core(): _FutureCore {
        return this.core;
    }
}

namespace task {
    // How `spawn` runs a task.
    export struct SpawnOptions {
        // Background work: it does not keep its thread alive (C304, C435),
        // and is killed when the thread ends (C437). Meant for work nothing
        // waits for, such as a periodic refresh.
        background: bool = false;
    }

    // Runs `body` as a new task on this thread and gives the future of its
    // result (C250, C257). The task starts once the calling task suspends
    // (C384), with a copy of the caller's context (C406) and of its
    // task-local values (C285).
    export fn spawn<T>(body: () => T, options: SpawnOptions = SpawnOptions {}, location: SourceLocation = SourceLocation()): Future<T> {
        let future = Future<T>();
        future._spawn(body, options.background, location);
        return future;
    }

    // What a task runs, boxed so C holds it as one pointer. Internal: only
    // Future._spawn and _FutureCore.spawnThread make one.
    export ref struct _Thunk {
        run: () => none;
    }

    // hzstd_task_entry_t: runs a _Thunk. An `extern C` function defined in
    // Haze, so it takes the task's context as its first C parameter (C401).
    // Not exported: it takes any pointer for a _Thunk, so only _FutureCore's
    // spawn methods name it.
    extern C fn __hz_task_run_thunk(thunk: cptr) {
        let box = do unsafe {
            let b: _Thunk = uninitialized;
            __c__("b = thunk;");
            b
        };
        box.run();
    }
}

namespace ffi {
    extern C noemit fn hzstd_time_since_task_switch(ctx: cptr): real :: final;
    extern C noemit fn hzstd_task_exit(ctx: cptr, status: int) :: final, noreturn;
    extern C noemit fn hzstd_abort() :: final, noreturn;
}

namespace sys {
    // Lets every other ready task on this thread run first, then continues
    // (C243). Meant for long computations, so that nothing else on the thread
    // waits behind them: call it now and then inside the loop.
    export fn yield() {
        ffi.hzstd_task_yield(contextPtr());
    }

    // Yields once the task has run longer than `seconds` since it last
    // switched, and otherwise returns at once (C588, C590). Meant to be
    // called on every iteration of a long loop: it is cheap enough for that
    // (one load and one compare, inline, no clock read; hzstd_runtime.h).
    // The time is CPU time, measured every 5 ms (so is its precision).
    export extern C noemit fn yieldAfter(seconds: real) :: final, context;

    // Ends the program gracefully with `status`, 0 to 255 (anything else
    // panics, C576): this task stops here, every other task stops where it
    // is suspended and never runs again, the runtime's own end of the thread
    // runs, and the program exits with `status` (C521, C585 to C587). Meant
    // for ending a program from anywhere in it; returning from `main` is the
    // ordinary way. The first status is final: a later uncaught panic is
    // printed but exits with it.
    export fn exit(status: int) :: noreturn, final {
        ffi.hzstd_task_exit(contextPtr(), status);
    }

    // Ends the program at once, with status 134; nothing else runs, nothing
    // is cleaned up or flushed (C547, C574). Meant for states where going
    // on would do harm.
    export fn abort() :: noreturn, final {
        ffi.hzstd_abort();
    }

    // Waits for every future, in order, and returns their values. Panics if
    // one was killed or never ran; join each one to handle that yourself.
    //
    //     let results = sys.joinAll(futures);
    export fn joinAll<T>(futures: []Future<T>): []T {
        let results: mut []T = [];
        for (let i = 0; i < futures.length; i++) {
            let r = futures[i].join();
            if r is TaskError {
                if r == TaskError.Killed {
                    sys.panic(f"sys.joinAll: future {i} has no value: its task was killed", 1);
                }
                sys.panic(f"sys.joinAll: future {i} has no value: its task never ran", 1);
            }
            else {
                results.push(r);
            }
        }
        return results;
    }

    // Seconds the current task has run since its last switch (C589): CPU
    // time, measured every 5 ms (so is its precision). Meant for code that
    // decides itself when to yield or hand off work.
    export fn timeSinceTaskSwitch(): real {
        return ffi.hzstd_time_since_task_switch(contextPtr());
    }
}
