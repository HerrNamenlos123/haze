// Array methods that are written in Haze rather than built into the compiler.
//
// `items.map(f)` is not a compiler feature: when a method call on an array
// names something the compiler does not implement itself, it is rewritten to a
// call of the function of that name in this namespace, with the array as the
// first argument (Elaborate.ts, tryResolveArrayExtensionCall). So
//
//     items.map(fn)   is   array.map(items, fn)
//
// and everything that follows -- deducing T and U, overload resolution, the
// error when nothing matches -- is the ordinary call machinery. Adding an array
// method means adding a function here.
//
// Note: overloads here are resolved by argument TYPE, not by closure arity --
// a `(value: T) => U` and a `(value: T, index: int) => U` overload of the same
// name are ambiguous at every call site (H7060). An index-taking variant needs
// its own name.
//
// `length`, `insert`, `remove` and `pop` are still implemented by the compiler
// and take precedence over anything declared here. `push`, `reserve` and
// `clear` used to be, and now live below -- the compiler keeps its versions
// only as a fallback for a build with no standard library.
//
// The three that stayed all hand back an element (`pop`, `remove`) or an
// element-typed slot (`insert`), which a function written here cannot express
// yet: it would need a local of the generic type T to receive the value from
// inline C, and a generic T has no value to initialise such a local with.

export namespace array {
    // A new array holding f(x) for every x, in order.
    //
    // The result type follows from what the closure returns, so mapping to a
    // different type needs no annotation: `nums.map((v: int) => f"n{v}")` is
    // a []str.
    export fn map<T, U>(items: []T, f: immediate (value: T) => U): []U {
        let result: mut []U = [];
        result.reserve(items.length);
        for item in items {
            result.push(f(item));
        }
        return result;
    }

    // The elements the predicate accepts, in order.
    export fn filter<T>(items: []T, predicate: immediate (value: T) => bool): []T {
        let result: mut []T = [];
        for item in items {
            if predicate(item) {
                result.push(item);
            }
        }
        return result;
    }

    // Sorts the array in place, by `compare(a, b)`: negative when a goes
    // first, positive when b does, 0 when either may. Stable -- elements that
    // compare 0 keep their order -- so a sort by one key after a sort by
    // another orders by both.
    //
    // A bottom-up merge sort, O(n log n) comparisons, with one scratch array
    // of n elements.
    export fn sort<T>(items: mut []T, compare: immediate (a: T, b: T) => int) {
        let count = items.length;
        if count < 2 {
            return;
        }
        let source: mut []T = [];
        source.reserve(count);
        for item in items {
            source.push(item);
        }
        let target: mut []T = [];
        target.reserve(count);
        let width = 1;
        while width < count {
            target.clear();
            let start = 0;
            while start < count {
                let middle = start + width < count ? start + width : count;
                let end = start + width * 2 < count ? start + width * 2 : count;
                let left = start;
                let right = middle;
                while left < middle && right < end {
                    // Bound to locals: an indexed element of a value-struct
                    // array passed straight into a call generates bad C.
                    let a = source[left];
                    let b = source[right];
                    // Only a strictly smaller right element goes first,
                    // which is what keeps the sort stable.
                    if compare(b, a) < 0 {
                        target.push(b);
                        right += 1;
                    } else {
                        target.push(a);
                        left += 1;
                    }
                }
                while left < middle {
                    target.push(source[left]);
                    left += 1;
                }
                while right < end {
                    target.push(source[right]);
                    right += 1;
                }
                start = end;
            }
            let swap = source;
            source = target;
            target = swap;
            width = width * 2;
        }
        for (let i = 0; i < count; i++) {
            items[i] = source[i];
        }
    }

    // Append one element.
    //
    // This is the whole of `items.push(x)`: the compiler no longer implements
    // it. The element type's C name comes from T.mangledName, which is what
    // lets one generic function stand in for the per-element-type function the
    // compiler used to synthesize.
    //
    // The array is `mut []T`: pushing changes its data, which only a `mut`
    // reference can (Axiom C601, C602). `let xs: mut []int = []; xs.push(1)`.
    //
    // The element is `NoInfer<T>` so that T comes from the array alone. With a
    // plain `T` there, pushing a value that merely converts to the element type
    // (a union variant, an integer literal) would deduce the argument's own
    // type and then fail to match the array.
    export fn push<T>(items: mut []T, element: NoInfer<T>) {
        __c__(f"HZSTD_ARRAY_PUSH(items, {T.mangledName}, element);");
    }

    // Grow the backing buffer so that `capacity` elements fit without
    // reallocating. Never shrinks, never changes length.
    export fn reserve<T>(items: mut []T, capacity: int) {
        __c__("hzstd_dynamic_array_reserve(items, capacity);");
    }

    // Drop every element. Keeps the buffer, so refilling does not reallocate.
    export fn clear<T>(items: mut []T) {
        __c__("hzstd_dynamic_array_clear(items);");
    }

    // Runs `body` holding the lock of an atomic array and returns its value,
    // so that several operations on the array happen as one: no other task
    // or thread sees the array in between. Every operation takes the same
    // lock, also inside `body` (a task that holds it takes it again without
    // waiting), and waiting for it suspends only the waiting task. `body` may
    // suspend. A panic that leaves `body` poisons the array, like a sys.Mutex:
    // every later operation on it panics (docs/async-decisions.md S5-9).
    //
    //     let jobs: atomic []Job = [];
    //     let job = jobs.lock(() => jobs.length > 0 ? jobs.pop() : none);
    export fn lock<T, R>(items: atomic []T, body: immediate () => R, location: SourceLocation = SourceLocation()): R {
        let ctx = sys.contextPtr();
        let core = ffi.atomicArrayCore(items);
        ffi.hzstd_mutex_lock(ctx, core, location);
        let result = body();
        ffi.hzstd_mutex_unlock(ctx, core);
        return result;
    }
}

namespace ffi {
    // The lock of an atomic array, made on its first use (hzstd_array.h,
    // "Atomic arrays"). Exported: array.lock is re-elaborated in every module
    // that calls it.
    export fn atomicArrayCore<T>(items: atomic []T): cptr {
        __c__("return (void *)hzstd_atomic_array_core(items);");
    }
}
