// Array methods that are written in Haze rather than built into the compiler.
//
// `items.map(f)` is not a compiler feature: when a method call on an array
// names something the compiler does not implement itself, it is rewritten to a
// call of the function of that name in this namespace, with the array as the
// first argument (Elaborate.ts, tryResolveArrayExtensionCall). So
//
//     items.map(fn)   is   array.map(items, fn)
//
// and everything that follows -- deducing T and U, overload resolution, the
// error when nothing matches -- is the ordinary call machinery. Adding an array
// method means adding a function here.
//
// Note: overloads here are resolved by argument TYPE, not by closure arity --
// a `(value: T) => U` and a `(value: T, index: int) => U` overload of the same
// name are ambiguous at every call site (H7060). An index-taking variant needs
// its own name.
//
// `length`, `insert`, `remove` and `pop` are still implemented by the compiler
// and take precedence over anything declared here. `push`, `reserve` and
// `clear` used to be, and now live below -- the compiler keeps its versions
// only as a fallback for a build with no standard library.
//
// The three that stayed all hand back an element (`pop`, `remove`) or an
// element-typed slot (`insert`), which a function written here cannot express
// yet: it would need a local of the generic type T to receive the value from
// inline C, and a generic T has no value to initialise such a local with.

export namespace array {
    // A new array holding f(x) for every x, in order.
    //
    // The result type follows from what the closure returns, so mapping to a
    // different type needs no annotation: `nums.map((v: int) => f"n{v}")` is
    // a []str.
    export fn map<T, U>(items: []T, f: immediate (value: T) => U): []U {
        let result: []U = [];
        result.reserve(items.length);
        for item in items {
            result.push(f(item));
        }
        return result;
    }

    // The elements the predicate accepts, in order.
    export fn filter<T>(items: []T, predicate: immediate (value: T) => bool): []T {
        let result: []T = [];
        for item in items {
            if predicate(item) {
                result.push(item);
            }
        }
        return result;
    }

    // Append one element.
    //
    // This is the whole of `items.push(x)`: the compiler no longer implements
    // it. The element type's C name comes from T.mangledName, which is what
    // lets one generic function stand in for the per-element-type function the
    // compiler used to synthesize.
    //
    // The array is taken as `[]T` rather than `mut []T` on purpose -- `mut`
    // here would reject `let xs: []int = []; xs.push(1)`, which the compiler
    // built-in has always accepted.
    //
    // The element is `NoInfer<T>` so that T comes from the array alone. With a
    // plain `T` there, pushing a value that merely converts to the element type
    // (a union variant, an integer literal) would deduce the argument's own
    // type and then fail to match the array.
    export fn push<T>(items: []T, element: NoInfer<T>) {
        __c__(f"HZSTD_ARRAY_PUSH(items, {T.mangledName}, element);");
    }

    // Grow the backing buffer so that `capacity` elements fit without
    // reallocating. Never shrinks, never changes length.
    export fn reserve<T>(items: []T, capacity: int) {
        __c__("hzstd_dynamic_array_reserve(items, capacity);");
    }

    // Drop every element. Keeps the buffer, so refilling does not reallocate.
    export fn clear<T>(items: []T) {
        __c__("hzstd_dynamic_array_clear(items);");
    }
}
