        this._pushSlow(value);
    }

    mut fn _pushSlow(value: str): void :: final {
        this._assertBuilding();
        let n = value.length;
        if this._measuring {
            this._length += n;
            return;
        }
        if n == 0 {
            return;
        }
        this._makeWritable(this._length + n, false);
        __c__("memcpy((hzstd_u8_t*)this->_data + this->_length, value.data, (size_t)n);");
        this._length += n;
    }

    mut fn push(value: Bytes): void :: final {
        this._assertBuilding();
        let n = value.length;
        if this._measuring {
            this._length += n;
            return;
        }
        if n == 0 {
            return;
        }
        this._makeWritable(this._length + n, false);
        this._copyIn(this._length, value);
        this._length += n;
    }

    mut fn push(value: u8): void :: final {
        // As push(str): the common case in one test.
        if (this._owned || this._fixed) && !this._committed && this._length < this._capacity {
            __c__("((hzstd_u8_t*)this->_data)[this->_length] = value;");
            this._length += 1;
            return;
        }
        this._pushSlow(value);
    }

    mut fn _pushSlow(value: u8): void :: final {
        this._assertBuilding();
        if this._measuring {
            this._length += 1;
            return;
        }
        this._makeWritable(this._length + 1, false);
        __c__("((hzstd_u8_t*)this->_data)[this->_length] = value;");
        this._length += 1;
    }

    // The values, formatted exactly as fmt.format formats them, written
    // straight into this buffer: nothing is allocated but this buffer's own
    // growth. It takes any buffer, a struct field included, which a
    // formatter's `mut stackref ByteBuffer` cannot. A str or int is written
    // directly. Any other value is measured first, room is made for exactly
    // that much, and its formatter writes into the room in place, through a
    // fixed window that cannot grow and so cannot move this buffer.
