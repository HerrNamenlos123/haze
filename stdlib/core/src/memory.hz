    mut fn insert(index: int, value: str): void :: final {
        this.insert(index, Bytes(value));
    }

    mut fn insert(index: int, value: u8): void :: final {
        this.insert(index, Bytes(value));
    }

    mut fn insert(index: int, value: Bytes): void :: final {
        this._assertBuilding();
        if index < 0 || index > this._length {
            sys.panic("ByteBuffer: insert position out of bounds");
        }
        let n = value.length;
        if this._measuring {
            this._length += n;
            return;
        }
        if n == 0 {
            return;
        }
        this._makeWritable(this._length + n, false);
        let tail = this._length - index;
        __c__("memmove((hzstd_u8_t*)this->_data + index + n, (hzstd_u8_t*)this->_data + index, (size_t)tail);");
