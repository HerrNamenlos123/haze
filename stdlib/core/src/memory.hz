// One byte of a ByteBuffer, from `buffer[index]`: `buffer[i] := v` writes it,
// `buffer[i].get()` reads it. A value holding a checked reference: it
// allocates nothing, and using it after the buffer is gone panics.
export struct ByteBufferIndex {
    buffer: mut stackref ByteBuffer;
    index: int;

    fn get(): u8 :: final {
        return this.buffer.getAt(this.index);
    }

    fn operator:=(value: u8): void :: final {
        this.buffer.setAt(this.index, value);
    }
}

export opaque struct Bytes {
    // This slice must consist of base pointer + offset + length. Since we don't want to constrain to 
    // a non-moving GC, we can't rely on interior pointers holding buffers alive. Therefore we must
    // reference the base object directly and encode an offset, such that the GC recognizes the 
    // pointer, thereby keeping the door open for a future switch to a moving/compacting GC.

    // However, currently it still wouldn't work with a moving GC since it requires actual GC references
    // and not plain pointers. But that wouldn't work together with slices taken from immutable program
    // memory like hardcoded strings or embedded files. So we will just ignore it.
    // But we keep base+offset so we remember that interior pointers may no longer be supported at some point.
    basePtr: cptr;
    offset: int;
    length: int;

    singleByte: u8 | none;

    fn constructor() {
        return Bytes {
            basePtr: none,
            offset: 0,
            length: 0,
            singleByte: none,
        };
    }

    fn constructor(value: u8) {
        return Bytes {
            basePtr: none,
            offset: 0,
            length: 1,
            singleByte: value,
        };
    }

    fn constructor(value: str) {
        let bytes = Bytes {
            basePtr: none,
            offset: 0,
            length: value.length,
            singleByte: none,
        };
        do unsafe {
            __c__("bytes.basePtr = (void*)value.data;");
        }
        return bytes;
    }

    fn operator[](index: int): u8 {
        return this.getAt(index);
    }

    fn getAt(index: int): u8 {
        if (index < 0 || index >= this.length) {
            sys.panic("Out of bounds access in Bytes slice");
        }

        if this.singleByte {
            return this.singleByte;
        }
        else {
            let result: u8 = 0;
            __c__("result = ((hzstd_u8_t*)this->basePtr + this->offset)[index];");
            return result;
        }
    }

    fn slice(start?: int, end?: int): Bytes {
        let len = this.length;

        // --- resolve start ---
        let s = 0;
        if start {
            s = start;
            if s < 0 {
                s = len + s;
            }
        }

        // --- resolve end ---
        let e = len;
        if end {
            e = end;
            if e < 0 {
                e = len + e;
            }
        }

        // --- clamp to [0, len] ---
        if s < 0 { s = 0; }
        if s > len { s = len; }

        if e < 0 { e = 0; }
        if e > len { e = len; }

        if this.singleByte {
            if e <= s {
                return Bytes();
            }

            // Only possible non-empty slice is [0,1)
            return Bytes(this.singleByte);
        }
        else {
            // --- empty if reversed ---
            if e <= s {
                return Bytes {
                    basePtr: this.basePtr,
                    offset: this.offset,
                    length: 0,
                    singleByte: none,
                };
            }

            return Bytes {
                basePtr: this.basePtr,
                offset: this.offset + s,
                length: e - s,
                singleByte: none,
            };
        }
    }

    fn string(): str {
        if !this.singleByte {
            // TODO: Perform utf-8 validation once we have actual unicode support
            let result = "";
            if (this.length > 0) {
                __c__("result = HZSTD_STRING((const char*)(this->basePtr + this->offset), this->length);");
            }
            return result;
        }
        else {
            // TODO: Perform utf-8 validation once we have actual unicode support
            let result = "";
            let byte = this.singleByte;
            __c__("result = hzstd_str_dup(HZSTD_STRING((const char*)&byte, 1));");
            return result;
        }
    }

    // Whether two slices name the exact same memory -- same base object, same
    // offset, same length -- WITHOUT reading a single byte of it.
    //
    // This is deliberately NOT what `==` below means. `==` compares CONTENTS,
    // and for a large buffer that is a memcmp over the whole thing; asking it
    // "is this the same buffer I already saw" costs time proportional to the
    // buffer's size, every time. This answers that question in a handful of
    // integer compares, which is what a cache guarding expensive work (parsing
    // an embedded font, uploading a texture) actually needs: two slices that
    // pass here are interchangeable for any purpose, and one that fails may
    // still be byte-equal -- so this is only ever a fast path, never a
    // substitute for `==` where equality is the real question.
    //
    // A single-byte slice holds its byte inline and has no base pointer at
    // all, so those compare by value; a single-byte and a pointer-backed
    // slice are never the same memory even when they hold the same byte.
    fn refersToSameMemory(other: Bytes): bool {
        if this.length != other.length {
            return false;
        }

        let a = this.singleByte;
        let b = other.singleByte;
        if (a is none) != (b is none) {
            return false;
        }
        if a is not none {
            if b is not none {
                return a == b;
            }
        }

        if this.offset != other.offset {
            return false;
        }

        // cptr has no comparison in the language (Conversion.typeSupportsComparison
        // excludes it outright: an address carries no meaning the language can
        // reason about), and identity is the one question about an address that
        // is always meaningful -- so it is asked here and nowhere else.
        let same = false;
        __c__("same = (this->basePtr == other.basePtr);");
        return same;
    }

    fn operator==(other: Bytes) {
        if this.length != other.length {
            return false;
        }

        if this.singleByte || other.singleByte {
            for (let i = 0; i < this.length; i++) {
                if this[i] != other[i] {
                    return false;
                }
            }
            return true;
        }

        let equal = false;
        __c__("equal = memcmp(this->basePtr + this->offset, other.basePtr + other.offset, this->length) == 0;");
        return equal;
    }

    fn operator!=(other: Bytes) {
        return !(this == other);
    }
}

export opaque struct TypeErasedBox {
    _handle: cptr;
    _prettyTypeName: str;
    _fingerprint: int;

    fn constructor<T>(value: T) {
        do unsafe {
            let box: ref Box<T> = { value: value };
            let handle: cptr = uninitialized;
            __c__("handle = box;");
            return TypeErasedBox {
                _handle: handle,
                _prettyTypeName: T.prettyName,
                _fingerprint: T.fingerprint,
            };
        };
    }

    fn set<T>(value: T) {
        do unsafe {
            let handle = this._handle;
            let typedBox: ref Box<T> = uninitialized;
            __c__("typedBox = handle;");
            typedBox.value = value;
        };
        this._prettyTypeName = T.prettyName;
        this._fingerprint = T.fingerprint;
    }

    fn get<T>() {
        // A fingerprint already implies identity: a type's own fully
        // qualified (mangled) name is a direct input to its fingerprint, so
        // an equal fingerprint (collisions aside -- see Fingerprint.ts,
        // never an issue unless it also coincides with an actual runtime
        // type violation) guarantees both same identity and same binary
        // layout in one check. `_prettyTypeName` is kept only for the panic
        // message below, not for the safety check itself.
        if (this._fingerprint != T.fingerprint) {
            sys.panic(f"Invalid Type Erased Box access. Value was stored as \"{this._prettyTypeName}\", but it is tried to be accessed as \"{T.prettyName}\"");
        }
        do unsafe {
            let handle = this._handle;
            let typedBox: ref Box<T> = uninitialized;
            __c__("typedBox = handle;");
            return typedBox.value;
        };
    }
}