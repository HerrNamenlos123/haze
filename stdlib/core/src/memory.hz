    // One value of pushFmt that is neither a str nor an int.
    mut fn _pushFormatted<T>(value: T): void {
        let stackref measure = ByteBuffer.measuring();
        fmt.format_to_proxy(measure, value, {});
        let n = measure.length();
        if this._measuring {
            this._length += n;
            return;
        }
        if n == 0 {
            return;
        }
        this._makeWritable(this._length + n, false);
        let room = none as cptr;
        __c__("room = (hzstd_u8_t*)this->_data + this->_length;");
