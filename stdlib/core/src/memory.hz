
export extern C noemit struct hzstd_allocator_t {};
export type Allocator = hzstd_allocator_t;

export extern C fn hzstd_make_heap_allocator(): Allocator :: final;
export extern C fn hzstd_make_arena_allocator(): Allocator :: final;

export namespace Alloc {
    export fn heap() {
        return hzstd_make_heap_allocator();
    }

    export fn arena() {
        return hzstd_make_arena_allocator();
    }
}

// ByteBuffer: the standard way to build binary data, and the only way to turn
// built bytes into a `str` or `Bytes` without copying them.
//
// One of the most important invariants in Haze: what a `str` (or `Bytes`)
// points to never changes, never moves and never changes length. So a slice
// may only point into a buffer that can no longer be written. Without a
// borrow checker the compiler cannot see who writes after a slice was taken,
// so the user states it instead, in two phases:
//
//   build    push / insert / remove / setAt / resize / reserve ... The buffer
//            grows and changes; no view of it can exist.
//   commit() ends the build phase for good.
//   read     bytes() / string() are views into the buffer's own storage, with
//            no copy. Nothing changes any more.
//
// Crossing the line (a write after commit, a view before it) panics. What a
// buffer does never depends on how it is stored at the moment: a buffer that
// still borrows the `str` it was built from behaves exactly like one that
// copied it.
//
// Why this is sound:
//   * The buffer is `nocopy`: no second binding of it, and so no second
//     writer over the same storage, can exist. (Its fields are only private by
//     convention. `opaque` stops literals and spreads; private fields, once
//     Haze has them, are what will stop code outside this file from reaching
//     into `_data` and friends.)
//   * Before commit no view exists, so the storage may be reallocated, and
//     the old block freed at once (GC_realloc does), without anyone noticing.
//   * After commit nothing writes, reallocates or frees it. The GC keeps it
//     alive for as long as any view points into it.
//
// Storage, chosen at construction:
//   growable  ByteBuffer() / ByteBuffer(capacity) / ByteBuffer(source): one
//             contiguous heap block the GC does not scan (it holds no
//             pointers), grown with GC_realloc. `reserve(total)` and ordinary
//             growth are geometric (at least double), so growing in a loop
//             stays amortised O(1); `reserveExact(total)` and the capacity
//             constructor allocate exactly.
//   fixed     ByteBuffer.fixed(capacity, allocator): allocated once, from any
//             allocator (an arena included), and never moved. Writing past the
//             capacity panics.
//   measuring ByteBuffer.measuring(): stores nothing and only counts. Run the
//             same code twice, measure then write into ByteBuffer(exact), and
//             the whole thing is one allocation (this is how fmt.format works).
//
// Built from a `str` or `Bytes`, a buffer borrows it (copy-on-write): nothing
// is allocated until the first write, and a buffer committed without writes
// is the source itself.
export nocopy opaque struct ByteBuffer {
    _data: cptr = none;        // the storage; see _owned / _fixed for whose
    _length: int = 0;
    _capacity: int = 0;        // bytes usable at _data
    _owned: bool = false;      // _data is our own growable heap block
    _fixed: bool = false;      // allocated once, never moved
    _measuring: bool = false;  // no storage at all, only _length
    _committed: bool = false;

    // Methods are `final` with explicit types throughout: assert() and every
    // panic format through this type (fmt.format), so nothing here may depend
    // on inference that would recurse back into fmt, and its own panics use
    // plain strings.

    // Empty and growable. Nothing is allocated until the first write.
    fn constructor(): ByteBuffer :: final {
        return ByteBuffer {};
    }

    // Growable, with exactly `capacity` bytes allocated up front.
    fn constructor(capacity: int): ByteBuffer :: final {
        if capacity < 0 {
            sys.panic("ByteBuffer: negative capacity");
        }
        let data = none as cptr;
        if capacity > 0 {
            __c__("data = hzstd_heap_allocate_atomic((size_t)capacity, \"ByteBuffer\");");
        }
        return ByteBuffer { _data: data, _capacity: capacity, _owned: capacity > 0 };
    }

    // Borrows `source` until the first write (copy-on-write). A `str` never
    // changes, so the buffer means the same thing either way.
    fn constructor(source: str): ByteBuffer :: final {
        let data = none as cptr;
        let length = source.length;
        if length > 0 {
            __c__("data = (void*)source.data;");
        }
        return ByteBuffer { _data: data, _length: length, _capacity: length };
    }

    // Borrows `source` like the `str` constructor. A single-byte Bytes holds
    // its byte inline and has no memory to borrow, so that one byte is copied.
    fn constructor(source: Bytes): ByteBuffer :: final {
        if let single = source.singleByte {
            let byte: u8 = single;
            let data = none as cptr;
            __c__("data = hzstd_heap_allocate_atomic(1, \"ByteBuffer\"); ((hzstd_u8_t*)data)[0] = byte;");
            return ByteBuffer { _data: data, _length: 1, _capacity: 1, _owned: true };
        }
        let data = none as cptr;
        let length = source.length;
        if length > 0 {
            __c__("data = (hzstd_u8_t*)source.basePtr + source.offset;");
        }
        return ByteBuffer { _data: data, _length: length, _capacity: length };
    }

    // `capacity` bytes from `allocator`, allocated now and never moved: the
    // buffer cannot grow, and writing past the capacity panics. With an arena
    // allocator the views live as long as the arena.
    static fn fixed(capacity: int, allocator: Allocator): ByteBuffer :: final {
        if capacity < 0 {
            sys.panic("ByteBuffer: negative capacity");
        }
        let data = none as cptr;
        if capacity > 0 {
            __c__("data = hzstd_allocate_atomic(allocator, (size_t)capacity, \"ByteBuffer\");");
        }
        return ByteBuffer { _data: data, _capacity: capacity, _fixed: true };
    }

    // Stores nothing, only counts: every write adds to length(), and nothing
    // can be read back. For sizing a second, real pass exactly.
    static fn measuring(): ByteBuffer :: final {
        return ByteBuffer { _measuring: true };
    }

    // --- Reading (any phase) -------------------------------------------------

    fn length(): int :: final {
        return this._length;
    }

    fn capacity(): int :: final {
        return this._capacity;
    }

    fn isCommitted(): bool :: final {
        return this._committed;
    }

    fn getAt(index: int): u8 :: final {
        if this._measuring {
            sys.panic("ByteBuffer: a measuring buffer has no contents to read");
        }
        if index < 0 || index >= this._length {
            sys.panic("ByteBuffer: index out of bounds");
        }
        let result: u8 = 0;
        __c__("result = ((hzstd_u8_t*)this->_data)[index];");
        return result;
    }

    // `buffer[i] := v` writes a byte, `buffer[i].get()` reads one. The index
    // is a value holding a checked reference to this buffer, so it allocates
    // nothing and cannot write into a buffer that is gone. That reference
    // needs a buffer that can be referenced: a `let stackref` or a stackref
    // parameter. getAt()/setAt() work on any buffer.
    mut stackref fn operator[](index: int): ByteBufferIndex :: final {
        return ByteBufferIndex { buffer: this, index: index };
    }

    // A copy of the current contents as a `str`, in either phase: later
    // writes do not change it. Committed (or still borrowing an immutable
    // source), the contents can no longer change, so it is a view, no copy.
    fn cloneString(): str :: final {
        let result = "";
        if this._measuring {
            sys.panic("ByteBuffer: a measuring buffer has no contents to read");
        }
        if this._length == 0 {
            return result;
        }
        if this._committed || this._isBorrowing() {
            __c__("result = HZSTD_STRING((const char*)this->_data, this->_length);");
            return result;
        }
        __c__("""
            char* copy = (char*)hzstd_heap_allocate_atomic((size_t)this->_length, "str");
            memcpy(copy, this->_data, (size_t)this->_length);
            result = HZSTD_STRING(copy, this->_length);
        """);
        return result;
    }

    // As cloneString(), as Bytes.
    fn cloneBytes(): Bytes :: final {
        if this._measuring {
            sys.panic("ByteBuffer: a measuring buffer has no contents to read");
        }
        let result = Bytes();
        if this._length == 0 {
            return result;
        }
        if this._committed || this._isBorrowing() {
            __c__("result.basePtr = this->_data; result.offset = 0; result.length = this->_length;");
            return result;
        }
        __c__("""
            void* copy = hzstd_heap_allocate_atomic((size_t)this->_length, "Bytes");
            memcpy(copy, this->_data, (size_t)this->_length);
            result.basePtr = copy;
            result.offset = 0;
            result.length = this->_length;
        """);
        return result;
    }

    // --- Phase change and the read phase -------------------------------------

    // Ends the build phase for good. Nothing is copied: from now on the
    // storage is read-only, and bytes()/string() are views into it.
    // Committing twice is harmless.
    mut fn commit(): void :: final {
        if this._measuring {
            sys.panic("ByteBuffer: a measuring buffer has no contents to commit");
        }
        this._committed = true;
    }

    // The committed contents, without a copy.
    fn bytes(): Bytes :: final {
        if !this._committed {
            sys.panic("ByteBuffer: bytes() needs a committed buffer; call commit() first, or use cloneBytes() for a copy");
        }
        let result = Bytes();
        if this._length > 0 {
            __c__("result.basePtr = this->_data; result.offset = 0; result.length = this->_length;");
        }
        return result;
    }

    // The committed contents as a `str`, without a copy.
    // TODO: UTF-8 validation once Haze has real unicode support.
    fn string(): str :: final {
        if !this._committed {
            sys.panic("ByteBuffer: string() needs a committed buffer; call commit() first, or use cloneString() for a copy");
        }
        let result = "";
        if this._length > 0 {
            __c__("result = HZSTD_STRING((const char*)this->_data, this->_length);");
        }
        return result;
    }

    // --- Writing (build phase) -----------------------------------------------

    mut fn push(value: str): void :: final {
        let n = value.length;
        // The common case in one test, small enough to be inlined into every
        // caller in this library (String.append): our own (or a fixed) block
        // that is still being built and has room. Anything else, every panic
        // included, is _pushSlow.
