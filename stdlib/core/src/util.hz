
extern C noemit fn sizeof(...): usize :: final;

export type Result<T, E> = nodiscard union { Ok: T, Err: E, };

// A parameter declared `NoInfer<T>` still converts like a `T`, but takes no
// part in deducing T -- the compiler skips it when it works out what the
// generic parameters are (Elaborate.ts, deduceGenericArgs). Use it for the
// parameter that should FOLLOW another one rather than compete with it:
// `array.push(items: []T, element: NoInfer<T>)` has to take T from the array,
// or pushing a value that merely converts to the element type would deduce the
// argument's own type and then fail to match the array.
export type NoInfer<T> = T;

// A value struct holding one value: a heap integer is `ref Box<int>`, a
// stack-referable one is `let stackref b = Box(5)`.
export struct Box<T> {
    value: T;

    fn constructor(value: T) {
        return Box<T> {
            value: value,
        };
    }
}

export fn clamp<T>(value: T, min: T, max: T): T {
    if (value < min) {
        return min;
    }
    else if (value > max) {
        return max;
    }
    else {
        return value;
    }
}

export fn max<T>(a: T, b: T): T {
    if (a > b) {
        return a;
    }
    else {
        return b;
    }
}

export fn min<T>(a: T, b: T): T {
    if (a < b) {
        return a;
    }
    else {
        return b;
    }
}

export fn sizeofTypeInBytes<T>() {
    let size = 0;
    do unsafe {
        __c__(f"size = sizeof({T.mangledName});");
    };
    return size;
}

export fn addressOf<T>(value: T) {
    if comptime T.category == meta.TypeCategory.Struct {
        if comptime T.isValue {
            static_assert(false, f"Struct '{T.prettyName}' is and therefore not applicable to addressOf()");
        }
        let addr: u64 = 0;
        do unsafe {
            __c__(f"addr = (uint64_t)(void*)value;");
        };
        return addr;
    }
    if comptime 
            T.category == meta.TypeCategory.Reactive || 
            T.category == meta.TypeCategory.Computed || 
            T.category == meta.TypeCategory.DynamicArray || 
            T.category == meta.TypeCategory.ShallowReactive {
        let addr: u64 = 0;
        do unsafe {
            __c__(f"addr = (uint64_t)(void*)value;");
        };
        return addr;
    }
    else {
        static_assert(false, f"Type '{T.prettyName}' is not a pointer based structure and therefore not applicable to addressOf()");
    }
}

export fn createStaticArray<T, N>(defaultValue: T): [N]T {
    do unsafe {
        // This is a plain C-style static array.
        let array: [N]T = uninitialized;
        for _, i in array {
            array[i] = defaultValue;
        }
        return array;
    };
}