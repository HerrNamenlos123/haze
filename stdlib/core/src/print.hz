
fn watchBinary(): rx.ShallowReactive<Bytes> :: final;

namespace ffi {
    export extern C noemit fn printf(fmt: ccstr, ...) :: final;
    export extern C noemit fn hzstd_print_str_stdout(string: str, noflush: bool) :: final;
}

namespace fmt {
    export struct FormatArgs {
        formatSpecifier: str = "";
    }

    // The formatting controller (R&D/Storage Classes and References.md §10).
    //
    // A value that lives in the formatting function's own frame and is handed
    // to every formatter as `mut stackref Writer`: no heap object for the
    // controller, no buffer growth, no frozen copy. It runs in two passes over
    // the same arguments -- first measuring (no buffer), then writing into a
    // buffer allocated once at exactly the measured size -- so the only heap
    // allocation in the whole pipeline is the returned string's bytes.
    //
    // It is `nocopy`: it carries a write cursor into shared storage, and two
    // cursors over one buffer would silently overwrite each other (§9.3).
    export nocopy struct Writer {
        data: cptr = none;      // null while measuring; else the exact-size buffer
        capacity: int = 0;      // byte length of `data`; 0 = measuring pass
        measuring: bool = true;
        written: int = 0;       // bytes written (pass 2) or measured (pass 1)

        // A measuring writer: counts bytes, writes nothing.
        // (`final` + explicit types throughout: assert() and panics format
        // through this very type, so nothing here may depend on inference
        // that would recurse back into fmt.)
        fn constructor(): Writer :: final {
            return Writer {};
        }

        // A writing writer over a fresh buffer of exactly `capacity` bytes.
        fn constructor(allocator: Allocator, capacity: int): Writer :: final {
            let data = none as cptr;
            if capacity > 0 {
                do unsafe {
                    __c__("data = hzstd_allocate(allocator, capacity, \"fmt string\");");
                };
            }
            return Writer { data: data, capacity: capacity, measuring: false, written: 0 };
        }

        mut fn write(value: str): void :: final {
            if !this.measuring {
                if this.written + value.length > this.capacity {
                    __c__("hzstd_panic(\"fmt.Writer: write exceeds the measured size\");");
                }
                do unsafe {
                    __c__("memcpy((char*)this->data + this->written, value.data, value.length);");
                };
            }
            this.written += value.length;
        }

        // The finished string: wraps the buffer without copying.
        fn string(): str :: final {
            if this.measuring || this.written == 0 {
                return "";
            }
            let result = "";
            do unsafe {
                __c__("result = HZSTD_STRING((const char*)this->data, this->written);");
            };
            return result;
        }
    }

    export type StringWriter = Writer;

    export fn format(values: ...): str :: final {
        // Very essential short-circuit because without it, fmt.format(str) always heap-allocates and clones 
        // the string when it could literally just return it.
        if comptime values.length == 1 && typeof(values[0]) == str {
            return values[0];
        }
        else {
            let stackref reader = Writer();
            for comptime value, i in values {
                format_to_proxy(reader, value, {});
            }
            let stackref writer = Writer(hzstd_make_heap_allocator(), reader.written);
            for comptime value, i in values {
                format_to_proxy(writer, value, {});
            }
            return writer.string();
        }
    }

    export fn formatWithAllocator(allocator: Allocator, values: ...) {
        let stackref reader = Writer();
        for comptime value, i in values {
            format_to_proxy(reader, value, {});
        }
        let stackref writer = Writer(allocator, reader.written);
        for comptime value, i in values {
            format_to_proxy(writer, value, {});
        }
        return writer.string();
    }

    // Shared body of print()/println(): the arguments are forwarded as a
    // parameter pack (`...args`), so both are thin wrappers and the
    // measure/write two-pass formatting lives in one place. Exported only
    // because pack functions are re-elaborated in the importing module.
    export fn printImpl(newline: bool, args: ...) :: final {
        // Nested because comptime `&&` does not short-circuit: `args[0]` must
        // not be touched when the pack is empty.
        if comptime args.length == 1 {
            if comptime typeof(args[0]) == str {
                ffi.hzstd_print_str_stdout(args[0], newline);
                if newline {
                    ffi.hzstd_print_str_stdout("\n", false);
                }
            }
            else {
                printFormatted(newline, ...args);
            }
        }
        else {
            printFormatted(newline, ...args);
        }
    }

    export fn printFormatted(newline: bool, args: ...) :: final {
        let stackref reader = Writer();
        for comptime arg, i in args {
            format_to_proxy(reader, arg, {});
            if comptime i != args.length - 1 {
                reader.write(" ");
            }
        }
        if newline {
            reader.write("\n");
        }
        let stackref writer = Writer(hzstd_make_heap_allocator(), reader.written);
        for comptime arg, i in args {
            format_to_proxy(writer, arg, {});
            if comptime i != args.length - 1 {
                writer.write(" ");
            }
        }
        if newline {
            writer.write("\n");
        }
        ffi.hzstd_print_str_stdout(writer.string(), false);
    }

    export fn print(args: ...) {
        printImpl(false, ...args);
    }

    export fn println(args: ...) :: final {
        printImpl(true, ...args);
    }

    export fn format_to_proxy<T>(writer: mut stackref Writer, value: T, args: FormatArgs) :: final {
        if comptime T.category == meta.TypeCategory.Reactive {
            format_to_proxy<rx.UnwrapReactive<T>>(writer, rx.get(value), args);
        }
        else if comptime T.category == meta.TypeCategory.ShallowReactive {
            format_to_proxy<rx.UnwrapReactive<T>>(writer, rx.get(value), args);
        }
        else if comptime T.category == meta.TypeCategory.Computed {
            format_to_proxy<rx.UnwrapReactive<T>>(writer, rx.get(value), args);
        }
        else if comptime T.category == meta.TypeCategory.Union {
            for comptime Variant, i in T.variants {
                if value is Variant {
                    format_to_proxy<Variant>(writer, value, args);
                }
            }
        }
        else if comptime T.category == meta.TypeCategory.TaggedUnion {
            for comptime Variant, i in T.variants {
                if value is Variant.type {
                    format_to_proxy<Variant.type>(writer, value, args);
                }
            }
        }
        else if comptime T.category == meta.TypeCategory.Array || T.category == meta.TypeCategory.DynamicArray {
            format_to_proxy<str>(writer, "[", {});
            for element, i in value {
                // TODO: This is actually incorrect for escape characters and we would have to preformat each element
                // and use string escaping to make it correct
                format_to_proxy<str>(writer, "\"", {});
                format_to_proxy<T.elementType>(writer, element, args);
                format_to_proxy<str>(writer, "\"", {});
                if i != value.length - 1 {
                    format_to_proxy<str>(writer, ", ", {});
                }
            }
            format_to_proxy<str>(writer, "]", {});
        }
        else {
            format_to(writer, value as T.baseType, args);
        }
    }

    export fn format_to<T>(writer: mut stackref Writer, value: T, args: FormatArgs) {
        static_assert(false, f"No formatter is known for type '{T.prettyName}'. To format this type, define a matching overload for fmt.format_to().");
    }

    export fn format_to(writer: mut stackref Writer, value: i8, args: FormatArgs) {
        format_to_sprintf<64, "\"%\" PRIi8", typeof(value)>(writer, value);
    }

    export fn format_to(writer: mut stackref Writer, value: i16, args: FormatArgs) {
        format_to_sprintf<64, "\"%\" PRIi16", typeof(value)>(writer, value);
    }

    export fn format_to(writer: mut stackref Writer, value: i32, args: FormatArgs) {
        format_to_sprintf<64, "\"%\" PRIi32", typeof(value)>(writer, value);
    }

    export fn format_to(writer: mut stackref Writer, value: i64, args: FormatArgs) {
        format_to_sprintf<64, "\"%\" PRIi64", typeof(value)>(writer, value);
    }

    export fn format_to(writer: mut stackref Writer, value: int, args: FormatArgs) {
        format_to_sprintf<64, "\"%\" PRIi64", typeof(value)>(writer, value);
    }

    export fn format_to(writer: mut stackref Writer, value: str, args: FormatArgs) {
        writer.write(value);
    }
    
    export fn format_to(writer: mut stackref Writer, value: u8, args: FormatArgs) {
        format_to_sprintf<64, "\"%\" PRIu8", typeof(value)>(writer, value);
    }

    export fn format_to(writer: mut stackref Writer, value: u16, args: FormatArgs) {
        format_to_sprintf<64, "\"%\" PRIu16", typeof(value)>(writer, value);
    }

    export fn format_to(writer: mut stackref Writer, value: u32, args: FormatArgs) {
        format_to_sprintf<64, "\"%\" PRIu32", typeof(value)>(writer, value);
    }

    export fn format_to(writer: mut stackref Writer, value: u64, args: FormatArgs) {
        format_to_sprintf<64, "\"%\" PRIu64", typeof(value)>(writer, value);
    }

    export fn format_to(writer: mut stackref Writer, value: usize, args: FormatArgs) {
        format_to_sprintf<64, "\"%\" PRIu64", typeof(value)>(writer, value);
    }

    export fn format_to(writer: mut stackref Writer, value: f32, args: FormatArgs) {
        format_to_sprintf<64, "\"%.9g\"", typeof(value)>(writer, value);
    }

    export fn format_to(writer: mut stackref Writer, value: f64, args: FormatArgs) {
        format_to_sprintf<64, "\"%.17g\"", typeof(value)>(writer, value);
    }

    export fn format_to(writer: mut stackref Writer, value: real, args: FormatArgs) {
        format_to(writer, value as f64, args);
    }

    export fn format_to(writer: mut stackref Writer, value: bool, args: FormatArgs) {
        if value {
            format_to(writer, "true", args);
        }
        else {
            format_to(writer, "false", args);
        }
    }

    export fn format_to(writer: mut stackref Writer, value: fs.Error, args: FormatArgs) {
        let num = 0;
        __c__("num = value;");
        format_to(writer, num, args);
    }

    export fn format_to(writer: mut stackref Writer, value: none, args: FormatArgs) {
        format_to(writer, "none", args);
    }

    export fn format_to(writer: mut stackref Writer, value: null, args: FormatArgs) {
        format_to(writer, "null", args);
    }

    export fn format_to_sprintf<BufferSize, Fmt, T>(writer: mut stackref Writer, value: T) {
        let n = 0;
        let string = "";
        __c__(f"""
char buf[{BufferSize}];
n = hzstd_snprintf(buf, sizeof(buf), {Fmt}, value);
string = HZSTD_STRING_FROM_CSTR(buf);
        """);
        if n > 0 && n < BufferSize {
            writer.write(string);
        }
    }

    export fn format_to(writer: mut stackref Writer, value: SourceLocation, args: FormatArgs) {
        let f = value.filename();
        if f {
            let l = value.line();
            if l {
                let c = value.column();
                if c {
                    writer.write(f"{f}:{l}:{c}");
                }
                else {
                    writer.write(f"{f}:{l}");
                }
            }
            else {
                writer.write(f"{f}");
            }
        }
        else {
            writer.write("<no location>");
        }
    }
}