
namespace ffi {
    extern C fn hzstd_cstr_from_str(allocator: Allocator, data: str): cstr :: final;

    extern C fn hzstd_str_from_cstr_ref(data: cstr): str :: final;
    extern C fn hzstd_str_from_ccstr_ref(data: ccstr): str :: final;
    extern C fn hzstd_str_from_cstr_dup(allocator: Allocator, data: cstr): str :: final;
}

// Workaround because of ffi namespace bug
export extern C fn hzstd_str_from_cstr_ref(data: cstr): str :: final;
export extern C fn hzstd_str_from_ccstr_ref(data: ccstr): str :: final;

// String: an editable text that is shared by reference.
//
// A `str` is an immutable slice, so a text that keeps changing (a document
// line being typed into) needs a container of its own. String is that
// container: a `ref` object around one ByteBuffer (memory.hz). Being a `ref`
// it can be stored, passed and shared freely, and every holder sees the same
// edits; the ByteBuffer inside does the work.
//
// It follows the ByteBuffer's phases: it is edited until commit(), and only
// then is string() a view without a copy (before that it panics). Reading the
// current text at any time is cloneString(), a copy, or no copy at all where
// the text cannot change any more. Built from a `str`, a String borrows it
// until the first edit, so wrapping a literal costs the object alone.
export opaque ref struct String {
    _buffer: ByteBuffer;

    fn constructor() {
        return String { _buffer: ByteBuffer() };
    }

    fn constructor(literal: str) {
        return String { _buffer: ByteBuffer(literal) };
    }

    // Room for `capacity` bytes in all; growth stays geometric.
    fn reserve(capacity: int) {
        this._buffer.reserve(capacity);
    }

    // Room for exactly `capacity` bytes, for when the final size is known.
    fn reserveExact(capacity: int) {
        this._buffer.reserveExact(capacity);
    }

    fn length(): int {
        return this._buffer.length();
    }

    fn capacity(): int {
        return this._buffer.capacity();
    }

    fn isCommitted(): bool {
        return this._buffer.isCommitted();
    }

    // The current text, in either phase: later edits do not change it.
    fn cloneString(): str {
        return this._buffer.cloneString();
    }

    // The committed text, without a copy. Panics before commit().
    fn string(): str {
        return this._buffer.string();
    }

    // Ends editing for good; afterwards string() is a view.
    fn commit() {
        this._buffer.commit();
    }

    ref mut fn append(string: String) {
        // A copy unless the other text can no longer change: appending a
        // String to itself must read it before it grows.
        this._buffer.push(string._buffer.cloneBytes());
        return this;
    }

    ref mut fn append(string: str) {
        this._buffer.push(string);
        return this;
    }

    ref mut fn append(value: u8) {
        this._buffer.push(value);
        return this;
    }

    // The values formatted exactly as fmt.format formats them, written
    // straight into this text with nothing allocated but its own growth
    // (ByteBuffer.pushFmt).
    ref mut fn appendFmt(values: ...) {
        this._buffer.pushFmt(...values);
        return this;
    }

    ref mut fn setAt(index: int, value: u8) {
        this._buffer.setAt(index, value);
        return this;
    }

    fn getAt(index: int): u8 {
        return this._buffer.getAt(index);
    }

    ref mut fn insert(index: int, value: str) {
        this._buffer.insert(index, value);
        return this;
    }

    ref mut fn insert(index: int, value: u8) {
        this._buffer.insert(index, value);
        return this;
    }

    ref mut fn remove(index: int, count: int) {
        this._buffer.remove(index, count);
        return this;
    }

    // Drops everything from `length` on.
    ref mut fn truncate(length: int) {
        this._buffer.truncate(length);
        return this;
    }

    // Empties the text and keeps its storage for reuse.
    ref mut fn clear() {
        this._buffer.clear();
        return this;
    }

    // Moves the bytes [middle, end) to `start`, and [start, middle) after
    // them, in place (ByteBuffer.rotate).
    ref mut fn rotate(start: int, middle: int, end: int) {
        this._buffer.rotate(start, middle, end);
        return this;
    }

    // `text[i] := v` writes a byte, `text[i].get()` reads one.
    ref mut fn operator[](index: int): StringByteRef {
        return StringByteRef {
            string: this,
            index: index,
        };
    }

    fn startsWith(prefix: str): bool {
        if prefix.length > this.length() {
            return false;
        }
        for (let i = 0; i < prefix.length; i++) {
            if this._buffer.getAt(i) != prefix[i] {
                return false;
            }
        }
        return true;
    }

    fn endsWith(suffix: str): bool {
        let len = this.length();
        if suffix.length > len {
            return false;
        }
        let offset = len - suffix.length;
        for (let i = 0; i < suffix.length; i++) {
            if this._buffer.getAt(offset + i) != suffix[i] {
                return false;
            }
        }
        return true;
    }

    fn contains(needle: str): bool {
        let len = this.length();
        if needle.length == 0 {
            return true;
        }
        if needle.length > len {
            return false;
        }
        for (let start = 0; start <= len - needle.length; start++) {
            let matches = true;
            for (let j = 0; j < needle.length; j++) {
                if this._buffer.getAt(start + j) != needle[j] {
                    matches = false;
                    break;
                }
            }
            if matches {
                return true;
            }
        }
        return false;
    }

    // A copy of bytes [start, end); negative positions count from the end.
    fn cloneSlice(start: int, end?: int): str {
        if !end {
            end = this.length();
        }
        assert(end);
        let len = this.length();

        let s = start;
        let e = end;

        if s < 0 {
            s += len;
        }
        if e < 0 {
            e += len;
        }

        s = clamp<int>(s, 0, len);
        e = clamp<int>(e, 0, len);

        if e < s {
            e = s;
        }

        let result = ByteBuffer(e - s);
        for (let i = s; i < e; i++) {
            result.push(this._buffer.getAt(i));
        }
        result.commit();
        return result.string();
    }
}

// One byte of a String, from `text[index]`. A value holding the String's
// reference: it allocates nothing.
export struct StringByteRef {
    string: mut String;
    index: int;

    fn get(): u8 {
        return this.string.getAt(this.index);
    }

    fn operator:=(value: u8) {
        this.string.setAt(this.index, value);
    }
}

namespace fmt {
    export fn format_to(writer: mut stackref ByteBuffer, value: String, args: FormatArgs) {
        // Read a COPY rather than committing. Committing would freeze the
        // String's buffer permanently, so merely interpolating a String
        // (f"{line}") would make every later edit to it panic with
        // "mutation was attempted on a ByteBuffer that was already
        // committed". Formatting must not mutate what it formats -- a
        // document line has to stay editable after being rendered.
        format_to(writer, value.cloneString(), args);
    }
}