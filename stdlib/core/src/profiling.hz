namespace ffi {
    extern C noemit fn hzstd_profiling_start(sampling_rate_hz: int, memoryInstrumentation: bool, memoryInstrumentationStacktraces: bool): hzstd_profiling_context_t :: final;
    extern C noemit fn hzstd_profiling_end(context: hzstd_profiling_context_t): hzstd_profiling_result_t :: final;

    export extern C noemit struct hzstd_profiling_context_t {};

    export extern C noemit opaque inline struct hzstd_profiling_frame_t {
        address: cptr;
        name: str;
        sourceloc: SourceLocation;
    };

    export extern C noemit opaque inline struct hzstd_profiling_sample_t {
        timestamp: real;
        sampling_duration: real;
        frames: []int;
        truncated: bool;
        lost_before: int;
    };

    export extern C noemit opaque inline struct hzstd_memory_instrumentation_frame_t {
        stacktrace: hzstd_stacktrace_t;
        timestamp: real;
    };

    export extern C noemit opaque inline struct hzstd_profiling_result_t {
        frames: []hzstd_profiling_frame_t;
        samples: []hzstd_profiling_sample_t;
        sampling_rate_hz: int;
        memoryInstrumentationFrames: []hzstd_memory_instrumentation_frame_t;
    };
}

// ── profiling ────────────────────────────────────────────────────────────
//
// This is the adapter between hzstd's raw FFI profiling output and
// ChromeTrace (stdlib/core/src/chrome-trace.hz), which owns every detail of
// how Chrome/V8/DevTools actually want that data shaped on the wire. This
// file should never need to know what a "ProfileChunk" is, or which trace
// event names DevTools recognizes -- only what hzstd's samples/frames mean
// and how to turn them into ChromeTrace.FrameRef sequences.
namespace profiling {
    export type Frame = ffi.hzstd_profiling_frame_t;
    export type Sample = ffi.hzstd_profiling_sample_t;
    export type ProfilingResult = ffi.hzstd_profiling_result_t;

    // hzstd_profiling_frame_t (an address + name + source location) ->
    // ChromeTrace.FrameRef. Haze source locations are 1-indexed with 0
    // meaning absent, which is exactly FrameRef's own convention, so no
    // conversion happens here -- ChromeTrace does whatever index shifting
    // each output format needs internally.
    fn frameRefForFrame(frame: Frame): ChromeTrace.FrameRef {
        return frameRefForNameAndLoc(frame.name, frame.sourceloc);
    }

    // Same conversion as frameRefForFrame above, but for sys.StackFrame
    // (the type used by memoryInstrumentationFrames' stacktraces) -- an
    // unrelated FFI struct that happens to share the same name/sourceloc
    // shape, so both funnel through this one implementation.
    fn frameRefForStackFrame(frame: sys.StackFrame): ChromeTrace.FrameRef {
        return frameRefForNameAndLoc(frame.name, frame.sourceloc);
    }

    fn frameRefForNameAndLoc(name: str, sourceloc: SourceLocation): ChromeTrace.FrameRef {
        let filename = sourceloc.filename();
        let line = sourceloc.line();
        return ChromeTrace.FrameRef {
            name: name.length > 0 ? name : "(unknown)",
            url: filename ? filename : "",
            line: line ? line : 0,
            column: 0,
        };
    }

    // stacktrace.frames[0 .. skip_n_frames) are internal hzstd frames (the
    // call into hzstd_build_stacktrace itself and its callers inside the
    // instrumentation hook) that were never meant to be user-visible --
    // skipped here the same way print_frames_to_stderr and sbuf_frames
    // (hzstd_runtime.c) already do for panic stack traces.
    fn frameRefsForStacktrace(stacktrace: sys.Stacktrace): []ChromeTrace.FrameRef {
        let frames: []ChromeTrace.FrameRef = [];
        for (let i = stacktrace.skip_n_frames; i < stacktrace.frames.length; i++) {
            frames.push(frameRefForStackFrame(stacktrace.frames[i]));
        }
        return frames;
    }

    // Sampling is driven by PERF_COUNT_SW_CPU_CLOCK (see hzstd_profiling.c), which only ticks
    // while the profiled thread is actually consuming CPU time -- correct for a CPU profiler,
    // but it means a gap between two consecutive samples' wall-clock timestamps far larger than
    // one sampling interval doesn't mean "this code ran for that whole gap"; it means the thread
    // wasn't running at all for most of it (blocked on the GPU/compositor, a mutex, any syscall
    // -- or just descheduled). Left alone, that whole gap would get charged to whatever function
    // the earlier sample happened to land in, making an ordinary call look like it took hundreds
    // of milliseconds when the thread was simply off-CPU right after it. A generous multiple of
    // the nominal interval is enough to tell "normal scheduling jitter between two real samples"
    // apart from "the thread clearly wasn't running for a while" -- false positives here just
    // produce a slightly-too-early gap in the trace, which is cheap; false negatives would let
    // real stalls hide as fake slow functions again, which is the actual bug being fixed.
    //
    // Per-file feedback: off-CPU time should show up as nothing at all in the trace, not a
    // marker -- so an off-cpu gap simply isn't reported as a sample (see
    // ChromeTrace.CpuProfileBuilder's own doc comment on addSample: the next real sample's
    // timeDelta then spans the whole gap on its own). Lost samples are different: the kernel
    // (PERF_RECORD_LOST) reports a hard fact that real code definitely ran there, so that still
    // gets its own marker via addLostSamplesMarker.
    fn addSamplesToProfile(builder: mut ChromeTrace.CpuProfileBuilder, result: ProfilingResult): void {
        let nominalIntervalUs = 1000000.0 / (result.sampling_rate_hz as real);
        let offCpuThresholdUs = nominalIntervalUs * 4.0;

        let lastTimeUs = 0.0;
        for (let s = 0; s < result.samples.length; s++) {
            let sample = result.samples[s];
            let timeUs = sample.timestamp * 1000000.0;

            if s > 0 {
                let delta = timeUs - lastTimeUs;
                if sample.lost_before > 0 {
                    // Hard fact from the kernel, not an inference from timing: real code
                    // definitely ran here, we just have no record of what it was. This takes
                    // priority over the off-cpu heuristic below -- finding out real samples
                    // existed here means the thread almost certainly *was* running, the opposite
                    // conclusion the off-cpu heuristic would otherwise draw from the same gap.
                    builder.addLostSamplesMarker(lastTimeUs + nominalIntervalUs, delta - nominalIntervalUs);
                } else if delta > offCpuThresholdUs {
                    // Off-CPU: the thread wasn't running for (most of) this gap. Emit nothing --
                    // no sample, no marker -- so the trace shows empty space here, per feedback.
                }
            }

            let frames: []ChromeTrace.FrameRef = [];
            // sample.frames is innermost-first; CpuProfileBuilder.addSample wants outermost-first.
            for (let depth = sample.frames.length - 1; depth >= 0; depth--) {
                frames.push(frameRefForFrame(result.frames[sample.frames[depth]]));
            }
            builder.addSample(timeUs, frames, sample.truncated);

            lastTimeUs = timeUs;
        }
    }

    export fn buildCpuProfile(result: ProfilingResult): ChromeTrace.CpuProfile {
        let builder = ChromeTrace.CpuProfileBuilder();
        builder.reserveSamples(result.samples.length);
        addSamplesToProfile(builder, result);
        return builder.build();
    }

    export fn writeCpuProfile(result: ProfilingResult, path: str) {
        return ChromeTrace.writeCpuProfile(buildCpuProfile(result), path);
    }

    // ── trace.json export ────────────────────────────────────────────────────
    //
    // pid/tid layout mirrors real Chrome traces (one process, several purpose-specific
    // threads/tracks within it) and leaves room to grow -- e.g. a future second Haze process
    // (worker/subprocess) would get pid 2 rather than requiring these ids to be renumbered.
    const hazeProcessPid = 1;
    const mainThreadTid = 1; // owns the "Profile"/"RunTask" stream, like Chrome's CrRendererMain
    const heapAllocationsTid = 2;

    // Sane placeholders until real instrumentation reports an allocation's type/size -- every
    // allocation currently looks identical in the trace beyond its stack trace and timestamp.
    const placeholderAllocationName = "Allocation";

    export fn buildTrace(result: ProfilingResult): ChromeTrace.Trace {
        let builder = ChromeTrace.TraceBuilder(hazeProcessPid);
        builder.addThread(mainThreadTid, "CrRendererMain", true);
        builder.addThread(heapAllocationsTid, "Heap Allocations");
        builder.addFrame(mainThreadTid, "HZFRAME0", "file:///haze");

        let profile = buildCpuProfile(result);
        // This "task" block is what gives the CPU flame chart somewhere to render into (see
        // ChromeTrace's file header) and anchors the sample ordering invariant; the profiled
        // session is represented as a single task spanning its whole duration.
        builder.addTask(mainThreadTid, profile.startTime, profile.endTime - profile.startTime);
        builder.addCpuProfileSamples(mainThreadTid, profile.startTime, profile);

        for (let i = 0; i < result.memoryInstrumentationFrames.length; i++) {
            let frame = result.memoryInstrumentationFrames[i];
            builder.addInstantMarker(
                heapAllocationsTid,
                frame.timestamp * 1000000.0,
                placeholderAllocationName,
                frameRefsForStacktrace(frame.stacktrace),
            );
        }

        return builder.build();
    }

    export fn toTraceJson(result: ProfilingResult): str {
        return ChromeTrace.traceToJson(buildTrace(result));
    }

    export fn writeTraceJson(result: ProfilingResult, path: str) {
        return ChromeTrace.writeTrace(buildTrace(result), path);
    }
}

// Sampling rate is configurable via the constructor parameter (default 10 kHz):
// - samplingRate = 10000 (default): balanced accuracy and manageable postprocessing
// - samplingRate = 0: unlimited, use maximum kernel-allowed rate (Linux) or default (Windows)
// - samplingRate > 0: use as a ceiling; kernel throttling may reduce actual rate further
// The *achieved* rate -- actual samples per second -- shows up in ProfilingResult.sampling_rate_hz
// once a session ends. Only one profiling session can be active at a time; starting a second
// session while one is already running will panic immediately.
export struct Profiler {
    context: ffi.hzstd_profiling_context_t;

    struct Args {
        samplingRate: int = 10000;
        memoryInstrumentation: bool = true;
        memoryInstrumentationStacktraces: bool = true;
    }

    fn constructor(args: Args) {
        fmt.println(f"Profiling started @ {args.samplingRate > 0 ? args.samplingRate : "any"} Hz");
        let context = ffi.hzstd_profiling_start(args.samplingRate, args.memoryInstrumentation, args.memoryInstrumentationStacktraces);
        return Profiler {
            context: context,
        };
    }

    // TODO: This profiler must turn into a resource so it's panic recovery safe
    //
    // hzstd_profiling_end itself prints postprocessing progress (sample counts,
    // lost/throttled counts, a live "unwinding sample N / total" counter) straight
    // to stdout as it happens, since that work can take real, visible time on a
    // large session -- nothing needs to be printed here beforehand or afterward.
    fn stop(): profiling.ProfilingResult {
        return ffi.hzstd_profiling_end(this.context);
    }

    // Dispatches on `path`'s extension: ".cpuprofile" writes the legacy Chrome DevTools /
    // V8 CPU profiler format (still just today's cpu-only data), anything else (default
    // "out.trace.json") writes a Chrome trace -- the format going forward, since it can also
    // carry whatever the FFI layer starts reporting beyond CPU samples (e.g. memory
    // instrumentation) that .cpuprofile has no room for.
    fn stopAndSave(path: str = "trace.json") {
        const result = this.stop();
        let r = path.endsWith(".cpuprofile") ? profiling.writeCpuProfile(result, path) : profiling.writeTraceJson(result, path);
        fmt.println(f"Results were written to {path}");
        return r;
    }
}
