namespace ffi {
    extern C noemit fn hzstd_profiling_start(sampling_rate_hz: int, memoryInstrumentation: bool, memoryInstrumentationStacktraces: bool): hzstd_profiling_context_t :: final;
    extern C noemit fn hzstd_profiling_end(context: hzstd_profiling_context_t): hzstd_profiling_result_t :: final;

    export extern C noemit struct hzstd_profiling_context_t {};

    export extern C noemit opaque inline struct hzstd_profiling_frame_t {
        address: cptr;
        name: str;
        sourceloc: SourceLocation;
    };

    export extern C noemit opaque inline struct hzstd_profiling_sample_t {
        timestamp: real;
        sampling_duration: real;
        frames: []int;
        truncated: bool;
        lost_before: int;
    };

    export extern C noemit opaque inline struct hzstd_memory_instrumentation_frame_t {
        stacktrace: hzstd_stacktrace_t;
        timestamp: real;
        sizeBytes: int;
        // Mirrors hz_profiler_instrument_allocation_type (hzstd_memory.h) --
        // see profiling.allocationKindName for the int -> label mapping.
        allocationType: int;
        dataType: str; // empty string = absent
    };

    export extern C noemit opaque inline struct hzstd_profiling_result_t {
        frames: []hzstd_profiling_frame_t;
        samples: []hzstd_profiling_sample_t;
        sampling_rate_hz: int;
        memoryInstrumentationFrames: []hzstd_memory_instrumentation_frame_t;
    };
}

// ── profiling ────────────────────────────────────────────────────────────
//
// This is the adapter between hzstd's raw FFI profiling output and
// ChromeTrace (stdlib/core/src/chrome-trace.hz), which owns every detail of
// how Chrome/V8/DevTools actually want that data shaped on the wire. This
// file should never need to know what a "ProfileChunk" is, or which trace
// event names DevTools recognizes -- only what hzstd's samples/frames mean
// and how to turn them into ChromeTrace.FrameRef sequences.
namespace profiling {
    export type Frame = ffi.hzstd_profiling_frame_t;
    export type Sample = ffi.hzstd_profiling_sample_t;
    export type ProfilingResult = ffi.hzstd_profiling_result_t;

    // hzstd_profiling_frame_t (an address + name + source location) ->
    // ChromeTrace.FrameRef. Haze source locations are 1-indexed with 0
    // meaning absent, which is exactly FrameRef's own convention, so no
    // conversion happens here -- ChromeTrace does whatever index shifting
    // each output format needs internally.
    fn frameRefForFrame(frame: Frame): ChromeTrace.FrameRef {
        return frameRefForNameAndLoc(frame.name, frame.sourceloc);
    }

    // Same conversion as frameRefForFrame above, but for sys.StackFrame
    // (the type used by memoryInstrumentationFrames' stacktraces) -- an
    // unrelated FFI struct that happens to share the same name/sourceloc
    // shape, so both funnel through this one implementation.
    fn frameRefForStackFrame(frame: sys.StackFrame): ChromeTrace.FrameRef {
        return frameRefForNameAndLoc(frame.name, frame.sourceloc);
    }

    // One FrameRef per entry of the profile's frame table, hashed once, ready to be handed
    // out by index.
    //
    // Both sample kinds address their frames by exactly this index already: a CPU sample's
    // `frames` are indices into result.frames outright, and a memory capture's
    // sys.StackFrame carries the same index as its `id` (hzstd_profiling.c sets it from the
    // frame-table index when it resolves the capture). So neither of them ever needs to
    // build a FrameRef -- or re-resolve a source location, or re-hash a function name --
    // more than once for a given frame, no matter how many samples land on it.
    //
    // That matters because the two are wildly different magnitudes: a large session has a
    // few thousand distinct frames but tens of millions of (sample, depth) pairs referring
    // to them. Building the FrameRef at each pair, as this used to, meant re-doing all of
    // that work millions of times over the same few thousand frames.
    fn buildFrameRefTable(result: ProfilingResult): []ChromeTrace.FrameRef {
        let frameRefs: []ChromeTrace.FrameRef = [];
        frameRefs.reserve(result.frames.length);
        for (let i = 0; i < result.frames.length; i++) {
            frameRefs.push(ChromeTrace.frameRefWithHash(frameRefForFrame(result.frames[i])));
        }
        return frameRefs;
    }

    fn frameRefForNameAndLoc(name: str, sourceloc: SourceLocation): ChromeTrace.FrameRef {
        let filename = sourceloc.filename();
        let line = sourceloc.line();
        return ChromeTrace.FrameRef {
            name: name.length > 0 ? name : "(unknown)",
            url: filename ? filename : "",
            line: line ? line : 0,
            column: 0,
        };
    }

    // stacktrace.frames[0 .. skip_n_frames) are internal hzstd frames (the
    // call into hzstd_build_stacktrace itself and its callers inside the
    // instrumentation hook) that were never meant to be user-visible --
    // skipped here the same way print_frames_to_stderr and sbuf_frames
    // (hzstd_runtime.c) already do for panic stack traces.
    // Called once per memory-allocation capture (hundreds of thousands of times on a large
    // session) -- .reserve() here matters a lot more than it looks like it should: leaving
    // `frames` to grow from Haze's default tiny array capacity means every single call
    // regrows it from scratch via GC_realloc, and at this call volume that repeated regrowth
    // was observed (via a live gdb backtrace during a synthetic stress run) to keep tripping
    // Boehm's own heap-growth-triggered collection over and over -- 16 GC-marker threads
    // pegged at 100% CPU each, for tens of seconds, entirely inside this one array's growth.
    // The exact final size is already known up front (stacktrace.frames.length minus the
    // skipped internal frames, plus the leaf), so there's no reason to pay for incremental
    // growth at all.
    //
    // Produces the order CpuProfileBuilder.addSample wants -- OUTERMOST-first, since it
    // walks its input front-to-back descending the call tree (see addSamplesToProfile
    // above, which reverses for the same reason) -- with `leaf` appended last so it lands
    // deepest. A capture's own frames are innermost-first, so the reversal happens here,
    // written straight into the final array. Building the natural-order list first and
    // reversing it into a second array (which is what this used to do, from the call site)
    // cost an extra array and an extra full copy on every one of hundreds of thousands of
    // captures, for an intermediate that was discarded a line later.
    fn sampleFrameRefsForStacktrace(
        stacktrace: sys.Stacktrace,
        frameRefs: []ChromeTrace.FrameRef,
        leaf: ChromeTrace.FrameRef,
    ): []ChromeTrace.FrameRef {
        let frames: []ChromeTrace.FrameRef = [];
        frames.reserve(stacktrace.frames.length - stacktrace.skip_n_frames + 1);
        for (let i = stacktrace.frames.length - 1; i >= stacktrace.skip_n_frames; i--) {
            let stackframe = stacktrace.frames[i];
            // Normal path: the capture's frame index into the shared frame table (see
            // buildFrameRefTable). The range check is not expected to fail for anything this
            // profiler produces -- it exists so a stacktrace from some other source, whose
            // `id` means something else or nothing at all, degrades to the old build-it-here
            // behavior instead of panicking on an out-of-range index.
            if stackframe.id >= 0 && stackframe.id < frameRefs.length {
                frames.push(frameRefs[stackframe.id]);
            } else {
                frames.push(frameRefForStackFrame(stackframe));
            }
        }
        frames.push(leaf);
        return frames;
    }

    // Sampling is driven by PERF_COUNT_SW_CPU_CLOCK (see hzstd_profiling.c), which only ticks
    // while the profiled thread is actually consuming CPU time -- correct for a CPU profiler,
    // but it means a gap between two consecutive samples' wall-clock timestamps far larger than
    // one sampling interval doesn't mean "this code ran for that whole gap"; it means the thread
    // wasn't running at all for most of it (blocked on the GPU/compositor, a mutex, any syscall
    // -- or just descheduled). Left alone, that whole gap would get charged to whatever function
    // the earlier sample happened to land in, making an ordinary call look like it took hundreds
    // of milliseconds when the thread was simply off-CPU right after it. A generous multiple of
    // the nominal interval is enough to tell "normal scheduling jitter between two real samples"
    // apart from "the thread clearly wasn't running for a while" -- false positives here just
    // produce a slightly-too-early gap in the trace, which is cheap; false negatives would let
    // real stalls hide as fake slow functions again, which is the actual bug being fixed.
    //
    // Per-file feedback: off-CPU time should show up as nothing at all in the trace, not a
    // marker -- so an off-cpu gap simply isn't reported as a sample (see
    // ChromeTrace.CpuProfileBuilder's own doc comment on addSample: the next real sample's
    // timeDelta then spans the whole gap on its own). Lost samples are different: the kernel
    // (PERF_RECORD_LOST) reports a hard fact that real code definitely ran there, so that still
    // gets its own marker via addLostSamplesMarker.
    fn addSamplesToProfile(
        builder: mut ChromeTrace.CpuProfileBuilder,
        result: ProfilingResult,
        frameRefs: []ChromeTrace.FrameRef,
    ): void {
        let nominalIntervalUs = 1000000.0 / (result.sampling_rate_hz as real);
        let offCpuThresholdUs = nominalIntervalUs * 4.0;

        let lastTimeUs = 0.0;
        for (let s = 0; s < result.samples.length; s++) {
            let sample = result.samples[s];
            let timeUs = sample.timestamp * 1000000.0;

            if s > 0 {
                let delta = timeUs - lastTimeUs;
                if sample.lost_before > 0 {
                    // Hard fact from the kernel, not an inference from timing: real code
                    // definitely ran here, we just have no record of what it was. This takes
                    // priority over the off-cpu heuristic below -- finding out real samples
                    // existed here means the thread almost certainly *was* running, the opposite
                    // conclusion the off-cpu heuristic would otherwise draw from the same gap.
                    builder.addLostSamplesMarker(lastTimeUs + nominalIntervalUs, delta - nominalIntervalUs);
                } else if delta > offCpuThresholdUs {
                    // Off-CPU: the thread wasn't running for (most of) this gap. Emit nothing --
                    // no sample, no marker -- so the trace shows empty space here, per feedback.
                }
            }

            let frames: []ChromeTrace.FrameRef = [];
            frames.reserve(sample.frames.length);
            // sample.frames is innermost-first; CpuProfileBuilder.addSample wants outermost-first.
            // Each entry is already a frame-table index, so this is a lookup into the shared
            // table (see buildFrameRefTable) rather than a fresh FrameRef per sample per depth.
            for (let depth = sample.frames.length - 1; depth >= 0; depth--) {
                frames.push(frameRefs[sample.frames[depth]]);
            }
            builder.addSample(timeUs, frames, sample.truncated);

            lastTimeUs = timeUs;
        }
    }

    export fn buildCpuProfile(result: ProfilingResult): ChromeTrace.CpuProfile {
        return buildCpuProfile(result, buildFrameRefTable(result));
    }

    // Overload taking an already-built frame-ref table, so a caller that builds more than one
    // profile out of the same result (buildTrace builds both a CPU and an allocation profile)
    // pays for it once rather than once per profile.
    fn buildCpuProfile(result: ProfilingResult, frameRefs: []ChromeTrace.FrameRef): ChromeTrace.CpuProfile {
        let builder = ChromeTrace.CpuProfileBuilder();
        builder.reserveSamples(result.samples.length);
        addSamplesToProfile(builder, result, frameRefs);
        return builder.build();
    }

    export fn writeCpuProfile(result: ProfilingResult, path: str) {
        return ChromeTrace.writeCpuProfile(buildCpuProfile(result), path);
    }

    // ── trace.json export ────────────────────────────────────────────────────
    //
    // pid/tid layout mirrors real Chrome traces (one process, one main thread/track within it)
    // and leaves room to grow -- e.g. a future second Haze process (worker/subprocess) would get
    // pid 2 rather than requiring these ids to be renumbered.
    const hazeProcessPid = 1;
    const mainThreadTid = 1; // owns the "Profile"/"RunTask" stream, like Chrome's CrRendererMain
    // Allocations get their own track rather than sharing the main thread's:
    // they are a separate profile with its own call tree and its own time
    // axis, and interleaving two profiles' samples on one tid would make
    // DevTools merge them into a single, meaningless flame chart. The name is
    // not one DevTools recognizes, so this lands in ThreadType.OTHER and
    // sorts below the main thread (see the note on the Timings track below) --
    // which is the correct place for it now that it is a profile rather than
    // a marker stream.
    const allocationThreadTid = 2;

    // Mirrors hz_profiler_instrument_allocation_type (hzstd_memory.h) -- kept as a plain int on
    // the FFI struct (see ffi.hzstd_memory_instrumentation_frame_t) rather than a real enum type,
    // since hzstd_types.h (which that struct is defined against) is deliberately freestanding and
    // can't depend on hzstd_memory.h. Values must be kept in sync by hand.
    fn allocationKindName(allocationType: int): str {
        if allocationType == 0 { return "Heap alloc"; }       // hz_profiler_instrument_allocation_type_heap
        if allocationType == 1 { return "Grow"; }              // hz_profiler_instrument_allocation_type_heap_realloc
        if allocationType == 2 { return "Heap alloc"; }        // hz_profiler_instrument_allocation_type_heap_atomic
        if allocationType == 3 { return "Create"; }            // hz_profiler_instrument_allocation_type_arena_create
        if allocationType == 4 { return "Arena suballoc"; }    // hz_profiler_instrument_allocation_type_arena_suballoc (unused today)
        if allocationType == 5 { return "Grow"; }              // hz_profiler_instrument_allocation_type_arena_enlarge
        return "Allocation";
    }

    // Builds the human-readable marker name shown in the trace for one allocation capture:
    // "<Kind> <dataType> (<size> bytes)" when a dataType string was actually reported by the
    // compiler/runtime (see the big comment on hzstd_heap_allocate_n in hzstd_memory.h for which
    // allocations carry one -- struct instantiation and array creation always do; array growth
    // does via hzstd_dynamic_array_t::elementTypeName; a small number of internal-only runtime
    // allocations legitimately don't), falling back to just "<Kind> (<size> bytes)" otherwise.
    fn allocationMarkerName(frame: ffi.hzstd_memory_instrumentation_frame_t): str {
        let kind = allocationKindName(frame.allocationType);
        if frame.dataType.length > 0 {
            return f"{kind} {frame.dataType} ({frame.sizeBytes} bytes)";
        }
        return f"{kind} ({frame.sizeBytes} bytes)";
    }

    // Progress reporting cadence for the long per-capture loops below. Time-based rather
    // than count-based so the output rate stays the same whether a session has ten thousand
    // captures or ten million; the index test is only there to keep the clock read itself
    // off the innermost path.
    const progressIntervalSeconds = 0.1;
    const progressCheckInterval = 4096;

    export fn buildTrace(result: ProfilingResult): ChromeTrace.Trace {
        let builder = ChromeTrace.TraceBuilder(hazeProcessPid);
        // Sized for the real total, not just the addInstantMarker calls below: both
        // profiles also expand into one ProfileChunk event per chunkSampleCount samples,
        // and on a large session that tail is thousands of events. Reserving only for the
        // markers left those chunks to trigger one final doubling of an array that is
        // already hundreds of megabytes -- an allocate-and-copy of the whole thing, plus
        // the "very large block" GC warning that comes with it. See
        // TraceBuilder.reserveEvents.
        //
        // Mirrors ChromeTrace's own chunk granularity rather than reading it from there
        // (it is an unexported implementation detail of that namespace). This only ever
        // feeds a reserve(), so the two drifting apart costs at worst a slightly-off
        // estimate, never a wrong trace.
        const samplesPerProfileChunk = 100;
        let allocationCount = result.memoryInstrumentationFrames.length;
        builder.reserveEvents(
            allocationCount
                + allocationCount / samplesPerProfileChunk
                + result.samples.length / samplesPerProfileChunk
                + 16,
        );
        builder.addThread(mainThreadTid, "CrRendererMain", true);
        builder.addFrame(mainThreadTid, "HZFRAME0", "file:///haze");

        // Built once and shared by both profiles below -- see buildFrameRefTable.
        let frameRefs = buildFrameRefTable(result);

        let profile = buildCpuProfile(result, frameRefs);
        // This "task" block is what gives the CPU flame chart somewhere to render into (see
        // ChromeTrace's file header) and anchors the sample ordering invariant; the profiled
        // session is represented as a single task spanning its whole duration.
        builder.addTask(mainThreadTid, profile.startTime, profile.endTime - profile.startTime);
        builder.addCpuProfileSamples(mainThreadTid, profile.startTime, profile);

        // Deliberately NOT a separate "Heap Allocations" thread (that was the previous
        // approach): DevTools hardcodes thread-track order by thread TYPE, classified purely
        // from the thread's NAME (devtools-frontend's Threads.ts/getThreadTypeForRendererThread)
        // -- an unrecognized name always lands in ThreadType.OTHER, which
        // CompatibilityTracksAppender's threadTrackOrder always sorts below MAIN_THREAD (priority
        // 7 vs 0), unconditionally, regardless of tid, registration order, or thread_sort_index
        // (all three were tried and confirmed to have no effect on this specific decision -- see
        // git history). There is no trace.json-level way to outrank MAIN_THREAD via a second
        // thread.
        //
        // The actual fix: DevTools' Timings track (TimingsTrackAppender) is appended before any
        // thread tracks at all in CompatibilityTracksAppender's constructor -- it always renders
        // above every thread, main included, unconditionally. It's populated by UserTimingsHandler
        // scanning the WHOLE trace for cat: "blink.user_timing" events (see
        // Types.Events.isPerformanceMark / UserTimingsHandler.ts), independent of which tid an
        // event is attached to -- our addInstantMarker calls already emit exactly that category
        // (see ChromeTrace.TraceEventInstantMarker), so putting them on the main thread's own tid
        // is enough for them to land in the always-first Timings track; no second thread needed.
        // ── Allocations: a deduplicated call tree, not one marker each ──────
        //
        // This used to emit one PerformanceMark per allocation, each with its
        // ENTIRE stack inlined into the event (DevTools resolves neither `sf`
        // nor the stackFrames dictionary for that event shape -- see
        // TraceEventInstantMarker -- so the frames genuinely have to be
        // inline, and there is no way to make that shape small).
        //
        // The problem is not the frames, it is emitting them per allocation.
        // Measured on a real 15-second capture: 80,339 allocations, ~63
        // frames deep on average, producing 965 MB of stackTrace -- while the
        // whole session only ever visited 1,908 DISTINCT stacks. The same
        // ~1,900 call paths were written out tens of thousands of times each.
        // 5.4 million frames, of which 5.0 million were repeats. That is what
        // made a 10-second capture produce a 1.1 GB file that DevTools
        // refuses to load, take minutes to postprocess, and need >10 GB of
        // RAM to serialize.
        //
        // Chrome does not do this, and neither does the CPU half of this very
        // file. A V8 SamplingHeapProfile is a TREE: each unique call path is
        // one node, written once, and every sample is just
        // {size, nodeId, ordinal}. CpuProfileBuilder below already implements
        // exactly that structure -- the same dedup hash index, the same
        // parent links -- which is why 2,597 CPU chunks covering the same 15
        // seconds cost 19 MB while the allocations cost 965 MB. The encoding
        // was the entire difference.
        //
        // So the stacks now go through the same builder, as a call tree.
        //
        // But the tree ALONE is not a replacement, and shipping only the tree
        // was a regression: it put allocations on a second thread track, which
        // (per the long note just above) DevTools sorts below the main thread
        // and collapses by default, turning the allocation timeline into a
        // second, hidden flame chart instead of the marker timeline it used to
        // be. The Timings track is the only place that renders above every
        // thread, and only PerformanceMark-shaped events land in it.
        //
        // Hence both, each carrying the half it encodes efficiently:
        //
        //   markers (Timings track) -- one per allocation, carrying WHEN it
        //     happened, its type and its size, and NO stackTrace. Stackless is
        //     what makes them affordable: the stack was 99% of a marker's
        //     bytes (~12,000 of ~12,200), so dropping it takes the marker
        //     stream from 965 MB to ~16 MB while keeping the timeline, the
        //     labels, and the click-to-inspect args intact.
        //
        //   tree (its own track) -- every allocation's FULL stack, deduplicated
        //     so each distinct call path is stored exactly once.
        //
        // Nothing is lost relative to the original: the same per-allocation
        // timeline, and the same stacks, just no longer written out five
        // million times.
        if result.memoryInstrumentationFrames.length > 0 {
            let allocBuilder = ChromeTrace.CpuProfileBuilder();
            allocBuilder.reserveSamples(result.memoryInstrumentationFrames.length);

            // One empty list shared by every marker below rather than one built per
            // capture: addInstantMarker only ever reads it, and an empty array
            // literal inside this loop would be hundreds of thousands of
            // allocations that exist purely to be observed as empty.
            let noFrames: []ChromeTrace.FrameRef = [];

            // Marker stream and allocation profile are built in ONE pass over the
            // captures, not two. They feed different builders, so the interleaving
            // changes nothing about either one's contents or ordering -- but the two
            // passes each independently recomputed allocationMarkerName(frame) (two
            // formatted strings per capture, thrown away immediately), and each
            // independently re-read the capture. Once through, computing the name
            // once, does the same work for half the string formatting.
            let lastProgressAt = time.now();
            for (let i = 0; i < result.memoryInstrumentationFrames.length; i++) {
                let frame = result.memoryInstrumentationFrames[i];
                let markerName = allocationMarkerName(frame);
                let tsUs = frame.timestamp * 1000000.0;

                builder.addInstantMarker(
                    mainThreadTid,
                    tsUs,
                    markerName,
                    noFrames,
                    frame.dataType.length > 0 ? frame.dataType : none,
                    frame.sizeBytes,
                );

                // A CpuProfile sample carries no size/type of its own (V8's
                // SamplingHeapProfileNode has selfSize for exactly this; the
                // CPU shape has nowhere to put it). Rather than lose the two
                // things that make an allocation profile useful, they become
                // the LEAF frame of the stack -- "Heap alloc struct mut Foo
                // (8 bytes)" sits where the allocating function's callee
                // would be.
                //
                // That keeps every byte of information the old per-allocation
                // markers carried, and it dedups on exactly the right key:
                // two allocations of the same type and size from the same
                // call path collapse to one node (which is what makes this
                // small), while differing in type OR size keeps them apart
                // and separately countable. The flame chart then reads as
                // "this call path allocated N of these", which is the
                // question an allocation profile exists to answer.
                allocBuilder.addSample(
                    tsUs,
                    sampleFrameRefsForStacktrace(
                        frame.stacktrace,
                        frameRefs,
                        ChromeTrace.FrameRef { name: markerName, url: "", line: 0, column: 0 },
                    ),
                );

                // Turning captures into events is the longest silent stretch of a large
                // session, so report progress -- but on a time cadence, not per capture: at
                // this call volume an unconditional print per iteration costs far more than
                // the work being reported on (and time.now() itself is only worth asking a
                // few thousand times, hence the cheap index test guarding it).
                if i % progressCheckInterval == 0 {
                    let nowSeconds = time.now();
                    if nowSeconds - lastProgressAt >= progressIntervalSeconds {
                        fmt.print(f"\r  building allocation events {i} / {allocationCount}");
                        lastProgressAt = nowSeconds;
                    }
                }
            }
            fmt.print(f"\r  building allocation events {allocationCount} / {allocationCount}\n");

            builder.addThread(allocationThreadTid, "HeapAllocations");

            let allocProfile = allocBuilder.build();
            builder.addTask(
                allocationThreadTid,
                allocProfile.startTime,
                allocProfile.endTime - allocProfile.startTime,
            );
            builder.addCpuProfileSamples(allocationThreadTid, allocProfile.startTime, allocProfile);
        }

        return builder.build();
    }

    export fn toTraceJson(result: ProfilingResult): str {
        return ChromeTrace.traceToJson(buildTrace(result));
    }

    // `result` itself is still reachable as this function's own parameter for the rest of its
    // body even once buildTrace has no further use for it, so dropping its big array fields here
    // makes that backing data unreachable well before this function returns, instead of only
    // once traceToJson has already built its own large representation on top of it too.
    //
    // Deliberately NOT forcing a GC collection here (an earlier version of this function did,
    // via sys.forceGc/GC_gcollect): Haze's GC (Boehm) is a non-incremental, conservative
    // collector, and a forced full mark+sweep pass over a session with hundreds of thousands of
    // live objects is itself genuinely slow -- calling it right at each stage's local memory
    // peak (exactly where this function would otherwise call it) turned out to cost far more
    // wall-clock time than it saved, to the point of never finishing at all on a large session.
    // Dropping the reference is still worth doing on its own: it's what makes this data eligible
    // for reclamation whenever Boehm's own heap-growth heuristics next decide to collect, which
    // is what actually fixed the original leak (see hzstd_profiling_end's context->
    // memoryCapturesHead/samples_head/g_profiling_context handling) -- forcing an immediate,
    // synchronous, full-heap collection on top of that is a different (and here, net harmful)
    // thing.
    export fn writeTraceJson(result: ProfilingResult, path: str) {
        let trace = buildTrace(result);
        result.frames = [];
        result.samples = [];
        result.memoryInstrumentationFrames = [];
        // Streams event-by-event rather than materializing the whole file as
        // one string first (see ChromeTrace.writeTrace) -- that string used to
        // be the single largest allocation a profiling session made, and it
        // was live at the same time as everything it was built from.
        return ChromeTrace.writeTrace(trace, path);
    }
}

// Sampling rate is configurable via the constructor parameter (default 10 kHz):
// - samplingRate = 10000 (default): balanced accuracy and manageable postprocessing
// - samplingRate = 0: unlimited, use maximum kernel-allowed rate (Linux) or default (Windows)
// - samplingRate > 0: use as a ceiling; kernel throttling may reduce actual rate further
// The *achieved* rate -- actual samples per second -- shows up in ProfilingResult.sampling_rate_hz
// once a session ends. Only one profiling session can be active at a time; starting a second
// session while one is already running will panic immediately.
export struct Profiler {
    context: ffi.hzstd_profiling_context_t;

    struct Args {
        samplingRate: int = 10000;
        memoryInstrumentation: bool = true;
        memoryInstrumentationStacktraces: bool = true;
    }

    fn constructor(args: Args = {}) {
        fmt.println(f"Profiling started @ {args.samplingRate > 0 ? args.samplingRate : "any"} Hz");
        let context = ffi.hzstd_profiling_start(args.samplingRate, args.memoryInstrumentation, args.memoryInstrumentationStacktraces);
        return Profiler {
            context: context,
        };
    }

    // TODO: This profiler must turn into a resource so it's panic recovery safe
    //
    // hzstd_profiling_end itself prints postprocessing progress (sample counts,
    // lost/throttled counts, a live "unwinding sample N / total" counter) straight
    // to stdout as it happens, since that work can take real, visible time on a
    // large session -- nothing needs to be printed here beforehand or afterward.
    fn stop(): profiling.ProfilingResult {
        return ffi.hzstd_profiling_end(this.context);
    }

    // Dispatches on `path`'s extension: ".cpuprofile" writes the legacy Chrome DevTools /
    // V8 CPU profiler format (still just today's cpu-only data), anything else (default
    // "out.trace.json") writes a Chrome trace -- the format going forward, since it can also
    // carry whatever the FFI layer starts reporting beyond CPU samples (e.g. memory
    // instrumentation) that .cpuprofile has no room for.
    fn stopAndSave(path: str = "trace.json") {
        const result = this.stop();
        let r = path.endsWith(".cpuprofile") ? profiling.writeCpuProfile(result, path) : profiling.writeTraceJson(result, path);
        fmt.println(f"Results were written to {path}");
        return r;
    }
}

namespace profiling {

    // ── scoped profiling ─────────────────────────────────────────────────────
    //
    // The wrap-a-closure form of the manual API: everything the closure does is
    // profiled, nothing before or after it is. This is the same Profiler +
    // stopAndSave pair a caller would otherwise write by hand -- the point is
    // that the stop/save half can't be forgotten or skipped, which matters
    // because a still-running session makes the *next* Profiler() panic (only
    // one session can be active at a time, see hzstd_profiling_start).
    //
    // Settings come from the same Profiler.Args as the manual API, so a scoped
    // profile can be tuned exactly like a hand-written one:
    //
    //     profiling.profile(() => { hotLoop(); });
    //     profiling.profile(() => { hotLoop(); }, "loop.trace.json");
    //     profiling.profile(() => { hotLoop(); }, "loop.trace.json", { samplingRate: 1000 });
    //
    // Deliberately returns void rather than forwarding the closure's own return
    // value: a generic `TRet` here would force every call site that profiles a
    // plain statement block to pin down a return type it doesn't have.
    export fn profile(body: () => void, path: str = "trace.json", args: Profiler.Args = {}): void {
        let profiler = Profiler(args);
        body();
        profiler.stopAndSave(path);
    }

    // ── automatic whole-program profiling ────────────────────────────────────
    //
    // Called by compiler-generated `main` (see CodeGenerator.ts) around the
    // user's own main function, on EVERY build -- so this must stay cheap and
    // completely invisible unless profiling was actually requested. The only
    // work done in the common case is one getenv.
    //
    // Configuration is by environment variable rather than by compiled-in
    // constants on purpose: an already-compiled binary must be profilable
    // without rebuilding it (`HAZE_PROFILE=1 ./myapp`), and `haze run --profile`
    // is then just the compiler setting the same variables before spawning that
    // same binary (ProjectCompiler.run). One mechanism, two entry points.
    //
    //   HAZE_PROFILE                        enable ("0"/"false"/"" disables)
    //   HAZE_PROFILE_OUT                    output path (default "trace.json")
    //   HAZE_PROFILE_SAMPLING_RATE          sampling rate in Hz (default 10000, 0 = unlimited)
    //   HAZE_PROFILE_MEMORY                 memory instrumentation (default on)
    //   HAZE_PROFILE_MEMORY_STACKTRACES     stacktraces for allocations (default on)
    export fn autoProfileEnabled(): bool {
        return envFlag("HAZE_PROFILE", false);
    }

    // ASCII-case-insensitive equality. The stdlib has no case helpers on `str`
    // (String's own buffer API is the only case-conversion path, see
    // vim_behavior.toLowerStr), and building a lowercased copy just to compare
    // it against four short literals would allocate on a path that runs during
    // startup of every profiled process -- so the fold happens per byte, inline.
    fn equalsIgnoreCase(value: str, lower: str): bool {
        if value.length != lower.length {
            return false;
        }
        for (let i = 0; i < value.length; i++) {
            let b = value[i];
            if b >= b"A" && b <= b"Z" {
                b = b + 32 as u8;
            }
            if b != lower[i] {
                return false;
            }
        }
        return true;
    }

    // "0"/"false"/"no"/"off", and a variable that's set but empty, all read as
    // off; any other value reads as on. This is what makes `HAZE_PROFILE=0
    // ./myapp` mean what it looks like it means, instead of the bare-presence
    // check that would treat it as enabled.
    fn envFlag(name: str, fallback: bool): bool {
        let value = env.get(name);
        if !value {
            return fallback;
        }
        if value.length == 0 {
            return false;
        }
        if equalsIgnoreCase(value, "0") || equalsIgnoreCase(value, "false")
            || equalsIgnoreCase(value, "no") || equalsIgnoreCase(value, "off") {
            return false;
        }
        return true;
    }

    // Plain non-negative decimal parse. Anything unparseable (empty, a stray
    // sign, trailing junk) falls back rather than panicking: a malformed
    // sampling rate in the environment should degrade to the default, not take
    // down a program that was merely asked to profile itself.
    fn envInt(name: str, fallback: int): int {
        let value = env.get(name);
        if !value {
            return fallback;
        }
        if value.length == 0 {
            return fallback;
        }
        let parsed = 0;
        for (let i = 0; i < value.length; i++) {
            let b = value[i];
            if !ascii.isDigit(b) {
                return fallback;
            }
            parsed = parsed * 10 + ((b - b"0") as int);
        }
        return parsed;
    }

    export fn autoProfileArgs(): Profiler.Args {
        return Profiler.Args {
            samplingRate: envInt("HAZE_PROFILE_SAMPLING_RATE", 10000),
            memoryInstrumentation: envFlag("HAZE_PROFILE_MEMORY", true),
            memoryInstrumentationStacktraces: envFlag("HAZE_PROFILE_MEMORY_STACKTRACES", true),
        };
    }

    export fn autoProfileOutputPath(): str {
        let path = env.get("HAZE_PROFILE_OUT");
        if path {
            return path;
        }
        return "trace.json";
    }

    // ── the two hooks compiler-generated `main` calls ────────────────────────
    //
    // Generated `main` brackets the call to the user's own main with these (see
    // CodeGenerator.ts), so the profiled region is exactly "the entire program"
    // -- startup through termination -- which is what an unmodified binary asked
    // to profile itself can meaningfully mean.
    //
    // Deliberately a begin/end PAIR of zero-argument functions rather than the
    // one closure-taking wrapper this otherwise wants to be: generated `main` is
    // emitted as raw C text that calls Haze symbols by hand-built mangled name
    // (the same `_HN...Ev` pattern already used for the user's main itself), and
    // a zero-argument, non-generic, namespace-level function is the one shape
    // that pattern can spell without the compiler resolving a real symbol. A
    // closure parameter would additionally mean constructing a Haze closure
    // value in C, which has no stable hand-writable representation at all.
    //
    // The session handle is module-level state rather than something threaded
    // between the two calls for the same reason -- generated `main` has nowhere
    // to put a Haze-typed local. Only one profiling session can be active at a
    // time anyway (hzstd_profiling_start panics otherwise), so there is nothing
    // a second concurrent auto-session could have meant.
    //
    // When profiling wasn't requested, beginAutoProfiling is a single getenv and
    // endAutoProfiling does nothing at all: an instrumented-but-not-profiling
    // build must behave identically to one without these hooks.
    //
    // Note this cannot catch a program that exits via sys.exit() rather than by
    // returning from main -- that terminates the process immediately, so
    // endAutoProfiling never runs and no trace is written. Returning from main
    // is the supported shape for whole-program profiling.
    let autoProfiler: Profiler | none = none;

    export fn beginAutoProfiling(): void {
        if !autoProfileEnabled() {
            return;
        }
        autoProfiler = Profiler(autoProfileArgs());
    }

    export fn endAutoProfiling(): void {
        if autoProfiler is Profiler {
            autoProfiler.stopAndSave(autoProfileOutputPath());
            autoProfiler = none;
        }
    }
}
