namespace ffi {
    extern C noemit fn hzstd_profiling_start(sampling_rate_hz: int, memoryInstrumentation: bool, memoryInstrumentationStacktraces: bool): hzstd_profiling_context_t :: final;
    extern C noemit fn hzstd_profiling_end(session: hzstd_profiling_context_t): hzstd_profiling_result_t :: final;

    export extern C noemit ref struct hzstd_profiling_context_t {};

    export extern C noemit opaque struct hzstd_profiling_frame_t {
        address: cptr;
        name: str;
        sourceloc: SourceLocation;
    };

    export extern C noemit opaque struct hzstd_profiling_sample_t {
        timestamp: real;
        sampling_duration: real;
        frames: mut []int;
        truncated: bool;
        lost_before: int;
        thread: int;
        cpu: real;
    };

    // The scheduler's record (docs/profiler-timelines.md). The numbers mirror
    // hzstd_sched_event_kind_t and hzstd_sched_run_end_t (hzstd_types.h).
    export extern C noemit opaque struct hzstd_profiling_thread_t {
        id: int;
        os_tid: int;
    };

    export extern C noemit opaque struct hzstd_profiling_task_t {
        id: int;
        parent: int;
        thread: int;
        spawned_at: SourceLocation;
        background: bool;
    };

    export extern C noemit opaque struct hzstd_profiling_sched_event_t {
        thread: int;
        time: real;
        kind: int;
        task: int;
        reason: int;
        cpu: real;
    };

    export extern C noemit opaque struct hzstd_memory_instrumentation_frame_t {
        stacktrace: hzstd_stacktrace_t;
        timestamp: real;
        sizeBytes: int;
        // Mirrors hz_profiler_instrument_allocation_type (hzstd_memory.h) --
        // see profiling.allocationKindName for the int -> label mapping.
        allocationType: int;
        dataType: str; // empty string = absent
    };

    export extern C noemit opaque struct hzstd_profiling_result_t {
        frames: mut []hzstd_profiling_frame_t;
        samples: []hzstd_profiling_sample_t;
        sampling_rate_hz: int;
        memoryInstrumentationFrames: []hzstd_memory_instrumentation_frame_t;
        threads: []hzstd_profiling_thread_t;
        tasks: []hzstd_profiling_task_t;
        schedEvents: []hzstd_profiling_sched_event_t;
    };
}

// ── profiling ────────────────────────────────────────────────────────────
//
// This is the adapter between hzstd's raw FFI profiling output and
// ChromeTrace (stdlib/core/src/chrome-trace.hz), which owns every detail of
// how Chrome/V8/DevTools actually want that data shaped on the wire. This
// file should never need to know what a "ProfileChunk" is, or which trace
// event names DevTools recognizes -- only what hzstd's samples/frames mean
// and how to turn them into ChromeTrace.FrameRef sequences.
namespace profiling {
    export type Frame = ffi.hzstd_profiling_frame_t;
    export type Sample = ffi.hzstd_profiling_sample_t;
    export type ProfilingResult = ffi.hzstd_profiling_result_t;

    // hzstd_profiling_frame_t (an address + name + source location) ->
    // ChromeTrace.FrameRef. Haze source locations are 1-indexed with 0
    // meaning absent, which is exactly FrameRef's own convention, so no
    // conversion happens here -- ChromeTrace does whatever index shifting
    // each output format needs internally.
    fn frameRefForFrame(frame: Frame): ChromeTrace.FrameRef {
        return frameRefForNameAndLoc(frame.name, frame.sourceloc);
    }

    // Same conversion as frameRefForFrame above, but for sys.StackFrame
    // (the type used by memoryInstrumentationFrames' stacktraces) -- an
    // unrelated FFI ref struct that happens to share the same name/sourceloc
    // shape, so both funnel through this one implementation.
    fn frameRefForStackFrame(frame: sys.StackFrame): ChromeTrace.FrameRef {
        return frameRefForNameAndLoc(frame.name, frame.sourceloc);
    }

    // One FrameRef per entry of the profile's frame table, hashed once, ready to be handed
    // out by index.
    //
    // Both sample kinds address their frames by exactly this index already: a CPU sample's
    // `frames` are indices into result.frames outright, and a memory capture's
    // sys.StackFrame carries the same index as its `id` (hzstd_profiling.c sets it from the
    // frame-table index when it resolves the capture). So neither of them ever needs to
    // build a FrameRef -- or re-resolve a source location, or re-hash a function name --
    // more than once for a given frame, no matter how many samples land on it.
    //
    // That matters because the two are wildly different magnitudes: a large session has a
    // few thousand distinct frames but tens of millions of (sample, depth) pairs referring
    // to them. Building the FrameRef at each pair, as this used to, meant re-doing all of
    // that work millions of times over the same few thousand frames.
    fn buildFrameRefTable(result: ProfilingResult): []ChromeTrace.FrameRef {
        let frameRefs: mut []ChromeTrace.FrameRef = [];
        frameRefs.reserve(result.frames.length);
        for (let i = 0; i < result.frames.length; i++) {
            frameRefs.push(ChromeTrace.frameRefWithHash(frameRefForFrame(result.frames[i])));
        }
        return frameRefs;
    }

    fn frameRefForNameAndLoc(name: str, sourceloc: SourceLocation): ChromeTrace.FrameRef {
        let filename = sourceloc.filename();
        let line = sourceloc.line();
        return ChromeTrace.FrameRef {
            name: name.length > 0 ? name : "(unknown)",
            url: filename ? filename : "",
            line: line ? line : 0,
            column: 0,
        };
    }

    // stacktrace.frames[0 .. skip_n_frames) are internal hzstd frames (the
    // call into hzstd_build_stacktrace itself and its callers inside the
    // instrumentation hook) that were never meant to be user-visible --
    // skipped here the same way print_frames_to_stderr and sbuf_frames
    // (hzstd_runtime.c) already do for panic stack traces.
    // Called once per memory-allocation capture (hundreds of thousands of times on a large
    // session) -- .reserve() here matters a lot more than it looks like it should: leaving
    // `frames` to grow from Haze's default tiny array capacity means every single call
    // regrows it from scratch via GC_realloc, and at this call volume that repeated regrowth
    // was observed (via a live gdb backtrace during a synthetic stress run) to keep tripping
    // Boehm's own heap-growth-triggered collection over and over -- 16 GC-marker threads
    // pegged at 100% CPU each, for tens of seconds, entirely inside this one array's growth.
    // The exact final size is already known up front (stacktrace.frames.length minus the
    // skipped internal frames, plus the leaf), so there's no reason to pay for incremental
    // growth at all.
    //
    // Produces the order CpuProfileBuilder.addSample wants -- OUTERMOST-first, since it
    // walks its input front-to-back descending the call tree (see addSamplesToProfile
    // above, which reverses for the same reason) -- with `leaf` appended last so it lands
    // deepest. A capture's own frames are innermost-first, so the reversal happens here,
    // written straight into the final array. Building the natural-order list first and
    // reversing it into a second array (which is what this used to do, from the call site)
    // cost an extra array and an extra full copy on every one of hundreds of thousands of
    // captures, for an intermediate that was discarded a line later.
    fn sampleFrameRefsForStacktrace(
        stacktrace: sys.Stacktrace,
        frameRefs: []ChromeTrace.FrameRef,
        leaf: ChromeTrace.FrameRef,
    ): []ChromeTrace.FrameRef {
        let frames: mut []ChromeTrace.FrameRef = [];
        frames.reserve(stacktrace.frames.length - stacktrace.skip_n_frames + 1);
        for (let i = stacktrace.frames.length - 1; i >= stacktrace.skip_n_frames; i--) {
            let stackframe = stacktrace.frames[i];
            // Normal path: the capture's frame index into the shared frame table (see
            // buildFrameRefTable). The range check is not expected to fail for anything this
            // profiler produces -- it exists so a stacktrace from some other source, whose
            // `id` means something else or nothing at all, degrades to the old build-it-here
            // behavior instead of panicking on an out-of-range index.
            if stackframe.id >= 0 && stackframe.id < frameRefs.length {
                frames.push(frameRefs[stackframe.id]);
            } else {
                frames.push(frameRefForStackFrame(stackframe));
            }
        }
        frames.push(leaf);
        return frames;
    }

    // Sampling is driven by PERF_COUNT_SW_CPU_CLOCK (see hzstd_profiling.c), which only ticks
    // while the profiled thread is actually consuming CPU time -- correct for a CPU profiler,
    // but it means a gap between two consecutive samples' wall-clock timestamps far larger than
    // one sampling interval doesn't mean "this code ran for that whole gap"; it means the thread
    // wasn't running at all for most of it (blocked on the GPU/compositor, a mutex, any syscall
    // -- or just descheduled). Left alone, that whole gap would get charged to whatever function
    // the earlier sample happened to land in, making an ordinary call look like it took hundreds
    // of milliseconds when the thread was simply off-CPU right after it. A generous multiple of
    // the nominal interval is enough to tell "normal scheduling jitter between two real samples"
    // apart from "the thread clearly wasn't running for a while" -- false positives here just
    // produce a slightly-too-early gap in the trace, which is cheap; false negatives would let
    // real stalls hide as fake slow functions again, which is the actual bug being fixed.
    //
    // Per-file feedback: off-CPU time should show up as nothing at all in the trace, not a
    // marker -- so an off-cpu gap simply isn't reported as a sample (see
    // ChromeTrace.CpuProfileBuilder's own doc comment on addSample: the next real sample's
    // timeDelta then spans the whole gap on its own). Lost samples are different: the kernel
    // (PERF_RECORD_LOST) reports a hard fact that real code definitely ran there, so that still
    // gets its own marker via addLostSamplesMarker.
    // Emits both kinds of sample this profiler produces into ONE profile, walked in
    // timestamp order: the CPU sampler's stacks, and -- when `allocationLeaves` is non-empty
    // -- one sample per instrumented allocation whose stack is the capture's own, with the
    // allocation itself as the leaf frame.
    //
    // They belong on one timeline because they ARE one timeline: hzstd_profiling.c
    // deliberately derives both timestamps from the same CLOCK_MONOTONIC reference (see the
    // comment on perf_time_ref_ns/memoryInstrumentationTimeRef there), precisely so the two
    // can be related to each other. Emitting them as two separate profiles on two thread
    // tracks -- which is what this used to do -- threw that away: it produced two flame
    // charts of the same thread that could not be read against each other, at wildly
    // different densities, neither of which was the whole story.
    //
    // The two are not the same KIND of measurement, and the merged chart shows that honestly
    // rather than hiding it: CPU frames are sampled, so their widths are statistical, while
    // allocations are instrumented, so each one is an exact event. A burst of allocations
    // inside one sampled call renders as exactly that -- many precise leaves under one
    // approximate parent.
    //
    // `allocationSampleTimesUs` receives, per allocation and in the same order as
    // `allocationLeaves`, the timestamp the allocation's sample will RECONSTRUCT to in
    // the profile (what CpuProfileBuilder.addSample returns) -- the allocation's
    // Timings-track marker has to be placed at exactly that value, not at the capture's
    // own timestamp, so that the two halves of one allocation coincide on the timeline.
    // See the marker loop in buildTrace.
    fn addSamplesToProfile(
        builder: mut ChromeTrace.CpuProfileBuilder,
        result: ProfilingResult,
        frameRefs: []ChromeTrace.FrameRef,
        allocationLeaves: []str,
        allocationSampleTimesUs: mut []real,
        thread: int,
    ): void {
        let nominalIntervalUs = 1000000.0 / (result.sampling_rate_hz as real);
        let offCpuThresholdUs = nominalIntervalUs * 4.0;

        // Built once, reused for every gap below -- see the off-CPU branch.
        let idleFrames: mut []ChromeTrace.FrameRef = [];
        idleFrames.push(ChromeTrace.FrameRef { name: "(idle)", url: "", line: 0, column: 0 });

        // Timestamps handed to addSample must never go backwards (it turns them into
        // timeDeltas, and a negative delta corrupts every timestamp a viewer reconstructs
        // after it). Merging two independently-ordered streams -- and allocation captures
        // are timestamped before they take the append lock, so captures from different
        // threads can land slightly out of order -- makes that a real possibility rather
        // than a theoretical one, so every emitted timestamp is clamped to the last one.
        let lastEmittedUs = 0.0;

        let cpuIndex = 0;
        let allocIndex = 0;

        // Timestamp of the last event that is EVIDENCE THE THREAD WAS RUNNING -- a CPU
        // sample or an instrumented allocation, whichever came last -- as opposed to
        // lastEmittedUs, which also moves for synthetic "(idle)" samples this loop
        // invents itself.
        //
        // Both kinds count, and that is the whole point of tracking this separately from
        // the CPU stream alone. An allocation capture is an instrumented event: it exists
        // because that line of code actually executed, which is exactly as strong a proof
        // that the thread was on-CPU at that instant as a CPU sample is. So a gap is only
        // off-CPU time if NEITHER kind of event appears in it.
        //
        // Measuring the gap against the previous CPU sample only (what this used to do,
        // with the whole check living inside the CPU branch below) got both halves of that
        // wrong, and the two failures compounded:
        //
        //   - A gap BOUNDED BY ALLOCATIONS was never even looked at. If an allocation was
        //     the last event before the thread went off-CPU and another allocation was the
        //     first event after it -- which is the normal shape of a frame-paced render
        //     loop, where the wait for the next swapchain image sits between two bursts of
        //     Haze allocations -- the loop emitted the two allocations back to back with
        //     nothing in between, and every viewer drew the FIRST one as spanning the
        //     entire wait. That is where "Heap alloc ... WGPUSurfaceTexture (24 bytes)"
        //     came to be shown as a 15 ms call. Measured on a real 3.7 s session: 1.58 s
        //     (42% of the whole timeline) sat under allocation leaves drawn this way.
        //   - When the gap WAS noticed (because a CPU sample happened to follow it), the
        //     idle sample still got placed by clamping against lastEmittedUs, so any
        //     allocation that had landed after the gap pushed the idle marker past the gap
        //     it was describing -- a zero-width "(idle)" on the wrong side of the pause,
        //     with the pause itself still charged to whatever preceded it.
        let lastActivityUs = 0.0;
        let haveActivity = false;

        while cpuIndex < result.samples.length || allocIndex < allocationLeaves.length {
            // Another thread's sample belongs to that thread's profile.
            if cpuIndex < result.samples.length && result.samples[cpuIndex].thread != thread {
                cpuIndex++;
                continue;
            }
            // Whichever stream's next entry is older goes first.
            let takeCpuSample = true;
            if cpuIndex >= result.samples.length {
                takeCpuSample = false;
            } else if allocIndex < allocationLeaves.length {
                takeCpuSample = result.samples[cpuIndex].timestamp
                    <= result.memoryInstrumentationFrames[allocIndex].timestamp;
            }

            // The next event's timestamp -- and, for a CPU sample, whether the kernel
            // reported samples lost right before it -- resolved BEFORE anything is
            // emitted, because the gap handling below has to run against it and is
            // identical for both kinds of event.
            let eventTimeUs = 0.0;
            let lostBefore = 0;
            if takeCpuSample {
                eventTimeUs = result.samples[cpuIndex].timestamp * 1000000.0;
                lostBefore = result.samples[cpuIndex].lost_before;
            } else {
                eventTimeUs = result.memoryInstrumentationFrames[allocIndex].timestamp * 1000000.0;
            }
            if eventTimeUs < lastEmittedUs {
                eventTimeUs = lastEmittedUs;
            }

            if haveActivity {
                if lostBefore > 0 {
                    // Hard fact from the kernel, not an inference from timing: real code
                    // definitely ran here, we just have no record of what it was. This takes
                    // priority over the off-cpu heuristic below -- finding out real samples
                    // existed here means the thread almost certainly *was* running, the opposite
                    // conclusion the off-cpu heuristic would otherwise draw from the same gap.
                    //
                    // Clamped to lastEmittedUs like every other emitted timestamp: allocation
                    // captures can have been emitted since the last CPU sample, and handing the
                    // builder a timestamp behind those would push a NEGATIVE timeDelta into the
                    // profile, which corrupts every timestamp reconstructed after it.
                    // Starts one nominal interval after the last real event (which
                    // therefore keeps its normal width) and runs up to this sample, whose
                    // own emission right below is what gives the marker that width -- no
                    // duration is passed or needed, see addLostSamplesMarker.
                    let markerStartUs = lastActivityUs + nominalIntervalUs;
                    if markerStartUs < lastEmittedUs {
                        markerStartUs = lastEmittedUs;
                    }
                    if markerStartUs > eventTimeUs {
                        markerStartUs = eventTimeUs;
                    }
                    builder.addLostSamplesMarker(markerStartUs);
                    lastEmittedUs = markerStartUs;
                } else if eventTimeUs - lastActivityUs > offCpuThresholdUs {
                    // Off-CPU: the thread wasn't running for (most of) this gap.
                    //
                    // Emitting NOTHING here (what this used to do, intending to leave the trace
                    // blank) does not produce blank space -- it produces a lie. Every flame chart
                    // derives sample i's on-screen width from timestamp[i+1] - timestamp[i], so a
                    // skipped gap is silently absorbed by the sample BEFORE it: whatever happened
                    // to be on the CPU when the thread went to sleep gets drawn as though it ran
                    // for the entire pause. Measured on a real session: a sample sitting in
                    // GC_pause, followed by a 2.94s wait, rendered as a single 2.94-second-wide
                    // GC_pause block -- and 3.35s of a 4.95s timeline was gaps drawn this way.
                    // That also erases exactly the pattern a frame-paced app should show: every
                    // vsync wait gets charged to the last function that ran before it, so a
                    // perfectly idle 60fps loop reads as 100% busy.
                    //
                    // So the gap gets its own explicit sample instead, starting one nominal
                    // interval after the last real one (which therefore keeps its normal width).
                    // "(idle)" is V8's own name for this in a .cpuprofile, so DevTools already
                    // understands what it is rather than showing it as a mystery function.
                    let idleStartUs = lastActivityUs + nominalIntervalUs;
                    if idleStartUs < lastEmittedUs {
                        idleStartUs = lastEmittedUs;
                    }
                    builder.addSample(idleStartUs, idleFrames);
                    lastEmittedUs = idleStartUs;
                }
            }

            if !takeCpuSample {
                let capture = result.memoryInstrumentationFrames[allocIndex];
                // A CpuProfile sample carries no size/type of its own (V8's
                // SamplingHeapProfileNode has selfSize for exactly this; the CPU shape has
                // nowhere to put it), so they become the LEAF frame instead -- "Heap alloc
                // ref struct mut Foo (8 bytes)" sits where the allocating function's callee
                // would be. That also dedups on exactly the right key: same type, same size,
                // same call path collapses to one node, while differing in either keeps them
                // apart and separately countable.
                let emittedUs = builder.addSample(
                    eventTimeUs,
                    sampleFrameRefsForStacktrace(
                        capture.stacktrace,
                        frameRefs,
                        ChromeTrace.FrameRef { name: allocationLeaves[allocIndex], url: "", line: 0, column: 0 },
                    ),
                );
                allocationSampleTimesUs.push(emittedUs);
                allocIndex = allocIndex + 1;
            } else {
                let sample = result.samples[cpuIndex];
                cpuIndex = cpuIndex + 1;

                let frames: mut []ChromeTrace.FrameRef = [];
                frames.reserve(sample.frames.length);
                // sample.frames is innermost-first; CpuProfileBuilder.addSample wants outermost-first.
                // Each entry is already a frame-table index, so this is a lookup into the shared
                // table (see buildFrameRefTable) rather than a fresh FrameRef per sample per depth.
                for (let depth = sample.frames.length - 1; depth >= 0; depth--) {
                    frames.push(frameRefs[sample.frames[depth]]);
                }
                builder.addSample(eventTimeUs, frames, sample.truncated);
            }

            lastEmittedUs = eventTimeUs;
            lastActivityUs = eventTimeUs;
            haveActivity = true;
        }
    }

    export fn buildCpuProfile(result: ProfilingResult): ChromeTrace.CpuProfile {
        return buildCpuProfile(result, buildFrameRefTable(result));
    }

    // Overload taking an already-built frame-ref table, so a caller that builds more than one
    // profile out of the same result (buildTrace builds both a CPU and an allocation profile)
    // pays for it once rather than once per profile.
    fn buildCpuProfile(result: ProfilingResult, frameRefs: []ChromeTrace.FrameRef): ChromeTrace.CpuProfile {
        // No allocation leaves: the legacy .cpuprofile shape is a pure CPU profile, and
        // nothing reading it expects instrumented events mixed in. buildTrace passes real
        // leaves (see there); this path passes none.
        let noAllocationLeaves: []str = [];
        let noAllocationSampleTimes: mut []real = [];
        let builder = ChromeTrace.CpuProfileBuilder();
        builder.reserveSamples(result.samples.length);
        addSamplesToProfile(builder, result, frameRefs, noAllocationLeaves, noAllocationSampleTimes, mainThreadTid);
        return builder.build();
    }

    export fn writeCpuProfile(result: ProfilingResult, path: str) {
        return ChromeTrace.writeCpuProfile(buildCpuProfile(result), path);
    }

    // ── trace.json export ────────────────────────────────────────────────────
    //
    // pid/tid layout mirrors real Chrome traces (one process, one main thread/track within it)
    // and leaves room to grow -- e.g. a future second Haze process (worker/subprocess) would get
    // pid 2 rather than requiring these ids to be renumbered.
    // ── The scheduler's timeline (docs/profiler-timelines.md) ───────────────
    //
    // Per Haze thread: a bar per task run above the run's samples, the event
    // loop's turns between runs, collections, and (Linux, from the kernel's
    // switch records) every stretch the thread was off its CPU. The same runs
    // and stretches go to extension tracks, with colours and properties.
    //
    // The numbers of hzstd_sched_event_kind_t and hzstd_sched_run_end_t.
    const eventRunBegin = 0;
    const eventRunEnd = 1;
    const eventLoopBegin = 2;
    const eventLoopEnd = 3;
    const eventGcBegin = 4;
    const eventGcEnd = 5;
    const eventWorldStopped = 6;
    const eventWorldStarted = 7;
    const eventStall = 8;
    const eventOsOut = 9;
    const eventOsIn = 10;
    const eventKilled = 12;

    const extensionGroup = "Haze";

    fn runEndName(reason: int): str {
        if reason == 0 { return "yield"; }
        if reason == 1 { return "join"; }
        if reason == 2 { return "sleep"; }
        if reason == 3 { return "suspend"; }
        if reason == 4 { return "end"; }
        return "session end";
    }

    // "1.25 ms", to the hundredth.
    fn millis(seconds: real): str {
        let hundredths = (seconds * 100000.0 + 0.5) as int;
        let frac = hundredths % 100;
        return f"{hundredths / 100}.{frac < 10 ? "0" : ""}{frac} ms";
    }

    fn fileName(path: str): str {
        let start = 0;
        for (let i = 0; i < path.length; i++) {
            let c = path.slice(i, i + 1);
            if c == "/" || c == "\\" {
                start = i + 1;
            }
        }
        return path.slice(start, path.length);
    }

    export fn threadName(thread: int): str {
        return thread == 1 ? "main" : f"thread {thread}";
    }

    // The tasks' indices, sorted by id, for taskAt.
    fn taskOrder(result: ProfilingResult): []int {
        let order: mut []int = [];
        order.reserve(result.tasks.length);
        for (let i = 0; i < result.tasks.length; i++) {
            order.push(i);
        }
        order.sort((a: int, b: int) => {
            let ia = result.tasks[a].id;
            let ib = result.tasks[b].id;
            return ia < ib ? -1 : (ia > ib ? 1 : 0);
        });
        return order;
    }

    // The index of the task with this id in result.tasks, -1 if unknown.
    fn taskAt(result: ProfilingResult, order: []int, id: int): int {
        let lo = 0;
        let hi = order.length - 1;
        while lo <= hi {
            let mid = lo + (hi - lo) / 2;
            let found = result.tasks[order[mid]].id;
            if found == id {
                return order[mid];
            }
            if found < id {
                lo = mid + 1;
            } else {
                hi = mid - 1;
            }
        }
        return -1;
    }

    export fn taskLabel(result: ProfilingResult, index: int, id: int): str {
        if index < 0 {
            return f"task {id}";
        }
        let task = result.tasks[index];
        let file = task.spawned_at.filename();
        if file {
            return f"task {id} {fileName(file)}:{task.spawned_at.line() ?? 0}";
        }
        return task.parent == 0 && id == 1 ? "task 1 main" : f"task {id} runtime";
    }

    fn spawnSite(result: ProfilingResult, index: int): str {
        if index < 0 {
            return "unknown";
        }
        let at = result.tasks[index].spawned_at;
        let file = at.filename();
        return file ? f"{file}:{at.line() ?? 0}:{at.column() ?? 0}" : "the runtime";
    }

    // The extension palette (devtools-frontend models/trace/types/Extensions.ts),
    // without the two colours that mean something: error and warning.
    fn taskColor(id: int): str {
        let palette: []str = [
            "primary", "secondary", "tertiary", "primary-light", "secondary-light",
            "tertiary-light", "primary-dark", "secondary-dark", "tertiary-dark",
        ];
        return palette[id % palette.length];
    }

    struct Bar {
        beginUs: real;
        endUs: real;
        data: ChromeTrace.TraceEventDispatch.Args.Data;
    }

    // The thread's bars, and its extension track entries straight into the
    // builder. A run, a loop turn, a collection and an off-CPU stretch nest by
    // time; see addBars for how they are kept a tree.
    fn threadBars(builder: mut ChromeTrace.TraceBuilder, result: ProfilingResult, order: []int, thread: int): mut []Bar {
        let bars: mut []Bar = [];
        let name = threadName(thread);
        let tasksTrack = f"{name} tasks";
        let cpuTrack = f"{name} CPU";
        let runCounts: mut []int = [];
        for (let i = 0; i < result.tasks.length; i++) {
            runCounts.push(0);
        }
        let runBegin = -1.0;
        let runTask = 0;
        let runCpu = -1.0;
        let runNote = "";
        let loopBegin = -1.0;
        let loopWaits = false;
        let gcBegin = -1.0;
        let worldBegin = -1.0;
        let osOut = -1.0;
        let osPreempted = false;
        for e in result.schedEvents {
            if e.thread != thread {
                continue;
            }
            let us = e.time * 1000000.0;
            if e.kind == eventRunBegin {
                runBegin = us;
                runTask = e.task;
                runCpu = e.cpu;
                runNote = "";
            } else if e.kind == eventRunEnd && runBegin >= 0.0 && e.task == runTask {
                let index = taskAt(result, order, runTask);
                let run = 0;
                if index >= 0 {
                    runCounts[index] = runCounts[index] + 1;
                    run = runCounts[index];
                }
                let label = taskLabel(result, index, runTask);
                let wall = (us - runBegin) / 1000000.0;
                let cpu = runCpu >= 0.0 && e.cpu >= 0.0 ? e.cpu - runCpu : -1.0;
                let off = cpu >= 0.0 && wall > cpu ? wall - cpu : 0.0;
                let parent = index >= 0 ? result.tasks[index].parent : 0;
                bars.push(Bar {
                    beginUs: runBegin,
                    endUs: us,
                    data: {
                        type: label,
                        task: runTask,
                        spawnedAt: spawnSite(result, index),
                        spawnedBy: parent,
                        run: run,
                        endedBy: runNote.length > 0 ? f"{runEndName(e.reason)} ({runNote})" : runEndName(e.reason),
                        cpuMs: cpu >= 0.0 ? cpu * 1000.0 : none,
                        wallMs: wall * 1000.0,
                        offCpuMs: cpu >= 0.0 ? off * 1000.0 : none,
                    },
                });
                let properties: mut [][]str = [
                    ["task", f"{runTask}"],
                    ["spawned at", spawnSite(result, index)],
                    ["spawned by", parent == 0 ? "the runtime" : f"task {parent}"],
                    ["run", f"{run}"],
                    ["ended by", runEndName(e.reason)],
                    ["wall", millis(wall)],
                ];
                if cpu >= 0.0 {
                    properties.push(["CPU", millis(cpu)]);
                    properties.push(["off CPU", millis(off)]);
                }
                if runNote.length > 0 {
                    properties.push(["note", runNote]);
                }
                builder.addExtensionEntry(thread, runBegin, us - runBegin, label, extensionGroup, tasksTrack,
                    taskColor(runTask), properties, label);
                runBegin = -1.0;
            } else if e.kind == eventLoopBegin {
                loopBegin = us;
                loopWaits = e.reason == 1;
            } else if e.kind == eventLoopEnd && loopBegin >= 0.0 {
                bars.push(Bar { beginUs: loopBegin, endUs: us, data: { type: loopWaits ? "event loop, waiting" : "event loop" } });
                loopBegin = -1.0;
            } else if e.kind == eventGcBegin {
                gcBegin = us;
            } else if e.kind == eventGcEnd && gcBegin >= 0.0 {
                bars.push(Bar { beginUs: gcBegin, endUs: us, data: { type: "GC" } });
                gcBegin = -1.0;
            } else if e.kind == eventWorldStopped {
                worldBegin = us;
            } else if e.kind == eventWorldStarted && worldBegin >= 0.0 {
                bars.push(Bar { beginUs: worldBegin, endUs: us, data: { type: "GC, world stopped" } });
                worldBegin = -1.0;
            } else if e.kind == eventStall && runBegin >= 0.0 && e.task == runTask {
                runNote = f"stall warning after {e.reason} ms";
            } else if e.kind == eventOsOut {
                osOut = us;
                osPreempted = e.reason == 1;
            } else if e.kind == eventOsIn && osOut >= 0.0 {
                let label = osPreempted ? "off CPU, preempted" : "off CPU, waiting";
                bars.push(Bar { beginUs: osOut, endUs: us, data: { type: label, evidence: "the kernel's switch records" } });
                builder.addExtensionEntry(thread, osOut, us - osOut, label, extensionGroup, cpuTrack,
                    osPreempted ? "error" : "secondary", [["off CPU", millis((us - osOut) / 1000000.0)]], label);
                osOut = -1.0;
            } else if e.kind == eventKilled {
                let index = taskAt(result, order, e.task);
                let label = f"{taskLabel(result, index, e.task)} killed";
                builder.addExtensionEntry(thread, us, 1.0, label, extensionGroup, tasksTrack, "error",
                    [["task", f"{e.task}"], ["spawned at", spawnSite(result, index)]], label);
            }
        }
        addInferredOffCpu(builder, result, thread, cpuTrack);
        return bars;
    }

    // Windows has no unprivileged record of context switches: between two
    // samples of the thread, the part of the wall time its CPU clock did not
    // advance (less the sample's own suspension) was spent off its CPU,
    // somewhere in between. Only to the extension track: the stretch's
    // position is not known, and as a bar it would cover the samples.
    fn addInferredOffCpu(builder: mut ChromeTrace.TraceBuilder, result: ProfilingResult, thread: int, cpuTrack: str): void {
        let previous = -1;
        for (let i = 0; i < result.samples.length; i++) {
            let sample = result.samples[i];
            if sample.thread != thread || sample.cpu < 0.0 {
                continue;
            }
            if previous >= 0 {
                let before = result.samples[previous];
                let wall = sample.timestamp - before.timestamp;
                let off = wall - (sample.cpu - before.cpu) - before.sampling_duration;
                if off > 0.0005 && off > wall * 0.25 {
                    let label = f"off CPU {millis(off)} of {millis(wall)}";
                    builder.addExtensionEntry(thread, before.timestamp * 1000000.0, wall * 1000000.0, label,
                        extensionGroup, cpuTrack, "warning",
                        [["off CPU", millis(off)], ["between samples", millis(wall)], ["evidence", "the thread's CPU clock between two samples"]],
                        label);
                }
            }
            previous = i;
        }
    }

    // DevTools builds each thread's tree by time and silently drops an event
    // that begins inside another and ends after it (devtools-frontend
    // 91506af6, models/trace/helpers/TreeHelpers.ts treify). So the bars go
    // in by begin, the longer one first, each clipped to the end of the one
    // it begins inside: a tree by construction. A bar begins at the whole
    // microsecond at or before its time, after the end of the bar before it:
    // DevTools places a sample at the whole microsecond at or before its own
    // time (CpuProfileBuilder), so every sample of a run lands inside its bar.
    fn addBars(builder: mut ChromeTrace.TraceBuilder, tid: int, bars: mut []Bar): void {
        bars.sort((a: Bar, b: Bar) => {
            if a.beginUs < b.beginUs { return -1; }
            if a.beginUs > b.beginUs { return 1; }
            if a.endUs > b.endUs { return -1; }
            if a.endUs < b.endUs { return 1; }
            return 0;
        });
        // Per depth: the open bar's begin and end, and where the last bar
        // placed at that depth ended (its siblings come after it).
        let begins: mut []real = [];
        let ends: mut []real = [];
        let siblingEnds: mut []real = [];
        let depth = 0;
        for bar in bars {
            while depth > 0 && ends[depth - 1] <= bar.beginUs {
                depth--;
            }
            let begin = (bar.beginUs as int) as real;
            if depth > 0 && begin < begins[depth - 1] {
                begin = begins[depth - 1];
            }
            if depth < siblingEnds.length && begin < siblingEnds[depth] {
                begin = siblingEnds[depth];
            }
            let end = bar.endUs;
            if depth > 0 && end > ends[depth - 1] {
                end = ends[depth - 1];
            }
            if end <= begin {
                continue;
            }
            builder.addBar(tid, begin, end - begin, bar.data);
            if depth < ends.length {
                begins[depth] = begin;
                ends[depth] = end;
                siblingEnds[depth] = end;
            } else {
                begins.push(begin);
                ends.push(end);
                siblingEnds.push(end);
            }
            // The new bar's children start inside it, after nothing.
            if depth + 1 < siblingEnds.length {
                siblingEnds[depth + 1] = begin;
            }
            depth++;
        }
    }

    const hazeProcessPid = 1;
    // Owns everything: the "Profile"/"RunTask" stream (like Chrome's CrRendererMain), the
    // allocation leaves merged into that same profile, and the allocation marker events that
    // DevTools lifts into its Timings track. There is deliberately no second tid -- see the
    // long note in buildTrace for why a second thread track could only ever be worse.
    const mainThreadTid = 1;

    // Mirrors hz_profiler_instrument_allocation_type (hzstd_memory.h) -- kept as a plain int on
    // the FFI struct (see ffi.hzstd_memory_instrumentation_frame_t) rather than a real enum type,
    // since hzstd_types.h (which that ref struct is defined against) is deliberately freestanding and
    // can't depend on hzstd_memory.h. Values must be kept in sync by hand.
    fn allocationKindName(allocationType: int): str {
        if allocationType == 0 { return "Heap alloc"; }       // hz_profiler_instrument_allocation_type_heap
        if allocationType == 1 { return "Grow"; }              // hz_profiler_instrument_allocation_type_heap_realloc
        if allocationType == 2 { return "Heap alloc"; }        // hz_profiler_instrument_allocation_type_heap_unscanned
        if allocationType == 3 { return "Arena"; }             // hz_profiler_instrument_allocation_type_arena_create (dataType: the label)
        if allocationType == 4 { return "Arena suballoc"; }    // hz_profiler_instrument_allocation_type_arena_suballoc (unused today)
        if allocationType == 5 { return "Arena chunk (scanned)"; }   // hz_profiler_instrument_allocation_type_arena_chunk_scanned
        if allocationType == 6 { return "Arena chunk (unscanned)"; } // hz_profiler_instrument_allocation_type_arena_chunk_unscanned
        return "Allocation";
    }

    // Builds the human-readable marker name shown in the trace for one allocation capture:
    // "<Kind> <dataType> (<size> bytes)" when a dataType string was actually reported by the
    // compiler/runtime (see the big comment on hzstd_heap_allocate_n in hzstd_memory.h for which
    // allocations carry one -- ref struct instantiation and array creation always do; array growth
    // does via hzstd_dynamic_array_t::elementTypeName; a small number of internal-only runtime
    // allocations legitimately don't), falling back to just "<Kind> (<size> bytes)" otherwise.
    fn allocationMarkerName(frame: ffi.hzstd_memory_instrumentation_frame_t): str {
        let kind = allocationKindName(frame.allocationType);
        if frame.dataType.length > 0 {
            return f"{kind} {frame.dataType} ({frame.sizeBytes} bytes)";
        }
        return f"{kind} ({frame.sizeBytes} bytes)";
    }

    // Progress reporting cadence for the long per-capture loops below. Time-based rather
    // than count-based so the output rate stays the same whether a session has ten thousand
    // captures or ten million; the index test is only there to keep the clock read itself
    // off the innermost path.
    const progressIntervalSeconds = 0.1;
    const progressCheckInterval = 4096;

    export fn buildTrace(result: ProfilingResult): ChromeTrace.Trace {
        let builder = ChromeTrace.TraceBuilder(hazeProcessPid);
        // Sized for the real total, not just the addInstantMarker calls below: both
        // profiles also expand into one ProfileChunk event per chunkSampleCount samples,
        // and on a large session that tail is thousands of events. Reserving only for the
        // markers left those chunks to trigger one final doubling of an array that is
        // already hundreds of megabytes -- an allocate-and-copy of the whole thing, plus
        // the "very large block" GC warning that comes with it. See
        // TraceBuilder.reserveEvents.
        //
        // Mirrors ChromeTrace's own chunk granularity rather than reading it from there
        // (it is an unexported implementation detail of that namespace). This only ever
        // feeds a reserve(), so the two drifting apart costs at worst a slightly-off
        // estimate, never a wrong trace.
        const samplesPerProfileChunk = 100;
        let allocationCount = result.memoryInstrumentationFrames.length;
        builder.reserveEvents(
            allocationCount
                + allocationCount / samplesPerProfileChunk
                + result.samples.length / samplesPerProfileChunk
                + 16,
        );
        builder.addFrame(mainThreadTid, "HZFRAME0", "file:///haze");

        // Built once and shared by everything below -- see buildFrameRefTable.
        let frameRefs = buildFrameRefTable(result);

        // ── Allocations appear TWICE, each time carrying a different half ───
        //
        // 1. As leaf frames in the main flame chart (see addSamplesToProfile), where each
        //    allocation hangs under the call path that made it. This is the "where did my
        //    allocations come from" view, deduplicated into a call tree so a call path that
        //    allocated the same thing a hundred thousand times is one node, not a hundred
        //    thousand copies of a 60-frame stack. (Emitting the full stack per allocation
        //    instead, which this once did, produced 965 MB of stackTrace for 80k allocations
        //    over ~1,900 distinct paths -- the same paths written out tens of thousands of
        //    times each.)
        //
        // 2. As stackless PerformanceMark events, which is what puts them in DevTools'
        //    Timings track. That track is appended before any thread track at all
        //    (CompatibilityTracksAppender's constructor), so it always renders above the
        //    main thread, and it is populated by UserTimingsHandler scanning the whole trace
        //    for cat: "blink.user_timing" regardless of tid -- so these ride along on the
        //    main thread's own tid and need no thread of their own. They carry WHEN, WHAT and
        //    HOW BIG, and deliberately no stack: the stack was ~99% of such an event's bytes,
        //    and it is already in the flame chart above.
        //
        // What is deliberately NOT done any more is giving allocations their own thread
        // track. DevTools classifies thread tracks by NAME
        // (devtools-frontend's Threads.ts/getThreadTypeForRendererThread), any unrecognized
        // name lands in ThreadType.OTHER, and threadTrackOrder sorts OTHER below MAIN_THREAD
        // unconditionally -- tid, registration order and thread_sort_index were all tried and
        // none of them change it. So that track could only ever appear below the main thread,
        // collapsed by default, as a second flame chart of the same thread that could not be
        // read against the first one. Both halves now live on the main thread's own timeline,
        // which is the only place they can actually be compared.
        let allocationLeaves: mut []str = [];
        if allocationCount > 0 {
            allocationLeaves.reserve(allocationCount);
            let lastProgressAt = time.now();
            for (let i = 0; i < allocationCount; i++) {
                allocationLeaves.push(allocationMarkerName(result.memoryInstrumentationFrames[i]));

                // Naming every capture is the longest silent stretch of a large session, so
                // report progress -- but on a time cadence, not per capture: at this call
                // volume an unconditional print per iteration costs far more than the work
                // being reported on (and time.now() itself is only worth asking a few
                // thousand times, hence the cheap index test guarding it).
                if i % progressCheckInterval == 0 {
                    let nowSeconds = time.now();
                    if nowSeconds - lastProgressAt >= progressIntervalSeconds {
                        fmt.print(f"\r  naming allocations {i} / {allocationCount}");
                        lastProgressAt = nowSeconds;
                    }
                }
            }
            fmt.print(f"\r  naming allocations {allocationCount} / {allocationCount}\n");
        }

        // ONE profile per Haze thread, carrying its CPU samples; the main thread's also the
        // allocations (they are not attributed to threads yet). The thread's track id is its
        // Haze id: the main thread is 1 (mainThreadTid), every other thread is a
        // "DedicatedWorker thread", the name DevTools shows as a worker track after the main
        // one (devtools-frontend 91506af6, models/trace/handlers/Threads.ts).
        let order = taskOrder(result);
        let noLeaves: mut []str = [];
        let allocationSampleTimesUs: mut []real = [];
        allocationSampleTimesUs.reserve(allocationLeaves.length);
        let threads: mut []int = [];
        for t in result.threads {
            threads.push(t.id);
        }
        if threads.length == 0 {
            threads.push(mainThreadTid);
        }
        for tid in threads {
            builder.addThread(tid, tid == mainThreadTid ? "CrRendererMain" : "DedicatedWorker thread", tid == mainThreadTid);
            let isMain = tid == mainThreadTid;
            let profileBuilder = ChromeTrace.CpuProfileBuilder();
            profileBuilder.reserveSamples(result.samples.length + (isMain ? allocationLeaves.length : 0));
            addSamplesToProfile(profileBuilder, result, frameRefs, isMain ? allocationLeaves : noLeaves, allocationSampleTimesUs, tid);
            let profile = profileBuilder.build();
            let bars = threadBars(builder, result, order, tid);

            // This "task" block is what gives the flame chart somewhere to render into (see
            // ChromeTrace's file header) and anchors the sample ordering invariant; the profiled
            // session is represented as a single task spanning its whole duration, and every
            // bar of the thread.
            let sessionBegin = profile.startTime;
            let sessionEnd = profile.endTime;
            for bar in bars {
                let begin = (bar.beginUs as int) as real;
                if begin < sessionBegin { sessionBegin = begin; }
                if bar.endUs > sessionEnd { sessionEnd = bar.endUs; }
            }
            builder.addTask(tid, sessionBegin, sessionEnd - sessionBegin);
            builder.addCpuProfileSamples(tid, profile.startTime, profile);
            addBars(builder, tid, bars);
        }
        assert(allocationSampleTimesUs.length == allocationCount,
            "every allocation capture must have been emitted as exactly one sample");

        // The Timings-track half (2. above). Stackless, so this is just one small event per
        // capture, reusing the name already computed for the flame-chart leaf.
        //
        // Placed half a microsecond AFTER the timestamp the allocation's SAMPLE
        // reconstructs to -- not at the capture's own timestamp, and not exactly on the
        // sample either. The marker carries no stack of its own: DevTools answers "what
        // was running when this fired" by nesting the marker, by time, into the tree of
        // entries derived from the samples, so the marker has to fall strictly inside its
        // own sample's [start, start + 1us) interval (CpuProfileBuilder guarantees every
        // sample is at least 1us wide and starts on an integer microsecond; see
        // advanceTimeline). Exactly ON the start is not enough: DevTools round-trips
        // sample timestamps through milliseconds, which can move them an ulp either way,
        // and when that put the marker a hair before its sample it was nested under the
        // CPU sample preceding the allocation instead -- a plausible-looking stack
        // pointing at code that never allocated anything, and a different one each time.
        // +0.5us is invisible at any zoom level and unreachable by float noise.
        if allocationCount > 0 {
            // One empty list shared by every marker rather than one built per capture:
            // addInstantMarker only ever reads it, and an empty array literal inside this
            // loop would be hundreds of thousands of allocations that exist purely to be
            // observed as empty.
            let noFrames: []ChromeTrace.FrameRef = [];
            let lastProgressAt = time.now();
            for (let i = 0; i < allocationCount; i++) {
                let frame = result.memoryInstrumentationFrames[i];
                builder.addInstantMarker(
                    mainThreadTid,
                    allocationSampleTimesUs[i] + 0.5,
                    allocationLeaves[i],
                    noFrames,
                    frame.dataType.length > 0 ? frame.dataType : none,
                    frame.sizeBytes,
                );
                if i % progressCheckInterval == 0 {
                    let nowSeconds = time.now();
                    if nowSeconds - lastProgressAt >= progressIntervalSeconds {
                        fmt.print(f"\r  building allocation markers {i} / {allocationCount}");
                        lastProgressAt = nowSeconds;
                    }
                }
            }
            fmt.print(f"\r  building allocation markers {allocationCount} / {allocationCount}\n");
        }

        return builder.build();
    }

    export fn toTraceJson(result: ProfilingResult): str {
        return ChromeTrace.traceToJson(buildTrace(result));
    }

    // `result` itself is still reachable as this function's own parameter for the rest of its
    // body even once buildTrace has no further use for it, so dropping its big array fields here
    // makes that backing data unreachable well before this function returns, instead of only
    // once traceToJson has already built its own large representation on top of it too.
    //
    // Deliberately NOT forcing a GC collection here (an earlier version of this function did,
    // via sys.forceGc/GC_gcollect): Haze's GC (Boehm) is a non-incremental, conservative
    // collector, and a forced full mark+sweep pass over a session with hundreds of thousands of
    // live objects is itself genuinely slow -- calling it right at each stage's local memory
    // peak (exactly where this function would otherwise call it) turned out to cost far more
    // wall-clock time than it saved, to the point of never finishing at all on a large session.
    // Dropping the reference is still worth doing on its own: it's what makes this data eligible
    // for reclamation whenever Boehm's own heap-growth heuristics next decide to collect, which
    // is what actually fixed the original leak (see hzstd_profiling_end's context->
    // memoryCapturesHead/samples_head/g_profiling_context handling) -- forcing an immediate,
    // synchronous, full-heap collection on top of that is a different (and here, net harmful)
    // thing.
    export fn writeTraceJson(result: ProfilingResult, path: str) {
        let trace = buildTrace(result);
        result.frames = [];
        result.samples = [];
        result.memoryInstrumentationFrames = [];
        // Streams event-by-event rather than materializing the whole file as
        // one string first (see ChromeTrace.writeTrace) -- that string used to
        // be the single largest allocation a profiling session made, and it
        // was live at the same time as everything it was built from.
        return ChromeTrace.writeTrace(trace, path);
    }
}

// Sampling rate is configurable via the constructor parameter (default 10 kHz):
// - samplingRate = 10000 (default): balanced accuracy and manageable postprocessing
// - samplingRate = 0: unlimited, use maximum kernel-allowed rate (Linux) or default (Windows)
// - samplingRate > 0: use as a ceiling; kernel throttling may reduce actual rate further
// The *achieved* rate -- actual samples per second -- shows up in ProfilingResult.sampling_rate_hz
// once a session ends. Only one profiling session can be active at a time; starting a second
// session while one is already running will panic immediately.
export ref struct Profiler {
    context: ffi.hzstd_profiling_context_t;

    ref struct Args {
        samplingRate: int = 10000;
        memoryInstrumentation: bool = true;
        memoryInstrumentationStacktraces: bool = true;
    }

    fn constructor(args: Args = {}) {
        fmt.println(f"Profiling started @ {args.samplingRate > 0 ? args.samplingRate : "any"} Hz");
        let session = ffi.hzstd_profiling_start(args.samplingRate, args.memoryInstrumentation, args.memoryInstrumentationStacktraces);
        return Profiler {
            context: session,
        };
    }

    // TODO: This profiler must turn into a resource so it's panic recovery safe
    //
    // hzstd_profiling_end itself prints postprocessing progress (sample counts,
    // lost/throttled counts, a live "unwinding sample N / total" counter) straight
    // to stdout as it happens, since that work can take real, visible time on a
    // large session -- nothing needs to be printed here beforehand or afterward.
    fn stop(): profiling.ProfilingResult {
        return ffi.hzstd_profiling_end(this.context);
    }

    // Dispatches on `path`'s extension: ".cpuprofile" writes the legacy Chrome DevTools /
    // V8 CPU profiler format (still just today's cpu-only data), anything else (default
    // "out.trace.json") writes a Chrome trace -- the format going forward, since it can also
    // carry whatever the FFI layer starts reporting beyond CPU samples (e.g. memory
    // instrumentation) that .cpuprofile has no room for.
    fn stopAndSave(path: str = "trace.json") {
        let result = this.stop();
        let r = path.endsWith(".cpuprofile") ? profiling.writeCpuProfile(result, path) : profiling.writeTraceJson(result, path);
        fmt.println(f"Results were written to {path}");
        return r;
    }
}

namespace profiling {

    // ── scoped profiling ─────────────────────────────────────────────────────
    //
    // The wrap-a-closure form of the manual API: everything the closure does is
    // profiled, nothing before or after it is. This is the same Profiler +
    // stopAndSave pair a caller would otherwise write by hand -- the point is
    // that the stop/save half can't be forgotten or skipped, which matters
    // because a still-running session makes the *next* Profiler() panic (only
    // one session can be active at a time, see hzstd_profiling_start).
    //
    // Settings come from the same Profiler.Args as the manual API, so a scoped
    // profile can be tuned exactly like a hand-written one:
    //
    //     profiling.profile(() => { hotLoop(); });
    //     profiling.profile(() => { hotLoop(); }, "loop.trace.json");
    //     profiling.profile(() => { hotLoop(); }, "loop.trace.json", { samplingRate: 1000 });
    //
    // Deliberately returns void rather than forwarding the closure's own return
    // value: a generic `TRet` here would force every call site that profiles a
    // plain statement block to pin down a return type it doesn't have.
    export fn profile(body: immediate () => void, path: str = "trace.json", args: Profiler.Args = {}): void {
        let profiler = Profiler(args);
        body();
        profiler.stopAndSave(path);
    }

    // ── automatic whole-program profiling ────────────────────────────────────
    //
    // Called by compiler-generated `main` (see CodeGenerator.ts) around the
    // user's own main function, on EVERY build -- so this must stay cheap and
    // completely invisible unless profiling was actually requested. The only
    // work done in the common case is one getenv.
    //
    // Configuration is by environment variable rather than by compiled-in
    // constants on purpose: an already-compiled binary must be profilable
    // without rebuilding it (`HAZE_PROFILE=1 ./myapp`), and `haze run --profile`
    // is then just the compiler setting the same variables before spawning that
    // same binary (ProjectCompiler.run). One mechanism, two entry points.
    //
    //   HAZE_PROFILE                        enable ("0"/"false"/"" disables)
    //   HAZE_PROFILE_OUT                    output path (default "trace.json")
    //   HAZE_PROFILE_SAMPLING_RATE          sampling rate in Hz (default 10000, 0 = unlimited)
    //   HAZE_PROFILE_MEMORY                 memory instrumentation (default on)
    //   HAZE_PROFILE_MEMORY_STACKTRACES     stacktraces for allocations (default on)
    export fn autoProfileEnabled(): bool {
        return envFlag("HAZE_PROFILE", false);
    }

    // ASCII-case-insensitive equality. The stdlib has no case helpers on `str`
    // (String's own buffer API is the only case-conversion path, see
    // vim_behavior.toLowerStr), and building a lowercased copy just to compare
    // it against four short literals would allocate on a path that runs during
    // startup of every profiled process -- so the fold happens per byte, inline.
    fn equalsIgnoreCase(value: str, lower: str): bool {
        if value.length != lower.length {
            return false;
        }
        for (let i = 0; i < value.length; i++) {
            let b = value[i];
            if b >= b"A" && b <= b"Z" {
                b = b + 32 as u8;
            }
            if b != lower[i] {
                return false;
            }
        }
        return true;
    }

    // "0"/"false"/"no"/"off", and a variable that's set but empty, all read as
    // off; any other value reads as on. This is what makes `HAZE_PROFILE=0
    // ./myapp` mean what it looks like it means, instead of the bare-presence
    // check that would treat it as enabled.
    fn envFlag(name: str, fallback: bool): bool {
        let value = env.get(name);
        if !value {
            return fallback;
        }
        if value.length == 0 {
            return false;
        }
        if equalsIgnoreCase(value, "0") || equalsIgnoreCase(value, "false")
            || equalsIgnoreCase(value, "no") || equalsIgnoreCase(value, "off") {
            return false;
        }
        return true;
    }

    // Plain non-negative decimal parse. Anything unparseable (empty, a stray
    // sign, trailing junk) falls back rather than panicking: a malformed
    // sampling rate in the environment should degrade to the default, not take
    // down a program that was merely asked to profile itself.
    fn envInt(name: str, fallback: int): int {
        let value = env.get(name);
        if !value {
            return fallback;
        }
        if value.length == 0 {
            return fallback;
        }
        let parsed = 0;
        for (let i = 0; i < value.length; i++) {
            let b = value[i];
            if !ascii.isDigit(b) {
                return fallback;
            }
            parsed = parsed * 10 + ((b - b"0") as int);
        }
        return parsed;
    }

    export fn autoProfileArgs(): Profiler.Args {
        return Profiler.Args {
            samplingRate: envInt("HAZE_PROFILE_SAMPLING_RATE", 10000),
            memoryInstrumentation: envFlag("HAZE_PROFILE_MEMORY", true),
            memoryInstrumentationStacktraces: envFlag("HAZE_PROFILE_MEMORY_STACKTRACES", true),
        };
    }

    export fn autoProfileOutputPath(): str {
        let path = env.get("HAZE_PROFILE_OUT");
        if path {
            return path;
        }
        return "trace.json";
    }

    // ── the two hooks compiler-generated `main` calls ────────────────────────
    //
    // Generated `main` brackets the call to the user's own main with these (see
    // CodeGenerator.ts), so the profiled region is exactly "the entire program"
    // -- startup through termination -- which is what an unmodified binary asked
    // to profile itself can meaningfully mean.
    //
    // Deliberately a begin/end PAIR of zero-argument functions rather than the
    // one closure-taking wrapper this otherwise wants to be: generated `main` is
    // emitted as raw C text that calls Haze symbols by hand-built mangled name
    // (the same `_HN...Ev` pattern already used for the user's main itself), and
    // a zero-argument, non-generic, namespace-level function is the one shape
    // that pattern can spell without the compiler resolving a real symbol. A
    // closure parameter would additionally mean constructing a Haze closure
    // value in C, which has no stable hand-writable representation at all.
    //
    // The session handle is module-level state rather than something threaded
    // between the two calls for the same reason -- generated `main` has nowhere
    // to put a Haze-typed local. Only one profiling session can be active at a
    // time anyway (hzstd_profiling_start panics otherwise), so there is nothing
    // a second concurrent auto-session could have meant.
    //
    // When profiling wasn't requested, beginAutoProfiling is a single getenv and
    // endAutoProfiling does nothing at all: an instrumented-but-not-profiling
    // build must behave identically to one without these hooks.
    //
    // Note this cannot catch a program that exits via sys.exit() rather than by
    // returning from main -- that terminates the process immediately, so
    // endAutoProfiling never runs and no trace is written. Returning from main
    // is the supported shape for whole-program profiling.
    let autoProfiler: Profiler | none = none;

    export fn beginAutoProfiling(): void {
        if !autoProfileEnabled() {
            return;
        }
        autoProfiler = Profiler(autoProfileArgs());
    }

    export fn endAutoProfiling(): void {
        if autoProfiler is Profiler {
            autoProfiler.stopAndSave(autoProfileOutputPath());
            autoProfiler = none;
        }
    }
}
