// What SDL's Wayland backend (cmake/sdlchecks.cmake, CheckWayland and the
// libdecor check) and this module need on Linux: pkg-config names, and the
// packages that ship them on Ubuntu/Debian and on Fedora. All are checked
// before anything is fetched or built, and every missing one is named at once.
struct SystemPackage {
    pkgConfig: str;
    apt: str;
    dnf: str;
}

fn linuxPackages(): []SystemPackage {
    return [
        SystemPackage { pkgConfig: "wayland-client >= 1.18", apt: "libwayland-dev", dnf: "wayland-devel" },
        SystemPackage { pkgConfig: "wayland-egl", apt: "libwayland-dev", dnf: "wayland-devel" },
        SystemPackage { pkgConfig: "wayland-cursor", apt: "libwayland-dev", dnf: "wayland-devel" },
        // The program SDL and gen-wayland-protocols.hz run; its .pc file ships with it.
        SystemPackage { pkgConfig: "wayland-scanner", apt: "libwayland-dev", dnf: "wayland-devel" },
        SystemPackage { pkgConfig: "egl", apt: "libegl-dev", dnf: "libglvnd-devel" },
        SystemPackage { pkgConfig: "xkbcommon >= 0.5.0", apt: "libxkbcommon-dev", dnf: "libxkbcommon-devel" },
        SystemPackage { pkgConfig: "libdecor-0", apt: "libdecor-0-dev", dnf: "libdecor-devel" },
    ];
}

// `words` with `word` added unless it is there already.
fn appendOnce(words: str, word: str): str {
    let parts = words.split(" ");
    for (let i = 0; i < parts.length; i++) {
        if parts[i] == word {
            return words;
        }
    }
    if words.length == 0 {
        return word;
    }
    return f"{words} {word}";
}

// None, or the message naming every missing package with both install lines.
fn missingLinuxPackages(): str | none {
    if !process.run("pkg-config", { "--version" }, process.Options { inherit_stdio: false }) {
        return "pkg-config is not installed\n  Ubuntu/Debian: sudo apt install pkg-config\n  Fedora:        sudo dnf install pkgconf-pkg-config";
    }
    let names = "";
    let apt = "";
    let dnf = "";
    let packages = linuxPackages();
    for (let i = 0; i < packages.length; i++) {
        let p = packages[i];
        if !process.run("pkg-config", { "--exists", p.pkgConfig }, process.Options { inherit_stdio: false }) {
            names = names.length == 0 ? p.pkgConfig : f"{names}, {p.pkgConfig}";
            apt = appendOnce(apt, p.apt);
            dnf = appendOnce(dnf, p.dnf);
        }
    }
    if names.length == 0 {
        return none;
    }
    return f"missing system packages: {names}\n  Ubuntu/Debian: sudo apt install {apt}\n  Fedora:        sudo dnf install {dnf}";
}

fn main(): int {
    attempt {
        if sys.isLinux() {
            let missing = missingLinuxPackages();
            if missing is str {
                raise missing;
            }
        }

        let binaryDir = env.get("HAZE_MODULE_BINARY_DIR");
        if !binaryDir { raise f"HAZE_MODULE_BINARY_DIR not defined"; }

        let sourceDir = env.get("HAZE_MODULE_SOURCE_DIR");
        if !sourceDir { raise f"HAZE_MODULE_SOURCE_DIR not defined"; }

        let cCompiler = env.get("HAZE_C_COMPILER");
        if !cCompiler { raise f"HAZE_C_COMPILER not defined"; }

        let cxxCompiler = env.get("HAZE_CXX_COMPILER");
        if !cxxCompiler { raise f"HAZE_CXX_COMPILER not defined"; }

        let repoPath = f"{binaryDir}/SDL";

        if !fs.exists(repoPath)?! {
            process.run("git", { "clone", "https://github.com/libsdl-org/SDL.git", repoPath }, {
                inherit_stdio: true,
            })?!;
        }

        // --force drops the patches below from the previous run, so they
        // apply to a clean tree every time.
        // A clone made for an older release has no tag for this one yet.
        process.run("git", { "fetch", "--tags", "origin" }, {
            inherit_stdio: true,
            cwd: repoPath,
        })?!;
        process.run("git", { "-c", "advice.detachedHead=false", "checkout", "--force", "release-3.4.18" }, {
            inherit_stdio: true,
            cwd: repoPath,
        })?!;

        // Additions to SDL, for what its API does not offer. Each is listed
        // as an input in haze.toml, so changing one rebuilds SDL.
        //   wayland-clipboard-receive: adds SDL_HazeWaylandReceiveClipboardData,
        //   which hands a clipboard transfer's pipe to the caller instead of
        //   reading it on the main thread as SDL_GetClipboardData does -- for
        //   the clipboard module, which reads it on a worker thread.
        //   tray-click-callbacks: a backport of SDL_CreateTrayWithProperties
        //   and its icon click callbacks from SDL main (3.6.0). Delete it as
        //   soon as a release has it, and update to that release.
        //   windows-tray: adds SDL_HazeGetTrayIconRect, where the icon is on
        //   screen. Applies on top of tray-click-callbacks.
        //   wayland-activated: adds SDL_PROP_WINDOW_WAYLAND_ACTIVATED_BOOLEAN,
        //   the compositor's xdg_toplevel "activated" state -- which window
        //   the user is working in. SDL only reports the keyboard focus, and
        //   GNOME holds the keyboard itself while its menus close and during
        //   moves, so that is not the same thing. To be proposed upstream.
        //   window-floating-rect: adds SDL_HazeGetWindowFloatingRect, the
        //   size and position a window returns to when it is restored --
        //   what app remembers between runs. SDL keeps it for
        //   SDL_RestoreWindow but has no getter, and a maximized or tiled
        //   window's own geometry is not it.
        let patches: []str = [
            "wayland-clipboard-receive.patch",
            "tray-click-callbacks.patch",
            "windows-tray.patch",
            "wayland-activated.patch",
            "window-floating-rect.patch",
        ];
        for patch in patches {
            process.run("git", { "apply", f"{sourceDir}/patches/{patch}" }, {
                inherit_stdio: true,
                cwd: repoPath,
            })?!;
        }

        fs.createDirectory(f"{repoPath}/build")?!;
        let configureArgs: mut []str = [
            "-B",
            f"{repoPath}/build",
            "-DSDL_SHARED=OFF",
            "-DSDL_STATIC=ON",
            "-DSDL_TEST_LIBRARY=OFF",
            "-DSDL_TESTS=OFF",
            "-DSDL_EXAMPLES=OFF",
            f"-DCMAKE_INSTALL_PREFIX={binaryDir}",
            "-DCMAKE_POSITION_INDEPENDENT_CODE=OFF",
            "-G",
            "Ninja",
            f"-DCMAKE_C_COMPILER={cCompiler}",
            f"-DCMAKE_CXX_COMPILER={cxxCompiler}",
        ];
        if sys.isLinux() {
            // SDL 3.4 stops at an optional X11 extension whose development
            // package is missing, where 3.2 left it out. These two need
            // packages a desktop does not usually have, SDL has a fallback
            // for each (the screensaver is inhibited over D-Bus first, and a
            // pointer warp without XTest uses XWarpPointer), and earlier
            // builds never had them -- so they are off by name rather than a
            // new requirement on every machine.
            configureArgs.push("-DSDL_X11_XSCRNSAVER=OFF");
            configureArgs.push("-DSDL_X11_XTEST=OFF");
        }
        process.run("cmake", configureArgs,
            process.Options {
                inherit_stdio: true,
                cwd: repoPath,
            }
        )?!;

        process.run("cmake",
            {
                "--build",
                f"{repoPath}/build",
                "--target",
                "install",
            },
            process.Options {
                inherit_stdio: true,
                cwd: repoPath,
            }
        )?!;
    }
    else e {
        if e is fs.Error {
            fmt.println(f"build-sdl step failed:", e);
            return 1;
        }
        else if e is str {
            fmt.println(f"build-sdl step failed: {e}");
            return 1;
        }
        else if e is int {
            fmt.println(f"build-sdl step failed: Process exited with code {e}");
            return 1;
        }
        assert(false);
    };

    return 0;
}