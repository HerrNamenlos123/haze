fn main(): int {
    attempt {
        let binaryDir = env.get("HAZE_MODULE_BINARY_DIR");
        if !binaryDir { raise f"HAZE_MODULE_BINARY_DIR not defined"; }

        let sourceDir = env.get("HAZE_MODULE_SOURCE_DIR");
        if !sourceDir { raise f"HAZE_MODULE_SOURCE_DIR not defined"; }

        let cCompiler = env.get("HAZE_C_COMPILER");
        if !cCompiler { raise f"HAZE_C_COMPILER not defined"; }

        let cxxCompiler = env.get("HAZE_CXX_COMPILER");
        if !cxxCompiler { raise f"HAZE_CXX_COMPILER not defined"; }

        let repoPath = f"{binaryDir}/SDL";

        if !fs.exists(repoPath)?! {
            process.run("git", { "clone", "https://github.com/libsdl-org/SDL.git", repoPath }, {
                inherit_stdio: true,
            })?!;
        }

        // --force drops the patches below from the previous run, so they
        // apply to a clean tree every time.
        // A clone made for an older release has no tag for this one yet.
        process.run("git", { "fetch", "--tags", "origin" }, {
            inherit_stdio: true,
            cwd: repoPath,
        })?!;
        process.run("git", { "-c", "advice.detachedHead=false", "checkout", "--force", "release-3.4.18" }, {
            inherit_stdio: true,
            cwd: repoPath,
        })?!;

        // Additions to SDL, for what its API does not offer. Each is listed
        // as an input in haze.toml, so changing one rebuilds SDL.
        //   wayland-clipboard-receive: adds SDL_HazeWaylandReceiveClipboardData,
        //   which hands a clipboard transfer's pipe to the caller instead of
        //   reading it on the main thread as SDL_GetClipboardData does -- for
        //   the clipboard module, which reads it on a worker thread.
        //   windows-tray: a left click on the tray icon clicks the menu's first
        //   entry instead of opening the menu, as on Windows, and adds
        //   SDL_HazeGetTrayIconRect, where the icon is on screen.
        //   wayland-activated: adds SDL_PROP_WINDOW_WAYLAND_ACTIVATED_BOOLEAN,
        //   the compositor's xdg_toplevel "activated" state -- which window
        //   the user is working in. SDL only reports the keyboard focus, and
        //   GNOME holds the keyboard itself while its menus close and during
        //   moves, so that is not the same thing. To be proposed upstream.
        //   window-floating-rect: adds SDL_HazeGetWindowFloatingRect, the
        //   size and position a window returns to when it is restored --
        //   what app remembers between runs. SDL keeps it for
        //   SDL_RestoreWindow but has no getter, and a maximized or tiled
        //   window's own geometry is not it.
        let patches: []str = [
            "wayland-clipboard-receive.patch",
            "windows-tray.patch",
            "wayland-activated.patch",
            "window-floating-rect.patch",
        ];
        for patch in patches {
            process.run("git", { "apply", f"{sourceDir}/patches/{patch}" }, {
                inherit_stdio: true,
                cwd: repoPath,
            })?!;
        }

        // This is for building with Wayland support on a fresh non-desktop linux:
        // sudo apt install \
        //     libwayland-dev \
        //     wayland-protocols \
        //     libxkbcommon-dev \
        //     libegl1-mesa-dev \
        //     libgles2-mesa-dev

        if sys.isLinux() {
            let pkg = process.run(
                "pkg-config",
                { "--version" },
            );
            if !pkg {
                raise f"pkg-config is not installed";
            }
            let requiredPackages: []str = [
                "libdecor-0",
            ];
            for package in requiredPackages {
                let result = process.run(
                    "pkg-config",
                    { "--exists", package },
                    process.Options {}
                );

                if !result {
                    raise f"Required system package '{package}' is missing";
                }
            }
        }

        fs.createDirectory(f"{repoPath}/build")?!;
        let configureArgs: mut []str = [
            "-B",
            f"{repoPath}/build",
            "-DSDL_SHARED=OFF",
            "-DSDL_STATIC=ON",
            "-DSDL_TEST_LIBRARY=OFF",
            "-DSDL_TESTS=OFF",
            "-DSDL_EXAMPLES=OFF",
            f"-DCMAKE_INSTALL_PREFIX={binaryDir}",
            "-DCMAKE_POSITION_INDEPENDENT_CODE=OFF",
            "-G",
            "Ninja",
            f"-DCMAKE_C_COMPILER={cCompiler}",
            f"-DCMAKE_CXX_COMPILER={cxxCompiler}",
        ];
        if sys.isLinux() {
            // SDL 3.4 stops at an optional X11 extension whose development
            // package is missing, where 3.2 left it out. These two need
            // packages a desktop does not usually have, SDL has a fallback
            // for each (the screensaver is inhibited over D-Bus first, and a
            // pointer warp without XTest uses XWarpPointer), and earlier
            // builds never had them -- so they are off by name rather than a
            // new requirement on every machine.
            configureArgs.push("-DSDL_X11_XSCRNSAVER=OFF");
            configureArgs.push("-DSDL_X11_XTEST=OFF");
        }
        process.run("cmake", configureArgs,
            process.Options {
                inherit_stdio: true,
                cwd: repoPath,
            }
        )?!;

        process.run("cmake",
            {
                "--build",
                f"{repoPath}/build",
                "--target",
                "install",
            },
            process.Options {
                inherit_stdio: true,
                cwd: repoPath,
            }
        )?!;
    }
    else e {
        if e is fs.Error {
            fmt.println(f"build-sdl step failed:", e);
            return 1;
        }
        else if e is str {
            fmt.println(f"build-sdl step failed: {e}");
            return 1;
        }
        else if e is int {
            fmt.println(f"build-sdl step failed: Process exited with code {e}");
            return 1;
        }
        assert(false);
    };

    return 0;
}