__c__("#define SDL_MAIN_HANDLED");
__c__("#include <SDL3/SDL.h>");
__c__("#include \"sdl_impl.c\"");

namespace ffi {
	export extern C ref struct SDL_Window {};
	export extern C ref struct SDL_Tray {};

	extern C fn haze_sdl_createTray(pixels: cptr, width: int, height: int, tooltip: str): SDL_Tray | none :: final;
	extern C fn haze_sdl_addTrayEntry(tray: SDL_Tray, label: str): int :: final;
	extern C fn haze_sdl_takeTrayClick(): int :: final;
	extern C fn haze_sdl_destroyTray(tray: SDL_Tray): void :: final;
	extern C fn haze_sdl_takeGlobalHotkey(): bool :: final;
	extern C fn haze_sdl_moveWindowToTray(window: SDL_Window, tray: SDL_Tray): void :: final;
	extern C fn haze_sdl_getPrefPath(org: str, app: str): str :: final;

	extern C fn haze_sdl_init(platformDecorations: bool): bool :: final;
	extern C fn haze_sdl_terminate(): void :: final;
	extern C fn haze_sdl_createWindow(width: i32, height: i32, title: ccstr, noApi: bool, borderless: bool, hidden: bool): SDL_Window | none :: final;
	extern C fn haze_sdl_showWindow(window: SDL_Window): void :: final;
	extern C fn haze_sdl_hideWindow(window: SDL_Window): void :: final;
	extern C fn haze_sdl_windowIsVisible(window: SDL_Window): bool :: final;
	extern C fn haze_sdl_raiseWindow(window: SDL_Window): bool :: final;
	extern C fn haze_sdl_destroyWindow(window: SDL_Window): void :: final;
	extern C fn haze_sdl_windowShouldClose(window: SDL_Window): bool :: final;
	extern C fn haze_sdl_setWindowShouldClose(window: SDL_Window, value: bool): void :: final;
	extern C fn haze_sdl_pollEvents(): void :: final;
	extern C fn haze_sdl_waitEventTimeout(timeoutMs: i32): void :: final;
	extern C fn haze_sdl_makeContextCurrent(window: SDL_Window): bool :: final;
	extern C fn haze_sdl_swapBuffers(window: SDL_Window): void :: final;
	extern C fn haze_sdl_swapInterval(interval: i32): bool :: final;
	extern C fn haze_sdl_getProcAddress(procname: ccstr): cptr :: final;
	extern C fn haze_sdl_getTime(): f64 :: final;
	extern C fn haze_sdl_consumeWindowSizeChanged(window: SDL_Window): bool :: final;
	extern C fn haze_sdl_windowHasFocus(window: SDL_Window): bool :: final;
	extern C fn haze_sdl_windowHasMouseFocus(window: SDL_Window): bool :: final;
	extern C fn haze_sdl_setTextInputActive(window: SDL_Window, active: bool): void :: final;

	// Custom-titlebar / OS window integration -- see the block comment above
	// haze_sdl_hit_test in sdl_impl.c. The region list is pushed one box at a
	// time rather than as an array so nothing has to be marshalled across the
	// FFI boundary: three scalar calls per frame, no allocation on either
	// side.
	extern C fn haze_sdl_enableWindowHitTest(window: SDL_Window): bool :: final;
	extern C fn haze_sdl_beginWindowRegions(window: SDL_Window): void :: final;
	extern C fn haze_sdl_pushWindowRegion(window: SDL_Window, x: f32, y: f32, w: f32, h: f32, draggable: bool): void :: final;
	extern C fn haze_sdl_commitWindowRegions(window: SDL_Window): void :: final;

	extern C fn haze_sdl_minimizeWindow(window: SDL_Window): void :: final;
	extern C fn haze_sdl_maximizeWindow(window: SDL_Window): void :: final;
	extern C fn haze_sdl_restoreWindow(window: SDL_Window): void :: final;
	extern C fn haze_sdl_windowIsMaximized(window: SDL_Window): bool :: final;
	extern C fn haze_sdl_windowIsBorderless(window: SDL_Window): bool :: final;
	extern C fn haze_sdl_requestWindowClose(window: SDL_Window): void :: final;
	extern C noemit fn SDL_GetWindowSize(window: SDL_Window, width: cptr, height: cptr): bool :: final;
	extern C noemit fn SDL_GetWindowSizeInPixels(window: SDL_Window, width: cptr, height: cptr): bool :: final;
	extern C noemit fn SDL_GetError(): ccstr :: final;

	// Clipboard. Wrapped in C rather than bound to SDL_GetClipboardText
	// directly because SDL hands back a buffer the caller must SDL_free --
	// see the shim in sdl_impl.c, which copies it into an owned Haze str.
	extern C fn haze_sdl_getClipboardText(): str :: final;
	extern C fn haze_sdl_setClipboardText(text: str): bool :: final;

	// Mouse cursor. Takes a plain int rather than an enum because the
	// vocabulary is owned by ui_styling.Cursor, which sdl must not import
	// (it sits far below the UI layer) -- the C side holds the index-to-
	// SDL_SystemCursor table. See sdl_impl.c.
	extern C fn haze_sdl_setCursor(index: i32): void :: final;

	// Event trampoline registration (private to ffi namespace — SDL headers not available outside)
	extern C type HazeSdlKeyFn = (userdata: cptr, scancode: i32, repeat: bool) -> void :: final;
	extern C type HazeSdlResizeFn = (userdata: cptr, width: i32, height: i32) -> void :: final;
	extern C type HazeSdlMouseMoveFn = (userdata: cptr, x: f32, y: f32) -> void :: final;
	extern C type HazeSdlMouseButtonFn = (userdata: cptr, button: i32, x: f32, y: f32) -> void :: final;
	extern C type HazeSdlMouseWheelFn = (userdata: cptr, x: f32, y: f32, mouseX: f32, mouseY: f32) -> void :: final;
	extern C type HazeSdlTextInputFn = (userdata: cptr, text: ccstr) -> void :: final;
	extern C type HazeSdlPointerFn = (userdata: cptr, kind: i32, device: i32, id: i64, x: f32, y: f32, pressure: f32, buttons: i32) -> void :: final;

	extern C noemit struct haze_sdl_trampolines_t {
		keyDown: HazeSdlKeyFn;
		keyUp: HazeSdlKeyFn;
		resize: HazeSdlResizeFn;
		mouseMove: HazeSdlMouseMoveFn;
		mouseDown: HazeSdlMouseButtonFn;
		mouseUp: HazeSdlMouseButtonFn;
		mouseWheel: HazeSdlMouseWheelFn;
		textInput: HazeSdlTextInputFn;
		pointer: HazeSdlPointerFn;
	}

	// Duplicates a C string into an owned, GC'd Haze str -- needed because
	// SDL's SDL_TextInputEvent.text points into a buffer SDL owns and reuses
	// across events, so it's only valid for the duration of this exact
	// trampoline call. hazeTextInputDispatch below copies it immediately via
	// this before the string ever reaches a Haze-level queue.
	extern C fn hzstd_cstr_dup(data: cstr): str :: final;

	extern C fn haze_sdl_register_trampolines(t: haze_sdl_trampolines_t): void :: final;
	export extern C fn haze_sdl_set_window_event_userdata(window: SDL_Window, userdata: cptr): void :: final;

	// Stateless poll (SDL_GetModState), not tied to any specific event --
	// called on demand from each dispatch function below rather than
	// threaded through every trampoline signature.
	extern C noemit fn haze_sdl_get_modifiers(): i32 :: final;

	export fn init(platformDecorations: bool): Result<none, str> {
		let result = haze_sdl_init(platformDecorations);
		if !result {
			return getError();
		}
		haze_sdl_register_trampolines({
			keyDown: hazeKeyDownDispatch,
			keyUp: hazeKeyUpDispatch,
			resize: hazeResizeDispatch,
			mouseMove: hazeMouseMoveDispatch,
			mouseDown: hazeMouseDownDispatch,
			mouseUp: hazeMouseUpDispatch,
			mouseWheel: hazeMouseWheelDispatch,
			textInput: hazeTextInputDispatch,
			pointer: hazePointerDispatch,
		});
		return none;
	}

	export fn terminate(): void {
		haze_sdl_terminate();
	}

	export fn createWindow(width: i32, height: i32, title: ccstr, noApi: bool, borderless: bool, hidden: bool): SDL_Window | none {
		return haze_sdl_createWindow(width, height, title, noApi, borderless, hidden);
	}

	export fn showWindow(window: SDL_Window) {
		haze_sdl_showWindow(window);
	}

	export fn hideWindow(window: SDL_Window) {
		haze_sdl_hideWindow(window);
	}

	export fn windowIsVisible(window: SDL_Window): bool {
		return haze_sdl_windowIsVisible(window);
	}

	export fn raiseWindow(window: SDL_Window): bool {
		return haze_sdl_raiseWindow(window);
	}

	export fn destroyWindow(window: SDL_Window) {
		haze_sdl_destroyWindow(window);
	}

	export fn windowShouldClose(window: SDL_Window): bool {
		return haze_sdl_windowShouldClose(window);
	}

	export fn setWindowShouldClose(window: SDL_Window, value: bool) {
		haze_sdl_setWindowShouldClose(window, value);
	}

	export fn pollEvents() {
		haze_sdl_pollEvents();
	}

	export fn waitEventTimeout(timeoutMs: i32) {
		haze_sdl_waitEventTimeout(timeoutMs);
	}

	export fn makeContextCurrent(window: SDL_Window): bool {
		return haze_sdl_makeContextCurrent(window);
	}

	export fn swapBuffers(window: SDL_Window) {
		haze_sdl_swapBuffers(window);
	}

	export fn swapInterval(interval: i32): bool {
		return haze_sdl_swapInterval(interval);
	}

	export fn getProcAddress(procname: ccstr): cptr {
		return haze_sdl_getProcAddress(procname);
	}

	export fn getTime(): f64 {
		return haze_sdl_getTime();
	}

	export fn getError(): str {
		return hzstd_str_from_ccstr_ref(SDL_GetError());
	}

	export fn consumeWindowSizeChanged(window: SDL_Window): bool {
		return haze_sdl_consumeWindowSizeChanged(window);
	}

	export fn windowHasFocus(window: SDL_Window): bool {
		return haze_sdl_windowHasFocus(window);
	}

	export fn windowHasMouseFocus(window: SDL_Window): bool {
		return haze_sdl_windowHasMouseFocus(window);
	}

	export fn setTextInputActive(window: SDL_Window, active: bool) {
		haze_sdl_setTextInputActive(window, active);
	}

	export fn enableWindowHitTest(window: SDL_Window): bool {
		return haze_sdl_enableWindowHitTest(window);
	}

	export fn beginWindowRegions(window: SDL_Window) {
		haze_sdl_beginWindowRegions(window);
	}

	export fn pushWindowRegion(window: SDL_Window, x: f32, y: f32, w: f32, h: f32, draggable: bool) {
		haze_sdl_pushWindowRegion(window, x, y, w, h, draggable);
	}

	export fn commitWindowRegions(window: SDL_Window) {
		haze_sdl_commitWindowRegions(window);
	}

	export fn minimizeWindow(window: SDL_Window) {
		haze_sdl_minimizeWindow(window);
	}

	export fn maximizeWindow(window: SDL_Window) {
		haze_sdl_maximizeWindow(window);
	}

	export fn restoreWindow(window: SDL_Window) {
		haze_sdl_restoreWindow(window);
	}

	export fn windowIsMaximized(window: SDL_Window): bool {
		return haze_sdl_windowIsMaximized(window);
	}

	export fn windowIsBorderless(window: SDL_Window): bool {
		return haze_sdl_windowIsBorderless(window);
	}

	export fn requestWindowClose(window: SDL_Window) {
		haze_sdl_requestWindowClose(window);
	}
}

// ---------------------------------------------------------------------------
// High-level event types
// ---------------------------------------------------------------------------

// Key enum — values match SDL3 scancodes so a direct integer cast works.
export enum Key {
	Unknown = 0,
	A = 4, B = 5, C = 6, D = 7, E = 8, F = 9, G = 10, H = 11,
	I = 12, J = 13, K = 14, L = 15, M = 16, N = 17, O = 18, P = 19,
	Q = 20, R = 21, S = 22, T = 23, U = 24, V = 25, W = 26, X = 27,
	Y = 28, Z = 29,
	Num1 = 30, Num2 = 31, Num3 = 32, Num4 = 33, Num5 = 34,
	Num6 = 35, Num7 = 36, Num8 = 37, Num9 = 38, Num0 = 39,
	Return = 40,
	Escape = 41,
	Backspace = 42,
	Tab = 43,
	Space = 44,
	Minus = 45,
	Equals = 46,
	LeftBracket = 47,
	RightBracket = 48,
	Backslash = 49,
	Semicolon = 51,
	Apostrophe = 52,
	Grave = 53,
	Comma = 54,
	Period = 55,
	Slash = 56,
	CapsLock = 57,
	F1 = 58, F2 = 59, F3 = 60, F4 = 61, F5 = 62, F6 = 63,
	F7 = 64, F8 = 65, F9 = 66, F10 = 67, F11 = 68, F12 = 69,
	Insert = 73,
	Home = 74,
	PageUp = 75,
	Delete = 76,
	End = 77,
	PageDown = 78,
	Right = 79,
	Left = 80,
	Down = 81,
	Up = 82,
	LCtrl = 224,
	LShift = 225,
	LAlt = 226,
	LGui = 227,
	RCtrl = 228,
	RShift = 229,
	RAlt = 230,
	RGui = 231,
}

export struct KeyEvent {
	key: Key;
	repeat: bool;
	modifiers: KeyModifiers;
}

export struct ResizeEvent {
	width: int;
	height: int;
}

export struct MouseMoveEvent {
	pos: Vec2;
	modifiers: KeyModifiers;
}

// button: 0=left, 1=middle, 2=right
export struct MouseButtonEvent {
	button: int;
	pos: Vec2;
	modifiers: KeyModifiers;
}

// x/y: signed scroll amount (positive = right/away-from-user); pos: mouse
// position at the time of the scroll, window-relative like every other
// event here.
export struct MouseWheelEvent {
	delta: Vec2;
	pos: Vec2;
	modifiers: KeyModifiers;
}

// Committed, layout/unicode-aware text (SDL_EVENT_TEXT_INPUT) -- distinct
// from KeyEvent: a KeyEvent for the physical "A" key doesn't tell you
// whether that produced "a", "A", "ä", or (mid-IME-composition) nothing at
// all yet. This is the already-resolved character(s) to actually insert,
// same division of labor as the DOM's keydown vs. input events.
export struct TextInputEvent {
	text: str;
}

// Which device a PointerEvent came from. The mouse has its own events above;
// this is for the two that SDL reports separately (and that the mouse events
// no longer carry copies of -- see haze_sdl_is_synthesized_mouse).
export enum PointerDevice { Pen, Touch }

export enum PointerEventKind { Down, Up, Move, Cancel }

// One pen or touch event. Down/Up are the contact itself (the pen's tip or
// eraser touching the surface, a finger landing or lifting); Move is
// everything in between AND everything that changes without contact -- a pen
// hovering, or a barrel button pressed or released. Cancel is a touch the
// platform took away (a system gesture, say) that will never see an Up.
//
// `buttons` is the DOM's PointerEvent.buttons after this event: 1 = tip or
// finger in contact, 2 = the barrel button the pen right-clicks with, 4 = its
// other barrel button, 32 = eraser end in contact. `id` tells pens apart from
// each other and fingers apart from each other, not a pen from a finger --
// pair it with `device`.
export struct PointerEvent {
	kind: PointerEventKind;
	device: PointerDevice;
	id: int;
	pos: Vec2;
	pressure: real;
	buttons: int;
	modifiers: KeyModifiers;
}

// ---------------------------------------------------------------------------
// Callback type aliases
// ---------------------------------------------------------------------------

export type KeyEventCallback = (e: KeyEvent) => bool :: final;
export type ResizeEventCallback = (e: ResizeEvent) => bool :: final;
export type MouseMoveEventCallback = (e: MouseMoveEvent) => bool :: final;
export type MouseButtonEventCallback = (e: MouseButtonEvent) => bool :: final;
export type MouseWheelEventCallback = (e: MouseWheelEvent) => bool :: final;
export type TextInputEventCallback = (e: TextInputEvent) => bool :: final;
export type PointerEventCallback = (e: PointerEvent) => bool :: final;

// ---------------------------------------------------------------------------
// Internal handler structs (one per event category)
// ---------------------------------------------------------------------------

export struct KeyHandler {
	id: int;
	callback: KeyEventCallback;
}

export struct ResizeHandler {
	id: int;
	callback: ResizeEventCallback;
}

export struct MouseMoveHandler {
	id: int;
	callback: MouseMoveEventCallback;
}

export struct MouseButtonHandler {
	id: int;
	callback: MouseButtonEventCallback;
}

export struct MouseWheelHandler {
	id: int;
	callback: MouseWheelEventCallback;
}

export struct TextInputHandler {
	id: int;
	callback: TextInputEventCallback;
}

export struct PointerHandler {
	id: int;
	callback: PointerEventCallback;
}

// ---------------------------------------------------------------------------
// Internal: convert SDL3 scancode integer to Key enum
// ---------------------------------------------------------------------------

fn scancodeToKey(scancode: i32): Key :: final {
	do unsafe {
		let k: Key = uninitialized;
		__c__("k = scancode;");
		return k;
	};
}

// Currently-held modifier keys (Shift/Ctrl/Alt/Gui), collapsed from SDL's
// left/right variants on the C side (haze_sdl_get_modifiers). A stateless
// poll, not tied to any specific event -- called fresh by every dispatch
// function below so every event this module produces carries modifiers.
export fn getModifiers(): KeyModifiers {
	do unsafe {
		let m: KeyModifiers = uninitialized;
		__c__("m = haze_sdl_get_modifiers();");
		return m;
	};
}

// ---------------------------------------------------------------------------
// Clipboard
// ---------------------------------------------------------------------------
//
// Process-global in SDL, not per-window, so these are free functions.

// The returned str is owned (copied out of SDL's buffer -- see the shim in
// sdl_impl.c); "" when the clipboard is empty or holds something that
// isn't text.
export fn getClipboardText(): str {
	return ffi.haze_sdl_getClipboardText();
}

export fn setClipboardText(text: str): bool {
	return ffi.haze_sdl_setClipboardText(text);
}

// ---------------------------------------------------------------------------
// Mouse cursor
// ---------------------------------------------------------------------------

// Sets the cursor by INDEX into the table in sdl_impl.c, whose order matches
// ui_styling.Cursor. Cheap to call every frame: the C side caches the cursor
// objects and early-outs when the shape hasn't changed.
export fn setCursor(index: int): void {
	// Narrowed against the cursor table's own bounds, not i32's: the
	// compiler needs int constrained before it fits in the FFI's i32, and
	// the only values that mean anything here are table indices anyway.
	// Anything else is a caller passing a non-cursor, so fall back to the
	// arrow rather than letting it reach the C table.
	let safe = 0 as i32;
	if index >= 0 && index < 12 {
		safe = index as i32;
	}
	ffi.haze_sdl_setCursor(safe);
}

// ---------------------------------------------------------------------------
// C-side event trampoline functions (called by sdl_impl.c)
// ---------------------------------------------------------------------------

fn hazeKeyDownDispatch(userdata: cptr, scancode: i32, repeat: bool): void :: final {
	do unsafe {
		let window: Window = uninitialized;
		__c__("window = userdata;");
		let e = KeyEvent { key: scancodeToKey(scancode), repeat: repeat, modifiers: getModifiers() };
		window.dispatchKeyDown(e);
	};
}

fn hazeKeyUpDispatch(userdata: cptr, scancode: i32, repeat: bool): void :: final {
	do unsafe {
		let window: Window = uninitialized;
		__c__("window = userdata;");
		let e = KeyEvent { key: scancodeToKey(scancode), repeat: repeat, modifiers: getModifiers() };
		window.dispatchKeyUp(e);
	};
}

fn hazeResizeDispatch(userdata: cptr, width: i32, height: i32): void :: final {
	do unsafe {
		let window: Window = uninitialized;
		__c__("window = userdata;");
		let e = ResizeEvent { width: width as int, height: height as int };
		window.dispatchResize(e);
	};
}

fn hazeMouseMoveDispatch(userdata: cptr, x: f32, y: f32): void :: final {
	do unsafe {
		let window: Window = uninitialized;
		__c__("window = userdata;");
		let e = MouseMoveEvent { pos: Vec2(x as real, y as real), modifiers: getModifiers() };
		window.dispatchMouseMove(e);
	};
}

fn hazeMouseDownDispatch(userdata: cptr, button: i32, x: f32, y: f32): void :: final {
	do unsafe {
		let window: Window = uninitialized;
		__c__("window = userdata;");
		let e = MouseButtonEvent { button: button as int, pos: Vec2(x as real, y as real), modifiers: getModifiers() };
		window.dispatchMouseDown(e);
	};
}

fn hazeMouseUpDispatch(userdata: cptr, button: i32, x: f32, y: f32): void :: final {
	do unsafe {
		let window: Window = uninitialized;
		__c__("window = userdata;");
		let e = MouseButtonEvent { button: button as int, pos: Vec2(x as real, y as real), modifiers: getModifiers() };
		window.dispatchMouseUp(e);
	};
}

fn hazeMouseWheelDispatch(userdata: cptr, x: f32, y: f32, mouseX: f32, mouseY: f32): void :: final {
	do unsafe {
		let window: Window = uninitialized;
		__c__("window = userdata;");
		let e = MouseWheelEvent { delta: Vec2(x as real, y as real), pos: Vec2(mouseX as real, mouseY as real), modifiers: getModifiers() };
		window.dispatchMouseWheel(e);
	};
}

fn hazePointerDispatch(userdata: cptr, kind: i32, device: i32, id: i64, x: f32, y: f32, pressure: f32, buttons: i32): void :: final {
	do unsafe {
		let window: Window = uninitialized;
		__c__("window = userdata;");
		// Numbering fixed by the C side -- see haze_sdl_dispatch_pointer.
		let eventKind = PointerEventKind.Move;
		if kind == 0 { eventKind = PointerEventKind.Down; }
		else if kind == 1 { eventKind = PointerEventKind.Up; }
		else if kind == 3 { eventKind = PointerEventKind.Cancel; }
		let e = PointerEvent {
			kind: eventKind,
			device: device == 1 ? PointerDevice.Pen : PointerDevice.Touch,
			id: id as int,
			pos: Vec2(x as real, y as real),
			pressure: pressure as real,
			buttons: buttons as int,
			modifiers: getModifiers(),
		};
		window.dispatchPointer(e);
	};
}

fn hazeTextInputDispatch(userdata: cptr, text: ccstr): void :: final {
	do unsafe {
		let window: Window = uninitialized;
		__c__("window = userdata;");
		// hzstd_cstr_dup only reads its argument (to copy it) despite taking
		// a non-const char* -- safe to drop the const here.
		let mutableText: cstr = uninitialized;
		__c__("mutableText = (char*)text;");
		let e = TextInputEvent { text: ffi.hzstd_cstr_dup(mutableText) };
		window.dispatchTextInput(e);
	};
}

export ref struct Window {
	handle: ffi.SDL_Window;

	// Event handler storage
	nextHandlerId: int = 0;
	keyDownHandlers: []KeyHandler = [];
	keyUpHandlers: []KeyHandler = [];
	resizeHandlers: []ResizeHandler = [];
	mouseMoveHandlers: []MouseMoveHandler = [];
	mouseDownHandlers: []MouseButtonHandler = [];
	mouseUpHandlers: []MouseButtonHandler = [];
	textInputHandlers: []TextInputHandler = [];
	mouseWheelHandlers: []MouseWheelHandler = [];
	pointerHandlers: []PointerHandler = [];

	fn makeContextCurrent() {
		ffi.makeContextCurrent(this.handle);
	}

	fn shouldClose(): bool {
		return ffi.windowShouldClose(this.handle);
	}

	fn moveToTray(tray: Tray) {
		ffi.haze_sdl_moveWindowToTray(this.handle, tray.handle);
	}

	fn cancelClose() {
		ffi.setWindowShouldClose(this.handle, false);
	}

	// Ask this window to close, exactly as if its titlebar's X had been
	// clicked: it pushes the platform's own SDL_EVENT_WINDOW_CLOSE_REQUESTED
	// rather than setting the should-close flag behind the event loop's back,
	// so a close from a custom titlebar and a close from the window manager
	// are the same code path from here on -- one shutdown sequence, not two.
	// See haze_sdl_requestWindowClose.
	fn close() {
		ffi.requestWindowClose(this.handle);
	}

	// ── Window state ────────────────────────────────────────────────
	//
	// The real platform operations, not an emulation of them, so a custom
	// titlebar's buttons behave (and animate) like the ones they replace.

	// Map a window created with WindowConfig.hidden. Idempotent, and a no-op
	// on a window that is already on screen.
	fn show() {
		ffi.showWindow(this.handle);
	}

	// Take the window off the desktop without tearing it down: the GPU
	// device, the swapchain and the window's size and position all survive,
	// so show() brings back the same window rather than building a new one.
	// This is the close-to-tray / hide-to-background operation.
	//
	// Not minimize(): a minimized window still exists on the desktop, with
	// its taskbar entry and thumbnail. A hidden one is gone until shown.
	//
	// The window is off the screen when this returns, so work that follows
	// without another frame (saving before exit) runs with nothing on screen.
	fn hide() {
		ffi.hideWindow(this.handle);
	}

	// Is the window currently mapped? False before the first show() of a
	// window created with WindowConfig.hidden, and false after hide().
	// A minimized window still counts as visible here -- it is mapped, the
	// platform just isn't showing it.
	fn isVisible(): bool {
		return ffi.windowIsVisible(this.handle);
	}

	// Bring the window to the front and ask for the keyboard focus
	// (SDL_RaiseWindow). The natural partner of show(): a window that has
	// just been unhidden is mapped, but not necessarily on top of whatever
	// the user has been looking at meanwhile, and not necessarily typed
	// into -- so a bring-it-back gesture is show() then focus().
	//
	// A request the platform is free to refuse, since self-focusing at will
	// is how an application steals someone's keystrokes from another one.
	// The bool reports whether SDL accepted the request, NOT that the window
	// is now focused; hasFocus() is what actually answers that, once the
	// platform has had an event loop turn to act. On a refusal a platform
	// may substitute a demand for attention of its own (a flashing taskbar
	// button, say) rather than doing nothing.
	//
	// A hidden window cannot come to the front -- show() first. Raising one
	// is not an error (Windows reports success), it simply has nothing to
	// raise.
	fn focus(): bool {
		return ffi.raiseWindow(this.handle);
	}

	fn minimize() {
		ffi.minimizeWindow(this.handle);
	}

	fn maximize() {
		ffi.maximizeWindow(this.handle);
	}

	fn restore() {
		ffi.restoreWindow(this.handle);
	}

	fn isMaximized(): bool {
		return ffi.windowIsMaximized(this.handle);
	}

	// Is the platform's own titlebar and frame gone (SDL_WINDOW_BORDERLESS)?
	// True exactly when the application asked for a borderless window, which
	// is the moment it owes the window a titlebar of its own.
	fn isBorderless(): bool {
		return ffi.windowIsBorderless(this.handle);
	}

	// ── OS window regions (custom titlebar) ─────────────────────────
	//
	// See the block comment above haze_sdl_hit_test in sdl_impl.c for what
	// these are and why the platform, not this process, is what ends up
	// moving the window.
	//
	// Reports false when the video backend has no hit-test support -- a
	// borderless window is then immovable, which a caller wants to know
	// about rather than discover by dragging.
	fn enableHitTest(): bool {
		return ffi.enableWindowHitTest(this.handle);
	}

	// One frame's worth of regions: begin, push each box in PAINT order
	// (later boxes win where they overlap), commit. The committed set is
	// what the hit test reads, so a half-built list is never visible to it.
	fn beginRegions() {
		ffi.beginWindowRegions(this.handle);
	}

	fn pushRegion(pos: Vec2, size: Vec2, draggable: bool) {
		ffi.pushWindowRegion(this.handle, pos.x as f32, pos.y as f32, size.x as f32, size.y as f32, draggable);
	}

	fn commitRegions() {
		ffi.commitWindowRegions(this.handle);
	}

	fn destroy() {
		ffi.destroyWindow(this.handle);
	}

	fn swapBuffers() {
		ffi.makeContextCurrent(this.handle);
		ffi.swapBuffers(this.handle);
	}

	fn swapInterval(interval: int) {
		if interval >= 0 && interval <= 10 {
			ffi.makeContextCurrent(this.handle);
			ffi.swapInterval(interval);
		}
	}

	fn getLogicalSize() {
		let width = 0 as i32;
		let height = 0 as i32;
		let w = none as cptr;
		let h = none as cptr;
		__c__("w = &width;");
		__c__("h = &height;");
		ffi.SDL_GetWindowSize(this.handle, w, h);
		return Vec2i(width, height);
	}

	fn getFramebufferSize() {
		let width = 0 as i32;
		let height = 0 as i32;
		let w = none as cptr;
		let h = none as cptr;
		__c__("w = &width;");
		__c__("h = &height;");
		ffi.SDL_GetWindowSizeInPixels(this.handle, w, h);
		return Vec2i(width, height);
	}

	fn consumeSizeChanged(): bool {
		return ffi.consumeWindowSizeChanged(this.handle);
	}

	// Whether this window holds the OS keyboard focus right now. Polled,
	// not event-driven -- see the shim in sdl_impl.c.
	fn hasFocus(): bool {
		return ffi.windowHasFocus(this.handle);
	}

	// Is the pointer over this window right now? Polled, not event-driven --
	// see the shim in sdl_impl.c, and note this is about the MOUSE, not the
	// keyboard focus hasFocus() reports: a window can hold the keyboard while
	// the pointer is somewhere else entirely.
	fn hasMouseFocus(): bool {
		return ffi.windowHasMouseFocus(this.handle);
	}

	// Turn text entry for this window on or off -- SDL_StartTextInput /
	// SDL_StopTextInput. On while something that takes typed text has focus,
	// off otherwise: that is what brings the on-screen keyboard up (and puts
	// it away) on a touch device, and what keeps an input method from
	// composing into a window with nowhere to put the text. A window starts
	// with it on (see haze_sdl_createWindow), so a host that never calls this
	// keeps the old always-on behavior. Key events arrive either way; only
	// TextInputEvent depends on it.
	fn setTextInputActive(active: bool) {
		ffi.setTextInputActive(this.handle, active);
	}

	fn getProcAddress(): ((name: ccstr) -> cptr) {
		this.makeContextCurrent();

		do unsafe {
			const rawProc = ffi.getProcAddress;
			const castedProc: ((name: ccstr) -> cptr) = uninitialized;
			__c__("castedProc = (void*)rawProc;");
			return castedProc;
		};
	}

	// --- Event handler registration ---

	fn onKeyDown(cb: KeyEventCallback): int {
		let id = this.nextHandlerId;
		this.nextHandlerId = id + 1;
		this.keyDownHandlers.push(KeyHandler { id: id, callback: cb });
		return id;
	}

	fn onKeyUp(cb: KeyEventCallback): int {
		let id = this.nextHandlerId;
		this.nextHandlerId = id + 1;
		this.keyUpHandlers.push(KeyHandler { id: id, callback: cb });
		return id;
	}

	fn onResize(cb: ResizeEventCallback): int {
		let id = this.nextHandlerId;
		this.nextHandlerId = id + 1;
		this.resizeHandlers.push(ResizeHandler { id: id, callback: cb });
		return id;
	}

	fn onMouseMove(cb: MouseMoveEventCallback): int {
		let id = this.nextHandlerId;
		this.nextHandlerId = id + 1;
		this.mouseMoveHandlers.push(MouseMoveHandler { id: id, callback: cb });
		return id;
	}

	fn onMouseDown(cb: MouseButtonEventCallback): int {
		let id = this.nextHandlerId;
		this.nextHandlerId = id + 1;
		this.mouseDownHandlers.push(MouseButtonHandler { id: id, callback: cb });
		return id;
	}

	fn onMouseUp(cb: MouseButtonEventCallback): int {
		let id = this.nextHandlerId;
		this.nextHandlerId = id + 1;
		this.mouseUpHandlers.push(MouseButtonHandler { id: id, callback: cb });
		return id;
	}

	fn onMouseWheel(cb: MouseWheelEventCallback): int {
		let id = this.nextHandlerId;
		this.nextHandlerId = id + 1;
		this.mouseWheelHandlers.push(MouseWheelHandler { id: id, callback: cb });
		return id;
	}

	fn onTextInput(cb: TextInputEventCallback): int {
		let id = this.nextHandlerId;
		this.nextHandlerId = id + 1;
		this.textInputHandlers.push(TextInputHandler { id: id, callback: cb });
		return id;
	}

	// Pen and touch -- see PointerEvent.
	fn onPointer(cb: PointerEventCallback): int {
		let id = this.nextHandlerId;
		this.nextHandlerId = id + 1;
		this.pointerHandlers.push(PointerHandler { id: id, callback: cb });
		return id;
	}

	// --- Deregistration ---

	fn removeHandler(id: int) {
		let i = 0;
		while i < this.keyDownHandlers.length {
			if this.keyDownHandlers[i].id == id {
				do unsafe {
					__c__("hzstd_dynamic_array_remove(this->keyDownHandlers, (size_t)i, NULL);");
				};
				return;
			}
			i = i + 1;
		}

		i = 0;
		while i < this.keyUpHandlers.length {
			if this.keyUpHandlers[i].id == id {
				do unsafe {
					__c__("hzstd_dynamic_array_remove(this->keyUpHandlers, (size_t)i, NULL);");
				};
				return;
			}
			i = i + 1;
		}

		i = 0;
		while i < this.resizeHandlers.length {
			if this.resizeHandlers[i].id == id {
				do unsafe {
					__c__("hzstd_dynamic_array_remove(this->resizeHandlers, (size_t)i, NULL);");
				};
				return;
			}
			i = i + 1;
		}

		i = 0;
		while i < this.mouseMoveHandlers.length {
			if this.mouseMoveHandlers[i].id == id {
				do unsafe {
					__c__("hzstd_dynamic_array_remove(this->mouseMoveHandlers, (size_t)i, NULL);");
				};
				return;
			}
			i = i + 1;
		}

		i = 0;
		while i < this.mouseDownHandlers.length {
			if this.mouseDownHandlers[i].id == id {
				do unsafe {
					__c__("hzstd_dynamic_array_remove(this->mouseDownHandlers, (size_t)i, NULL);");
				};
				return;
			}
			i = i + 1;
		}

		i = 0;
		while i < this.mouseUpHandlers.length {
			if this.mouseUpHandlers[i].id == id {
				do unsafe {
					__c__("hzstd_dynamic_array_remove(this->mouseUpHandlers, (size_t)i, NULL);");
				};
				return;
			}
			i = i + 1;
		}

		i = 0;
		while i < this.mouseWheelHandlers.length {
			if this.mouseWheelHandlers[i].id == id {
				do unsafe {
					__c__("hzstd_dynamic_array_remove(this->mouseWheelHandlers, (size_t)i, NULL);");
				};
				return;
			}
			i = i + 1;
		}

		i = 0;
		while i < this.textInputHandlers.length {
			if this.textInputHandlers[i].id == id {
				do unsafe {
					__c__("hzstd_dynamic_array_remove(this->textInputHandlers, (size_t)i, NULL);");
				};
				return;
			}
			i = i + 1;
		}

		i = 0;
		while i < this.pointerHandlers.length {
			if this.pointerHandlers[i].id == id {
				do unsafe {
					__c__("hzstd_dynamic_array_remove(this->pointerHandlers, (size_t)i, NULL);");
				};
				return;
			}
			i = i + 1;
		}
	}

	// --- Internal dispatch (called by trampolines) ---

	fn dispatchKeyDown(e: KeyEvent) {
		let i = 0;
		while i < this.keyDownHandlers.length {
			if this.keyDownHandlers[i].callback(e) {
				return;
			}
			i = i + 1;
		}
	}

	fn dispatchKeyUp(e: KeyEvent) {
		let i = 0;
		while i < this.keyUpHandlers.length {
			if this.keyUpHandlers[i].callback(e) {
				return;
			}
			i = i + 1;
		}
	}

	fn dispatchResize(e: ResizeEvent) {
		let i = 0;
		while i < this.resizeHandlers.length {
			if this.resizeHandlers[i].callback(e) {
				return;
			}
			i = i + 1;
		}
	}

	fn dispatchMouseMove(e: MouseMoveEvent) {
		let i = 0;
		while i < this.mouseMoveHandlers.length {
			if this.mouseMoveHandlers[i].callback(e) {
				return;
			}
			i = i + 1;
		}
	}

	fn dispatchMouseDown(e: MouseButtonEvent) {
		let i = 0;
		while i < this.mouseDownHandlers.length {
			if this.mouseDownHandlers[i].callback(e) {
				return;
			}
			i = i + 1;
		}
	}

	fn dispatchMouseUp(e: MouseButtonEvent) {
		let i = 0;
		while i < this.mouseUpHandlers.length {
			if this.mouseUpHandlers[i].callback(e) {
				return;
			}
			i = i + 1;
		}
	}

	fn dispatchMouseWheel(e: MouseWheelEvent) {
		let i = 0;
		while i < this.mouseWheelHandlers.length {
			if this.mouseWheelHandlers[i].callback(e) {
				return;
			}
			i = i + 1;
		}
	}

	fn dispatchTextInput(e: TextInputEvent) {
		let i = 0;
		while i < this.textInputHandlers.length {
			if this.textInputHandlers[i].callback(e) {
				return;
			}
			i = i + 1;
		}
	}

	fn dispatchPointer(e: PointerEvent) {
		let i = 0;
		while i < this.pointerHandlers.length {
			if this.pointerHandlers[i].callback(e) {
				return;
			}
			i = i + 1;
		}
	}
}

export ref struct WindowSizeConfig {
	width: int = 1080;
	height: int = 720;
}

export ref struct WindowConfig {
	title: ccstr;
	size: WindowSizeConfig = {};
	noApi: bool = false;
	// Drop the platform's titlebar and frame -- the application draws its
	// own. See Window.enableHitTest, which is what gives such a window its
	// dragging, resizing, snapping and double-click-to-maximize back.
	borderless: bool = false;
	// Create the window without mapping it, leaving it invisible until
	// Window.show() is called.
	//
	// A window is on screen from the moment it is created, and the
	// compositor paints it from that moment -- but nothing can have been
	// rendered into it yet, since the GPU device and swapchain are built
	// afterwards. The gap between the two is what shows as a black
	// rectangle before an application appears. Deferring the mapping until
	// the first frame has been presented removes it: the window's first
	// painted pixels are the application's first frame. See App's
	// windowShown, which does exactly this.
	hidden: bool = false;
}

// platformDecorations: false when every window is going to be borderless and
// draw its own titlebar -- the platform's decoration support is then never
// loaded, see haze_sdl_init.
export fn init(platformDecorations: bool = true) {
	return ffi.init(platformDecorations);
}

export fn terminate() {
	ffi.terminate();
}

export fn createWindow(config: WindowConfig): Result<mut Window, str> {
	assert(config.size.width >= i32.min && config.size.width <= i32.max);
	assert(config.size.height >= i32.min && config.size.height <= i32.max);
	const handle = ffi.createWindow(config.size.width, config.size.height, config.title, config.noApi, config.borderless, config.hidden);
	if !handle {
		return Result<mut Window, str>.Err(ffi.getError());
	}

	let window = Window { handle: handle };
	let windowPtr: cptr = none;
	__c__("windowPtr = window;");
	ffi.haze_sdl_set_window_event_userdata(handle, windowPtr);

	return Result<mut Window, str>.Ok(window);
}

export fn pollEvents() {
	ffi.pollEvents();
}

// Block until an event arrives or `timeoutMs` elapses, leaving whatever
// arrived in the queue for the next pollEvents(). For a host that skipped
// rendering a frame and therefore has nothing to block on -- see
// haze_sdl_waitEventTimeout in sdl_impl.c.
export fn waitEventTimeout(timeoutMs: i32) {
	ffi.waitEventTimeout(timeoutMs);
}

export fn getTime(): real {
	return ffi.getTime() as real;
}

export ref struct Tray {
	handle: ffi.SDL_Tray;

	fn addEntry(label: str): int {
		return ffi.haze_sdl_addTrayEntry(this.handle, label);
	}

	fn takeClicked(): int | none {
		let index = ffi.haze_sdl_takeTrayClick();
		if index < 0 { return none; }
		return index;
	}

	fn destroy() {
		ffi.haze_sdl_destroyTray(this.handle);
	}
}

export fn createTray(rgbaPixels: Bytes, width: int, height: int, tooltip: str): Result<Tray, str> {
	let pixels = none as cptr;
	__c__("pixels = rgbaPixels.basePtr + rgbaPixels.offset;");
	let handle = ffi.haze_sdl_createTray(pixels, width, height, tooltip);
	if !handle {
		return Result<Tray, str>.Err(ffi.getError());
	}
	return Result<Tray, str>.Ok(Tray { handle: handle });
}

export fn registerGlobalHotkey(modifiers: KeyModifiers, key: Key): bool {
	do unsafe {
		let registered: bool = uninitialized;
		__c__("registered = haze_sdl_registerGlobalHotkey((int)modifiers, (int)key);");
		return registered;
	};
}

export fn takeGlobalHotkey(): bool {
	return ffi.haze_sdl_takeGlobalHotkey();
}

export fn prefPath(org: str, app: str): str {
	return ffi.haze_sdl_getPrefPath(org, app);
}
