+/* Haze: the window's floating geometry -- its position and size when it is
+ * neither maximized, tiled nor fullscreen, and so what restoring it returns
+ * to. SDL keeps it for exactly that, but has no getter: a maximized or tiled
+ * window's own size and position are something else. The position is
+ * meaningless where the platform never reports one (Wayland).
+ */
+bool SDL_HazeGetWindowFloatingRect(SDL_Window *window, SDL_Rect *rect)
+{
+    CHECK_WINDOW_MAGIC(window, false);
+    if (!rect) {
+        return SDL_InvalidParamError("rect");
+    }
+    *rect = window->floating;
+    return true;
+}
