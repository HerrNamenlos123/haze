import ui_styling;

// Tailwind-style preset shorthands. Depends on ui_styling for exactly one
// thing -- the `*Op` data vocabulary -- and nothing else: no behavior is
// shared, ui_styling never has to change for a preset added here, and
// ui_styling never names a single one of these functions or knows the
// "tailwind class" concept exists at all. Each preset is a plain factory
// that returns a plain ui_styling.*Op value directly: no closures, no
// generics, no indirection -- the array of presets a component writes is
// just data ui_styling.computeDivStyle()/computeTextStyle() loops over.
namespace presets {
    // Tailwind number-to-px scale: w-<number> -> width: calc(var(--spacing) * <number>);
    export const baseSpacing = 4.0;

    export fn computeSize(number: real): real {
        return number * baseSpacing;
    }

    export fn bg(color: Color): ui_styling.BackgroundColorOp {
        return ui_styling.BackgroundColorOp { color: color };
    }

    export fn textColor(color: Color): ui_styling.TextColorOp {
        return ui_styling.TextColorOp { color: color };
    }

    // Text wrapping. `noWrap()` lets a long run extend past its container
    // instead of breaking onto a second visual row -- required by anything
    // that maps an x coordinate back to a character index (a code editor's
    // hit-testing, a caret), since a wrapped row breaks that mapping.
    export fn textWrap(value: ui_styling.TextWrap): ui_styling.TextWrapOp {
        return ui_styling.TextWrapOp { value: value };
    }

    export fn noWrap(): ui_styling.TextWrapOp {
        return ui_styling.TextWrapOp { value: ui_styling.TextWrap.None };
    }

    export fn p(value: real): ui_styling.PaddingOp {
        return ui_styling.PaddingOp {
            padding: ui_styling.StylePaddingSimple { value: computeSize(value) },
        };
    }

    export fn gap(value: real): ui_styling.GapOp {
        return ui_styling.GapOp { value: computeSize(value) };
    }

    // overflow-hidden / overflow-visible: clip (or don't) content larger
    // than this element, on both axes. Clipping is painting-only -- a
    // clipped child still takes up the space it would have, it just stops
    // being drawn past the edge of this element.
    export fn overflowHidden(): ui_styling.OverflowOp {
        return ui_styling.OverflowOp {
            x: ui_styling.Overflow.Hidden,
            y: ui_styling.Overflow.Hidden,
        };
    }

    export fn overflowVisible(): ui_styling.OverflowOp {
        return ui_styling.OverflowOp {
            x: ui_styling.Overflow.Visible,
            y: ui_styling.Overflow.Visible,
        };
    }

    // Single-axis forms -- CSS's overflow-x / overflow-y.
    export fn overflowX(value: ui_styling.Overflow): ui_styling.OverflowXOp {
        return ui_styling.OverflowXOp { value: value };
    }

    export fn overflowY(value: ui_styling.Overflow): ui_styling.OverflowYOp {
        return ui_styling.OverflowYOp { value: value };
    }

    // w-<number>/h-<number>: fixed pixel size on the Tailwind spacing scale
    // (same scale as p()/gap() above).
    export fn w(value: real): ui_styling.WidthOp {
        return ui_styling.WidthOp { value: computeSize(value) };
    }

    export fn h(value: real): ui_styling.HeightOp {
        return ui_styling.HeightOp { value: computeSize(value) };
    }

    // w-fit/h-fit: wrap tightly to content. w-grow/h-grow (Tailwind has no
    // direct equivalent -- closest is w-full, but that's percent-of-parent,
    // not "share remaining space with sibling Grow elements"): expand to
    // fill available space, split with other Grow siblings.
    //
    // Functions, not consts: WidthOp/HeightOp aren't `inline struct`s, so
    // they're heap-allocated -- a top-level `const` of one fails to compile
    // (the generated C initializer needs a statement-expression, which C
    // doesn't allow at file scope). A zero-arg function allocates at the
    // call site instead, which is fine.
    export fn wFit(): ui_styling.WidthOp {
        return ui_styling.WidthOp { value: ui_styling.SizeMode.Fit };
    }

    export fn wGrow(): ui_styling.WidthOp {
        return ui_styling.WidthOp { value: ui_styling.SizeMode.Grow };
    }

    export fn hFit(): ui_styling.HeightOp {
        return ui_styling.HeightOp { value: ui_styling.SizeMode.Fit };
    }

    export fn hGrow(): ui_styling.HeightOp {
        return ui_styling.HeightOp { value: ui_styling.SizeMode.Grow };
    }

    // Cross-axis alignment (perpendicular to direction -- see CrossAlign's
    // own doc comment for exactly which physical axis that is).
    export fn crossAlign(value: ui_styling.CrossAlign): ui_styling.CrossAlignOp {
        return ui_styling.CrossAlignOp { value: value };
    }

    // items-stretch shorthand: opt-in cross-axis fill for children still at
    // their default size.
    export fn stretch(): ui_styling.CrossAlignOp {
        return ui_styling.CrossAlignOp { value: ui_styling.CrossAlign.Stretch };
    }

    // Main-axis packing (the same axis as direction).
    export fn packing(value: ui_styling.Packing): ui_styling.PackingOp {
        return ui_styling.PackingOp { value: value };
    }

    export fn direction(value: ui_styling.Direction): ui_styling.DirectionOp {
        return ui_styling.DirectionOp { value: value };
    }

    // flex-row/flex-col shorthands. Row is already the default (unset ==
    // Row), so row() only matters when overriding a col() from elsewhere
    // (e.g. a preset list building on another one).
    export fn row(): ui_styling.DirectionOp {
        return ui_styling.DirectionOp { value: ui_styling.Direction.Row };
    }

    export fn col(): ui_styling.DirectionOp {
        return ui_styling.DirectionOp { value: ui_styling.Direction.Column };
    }

    // position: static/relative/absolute/fixed -- see ui_styling.Position for
    // exactly what each one resolves against.
    export fn relative(): ui_styling.PositionOp {
        return ui_styling.PositionOp { value: ui_styling.Position.Relative };
    }

    export fn absolute(): ui_styling.PositionOp {
        return ui_styling.PositionOp { value: ui_styling.Position.Absolute };
    }

    export fn fixed(): ui_styling.PositionOp {
        return ui_styling.PositionOp { value: ui_styling.Position.Fixed };
    }

    // top-<number>/right-<number>/bottom-<number>/left-<number>: offset from
    // that edge of the containing block, same spacing scale as p()/gap()
    // above. Only meaningful on an Absolute/Fixed element (or one with
    // anchorTo() set) -- a no-op otherwise, same as Tailwind/CSS.
    export fn top(value: real): ui_styling.TopOp {
        return ui_styling.TopOp { value: value };
    }

    export fn right(value: real): ui_styling.RightOp {
        return ui_styling.RightOp { value: value };
    }

    export fn bottom(value: real): ui_styling.BottomOp {
        return ui_styling.BottomOp { value: value };
    }

    export fn left(value: real): ui_styling.LeftOp {
        return ui_styling.LeftOp { value: value };
    }

    // translate-x-*/translate-y-*: shift this element by a fraction of ITS
    // OWN size, after layout has already placed it -- see
    // ui_styling.TranslateValues for the full semantics.
    //
    // The argument is the fraction directly: 1.0 is Tailwind's
    // `translate-x-full` (CSS `translate: 100%`), -0.5 is
    // `-translate-x-1/2` (CSS `-50%`). Tailwind spells the common fractions
    // as named utilities; here they're just the number, since Haze has real
    // literals and doesn't need `1/2` to be a class-name token.
    //
    // NOT on the p()/gap() spacing scale: these are multiples of the
    // element's own size, so passing 4 would mean "four times my own width",
    // not "16px". Use left()/top() for a pixel offset.
    //
    // The classic centering idiom, exactly as in CSS/Tailwind -- place the
    // element's top-left at the middle of its container, then pull it back
    // by half of itself so its CENTER lands there:
    //   presets.absolute(), presets.left(w/2), presets.top(h/2),
    //   presets.translateX(-0.5), presets.translateY(-0.5)
    export fn translateX(value: real): ui_styling.TranslateXOp {
        return ui_styling.TranslateXOp { value: value };
    }

    export fn translateY(value: real): ui_styling.TranslateYOp {
        return ui_styling.TranslateYOp { value: value };
    }

    // Both axes at once -- the `translate-*` shorthand.
    export fn translate(x: real, y: real): ui_styling.TranslateOp {
        return ui_styling.TranslateOp { x: x, y: y };
    }

    // z-<number>: stacking order among floating elements. Like CSS, only
    // affects an element that's actually taken out of flow (Absolute/Fixed/
    // anchorTo) -- Clay's zIndex lives on its floating config, so it has no
    // effect on an element still in normal flow.
    export fn z(value: int): ui_styling.ZIndexOp {
        return ui_styling.ZIndexOp { value: value };
    }

    // Anchors this element to an arbitrary other element elsewhere in the
    // tree (not necessarily an ancestor) -- the one case CSS itself can't
    // express. `target` is a hollow ui_styling.AnchorTarget created via
    // ui.anchor() and handed to the other element's `anchor:` prop; order
    // doesn't matter, see AnchorTarget's own doc comment.
    export fn anchorTo(target: ui_styling.AnchorTarget): ui_styling.AnchorToOp {
        return ui_styling.AnchorToOp { target: target };
    }

    // border-<width>: sets all four border widths at once, raw pixels (not
    // on the spacing scale -- Tailwind's own border-width utility isn't
    // either, it's a small fixed scale of its own). borderT/R/B/L set one
    // edge independently, combinable in the same presets array (e.g.
    // `[presets.borderT(2), presets.borderColor("#f00")]` for a top-only
    // rule). Only draws once borderColor's alpha is also non-zero.
    export fn border(value: real): ui_styling.BorderWidthOp {
        return ui_styling.BorderWidthOp { value: value };
    }

    export fn borderT(value: real): ui_styling.BorderTopWidthOp {
        return ui_styling.BorderTopWidthOp { value: value };
    }

    export fn borderR(value: real): ui_styling.BorderRightWidthOp {
        return ui_styling.BorderRightWidthOp { value: value };
    }

    export fn borderB(value: real): ui_styling.BorderBottomWidthOp {
        return ui_styling.BorderBottomWidthOp { value: value };
    }

    export fn borderL(value: real): ui_styling.BorderLeftWidthOp {
        return ui_styling.BorderLeftWidthOp { value: value };
    }

    // One shared color for all of this element's borders -- see the question
    // asked before implementing: per-edge width is supported, per-edge color
    // is not (yet).
    export fn borderColor(color: Color): ui_styling.BorderColorOp {
        return ui_styling.BorderColorOp { color: color };
    }

    export fn rounded(value: real): ui_styling.CornerRadiusOp {
        return ui_styling.CornerRadiusOp {
            cornerRadius: ui_styling.StyleCornerRadiusSimple { value: value },
        };
    }

    export fn fontSize(value: real): ui_styling.FontSizeOp {
        return ui_styling.FontSizeOp { value: value };
    }

    export fn fontFamily(value: str): ui_styling.FontFamilyOp {
        return ui_styling.FontFamilyOp { value: value };
    }

    // Mouse cursor, mirroring Tailwind's `cursor-*` utilities. `cursor(...)`
    // is the general form; the rest are the shorthands you actually reach
    // for, named exactly as Tailwind names them (cursor-pointer ->
    // cursorPointer, cursor-not-allowed -> cursorNotAllowed, ...).
    //
    // Inherits like CSS: setting this on a container covers its whole
    // subtree, and a descendant can override it (including back to
    // cursorDefault()).
    export fn cursor(value: ui_styling.Cursor): ui_styling.CursorOp {
        return ui_styling.CursorOp { value: value };
    }

    export fn cursorDefault(): ui_styling.CursorOp {
        return ui_styling.CursorOp { value: ui_styling.Cursor.Default };
    }

    export fn cursorPointer(): ui_styling.CursorOp {
        return ui_styling.CursorOp { value: ui_styling.Cursor.Pointer };
    }

    export fn cursorText(): ui_styling.CursorOp {
        return ui_styling.CursorOp { value: ui_styling.Cursor.Text };
    }

    export fn cursorWait(): ui_styling.CursorOp {
        return ui_styling.CursorOp { value: ui_styling.Cursor.Wait };
    }

    export fn cursorProgress(): ui_styling.CursorOp {
        return ui_styling.CursorOp { value: ui_styling.Cursor.Progress };
    }

    export fn cursorCrosshair(): ui_styling.CursorOp {
        return ui_styling.CursorOp { value: ui_styling.Cursor.Crosshair };
    }

    export fn cursorMove(): ui_styling.CursorOp {
        return ui_styling.CursorOp { value: ui_styling.Cursor.Move };
    }

    export fn cursorNotAllowed(): ui_styling.CursorOp {
        return ui_styling.CursorOp { value: ui_styling.Cursor.NotAllowed };
    }

    export fn cursorResizeNS(): ui_styling.CursorOp {
        return ui_styling.CursorOp { value: ui_styling.Cursor.ResizeNS };
    }

    export fn cursorResizeEW(): ui_styling.CursorOp {
        return ui_styling.CursorOp { value: ui_styling.Cursor.ResizeEW };
    }

    export fn cursorResizeNWSE(): ui_styling.CursorOp {
        return ui_styling.CursorOp { value: ui_styling.Cursor.ResizeNWSE };
    }

    export fn cursorResizeNESW(): ui_styling.CursorOp {
        return ui_styling.CursorOp { value: ui_styling.Cursor.ResizeNESW };
    }
}
