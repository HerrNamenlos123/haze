
__c__("#define GLFW_INCLUDE_NONE");
__c__("#include <GLFW/glfw3.h>");
__c__("#include <math.h>");
__c__("#include <string.h>");

extern C noemit fn strcmp(str1: ccstr, str2: ccstr): i32 :: final;
extern C noemit fn getenv(name: ccstr): ccstr :: final;

const GLFW_PLATFORM: i32;
const GLFW_PLATFORM_X11: i32;
const GLFW_ANY_PLATFORM: i32;
const GLFW_CONTEXT_VERSION_MAJOR: i32;
const GLFW_CONTEXT_VERSION_MINOR: i32;
const GLFW_OPENGL_PROFILE: i32;
const GLFW_OPENGL_CORE_PROFILE: i32;
const GLFW_CLIENT_API: i32;
const GLFW_NO_API: i32;

namespace ffi {
    export extern C struct GLFWwindow {};
    export extern C struct GLFWmonitor {};

    extern C fn glfwInit(): i32 :: final;
    extern C fn glfwTerminate(): void :: final;
    extern C fn glfwCreateWindow(width: i32, height: i32, title: ccstr, monitor?: GLFWmonitor, share?: GLFWwindow): GLFWwindow | none :: final;
    extern C fn glfwDestroyWindow(w: GLFWwindow) :: final;
    extern C fn glfwWindowShouldClose(w: GLFWwindow): i32 :: final;
    extern C fn glfwSetWindowShouldClose(w: GLFWwindow, value: i32) :: final;
    extern C fn glfwSwapBuffers(w: GLFWwindow) :: final;
    extern C fn glfwSwapInterval(flag: i32) :: final;
    extern C fn glfwMakeContextCurrent(w: GLFWwindow) :: final;
    extern C fn glfwPollEvents() :: final;
    extern C fn glfwInitHint(hint: i32, value: i32) :: final;
    extern C fn glfwWindowHint(hint: i32, value: i32) :: final;
    extern C fn glfwGetTime(): f64 :: final;
    // extern C glfwMakeContextCurrent(w: GLFWwindow*);
    extern C fn glfwGetProcAddress(procname: ccstr): (() -> void) :: final;
    extern C noemit fn glfwGetFramebufferSize(w: GLFWwindow, width: cptr /* int* aka i32* */, height: cptr /* int* aka i32* */) :: final;

    export fn init(): bool {
        return glfwInit() != 0;
    }

    export fn terminate(): void {
        glfwTerminate();
    }

    export fn createWindow(width: i32, height: i32, title: ccstr, monitor?: GLFWmonitor, share?: GLFWwindow): GLFWwindow | none {
        return glfwCreateWindow(width, height, title, monitor, share);
    }

    export fn windowShouldClose(w: GLFWwindow): bool {
        return glfwWindowShouldClose(w) != 0;
    }

    export fn setWindowShouldClose(w: GLFWwindow, value: bool) {
        if value == true {
            glfwSetWindowShouldClose(w, 1);
        }
        else {
            glfwSetWindowShouldClose(w, 0);
        }
    }

    export fn swapBuffers(w: GLFWwindow) {
        glfwSwapBuffers(w);
    }

    export fn swapInterval(flags: i32) {
        glfwSwapInterval(flags);
    }

    export fn destroyWindow(w: GLFWwindow) {
        glfwDestroyWindow(w);
    }

    export fn makeContextCurrent(w: GLFWwindow) {
        glfwMakeContextCurrent(w);
    }

    export fn pollEvents() {
        glfwPollEvents();
    }

    export fn initHint(hint: i32, value: i32) {
        glfwInitHint(hint, value);
    }

    export fn windowHint(hint: i32, value: i32) {
        glfwWindowHint(hint, value);
    }

    export fn getTime(): f64 {
        return glfwGetTime() as f64;
    }

    export extern C fn glfw_getProcAddress(procname: ccstr): () -> void {
        return glfwGetProcAddress(procname);
    }
}

export struct Window {
    handle: ffi.GLFWwindow;

    fn makeContextCurrent() {
        ffi.makeContextCurrent(this.handle);
    }

    fn shouldClose(): bool {
        return ffi.windowShouldClose(this.handle);
    }

    fn close() {
        ffi.setWindowShouldClose(this.handle, true);
    }

    fn destroy() {
        ffi.destroyWindow(this.handle);
    }

    fn swapBuffers() {
        ffi.makeContextCurrent(this.handle);
        ffi.swapBuffers(this.handle);
    }

    fn swapInterval(interval: int) {
        if interval >= 0 && interval <= 10 {
            ffi.makeContextCurrent(this.handle);
            ffi.swapInterval(interval);
        }
    }

    fn getFramebufferSize() {
        let width = 0 as i32;
        let height = 0 as i32;
        let w = none as cptr;
        let h = none as cptr;
        __c__("w = &width;");
        __c__("h = &height;");
        ffi.glfwGetFramebufferSize(this.handle, w, h);
        return Vec2i(width, height);
    }

    fn getProcAddress(): ((name: ccstr) -> cptr) {
        // This makeContextCurrent() is important because getProcAddress is usually immediately passed to
        // gl.init, which then takes the GL context. It is important that the two are linked.
        // We just need to hope someone doesn't call getProcAddress and then do something else instead of gl.init()
        this.makeContextCurrent(); 

        do unsafe {
            const rawProc = ffi.glfw_getProcAddress;
            const castedProc: ((name: ccstr) -> cptr) = uninitialized;
            __c__("castedProc = (void*)rawProc;");
            return castedProc;
        };
    }
}

export struct WindowSizeConfig {
    width: int = 1080;
    height: int = 720;
}

export struct WindowConfig {
    title: ccstr;
    size: WindowSizeConfig = {};
    noApi: bool = false; // This prevents graphics context creation, which is required for Vulkan
}

export fn init(): bool {
    const desktop = getenv("XDG_CURRENT_DESKTOP");
    let valid = true;
    __c__("valid = desktop != 0;");
    if (valid && strcmp(desktop, "GNOME") == 0) {
        ffi.initHint(GLFW_PLATFORM, GLFW_PLATFORM_X11);
    }
    else {
        ffi.initHint(GLFW_PLATFORM, GLFW_ANY_PLATFORM);
    }
    return ffi.init();
}

export fn terminate() {
    ffi.terminate();
}

export fn createWindow(config: WindowConfig): Result<Window, none> {
    ffi.windowHint(GLFW_CONTEXT_VERSION_MAJOR, 3);
    ffi.windowHint(GLFW_CONTEXT_VERSION_MINOR, 3);
    ffi.windowHint(GLFW_OPENGL_PROFILE, GLFW_OPENGL_CORE_PROFILE);

    if (config.noApi) {
        ffi.windowHint(GLFW_CLIENT_API, GLFW_NO_API);
    }

    assert(config.size.width >= i32.min && config.size.width <= i32.max);
    assert(config.size.height >= i32.min && config.size.height <= i32.max);
    const handle = ffi.createWindow(config.size.width, config.size.height, config.title, none, none);
    if !handle {
        return Result<Window, none>.Err(none);
    }

    return Result<Window, none>.Ok(
        Window { handle: handle }
    );
}

export fn pollEvents() {
    ffi.pollEvents();
}

export fn getTime(): real {
    return ffi.getTime() as real;
}