import sdl
import sdl_wgpu
import wgpu
import renderer

export struct AppOptions {
    title: ccstr = "Haze App";
    presentMode: wgpu.PresentMode = wgpu.PresentMode.Fifo;
    // Does the OS draw this window's titlebar and frame?
    //
    // Turning it off makes the window borderless, and the application owes
    // it a titlebar of its own -- one that is a real titlebar, not a strip
    // that looks like one: see App.pushWindowRegion, which publishes where
    // that titlebar is so the window manager can go on doing everything it
    // did with the one it no longer draws (drag, double-click to maximize,
    // snap to an edge or a corner, tile, the window menu, the keyboard
    // move/resize gestures).
    nativeTitlebar: bool = true;
    size: sdl.WindowSizeConfig = {};
    startHidden: bool = false;
    hideOnClose: bool = false;
    // Open the window the way it was left: its size, whether it was
    // maximized, and -- where the platform lets an application place its
    // window, which Wayland does not (see sdl.applicationPlacesWindows) --
    // where it was, on a display that is still there. `size` is then only the
    // size of the very first window. Kept in the platform's state directory
    // under the [app] appId from haze.toml, which this needs. See
    // RememberedWindow.
    rememberWindowState: bool = false;
}

// ── Remembered window state ──────────────────────────────────────────────
//
// What AppOptions.rememberWindowState keeps of the window between runs, in
// <state directory>/<appId>/window-state.json.
//
// The size is the one the window returns to when it is restored, not the one
// it happens to have: a maximized or tiled window comes back maximized or at
// its own size, and un-maximizing it then gives back the size it had before,
// as it would have in the run it was left in. Its position is kept only where
// the platform lets an application place its window at all; on Wayland the
// compositor places every window itself.
//
// Written once the window has stayed the same for windowStateSettleSeconds,
// and again when it closes: a resize is a stream of changes, and an
// application that is killed, crashes or loses power never gets to close, so
// what it was left like must already be on disk.

export struct RememberedWindow {
    // The size the window returns to when it is restored, in the desktop's
    // coordinates (logical pixels where the platform scales).
    width: int;
    height: int;
    maximized: bool = false;
    // Where it was. none where the platform places windows itself.
    placement: RememberedPlacement | none = none;
}

export struct RememberedPlacement {
    // The top left corner of the window's restore rect.
    x: int;
    y: int;
    // The work area of the display the window was on, when it was left. A
    // display whose work area is no longer this one has changed (or is
    // another display), and the window may no longer fit where it was.
    workArea: sdl.Rect;
}

const windowStateSettleSeconds = 0.5;

// Larger than any real window, so a file that says more is not trusted.
const maxRememberedWindowSize = 16384;
const maxRememberedCoordinate = 1048576;

// The least of a restored window that stays on a display: enough of its top
// edge to grab the titlebar beside a button or two, and enough of its height
// to hold the titlebar. A window or a work area smaller than that is shown
// whole.
const minVisibleWidth = 100;
const minVisibleHeight = 50;

fn minInt(a: int, b: int): int {
    return a < b ? a : b;
}

fn maxInt(a: int, b: int): int {
    return a > b ? a : b;
}

// `value` moved into [low, high]; low wins where the two cross.
fn clampInt(value: int, low: int, high: int): int {
    return maxInt(low, minInt(value, high));
}

fn rectOverlapArea(a: sdl.Rect, b: sdl.Rect): int {
    let width = minInt(a.x + a.width, b.x + b.width) - maxInt(a.x, b.x);
    let height = minInt(a.y + a.height, b.y + b.height) - maxInt(a.y, b.y);
    if width <= 0 || height <= 0 {
        return 0;
    }
    return width * height;
}

// The squared distance between the nearest points of two rectangles; 0 where
// they touch or overlap.
fn rectGapSquared(a: sdl.Rect, b: sdl.Rect): int {
    let dx = maxInt(0, maxInt(b.x - (a.x + a.width), a.x - (b.x + b.width)));
    let dy = maxInt(0, maxInt(b.y - (a.y + a.height), a.y - (b.y + b.height)));
    return dx * dx + dy * dy;
}

fn rectContains(outer: sdl.Rect, inner: sdl.Rect): bool {
    return inner.x >= outer.x && inner.y >= outer.y
        && inner.x + inner.width <= outer.x + outer.width
        && inner.y + inner.height <= outer.y + outer.height;
}

// Which of the displays' `areas` a window at `rect` is on: the one it
// overlaps most, or the nearest one when it overlaps none -- the rule
// Windows' MonitorFromRect applies. A tie goes to the earlier area, which
// puts the primary display first (see sdl.displayWorkAreas). -1 for no areas.
export fn displayIndexFor(rect: sdl.Rect, areas: []sdl.Rect): int {
    let best = -1;
    let bestOverlap = 0;
    for (let i = 0; i < areas.length; i++) {
        let overlap = rectOverlapArea(rect, areas[i]);
        if overlap > bestOverlap {
            best = i;
            bestOverlap = overlap;
        }
    }
    if best >= 0 {
        return best;
    }
    let bestGap = 0;
    for (let i = 0; i < areas.length; i++) {
        let gap = rectGapSquared(rect, areas[i]);
        if best < 0 || gap < bestGap {
            best = i;
            bestGap = gap;
        }
    }
    return best;
}

// Where a window remembered at `rect` goes on the displays there are now:
// `areas`, their work areas, of which there is at least one. `savedArea` is
// the work area of the display it was on (RememberedPlacement.workArea).
//
// On displays that have not changed, the window goes back exactly where it
// was, even partly off the edge where the user left it so. Only so far off
// that it could not be grabbed is it pulled back: its titlebar never above
// the work area, and at least minVisibleWidth x minVisibleHeight of it on
// the display. A window whose display changed (another resolution, another
// arrangement, or gone, so that it lands on another one) and that no longer
// fits where it was goes wholly onto the display it is now on, shrunk to the
// work area if it is larger.
export fn placeOnDisplays(rect: sdl.Rect, savedArea: sdl.Rect, areas: []sdl.Rect): sdl.Rect {
    assert(areas.length > 0);
    let area = areas[displayIndexFor(rect, areas)];
    let result = rect;
    if area != savedArea && !rectContains(area, rect) {
        result.width = minInt(rect.width, area.width);
        result.height = minInt(rect.height, area.height);
        result.x = clampInt(rect.x, area.x, area.x + area.width - result.width);
        result.y = clampInt(rect.y, area.y, area.y + area.height - result.height);
        return result;
    }
    let visibleWidth = minInt(minVisibleWidth, minInt(rect.width, area.width));
    let visibleHeight = minInt(minVisibleHeight, minInt(rect.height, area.height));
    result.x = clampInt(rect.x, area.x + visibleWidth - rect.width, area.x + area.width - visibleWidth);
    result.y = clampInt(rect.y, area.y, area.y + area.height - visibleHeight);
    return result;
}

// <state directory>/<appId>/window-state.json, none without a state
// directory. The XDG state directory on Linux (XDG_STATE_HOME, which must be
// an absolute path, or ~/.local/state), %LOCALAPPDATA% on Windows.
fn windowStatePath(appId: str): str | none {
    if sys.isWin32() {
        if let local = env.get("LOCALAPPDATA") {
            if local.length > 0 {
                return f"{local}/{appId}/window-state.json";
            }
        }
        return none;
    }
    if let dir = env.get("XDG_STATE_HOME") {
        if dir.startsWith("/") {
            return f"{dir}/{appId}/window-state.json";
        }
    }
    if let home = env.get("HOME") {
        if home.length > 0 {
            return f"{home}/.local/state/{appId}/window-state.json";
        }
    }
    return none;
}

// What the file at `path` remembers: none when there is no file yet, and
// none for a file that is unreadable or holds what no window could have been
// (it is then replaced by the next save).
fn loadRememberedWindow(path: str): RememberedWindow | none {
    let text = fs.readText(path);
    if !text {
        return none;
    }
    let parsed = json.parse<RememberedWindow>(text);
    if !parsed {
        fmt.println(f"The remembered window state in {path} is not valid and is ignored: {parsed}");
        return none;
    }
    let state = parsed;
    if state.width < 1 || state.width > maxRememberedWindowSize || state.height < 1 || state.height > maxRememberedWindowSize {
        return none;
    }
    if let placement = state.placement {
        let area = placement.workArea;
        let coordinatesValid = placement.x >= -maxRememberedCoordinate && placement.x <= maxRememberedCoordinate
            && placement.y >= -maxRememberedCoordinate && placement.y <= maxRememberedCoordinate
            && area.x >= -maxRememberedCoordinate && area.x <= maxRememberedCoordinate
            && area.y >= -maxRememberedCoordinate && area.y <= maxRememberedCoordinate
            && area.width >= 1 && area.width <= maxRememberedCoordinate
            && area.height >= 1 && area.height <= maxRememberedCoordinate;
        if !coordinatesValid {
            state.placement = none;
        }
    }
    return state;
}

// The window as it would be remembered: its restore rect and whether it is
// maximized. Compared frame to frame, so it holds only what is cheap to read.
// Exported because App's fields name it, as with every type they hold.
export struct WindowGeometry {
    rect: sdl.Rect;
    maximized: bool;
}

fn pickSurfaceFormat(caps: wgpu.SurfaceCapabilities): wgpu.TextureFormat {
    for format in caps.formats {
        if format != wgpu.TextureFormat.BGRA8UnormSrgb && format != wgpu.TextureFormat.RGBA8UnormSrgb {
            return format;
        }
    }
    return caps.formats[0];
}

// The window's surface and the adapter that will draw to it.
struct GpuConnection {
    surface: wgpu.Surface;
    adapter: wgpu.Adapter;
}

fn connectGpuWith(window: sdl.Window, backends: wgpu.InstanceBackend, allowSoftware: bool): Result<GpuConnection, str> {
    let instance = wgpu.createInstance(backends);
    if !instance { return "WGPU instance creation failed"; }

    let surface = sdl_wgpu.createWindowWGPUSurface(instance, window);
    if !surface { return "WGPU surface creation failed"; }

    let adapter = instance.requestAdapterSync({});
    if !adapter { return f"No graphics adapter: {adapter}"; }
    if !allowSoftware && adapter.isSoftware() { return "Only a software graphics adapter"; }

    return GpuConnection { surface: surface, adapter: adapter };
}

// wgpu's first-class backends first (Vulkan, Metal, DX12), and every backend
// only when those have no GPU to offer. An instance brings up each backend it
// is allowed, used or not: with all of them, a Linux application loaded the
// OpenGL driver and made an EGL context beside the Vulkan device it actually
// drew with -- 13 MB of memory and its share of the startup time.
fn connectGpu(window: sdl.Window): Result<GpuConnection, str> {
    let primary = connectGpuWith(window, wgpu.primaryBackends(), false);
    if primary {
        return primary;
    }
    return connectGpuWith(window, wgpu.InstanceBackend.All, true);
}

// Falls back to Fifo (the only present mode WebGPU guarantees every backend
// supports) when the requested mode isn't in this surface's capabilities --
// requesting an unsupported mode is a hard validation-error panic in wgpu,
// not a recoverable Result, so this has to be checked before configure().
fn pickPresentMode(caps: wgpu.SurfaceCapabilities, requested: wgpu.PresentMode): wgpu.PresentMode {
    for mode in caps.presentModes {
        if mode == requested { return requested; }
    }
    return wgpu.PresentMode.Fifo;
}

fn getWindowState(window: sdl.Window): renderer.gfx.CanvasSize {
    let logicalSize = window.getLogicalSize();
    let framebufferSize = window.getFramebufferSize();
    let dpiScaleX = logicalSize.x > 0 ? framebufferSize.x as real / logicalSize.x as real : 1.0;
    let dpiScaleY = logicalSize.y > 0 ? framebufferSize.y as real / logicalSize.y as real : 1.0;
    let dpiScale = (dpiScaleX + dpiScaleY) / 2.0;
    return renderer.gfx.CanvasSize {
        logicalSize: logicalSize,
        framebufferSize: framebufferSize,
        dpiScale: dpiScale as f32,
    };
}

// Bundles SDL + WGPU init, surface configuration, and the renderer context/canvas
// into one struct. Exposes every piece (gfx, canvas, window, device, surface,
// surfaceFormat) so nothing is hidden — use individual modules directly when
// you need to deviate from the defaults.
export ref struct AppPointerButtons {
    leftHeld: bool = false;
    middleHeld: bool = false;
    rightHeld: bool = false;
}

// Moved and Cancelled joined Pressed/Released when pens and touch did: a pen
// stroke or a pinch needs every position the device reported, not just where
// the pointer ended up by the time the frame was drawn.
export enum PointerEdgeKind { Pressed, Released, Moved, Cancelled }

export enum PointerType { Mouse, Pen, Touch }

// One press, release or move, queued in the exact order SDL delivered it, with
// the pointer position at that moment -- appended to by the SDL callbacks below
// and drained (reset) at the top of nextFrame(), same one-frame-window
// lifecycle as App.wheelDeltaThisFrame. This exists *in addition to* the
// level state in AppPointerButtons above: a single held-boolean (or even a
// single "did it change" latch) can only describe at most one transition per
// frame. If two, three, or a dozen down+up pairs for the same button all
// land within one pollEvents() call -- entirely possible on a slow/variable
// frame, and trivially possible for a burst of clicks even on a fast one --
// a level or a latch collapses all of them into whatever the net effect
// happens to be (often nothing at all, since down+up cancel out), silently
// dropping every click but the net transition. Queuing every individual edge
// as it happens, instead of folding it into shared mutable state, means
// nothing SDL reports within a frame can ever be lost, no matter how many
// events land in that frame.
//
// The same goes for motion. Pen and touch moves are queued one per sample,
// because ink drawn from a frame's last position alone is a polygon. Mouse
// moves in a row collapse into one (the latest position): nothing draws with
// the mouse at that resolution, and a gaming mouse reports a thousand of them
// a second.
//
// The fields after `pos` follow the DOM's PointerEvent, and default to the
// mouse so an edge built from the old three fields still means what it did.
//
// A value, stored inline in the queue: the queue keeps its buffer from frame
// to frame, so queuing an edge allocates nothing. As a `ref struct` every
// mouse move and every pen sample was a heap object of its own.
export struct PointerEdge {
    // matches sdl.MouseButtonEvent.button: 0=left (a pen's tip, a finger),
    // 1=middle, 2=right (and a pen's tip with the barrel button held, see
    // PenContacts); 5 is a pen's eraser end, as in the DOM. -1 on a move.
    button: int;
    kind: PointerEdgeKind;
    pos: Vec2;
    // 1 is the mouse. Pens and fingers get ids of their own (see
    // penPointerId/touchPointerId), stable from Pressed to Released.
    pointerId: int = 1;
    pointerType: PointerType = PointerType.Mouse;
    // The DOM's PointerEvent.buttons AFTER this edge: 1 = left/tip/finger,
    // 2 = right/barrel, 4 = middle/second barrel, 32 = eraser.
    buttons: int = 0;
    pressure: real = 0.0;
    // The mouse and the pen always are; of several fingers, only the first
    // one down -- the DOM's rule, which is what lets a two-finger pinch leave
    // clicks and focus alone.
    isPrimary: bool = true;
}

fn penPointerId(id: int): int {
    return 1000 + id;
}

fn touchPointerId(id: int): int {
    return 100000 + id;
}

// Bitflag tests without an `&` operator -- see ui_components.hasButton.
fn hasBit(value: int, bit: int): bool :: final {
    do unsafe {
        let result: bool = uninitialized;
        __c__("result = (value & bit) != 0;");
        return result;
    };
}

// The pens in contact, and which button each contact is.
//
// The tip is the left button and the eraser end button 5, as in the DOM. The
// tip pressed with the barrel button held is the pen's right click: the
// gesture Windows Ink and GTK make the barrel button's, and the one that asks
// for a context menu, as a right press does. Which button it is, the touch-down
// decides, and the lift-off releases that same button whatever was let go of
// in between: a press and its release are one button.
//
// Only pens in contact are kept: SDL may give a pen a new id each time it comes
// into range, so an entry per id ever seen would grow for as long as the app
// runs.
export ref struct PenContacts {
    _pressed: LinearMap<int, int> = {};

    // The button of the edge a pen event makes, with `buttons` the DOM bits
    // the event reports: what a touch-down presses, what a lift-off releases,
    // and -1 for a move or a cancel (the DOM's pointercancel has no button).
    fn button(kind: sdl.PointerEventKind, id: int, buttons: int): int {
        if kind == sdl.PointerEventKind.Down {
            let pressed = 0;
            if hasBit(buttons, 32) {
                pressed = 5;
            } else if hasBit(buttons, 2) {
                pressed = 2;
            }
            this._pressed.set(id, pressed);
            return pressed;
        }
        if kind == sdl.PointerEventKind.Up || kind == sdl.PointerEventKind.Cancel {
            let pressed = this._pressed.get(id) ?? 0;
            this._pressed.delete(id);
            return kind == sdl.PointerEventKind.Up ? pressed : -1;
        }
        return -1;
    }

    // How many pens are in contact.
    fn inContact(): int {
        return this._pressed.size();
    }
}

// The edge a pen event makes: its button from `contacts`, the rest the pen's
// own.
export fn penEdge(contacts: PenContacts, e: sdl.PointerEvent): PointerEdge {
    let kind = PointerEdgeKind.Moved;
    if e.kind == sdl.PointerEventKind.Down {
        kind = PointerEdgeKind.Pressed;
    } else if e.kind == sdl.PointerEventKind.Up {
        kind = PointerEdgeKind.Released;
    } else if e.kind == sdl.PointerEventKind.Cancel {
        kind = PointerEdgeKind.Cancelled;
    }
    return PointerEdge {
        button: contacts.button(e.kind, e.id, e.buttons),
        kind: kind,
        pos: e.pos,
        pointerId: penPointerId(e.id),
        pointerType: PointerType.Pen,
        buttons: e.buttons,
        pressure: e.pressure,
    };
}

export enum KeyEdgeKind { Pressed, Released }

// One key press or release, queued in order -- same reasoning as PointerEdge
// above: a burst of keystrokes (someone typing at a normal pace while a
// frame takes a while, or just fast typing/repeat) can easily produce
// several key down/up pairs within one frame, and a level or single-edge
// latch would silently drop all but the net effect.
export ref struct KeyEdge {
    key: sdl.Key;
    kind: KeyEdgeKind;
    repeat: bool;
    modifiers: KeyModifiers;
}

export opaque ref struct App {
    window: mut sdl.Window;
    device: wgpu.Device;
    surface: wgpu.Surface;
    surfaceFormat: wgpu.TextureFormat;
    caps: wgpu.SurfaceCapabilities;
    presentMode: wgpu.PresentMode;
    gfx: mut renderer.gfx.Context;
    canvas: mut renderer.gfx.Canvas;
    // Owned once at startup and reset() in place every nextFrame(), never
    // reconstructed per tick -- see Frame's doc comment in renderer.hz for
    // why (reference semantics for correct sharing across every
    // Renderer(frame, canvas) call this frame, without the per-frame heap
    // allocation a fresh Frame(gfx) every tick would cost).
    frame: mut renderer.gfx.Frame;
    windowState: renderer.gfx.CanvasSize;
    mousePosition: Vec2 = {};
    // Has the pointer ever actually been located?
    //
    // mousePosition starts at (0,0), which is not a neutral value -- it is
    // the window's top-left corner, a perfectly ordinary place for a real
    // pointer to be. So until the platform has told us where the mouse
    // is, "the mouse is at 0,0" and "we have no idea where the mouse is"
    // are indistinguishable, and everything downstream reads the first
    // one: the element in the corner comes up hovered, before the pointer
    // has ever been over the window at all.
    //
    // This is what tells the two apart. Nothing sets it but a real
    // platform mouse event.
    //
    // It only answers "has the pointer ever been located", which is half the
    // question -- see pointerInside below for the other half, and
    // mousePosKnown() for the two together.
    mousePositionKnown: bool = false;

    // Is the pointer over this window RIGHT NOW? Refreshed once per
    // nextFrame(), beside the keyboard focus below and for the same reason.
    //
    // Without this, mousePosition keeps its last value forever once the
    // pointer leaves, and that value is never neutral: it is wherever the
    // pointer was when it crossed the edge, i.e. sitting exactly on top of
    // whatever it left through. Anything reading it then reports that element
    // as hovered for as long as the pointer is away -- which is a statement
    // about where the pointer is, and a false one. See
    // ui_components.UIContext.updateHoverState, which stops claiming anything
    // is hovered the moment this goes false.
    pointerInside: bool = false;

    // Was the last thing to set mousePosition a finger that has since lifted?
    //
    // The primary finger moves mousePosition like the mouse does, so the UI
    // hover-tests and hit-tests where it is. But a finger that lifted is not
    // anywhere: there is no pointer resting on the element it tapped, and
    // treating its last position as one leaves that element looking hovered
    // until the mouse happens to move -- the "sticky hover" every touch UI
    // has to work around. So a lifted finger leaves the position unknown
    // (see mousePosKnown) until a mouse or a pen reports one again.
    fingerLifted: bool = false;
    resized: bool = false;

    // ── Deferred first appearance ────────────────────────────────────
    //
    // The window is created hidden (see the constructor) and mapped by
    // nextFrame() only once a frame has actually been presented into it.
    //
    // Everything a frame needs -- the WGPU instance, the adapter, the
    // device, the swapchain, the render pipelines, the font atlas -- is
    // built after the window exists, and on a cold start that is a few
    // hundred milliseconds of work. A window that is on screen for all of
    // it has nothing to show but an empty surface, which the compositor
    // paints black: the flash between launching an application and seeing
    // it. Waiting costs nothing (the window simply appears a moment later,
    // already drawn) and it is what makes the first painted pixels the UI's
    // rather than the compositor's fallback.
    //
    // `framePresented` is set by nextFrame() itself rather than by the
    // presenting code: nextFrame() returning a second time means the caller
    // has been all the way around its loop, which is precisely "a frame was
    // rendered and presented". No caller has to remember to say so, and a
    // loop that presents through some other path still gets it right.
    //
    // That is the order where a window is on screen the moment it is shown.
    // On Wayland it is the other way round, and the protocol already does
    // what the waiting is for: a shown window stays off screen until its
    // first frame arrives, and that frame is what maps it. There the window
    // is shown first and drawn into after -- and must be, since a hidden
    // Wayland window has nowhere on screen for a frame to go (see
    // sdl.Window.appearsWithFirstFrame). Either way nothing is ever presented
    // into a window that is neither on screen nor about to be: see
    // `canvas.setOnScreen` in nextFrame() and hide().
    windowShown: bool = false;
    framePresented: bool = false;
    hideOnClose: bool = false;

    // ── Remembered window state (AppOptions.rememberWindowState) ───────
    //
    // Where it is kept, none when it is not remembered; what the file holds;
    // the window as last seen, and when that last changed. Seen only while
    // the window is on screen and not minimized: a minimized window was
    // maximized or not before it was minimized, and that is what it comes
    // back as.
    _windowStatePath: str | none = none;
    _savedWindow: RememberedWindow | none = none;
    _windowGeometry: WindowGeometry | none = none;
    _windowGeometryChangedAt: real = 0.0;
    _windowStateUnsaved: bool = false;

    // When the current tick began (sdl.getTime(), seconds) -- stamped by
    // nextFrame(), read by idle() to keep skipped ticks from running
    // back-to-back.
    _tickStart: real = 0.0;

    // ── OS window focus ──────────────────────────────────────────────
    //
    // `focused` is the live state; the two edges beside it are true for
    // exactly the one frame the state flipped, the same one-frame-window
    // lifecycle `resized` above has.
    //
    // An application cares about the EDGE far more than the level -- "the
    // user just switched away, flush unsaved work" and "the user just came
    // back, re-check what changed underneath us" -- and computing it here
    // rather than in every caller is what keeps two consumers from each
    // having to keep their own previous-value variable and disagreeing
    // about which frame the transition happened on.
    //
    // `focused` starts false, so the first frame of a window that opens
    // focused reports focusGained. That is deliberate: "the window just
    // became current" is exactly what a startup frame is.
    //
    // A window shown that the platform puts on screen WITHOUT the focus
    // reports focusLost too, although it never had it: for the user it is the
    // same thing -- they are working somewhere else while it sits there -- and
    // an application that only shows a window while it is in use (a tray
    // popup that hides on focusLost) must never be left open in that state.
    // See sdl.Window.consumeFocusRefused.
    focused: bool = false;
    focusGained: bool = false;
    focusLost: bool = false;
    _pointerButtons: AppPointerButtons = {};
    // Who is holding the primary "left" level down. The UI polls one level
    // for the primary pointer (leftHeld), but the mouse, a pen tip and the
    // first finger can each hold it, so it is the OR of the three rather than
    // a flag any one of them could clear from under another.
    _mouseLeftHeld: bool = false;
    _penTipHeld: bool = false;
    _touchHeld: bool = false;
    // Which button each pen in contact pressed, which its release reports
    // (the up itself only says what is still down afterwards).
    _penContacts: PenContacts = {};
    // The fingers currently down, in landing order, and whether the first
    // of them -- the primary one -- is still among them. A finger that lands
    // while others are down is never primary, even after the primary lifts.
    _activeTouches: []int = [];
    _primaryTouch: int = 0;
    _hasPrimaryTouch: bool = false;
    _pointerEdgeQueue: []PointerEdge = [];
    _keyEdgeQueue: []KeyEdge = [];
    // Committed text chunks (SDL_EVENT_TEXT_INPUT) queued this frame, in
    // order -- see sdl.TextInputEvent for why this is separate from key
    // edges above.
    _textInputQueue: []str = [];
    // This-frame's accumulated wheel delta/modifiers -- reset at the top of
    // nextFrame() (before pollEvents() re-accumulates fresh values into it),
    // so it holds exactly one frame's worth of scroll input by the time
    // nextFrame() returns, same one-frame-window lifecycle `resized` uses.
    wheelDeltaThisFrame: Vec2 = {};
    wheelModifiersThisFrame: KeyModifiers = KeyModifiers.None;

    fn constructor(options: AppOptions): Result<mut App, str> {
        // The one window is the only one there is, so whether it has a native
        // titlebar is whether the platform's decorations are needed at all.
        let initResult = sdl.init(options.nativeTitlebar);
        if !initResult { return f"SDL init failed: {initResult}"; }

        let statePath: str | none = none;
        let remembered: RememberedWindow | none = none;
        if options.rememberWindowState {
            let appId = sys.appId();
            if !appId {
                return "AppOptions.rememberWindowState needs an [app] appId in haze.toml: the state is kept under it";
            }
            statePath = windowStatePath(appId);
            if let path = statePath {
                remembered = loadRememberedWindow(path);
            }
            else {
                fmt.println("The window state is not remembered: there is no state directory to keep it in");
            }
        }

        let width = options.size.width;
        let height = options.size.height;
        let maximized = false;
        let position: Vec2i | none = none;
        if let state = remembered {
            width = state.width;
            height = state.height;
            maximized = state.maximized;
            let areas = sdl.displayWorkAreas();
            if sdl.applicationPlacesWindows() && areas.length > 0 {
                if let placement = state.placement {
                    let placed = placeOnDisplays(
                        sdl.Rect { x: placement.x, y: placement.y, width: width, height: height },
                        placement.workArea,
                        areas,
                    );
                    position = Vec2i(placed.x, placed.y);
                    width = placed.width;
                    height = placed.height;
                }
            }
            if !position {
                // Placed by the platform, on a display it has not named yet.
                // Kept no larger than the largest display, so that a window
                // remembered from a larger one never opens larger than any
                // screen there is.
                let largestWidth = 0;
                let largestHeight = 0;
                for area in areas {
                    largestWidth = maxInt(largestWidth, area.width);
                    largestHeight = maxInt(largestHeight, area.height);
                }
                if largestWidth > 0 && largestHeight > 0 {
                    width = minInt(width, largestWidth);
                    height = minInt(height, largestHeight);
                }
            }
        }

        let window = sdl.createWindow({
            title: options.title,
            size: { width: width, height: height },
            position: position,
            maximized: maximized,
            noApi: true,
            borderless: !options.nativeTitlebar,
            // Not on screen yet -- see windowShown below.
            hidden: true,
        });
        if !window { return f"Window creation failed: {window}"; }

        // A borderless window is inert until the platform is told which of
        // its pixels are titlebar and which are its (now interior) resize
        // handles -- without this it cannot be moved or resized at all. Only
        // installed when the decorations are actually gone: on a normally
        // decorated window the same hit test would carve fake resize borders
        // out of the inside of the frame the platform already draws.
        if !options.nativeTitlebar {
            if !window.enableHitTest() {
                return "This platform has no window hit-test support, so a borderless window cannot be moved or resized";
            }
        }

        let gpu = connectGpu(window);
        if !gpu { return f"{gpu}"; }
        let surface = gpu.surface;
        let adapter = gpu.adapter;
        let device = adapter.requestDeviceSync({})?!;

        let caps = surface.getCapabilities(adapter);
        if !caps { return "Failed to get surface capabilities"; }

        let surfaceFormat = pickSurfaceFormat(caps);
        let windowState = getWindowState(window);
        let presentMode = pickPresentMode(caps, options.presentMode);

        surface.configure({
            device: device,
            format: surfaceFormat,
            usage: wgpu.TextureUsage.RenderAttachment,
            width: windowState.framebufferSize.x,
            height: windowState.framebufferSize.y,
            presentMode: presentMode,
            alphaMode: caps.alphaModes[0],
        });

        let gfx = renderer.gfx.Context({
            device: device,
            targetFormat: surfaceFormat,
        });

        let canvas = renderer.gfx.Canvas({
            gfx: gfx,
            size: windowState,
            surface: surface,
        });
        // The window was created hidden; nextFrame() puts the canvas on
        // screen with it.
        canvas.setOnScreen(false);


        let pointerButtons = AppPointerButtons {};
        let frame = renderer.gfx.Frame(gfx);
        let app = App {
            window: window,
            device: device,
            surface: surface,
            surfaceFormat: surfaceFormat,
            caps: caps,
            presentMode: presentMode,
            gfx: gfx,
            canvas: canvas,
            frame: frame,
            windowState: windowState,
            mousePosition: {},
            _pointerButtons: pointerButtons,
            windowShown: options.startHidden,
            hideOnClose: options.hideOnClose,
            _windowStatePath: statePath,
            _savedWindow: remembered,
        };

        window.onMouseMove((e: sdl.MouseMoveEvent) => {
            app.mousePosition.x = e.pos.x;
            app.mousePosition.y = e.pos.y;
            // First real word on where the pointer is -- see
            // mousePositionKnown.
            app.mousePositionKnown = true;
            app.fingerLifted = false;
            app.queueMouseMove(e.pos);
            return false;
        });
        window.onMouseDown((e: sdl.MouseButtonEvent) => {
            if e.button == 0 { app._mouseLeftHeld = true; }
            if e.button == 1 { pointerButtons.middleHeld = true; }
            if e.button == 2 { pointerButtons.rightHeld = true; }
            app.refreshLeftHeld();
            // A click carries a position too, and can legitimately be the
            // FIRST thing we hear about the pointer: click into an
            // unfocused window without moving first and the press may
            // arrive before any motion event.
            app.mousePosition.x = e.pos.x;
            app.mousePosition.y = e.pos.y;
            app.mousePositionKnown = true;
            app.fingerLifted = false;
            app._pointerEdgeQueue.push({ button: e.button, kind: PointerEdgeKind.Pressed, pos: e.pos, buttons: app.mouseButtons() });
            return false;
        });
        window.onMouseUp((e: sdl.MouseButtonEvent) => {
            if e.button == 0 { app._mouseLeftHeld = false; }
            if e.button == 1 { pointerButtons.middleHeld = false; }
            if e.button == 2 { pointerButtons.rightHeld = false; }
            app.refreshLeftHeld();
            app._pointerEdgeQueue.push({ button: e.button, kind: PointerEdgeKind.Released, pos: e.pos, buttons: app.mouseButtons() });
            return false;
        });
        window.onPointer((e: sdl.PointerEvent) => {
            if e.device == sdl.PointerDevice.Pen {
                app.handlePen(e);
            } else {
                app.handleTouch(e);
            }
            return false;
        });
        window.onMouseWheel((e: sdl.MouseWheelEvent) => {
            app.wheelDeltaThisFrame.x += e.delta.x;
            app.wheelDeltaThisFrame.y += e.delta.y;
            app.wheelModifiersThisFrame = e.modifiers;
            return false;
        });
        window.onKeyDown((e: sdl.KeyEvent) => {
            app._keyEdgeQueue.push({ key: e.key, kind: KeyEdgeKind.Pressed, repeat: e.repeat, modifiers: e.modifiers });
            return false;
        });
        window.onKeyUp((e: sdl.KeyEvent) => {
            app._keyEdgeQueue.push({ key: e.key, kind: KeyEdgeKind.Released, repeat: e.repeat, modifiers: e.modifiers });
            return false;
        });
        window.onTextInput((e: sdl.TextInputEvent) => {
            app._textInputQueue.push(e.text);
            return false;
        });

        return app;
    }

    fn mousePos(): Vec2 {
        return this.mousePosition;
    }

    // ── Pointer bookkeeping (called from the SDL callbacks above) ──────

    fn refreshLeftHeld() {
        this._pointerButtons.leftHeld = this._mouseLeftHeld || this._penTipHeld || this._touchHeld;
    }

    // The mouse's own buttons as a DOM bitmask -- its buttons only, so a pen
    // tip that happens to be down does not show up on a mouse event.
    fn mouseButtons(): int {
        let buttons = 0;
        if this._mouseLeftHeld { buttons += 1; }
        if this._pointerButtons.rightHeld { buttons += 2; }
        if this._pointerButtons.middleHeld { buttons += 4; }
        return buttons;
    }

    // Consecutive mouse moves collapse into one -- see PointerEdge.
    fn queueMouseMove(pos: Vec2) {
        let n = this._pointerEdgeQueue.length;
        if n > 0 {
            let last = this._pointerEdgeQueue[n - 1];
            if last.kind == PointerEdgeKind.Moved && last.pointerType == PointerType.Mouse {
                // Whole-element assignment: `last` is a copy of a value-typed
                // element, so writing to it alone would not reach the queue.
                last.pos = pos;
                this._pointerEdgeQueue[n - 1] = last;
                return;
            }
        }
        this._pointerEdgeQueue.push({ button: -1, kind: PointerEdgeKind.Moved, pos: pos, buttons: this.mouseButtons() });
    }

    // The pen is always a primary pointer: it moves the position the UI
    // hovers with and its tip holds the primary level, exactly as the mouse
    // does -- a pen is how a tablet user clicks buttons, too.
    fn handlePen(e: sdl.PointerEvent) {
        this.mousePosition = e.pos;
        this.mousePositionKnown = true;
        this.fingerLifted = false;
        this._penTipHeld = hasBit(e.buttons, 1);
        this.refreshLeftHeld();

        this._pointerEdgeQueue.push(penEdge(this._penContacts, e));
    }

    fn handleTouch(e: sdl.PointerEvent) {
        let kind = PointerEdgeKind.Moved;
        let button = -1;
        if e.kind == sdl.PointerEventKind.Down {
            kind = PointerEdgeKind.Pressed;
            button = 0;
            if this._activeTouches.length == 0 {
                this._primaryTouch = e.id;
                this._hasPrimaryTouch = true;
            }
            this._activeTouches.push(e.id);
        } else if e.kind == sdl.PointerEventKind.Up || e.kind == sdl.PointerEventKind.Cancel {
            kind = e.kind == sdl.PointerEventKind.Up ? PointerEdgeKind.Released : PointerEdgeKind.Cancelled;
            button = 0;
            for (let i = 0; i < this._activeTouches.length; i++) {
                if this._activeTouches[i] == e.id {
                    this._activeTouches.remove(i);
                    break;
                }
            }
        }

        let isPrimary = this._hasPrimaryTouch && this._primaryTouch == e.id;
        if isPrimary {
            this.mousePosition = e.pos;
            this.mousePositionKnown = true;
            this._touchHeld = kind == PointerEdgeKind.Pressed || kind == PointerEdgeKind.Moved;
            this.refreshLeftHeld();
            // See fingerLifted: in contact it is where the pointer is, lifted
            // it is nowhere.
            this.fingerLifted = !this._touchHeld;
            if kind == PointerEdgeKind.Released || kind == PointerEdgeKind.Cancelled {
                this._hasPrimaryTouch = false;
            }
        }

        this._pointerEdgeQueue.push({
            button: button,
            kind: kind,
            pos: e.pos,
            pointerId: touchPointerId(e.id),
            pointerType: PointerType.Touch,
            buttons: e.buttons,
            pressure: e.pressure,
            isPrimary: isPrimary,
        });
    }

    // Whether mousePos() means anything RIGHT NOW.
    //
    // Both halves have to hold: the platform must have reported the pointer at
    // least once (mousePositionKnown -- otherwise (0,0) would read as the
    // top-left corner), and the pointer must be over this window at this
    // moment (pointerInside -- otherwise the last position inside would go on
    // answering forever). Either one alone leaves a UI claiming something is
    // hovered when nothing is.
    //
    // And a third: the position must not be the one a lifted finger left
    // behind (see fingerLifted).
    fn mousePosKnown(): bool {
        return this.mousePositionKnown && this.pointerInside && !this.fingerLifted;
    }

    fn pointerLeftHeld(): bool {
        return this._pointerButtons.leftHeld;
    }

    fn pointerMiddleHeld(): bool {
        return this._pointerButtons.middleHeld;
    }

    fn pointerRightHeld(): bool {
        return this._pointerButtons.rightHeld;
    }

    // Every press/release queued this frame, in the exact order SDL
    // delivered them -- see PointerEdge for why callers need this instead of
    // just diffing pointer*Held() frame to frame.
    fn pointerEdges(): []PointerEdge {
        return this._pointerEdgeQueue;
    }

    // Turn the platform's text entry on or off -- see
    // sdl.Window.setTextInputActive. Meant to be driven by the UI's own idea
    // of text focus (ui_components.KeyboardCallbacks.setTextInputActive), so
    // the on-screen keyboard of a touch device comes up exactly when a text
    // field is focused.
    fn setTextInputActive(active: bool) {
        this.window.setTextInputActive(active);
    }

    // Every key press/release queued this frame, in order -- see KeyEdge.
    fn keyEdges(): []KeyEdge {
        return this._keyEdgeQueue;
    }

    // Every committed text chunk queued this frame, in order.
    fn textInput(): []str {
        return this._textInputQueue;
    }

    fn wheelDelta(): Vec2 {
        return this.wheelDeltaThisFrame;
    }

    fn wheelModifiers(): KeyModifiers {
        return this.wheelModifiersThisFrame;
    }

    // Is the window the one the user is working in -- the OS focus (on
    // Wayland the compositor's "activated" state rather than the keyboard,
    // see sdl.Window.hasFocus)? See the fields above for why the two edges
    // are published alongside it.
    fn hasFocus(): bool {
        return this.focused;
    }

    // True for exactly the frame the window lost the OS focus, or,
    // just shown, came on screen without it (see `focused` above) -- the
    // moment to flush anything that should not be left unsaved while the
    // user is somewhere else.
    fn justLostFocus(): bool {
        return this.focusLost;
    }

    // True for exactly the frame the window regained it.
    fn justGainedFocus(): bool {
        return this.focusGained;
    }

    // ── The OS window ────────────────────────────────────────────────
    //
    // Everything a custom titlebar needs, in the platform's own terms. None
    // of it is emulated: close pushes the very event the window manager's
    // close button pushes, and minimize/maximize/restore are the platform
    // operations, so a hand-drawn titlebar's buttons behave exactly like the
    // ones they replaced.

    // Ask this window to close, exactly as if its X had been clicked. The
    // request travels through SDL's event queue and comes back out of
    // pollEvents() as an ordinary close-requested event, so nextFrame()
    // returns none on the next tick and the application runs its one
    // ordinary shutdown -- there is no second path out.
    fn requestClose() {
        this.window.close();
    }

    fn minimize() {
        this.window.minimize();
    }

    fn maximize() {
        this.window.maximize();
    }

    fn restore() {
        this.window.restore();
    }

    fn show() {
        this.windowShown = false;
        this.framePresented = false;
    }

    fn hide() {
        // Hiding to the background is how such an application is usually
        // left, so the window is saved as it was while it is still known.
        this.saveWindowState();
        this.window.hide();
        // At once, not at the next nextFrame(): a caller that hides in the
        // middle of its tick (on focus loss, say) still renders after.
        this.canvas.setOnScreen(false);
        this.windowShown = true;
    }

    fn isVisible(): bool {
        return this.window.isVisible();
    }

    fn isMaximized(): bool {
        return this.window.isMaximized();
    }

    // Does the OS draw this window's titlebar (see AppOptions.nativeTitlebar)?
    // False means the application is responsible for one -- which is exactly
    // the condition a UI shell should render its own titlebar on, rather than
    // hard-coding the same choice a second time.
    fn hasNativeTitlebar(): bool {
        return !this.window.isBorderless();
    }

    // ── Publishing where the titlebar is ─────────────────────────────
    //
    // One frame's worth of boxes: begin, push each in PAINT order (a later
    // box wins where it overlaps an earlier one), commit. Only the committed
    // set is ever visible to the platform's hit test, so a half-built list
    // cannot be read.
    //
    // Coordinates are LOGICAL window pixels -- the same space mousePos() and
    // the UI's own layout use.
    //
    // Deliberately three plain calls over Vec2/bool rather than one taking a
    // list of some region type: app sits below the UI layer and stays
    // ignorant of it, exactly like setCursor() taking a bare int instead of a
    // ui_styling.Cursor. The UI decides what the boxes are; this only carries
    // them across.
    fn beginWindowRegions() {
        this.window.beginRegions();
    }

    fn pushWindowRegion(pos: Vec2, size: Vec2, draggable: bool) {
        this.window.pushRegion(pos, size, draggable);
    }

    fn commitWindowRegions() {
        this.window.commitRegions();
    }

    // ── Remembering the window (AppOptions.rememberWindowState) ──────

    // The window as it would be remembered, none while there is nothing to
    // see: hidden, or minimized (see _windowGeometry).
    fn currentWindowGeometry(): WindowGeometry | none {
        if !this.window.isVisible() || this.window.isMinimized() {
            return none;
        }
        let rect = this.window.getRestoreRect();
        if rect.width <= 0 || rect.height <= 0 {
            return none;
        }
        return WindowGeometry { rect: rect, maximized: this.window.isMaximized() };
    }

    // Once a frame: notes a change, and saves it once the window has stayed
    // that way for windowStateSettleSeconds.
    fn trackWindowState() {
        if !this._windowStatePath {
            return;
        }
        let geometry = this.currentWindowGeometry();
        if !geometry {
            return;
        }
        let changed = true;
        if let known = this._windowGeometry {
            changed = known != geometry;
        }
        if changed {
            this._windowGeometry = geometry;
            this._windowGeometryChangedAt = sdl.getTime();
            this._windowStateUnsaved = true;
            return;
        }
        if this._windowStateUnsaved && sdl.getTime() - this._windowGeometryChangedAt >= windowStateSettleSeconds {
            this.saveWindowState();
        }
    }

    // Saves the window as last seen, now.
    fn saveWindowState() {
        this._windowStateUnsaved = false;
        if let path = this._windowStatePath {
            if let geometry = this._windowGeometry {
                this.writeWindowState(path, geometry);
            }
        }
    }

    // Writes `geometry` to `path`, unless the file already holds it. The
    // displays are read here, not every frame: only what is written needs
    // them.
    fn writeWindowState(path: str, geometry: WindowGeometry) {
        let state = RememberedWindow {
            width: geometry.rect.width,
            height: geometry.rect.height,
            maximized: geometry.maximized,
        };
        if sdl.applicationPlacesWindows() {
            let areas = sdl.displayWorkAreas();
            let index = displayIndexFor(geometry.rect, areas);
            if index >= 0 {
                state.placement = RememberedPlacement { x: geometry.rect.x, y: geometry.rect.y, workArea: areas[index] };
            }
        }
        if let saved = this._savedWindow {
            if saved == state {
                return;
            }
        }
        // Written beside it and renamed over it, so the file is always
        // either the old state or the new one, never half of one.
        let partial = f"{path}.saving";
        let written = fs.writeText(partial, json.stringify(state));
        if !written {
            fmt.println(f"The window state could not be saved to {path}: {written}");
            return;
        }
        let moved = fs.move(partial, path, { overwrite: true });
        if !moved {
            fmt.println(f"The window state could not be saved to {path}: {moved}");
            return;
        }
        this._savedWindow = state;
    }

    // Polls events, handles resize, and returns this App's Frame reset for
    // this tick (the same persistent instance every call, not a fresh
    // allocation -- see Frame's doc comment in renderer.hz).
    // Returns none when the window has been closed — use as a while condition.
    mut fn nextFrame(): mut renderer.gfx.Frame | none {
        if this.window.shouldClose() {
            if !this.hideOnClose {
                this.saveWindowState();
                return none;
            }
            this.window.cancelClose();
            if this.window.shouldClose() {
                this.saveWindowState();
                return none;
            }
            this.hide();
        }
        this._tickStart = sdl.getTime();

        // A pending show. Where the first frame is what maps the window, show
        // it now and let this tick's frame bring it on screen; elsewhere the
        // second time around the caller's loop, when frame 0 is rendered and
        // presented and the window has something to show. See windowShown.
        if !this.windowShown {
            if this.window.appearsWithFirstFrame() || this.framePresented {
                this.window.show();
                this.window.focus();
                this.windowShown = true;
            }
            else {
                this.framePresented = true;
            }
        }

        // Cleared *before* polling so this call's pollEvents() accumulates
        // a fresh delta for this frame, left readable until the next
        // nextFrame() call clears it again.
        this.wheelDeltaThisFrame = Vec2(0.0, 0.0);
        this.wheelModifiersThisFrame = KeyModifiers.None;
        this._pointerEdgeQueue.clear();
        this._keyEdgeQueue.clear();
        this._textInputQueue.clear();

        sdl.pollEvents();
        fs.pollEvents();

        // What this tick may draw into: the window while it is on screen, and
        // -- where a window is drawn before it is shown -- the hidden one about
        // to be. Read off the window every tick rather than tracked, so it
        // holds whoever shows or hides it.
        this.canvas.setOnScreen(this.window.isVisible() || !this.windowShown);

        // Once the application has been quiet for a moment, what a burst of
        // work left in the heap goes back to the system.
        sys.releaseIdleMemory();

        // Focus edges for this frame. Read once, after pollEvents(), so
        // both the level and the two edges describe the same instant --
        // and so a handler that runs later this frame cannot see the flag
        // flip underneath it.
        let nowFocused = this.window.hasFocus();
        let refused = this.window.consumeFocusRefused();
        this.focusGained = nowFocused && !this.focused;
        this.focusLost = !nowFocused && (this.focused || refused);
        this.focused = nowFocused;

        // Where the pointer is, read at the same instant as the keyboard
        // focus so everything this frame agrees. This is the one thing that
        // ever sets pointerInside back to false -- see its comment.
        this.pointerInside = this.window.hasMouseFocus();

        this.resized = false;
        if this.window.consumeSizeChanged() {
            let next = getWindowState(this.window);
            if next.framebufferSize.x > 0 && next.framebufferSize.y > 0 {
                this.surface.configure({
                    device: this.device,
                    format: this.surfaceFormat,
                    usage: wgpu.TextureUsage.RenderAttachment,
                    width: next.framebufferSize.x,
                    height: next.framebufferSize.y,
                    presentMode: this.presentMode,
                    alphaMode: this.caps.alphaModes[0],
                });
                this.canvas.resize(next);
                this.windowState = next;
                this.resized = true;
            }
        }

        this.trackWindowState();

        this.frame.reset();
        return this.frame;
    }

    // Idle out a frame the renderer skipped.
    //
    // A loop that renders every frame is paced by the GPU: the swapchain
    // acquire inside the renderer's commit blocks until the next vblank under
    // FIFO. A frame that changed nothing never commits and never acquires, so
    // that pacing disappears with it and the loop would spin flat out. This
    // puts the process to sleep in the OS instead, and an arriving event wakes
    // it immediately -- so idling costs no CPU without costing any input
    // latency either.
    //
    // The timeout is a CEILING, not a frame target: it only bounds how long
    // work that arrives through something other than an SDL event (a
    // filesystem watcher, a timer a component is waiting on) can sit before
    // the next tick looks at it. Together with the spacing below it adds up
    // to one nominal frame, which keeps that identical to what a 60fps render
    // loop already guaranteed.
    //
    // The spacing is the other half of what the vblank used to do: cap the
    // tick rate. Events wake the wait immediately, so a pointer reporting at
    // 1000 Hz over a part of the UI that does not react to it would otherwise
    // run a thousand ticks a second, each one examining the tree and finding
    // nothing. The first event after a quiet spell is still handled at once
    // (its tick starts the moment the wait returns); only a tick that follows
    // straight on another skipped one is held back, and then by at most this
    // much -- well under the frame of latency a vsynced loop always had.
    fn idle() {
        const minTickSeconds = 0.004;
        let elapsed = sdl.getTime() - this._tickStart;
        if elapsed < minTickSeconds {
            time.sleep(minTickSeconds - elapsed);
        }
        sdl.waitEventTimeout(this.windowShown && !this.window.isVisible() ? 100 as i32 : 12 as i32);
    }

    fn destroy() {
        // For a host that leaves its loop without nextFrame() returning none.
        this.saveWindowState();
        this.window.destroy();
        sdl.terminate();
    }
}

// === System clipboard =========================================
//
// Free functions rather than App methods because the clipboard is a
// process-global desktop resource in SDL, not a property of any one
// window. Exposed here so callers get the OS clipboard without importing
// sdl directly -- the same reason everything else in this module exists.

// "" when the clipboard is empty or holds non-text (an image, say).
export fn getClipboardText(): str {
    return sdl.getClipboardText();
}

export fn setClipboardText(text: str): bool {
    return sdl.setClipboardText(text);
}

// === Mouse cursor =============================================
//
// Also process-global, and also called every frame by the UI layer (see
// ui_components' cursor resolution) -- the underlying SDL wrapper caches
// and early-outs, so a per-frame call costs nothing when the shape is
// unchanged.
//
// `index` is a ui_styling.Cursor cast to int. This module deliberately
// doesn't import ui_styling to name that type: app sits below the UI layer
// and stays ignorant of it, exactly like the sdl module below it.
export fn setCursor(index: int): void {
    sdl.setCursor(index);
}
