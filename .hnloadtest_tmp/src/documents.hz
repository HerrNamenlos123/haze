import perfect_freehand
import tesselate

// We use "ref" for the shapes, but not for anything else. So every shape will be its own
// object, and can be referenced through its reference. The parent only has an array of
// references, which is not that heavy. But all shapes belonging to one document will
// live in one arena per document, so the arena per document can only grow and not shrink
// (shapes are rarely deleted), which makes it very memory-efficient.

struct BBox {
  left: real;
  right: real;
  top: real;
  bottom: real;

  fn overlaps(other: BBox): bool {
    return this.left <= other.right && this.right >= other.left &&
           this.top <= other.bottom && this.bottom >= other.top;
  }

  fn contains(p: Vec2): bool {
    return p.x >= this.left && p.x <= this.right && p.y >= this.top && p.y <= this.bottom;
  }

  fn translated(d: Vec2): BBox {
    return BBox { left: this.left + d.x, right: this.right + d.x, top: this.top + d.y, bottom: this.bottom + d.y };
  }

  // Scaled about `origin` -- what a uniform resize does to it.
  fn scaled(origin: Vec2, ratio: real): BBox {
    return BBox {
      left: origin.x + (this.left - origin.x) * ratio,
      right: origin.x + (this.right - origin.x) * ratio,
      top: origin.y + (this.top - origin.y) * ratio,
      bottom: origin.y + (this.bottom - origin.y) * ratio,
    };
  }
}

fn combineBBox(a: BBox, b: BBox): BBox {
  return BBox {
    left: min(a.left, b.left),
    right: max(a.right, b.right),
    top: min(a.top, b.top),
    bottom: max(a.bottom, b.bottom),
  };
}

struct Point {
    x: real;
    y: real;
    pressure: real;
}

// A stroke's outline polygon, in page mm. The file keeps it as [[x, y], ...];
// in memory it is one flat array. As a little array per point, the outlines
// were most of the objects in a loaded document -- hundreds of thousands in a
// large one -- and the garbage collector walks every one of them on every
// collection, so the pauses grew with the document.
[[json.serialize="toJson", json.parse="fromJson"]]
ref struct Outline {
  points: []Vec2 = [];

  fn toJson(): json.Node {
    let node = json.array();
    for p in this.points {
      let pair = node.newArray();
      pair.appendNumber(p.x);
      pair.appendNumber(p.y);
      node.append(pair);
    }
    return node;
  }

  static fn fromJson(node: json.Node): Result<Outline, json.Error> {
    if !node.isArray() {
      return json.Error { error: () => "outline: expected an array" };
    }
    let points: []Vec2 = [];
    let count = node.arrayLength();
    if count <= 1000000000 {
      points.reserve(count as int);
    }
    let pair = node.firstElement();
    while let current = pair {
      if !current.isArray() {
        return json.Error { error: () => "outline: expected [x, y]" };
      }
      let x = current.firstElement();
      if !x {
        return json.Error { error: () => "outline: expected [x, y]" };
      }
      let y = x.next();
      if !y {
        return json.Error { error: () => "outline: expected [x, y]" };
      }
      if !x.isNumber() || !y.isNumber() {
        return json.Error { error: () => "outline: expected [x, y]" };
      }
      points.push(Vec2(x.numberValue(), y.numberValue()));
      pair = current.next();
    }
    return Outline { points: points };
  }
}

ref struct LineShape {
  variant: "Line";
  points: []Point;
  penColor: str;
  penThickness: real;
  // Cached outline + bbox for this stroke, so reopening the file doesn't have to redo the
  // perfect-freehand computation. Optional for backward compatibility with older files.
  bbox?: BBox;
  cachedOutline?: Outline;

  // Internal, non-serialized data: the stroke tessellated at the tile pyramid
  // levels (see tiles.hz's tilemath namespace) it was last drawn at. One
  // fixed-tolerance tessellation for every level would be either wastefully
  // fine when zoomed out or visibly faceted when zoomed in. Only the
  // maxTesselatedLevels most recent levels are kept, so zooming through the
  // whole range does not leave every stroke holding a mesh per level.
  [[json.ignore]]
  tesselations: []LevelTesselation = [];
  // Left out of the page's tiles while the editor draws it itself -- as it
  // is being moved or resized, or has been erased and not yet removed. See
  // DocumentRenderer.render and EditorControls.
  [[json.ignore]]
  hidden: bool = false;

  // The stroke's outline polygon in page mm: what the eraser hit-tests
  // against, and what the bbox and the tesselations are derived from.
  fn getOutline(): []Vec2 {
    if let cached = this.cachedOutline {
      return cached.points;
    }
    let outline = constructStrokeOutline({ shape: this });
    this.cachedOutline = Outline { points: outline };
    return outline;
  }

  // The outline's bounds. Asking for them does not make the stroke hold its
  // outline: every stroke of a page is asked where it is, to find the few a
  // tile shows, and only those are ever drawn.
  fn getBBox(): BBox {
    if this.bbox {
      return this.bbox;
    }

    let result = BBox { left: 0, right: 0, top: 0, bottom: 0 };
    if let cached = this.cachedOutline {
      result = outlineBBox(cached.points);
    } else {
      result = constructStrokeBBox({ shape: this });
    }
    this.bbox = result;
    return result;
  }

  fn hasTesselation(level: int): bool {
    for t in this.tesselations {
      if t.level == level {
        return true;
      }
    }
    return false;
  }

  // This stroke's tesselation at the given tile pyramid level, computed on
  // first use -- shared by the tile renderer and the live overlay. Tolerance
  // is derived from the level's native px/mm (tilemath.nativeZoomForLevel),
  // so curve flattening targets roughly one native pixel of deviation
  // regardless of how zoomed in/out that level is.
  fn ensureTesselated(level: int): TesselationResult {
    for t in this.tesselations {
      if t.level == level {
        return t.result;
      }
    }
    let nativeZoom = tilemath.nativeZoomForLevel(level);
    let result = tesselateStroke({ shape: this, tolerance: 1.0 / nativeZoom });
    if this.tesselations.length >= maxTesselatedLevels {
      // The level furthest from this one is the least likely to be drawn next.
      let furthest = 0;
      for (let i = 1; i < this.tesselations.length; i++) {
        if levelDistance(this.tesselations[i].level, level) > levelDistance(this.tesselations[furthest].level, level) {
          furthest = i;
        }
      }
      this.tesselations.remove(furthest);
    }
    this.tesselations.push(LevelTesselation { level: level, result: result });
    return result;
  }

  // Drops the tesselations of every level but `level`.
  fn keepOnlyTesselation(level: int) {
    let i = 0;
    while i < this.tesselations.length {
      if this.tesselations[i].level == level {
        i += 1;
      } else {
        this.tesselations.remove(i);
      }
    }
  }

  // Drops the outline and every tesselation, keeping the bbox: what a stroke
  // nobody is looking at needs. Both are computed again on demand.
  fn dropDrawCaches() {
    this.cachedOutline = none;
    this.tesselations.clear();
  }

  fn clearShapeCache() {
    this.bbox = none;
    this.cachedOutline = none;
    this.tesselations.clear();
  }
};

ref struct ImageShape {
  variant: "Image";
  position: Vec2;
  size: Vec2;
  base64ImageData: str;
  bbox?: BBox;
  // See LineShape.hidden.
  [[json.ignore]]
  hidden: bool = false;
  // The decoded GPU texture is cached outside the document model entirely
  // (DocumentRenderer.imageTextures, keyed by base64ImageData) rather than
  // as a field here: this ref struct participates in json.parse/json.stringify
  // for the whole document, and a field whose type reaches into opaque
  // wgpu FFI handles breaks that generic codegen (sizeof on an
  // intentionally-incomplete C struct) even when marked [[json.ignore]].

  fn getBBox(): BBox {
    if this.bbox {
      return this.bbox;
    }
    let result = BBox {
      left: this.position.x,
      right: this.position.x + this.size.x,
      top: this.position.y,
      bottom: this.position.y + this.size.y,
    };
    this.bbox = result;
    return result;
  }

  fn clearShapeCache() {
    this.bbox = none;
  }
};

ref struct TextblockShape {
  variant: "Textblock";
  position: Vec2;
  size: Vec2;
  rawText: str;
  bbox?: BBox;
  // See LineShape.hidden.
  [[json.ignore]]
  hidden: bool = false;
  // Image/Canvas/Texture element reference

  fn getBBox(): BBox {
    if this.bbox {
      return this.bbox;
    }
    let result = BBox {
      left: this.position.x,
      right: this.position.x + this.size.x,
      top: this.position.y,
      bottom: this.position.y + this.size.y,
    };
    this.bbox = result;
    return result;
  }

  fn clearShapeCache() {
    this.bbox = none;
  }
};

[[json.discriminator="variant"]]
type Shape = LineShape | ImageShape | TextblockShape;

// Drops a stroke's stored outline and bbox, for a shape coming in from a file
// or the clipboard: an outline is only ever used as computed here, from the
// points. The web app's stored outlines are exactly what that computes
// anyway; but haze-notes builds before the outline matched the web app's
// stored their own, a little thicker, and those must not be shown, exported
// or saved again.
fn forgetStoredOutline(shape: Shape) {
    if shape is LineShape {
        shape.clearShapeCache();
    }
}

// Identity, not contents: `==` on ref structs compares them member by member,
// and two strokes drawn alike are still two strokes.
fn shapeAddress(shape: Shape): u64 {
    if shape is LineShape { return addressOf(shape); }
    if shape is ImageShape { return addressOf(shape); }
    if shape is TextblockShape { return addressOf(shape); }
    return 0;
}

fn sameShape(a: Shape, b: Shape): bool {
    return shapeAddress(a) == shapeAddress(b);
}

fn setShapeHidden(shape: Shape, hidden: bool) {
    if shape is LineShape { shape.hidden = hidden; }
    else if shape is ImageShape { shape.hidden = hidden; }
    else if shape is TextblockShape { shape.hidden = hidden; }
}

fn isShapeHidden(shape: Shape): bool {
    if shape is LineShape { return shape.hidden; }
    if shape is ImageShape { return shape.hidden; }
    if shape is TextblockShape { return shape.hidden; }
    return false;
}

// Moves a shape by `d` mm. A translation leaves a stroke's outline the same
// shape, so the cached outline and bbox are shifted along instead of
// recomputed -- perfect-freehand is the expensive part of a stroke.
fn translateShape(shape: Shape, d: Vec2) {
    if shape is LineShape {
        let moved: []Point = [];
        for p in shape.points {
            moved.push(Point { x: p.x + d.x, y: p.y + d.y, pressure: p.pressure });
        }
        shape.points = moved;
        if let outline = shape.cachedOutline {
            let moved: []Vec2 = [];
            moved.reserve(outline.points.length);
            for p in outline.points {
                moved.push(Vec2(p.x + d.x, p.y + d.y));
            }
            shape.cachedOutline = Outline { points: moved };
        }
        if let b = shape.bbox {
            shape.bbox = b.translated(d);
        }
        // Tesselations are in page mm too, so they would all be off by d.
        shape.tesselations.clear();
    }
    else if shape is ImageShape {
        shape.position = Vec2(shape.position.x + d.x, shape.position.y + d.y);
        shape.clearShapeCache();
    }
    else if shape is TextblockShape {
        shape.position = Vec2(shape.position.x + d.x, shape.position.y + d.y);
        shape.clearShapeCache();
    }
}

// Scales a shape about `origin` by `ratio`. A stroke keeps its pen thickness
// unless `scaleThickness`, so its outline has to be recomputed -- thin lines
// drawn bigger are still thin lines.
fn scaleShape(shape: Shape, origin: Vec2, ratio: real, scaleThickness: bool) {
    if shape is LineShape {
        let scaled: []Point = [];
        for p in shape.points {
            scaled.push(Point {
                x: origin.x + (p.x - origin.x) * ratio,
                y: origin.y + (p.y - origin.y) * ratio,
                pressure: p.pressure,
            });
        }
        shape.points = scaled;
        if scaleThickness {
            shape.penThickness = shape.penThickness * ratio;
        }
        shape.clearShapeCache();
    }
    else if shape is ImageShape {
        shape.position = Vec2(origin.x + (shape.position.x - origin.x) * ratio, origin.y + (shape.position.y - origin.y) * ratio);
        shape.size = Vec2(shape.size.x * ratio, shape.size.y * ratio);
        shape.clearShapeCache();
    }
    else if shape is TextblockShape {
        shape.position = Vec2(origin.x + (shape.position.x - origin.x) * ratio, origin.y + (shape.position.y - origin.y) * ratio);
        shape.size = Vec2(shape.size.x * ratio, shape.size.y * ratio);
        shape.clearShapeCache();
    }
}

// A copy holding only what the file format stores -- what the clipboard
// carries, so a pasted shape starts with no caches pointing at the original.
fn cloneShape(shape: Shape): Shape {
    if shape is LineShape {
        let points: []Point = [];
        for p in shape.points {
            points.push(p);
        }
        return LineShape { variant: "Line", points: points, penColor: shape.penColor, penThickness: shape.penThickness };
    }
    if shape is ImageShape {
        return ImageShape { variant: "Image", position: shape.position, size: shape.size, base64ImageData: shape.base64ImageData };
    }
    assert(shape is TextblockShape);
    return TextblockShape { variant: "Textblock", position: shape.position, size: shape.size, rawText: shape.rawText };
}

// What Ctrl+C puts on the clipboard, in the same format the web app used,
// so shapes copy between the two.
struct ShapesInClipboard {
    type: str;
    shapes: []Shape;
}

// Pages, the body and the file are references: the editor edits the one
// document everything else is showing, and a page added or a shape removed
// has to be seen by the renderer and by the next save alike.
ref struct Page {
    shapes: []Shape;
}

struct Viewport {
    offsetX: real = 0.0;
    offsetY: real = 0.0;
    zoomPxPerMm: real = 4.0;
}

ref struct DocumentBody {
    pageColor: str;
    gridColor: str;
    gridType: "lines" | "dots";
    pages: []Page;
    pageWidthMm: real;
    pageHeightMm: real;
    currentPageIndex: int;
    viewport?: Viewport;
}

ref struct DocumentFile {
    filetype: str;
    fileversion: int;
    data: DocumentBody;
}

struct StrokeConstructArgs {
  accuracyScaling: real = 10.0;
  shape: LineShape;
}

// The stroke's outline polygon, in the same mm as its points -- exactly the
// one the web app draws: its getPath (store.ts), perfect-freehand 1.2.2 with
// the same options, points and pressures, so a stroke looks the same in both
// and the outline the web app stored in a file is the one computed here.
// That means simulated pressure (the library's default) and not `last`, as
// the web app called it; the pen's own pressure only seeds the first point.
//
// perfect_freehand runs on points scaled up by accuracyScaling, and its
// outline comes back in that scaled space -- scaled down again here, so no
// caller has to know about it. getBBox once used it unscaled, which put every
// bbox 10x further out than the stroke: the tile cull then dropped nearly
// every stroke from its own tile.
fn constructStrokeOutline(args: StrokeConstructArgs): []Vec2 {
    if let outline = strokeContext(args).computeScaledDown(args.accuracyScaling) {
        return outline;
    }
    return [];
}

// The bounds of that outline, without building it -- perfect_freehand finds
// them in its own buffers, so this allocates nothing.
fn constructStrokeBBox(args: StrokeConstructArgs): BBox {
    if let bounds = strokeContext(args).computeBounds() {
        return BBox {
            left: bounds.min.x / args.accuracyScaling,
            right: bounds.max.x / args.accuracyScaling,
            top: bounds.min.y / args.accuracyScaling,
            bottom: bounds.max.y / args.accuracyScaling,
        };
    }
    return BBox { left: 0, right: 0, top: 0, bottom: 0 };
}

// The bounds of an outline that is already there.
fn outlineBBox(outline: []Vec2): BBox {
    if outline.length == 0 {
        return BBox { left: 0, right: 0, top: 0, bottom: 0 };
    }
    let minX = outline[0].x;
    let maxX = outline[0].x;
    let minY = outline[0].y;
    let maxY = outline[0].y;
    for p in outline {
        minX = min(minX, p.x);
        maxX = max(maxX, p.x);
        minY = min(minY, p.y);
        maxY = max(maxY, p.y);
    }
    return BBox { left: minX, right: maxX, top: minY, bottom: maxY };
}

// The one perfect_freehand context every stroke is computed in. It keeps its
// buffers from stroke to stroke, so computing a document's thousands of
// strokes allocates only what the longest of them needs -- one context made
// and destroyed per stroke allocated all of it again each time. Strokes are
// only ever computed on the main thread, so one is enough.
let strokeOutliner: perfect_freehand.PerfectFreehand | none = none;

// That context, holding `args.shape`'s points and ready to compute.
fn strokeContext(args: StrokeConstructArgs): perfect_freehand.PerfectFreehand {
    if !strokeOutliner {
        strokeOutliner = perfect_freehand.PerfectFreehand({
            // Set per stroke, below.
            size: 1.0,
            thinning: 0.1,
            smoothing: 0.0,
            streamline: 0.6,
            simulatePressure: true,
            last: false,
        });
    }
    assert(strokeOutliner);
    let pf = strokeOutliner;
    pf.clearPoints();
    pf.setSize(args.shape.penThickness * args.accuracyScaling);
    for point in args.shape.points {
        pf.addPointWithPressure(Vec2(point.x * args.accuracyScaling, point.y * args.accuracyScaling), point.pressure);
    }
    return pf;
}

struct TesselationResult {
	vertices: []Vec2 = [];
	indices: []i32 = [];
}

struct LevelTesselation {
  level: int;
  result: TesselationResult;
}

// How many zoom levels' tesselations a stroke keeps -- the level being zoomed
// from and the one being zoomed to.
const comptime maxTesselatedLevels = 2;

fn levelDistance(a: int, b: int): int {
  return a > b ? a - b : b - a;
}

struct StrokeTesselateArgs {
  shape: LineShape;
  // Curve-flattening tolerance, in the same mm units the curve itself is
  // drawn in (post accuracyScaling division). 0.25 (the old default) was
  // never actually exercised before quadraticBezierTo existed -- straight
  // lineTo ignores tolerance entirely, so nobody had reason to tune it.
  // It's wildly coarse for these curves (individual outline-to-outline
  // segments routinely span well under 1mm): the flattener was treating
  // every curve as "already flat enough" and emitting it as a single
  // straight chord, which is why the smoothing looked like no change at
  // all. 0.02mm actually subdivides.
  tolerance: real = 0.0001;
}

fn tesselateStroke(args: StrokeTesselateArgs): TesselationResult {
    // The outline is the stroke's own cached one (stored in the file, too), so
    // tessellating at another level never reruns perfect-freehand.
    let outline = args.shape.getOutline();
    if outline.length == 0 {
        return {};
    }

    // Standard perfect-freehand smoothing recipe (same one the original
    // HTML canvas version used, typically via an SVG "Q" path): connecting
    // the raw outline points with straight lineTo()s makes every direction
    // change in the outline a visible corner, especially bad on tight
    // curves. Instead, draw a quadratic curve through the *midpoint* of
    // each consecutive pair of outline points, using the outline point
    // itself as that segment's control point -- this is what makes
    // adjacent segments meet smoothly (C1-continuous) instead of at a
    // hard corner. The tesselator's quadraticBezierTo already flattens the
    // curve internally (at `tolerance`), no manual subdivision needed.
    let n = outline.length;
    let first = outline[0];
    let tess = tesselate.Tesselator();
    tess.beginPath();
    tess.moveTo(first);
    for (let p = 0; p < n; p++) {
        let cur = outline[p];
        let next = outline[(p + 1) % n];
        let to = Vec2((cur.x + next.x) / 2.0, (cur.y + next.y) / 2.0);
        tess.quadraticBezierTo(cur, to);
    }
    tess.closePath();
    if let t = tess.tessellate(args.tolerance) { 
      tess.destroy();
      return {
        vertices: t.vertices,
        indices: t.indices,
      };
    }
    tess.destroy();
    return {};
}
