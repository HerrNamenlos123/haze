// Recursive-descent parser for Haze.
//
// Structure mirrors HazeParser.g4 one function per rule, so the grammar stays
// the readable specification and this file stays a direct transcription of it.
// To extend the language: add the token in tokens.hz, lex it in lexer.hz, and
// add/extend the matching parse function here.
//
// There is no intermediate AST. Each parse function writes its own node into
// the one output String (see json.hz) as it recognises the input, and every
// node is written where it finally sits, so no part of the output is ever
// copied out and spliced back. Three techniques make that work:
//
//   * A node whose kind is only known after its first child has been written
//     (left recursion: `a + b`, `a.b`, `a(...)`, `a ? b : c`, `x = y`,
//     `A | B`, `Foo { }`) gets its header written behind the child and
//     hoisted in front of it: wrapNode().
//   * A field that is parsed after fields which precede it in the AST (a
//     function's `requires`, a struct's generics, a static array's size) is
//     written where it is parsed and hoisted into place the same way.
//   * What has to wait is remembered as a token position or an output offset,
//     never as text: generic parameter names are token indices on `stack`,
//     and an annotation is parsed where it stands and walked again, quietly,
//     where the AST puts it.
//
// A value never writes separators: the object or array it goes into does.

export struct ParseError {
    message: str = "";
    line: int = 0;
    col: int = 0;
}

export struct SourceOverrideState {
    active: bool;
    file: str;
    startLine: int;
    startCol: int;
    endLine: int;
    endCol: int;
    hasEnd: bool;
    offsetMode: bool;
    anchorLine: int;
}

ref struct Parser {
    src: str = "";
    filename: str = "";
    toks: mut []Token = [];
    pos: int = 0;

    w: JsonWriter;
    errors: mut []ParseError = [];

    // Integers that outlive one call: the token indices of generic parameter
    // names and the pending operators of a binary chain. A stack, so nested
    // constructs share it: push above the top, use, pop back down (popTo).
    stack: mut []int = [];

    // While set, errors are not recorded. Annotations are walked a second time
    // where the AST puts them; their errors were reported the first time.
    quiet: bool = false;

    // Elements written so far into the declaration list being filled (the
    // file's, or a namespace's). A `#source` block's declarations join the
    // enclosing list, so one call may write any number of them.
    listCount: int = 0;

    // Set by a `#source "file:line:col[-endcol][.endline]"` block. While
    // active, EVERY node inside reports this location instead of its real one,
    // which is how generated import files point back at their original source.
    sourcelocOverride: bool = false;
    overrideFile: str = "";
    overrideStartLine: int = 0;
    overrideStartCol: int = 0;
    overrideEndLine: int = 0;
    overrideEndCol: int = 0;
    overrideHasEnd: bool = false;
    // Offset (line-map) mode: spec was "file:line" with no column. Contents
    // are mapped line-by-line -- the first line after the directive line
    // corresponds to overrideStartLine, columns pass through unchanged.
    overrideOffsetMode: bool = false;
    overrideAnchorLine: int = 0;

    // `Foo { ... }` is ambiguous with `if cond { ... }`, so the statement
    // parser clears this while parsing a control-flow condition.
    allowBraceLiteral: bool = true;

    // Set while parsing the init clause of a C-style `for`, where the trailing
    // `;` belongs to the for rule rather than to the statement.
    noSemiInStatement: bool = false;

    // Did the `attempt { } ... ;` statement just parsed end with a semicolon?
    // attemptExprImpl() consumes it (the `;` is part of the AttemptExpr's own
    // span there, unlike `do`), so it has to report back out of band.
    attemptTookSemi: bool = false;

    static fn create(src: str, filename: str, toks: mut []Token): mut Parser {
        // The JSON is 3 to 12 times the size of the source, 8 on average over
        // the repository, so 10x leaves almost every file with one allocation
        // and the rest with one regrowth.
        let out = String();
        out.reserve(src.length * 10 + 4096);
        let p = Parser {
            src: src,
            filename: filename,
            toks: toks,
            w: JsonWriter { buf: out },
        };
        p.stack.reserve(64);
        return p;
    }

    // --- Token cursor ------------------------------------------------------

    fn cur(): Token { return this.toks[this.pos]; }

    fn kind(): TK { return this.toks[this.pos].kind; }

    fn peekKind(offset: int): TK {
        let p = this.pos + offset;
        if p >= this.toks.length { return TK.EOF; }
        return this.toks[p].kind;
    }

    fn at(k: TK): bool { return this.toks[this.pos].kind == k; }

    fn atEnd(): bool { return this.toks[this.pos].kind == TK.EOF; }

    mut fn advance(): Token {
        let t = this.toks[this.pos];
        if this.pos < this.toks.length - 1 { this.pos++; }
        return t;
    }

    mut fn accept(k: TK): bool {
        if this.toks[this.pos].kind == k {
            this.advance();
            return true;
        }
        return false;
    }

    mut fn expect(k: TK): Token {
        if this.toks[this.pos].kind == k {
            return this.advance();
        }
        let t = this.toks[this.pos];
        if !this.quiet {
            let want = tokenName(k);
            let got = tokenName(t.kind);
            this.errorAt(t, f"expected {want} but found {got}");
        }
        return t;
    }

    mut fn errorAt(t: Token, message: str) {
        if this.quiet { return; }
        this.errors.push(ParseError { message: message, line: t.line, col: t.col });
    }

    // Text of a token, zero-copy.
    fn text(t: Token): str { return this.src.slice(t.start, t.end); }

    // The token most recently consumed — the `end` anchor for a node span.
    fn lastToken(): Token {
        if this.pos == 0 { return this.toks[0]; }
        return this.toks[this.pos - 1];
    }

    mut fn popTo(height: int) {
        while this.stack.length > height { this.stack.pop(); }
    }

    // --- Output helpers ----------------------------------------------------

    // Completes a node whose first child is already written at `at`: the
    // header goes in front, and the child becomes the value of `key`.
    mut fn wrapNode(at: int, variant: str, key: str) {
        let moved = this.w.length();
        this.w.node(variant);
        this.w.key(key);
        this.w.hoist(at, moved);
    }

    // The next element of the declaration list being filled.
    mut fn declElement() {
        if this.listCount > 0 { this.w.comma(); }
        this.listCount++;
    }

    // --- sourceloc ---------------------------------------------------------
    //
    // `end` is the START position of the node's last token, matching the
    // reference parser (ANTLR's stop-token position). A single-token node
    // therefore has start == end.

    // A node's source location in the COMPACT wire form.
    //
    // The AST shape the compiler consumes is
    //   {filename, start:{line,column}, end:{line,column}}
    // which costs ~130 bytes per node. It is 58% of the payload, and the
    // filename alone repeated over 10,000 times in a generated import file.
    //
    // On the wire it becomes  "L":[startLine,startCol,endLine,endCol]  with the
    // filename omitted whenever it is the file being parsed (the overwhelmingly
    // common case); a `#source` override emits "F" alongside. The TS bridge
    // expands this back during the revive walk it already performs.
    mut fn writeLoc(startTok: Token, endTok: Token) {
        this.w.key("L");
        this.w.array();
        if this.sourcelocOverride && this.overrideOffsetMode {
            let delta = this.overrideStartLine - (this.overrideAnchorLine + 1);
            this.w.intValue(startTok.line + delta);
            this.w.comma();
            this.w.intValue(startTok.col);
            this.w.comma();
            this.w.intValue(endTok.line + delta);
            this.w.comma();
            this.w.intValue(endTok.col);
            this.w.endArray();
            this.w.keyString("F", this.overrideFile);
            return;
        }
        if this.sourcelocOverride {
            this.w.intValue(this.overrideStartLine);
            this.w.comma();
            this.w.intValue(this.overrideStartCol);
            if this.overrideHasEnd {
                this.w.comma();
                this.w.intValue(this.overrideEndLine);
                this.w.comma();
                this.w.intValue(this.overrideEndCol);
            }
            this.w.endArray();
            // A #source block points at a different file, so it must be named.
            this.w.keyString("F", this.overrideFile);
            return;
        }
        this.w.intValue(startTok.line);
        this.w.comma();
        this.w.intValue(startTok.col);
        this.w.comma();
        this.w.intValue(endTok.line);
        this.w.comma();
        this.w.intValue(endTok.col);
        this.w.endArray();
    }

    // Span from `startTok` through the last consumed token.
    mut fn locHere(startTok: Token) {
        this.writeLoc(startTok, this.lastToken());
    }

    // -----------------------------------------------------------------------
    // Expressions.
    //
    // Precedence, loosest to tightest, straight from the grammar:
    //   assignment -> ternary -> nullish -> logical -> equality -> comparison
    //   -> additive -> multiplicative -> prefix -> postfix -> primary
    //
    // Every level writes its operand in place first. Only when an operator of
    // its own follows does it turn that operand into the first child of a new
    // node (wrapNode), so the common case, a level with no operator, costs a
    // single token check.
    // -----------------------------------------------------------------------

    mut fn expr(): void :: final {
        this.assignment();
    }

    // assignment: ternary (assignOp assignment)?
    mut fn assignment(): void :: final {
        let start = this.cur();
        let at = this.w.length();
        this.ternary();

        let op = this.assignOpOf(this.kind());
        if op < 0 { return; }
        this.advance();

        this.wrapNode(at, "ExprAssignmentExpr", "target");
        this.w.key("value");
        this.assignment();
        this.w.keyInt("operation", op);
        this.locHere(start);
        this.w.end();
    }

    // EAssignmentOperation in shared/AST.ts
    fn assignOpOf(k: TK): int {
        if k == TK.Equals { return 0; }       // Rebind
        if k == TK.ColonEquals { return 1; }  // Assign
        if k == TK.PlusEq { return 2; }
        if k == TK.MinusEq { return 3; }
        if k == TK.MulEq { return 4; }
        if k == TK.DivEq { return 5; }
        if k == TK.ModEq { return 6; }
        return -1;
    }

    // ternary: nullish (QUESTIONMARK expr COLON ternary)? | ATTEMPT ...
    mut fn ternary(): void :: final {
        if this.at(TK.Attempt) {
            this.attemptExpr();
            return;
        }

        let start = this.cur();
        let at = this.w.length();
        this.nullish();

        if !this.at(TK.Question) { return; }
        this.advance();

        this.wrapNode(at, "TernaryExpr", "condition");
        this.w.key("thenExpr");
        this.expr();
        this.expect(TK.Colon);
        this.w.key("else");
        this.ternary();
        this.locHere(start);
        this.w.end();
    }

    // The left-associative binary levels, loosest first. Each is one flat
    // grammar rule, `additive: multiplicative ((PLUS|MINUS) multiplicative)*`:
    //   0 nullish ??           1 logical && || |       2 equality == !=
    //   3 comparison < <= > >= 4 additive + -          5 multiplicative * / %
    // The result is the EBinaryOperation, or -1 when `k` is not this level's.
    fn binaryOp(level: int, k: TK): int {
        if level == 0 {
            if k == TK.DoubleQuestion { return 14; }  // NullishCoalesce
            return -1;
        }
        if level == 1 {
            if k == TK.DoubleAnd { return 11; }  // BoolAnd
            if k == TK.DoubleOr { return 12; }   // BoolOr
            if k == TK.Or { return 13; }         // BitwiseOr
            return -1;
        }
        if level == 2 {
            if k == TK.DoubleEquals { return 9; }  // Equal
            if k == TK.NotEquals { return 10; }    // NotEqual
            return -1;
        }
        if level == 3 {
            if k == TK.LAngle { return 5; }  // LessThan
            if k == TK.Leq { return 6; }     // LessEqual
            if k == TK.RAngle { return 7; }  // GreaterThan
            if k == TK.Geq { return 8; }     // GreaterEqual
            return -1;
        }
        if level == 4 {
            if k == TK.Plus { return 3; }   // Add
            if k == TK.Minus { return 4; }  // Subtract
            return -1;
        }
        if k == TK.Mul { return 0; }  // Multiply
        if k == TK.Div { return 1; }  // Divide
        if k == TK.Mod { return 2; }  // Modulo
        return -1;
    }

    // nullish: logical (?? logical)*
    mut fn nullish(): void :: final {
        this.binaryLevel(0);
    }

    // The operand of a binary level: the next tighter level.
    mut fn binaryOperand(level: int): void :: final {
        if level == 5 {
            this.prefixExpr();
            return;
        }
        this.binaryLevel(level + 1);
    }

    mut fn binaryLevel(level: int): void :: final {
        let start = this.cur();
        let at = this.w.length();
        this.binaryOperand(level);

        let op = this.binaryOp(level, this.kind());
        if op < 0 { return; }

        // `a + b + c` nests as ((a+b)+c), and the reference parser stamps
        // every node it builds from one rule with the rule's own span: the
        // inner `a + b` reports the span of the whole chain. So the chain is
        // written operand by operand, `a ,"b":b ,"b":c`, and the end of each
        // operand is remembered with its operator. Once the chain's last
        // token is known, each node's tail (operation, span, `}`) goes in
        // after its right operand, last first so the earlier offsets stay
        // valid, and all the headers in front of `a`.
        let base = this.stack.length;
        while op >= 0 {
            this.advance();
            this.w.key("b");
            this.binaryOperand(level);
            this.stack.push(op);
            this.stack.push(this.w.length());
            op = this.binaryOp(level, this.kind());
        }
        let endTok = this.lastToken();

        let count = (this.stack.length - base) / 2;
        for (let i = count - 1; i >= 0; i--) {
            let moved = this.w.length();
            this.w.keyInt("operation", this.stack[base + 2 * i]);
            this.writeLoc(start, endTok);
            this.w.end();
            this.w.hoist(this.stack[base + 2 * i + 1], moved);
        }
        let moved = this.w.length();
        for (let i = 0; i < count; i++) {
            this.w.node("BinaryExpr");
            this.w.key("a");
        }
        this.w.hoist(at, moved);
        this.popTo(base);
    }

    // prefixExpr: preUnaryOp prefixExpr | postfixExpr
    mut fn prefixExpr(): void :: final {
        let start = this.cur();
        let k = this.kind();

        // ++x / --x produce PreIncrExpr; + - ! produce UnaryExpr.
        if k == TK.PlusPlus || k == TK.MinusMinus {
            this.advance();
            this.w.node("PreIncrExpr");
            this.w.key("expr");
            this.prefixExpr();
            let op = 0;
            if k == TK.MinusMinus { op = 1; }
            this.w.keyInt("operation", op);
            this.locHere(start);
            this.w.end();
            return;
        }

        if k == TK.Plus || k == TK.Minus || k == TK.Not {
            this.advance();
            this.w.node("UnaryExpr");
            this.w.key("expr");
            this.prefixExpr();
            let op = 0;                          // Plus
            if k == TK.Minus { op = 1; }         // Minus
            else if k == TK.Not { op = 2; }      // Negate
            this.w.keyInt("operation", op);
            this.locHere(start);
            this.w.end();
            return;
        }

        this.postfixExpr();
    }

    // argExpr: spreadExpr | expr
    // `...pack` inside a call argument list (parameter pack expansion).
    mut fn argExpr(): void :: final {
        if this.at(TK.Ellipsis) {
            let start = this.cur();
            this.advance();
            this.w.node("SpreadExpr");
            this.w.key("expr");
            this.expr();
            this.locHere(start);
            this.w.end();
            return;
        }
        this.expr();
    }

    // -----------------------------------------------------------------------
    // Postfix chain: calls, indexing, member access, casts, type tests.
    // Each postfix wraps the expression built so far.
    // -----------------------------------------------------------------------

    mut fn postfixExpr(): void :: final {
        let at = this.w.length();
        this.primaryExpr();

        while true {
            // Each postfix node is stamped with the span of the postfix rule
            // itself, which begins at the operator token (`(`, `[`, `.`, `as`,
            // ...), not at the start of the chain. So `a.b.c()` gives the call
            // node the span of `(...)` and the member node the span of `.c`.
            let start = this.cur();
            let k = this.kind();

            if k == TK.PlusPlus || k == TK.MinusMinus {
                this.advance();
                let op = 0;
                if k == TK.MinusMinus { op = 1; }
                this.wrapNode(at, "PostIncrExpr", "expr");
                this.w.keyInt("operation", op);
                this.locHere(start);
                this.w.end();
                continue;
            }

            // Call: `f(args)` with an optional `with allocator`.
            if k == TK.LParen {
                this.advance();
                this.wrapNode(at, "ExprCallExpr", "calledExpr");
                this.w.key("arguments");
                this.w.array();
                // Inside the parentheses a `{` cannot be a block body, so brace
                // literals are allowed again even within an `if`/`while`
                // condition: `if f(T {})`.
                let savedAllow = this.allowBraceLiteral;
                this.allowBraceLiteral = true;
                if !this.at(TK.RParen) {
                    this.argExpr();
                    while this.accept(TK.Comma) {
                        if this.at(TK.RParen) { break; }  // trailing comma
                        this.w.comma();
                        this.argExpr();
                    }
                }
                this.allowBraceLiteral = savedAllow;
                this.w.endArray();
                this.expect(TK.RParen);
                this.w.key("allocator");
                this.withAllocator();
                this.locHere(start);
                this.w.end();
                continue;
            }

            // Subscript: `a[i]`, `a[i, j]`, slices `a[s:e]`.
            if k == TK.LBracket {
                this.advance();
                this.wrapNode(at, "ArraySubscriptExpr", "expr");
                this.w.key("indices");
                this.w.array();
                this.subscriptIndex();
                while this.accept(TK.Comma) {
                    if this.at(TK.RBracket) { break; }
                    this.w.comma();
                    this.subscriptIndex();
                }
                this.w.endArray();
                this.expect(TK.RBracket);
                this.locHere(start);
                this.w.end();
                continue;
            }

            // Comptime member access: `a.[expr]`
            if k == TK.Dot && this.peekKind(1) == TK.LBracket {
                this.advance();
                this.advance();
                this.wrapNode(at, "ExprComptimeMemberAccess", "expr");
                this.w.key("memberExpr");
                this.expr();
                this.expect(TK.RBracket);
                this.locHere(start);
                this.w.end();
                continue;
            }

            // Member access: `a.b<T>` / optional chaining `a?.b`
            if k == TK.Dot || k == TK.QuestionDot {
                // The grammar rule here is `(DOT | QUESTIONDOT) nameSegment`,
                // which INCLUDES the dot, so the span starts at the dot (unlike
                // `nameExpr`, whose rule is a bare `nameSegment` and therefore
                // starts at the name). `start` is already the dot token.
                this.advance();
                let nameTok = this.memberName();
                let variant = "ExprMemberAccess";
                if k == TK.QuestionDot { variant = "OptionalChainingExprMemberAccess"; }
                this.wrapNode(at, variant, "expr");
                this.w.keyString("member", this.text(nameTok));
                this.genericArgs();
                this.locHere(start);
                this.w.end();
                continue;
            }

            // Error propagation `expr?!`
            if k == TK.QuestionExcl {
                this.advance();
                this.wrapNode(at, "ErrorPropagationExpr", "expr");
                this.locHere(start);
                this.w.end();
                continue;
            }

            // `expr as T`
            if k == TK.As {
                this.advance();
                this.wrapNode(at, "ExplicitCastExpr", "expr");
                this.w.key("castedTo");
                this.typeExpr();
                this.locHere(start);
                this.w.end();
                continue;
            }

            // `expr is T` / `expr is not T`
            if k == TK.Is || k == TK.IsNot {
                this.advance();
                this.wrapNode(at, "ExprIsTypeExpr", "expr");
                this.w.key("comparisonType");
                this.typeExpr();
                this.w.keyBool("inverted", k == TK.IsNot);
                this.locHere(start);
                this.w.end();
                continue;
            }

            break;
        }
    }

    // subscriptExpr: expr | start=expr? COLON end=expr?
    mut fn subscriptIndex(): void :: final {
        // Leading `:` -> slice with no start.
        if this.at(TK.Colon) {
            this.advance();
            this.w.object();
            this.w.firstKey("type");
            this.w.stringValue("slice");
            this.w.keyNull("start");
            this.w.key("end");
            this.sliceEnd();
            this.w.end();
            return;
        }

        let at = this.w.length();
        this.expr();
        let moved = this.w.length();
        this.w.object();
        this.w.firstKey("type");
        if this.at(TK.Colon) {
            this.advance();
            this.w.stringValue("slice");
            this.w.key("start");
            this.w.hoist(at, moved);
            this.w.key("end");
            this.sliceEnd();
            this.w.end();
            return;
        }
        this.w.stringValue("index");
        this.w.key("value");
        this.w.hoist(at, moved);
        this.w.end();
    }

    // The end of a slice, or null when it is left open (`a[s:]`).
    mut fn sliceEnd(): void :: final {
        if this.at(TK.RBracket) || this.at(TK.Comma) {
            this.w.nullValue();
            return;
        }
        this.expr();
    }

    // withAllocator: WITH expr, or null when absent.
    mut fn withAllocator(): void :: final {
        if !this.at(TK.With) {
            this.w.nullValue();
            return;
        }
        this.advance();
        this.expr();
    }

    // A member name may be an identifier or the `type` keyword (memberNameId).
    mut fn memberName(): Token {
        if this.at(TK.Type) { return this.advance(); }
        return this.expect(TK.Ident);
    }

    // genericArgs: LANGLE genericLiteral (COMMA genericLiteral)* RANGLE
    //
    // Written as `,"generics":[...]`, and omitted entirely when there are none
    // (`"generics":[]` appeared 4,384 times in one file); the bridge defaults
    // a missing key to []. Only consumes `<` when the contents parse as a
    // generic argument list, so `a < b` stays a comparison.
    mut fn genericArgs(): void :: final {
        if !this.at(TK.LAngle) { return; }
        if !this.looksLikeGenericArgs() { return; }

        this.advance();
        this.w.key("generics");
        this.w.array();
        this.typeExpr();
        while this.accept(TK.Comma) {
            this.w.comma();
            this.typeExpr();
        }
        this.w.endArray();
        this.expect(TK.RAngle);
    }

    // Decide whether a `<` opens a generic argument list or is a less-than.
    // Scans ahead for a matching `>` without crossing tokens that cannot appear
    // in a type argument list.
    fn looksLikeGenericArgs(): bool {
        let angle = 0;
        let paren = 0;
        let bracket = 0;
        let i = this.pos;
        let limit = this.toks.length;

        while i < limit {
            let k = this.toks[i].kind;

            // Generic arguments are types, and a type may contain balanced
            // parentheses and brackets: `Result<[]DirEntry, Error>` and
            // `Foo<typeof(x.[y])>` are both valid. Only an UNBALANCED closer
            // means the `<` was a comparison.
            if k == TK.LParen { paren++; }
            else if k == TK.LBracket { bracket++; }
            else if k == TK.RParen {
                if paren == 0 { return false; }
                paren--;
            }
            else if k == TK.RBracket {
                if bracket == 0 { return false; }
                bracket--;
            }
            else if k == TK.LAngle { angle++; }
            else if k == TK.RAngle {
                angle--;
                if angle == 0 { return paren == 0 && bracket == 0; }
            }
            else if k == TK.Semi || k == TK.LCurly || k == TK.RCurly || k == TK.EOF
                 || k == TK.DoubleEquals || k == TK.NotEquals
                 || k == TK.DoubleAnd || k == TK.DoubleOr
                 || k == TK.Leq || k == TK.Geq
                 || k == TK.Plus || k == TK.Minus || k == TK.Div || k == TK.Mod {
                // These cannot appear in a type argument list (at depth 0).
                if paren == 0 && bracket == 0 { return false; }
            }
            i++;
        }
        return false;
    }

    // -----------------------------------------------------------------------
    // Primary expressions.
    // -----------------------------------------------------------------------

    mut fn primaryExpr(): void :: final {
        let k = this.kind();
        let start = this.cur();

        // A lambda must be tried before a parenthesised expression: `(x)` is a
        // prefix of both, and only the arrow after `)` disambiguates them.
        if k == TK.LParen {
            if this.looksLikeLambda() {
                this.lambdaExpr();
                return;
            }
            this.advance();
            this.w.node("ParenthesisExpr");
            this.w.key("expr");
            let savedParen = this.allowBraceLiteral;
            this.allowBraceLiteral = true;
            this.expr();
            this.allowBraceLiteral = savedParen;
            this.expect(TK.RParen);
            this.locHere(start);
            this.w.end();
            return;
        }

        if k == TK.Do {
            this.doScopeExpr();
            return;
        }

        if k == TK.Attempt {
            this.attemptExpr();
            return;
        }

        // `type <typeExpr>` switches into type syntax.
        if k == TK.Type {
            this.advance();
            this.w.node("TypeValueExpr");
            this.w.key("datatype");
            this.typeExpr();
            this.locHere(start);
            this.w.end();
            return;
        }

        if k == TK.Typeof {
            this.advance();
            this.expect(TK.LParen);
            this.w.node("TypeOfExpr");
            this.w.key("expr");
            this.expr();
            this.expect(TK.RParen);
            this.locHere(start);
            this.w.end();
            return;
        }

        // Array literal.
        if k == TK.LBracket {
            this.arrayExpr();
            return;
        }

        // Anonymous struct literal `{ ... }`.
        if k == TK.LCurly {
            this.w.node("AggregateLiteralExpr");
            this.w.keyNull("datatype");
            this.braceBody(start);
            return;
        }

        if this.isLiteralStart(k) {
            this.literalExpr();
            return;
        }

        if k == TK.FStringStart || k == TK.FTripleStringStart {
            this.interpolatedString();
            return;
        }

        // `ref Foo { ... }`: a struct literal whose type is `ref Foo` (allocates).
        if k == TK.Ref {
            this.advance();
            this.w.node("AggregateLiteralExpr");
            this.w.key("datatype");
            this.w.node("RefTypeExpr");
            this.w.key("type");
            this.nameExpr();
            this.locHere(start);
            this.w.end();
            this.braceBody(start);
            return;
        }

        // Name, possibly followed by a brace literal (`Foo { ... }`).
        if k == TK.Ident || k == TK.Type {
            let at = this.w.length();
            this.nameExpr();
            if this.at(TK.LCurly) && this.allowBraceLiteral {
                // The literal spans from the type name, not from `{`.
                this.wrapNode(at, "AggregateLiteralExpr", "datatype");
                this.braceBody(start);
            }
            return;
        }

        this.errorAt(start, f"unexpected token in expression: {tokenName(k)}");
        this.advance();
        this.w.nullValue();
    }

    fn isLiteralStart(k: TK): bool {
        return k == TK.True || k == TK.False || k == TK.IntLit || k == TK.HexIntLit
            || k == TK.FloatLit || k == TK.UnitIntLit || k == TK.UnitFloatLit
            || k == TK.StringLit || k == TK.TripleStringLit || k == TK.RegexLit;
    }

    // Does a `(` start a lambda? Scan to the matching `)` and look for `=>`/`->`,
    // or a return-type annotation / requiresJson block introducing one.
    fn looksLikeLambda(): bool {
        let depth = 0;
        let i = this.pos;
        let limit = this.toks.length;

        while i < limit {
            let k = this.toks[i].kind;
            if k == TK.LParen { depth++; }
            else if k == TK.RParen {
                depth--;
                if depth == 0 {
                    let after = this.toks[i + 1].kind;
                    if after == TK.DoubleArrow || after == TK.SingleArrow { return true; }
                    // `(a): T => ...` and `(a) :: final => ...`
                    //
                    // The return type's generic arguments are skipped whole:
                    // `(): LinearMap<str, bool> => ...` has a comma, and
                    // `Foo<typeof(x)>` a `)`, that belong to the type, not to
                    // an enclosing call. Outside them the stops are unchanged
                    // -- a `,` or `)` there still means `(a)` was an
                    // expression (a call argument, a ternary branch).
                    if after == TK.Colon || after == TK.DoubleColon {
                        let angle = 0;
                        let paren = 0;
                        let j = i + 2;
                        while j < limit {
                            let kk = this.toks[j].kind;
                            if angle > 0 {
                                if kk == TK.LAngle { angle++; }
                                else if kk == TK.RAngle { angle--; }
                                else if kk == TK.LParen { paren++; }
                                else if kk == TK.RParen {
                                    if paren == 0 { return false; }
                                    paren--;
                                }
                                else if kk == TK.Semi || kk == TK.LCurly || kk == TK.RCurly
                                        || kk == TK.EOF { return false; }
                            } else {
                                if kk == TK.DoubleArrow || kk == TK.SingleArrow { return true; }
                                if kk == TK.LAngle { angle++; }
                                else if kk == TK.Semi || kk == TK.LCurly || kk == TK.RParen
                                        || kk == TK.Comma || kk == TK.EOF { return false; }
                            }
                            j++;
                        }
                    }
                    return false;
                }
            }
            else if k == TK.EOF { return false; }
            i++;
        }
        return false;
    }

    // literal -> ASTLiteralExpr wrapping a LiteralValue.
    mut fn literalExpr(): void :: final {
        let t = this.advance();
        this.w.node("LiteralExpr");
        this.w.key("literal");
        this.literalValue(t);
        this.locHere(t);
        this.w.end();
    }

    // The LiteralValue of a literal token.
    // EPrimitive: str=1 int=5 real=15 bool=18 Regex=22
    mut fn literalValue(t: Token): void :: final {
        let k = t.kind;
        let raw = this.text(t);

        this.w.object();
        if k == TK.True || k == TK.False {
            this.w.firstKey("type");
            this.w.intValue(18);
            this.w.keyBool("value", k == TK.True);
        }
        else if k == TK.IntLit {
            this.w.firstKey("type");
            this.w.intValue(5);
            // Integer values are emitted as strings and revived to BigInt.
            this.w.key("value");
            this.w.decimalString(raw);
            this.w.keyNull("unit");
        }
        else if k == TK.HexIntLit {
            this.w.firstKey("type");
            this.w.intValue(5);
            this.w.key("value");
            this.w.hexAsDecimalString(raw.slice(2));
            this.w.keyNull("unit");
        }
        else if k == TK.UnitIntLit {
            let split = splitUnit(raw);
            this.w.firstKey("type");
            this.w.intValue(5);
            this.w.key("value");
            this.w.decimalString(raw.slice(0, split));
            this.w.keyInt("unit", unitCode(raw.slice(split)));
        }
        else if k == TK.FloatLit {
            this.w.firstKey("type");
            this.w.intValue(15);
            this.w.key("value");
            this.w.floatValue(raw);
            this.w.keyNull("unit");
        }
        else if k == TK.UnitFloatLit {
            let split = splitUnit(raw);
            this.w.firstKey("type");
            this.w.intValue(15);
            this.w.key("value");
            this.w.floatValue(raw.slice(0, split));
            this.w.keyInt("unit", unitCode(raw.slice(split)));
        }
        else if k == TK.StringLit {
            this.w.firstKey("type");
            this.w.intValue(1);
            if raw.length > 0 && raw[0] == b"b" {
                this.w.keyString("prefix", "b");
                this.w.key("value");
                this.w.literalString(raw.slice(1), 1);
            }
            else {
                this.w.keyNull("prefix");
                this.w.key("value");
                this.w.literalString(raw, 1);
            }
        }
        else if k == TK.TripleStringLit {
            this.w.firstKey("type");
            this.w.intValue(1);
            this.w.keyNull("prefix");
            this.w.key("value");
            this.w.literalString(raw, 3);
        }
        else if k == TK.RegexLit {
            // r"pattern"flags
            let closing = raw.length - 1;
            while closing > 1 && raw[closing] != b"\"" { closing--; }
            this.w.firstKey("type");
            this.w.intValue(22);
            this.w.keyString("pattern", raw.slice(2, closing));
            this.w.key("flags");
            this.w.array();
            for (let i = closing + 1; i < raw.length; i++) {
                if i > closing + 1 { this.w.comma(); }
                this.w.stringValue(raw.slice(i, i + 1));
            }
            this.w.endArray();
            this.w.keyNull("id");
        }
        this.w.end();
    }

    // interpolatedString: FSTRING_START fragment* FSTRING_END (WITH expr)?
    mut fn interpolatedString(): void :: final {
        let start = this.advance();   // FStringStart / FTripleStringStart

        this.w.node("FStringExpr");
        this.w.key("fragments");
        this.w.array();
        let count = 0;
        while true {
            let k = this.kind();

            if k == TK.FStringText {
                let t = this.advance();
                if count > 0 { this.w.comma(); }
                count++;
                // f-string text goes through the SAME trim+unescape as a whole
                // string literal, with no delimiters to strip (stripQuotes = 0
                // in the reference). The lexer keeps `{{` / `}}` doubled in the
                // token so the text stays a slice of the source.
                this.w.object();
                this.w.firstKey("type");
                this.w.stringValue("text");
                this.w.key("value");
                this.w.unescapedString(this.text(t), true);
                this.w.end();
                continue;
            }

            if k == TK.LCurly {
                this.advance();
                if count > 0 { this.w.comma(); }
                count++;
                this.w.object();
                this.w.firstKey("type");
                this.w.stringValue("expr");
                this.w.key("value");
                this.expr();
                this.w.end();
                this.expect(TK.RCurly);
                continue;
            }

            if k == TK.FStringEnd || k == TK.FTripleStringEnd {
                this.advance();
                break;
            }

            this.errorAt(this.cur(), "unterminated f-string");
            break;
        }
        this.w.endArray();

        this.w.key("allocator");
        this.withAllocator();
        this.locHere(start);
        this.w.end();
    }

    // arrayExpr: LBRACKET aggregateBody RBRACKET withAllocator?
    mut fn arrayExpr(): void :: final {
        let start = this.expect(TK.LBracket);
        this.w.node("AggregateLiteralExpr");
        this.w.keyNull("datatype");
        this.w.key("elements");
        let savedAllow = this.allowBraceLiteral;
        this.allowBraceLiteral = true;
        this.aggregateBody(TK.RBracket);
        this.allowBraceLiteral = savedAllow;
        this.expect(TK.RBracket);
        this.w.key("allocator");
        this.withAllocator();
        this.locHere(start);
        this.w.end();
    }

    // The rest of braceExpr: nameExpr? LCURLY aggregateBody RCURLY withAllocator?
    // after the AggregateLiteralExpr header and its datatype are written.
    mut fn braceBody(start: Token): void :: final {
        this.expect(TK.LCurly);
        this.w.key("elements");
        let savedAllow = this.allowBraceLiteral;
        this.allowBraceLiteral = true;
        this.aggregateBody(TK.RCurly);
        this.allowBraceLiteral = savedAllow;
        this.expect(TK.RCurly);
        this.w.key("allocator");
        this.withAllocator();
        this.locHere(start);
        this.w.end();
    }

    // aggregateBody: (key: value | value) list with an optional trailing comma.
    mut fn aggregateBody(terminator: TK): void :: final {
        this.w.array();
        let count = 0;
        while !this.at(terminator) {
            if count > 0 { this.w.comma(); }
            count++;
            this.aggregateElement();
            if !this.accept(TK.Comma) { break; }
        }
        this.w.endArray();
    }

    mut fn aggregateElement(): void :: final {
        let start = this.cur();
        this.w.object();
        this.w.firstKey("key");

        // `name:` introduces a keyed element, but `a ? b : c` and plain
        // expressions must not be mistaken for one.
        if (this.at(TK.Ident) || this.at(TK.Type)) && this.peekKind(1) == TK.Colon {
            let t = this.advance();
            this.w.stringValue(this.text(t));
            this.advance();
        }
        else {
            this.w.nullValue();
        }

        // `...bar` spreads a struct's members into the literal (§6).
        // Same token as the argument-list spread; the semantic layer keeps
        // the two contexts apart.
        let isSpread = this.accept(TK.Ellipsis);

        this.w.key("value");
        this.expr();
        this.w.keyBool("spread", isSpread);
        this.locHere(start);
        this.w.end();
    }

    // nameExpr: nameSegment (DOT nameSegment)*
    // Emits SymbolValueExpr, wrapped in ExprMemberAccess for each extra segment.
    mut fn nameExpr(): void :: final {
        let start = this.cur();
        let at = this.w.length();
        let nameTok = this.memberName();
        this.w.node("SymbolValueExpr");
        this.w.keyString("name", this.text(nameTok));
        this.genericArgs();
        this.locHere(start);
        this.w.end();

        // Only continue the dotted chain while it stays a plain name; anything
        // else (calls, indexing) is handled by postfixExpr.
        while this.at(TK.Dot) && (this.peekKind(1) == TK.Ident || this.peekKind(1) == TK.Type) {
            // Like postfixExpr, each segment is anchored at its own name
            // token, after the `.`.
            this.advance();
            let segStart = this.cur();
            let segTok = this.memberName();
            this.wrapNode(at, "ExprMemberAccess", "expr");
            this.w.keyString("member", this.text(segTok));
            this.genericArgs();
            this.locHere(segStart);
            this.w.end();
        }
    }

    // -----------------------------------------------------------------------
    // Type expressions.
    //
    //   typeExpr        -> union of modified types, or a tagged `union { ... }`
    //   typeExprModified-> inline/mut/const/[]T/[N]T/(params)=>T/extern C (params)->T
    //   typeExprSimple  -> primary with .member / .[expr] postfixes
    //
    // Types and value expressions share the SymbolValueExpr/ExprMemberAccess
    // node shapes, so name parsing is reused directly.
    // -----------------------------------------------------------------------

    // typeExpr: typeExprUnion | NODISCARD? UNION LCURLY (id COLON typeExprUnion COMMA)+ ... RCURLY
    mut fn typeExpr(): void :: final {
        let start = this.cur();

        if this.at(TK.Nodiscard) || this.at(TK.Union) {
            let hasNodiscard = this.accept(TK.Nodiscard);
            if this.at(TK.Union) && this.peekKind(1) == TK.LCurly {
                this.advance();
                this.expect(TK.LCurly);

                if hasNodiscard {
                    this.w.node("NodiscardTypeExpr");
                    this.w.key("type");
                }
                this.w.node("TaggedUnionTypeExpr");
                this.w.key("members");
                this.w.array();
                let count = 0;
                while !this.at(TK.RCurly) && !this.atEnd() {
                    let tagTok = this.memberName();
                    if count > 0 { this.w.comma(); }
                    count++;
                    this.w.object();
                    this.w.firstKey("tag");
                    this.w.stringValue(this.text(tagTok));
                    this.w.key("type");
                    this.expect(TK.Colon);
                    this.typeExprUnion();
                    this.w.end();
                    if !this.accept(TK.Comma) { break; }
                }
                this.expect(TK.RCurly);
                this.w.endArray();
                this.locHere(start);
                this.w.end();

                if hasNodiscard {
                    this.locHere(start);
                    this.w.end();
                }
                return;
            }

            // `nodiscard T` without a tagged union body.
            if hasNodiscard {
                this.w.node("NodiscardTypeExpr");
                this.w.key("type");
                this.typeExprUnion();
                this.locHere(start);
                this.w.end();
                return;
            }
        }

        this.typeExprUnion();
    }

    // typeExprUnion: typeExprModified (SINGLEOR typeExprModified)*
    mut fn typeExprUnion(): void :: final {
        let start = this.cur();
        let at = this.w.length();
        this.typeExprModified();

        if !this.at(TK.Or) { return; }

        let moved = this.w.length();
        this.w.node("BinaryUnionTypeExpr");
        this.w.key("types");
        this.w.array();
        this.w.hoist(at, moved);
        while this.accept(TK.Or) {
            this.w.comma();
            this.typeExprModified();
        }
        this.w.endArray();
        this.locHere(start);
        this.w.end();
    }

    mut fn typeExprModified(): void :: final {
        let start = this.cur();
        let k = this.kind();

        // `immediate` is a contextual keyword: only in type position, and
        // only by its text, so it stays usable as a plain identifier
        // (`config.immediate`) everywhere else.
        let isImmediate = k == TK.Ident && this.text(this.cur()) == "immediate";
        if k == TK.Ref || k == TK.Stackref || k == TK.Mut || k == TK.Const || isImmediate {
            this.advance();
            let variant = "RefTypeExpr";
            if k == TK.Stackref { variant = "StackrefTypeExpr"; }
            else if isImmediate { variant = "ImmediateTypeExpr"; }
            else if k == TK.Mut { variant = "MutTypeExpr"; }
            else if k == TK.Const { variant = "ConstTypeExpr"; }

            this.w.node(variant);
            this.w.key("type");
            this.typeExprModified();
            this.locHere(start);
            this.w.end();
            return;
        }

        // `[]T` dynamic array, `[N]T` static array.
        if k == TK.LBracket {
            this.advance();
            if this.accept(TK.RBracket) {
                this.w.node("DynamicArrayTypeExpr");
                this.w.key("type");
                this.typeExprModified();
                this.locHere(start);
                this.w.end();
                return;
            }
            this.w.node("StaticArrayTypeExpr");
            // The size is written first and moved behind the element type,
            // which follows it in the AST.
            let sizeAt = this.w.length();
            this.w.key("arraySize");
            this.expr();
            this.expect(TK.RBracket);
            let typeAt = this.w.length();
            this.w.key("type");
            this.typeExprModified();
            this.w.hoist(sizeAt, typeAt);
            this.locHere(start);
            this.w.end();
            return;
        }

        // Function type: `(params) => T` (closure) or `-> T` (function).
        // A parenthesised type such as `[](Foo)` also starts with `(`,
        // so only commit to a function type when an arrow follows the `)`.
        if k == TK.LParen && this.parenIsFunctionType() {
            this.advance();
            this.functionTypeRest(start, false);
            return;
        }

        // `extern C (params) -> T`: a function type without a context, the
        // only kind C can call. Another language, none, and `=>` are parsed
        // and named as errors, with the same message and position as the
        // reference parser's (Parser.ts checkExternFunctionType).
        if k == TK.Extern {
            this.advance();
            if this.at(TK.Ident) {
                let langTok = this.advance();
                if this.text(langTok) != "C" {
                    this.errorAt(langTok, f"unknown language '{this.text(langTok)}' in a function type: only 'extern C (...) -> R' exists");
                }
            }
            else {
                this.errorAt(this.cur(), "expected 'C' after 'extern' in a function type: 'extern C (...) -> R'");
            }
            this.expect(TK.LParen);
            this.functionTypeRest(start, true);
            return;
        }

        this.typeExprSimple();
    }

    // A function type from just after its `(`: parameters, arrow, return type
    // and requires block. `externC` is the `extern C (...) -> T` form.
    mut fn functionTypeRest(start: Token, externC: bool): void :: final {
        // The variant depends on the arrow after the parameters, so the
        // header is hoisted in front of them once that is known.
        let at = this.w.length();
        let ellipsis = this.paramList(false);
        this.expect(TK.RParen);
        this.w.keyBool("ellipsis", ellipsis);

        let arrow = this.kind();
        if arrow == TK.DoubleArrow || arrow == TK.SingleArrow {
            if externC && arrow == TK.DoubleArrow {
                this.errorAt(this.cur(), "an 'extern C' function type takes '->', not '=>': C cannot call a closure");
            }
            this.advance();
            let variant = "CallableTypeExpr";
            if arrow == TK.SingleArrow { variant = "FunctionTypeExpr"; }
            let moved = this.w.length();
            this.w.node(variant);
            this.w.hoist(at, moved);

            this.w.key("returnType");
            // The grammar's return type is a typeExprModified, so
            // `extern C () -> A | B` is `(extern C () -> A) | B`. The plain
            // form reads `-> (A | B)` instead, against the grammar; that is an
            // open question about the plain form, not copied into this one.
            if externC { this.typeExprModified(); }
            else { this.typeExpr(); }
            this.w.key("requires");
            this.requiresBlock();
            this.w.keyInt("mutability", 1);   // EDatatypeMutability.Default
            // EExternLanguage.Extern_C. Absent, the type is a Haze one.
            if externC { this.w.keyInt("externLanguage", 2); }
            this.locHere(start);
            this.w.end();
            return;
        }

        this.errorAt(this.cur(), "expected '=>' or '->' in function type");
        this.w.truncate(at);
        this.w.nullValue();
    }

    // Does the `(` at the cursor open a function type's parameter list, rather
    // than simply parenthesising a type?
    fn parenIsFunctionType(): bool {
        let depth = 0;
        let i = this.pos;
        let limit = this.toks.length;
        while i < limit {
            let k = this.toks[i].kind;
            if k == TK.LParen { depth++; }
            else if k == TK.RParen {
                depth--;
                if depth == 0 {
                    let after = this.toks[i + 1].kind;
                    return after == TK.DoubleArrow || after == TK.SingleArrow;
                }
            }
            else if k == TK.EOF { return false; }
            i++;
        }
        return false;
    }

    // typeExprSimple: typeExprPrimary typeExprPostfix*
    mut fn typeExprSimple(): void :: final {
        let start = this.cur();
        let at = this.w.length();
        this.typeExprPrimary();

        while true {
            // `.[expr]` comptime member access
            if this.at(TK.Dot) && this.peekKind(1) == TK.LBracket {
                this.advance();
                this.advance();
                this.wrapNode(at, "ExprComptimeMemberAccess", "expr");
                this.w.key("memberExpr");
                this.expr();
                this.expect(TK.RBracket);
                this.locHere(start);
                this.w.end();
                continue;
            }

            let segStart = this.cur();
            let k = this.kind();
            if k == TK.Dot || k == TK.QuestionDot {
                // `typeExprPostfix : (DOT | QUESTIONDOT) nameSegment` INCLUDES
                // the dot, so the span starts there.
                this.advance();
                let segTok = this.memberName();
                let variant = "ExprMemberAccess";
                if k == TK.QuestionDot { variant = "OptionalChainingExprMemberAccess"; }
                this.wrapNode(at, variant, "expr");
                this.w.keyString("member", this.text(segTok));
                this.genericArgs();
                this.locHere(segStart);
                this.w.end();
                continue;
            }
            break;
        }
    }

    mut fn typeExprPrimary(): void :: final {
        let start = this.cur();
        let k = this.kind();

        if k == TK.Typeof {
            this.advance();
            this.expect(TK.LParen);
            this.w.node("TypeOfExpr");
            this.w.key("expr");
            this.expr();
            this.expect(TK.RParen);
            this.locHere(start);
            this.w.end();
            return;
        }

        if k == TK.LParen {
            this.advance();
            this.typeExpr();
            this.expect(TK.RParen);
            return;
        }

        if k == TK.LCurly {
            this.anonStructType();
            return;
        }

        // Literal types such as 5, true or "Foo".
        if this.isLiteralStart(k) {
            this.literalExpr();
            return;
        }

        if k == TK.Ident || k == TK.Type {
            // A bare dotted type name is a `nameExpr`, whose segments are
            // anchored at the NAME. Anything else (typeof(...), parens) is
            // followed by `typeExprPostfix`, which includes the dot -- see
            // typeExprSimple.
            this.nameExpr();
            return;
        }

        this.errorAt(start, f"unexpected token in type: {tokenName(k)}");
        this.advance();
        this.w.nullValue();
    }

    // -----------------------------------------------------------------------
    // Parameters.
    // -----------------------------------------------------------------------

    // `,"params":[...]`. Returns whether a `...` (variadic) appeared.
    mut fn paramList(typesOptional: bool): bool :: final {
        this.w.key("params");
        this.w.array();
        let ellipsis = false;
        let count = 0;

        while !this.at(TK.RParen) && !this.atEnd() {
            if this.at(TK.Ellipsis) {
                this.advance();
                ellipsis = true;
                this.accept(TK.Comma);
                continue;
            }

            let start = this.cur();
            let nameTok = this.expect(TK.Ident);
            let isOptional = this.accept(TK.Question);

            // `name: ...pack` is a parameter pack; the kind is the first key,
            // so it is settled before anything is written.
            let hasType = this.accept(TK.Colon);
            let isPack = false;
            if hasType { isPack = this.accept(TK.Ellipsis); }

            if count > 0 { this.w.comma(); }
            count++;
            this.w.object();
            this.w.firstKey("kind");

            if isPack {
                this.w.stringValue("param-pack");
                this.w.keyString("name", this.text(nameTok));
                // A default value is parsed (it is in the span) but a pack
                // has no field for it.
                if this.accept(TK.Equals) {
                    let at = this.w.length();
                    this.expr();
                    this.w.truncate(at);
                }
                this.locHere(start);
                this.w.end();
                if !this.accept(TK.Comma) { break; }
                continue;
            }

            this.w.stringValue("normal");
            this.w.keyString("name", this.text(nameTok));
            this.w.key("datatype");
            if hasType {
                this.typeExpr();
            }
            else {
                if !typesOptional {
                    this.errorAt(this.cur(), "expected ':' and a parameter type");
                }
                this.w.nullValue();
            }
            this.w.keyBool("optional", isOptional);
            this.w.key("defaultValue");
            if this.accept(TK.Equals) { this.expr(); }
            else { this.w.nullValue(); }
            this.locHere(start);
            this.w.end();

            if !this.accept(TK.Comma) { break; }
        }

        this.w.endArray();
        return ellipsis;
    }

    // -----------------------------------------------------------------------
    // requires blocks: `:: final, pure, noreturn, noreturn_if(expr)`
    // Always written (the AST field is not optional).
    // -----------------------------------------------------------------------

    mut fn requiresBlock(): void :: final {
        let isFinal = false;
        let isPure = false;
        let isNoreturn = false;
        // The noreturn_if condition is written where it is parsed; the flags,
        // which come first, go in front of it once they are all known.
        let at = this.w.length();
        let hasNoreturnIf = false;

        if this.accept(TK.DoubleColon) {
            while true {
                // Parts may be parenthesised.
                let opened = this.accept(TK.LParen);
                let k = this.kind();

                if k == TK.Final { this.advance(); isFinal = true; }
                else if k == TK.Pure { this.advance(); isPure = true; }
                else if k == TK.Noreturn { this.advance(); isNoreturn = true; }
                else if k == TK.NoreturnIf {
                    this.advance();
                    this.expect(TK.LParen);
                    // A later noreturn_if replaces an earlier one.
                    this.w.truncate(at);
                    this.w.object();
                    this.w.firstKey("expr");
                    this.expr();
                    this.w.end();
                    hasNoreturnIf = true;
                    this.expect(TK.RParen);
                }
                else {
                    this.errorAt(this.cur(), "expected a requiresJson specifier");
                    if opened { this.accept(TK.RParen); }
                    break;
                }

                if opened { this.expect(TK.RParen); }
                if !this.accept(TK.Comma) { break; }
            }
        }

        let moved = this.w.length();
        this.w.object();
        this.w.firstKey("final");
        this.w.boolValue(isFinal);
        this.w.keyBool("pure", isPure);
        this.w.keyBool("noreturn", isNoreturn);
        this.w.key("noreturnIf");
        if !hasNoreturnIf { this.w.nullValue(); }
        this.w.hoist(at, moved);
        this.w.end();
    }

    // Structs and enums accept a requires block and ignore it.
    mut fn discardRequiresBlock(): void :: final {
        let at = this.w.length();
        this.requiresBlock();
        this.w.truncate(at);
    }

    // `,"requires":{...}` as an absent block reads.
    mut fn noRequires() {
        this.w.key("requires");
        this.w.object();
        this.w.firstKey("final");
        this.w.boolValue(false);
        this.w.keyBool("pure", false);
        this.w.keyBool("noreturn", false);
        this.w.keyNull("noreturnIf");
        this.w.end();
    }

    // -----------------------------------------------------------------------
    // Scopes, lambdas, do/attempt.
    // -----------------------------------------------------------------------

    // rawScope: LCURLY statement* RCURLY
    mut fn rawScope(isUnsafe: bool): void :: final {
        this.rawScopeFrom(isUnsafe, this.cur());
    }

    // As rawScope, but with an explicit span start (see doScopeExpr).
    mut fn rawScopeFrom(isUnsafe: bool, start: Token): void :: final {
        this.expect(TK.LCurly);
        this.w.node("Scope");
        this.w.key("statements");
        this.w.array();

        let count = 0;
        while !this.at(TK.RCurly) && !this.atEnd() {
            // #source at statement position: relocates the statements inside
            // the block; they land in the enclosing scope's statement list as
            // if the directive were not there.
            if this.at(TK.SourceDirective) {
                let saved = this.beginSourceBlock();
                while !this.at(TK.RCurly) && !this.atEnd() {
                    let beforeInner = this.pos;
                    if count > 0 { this.w.comma(); }
                    count++;
                    this.statement();
                    if this.pos == beforeInner { this.advance(); }
                }
                this.restoreOverride(saved);
                this.expect(TK.RCurly);
                continue;
            }
            let before = this.pos;
            if count > 0 { this.w.comma(); }
            count++;
            this.statement();
            // Guarantee forward progress even if a statement failed to parse.
            if this.pos == before { this.advance(); }
        }
        this.expect(TK.RCurly);

        this.w.endArray();
        this.w.keyBool("unsafe", isUnsafe);
        this.locHere(start);
        this.w.end();
    }

    // doScope: DO UNSAFE? LCURLY statement* RCURLY
    mut fn doScopeExpr(): void :: final {
        let start = this.expect(TK.Do);
        let isUnsafe = this.accept(TK.Unsafe);
        this.w.node("BlockScopeExpr");
        this.w.key("scope");
        // `doScope` is one rule, so the Scope node it builds spans from `do`,
        // not from the opening brace.
        this.rawScopeFrom(isUnsafe, start);
        this.locHere(start);
        this.w.end();
    }

    // attempt rawScope (else id? rawScope | recover id? rawScope)*
    mut fn attemptExpr(): void :: final {
        this.attemptExprImpl(false);
    }

    mut fn attemptExprImpl(takeSemi: bool): void :: final {
        let start = this.expect(TK.Attempt);
        this.w.node("AttemptExpr");
        this.w.key("attemptScope");
        this.rawScope(false);

        // Each clause is written as it comes, scope then variable. The AST
        // has the else clause first, and only the last of each kind counts,
        // so an earlier duplicate is removed and the order fixed at the end.
        let elseAt = -1;
        let elseLength = 0;
        let recoverAt = -1;
        let recoverLength = 0;
        while true {
            if this.at(TK.Else) {
                this.advance();
                let name = "";
                if this.at(TK.Ident) { name = this.text(this.advance()); }
                if elseAt >= 0 {
                    this.w.remove(elseAt, elseLength);
                    if recoverAt > elseAt { recoverAt -= elseLength; }
                }
                elseAt = this.w.length();
                this.w.key("elseScope");
                this.rawScope(false);
                this.w.keyOptionalString("elseVar", name);
                elseLength = this.w.length() - elseAt;
                continue;
            }
            if this.at(TK.Recover) {
                this.advance();
                let name = "";
                if this.at(TK.Ident) { name = this.text(this.advance()); }
                if recoverAt >= 0 {
                    this.w.remove(recoverAt, recoverLength);
                    if elseAt > recoverAt { elseAt -= recoverLength; }
                }
                recoverAt = this.w.length();
                this.w.key("recoverScope");
                this.rawScope(false);
                this.w.keyOptionalString("recoverVar", name);
                recoverLength = this.w.length() - recoverAt;
                continue;
            }
            break;
        }

        if elseAt < 0 {
            let moved = this.w.length();
            this.w.keyNull("elseScope");
            this.w.keyNull("elseVar");
            if recoverAt >= 0 { this.w.hoist(recoverAt, moved); }
        }
        else if recoverAt >= 0 && recoverAt < elseAt {
            this.w.hoist(recoverAt, elseAt);
        }
        if recoverAt < 0 {
            this.w.keyNull("recoverScope");
            this.w.keyNull("recoverVar");
        }

        if takeSemi { this.attemptTookSemi = this.accept(TK.Semi); }

        this.locHere(start);
        this.w.end();
    }

    // lambda: LB lambdaParams RB (COLON typeExpr)? requiresBlock? (=> | ->) funcbody
    mut fn lambdaExpr(): void :: final {
        let start = this.expect(TK.LParen);
        this.w.node("LambdaExpr");
        this.w.key("lambda");
        this.w.node("Lambda");
        // "kind" comes next in the AST but is only known at the arrow.
        let kindAt = this.w.length();
        let ellipsis = this.paramList(true);
        this.w.keyBool("ellipsis", ellipsis);
        this.expect(TK.RParen);

        if this.accept(TK.Colon) {
            this.w.key("returnType");
            this.typeExpr();
        }

        // The requires block belongs after the scope. Without one (nearly
        // always) the default is simply written there; a real one is written
        // here and the scope moved in front of it.
        let hasRequires = this.at(TK.DoubleColon);
        let requiresLength = 0;
        if hasRequires {
            let at = this.w.length();
            this.w.key("requires");
            this.requiresBlock();
            requiresLength = this.w.length() - at;
        }

        let arrow = this.kind();
        let kind = "closure";
        if arrow == TK.SingleArrow { kind = "function"; }
        if arrow == TK.DoubleArrow || arrow == TK.SingleArrow { this.advance(); }
        else { this.errorAt(this.cur(), "expected '=>' or '->' in lambda"); }

        let moved = this.w.length();
        this.w.keyString("kind", kind);
        this.w.hoist(kindAt, moved);

        let scopeAt = this.w.length();
        this.w.key("scope");
        this.funcBody();
        if hasRequires { this.w.hoist(scopeAt - requiresLength, scopeAt); }
        else { this.noRequires(); }
        this.locHere(start);
        this.w.end();

        this.locHere(start);
        this.w.end();
    }

    // funcbody: rawScope | expr
    mut fn funcBody(): void :: final {
        if this.at(TK.LCurly) {
            this.rawScope(false);
            return;
        }
        this.w.node("ExprAsFuncBody");
        this.w.key("expr");
        this.expr();
        this.w.end();
    }

    // -----------------------------------------------------------------------
    // Statements.
    // -----------------------------------------------------------------------

    mut fn statement(): void :: final {
        let start = this.cur();
        let k = this.kind();

        if k == TK.InlineC {
            this.advance();
            this.expect(TK.LParen);
            this.w.node("InlineCStatement");
            this.w.key("expr");
            this.expr();
            this.expect(TK.RParen);
            this.accept(TK.Semi);
            this.locHere(start);
            this.w.end();
            return;
        }

        if k == TK.Return {
            this.advance();
            this.w.node("ReturnStatement");
            if !this.at(TK.Semi) {
                this.w.key("expr");
                this.expr();
            }
            this.expect(TK.Semi);
            this.locHere(start);
            this.w.end();
            return;
        }

        if k == TK.Raise {
            this.advance();
            this.w.node("RaiseStatement");
            this.w.key("expr");
            if !this.at(TK.Semi) { this.expr(); }
            else { this.w.nullValue(); }
            this.expect(TK.Semi);
            this.locHere(start);
            this.w.end();
            return;
        }

        if k == TK.Break {
            this.advance();
            this.expect(TK.Semi);
            this.w.node("BreakStatement");
            this.locHere(start);
            this.w.end();
            return;
        }

        if k == TK.Continue {
            this.advance();
            this.expect(TK.Semi);
            this.w.node("ContinueStatement");
            this.locHere(start);
            this.w.end();
            return;
        }

        if k == TK.Let || k == TK.Const {
            this.variableCreation();
            return;
        }

        if k == TK.Type {
            // `type X = T;` alias — but `type` can also start an expression.
            if this.peekKind(1) == TK.Ident {
                this.typeAlias(this.cur(), false, 0, -1);
                this.accept(TK.Semi);
                return;
            }
        }

        if k == TK.Alias {
            // `alias` is a reserved word, so unlike `type` there is nothing
            // else it can start.
            this.typeAlias(this.cur(), false, 0, -1);
            this.accept(TK.Semi);
            return;
        }

        if k == TK.If {
            this.ifStatement();
            return;
        }

        if k == TK.While {
            this.whileStatement();
            return;
        }

        if k == TK.For {
            this.forStatement();
            return;
        }

        // `do { }` and `attempt { }` as statements: the trailing semicolon is
        // optional, which is why they are matched before the generic
        // expression-statement rule.
        if k == TK.Do {
            // `doScope SEMI?` is one statement rule: the optional `;` is part
            // of the statement's span (but not of the inner expression's).
            this.w.node("ExprStatement");
            this.w.key("expr");
            this.doScopeExpr();
            this.w.keyBool("semicolon", this.accept(TK.Semi));
            this.locHere(start);
            this.w.end();
            return;
        }

        if k == TK.Attempt {
            // `ATTEMPT rawScope attemptBody* SEMI?` is a single statement rule
            // and the AttemptExpr node is built from it, so the optional `;`
            // falls inside the EXPRESSION's span too (unlike `do`, where the
            // expression comes from the separate doScope rule).
            this.attemptTookSemi = false;
            this.w.node("ExprStatement");
            this.w.key("expr");
            this.attemptExprImpl(true);
            this.w.keyBool("semicolon", this.attemptTookSemi);
            this.locHere(start);
            this.w.end();
            return;
        }

        // Expression statement. The trailing `;` is optional: without one, a
        // last statement in an emitting scope (`do`/`attempt`) yields its value
        // instead of discarding it -- see `emit` in SymbolCollection.ts.
        this.w.node("ExprStatement");
        this.w.key("expr");
        this.expr();
        let semi = false;
        if !this.noSemiInStatement { semi = this.accept(TK.Semi); }
        this.w.keyBool("semicolon", semi);
        this.locHere(start);
        this.w.end();
    }

    // variableCreation: (let|const) comptime? id ((: T)? = expr | : T) SEMI?
    mut fn variableCreation(): void :: final {
        let start = this.cur();
        let mutability = this.variableMutability();
        let isStackref = this.accept(TK.Stackref);
        let isComptime = this.accept(TK.Comptime);
        let nameTok = this.expect(TK.Ident);

        this.w.node("VariableDefinitionStatement");
        this.w.keyInt("mutability", mutability);
        this.w.keyBool("stackref", isStackref);
        this.w.keyBool("comptime", isComptime);
        this.w.keyString("name", this.text(nameTok));
        if this.accept(TK.Colon) {
            this.w.key("datatype");
            this.typeExpr();
        }
        if this.accept(TK.Equals) {
            this.w.key("expr");
            this.expr();
        }
        if !this.noSemiInStatement { this.accept(TK.Semi); }
        this.w.keyInt("variableContext", 1);   // EVariableContext.FunctionLocal
        this.locHere(start);
        this.w.end();
    }

    // EVariableMutability: Const=1 Let=2 Default=3
    mut fn variableMutability(): int {
        if this.accept(TK.Const) { return 1; }
        if this.accept(TK.Let) { return 2; }
        return 3;
    }

    // Condition of if/while: either an expression or `let x = expr` with an
    // optional `; guard`, written as the `condition` / `letCondition` pair.
    // `first` when `condition` opens its object. Brace literals are disabled
    // so `if x { }` parses the brace as the body rather than a struct literal.
    mut fn condition(first: bool): void :: final {
        let savedAllow = this.allowBraceLiteral;
        this.allowBraceLiteral = false;

        if this.at(TK.Let) {
            this.advance();
            let nameTok = this.expect(TK.Ident);
            let letAt = this.w.length();
            this.w.key("letCondition");
            this.w.object();
            this.w.firstKey("name");
            this.w.stringValue(this.text(nameTok));
            this.w.key("type");
            if this.accept(TK.Colon) { this.typeExpr(); }
            else { this.w.nullValue(); }
            this.expect(TK.Equals);
            this.w.key("expr");
            this.expr();
            this.w.end();

            // A `let` condition may still carry a guard expression, which is
            // reported as the plain `condition`, ahead of the binding.
            let moved = this.w.length();
            if first { this.w.firstKey("condition"); }
            else { this.w.key("condition"); }
            if this.accept(TK.Semi) { this.expr(); }
            else { this.w.nullValue(); }
            this.w.hoist(letAt, moved);
        }
        else {
            if first { this.w.firstKey("condition"); }
            else { this.w.key("condition"); }
            this.expr();
            this.w.keyNull("letCondition");
        }

        this.allowBraceLiteral = savedAllow;
    }

    mut fn ifStatement(): void :: final {
        let start = this.expect(TK.If);
        let isComptime = this.accept(TK.Comptime);
        this.w.node("IfStatement");
        this.condition(false);
        this.w.key("thenScope");
        this.rawScope(false);
        this.w.keyBool("comptime", isComptime);

        this.w.key("elseIfs");
        this.w.array();
        let count = 0;
        let hasElse = false;
        while this.at(TK.Else) {
            this.advance();
            if this.at(TK.If) {
                this.advance();
                this.accept(TK.Comptime);
                if count > 0 { this.w.comma(); }
                count++;
                this.w.object();
                this.condition(true);
                this.w.key("thenScope");
                this.rawScope(false);
                this.w.end();
                continue;
            }
            this.w.endArray();
            hasElse = true;
            this.w.key("else");
            this.rawScope(false);
            break;
        }
        if !hasElse { this.w.endArray(); }

        this.locHere(start);
        this.w.end();
    }

    mut fn whileStatement(): void :: final {
        let start = this.expect(TK.While);
        this.w.node("WhileStatement");
        this.condition(false);
        this.w.key("body");
        this.rawScope(false);
        this.locHere(start);
        this.w.end();
    }

    // for: `for x in expr { }` / `for x, i in expr { }` / C-style `for (a; b; c)`
    mut fn forStatement(): void :: final {
        let start = this.expect(TK.For);
        let isComptime = this.accept(TK.Comptime);

        if this.at(TK.LParen) {
            this.advance();
            this.w.node("ForStatement");

            this.w.key("initStatement");
            if !this.at(TK.Semi) {
                // In `for (init; cond; incr)` the separating `;` belongs to the
                // for rule, not to the init statement, so the statement's span
                // must stop before it. `noSemiInStatement` makes the statement
                // parser leave the `;` for us to consume here.
                this.noSemiInStatement = true;
                this.statement();
                this.noSemiInStatement = false;
            }
            else {
                this.w.nullValue();
            }
            this.expect(TK.Semi);

            this.w.key("loopCondition");
            if !this.at(TK.Semi) { this.expr(); }
            else { this.w.nullValue(); }
            this.expect(TK.Semi);

            this.w.key("loopIncrement");
            if !this.at(TK.RParen) { this.expr(); }
            else { this.w.nullValue(); }
            this.expect(TK.RParen);

            this.w.keyBool("comptime", isComptime);
            this.w.key("body");
            this.rawScope(false);
            this.locHere(start);
            this.w.end();
            return;
        }

        let loopVarTok = this.expect(TK.Ident);
        let indexVar = "";
        if this.accept(TK.Comma) {
            let idxTok = this.expect(TK.Ident);
            indexVar = this.text(idxTok);
        }
        this.expect(TK.In);

        this.w.node("ForEachStatement");
        this.w.keyString("loopVariable", this.text(loopVarTok));
        this.w.keyOptionalString("indexVariable", indexVar);
        this.w.key("value");
        let savedAllow = this.allowBraceLiteral;
        this.allowBraceLiteral = false;
        this.expr();
        this.allowBraceLiteral = savedAllow;

        this.w.keyBool("comptime", isComptime);
        this.w.key("body");
        this.rawScope(false);
        this.locHere(start);
        this.w.end();
    }


    // -----------------------------------------------------------------------
    // Top level.
    // -----------------------------------------------------------------------

    // prog: (importStatements | globalDeclaration)* EOF
    // The output is an envelope, not a bare array:
    //   {"f":"<filename>","d":[ ...declarations... ]}
    // so the filename is transmitted ONCE instead of on every node (it was
    // repeated 10,405 times in one generated import file, a third of the
    // payload). The bridge unwraps this and fills the name back in.
    mut fn parseProgram(): void :: final {
        this.w.object();
        this.w.firstKey("f");
        this.w.stringValue(this.filename);
        this.w.key("d");
        this.w.array();
        this.listCount = 0;
        while !this.atEnd() {
            let before = this.pos;
            this.topLevelDeclaration();
            if this.pos == before {
                this.errorAt(this.cur(), f"unexpected token: {tokenName(this.kind())}");
                this.advance();
            }
        }
        this.w.endArray();
        this.w.end();
    }

    mut fn topLevelDeclaration(): void :: final {
        let k = this.kind();

        if k == TK.Import {
            this.declElement();
            this.importStatement();
            return;
        }
        if k == TK.From {
            this.declElement();
            this.fromImportStatement();
            return;
        }
        if k == TK.Semi {
            this.advance();
            return;
        }

        this.globalDeclaration();
    }

    // import (id | STRING) (as id)? SEMI?
    mut fn importStatement(): void :: final {
        let start = this.expect(TK.Import);

        let isPath = this.at(TK.StringLit);
        let nameTok = this.cur();
        if isPath { this.advance(); }
        else { nameTok = this.expect(TK.Ident); }

        let aliasName = "";
        if this.accept(TK.As) {
            let t = this.expect(TK.Ident);
            aliasName = this.text(t);
        }
        this.accept(TK.Semi);

        this.w.node("ModuleImport");
        this.writeImportSource(isPath, nameTok);
        this.w.keyOptionalString("alias", aliasName);
        this.locHere(start);
        this.w.end();
    }

    // `,"mode":..,"name":..` of an import: a module name, or a path written as
    // a string literal.
    mut fn writeImportSource(isPath: bool, nameTok: Token) {
        if isPath {
            this.w.keyString("mode", "path");
            this.w.key("name");
            this.w.literalString(this.text(nameTok), 1);
            return;
        }
        this.w.keyString("mode", "module");
        this.w.keyString("name", this.text(nameTok));
    }

    // from (id | STRING) import importAs (, importAs)* SEMI?
    mut fn fromImportStatement(): void :: final {
        let start = this.expect(TK.From);

        let isPath = this.at(TK.StringLit);
        let nameTok = this.cur();
        if isPath { this.advance(); }
        else { nameTok = this.expect(TK.Ident); }

        this.expect(TK.Import);

        this.w.node("SymbolImport");
        this.writeImportSource(isPath, nameTok);
        this.w.key("symbols");
        this.w.array();
        let count = 0;
        while true {
            let symTok = this.expect(TK.Ident);
            let aliasName = "";
            if this.accept(TK.As) {
                let aliasTok = this.expect(TK.Ident);
                aliasName = this.text(aliasTok);
            }
            if count > 0 { this.w.comma(); }
            count++;
            this.w.object();
            this.w.firstKey("symbol");
            this.w.stringValue(this.text(symTok));
            this.w.keyOptionalString("alias", aliasName);
            this.w.end();
            if !this.accept(TK.Comma) { break; }
        }
        this.accept(TK.Semi);
        this.w.endArray();
        this.locHere(start);
        this.w.end();
    }

    // A global declaration, with all the leading modifiers the grammar allows.
    mut fn globalDeclaration(): void :: final {
        // The declaration's sourceloc and originalSourcecode start at the first
        // modifier (`export`, `extern C noemit`, ...), not at the `fn`/`struct`
        // keyword, so remember it before any of them are consumed.
        let declStart = this.cur();
        let annotationsAt = this.skipAnnotations();
        let isExport = this.accept(TK.Export);

        // `__c__("...")` injection.
        if this.at(TK.InlineC) {
            let start = this.lastToken();
            if !isExport { start = this.cur(); }
            this.advance();
            this.expect(TK.LParen);
            this.declElement();
            this.w.node("CInjectDirective");
            this.w.key("expr");
            this.expr();
            this.expect(TK.RParen);
            this.accept(TK.Semi);
            this.w.keyBool("export", isExport);
            this.locHere(start);
            this.w.end();
            return;
        }

        if this.at(TK.Namespace) {
            this.declElement();
            this.namespaceDefinition(declStart, isExport);
            return;
        }
        if this.at(TK.ModuleNamespace) {
            this.declElement();
            this.moduleNamespaceDefinition(declStart, isExport);
            return;
        }
        if this.at(TK.SourceDirective) {
            this.sourceLocationBlock();
            return;
        }

        // extern / pub / noemit / opaque / plain / modifiers.
        let mods = this.declModifiers();

        if this.at(TK.Fn) {
            this.declElement();
            this.functionDefinition(declStart, isExport, mods, false, 0);
            return;
        }
        if this.at(TK.Struct) {
            this.declElement();
            this.structDefinition(declStart, isExport, mods, annotationsAt);
            return;
        }
        if this.at(TK.Enum) {
            this.declElement();
            this.enumDefinition(declStart, isExport, mods);
            return;
        }
        if this.at(TK.Type) || this.at(TK.Alias) {
            this.declElement();
            this.typeAlias(declStart, isExport, mods.externLang, annotationsAt);
            this.accept(TK.Semi);
            return;
        }
        if this.at(TK.Let) || this.at(TK.Const) {
            this.declElement();
            this.globalVariable(declStart, isExport, mods);
            return;
        }

        this.errorAt(this.cur(), f"unexpected token at top level: {tokenName(this.kind())}");
        this.advance();
    }

    // extern [lang] pub? noemit? (opaque|plain|ref|nocopy)*
    mut fn declModifiers(): Modifiers :: final {
        let m = Modifiers {};

        if this.accept(TK.Extern) {
            // EExternLanguage: None=0 Extern=1 Extern_C=2
            m.externLang = 1;
            if this.at(TK.Ident) {
                let langTok = this.advance();
                if this.text(langTok) == "C" { m.externLang = 2; }
            }
        }

        while true {
            if this.at(TK.Pub) { this.advance(); m.isPub = true; continue; }
            if this.at(TK.Noemit) { this.advance(); m.isNoemit = true; continue; }
            if this.at(TK.Opaque) { this.advance(); m.isOpaque = true; continue; }
            if this.at(TK.Plain) { this.advance(); m.isPlain = true; continue; }
            if this.at(TK.Ref) { this.advance(); m.refByDefault = true; continue; }
            if this.at(TK.Nocopy) { this.advance(); m.isNocopy = true; continue; }
            break;
        }
        return m;
    }

    // metaAnnotation: [[ item (, item)* ,? ]]
    //
    // Parsed where it stands, which is where its errors belong, and written
    // where the AST puts it, near the end of the declaration it annotates:
    // writeAnnotations walks the same tokens again, quietly. Returns the token
    // position of `[[`, or -1 when there is no annotation.
    mut fn skipAnnotations(): int :: final {
        if !(this.at(TK.LBracket) && this.peekKind(1) == TK.LBracket) { return -1; }
        let at = this.pos;
        this.metaAnnotation(false);
        return at;
    }

    // `,"annotations":[...]` for the annotation at token `at`, or `[]`.
    mut fn writeAnnotations(at: int): void :: final {
        this.w.key("annotations");
        if at < 0 {
            this.w.array();
            this.w.endArray();
            return;
        }
        let savedPos = this.pos;
        let savedQuiet = this.quiet;
        this.pos = at;
        this.quiet = true;
        this.metaAnnotation(true);
        this.quiet = savedQuiet;
        this.pos = savedPos;
    }

    mut fn metaAnnotation(write: bool): void :: final {
        this.advance();
        this.advance();
        if write { this.w.array(); }

        let count = 0;
        while !this.at(TK.RBracket) && !this.atEnd() {
            // The key is the dotted name, `a.b.c`.
            let first = this.expect(TK.Ident);
            if write {
                if count > 0 { this.w.comma(); }
                this.w.object();
                this.w.firstKey("key");
                this.w.openString();
                this.w.stringPart(this.text(first));
            }
            while this.at(TK.Dot) {
                this.advance();
                let seg = this.expect(TK.Ident);
                if write {
                    this.w.stringPart(".");
                    this.w.stringPart(this.text(seg));
                }
            }
            if write { this.w.closeString(); }

            // The annotation value is a bare LiteralValue, not an expression.
            if this.accept(TK.Equals) {
                let t = this.advance();
                if write {
                    this.w.key("value");
                    this.literalValue(t);
                }
            }
            else if write {
                this.w.keyNull("value");
            }
            if write { this.w.end(); }
            count++;

            if !this.accept(TK.Comma) { break; }
        }
        this.expect(TK.RBracket);
        this.expect(TK.RBracket);
        if write { this.w.endArray(); }
    }

    // namespace id (. id)* { globalDeclaration* }
    mut fn namespaceDefinition(start: Token, isExport: bool): void :: final {
        this.expect(TK.Namespace);

        // `namespace a.b { X }` nests: a contains b, b contains X. Every
        // level's header is written as its name is read.
        let depth = 0;
        let nameTok = this.expect(TK.Ident);
        while true {
            this.w.node("NamespaceDefinition");
            this.w.keyBool("export", isExport);
            this.w.keyString("name", this.text(nameTok));
            this.w.key("declarations");
            this.w.array();
            depth++;
            if !this.accept(TK.Dot) { break; }
            nameTok = this.expect(TK.Ident);
        }

        this.expect(TK.LCurly);
        let savedCount = this.listCount;
        this.listCount = 0;
        while !this.at(TK.RCurly) && !this.atEnd() {
            let before = this.pos;
            this.globalDeclaration();
            if this.pos == before { this.advance(); }
        }
        this.listCount = savedCount;
        this.expect(TK.RCurly);

        for (let i = 0; i < depth; i++) {
            this.w.endArray();
            this.locHere(start);
            this.w.end();
        }
    }

    // module_namespace name "version" "id" { globalDeclaration* }
    mut fn moduleNamespaceDefinition(start: Token, isExport: bool): void :: final {
        this.expect(TK.ModuleNamespace);

        let nameTok = this.expect(TK.Ident);
        let versionTok = this.expect(TK.StringLit);
        let idTok = this.expect(TK.StringLit);

        this.expect(TK.LCurly);
        this.w.node("ModuleNamespaceDefinition");
        this.w.keyBool("export", isExport);
        this.w.keyString("moduleName", this.text(nameTok));
        this.w.key("moduleId");
        this.w.literalString(this.text(idTok), 1);
        this.w.key("moduleVersion");
        this.w.literalString(this.text(versionTok), 1);
        this.w.key("declarations");
        this.w.array();

        let savedCount = this.listCount;
        this.listCount = 0;
        while !this.at(TK.RCurly) && !this.atEnd() {
            let before = this.pos;
            this.globalDeclaration();
            if this.pos == before { this.advance(); }
        }
        this.listCount = savedCount;
        this.expect(TK.RCurly);

        this.w.endArray();
        this.locHere(start);
        this.w.end();
    }

    // Snapshot of the #source override state, so directive blocks can nest.
    mut fn saveOverride(): SourceOverrideState :: final {
        return SourceOverrideState {
            active: this.sourcelocOverride,
            file: this.overrideFile,
            startLine: this.overrideStartLine,
            startCol: this.overrideStartCol,
            endLine: this.overrideEndLine,
            endCol: this.overrideEndCol,
            hasEnd: this.overrideHasEnd,
            offsetMode: this.overrideOffsetMode,
            anchorLine: this.overrideAnchorLine,
        };
    }

    mut fn restoreOverride(saved: SourceOverrideState): void :: final {
        this.sourcelocOverride = saved.active;
        this.overrideFile = saved.file;
        this.overrideStartLine = saved.startLine;
        this.overrideStartCol = saved.startCol;
        this.overrideEndLine = saved.endLine;
        this.overrideEndCol = saved.endCol;
        this.overrideHasEnd = saved.hasEnd;
        this.overrideOffsetMode = saved.offsetMode;
        this.overrideAnchorLine = saved.anchorLine;
    }

    // Parses `#source "spec" {` and activates the override; the caller loops
    // its own contents and then restores + expects the closing RCurly.
    mut fn beginSourceBlock(): SourceOverrideState :: final {
        let dirTok = this.expect(TK.SourceDirective);
        let pathTok = this.expect(TK.StringLit);
        let spec = stringLiteralValue(this.text(pathTok), 1);
        this.expect(TK.LCurly);
        let saved = this.saveOverride();
        this.applySourceSpec(spec, dirTok.line);
        return saved;
    }

    // #source "file:line:col" { globalDeclaration* }
    // The directive overrides the sourceloc of everything inside it. Its
    // declarations join the enclosing list.
    mut fn sourceLocationBlock(): void :: final {
        let saved = this.beginSourceBlock();

        while !this.at(TK.RCurly) && !this.atEnd() {
            let before = this.pos;
            this.topLevelDeclaration();
            if this.pos == before { this.advance(); }
        }

        this.restoreOverride(saved);
        this.expect(TK.RCurly);
    }

    // Parse `"/path/to/file.hz:line:col[-endcol[.endline]]"`. The path itself may
    // contain colons on some platforms, so the numeric suffix is found by
    // scanning back from the end rather than splitting on the first colon.
    //
    // The two numbers after `-` are (endLine, endCol) in that order -- the same
    // order formatSourceLoc prints, since it is what writes these specs. A lone
    // `-endcol` means the span ends on the start line.
    //
    // Columns in the spec are 1-based (that is what formatSourceLoc prints and
    // what the hzui plugin emits), while a Token's `col` -- and therefore the
    // sourceloc this override replaces -- is 0-based, so every column read out
    // of a spec is converted on the way in.
    mut fn applySourceSpec(spec: str, anchorLine: int) {
        // Find the two colons that introduce line and column. A spec with a
        // single trailing ":line" (no column) selects offset mode instead.
        let lastColon = -1;
        let prevColon = -1;
        for (let i = spec.length - 1; i >= 0; i--) {
            if spec[i] == b":" {
                if lastColon < 0 { lastColon = i; }
                else { prevColon = i; return this.finishSourceSpec(spec, prevColon, lastColon); }
            }
        }
        if lastColon >= 0 {
            // "file:line" -> offset (line-map) mode.
            this.overrideFile = spec.slice(0, lastColon);
            this.overrideStartLine = parseIntPrefix(spec.slice(lastColon + 1));
            this.overrideAnchorLine = anchorLine;
            this.overrideOffsetMode = true;
            this.sourcelocOverride = true;
        }
        // Malformed (no colon at all): leave the real locations in place.
    }

    mut fn finishSourceSpec(spec: str, prevColon: int, lastColon: int) {
        this.overrideFile = spec.slice(0, prevColon);
        this.overrideStartLine = parseIntPrefix(spec.slice(prevColon + 1, lastColon));

        let tail = spec.slice(lastColon + 1);
        this.overrideStartCol = specColumn(tail);
        this.overrideHasEnd = false;
        this.overrideEndLine = this.overrideStartLine;
        this.overrideEndCol = this.overrideStartCol;

        // Optional `-endcol` or `-endline.endcol`.
        let dash = indexOf(tail, "-");
        if dash >= 0 {
            let rest = tail.slice(dash + 1);
            this.overrideHasEnd = true;
            let dot = indexOf(rest, ".");
            if dot >= 0 {
                this.overrideEndLine = parseIntPrefix(rest);
                this.overrideEndCol = specColumn(rest.slice(dot + 1));
            }
            else {
                this.overrideEndCol = specColumn(rest);
            }
        }

        this.overrideOffsetMode = false;
        this.sourcelocOverride = true;
    }

    // globalVariableDef
    mut fn globalVariable(start: Token, isExport: bool, mods: Modifiers): void :: final {
        let mutability = this.variableMutability();
        let isStackref = this.accept(TK.Stackref);
        let isComptime = this.accept(TK.Comptime);
        let nameTok = this.expect(TK.Ident);

        this.w.node("GlobalVariableDefinition");
        this.w.keyBool("export", isExport);
        this.w.keyBool("comptime", isComptime);
        this.w.keyBool("pub", mods.isPub);
        this.w.keyInt("extern", mods.externLang);
        this.w.keyInt("mutability", mutability);
        this.w.keyString("name", this.text(nameTok));
        if this.accept(TK.Colon) {
            this.w.key("datatype");
            this.typeExpr();
        }
        if this.accept(TK.Equals) {
            this.w.key("expr");
            this.expr();
        }
        this.accept(TK.Semi);
        this.locHere(start);
        this.w.end();
    }

    // typeDef: (type | alias) name (<generics>)? = typeExpr
    //
    // One production, two keywords. `alias` aliases any symbol; `type` is
    // `alias` plus a check, made later, that the target resolves to a datatype.
    // `typeOnly` is the only trace of which keyword was written.
    mut fn typeAlias(start: Token, isExport: bool, externLang: int, annotationsAt: int): void :: final {
        let typeOnly = this.at(TK.Type);
        if typeOnly { this.expect(TK.Type); } else { this.expect(TK.Alias); }
        let nameTok = this.expect(TK.Ident);

        let genericsBase = this.genericParams();
        let genericsEnd = this.stack.length;

        this.expect(TK.Equals);
        this.w.node("AliasDef");
        this.w.keyBool("typeOnly", typeOnly);
        this.w.keyString("name", this.text(nameTok));
        this.w.key("datatype");
        this.typeExpr();
        this.writeGenerics(genericsBase, genericsEnd, start);
        this.popTo(genericsBase);
        this.w.keyBool("export", isExport);
        this.w.keyBool("pub", false);
        this.w.keyInt("extern", externLang);
        this.writeAnnotations(annotationsAt);
        this.locHere(start);
        this.w.end();
    }

    // <A, B, C> generic parameter names. Each name's token index is pushed on
    // the stack; returns the height before them, to pop back to when done.
    mut fn genericParams(): int :: final {
        let base = this.stack.length;
        if !this.at(TK.LAngle) { return base; }
        this.advance();
        while !this.at(TK.RAngle) && !this.atEnd() {
            this.stack.push(this.pos);
            this.expect(TK.Ident);
            if !this.accept(TK.Comma) { break; }
        }
        this.expect(TK.RAngle);
        return base;
    }

    // The generic parameters stack[first, last) as `,"generics":[...]`, each
    // carrying the whole declaration's span (from `start` to the last token so
    // far). Omitted when there are none; the bridge defaults a missing key to [].
    mut fn writeGenerics(first: int, last: int, start: Token) {
        if last == first { return; }
        let endTok = this.lastToken();
        this.w.key("generics");
        this.w.array();
        for (let i = first; i < last; i++) {
            if i > first { this.w.comma(); }
            this.w.object();
            this.w.firstKey("name");
            this.w.stringValue(this.text(this.toks[this.stack[i]]));
            this.writeLoc(start, endTok);
            this.w.end();
        }
        this.w.endArray();
    }


    // functionDefinition / struct method.
    //
    // `methodType` (EMethodType) only matters inside a struct; `operatorId`
    // is the EOverloadedOperator for `operator+` style names.
    mut fn functionDefinition(start: Token, isExport: bool, mods: Modifiers, isMethod: bool, methodType: int): void :: final {
        this.expect(TK.Fn);
        let isComptime = this.accept(TK.Comptime);

        let nameTok = this.cur();
        let name = "";
        let operatorId = operatorIdOf(nameTok.kind);
        if operatorId > 0 {
            this.advance();
            // The AST stores the mangled name, not the source spelling.
            name = operatorMethodName(nameTok.kind);
        }
        else {
            nameTok = this.memberName();
            name = this.text(nameTok);
        }

        let genericsBase = this.genericParams();
        let genericsEnd = this.stack.length;

        this.expect(TK.LParen);
        this.w.node("FunctionDefinition");
        this.w.keyBool("export", isExport);
        this.w.keyBool("comptime", isComptime);
        this.w.keyBool("pub", mods.isPub);
        this.w.keyInt("externLanguage", mods.externLang);
        if operatorId > 0 {
            this.w.key("operatorOverloading");
            this.w.object();
            this.w.firstKey("operator");
            this.w.intValue(operatorId);
            this.w.end();
        }
        // The generics and the requires block come here in the AST, but the
        // requires block is parsed after the parameters and the generics'
        // span ends with the function: both are hoisted in when known.
        let nameAt = this.w.length();
        this.w.keyString("name", name);
        this.w.keyBool("noemit", mods.isNoemit);
        this.w.keyBool("static", mods.isStatic);
        let ellipsis = this.paramList(false);
        this.expect(TK.RParen);
        this.w.keyBool("ellipsis", ellipsis);

        if this.accept(TK.Colon) {
            this.w.key("returnType");
            this.typeExpr();
        }

        let requiresFrom = this.w.length();
        this.w.key("requires");
        this.requiresBlock();
        this.w.hoist(nameAt, requiresFrom);
        this.accept(TK.DoubleArrow);

        this.w.keyInt("methodType", methodType);
        if mods.methodMutability == 0 { this.w.keyNull("methodRequiredMutability"); }
        else { this.w.keyInt("methodRequiredMutability", mods.methodMutability); }
        if mods.methodReceiverStorage == 0 { this.w.keyNull("methodReceiverStorage"); }
        else { this.w.keyInt("methodReceiverStorage", mods.methodReceiverStorage); }

        if this.at(TK.LCurly) {
            this.w.key("funcbody");
            this.rawScope(false);
        }
        else if !this.at(TK.Semi) && !this.atEnd() && this.canStartExpr(this.kind()) {
            this.w.key("funcbody");
            this.funcBody();
            this.accept(TK.Semi);
        }
        else {
            this.accept(TK.Semi);
        }

        let sourceEnd = this.lastToken();
        if genericsEnd > genericsBase {
            let moved = this.w.length();
            this.writeGenerics(genericsBase, genericsEnd, start);
            this.w.hoist(nameAt, moved);
        }
        this.popTo(genericsBase);

        this.locHere(start);
        this.w.keyString("originalSourcecode", this.sourceSpan(start, sourceEnd));
        this.w.end();
    }

    fn canStartExpr(k: TK): bool {
        return k == TK.Ident || k == TK.Type || k == TK.LParen || k == TK.LBracket
            || k == TK.Ref
            || k == TK.Do || k == TK.Attempt || k == TK.Typeof
            || k == TK.FStringStart || k == TK.FTripleStringStart
            || k == TK.Minus || k == TK.Plus || k == TK.Not
            || k == TK.PlusPlus || k == TK.MinusMinus
            || this.isLiteralStart(k);
    }

    // Raw source text spanning two tokens, used for `originalSourcecode`.
    fn sourceSpan(a: Token, b: Token): str {
        if b.end <= a.start { return this.src.slice(a.start, a.end); }
        return this.src.slice(a.start, b.end);
    }

    // structDefinition
    mut fn structDefinition(start: Token, isExport: bool, mods: Modifiers, annotationsAt: int): void :: final {
        this.expect(TK.Struct);
        let nameTok = this.expect(TK.Ident);
        let genericsBase = this.genericParams();
        let genericsEnd = this.stack.length;
        this.discardRequiresBlock();

        this.expect(TK.LCurly);

        this.w.node("StructDefinition");
        this.w.keyBool("export", isExport);
        this.w.keyInt("extern", mods.externLang);
        this.w.keyString("name", this.text(nameTok));
        this.w.keyBool("noemit", mods.isNoemit);
        this.w.keyBool("opaque", mods.isOpaque);
        this.w.keyBool("plain", mods.isPlain);
        this.w.keyBool("refByDefault", mods.refByDefault);
        this.w.keyBool("nocopy", mods.isNocopy);
        this.w.keyBool("pub", mods.isPub);
        // The generics' span ends with the struct: hoisted in at the end.
        let genericsAt = this.w.length();
        this.w.key("members");
        this.w.array();

        let stackref body = StructBody {};
        while !this.at(TK.RCurly) && !this.atEnd() {
            let before = this.pos;
            this.structContent(body);
            if this.pos == before { this.advance(); }
        }
        while body.group < 2 { this.openNextGroup(body); }
        this.w.endArray();

        this.expect(TK.RCurly);
        this.accept(TK.Semi);
        let sourceEnd = this.lastToken();

        if genericsEnd > genericsBase {
            let moved = this.w.length();
            this.writeGenerics(genericsBase, genericsEnd, start);
            this.w.hoist(genericsAt, moved);
        }
        this.popTo(genericsBase);

        this.writeAnnotations(annotationsAt);
        this.locHere(start);
        this.w.keyString("originalSourcecode", this.sourceSpan(start, sourceEnd));
        this.w.end();
    }

    // A struct body is three arrays, members, methods and nestedStructs, but
    // its items come in any order. The array of the latest kind seen is the
    // one open at the end of the output; an item of an earlier kind is
    // written there too and hoisted to the end of its own array.
    //
    // Closes the open array and opens the next one.
    mut fn openNextGroup(body: mut stackref StructBody) {
        if body.group == 0 {
            body.membersEnd = this.w.length();
            this.w.endArray();
            this.w.key("methods");
        }
        else {
            body.methodsEnd = this.w.length();
            this.w.endArray();
            this.w.key("nestedStructs");
        }
        this.w.array();
        body.group++;
    }

    // Before an item of `group` (0 members, 1 methods, 2 nested): returns
    // where it starts, comma included.
    mut fn beginStructItem(body: mut stackref StructBody, group: int): int {
        while body.group < group { this.openNextGroup(body); }
        let at = this.w.length();
        let count = body.members;
        if group == 1 { count = body.methods; }
        else if group == 2 { count = body.nested; }
        if count > 0 { this.w.comma(); }
        if group == 0 { body.members++; }
        else if group == 1 { body.methods++; }
        else { body.nested++; }
        return at;
    }

    // After an item: moves it into its own array if a later one is open.
    mut fn endStructItem(body: mut stackref StructBody, group: int, at: int) {
        if group >= body.group { return; }
        let size = this.w.length() - at;
        if group == 0 {
            this.w.hoist(body.membersEnd, at);
            body.membersEnd += size;
            if body.group == 2 { body.methodsEnd += size; }
            return;
        }
        this.w.hoist(body.methodsEnd, at);
        body.methodsEnd += size;
    }

    // One item inside a struct body: a member, a method, or a nested type.
    mut fn structContent(body: mut stackref StructBody): void :: final {
        // #source at struct-content position: relocates the members inside.
        if this.at(TK.SourceDirective) {
            let saved = this.beginSourceBlock();
            while !this.at(TK.RCurly) && !this.atEnd() {
                let before = this.pos;
                this.structContent(body);
                if this.pos == before { this.advance(); }
            }
            this.restoreOverride(saved);
            this.expect(TK.RCurly);
            return;
        }
        let declStart = this.cur();
        let annotationsAt = this.skipAnnotations();

        // Nested struct / enum definitions, possibly behind modifiers such as
        // `struct Args { ... }`.
        if this.at(TK.Struct) || this.at(TK.Enum)
           || ((this.at(TK.Export) || this.at(TK.Extern) || this.at(TK.Pub)
                || this.at(TK.Opaque) || this.at(TK.Plain) || this.at(TK.Noemit)
                || this.at(TK.Ref) || this.at(TK.Nocopy))
               && this.declAheadIsType()) {
            let isExport = this.accept(TK.Export);
            let mods = this.declModifiers();
            let at = this.beginStructItem(body, 2);
            if this.at(TK.Struct) {
                this.structDefinition(declStart, isExport, mods, annotationsAt);
            }
            else {
                this.enumDefinition(declStart, isExport, mods);
            }
            this.endStructItem(body, 2, at);
            return;
        }

        // Methods: [static] [mut|const|ref|stackref] fn name(...)
        let mods = Modifiers {};
        mods.isStatic = this.accept(TK.Static);

        // Method modifiers in any order before `fn`:
        //   EDatatypeMutability: Default=1 Mut=2 Const=3; null when unspecified.
        //   EStorageClass: Ref=2 Stackref=3; null when unspecified (`ref fn` / `stackref fn`).
        while this.at(TK.Mut) || this.at(TK.Const) || this.at(TK.Ref) || this.at(TK.Stackref) {
            let k = this.kind();
            this.advance();
            if k == TK.Mut { mods.methodMutability = 2; }
            else if k == TK.Const { mods.methodMutability = 3; }
            else if k == TK.Ref { mods.methodReceiverStorage = 2; }
            else if k == TK.Stackref { mods.methodReceiverStorage = 3; }
        }

        if this.at(TK.Fn) {
            // EMethodType (common.ts): Constructor=2 for a method literally
            // named `constructor`, otherwise Method=1. `static` does NOT make
            // it a constructor.
            let methodType = 1;
            if this.peekKind(1) == TK.Ident && this.text(this.toks[this.pos + 1]) == "constructor" {
                methodType = 2;
            }
            let at = this.beginStructItem(body, 1);
            this.functionDefinition(declStart, false, mods, true, methodType);
            this.endStructItem(body, 1, at);
            return;
        }

        // Otherwise a data member: [let|const] name?: T (= expr)? ;
        // The span starts at the `[[...]]` annotation when there is one, since
        // it is part of the same structContent rule.
        let start = declStart;
        let mutability = 3;   // EVariableMutability.Default
        if this.at(TK.Let) { this.advance(); mutability = 2; }
        else if this.at(TK.Const) { this.advance(); mutability = 1; }

        let nameTok = this.memberName();
        let isOptional = this.accept(TK.Question);

        let at = this.beginStructItem(body, 0);
        this.w.node("StructMember");
        this.w.keyString("name", this.text(nameTok));

        // The type may be omitted when a default gives it one (`test = true`).
        // SymbolCollection turns the absent type into `typeof(<default>)`.
        this.w.key("type");
        if !this.at(TK.Equals) {
            this.expect(TK.Colon);
            this.typeExpr();
        }
        else {
            this.w.nullValue();
        }

        this.w.key("defaultValue");
        if this.accept(TK.Equals) { this.expr(); }
        else { this.w.nullValue(); }
        // Commas and semicolons are both accepted, here as in an anonymous
        // struct body. The formatter will normalise later; the parser is
        // permissive now.
        this.memberSeparator();

        this.w.keyBool("optional", isOptional);
        this.w.keyInt("mutability", mutability);
        this.writeAnnotations(annotationsAt);
        this.locHere(start);
        this.w.end();
        this.endStructItem(body, 0, at);
    }

    // A member separator: `,` or `;`, both optional at the end of a body.
    mut fn memberSeparator(): bool :: final {
        if this.accept(TK.Comma) { return true; }
        if this.accept(TK.Semi) { return true; }
        return false;
    }

    // anonStructType: `{ x: real, y: real }` in a TYPE position.
    //
    // Value only: `ref { ... }` is deliberately not expressible, because an
    // anonymous struct has no identity to hang a reference on.
    mut fn anonStructType(): void :: final {
        let start = this.expect(TK.LCurly);
        this.w.node("AnonStructType");
        this.w.key("members");
        this.w.array();

        let count = 0;
        while !this.at(TK.RCurly) && !this.atEnd() {
            let memberStart = this.cur();
            let nameTok = this.memberName();
            let isOptional = this.accept(TK.Question);

            if count > 0 { this.w.comma(); }
            count++;
            this.w.node("StructMember");
            this.w.keyString("name", this.text(nameTok));
            this.w.key("type");
            if !this.at(TK.Equals) {
                this.expect(TK.Colon);
                this.typeExpr();
            }
            else {
                this.w.nullValue();
            }
            this.w.key("defaultValue");
            if this.accept(TK.Equals) { this.expr(); }
            else { this.w.nullValue(); }
            this.w.keyBool("optional", isOptional);
            // EVariableMutability.Default
            this.w.keyInt("mutability", 3);
            this.w.key("annotations");
            this.w.array();
            this.w.endArray();
            this.locHere(memberStart);
            this.w.end();

            if !this.memberSeparator() { break; }
        }
        this.expect(TK.RCurly);

        this.w.endArray();
        this.locHere(start);
        this.w.end();
    }

    // Look past modifiers to see whether a struct/enum keyword follows.
    fn declAheadIsType(): bool {
        let i = this.pos;
        let limit = this.toks.length;
        while i < limit {
            let k = this.toks[i].kind;
            if k == TK.Struct || k == TK.Enum { return true; }
            if k == TK.Export || k == TK.Extern || k == TK.Pub || k == TK.Noemit
               || k == TK.Opaque || k == TK.Plain || k == TK.Ref || k == TK.Nocopy {
                i++;
                continue;
            }
            // `extern C struct` — the language name is a bare identifier.
            if k == TK.Ident && i > this.pos && this.toks[i - 1].kind == TK.Extern {
                i++;
                continue;
            }
            return false;
        }
        return false;
    }

    // enumDefinition
    mut fn enumDefinition(start: Token, isExport: bool, mods: Modifiers): void :: final {
        this.expect(TK.Enum);
        let isBitflag = this.accept(TK.Bitflag);
        let isUnscoped = this.accept(TK.Unscoped);
        let nameTok = this.expect(TK.Ident);
        this.discardRequiresBlock();

        this.expect(TK.LCurly);
        this.w.node("EnumDefinition");
        this.w.keyBool("export", isExport);
        this.w.keyInt("extern", mods.externLang);
        this.w.keyString("name", this.text(nameTok));
        this.w.keyBool("noemit", mods.isNoemit);
        this.w.keyBool("pub", mods.isPub);
        this.w.keyBool("bitflag", isBitflag);
        this.w.keyBool("unscoped", isUnscoped);
        this.w.key("values");
        this.w.array();

        let count = 0;
        while !this.at(TK.RCurly) && !this.atEnd() {
            let vStart = this.cur();
            let vNameTok = this.expect(TK.Ident);
            if count > 0 { this.w.comma(); }
            count++;
            this.w.node("EnumValue");
            this.w.keyString("name", this.text(vNameTok));
            this.w.key("value");
            if this.accept(TK.Equals) { this.expr(); }
            else { this.w.nullValue(); }
            this.locHere(vStart);
            this.w.end();

            if !this.accept(TK.Comma) { break; }
        }
        this.expect(TK.RCurly);
        this.accept(TK.Semi);
        let sourceEnd = this.lastToken();

        this.w.endArray();
        this.locHere(start);
        this.w.keyString("originalSourcecode", this.sourceSpan(start, sourceEnd));
        this.w.end();
    }

}

// Where a struct body stands while its items are parsed; see openNextGroup.
struct StructBody {
    group: int = 0;        // the array open at the end: 0 members, 1 methods, 2 nested
    membersEnd: int = 0;   // where the members array's items end, once it is closed
    methodsEnd: int = 0;   // the same for methods
    members: int = 0;
    methods: int = 0;
    nested: int = 0;
}

// Leading modifiers shared by all declaration forms.
export struct Modifiers {
    externLang: int = 0;         // EExternLanguage
    isPub: bool = false;
    isNoemit: bool = false;
    isOpaque: bool = false;
    isPlain: bool = false;
    refByDefault: bool = false;
    isNocopy: bool = false;
    isStatic: bool = false;
    methodMutability: int = 0;   // 0 = unspecified, else EDatatypeMutability
    methodReceiverStorage: int = 0;   // 0 = unspecified, else EStorageClass (Ref=2, Stackref=3)
}

// Index of the first byte of the unit suffix in a unit literal.
fn splitUnit(raw: str): int {
    let i = raw.length;
    while i > 0 {
        let c = raw[i - 1];
        if (c >= b"0" && c <= b"9") || c == b"." { break; }
        i--;
    }
    return i;
}

// Unit suffix -> ELiteralUnit (s=0 ms=1 us=2 ns=3 m=4 h=5 d=6)
fn unitCode(unit: str): int {
    if unit == "s" { return 0; }
    if unit == "ms" { return 1; }
    if unit == "us" { return 2; }
    if unit == "ns" { return 3; }
    if unit == "m" { return 4; }
    if unit == "h" { return 5; }
    if unit == "d" { return 6; }
    return 0;
}

// EOverloadedOperator for the `operator...` method names; 0 when not one.
fn operatorIdOf(k: TK): int {
    if k == TK.OpPlus { return 1; }
    if k == TK.OpMinus { return 2; }
    if k == TK.OpMul { return 3; }
    if k == TK.OpDiv { return 4; }
    if k == TK.OpMod { return 5; }
    if k == TK.OpRebind { return 6; }
    if k == TK.OpAssign { return 7; }
    if k == TK.OpSubscript { return 8; }
    if k == TK.OpAs { return 9; }
    if k == TK.OpEq { return 10; }
    if k == TK.OpNeq { return 11; }
    if k == TK.OpLt { return 12; }
    if k == TK.OpGt { return 13; }
    if k == TK.OpLte { return 14; }
    if k == TK.OpGte { return 15; }
    return 0;
}

// Index of `needle` in `haystack`, or -1.
fn indexOf(haystack: str, needle: str): int {
    if needle.length == 0 { return 0; }
    let limit = haystack.length - needle.length;
    for (let i = 0; i <= limit; i++) {
        if haystack.startsWith(needle, i) { return i; }
    }
    return -1;
}

// Parse a whole source file into AST JSON.
export fn parseToJson(src: str, filename: str): mut Parser {
    let lexer = tokenize(src);
    let p = Parser.create(src, filename, lexer.tokens);
    for e in lexer.errors {
        p.errors.push(ParseError { message: e.message, line: e.line, col: e.col });
    }
    p.parseProgram();
    return p;
}

// Operator methods are stored under a mangled name in the AST.
fn operatorMethodName(k: TK): str {
    if k == TK.OpPlus { return "__operator_add"; }
    if k == TK.OpMinus { return "__operator_sub"; }
    if k == TK.OpMul { return "__operator_mul"; }
    if k == TK.OpDiv { return "__operator_div"; }
    if k == TK.OpMod { return "__operator_mod"; }
    if k == TK.OpRebind { return "__operator_assign"; }
    if k == TK.OpAssign { return "__operator_assign"; }
    if k == TK.OpAs { return "__operator_cast"; }
    if k == TK.OpSubscript { return "__operator_subscript"; }
    if k == TK.OpEq { return "__operator_eq"; }
    if k == TK.OpNeq { return "__operator_neq"; }
    if k == TK.OpLt { return "__operator_lt"; }
    if k == TK.OpGt { return "__operator_gt"; }
    if k == TK.OpLte { return "__operator_lte"; }
    if k == TK.OpGte { return "__operator_gte"; }
    return "";
}

// A 1-based column from a `#source` spec, as the 0-based column a sourceloc
// carries. A malformed `:0` clamps to 0 rather than wrapping negative.
fn specColumn(s: str): int {
    let v = parseIntPrefix(s);
    if v <= 0 { return 0; }
    return v - 1;
}

// Leading decimal digits of `s` as an int (0 when there are none).
fn parseIntPrefix(s: str): int {
    let v = 0;
    for (let i = 0; i < s.length; i++) {
        let c = s[i];
        if c < b"0" || c > b"9" { break; }
        v = v * 10 + ((c as int) - 48);
    }
    return v;
}
