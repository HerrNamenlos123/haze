// haze-parser CLI.
//
// Two modes:
//
//   haze-parser <file.hz>     Parse one file and print its AST JSON to stdout.
//   haze-parser --server      Read file paths on stdin, stream JSON on stdout.
//
// The compiler uses server mode: a build parses hundreds of files, and paying a
// process spawn per file would eat most of the speedup.
//
// Server protocol, line oriented so no framing library is needed:
//   Request   one line containing a file path (or `__quit__` to exit).
//   Response  `OK <byteLength>\n` followed by exactly that many bytes of JSON,
//             or `ERR <message>\n`.
// Counting bytes means the JSON payload never has to be escaped or scanned.

__c__("#include <stdio.h>");
__c__("#include <string.h>");

// argv/stdin are not exposed by the standard library, so they come straight
// from C. The buffer is static and reused: paths are short and this runs on the
// hot path once per file.
extern C fn hz_arg_count(): int :: final;
extern C fn hz_arg_at(index: int): ccstr :: final;
extern C fn hz_read_line(): ccstr :: final;
extern C fn hz_write_all(data: str): void :: final;
extern C fn hz_flush(): void :: final;
extern C fn hz_write_err(data: str): void :: final;
// Read exactly n bytes of source from stdin (used by the TEXT request).
extern C fn hz_read_exact(n: int): str :: final;

__c__("
#ifdef _WIN32
#include <io.h>
#include <fcntl.h>

// stdin/stdout default to text mode on Windows, which is fatal for this
// protocol. Reading: fread() collapses CRLF to LF, so a TEXT request carrying a
// CRLF source needs more raw bytes than its declared length and fread() blocks
// forever waiting for bytes the compiler already sent in full. Writing: LF
// expands to CRLF, so the payload no longer matches the byte count in the
// header. Both sides must be raw.
__attribute__((constructor))
static void _hz_set_binary_stdio(void) {
    _setmode(_fileno(stdin), _O_BINARY);
    _setmode(_fileno(stdout), _O_BINARY);
}
#endif

static char _hz_linebuf[65536];

// The generated entry point does not stash argc/argv anywhere, so grab them
// from a constructor that runs before main.
//
// Only glibc passes (argc, argv, envp) to .init_array constructors. On Windows
// a constructor is called with no arguments at all, so reading them there gave
// argc == 0 and every invocation failed with the usage message. Windows instead
// exposes the real values as the CRT globals __argc/__argv.
#ifdef _WIN32
extern int __argc;
extern char** __argv;
#define _hz_argc __argc
#define _hz_argv ((const char**)__argv)
#else
static int _hz_argc = 0;
static const char** _hz_argv = 0;

__attribute__((constructor))
static void _hz_capture_args(int argc, const char** argv) {
    _hz_argc = argc;
    _hz_argv = argv;
}
#endif

hzstd_str_t hz_read_exact(hzstd_int_t n) {
    hzstd_str_t s;
    if (n <= 0) { s.data = \"\"; s.length = 0; return s; }
    char* buf = (char*)hzstd_allocate(hzstd_make_heap_allocator(), (size_t)n + 1, \"str\");
    size_t got = fread(buf, 1, (size_t)n, stdin);
    buf[got] = 0;
    s.data = buf;
    s.length = (hzstd_int_t)got;
    return s;
}

hzstd_ccstr_t hz_read_line(void) {
    // Must not return NULL at EOF: the caller wraps this in
    // hzstd_str_from_ccstr_ref, which strlen()s it, so a NULL segfaulted the
    // whole server the moment stdin closed without an explicit __quit__.
    // An empty line already means \"stop\" in runServer.
    if (!fgets(_hz_linebuf, sizeof(_hz_linebuf), stdin)) {
        _hz_linebuf[0] = 0;
        return _hz_linebuf;
    }
    return _hz_linebuf;
}

// Write a length-counted slice: the JSON contains newlines and its length is
// authoritative, so puts()/printf() are not usable.
hzstd_void_t hz_write_all(hzstd_str_t data) {
    fwrite(data.data, 1, (size_t)data.length, stdout);
}

hzstd_void_t hz_write_err(hzstd_str_t data) {
    fwrite(data.data, 1, (size_t)data.length, stderr);
    fputc('\\n', stderr);
}

hzstd_void_t hz_flush(void) { fflush(stdout); }

hzstd_int_t hz_arg_count(void) { return (hzstd_int_t)_hz_argc; }
hzstd_ccstr_t hz_arg_at(hzstd_int_t index) {
    if (index < 0 || index >= (hzstd_int_t)_hz_argc) return \"\";
    return _hz_argv[index];
}
");

fn parseFile(path: str): str | none {
    if let content = fs.readText(path) {
        let p = parseToJson(content, path);
        if p.errors.length > 0 {
            let first = p.errors[0];
            let msg = first.message;
            hz_write_err(f"{path}:{first.line}:{first.col}: {msg}");
            return none;
        }
        return p.w.result();
    }
    return none;
}

// Strip the trailing newline fgets leaves in place, plus any stray whitespace.
fn trimLine(s: str): str {
    let end = s.length;
    while end > 0 {
        let c = s[end - 1];
        if c == b"\n" || c == b"\r" || c == b" " || c == b"\t" { end--; }
        else { break; }
    }
    return s.slice(0, end);
}

fn runServer(): int {
    while true {
        let raw = hz_read_line();
        let line = trimLine(hzstd_str_from_ccstr_ref(raw));
        if line.length == 0 { break; }
        if line == "__quit__" { break; }

        // `TEXT <byteLength> <filename>`: the next <byteLength> bytes on stdin
        // are the source. Used for buffers the compiler already holds in memory
        // and for synthetic sources that have no file on disk.
        if line.startsWith("TEXT ", 0) {
            let rest = line.slice(5);
            let sp = 0;
            while sp < rest.length && rest[sp] != b" " { sp++; }
            let byteLen = parseInt(rest.slice(0, sp));
            let name = rest.slice(sp + 1);
            let content = hz_read_exact(byteLen);
            let p = parseToJson(content, name);
            if p.errors.length > 0 {
                let first = p.errors[0];
                let msg = first.message;
                fmt.println(f"ERR {name}:{first.line}:{first.col}: {msg}");
            }
            else {
                let out = p.w.result();
                fmt.println(f"OK {out.length}");
                hz_write_all(out);
            }
            hz_flush();
            continue;
        }

        let result = parseFile(line);
        if result {
            fmt.println(f"OK {result.length}");
            hz_write_all(result);
        }
        else {
            fmt.println(f"ERR failed to parse {line}");
        }
        hz_flush();
    }
    return 0;
}

fn main() {
    if hz_arg_count() < 2 {
        hz_write_err("usage: haze-parser <file.hz> | --server");
        return 1;
    }

    let arg = hzstd_str_from_ccstr_ref(hz_arg_at(1));

    if arg == "--server" {
        return runServer();
    }

    // `--bench <file> [iterations]`: time parsing only, excluding process
    // startup and file IO, so the number is comparable to an in-process parser.
    if arg == "--bench" {
        let path = hzstd_str_from_ccstr_ref(hz_arg_at(2));
        if let content = fs.readText(path) {
            let iters = 5;
            // Warm up so the first allocation burst is not measured.
            let warm = parseToJson(content, path);
            fmt.println(f"warmup json bytes: {warm.w.result().length}");

            let best = 1000000.0;
            for (let i = 0; i < iters; i++) {
                let t0 = time.now();
                let p = parseToJson(content, path);
                let t1 = time.now();
                let ms = (t1 - t0) * 1000.0;
                if ms < best { best = ms; }
            }
            let kb = (content.length as real) / 1024.0;
            let mbs = (content.length as real) / 1000000.0 / (best / 1000.0);
            fmt.println(f"{path}: {kb}KB  best={best}ms  {mbs}MB/s");
            return 0;
        }
        return 1;
    }

    let result = parseFile(arg);
    if result {
        hz_write_all(result);
        hz_flush();
        return 0;
    }
    return 1;
}

// Leading decimal digits of `s` as an int.
fn parseInt(s: str): int {
    let v = 0;
    for (let i = 0; i < s.length; i++) {
        let c = s[i];
        if c < b"0" || c > b"9" { break; }
        v = v * 10 + ((c as int) - 48);
    }
    return v;
}
